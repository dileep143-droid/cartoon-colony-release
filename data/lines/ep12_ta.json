[{"id": 1, "duration_s": 5.147, "emotion": "mischievous", "text": "காலை ஏழு மணி... காலனி முழுக்க போனெல்லாம் ஒண்ணா அலறுச்சு!"}, {"id": 2, "duration_s": 3.35, "emotion": "angry", "text": "காசு கந்தசாமி கடன் வாங்கிண்டார்! வசூலுண்டு!"}, {"id": 3, "duration_s": 2.26, "emotion": "excited", "text": "கந்தசாமி கதை... எனக்கா? <gasp>"}, {"id": 4, "duration_s": 2.1, "emotion": "scared_whisper", "text": "நான் வீட்ல இல்ல... நான் அரிசி!"}, {"id": 5, "duration_s": 1.09, "emotion": "stern_warning", "text": "கந்தசாமி!"}, {"id": 6, "duration_s": 9.77, "emotion": "mischievous", "text": "இதெல்லாம் தொடங்கினது நேத்து... வெறும் ரெண்டே நிமிஷத்துல."}, {"id": 7, "duration_s": 2.65, "emotion": "serious", "text": "தொண்ணூற்றெட்டு, தொண்ணூற்றொன்பது... திரும்ப எண்ணு! ஒரு ரூபா கூட கம்மி இல்ல!"}, {"id": 8, "duration_s": 4.16, "emotion": "worried", "text": "கடை சின்னது, தொப்பை பெருசு! கடைய பெருசாக்கணும்!"}, {"id": 9, "duration_s": 3.71, "emotion": "mischievous", "text": "பெரிய கடையா? நான் இப்பவே இடம் பண்றேன்!"}, {"id": 10, "duration_s": 3.1, "emotion": "excited", "text": "ரெண்டே நிமிஷத்துல லோன்! காகிதமே வேண்டாம்!"}, {"id": 11, "duration_s": 4.1, "emotion": "excited", "text": "ரெண்டு நிமிஷமா? அதுக்குள்ள என் டீ கூட ஆறாதே!"}, {"id": 12, "duration_s": 2.21, "emotion": "curious", "text": "கந்தசாமி, லோன்னா என்ன?"}, {"id": 13, "duration_s": 4.79, "emotion": "proud", "text": "லோன்னா... ஊரான் காசு, என் கடை!"}, {"id": 14, "duration_s": 1.52, "emotion": "calm", "text": "உங்க காண்டாக்ட்ஸ் மட்டும் குடுங்கோ."}, {"id": 15, "duration_s": 3.02, "emotion": "happy", "text": "காண்டாக்ட்ஸ்தானே? எடுத்துக்கோ! ஓசியில!"}, {"id": 16, "duration_s": 1.62, "emotion": "calm", "text": "கூடவே, ஃபோட்டோ கேலரியும்."}, {"id": 17, "duration_s": 4.58, "emotion": "giggly", "text": "போட்டோவும் எடுத்துக்கோ! என்னை மாதிரி ஹேண்ட்சம் யாரு?"}, {"id": 18, "duration_s": 1.94, "emotion": "calm", "text": "இந்த விதிமுறைகளையும்... படிச்சுடுங்கோ."}, {"id": 19, "duration_s": 2.32, "emotion": "serious", "text": "நான் சொல்லட்டுமா? விதிகளைப் படிங்க!"}, {"id": 20, "duration_s": 3.18, "emotion": "sarcastic", "text": "படிச்சா நேரமாகும்... டைம் இஸ் மணி!"}, {"id": 21, "duration_s": 1.93, "emotion": "excited", "text": "வாழ்த்துக்கள்! லோன் சாங்ஷன்!"}, {"id": 22, "duration_s": 3.53, "emotion": "shocked", "text": "இருபதாயிரம் கேட்டா, பதிமூணாயிரமா?"}, {"id": 23, "duration_s": 1.97, "emotion": "happy", "text": "ஏழாயிரம் ப்ராசஸிங் ஃபீஸ்ங்கோ!"}, {"id": 24, "duration_s": 3.6, "emotion": "worried", "text": "ஏழு நாள்ல... முப்பதாயிரம் திருப்பணும்!"}, {"id": 25, "duration_s": 4.58, "emotion": "proud", "text": "ஏழு நாள்ல கடை டபுள் ஆயிடும்!"}, {"id": 26, "duration_s": 3.96, "emotion": "proud", "text": "இன்னிக்கு முதல் காசு கந்தசாமி... லோன் கந்தசாமி!"}, {"id": 27, "duration_s": 4.12, "emotion": "happy", "text": "லான்? ஆஹா! புல் எங்க நடுவீங்க கந்தசாமி?"}, {"id": 28, "duration_s": 3.86, "emotion": "sarcastic", "text": "புல்லு இல்ல வேலு வாத்தியாரே! லோன்! பணம்!"}, {"id": 29, "duration_s": 5.13, "emotion": "tired", "text": "அண்ணே, ஃப்ரீசர் பெருசா, இல்ல கதவு சிறுசா?"}, {"id": 30, "duration_s": 3.34, "emotion": "serious", "text": "கந்தசாமி, இவ்ளோ காசு ஏது?"}, {"id": 31, "duration_s": 2.95, "emotion": "happy", "text": "கடவுள் குடுத்தார்... ரெண்டே நிமிஷத்துல."}, {"id": 32, "duration_s": 3.14, "emotion": "excited", "text": "ரெண்டு நிமிஷத்துல காசா? என் கனவு!"}, {"id": 33, "duration_s": 2.3, "emotion": "excited", "text": "லைவ்ல இருக்கோம்! கந்தசாமி ஃப்ரீசர்!"}, {"id": 34, "duration_s": 4.25, "emotion": "mischievous", "text": "அன்னிக்கு ராத்திரி... வட்டி முழிச்சுச்சு. கந்தசாமியும்!"}, {"id": 35, "duration_s": 3.0, "emotion": "worried", "text": "பன்னிரண்டு மணி... இருபத்தொன்றாயிரம்!"}, {"id": 36, "duration_s": 2.58, "emotion": "panicked", "text": "ஒரு மணி... இருபத்திரண்டாயிரம்!"}, {"id": 37, "duration_s": 2.66, "emotion": "comic_panic", "text": "இது வட்டியா, கரண்ட் மீட்டரா?"}, {"id": 38, "duration_s": 2.46, "emotion": "scared_whisper", "text": "அறிவு! வட்டி ஒவ்வொரு மணிக்கும் ஏறுது!"}, {"id": 39, "duration_s": 2.61, "emotion": "proud", "text": "அறிவியல் சொல்லுது... வட்டியும் ராத்திரி தூங்கும்."}, {"id": 40, "duration_s": 3.59, "emotion": "crying", "text": "வட்டி தூங்காது அறிவு... நான் தூங்கல!"}, {"id": 41, "duration_s": 2.765, "emotion": "tired", "text": "கந்தசாமி... ஹிசாப் நாளை."}, {"id": 42, "duration_s": 3.51, "emotion": "mischievous", "text": "ஆப் ஆப்பு வச்சுச்சு... எல்லாருக்கும் போன்!"}, {"id": 43, "duration_s": 2.96, "emotion": "proud", "text": "யாரு? நான் யாருக்கும் பயப்படமாட்டேன்!"}, {"id": 44, "duration_s": 3.65, "emotion": "shouting", "text": "கந்தசாமி பணம் கட்டுங்கோ, இல்லாட்டி போட்டோ எல்லாருக்கும்!"}, {"id": 45, "duration_s": 2.3, "emotion": "sarcastic", "text": "போன்தான்ங்க, பல்லி இல்ல!"}, {"id": 46, "duration_s": 4.05, "emotion": "angry", "text": "எல்லாருக்கும் போன்... எனக்கு இல்லையா? என் நம்பர் இல்லையா?"}, {"id": 47, "duration_s": 6.47, "emotion": "proud", "text": "வந்துச்சு! ஹலோ? ஆமா, நான்தான்... காலனியே பார்க்கட்டும்!"}, {"id": 48, "duration_s": 1.61, "emotion": "worried", "text": "போனுக்கே கண்ணு பட்டுடுச்சு!"}, {"id": 49, "duration_s": 4.44, "emotion": "shouting", "text": "சோதனை! ...யாரை?"}, {"id": 50, "duration_s": 6.66, "emotion": "tired", "text": "போன் அடிக்குது, ஆட்டோ நின்னுது. ஹூம்..."}, {"id": 51, "duration_s": 0.64, "emotion": "stern_warning", "text": "சும்மாரு!"}, {"id": 52, "duration_s": 2.81, "emotion": "excited", "text": "முப்பது வருஷமா கந்தசாமி கிசுகிசு இல்ல!"}, {"id": 53, "duration_s": 2.804, "emotion": "mischievous", "text": "கேட்டியா? கந்தசாமி லோன் வாங்கினார்!"}, {"id": 54, "duration_s": 2.12, "emotion": "sarcastic", "text": "தெரியும். எனக்கும் போன் வந்துச்சு."}, {"id": 55, "duration_s": 1.6, "emotion": "excited", "text": "கேட்டியா? கந்தசாமி—"}, {"id": 56, "duration_s": 2.5, "emotion": "calm", "text": "தெரியும். எலுமிச்சையும் கட்டியாச்சு."}, {"id": 57, "duration_s": 0.68, "emotion": "pleading", "text": "கேட்டியா...?"}, {"id": 58, "duration_s": 2.3, "emotion": "giggly", "text": "தெரியும் மாமி! காலனி முழுக்க தெரியும்!"}, {"id": 59, "duration_s": 2.38, "emotion": "mischievous", "text": "ஹலோ, லோன் ஆபீசா? வேற என்ன வாங்கினார்?"}, {"id": 60, "duration_s": 1.54, "emotion": "surprised", "text": "மாமி, வசூல் பண்ணப்போறேளா?"}, {"id": 61, "duration_s": 1.96, "emotion": "giggly", "text": "இல்ல கண்ணா, கிசுகிசு மட்டும்!"}, {"id": 62, "duration_s": 3.23, "emotion": "angry", "text": "கந்தசாமி! காலனி முழுக்க என்ன பேசுதுங்க?!"}, {"id": 63, "duration_s": 1.106, "emotion": "serious", "text": "கந்தசாமி எங்கே?"}, {"id": 64, "duration_s": 1.226, "emotion": "giggly", "text": "அரிசில!"}, {"id": 65, "duration_s": 1.99, "emotion": "scared_whisper", "text": "ராஜாத்தி... நான் மூட்டைல இல்ல."}, {"id": 66, "duration_s": 1.96, "emotion": "guilty", "text": "ரெண்டே நிமிஷ லோன்தான் ராஜாத்தி."}, {"id": 67, "duration_s": 3.29, "emotion": "sarcastic", "text": "ரெண்டு நிமிஷ லோன்... காலனி முழுக்க போனா?"}, {"id": 68, "duration_s": 2.801, "emotion": "pleading", "text": "போட்டோ எடுத்தாங்க! எல்லாருக்கும் அனுப்புவாங்க!"}, {"id": 69, "duration_s": 3.22, "emotion": "laughing", "text": "இது அப்பா ஜிலேபி போட்டோ!"}, {"id": 70, "duration_s": 1.74, "emotion": "determined", "text": "கணக்கை நான் பாக்கறேன்."}, {"id": 71, "duration_s": 1.93, "emotion": "excited", "text": "டென்ஷன் வேணாம்! என்கிட்ட வேற ஆப்!"}, {"id": 72, "duration_s": 1.93, "emotion": "proud", "text": "லோன் அடைக்க... புது லோன்!"}, {"id": 73, "duration_s": 2.54, "emotion": "excited", "text": "நெசமாவா? எவ்ளோ நிமிஷம்?"}, {"id": 74, "duration_s": 1.44, "emotion": "comic_panic", "text": "...சும்மா தமாஷ் பண்ணேன்."}, {"id": 75, "duration_s": 3.35, "emotion": "angry", "text": "கடன் மேல கடனா? நில்லு சேகர்!"}, {"id": 76, "duration_s": 2.83, "emotion": "embarrassed", "text": "பட்டம்மா குறி... என்னைக்கும் தப்பாது."}, {"id": 77, "duration_s": 1.89, "emotion": "determined", "text": "போதும்! இனி நான் பாத்துக்கறேன்."}, {"id": 78, "duration_s": 2.82, "emotion": "serious", "text": "முதல்ல ஆதாரம். மிரட்டல் எல்லாம் ஸ்கிரீன்ஷாட்."}, {"id": 79, "duration_s": 4.58, "emotion": "calm", "text": "அப்புறம் காண்டாக்ட்ஸ், போட்டோ அனுமதி... ஆஃப்!"}, {"id": 80, "duration_s": 1.46, "emotion": "shocked", "text": "ஓசிலதானே குடுத்தேன்!"}, {"id": 81, "duration_s": 0.75, "emotion": "shouting", "text": "சும்மா!"}, {"id": 82, "duration_s": 2.57, "emotion": "excited", "text": "ஒரு ஐடியா இருக்கு! நிஜ பேங்க் போலாம்!"}, {"id": 83, "duration_s": 5.13, "emotion": "proud", "text": "நான் சொல்லட்டுமா? பத்தொன்பது முப்பதுக்கு சைபர் புகார்!"}, {"id": 84, "duration_s": 3.62, "emotion": "worried", "text": "பேங்கா? அங்க உக்காரவே ஃபீஸ் இருக்கும்!"}, {"id": 85, "duration_s": 0.68, "emotion": "stern_warning", "text": "கிளம்பு!"}, {"id": 86, "duration_s": 0.86, "emotion": "happy", "text": "போலாம், போலாம்!"}, {"id": 87, "duration_s": 4.579, "emotion": "sarcastic", "text": "கந்தசாமி, தொப்பைய கொஞ்சம் தள்ளு... வட்டியோட!"}, {"id": 88, "duration_s": 2.39, "emotion": "tired", "text": "<sigh> அவசர வேலைன்னா தானா நின்னுடும்!"}, {"id": 89, "duration_s": 2.0, "emotion": "stern_warning", "text": "தள்ளுங்க! நான் எண்ணறேன்!"}, {"id": 90, "duration_s": 2.98, "emotion": "scared_whisper", "text": "முன்னாடியே சொல்லிடுங்க... உக்கார ஃபீஸா?"}, {"id": 91, "duration_s": 3.73, "emotion": "calm", "text": "மேடம், ஆப் தினமும் வட்டி ஏத்துது, எல்லாரையும் மிரட்டுது."}, {"id": 92, "duration_s": 4.466, "emotion": "serious", "text": "நான் சொல்லட்டுமா? எந்த ஆப்புக்கும் காண்டாக்ட்ஸ்-போட்டோ தராதீங்க."}, {"id": 93, "duration_s": 2.62, "emotion": "serious", "text": "கடன் பேங்க் இல்ல ஆர்பிஐ கம்பெனில மட்டும்!"}, {"id": 94, "duration_s": 2.19, "emotion": "guilty", "text": "அப்போ என் ஆப்... ரெஜிஸ்டர்டா?"}, {"id": 95, "duration_s": 4.03, "emotion": "proud", "text": "மிரட்டலா? பத்தொன்பது முப்பது போன். சைபர்ல புகார்."}, {"id": 96, "duration_s": 2.69, "emotion": "calm", "text": "சைபர் க்ரைம் ஹெல்ப்லைன். சொல்லுங்கோ, என்னாச்சு?"}, {"id": 97, "duration_s": 2.62, "emotion": "serious", "text": "லோன் ஆப் மிரட்டுது. ஆதாரம் எல்லாம் இருக்கு."}, {"id": 98, "duration_s": 3.28, "emotion": "calm", "text": "நல்லது. புகார் பதிவாயிடுத்து, எண் மெசேஜ்ல வரும்."}, {"id": 99, "duration_s": 3.22, "emotion": "worried", "text": "அப்புறம்... ஃபீஸ் ஏதும்?"}, {"id": 100, "duration_s": 0.86, "emotion": "calm", "text": "ஃபீஸ் இல்லை."}, {"id": 101, "duration_s": 2.92, "emotion": "happy", "text": "கடைக்கு சரியான லோன், சரியான பேப்பரோட!"}, {"id": 102, "duration_s": 3.46, "emotion": "happy", "text": "மேடம், உங்க அறிவுரை... ஒரு ரூபா கூட கம்மி இல்ல!"}, {"id": 103, "duration_s": 3.962, "emotion": "calm", "text": "சாயங்காலம் கந்தசாமி சத்யநாராயண பூஜை வச்சார்."}, {"id": 104, "duration_s": 3.12, "emotion": "pleading", "text": "கடவுளே, இன்னிக்கு போனே அடிக்கக்கூடாது!"}, {"id": 105, "duration_s": 3.6, "emotion": "serious", "text": "கதையின் முதல் அத்தியாயம்... கவனமா கேளுங்க."}, {"id": 106, "duration_s": 2.26, "emotion": "scared_whisper", "text": "வந்துட்டாங்க... வசூல்காரங்க!"}, {"id": 107, "duration_s": 3.22, "emotion": "excited", "text": "பிளான் ஓகே? மூணு... ரெண்டு... ஒண்ணு!"}, {"id": 108, "duration_s": 1.21, "emotion": "calm", "text": "கந்தசாமி பூஜைல இருக்கார்!"}, {"id": 109, "duration_s": 1.82, "emotion": "angry", "text": "பூஜையா? பணம் எப்போ?!"}, {"id": 110, "duration_s": 3.38, "emotion": "proud", "text": "பத்தொன்பது முப்பதுல புகார் ஆயிடுச்சு! காலனியே சாட்சி!"}, {"id": 111, "duration_s": 2.33, "emotion": "proud", "text": "நான் யாருக்கும் பயப்பட மாட்டேன்!"}, {"id": 112, "duration_s": 2.88, "emotion": "sarcastic", "text": "மிரட்டலுக்கு பயப்படல... பல்லிக்கு பயம்!"}, {"id": 113, "duration_s": 3.68, "emotion": "mischievous", "text": "கண்ணா, உன் பேர் என்ன? நாளைக்கு காலனியே தெரிஞ்சுக்கும்."}, {"id": 114, "duration_s": 2.79, "emotion": "serious", "text": "எல்லா போனுக்கும் கண் பட்டுடுச்சு!"}, {"id": 115, "duration_s": 4.97, "emotion": "excited", "text": "பிரசாதம்? ...சோதனை!"}, {"id": 116, "duration_s": 2.53, "emotion": "guilty", "text": "பசிக்குது! சாமி மன்னிச்சுடுவாரு!"}, {"id": 117, "duration_s": 3.18, "emotion": "excited", "text": "லைவ்ல இருக்கோம்! உலகின் முதல் ஆன்டி-லோன் ஆரத்தி!"}, {"id": 118, "duration_s": 0.98, "emotion": "shouting", "text": "சும்மா!"}, {"id": 119, "duration_s": 2.87, "emotion": "calm", "text": "சரி... கதையின் முதல் அத்தியாயம்."}, {"id": 120, "duration_s": 2.68, "emotion": "loving", "text": "கந்தசாமி, இனி நீங்க தனியில்ல."}, {"id": 121, "duration_s": 2.88, "emotion": "tender", "text": "காலனியே என் கூட... ஃபீஸும் இல்ல."}, {"id": 122, "duration_s": 4.56, "emotion": "calm", "text": "மறுநாள் காலை... காலனில ஒரு போன் கூட அடிக்கல."}, {"id": 123, "duration_s": 9.018, "emotion": "proud", "text": "விசாரணை முடிஞ்சுது! சைபர் செல் புகார பதிவு பண்ணிடுச்சு."}, {"id": 124, "duration_s": 5.91, "emotion": "serious", "text": "ஆப் மேல புகார் ஆச்சு. மிரட்டல் போன்கள் நின்னுடுச்சு."}, {"id": 125, "duration_s": 3.69, "emotion": "excited", "text": "அப்போ... முப்பதாயிரம் வேணாமா?"}, {"id": 126, "duration_s": 3.14, "emotion": "serious", "text": "மிரட்டலுக்கு வட்டி இல்ல. வாங்கின அளவு திருப்பு."}, {"id": 127, "duration_s": 5.133, "emotion": "sad", "text": "பதிமூணாயிரம்... முழுசா. ஒரு ரூபா கூட கம்மி இல்ல..."}, {"id": 128, "duration_s": 5.07, "emotion": "determined", "text": "காண்டாக்ட்ஸ் போட்டோ என்னோடது. எந்த ஆப்புக்கும் இல்ல!"}, {"id": 129, "duration_s": 3.21, "emotion": "proud", "text": "அறிவியல் சொல்லுது, ஆப் அழிச்சா லோனும் அழியும்!"}, {"id": 130, "duration_s": 3.13, "emotion": "serious", "text": "நான் சொல்லட்டுமா? கடன் திருப்பு, மிரட்டல் வேணாம்!"}, {"id": 131, "duration_s": 4.46, "emotion": "proud", "text": "கடை பெருசாகும்... பேங்க்ல, சரியான பேப்பரோட!"}, {"id": 132, "duration_s": 4.43, "emotion": "guilty", "text": "தாத்தா, ரெண்டு நிமிஷ லோன்... ரெண்டு நாள் அழ வச்சுடுச்சு."}, {"id": 133, "duration_s": 3.18, "emotion": "calm", "text": "அவசரக் கடன்... நீண்ட நாள் அழ வைக்கும்."}, {"id": 134, "duration_s": 5.51, "emotion": "serious", "text": "கடன் பேங்க்ல, இல்ல ஆர்பிஐ பதிவு இடத்துல. விதிகள படிச்சு."}, {"id": 135, "duration_s": 5.14, "emotion": "stern_warning", "text": "ஆப்ல போட்டோ, காண்டாக்ட்ஸ் வேணாம். மிரட்டல்? பத்தொன்பது முப்பது!"}, {"id": 136, "duration_s": 4.15, "emotion": "happy", "text": "‘டைம் இஸ் மணி’ இல்ல... ‘படிப்பு இஸ் மணி’!"}, {"id": 137, "duration_s": 3.37, "emotion": "happy", "text": "ஒரு வார்த்தை கூட கம்மி இல்ல... முழுசா படிப்பேன்!"}, {"id": 138, "duration_s": 1.57, "emotion": "excited", "text": "ரெண்டே நிமிஷ லோன்!"}, {"id": 139, "duration_s": 3.04, "emotion": "happy", "text": "காலனி கதைகள்... மறுபடி சந்திப்போம்!"}]