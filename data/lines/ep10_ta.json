[{"id": 1, "duration_s": 4.35, "emotion": "mischievous", "text": "ராத்திரி ரெண்டு மணி... காலனியே தூக்கத்துல."}, {"id": 2, "duration_s": 1.0, "emotion": "mischievous", "text": "ஒருத்தனைத் தவிர!"}, {"id": 3, "duration_s": 1.36, "emotion": "angry", "text": "என் காதுல ஏர்போர்ட்டா?"}, {"id": 4, "duration_s": 1.79, "emotion": "proud", "text": "நான் யாருக்கும் பயப்படமாட்டேன்!"}, {"id": 5, "duration_s": 3.63, "emotion": "giggly", "text": "பத்து தட்டு... இருபது... முப்பது..."}, {"id": 6, "duration_s": 2.48, "emotion": "sarcastic", "text": "கைதட்டல் எதுக்கு? ஊர்வலமா?"}, {"id": 7, "duration_s": 2.77, "emotion": "scared_whisper", "text": "நாற்பதாவது... கடைசி."}, {"id": 8, "duration_s": 8.11, "emotion": "giggly", "text": "நாற்பது தட்டு! கொசு: பூஜ்ஜியம். முருகேசன்: நாற்பது!"}, {"id": 9, "duration_s": 3.7, "emotion": "determined", "text": "ஒதுங்கு! என் செருப்பு குறி தப்பாது!"}, {"id": 10, "duration_s": 3.36, "emotion": "embarrassed", "text": "தப்பலை... நேரா என் நெத்தியிலேயே!"}, {"id": 11, "duration_s": 2.17, "emotion": "proud", "text": "பாத்தியா? குறி தப்பாது."}, {"id": 12, "duration_s": 2.24, "emotion": "mischievous", "text": "இது... ஆரம்பம்தான்!"}, {"id": 13, "duration_s": 2.62, "emotion": "giggly", "text": "விடிஞ்சதும்... காலனியே சொறிஞ்சுக்கிட்டு!"}, {"id": 14, "duration_s": 2.51, "emotion": "excited", "text": "கேட்டியா? ராத்திரி கொசுப்படை வந்துச்சாம்!"}, {"id": 15, "duration_s": 2.81, "emotion": "mischievous", "text": "முருகேசன் தன்னையே நாற்பது அடி அடிச்சுக்கிட்டாராம்!"}, {"id": 16, "duration_s": 2.06, "emotion": "embarrassed", "text": "அது கொசு இல்ல... யானை!"}, {"id": 17, "duration_s": 3.05, "emotion": "sarcastic", "text": "யானை இல்ல... அம்மா செருப்பு!"}, {"id": 18, "duration_s": 2.37, "emotion": "serious", "text": "கண்ணு பட்டுடுச்சு! கொசுக் கண்ணு!"}, {"id": 19, "duration_s": 2.51, "emotion": "shocked", "text": "ஐயோ! மிளகாயையும் தின்னுடுச்சே!"}, {"id": 20, "duration_s": 4.0, "emotion": "stern_warning", "text": "சமோசா? நில்லு! விசாரணை!"}, {"id": 21, "duration_s": 2.17, "emotion": "happy", "text": "விசாரணை ஓவர். பசி!"}, {"id": 22, "duration_s": 3.67, "emotion": "proud", "text": "அறிவியல் சொல்லுது, கொசு சாக்கடையில மட்டும்தான் வளரும்!"}, {"id": 23, "duration_s": 1.03, "emotion": "curious", "text": "நான் சொல்லவா?"}, {"id": 24, "duration_s": 2.79, "emotion": "proud", "text": "பசங்க சும்மா இரு! அறிவியல் பேசுது."}, {"id": 25, "duration_s": 3.41, "emotion": "proud", "text": "நம்ம காலனி சுத்தம்! கொசு வெளியில இருந்து வருது!"}, {"id": 26, "duration_s": 3.54, "emotion": "excited", "text": "கொசு-ப்ரூஃப் ஊதுபத்தி! ஒண்ணு கொளுத்து, கொசு காலி!"}, {"id": 27, "duration_s": 1.91, "emotion": "determined", "text": "நாற்பது குடு! ஒரு தட்டுக்கு ஒண்ணு."}, {"id": 28, "duration_s": 2.54, "emotion": "stern_warning", "text": "பத்துக்கு ஒண்ணு. ஒரு ரூபா கூட கம்மி இல்ல!"}, {"id": 29, "duration_s": 3.15, "emotion": "angry", "text": "முதலாளி! இது போன வருஷ பூஜை ஊதுபத்தி!"}, {"id": 30, "duration_s": 2.836, "emotion": "embarrassed", "text": "பழைய பூஜை... புது கொசு."}, {"id": 31, "duration_s": 5.0, "emotion": "giggly", "text": "சாயங்காலத்துக்குள்ள மேகம் வந்துச்சு. கொசு போகல."}, {"id": 32, "duration_s": 2.57, "emotion": "excited", "text": "லைவ்-ல இருக்கோம்! காலனியில மேகம்!"}, {"id": 33, "duration_s": 1.53, "emotion": "determined", "text": "முதலாளி, அசையாதீங்க."}, {"id": 34, "duration_s": 2.99, "emotion": "tired", "text": "புகை போச்சு... கொசு போகல."}, {"id": 35, "duration_s": 2.46, "emotion": "serious", "text": "ரெண்டு நாள் கழிச்சு. கந்தசாமி வீட்டுல."}, {"id": 36, "duration_s": 3.2, "emotion": "loving", "text": "எந்திரிடா கண்ணா. உனக்குப் பிடிச்ச லட்டு."}, {"id": 37, "duration_s": 2.5, "emotion": "shocked", "text": "லட்டு வேண்டாம்னு போண்டா சொல்றானா?!"}, {"id": 38, "duration_s": 2.21, "emotion": "tired", "text": "அம்மா... பசிக்கல..."}, {"id": 39, "duration_s": 2.38, "emotion": "worried", "text": "ஏங்க! காய்ச்சல்! டாக்டர்!"}, {"id": 40, "duration_s": 2.49, "emotion": "worried", "text": "ஃபீஸ்... பரவால்ல! பரவால்ல!"}, {"id": 41, "duration_s": 2.38, "emotion": "calm", "text": "காய்ச்சலுங்களா? காலைல கிளினிக் வாங்கங்க."}, {"id": 42, "duration_s": 2.42, "emotion": "serious", "text": "டெங்கு டெஸ்ட் வேணுங்க. பயப்படாதீங்க."}, {"id": 43, "duration_s": 1.78, "emotion": "serious", "text": "ஊட்டைச் சுத்தி தண்ணி தேங்கியிருக்குதுங்களா?"}, {"id": 44, "duration_s": 1.1, "emotion": "proud", "text": "எங்க வீடு சுத்தம்!"}, {"id": 45, "duration_s": 3.17, "emotion": "serious", "text": "டெங்கு கொசு சுத்தமான தேங்குன தண்ணீலதானுங்க வளருது."}, {"id": 46, "duration_s": 2.652, "emotion": "happy", "text": "வாங்க, போலாம்!"}, {"id": 47, "duration_s": 1.32, "emotion": "giggly", "text": "...சேர்ந்தும் புட்டோம்."}, {"id": 48, "duration_s": 2.81, "emotion": "relieved", "text": "டெங்கு இல்ல. லேசான காய்ச்சல்தான்."}, {"id": 49, "duration_s": 1.9, "emotion": "pleading", "text": "அப்போ... லட்டு?"}, {"id": 50, "duration_s": 1.04, "emotion": "stern_warning", "text": "சரியானப்புறம். ஒண்ணே ஒண்ணு."}, {"id": 51, "duration_s": 2.4, "emotion": "shocked", "text": "ஒண்ணா?!"}, {"id": 52, "duration_s": 3.08, "emotion": "excited", "text": "ஒரு ஐடியா இருக்கு! நாம ஆகப்போறோம்..."}, {"id": 53, "duration_s": 1.21, "emotion": "excited", "text": "...கொசு ஒற்றர்கள்!"}, {"id": 54, "duration_s": 2.14, "emotion": "proud", "text": "நான் சொல்லவா? இந்தத் தடவை நிஜமா!"}, {"id": 55, "duration_s": 1.12, "emotion": "stern_warning", "text": "சொல்லு! சீக்கிரம்!"}, {"id": 56, "duration_s": 2.21, "emotion": "serious", "text": "டெங்கு கொசு பெரும்பாலும் பகல்லதான் கடிக்கும்."}, {"id": 57, "duration_s": 3.04, "emotion": "serious", "text": "சாக்கடையில இல்ல, சுத்தமா தேங்கின தண்ணில முட்டை போடும்."}, {"id": 58, "duration_s": 3.96, "emotion": "shocked", "text": "அப்போ அறிவு அண்ணன் அறிவியல்... தலைகீழ்!"}, {"id": 59, "duration_s": 3.76, "emotion": "serious", "text": "தண்ணில குட்டிக் குட்டிப் புழு தெரிஞ்சா, அது லார்வா."}, {"id": 60, "duration_s": 2.66, "emotion": "serious", "text": "ஒரு வாரத்துல, லார்வா கொசுவா!"}, {"id": 61, "duration_s": 2.35, "emotion": "determined", "text": "துப்பறிவாளர்களே! பழி வாங்குங்க!"}, {"id": 62, "duration_s": 4.68, "emotion": "determined", "text": "ஒவ்வொரு பாத்திரம்! ஒவ்வொரு தொட்டி! ஒவ்வொரு டயர்!"}, {"id": 63, "duration_s": 2.91, "emotion": "proud", "text": "உளவா? பெரியவங்க பாப்போம்!"}, {"id": 64, "duration_s": 0.75, "emotion": "angry", "text": "அமைதி!"}, {"id": 65, "duration_s": 2.0, "emotion": "excited", "text": "அப்படித் தொடங்கிச்சு... கொசு உளவு!"}, {"id": 66, "duration_s": 2.01, "emotion": "excited", "text": "கிடைச்சுடுச்சு! கூலர்ல லார்வா!"}, {"id": 67, "duration_s": 3.48, "emotion": "proud", "text": "என் கூலரா? இவங்க சும்மா... வாடகைக்காரங்க."}, {"id": 68, "duration_s": 2.89, "emotion": "scared_whisper", "text": "நான்... யாருக்கும்... பயப்படமாட்டேன்."}, {"id": 69, "duration_s": 2.18, "emotion": "panicked", "text": "செல்வி! இது வாடகை கேக்குது!"}, {"id": 70, "duration_s": 2.49, "emotion": "stern_warning", "text": "பட்டம்மா, பூந்தொட்டி தட்டுலயும்!"}, {"id": 71, "duration_s": 3.15, "emotion": "proud", "text": "என் தொட்டிக்கு தினமும் பூஜை நடக்குது!"}, {"id": 72, "duration_s": 2.56, "emotion": "sarcastic", "text": "பூஜையும், தண்ணியும்... கொசுவும்."}, {"id": 73, "duration_s": 1.9, "emotion": "determined", "text": "போதும்! இனி நான் பாக்கறேன்."}, {"id": 74, "duration_s": 2.85, "emotion": "proud", "text": "வாரம் காலி பண்ணி காய வைங்க. பத்து வினாடி."}, {"id": 75, "duration_s": 2.68, "emotion": "embarrassed", "text": "நானும்... உதவிதான் பண்ணிட்டிருந்தேன்."}, {"id": 76, "duration_s": 2.94, "emotion": "mischievous", "text": "மாடியில... சேகரோட பிசினஸ்."}, {"id": 77, "duration_s": 1.11, "emotion": "excited", "text": "டென்ஷன் ஆகாதீங்க!"}, {"id": 78, "duration_s": 5.01, "emotion": "proud", "text": "இதான் என் டயர் பிசினஸ்! இருபது டயர், அடுத்த வருஷம் இருபது லட்சம்!"}, {"id": 79, "duration_s": 3.29, "emotion": "serious", "text": "ஒரு டயர்ல... நூத்துக்கு மேல லார்வா."}, {"id": 80, "duration_s": 1.38, "emotion": "shocked", "text": "இருபது டயர்ல?"}, {"id": 81, "duration_s": 2.01, "emotion": "shocked", "text": "முழு கொசு காலனி!"}, {"id": 82, "duration_s": 2.6, "emotion": "mischievous", "text": "அப்போ... வாடகை வாங்கவா?"}, {"id": 83, "duration_s": 3.67, "emotion": "proud", "text": "என் ஊறுகாய்க்கு வெயில்! குறைஞ்சது நான்..."}, {"id": 84, "duration_s": 1.9, "emotion": "mischievous", "text": "பாட்டி... உங்க மூடியிலயும்."}, {"id": 85, "duration_s": 3.25, "emotion": "shocked", "text": "ஆத்தி! காலனியே பாக்குமே!"}, {"id": 86, "duration_s": 1.89, "emotion": "angry", "text": "எல்லாம் உன் டயராலதான்!"}, {"id": 87, "duration_s": 0.82, "emotion": "panicked", "text": "ஜாடியும்!"}, {"id": 88, "duration_s": 2.22, "emotion": "embarrassed", "text": "குறி... திரும்பவும் சரி."}, {"id": 89, "duration_s": 2.94, "emotion": "determined", "text": "டயர் தலைகீழ், தண்ணி வெளியே, பிசினஸ் உள்ளே!"}, {"id": 90, "duration_s": 2.37, "emotion": "excited", "text": "முருகேசன் மாடியில இருபது லட்சம்!"}, {"id": 91, "duration_s": 2.74, "emotion": "panicked", "text": "இருபது லட்சம்... கொசு! டெங்கு வந்துடுச்சு!"}, {"id": 92, "duration_s": 3.12, "emotion": "serious", "text": "கண்ணு பட்டுடுச்சு! வாசல்தோறும் எலுமிச்சை!"}, {"id": 93, "duration_s": 3.4, "emotion": "mischievous", "text": "கொசுவலை! இன்னிக்கு ரேட் டபுள்!"}, {"id": 94, "duration_s": 3.83, "emotion": "giggly", "text": "அப்புறம்... காலனியில பேய்கள் ஊர்வலம்."}, {"id": 95, "duration_s": 2.2, "emotion": "shouting", "text": "கொசுவுக்கும் விசாரணை உண்டு!"}, {"id": 96, "duration_s": 0.69, "emotion": "angry", "text": "அமைதி!"}, {"id": 97, "duration_s": 4.11, "emotion": "serious", "text": "புகை, எலுமிச்சை, பேட் இல்ல. தேங்கின நீர் கொட்டுங்க!"}, {"id": 98, "duration_s": 1.03, "emotion": "excited", "text": "ஒரு ஐடியா இருக்கு!"}, {"id": 99, "duration_s": 2.99, "emotion": "excited", "text": "சுத்தப் போட்டி! யார் அதிகம் தண்ணி கண்டுபிடிக்கிறாங்களோ!"}, {"id": 100, "duration_s": 3.34, "emotion": "determined", "text": "போட்டியா? முருகேசன்கள் தோக்கவே மாட்டோம்!"}, {"id": 101, "duration_s": 2.27, "emotion": "excited", "text": "காலனியோட முதல்... சுத்தப் போட்டி!"}, {"id": 102, "duration_s": 2.7, "emotion": "serious", "text": "விதி கேளுங்க! யாருக்கு அதிகமா..."}, {"id": 103, "duration_s": 2.78, "emotion": "serious", "text": "லார்வா, வாத்தியாரே! லார்வா!"}, {"id": 104, "duration_s": 2.64, "emotion": "shocked", "text": "லவ்வரா? இந்தக் காலனியில?"}, {"id": 105, "duration_s": 3.93, "emotion": "scared_whisper", "text": "யாருக்கு? எங்க? இந்த வயசுல?"}, {"id": 106, "duration_s": 2.45, "emotion": "sarcastic", "text": "கொசுவோட குழந்தை, வாத்தியாரே!"}, {"id": 107, "duration_s": 2.31, "emotion": "embarrassed", "text": "ஓ... அப்படின்னா சரி. ஆரம்பி!"}, {"id": 108, "duration_s": 3.29, "emotion": "tired", "text": "முழுக்கை... முழுசா வியர்வை!"}, {"id": 109, "duration_s": 2.48, "emotion": "giggly", "text": "ஆனா கொசு வழுக்கிடுச்சு!"}, {"id": 110, "duration_s": 2.1, "emotion": "determined", "text": "ஆயா, உங்க கிண்ணமும்!"}, {"id": 111, "duration_s": 2.38, "emotion": "embarrassed", "text": "கண்ணு... தண்ணிக்குத்தான் பட்டிருக்கு."}, {"id": 112, "duration_s": 3.7, "emotion": "happy", "text": "அட, மேல குளமே!"}, {"id": 113, "duration_s": 6.3, "emotion": "shouting", "text": "மழையா? சமோசா? விசாரணை!"}, {"id": 114, "duration_s": 3.33, "emotion": "mischievous", "text": "கந்தசாமி ஐயா, ஓசி வாடகைக்காரங்க!"}, {"id": 115, "duration_s": 3.92, "emotion": "sad", "text": "என் கடையில யாரும் ஓசியில இருக்க முடியாது!"}, {"id": 116, "duration_s": 2.6, "emotion": "proud", "text": "அறிவியல் சொல்லுது... இது நகராது."}, {"id": 117, "duration_s": 0.67, "emotion": "calm", "text": "நகரு."}, {"id": 118, "duration_s": 2.45, "emotion": "embarrassed", "text": "சயின்ஸ் சொல்லுது... பசங்கள கேளுங்க."}, {"id": 119, "duration_s": 2.15, "emotion": "excited", "text": "லைவ்-ல இருக்கோம்! ஹேஷ்டேக் கொசு-இல்லா!"}, {"id": 120, "duration_s": 3.64, "emotion": "proud", "text": "ஒரு மணில, காலனில ஒரு சொட்டு தேங்கின தண்ணி இல்ல."}, {"id": 121, "duration_s": 2.6, "emotion": "excited", "text": "பத்தாயிரம் வியூஸ்! காலனி வைரல்!"}, {"id": 122, "duration_s": 2.29, "emotion": "excited", "text": "கேட்டியா? இந்தத் தடவை நல்ல செய்தி!"}, {"id": 123, "duration_s": 3.32, "emotion": "proud", "text": "ரீல்ல முன்னாடி நான்தான்! காலனியே பாக்கும்!"}, {"id": 124, "duration_s": 3.44, "emotion": "proud", "text": "டெங்கு இல்லாத காலனி. லவ்வர் இல்லாததும்."}, {"id": 125, "duration_s": 2.22, "emotion": "sarcastic", "text": "லார்வா, வாத்தியாரே... லார்வா."}, {"id": 126, "duration_s": 3.38, "emotion": "happy", "text": "காலனி கொசுவை ஜெயிச்சுது... தண்ணியோட சண்டை போட்டு."}, {"id": 127, "duration_s": 2.61, "emotion": "stern_warning", "text": "டாக்டர் சொன்னார். ஒண்ணே ஒண்ணு."}, {"id": 128, "duration_s": 2.38, "emotion": "loving", "text": "ஒண்ணுதானே... மெதுவா சாப்பிடுவேன்."}, {"id": 129, "duration_s": 2.72, "emotion": "tired", "text": "போண்டா, இருபது நிமிஷம் ஆச்சுடா!"}, {"id": 130, "duration_s": 4.71, "emotion": "happy", "text": "சரியாயிடுச்சு! இப்போ... பசிக்குது!"}, {"id": 131, "duration_s": 3.26, "emotion": "proud", "text": "நான்தான் சொன்னேனே, நான் யாருக்கும் பயப்படமாட்டேன்."}, {"id": 132, "duration_s": 1.94, "emotion": "mischievous", "text": "ஙொய்ய்ய்..."}, {"id": 133, "duration_s": 1.55, "emotion": "calm", "text": "கேளு ஒற்றர்களே."}, {"id": 134, "duration_s": 3.47, "emotion": "serious", "text": "கொசுவோட சண்டையா? தண்ணியோட போடுங்க."}, {"id": 135, "duration_s": 5.95, "emotion": "serious", "text": "வாரத்துல ஒருதடவை, எல்லா பாத்திரமும் காலி, தொட்டி மூடி."}, {"id": 136, "duration_s": 4.33, "emotion": "loving", "text": "முழுக்கை சட்டை. காய்ச்சல்னா நேரா டாக்டர்."}, {"id": 137, "duration_s": 1.12, "emotion": "excited", "text": "கேஸ் குளோஸ்!"}, {"id": 138, "duration_s": 4.24, "emotion": "mischievous", "text": "காலனி திருந்துச்சு... ஆனா முருகேசன் கைதட்டல்?"}, {"id": 139, "duration_s": 1.6, "emotion": "scared_whisper", "text": "நாப்பத்தொண்ணாவது..."}]