[{"id": 1, "duration_s": 3.57, "emotion": "mischievous", "text": "ಇದು ನಮ್ಮ ಕಾಲೋನಿ, ಇದು ಅದ್ರ ದೊಡ್ಡ ಟ್ಯಾಂಕು."}, {"id": 2, "duration_s": 5.018, "emotion": "mischievous", "text": "ಈ ಟ್ಯಾಂಕ್ ಒಳಗೆ... ಒಂದು ಭೂತ ಇದೆ! ಊಊಊ!"}, {"id": 3, "duration_s": 1.61, "emotion": "curious", "text": "ಭೂತ ಇಲ್ಲ. ನಾ ಹೇಳ್ಲಾ?"}, {"id": 4, "duration_s": 1.23, "emotion": "stern_warning", "text": "ಚುಪ್!"}, {"id": 5, "duration_s": 3.57, "emotion": "mischievous", "text": "ನನ್ ನಿಧಿ... ಇಲ್ಲಿ ಯಾರೂ ಹುಡುಕಲ್ಲ."}, {"id": 6, "duration_s": 2.77, "emotion": "sarcastic", "text": "ನಿನ್ ಭೂತ... ಟಾರ್ಚ್‌ಗೆ ಹೆದರುತ್ತೆ."}, {"id": 7, "duration_s": 2.34, "emotion": "mischievous", "text": "ಭೂತ ನಿಜ! ಇವತ್ತು ರಾತ್ರಿ ನೋಡು!"}, {"id": 8, "duration_s": 1.53, "emotion": "calm", "text": "ಮಕ್ಳೇ! ಊಟ ರೆಡಿ!"}, {"id": 9, "duration_s": 1.81, "emotion": "giggly", "text": "ಬೊಂಡ ಆಗ್ಲೇ ತಲುಪಿದ!"}, {"id": 10, "duration_s": 6.499, "emotion": "scared_whisper", "text": "ಆಮೇಲೆ... ರಾತ್ರಿ ಸರಿಯಾಗಿ ಹನ್ನೆರಡು ಗಂಟೆಗೆ..."}, {"id": 11, "duration_s": 1.14, "emotion": "scared_whisper", "text": "ಭ... ಭ... ಭೂತ!"}, {"id": 12, "duration_s": 2.74, "emotion": "panicked", "text": "ಟ್ಯಾಂಕಿಗೆ... ದೃಷ್ಟಿ ಆಯ್ತು!"}, {"id": 13, "duration_s": 4.846, "emotion": "scared_whisper", "text": "ಸರಸು! ಏಳು! ಟ್ಯಾಂಕಲ್ಲಿ ಭೂತ!"}, {"id": 14, "duration_s": 3.65, "emotion": "comic_panic", "text": "ನಿಂಬೆ! ಮೆಣ್ಸು! ನಿಂಬೆ! ಮೆಣ್ಸು!"}, {"id": 15, "duration_s": 4.12, "emotion": "excited", "text": "ಚಂಪಾ? ಭೂತ? ಹ್ಞಾ! ನಿಜಾನಾ?"}, {"id": 16, "duration_s": 2.12, "emotion": "excited", "text": "ಗೊತ್ತಾ? ಟ್ಯಾಂಕಲ್ಲಿ ಭೂತ!"}, {"id": 17, "duration_s": 4.07, "emotion": "mischievous", "text": "ಹತ್ತೇ ಸೆಕೆಂಡಲ್ಲಿ... ಇಡೀ ಕಾಲೋನಿಗೆ ಗೊತ್ತಾಗಿತ್ತು."}, {"id": 18, "duration_s": 2.32, "emotion": "excited", "text": "ಹಲೋ ಫ್ರೆಂಡ್ಸ್! ಲೈವ್ ನಡೀತಿದೆ!"}, {"id": 19, "duration_s": 3.6, "emotion": "excited", "text": "ಭೂತ ಲೈವ್! ಎರಡು ಲಕ್ಷ ವೀಕ್ಷಕರು!"}, {"id": 20, "duration_s": 2.33, "emotion": "scared_whisper", "text": "ಭೂತಣ್ಣ, ಸೆಲ್ಫಿ ಪ್ಲೀಸ್?"}, {"id": 21, "duration_s": 3.89, "emotion": "proud", "text": "ವಿಜ್ಞಾನ ಹೇಳುತ್ತೆ... ಭೂತ ವೈಫೈನಿಂದ ಬರುತ್ತೆ!"}, {"id": 22, "duration_s": 2.1, "emotion": "proud", "text": "ವೈಫೈ ಆಫ್. ಭೂತ ಮಾಯ."}, {"id": 23, "duration_s": 4.36, "emotion": "serious", "text": "ಶ್ರುತಿ ತಪ್ಪು. ಹತ್ತರಲ್ಲಿ ನಾಲ್ಕು."}, {"id": 24, "duration_s": 1.24, "emotion": "happy", "text": "ಹ್ಞಾಂ! ಈಗ ಏಳು!"}, {"id": 25, "duration_s": 1.84, "emotion": "proud", "text": "ಭೂತ ಗೀತ ಏನೂ ಇಲ್ಲ!"}, {"id": 26, "duration_s": 1.59, "emotion": "proud", "text": "ನಾನ್ಯಾರಿಗೂ ಹೆದ್ರಲ್ಲ!"}, {"id": 27, "duration_s": 2.79, "emotion": "sarcastic", "text": "ನಿನ್ನೆ ಹಲ್ಲಿಗೆ ಹೆದರಿ ಕಪಾಟು ಹತ್ತಿದ್ದ್ಯಾರು?"}, {"id": 28, "duration_s": 3.69, "emotion": "embarrassed", "text": "ಅದು... ಕಪಾಟಿನ ಧೂಳು ನೋಡ್ತಿದ್ದೆ."}, {"id": 29, "duration_s": 2.56, "emotion": "proud", "text": "ಹೋಗು ಮಗನೇ! ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ!"}, {"id": 30, "duration_s": 5.78, "emotion": "scared_whisper", "text": "ಭೂತಣ್ಣ... ನಾನು ಸುಮ್ನೆ... ವಾಕಿಂಗ್ ಬಂದೆ."}, {"id": 31, "duration_s": 3.538, "emotion": "sarcastic", "text": "ಬಂದ್ರಾ? ವಾಕಿಂಗ್ ಆಯ್ತಾ?"}, {"id": 32, "duration_s": 2.87, "emotion": "scared_whisper", "text": "ಹೂಂ... ತುಂಬಾ... ಒಳ್ಳೆ ಗಾಳಿ ಇದೆ."}, {"id": 33, "duration_s": 2.72, "emotion": "guilty", "text": "ನಾನು ಸುಮ್ನೆ... ತಮಾಷೆ ಮಾಡ್ದೆ."}, {"id": 34, "duration_s": 3.07, "emotion": "mischievous", "text": "ಟೆನ್ಷನ್ ಬೇಡ! ಭೂತ ಇದ್ರೆ ಬ್ಯುಸಿನೆಸ್!"}, {"id": 35, "duration_s": 4.22, "emotion": "mischievous", "text": "ಮರುದಿನ... ಕಾಲೋನಿಗೆ ಭಯ. ದಾಸಪ್ಪಂಗೆ ಖುಷಿ."}, {"id": 36, "duration_s": 2.2, "emotion": "comic_panic", "text": "ಭೂತದ ನೀರಾ? ಬೇಡಪ್ಪ ಬೇಡ!"}, {"id": 37, "duration_s": 1.59, "emotion": "sarcastic", "text": "ಮತ್ತೆ ಚಹಾ ಯಾವುದ್ರಲ್ಲಿ ಮಾಡ್ಲಿ?"}, {"id": 38, "duration_s": 3.3, "emotion": "proud", "text": "ಒಂದು ಬಕೆಟ್, ಎರಡು ರೂಪಾಯಿ! ಲೈನಲ್ಲಿ!"}, {"id": 39, "duration_s": 1.75, "emotion": "serious", "text": "ನಾಯಿಗೂ ಎರಡು ರೂಪಾಯಿ."}, {"id": 40, "duration_s": 1.69, "emotion": "proud", "text": "ಒಂದ್ರೂಪಾಯಿ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 41, "duration_s": 2.69, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪ! ಮನೆಯವರ ಹತ್ರಾನೂ ದುಡ್ಡಾ?"}, {"id": 42, "duration_s": 3.86, "emotion": "embarrassed", "text": "ಮನೆಯವರಿಗೆ... ಅರ್ಧ ರೇಟು."}, {"id": 43, "duration_s": 2.75, "emotion": "comic_panic", "text": "ಬೊಂಡ! ಇದು ನಲವತ್ತು ಬಕೆಟ್ ಆಯ್ತು!"}, {"id": 44, "duration_s": 1.74, "emotion": "happy", "text": "ದಾಹನೂ ಆಗಿತ್ತು."}, {"id": 45, "duration_s": 1.86, "emotion": "happy", "text": "ಬನ್ನಿ ಹೋಗೋಣ! ನೀರು ತರೋಕೆ!"}, {"id": 46, "duration_s": 1.49, "emotion": "sad", "text": "ಇವತ್ತೂ ಇಲ್ವಾ, ರಾಣಿ?"}, {"id": 47, "duration_s": 2.54, "emotion": "excited", "text": "ಗೊತ್ತಾ? ಭೂತ ರಾತ್ರಿ ನನ್ ಹೆಸ್ರು ಕರೀತು!"}, {"id": 48, "duration_s": 2.64, "emotion": "proud", "text": "ಹೂಂ! ನಂದು ಎರಡ್ಸಲ ಕರೀತು!"}, {"id": 49, "duration_s": 3.13, "emotion": "proud", "text": "ವಿಜ್ಞಾನ ಹೇಳುತ್ತೆ... ಭೂತಕ್ಕೆ ತಣ್ಣೀರು ಇಷ್ಟ."}, {"id": 50, "duration_s": 0.42, "emotion": "stern_warning", "text": "ಚುಪ್!"}, {"id": 51, "duration_s": 2.44, "emotion": "curious", "text": "ನಾ ಹೇಳ್ಲಾ? ಆಮೇಲೆ."}, {"id": 52, "duration_s": 3.68, "emotion": "excited", "text": "ಅಣ್ಣ-ತಂಗೀರೇ! ಭೂತದ ಭಯಾನಾ? ಟೆನ್ಷನ್ ಬೇಡ!"}, {"id": 53, "duration_s": 2.88, "emotion": "proud", "text": "ಪ್ರಸ್ತುತ... ತಾಂತ್ರಿಕ ಸೀನಾ ಬಾಬಾ!"}, {"id": 54, "duration_s": 4.33, "emotion": "serious", "text": "ಅಲಖ್ ನಿರಂಜನ! ಭೂತ... ತುಂಬಾ ದೊಡ್ಡದು ಉಂಟು."}, {"id": 55, "duration_s": 2.69, "emotion": "embarrassed", "text": "ಹೆ ಹೆ... ಇದು ಬಾಬಾನ... ಉಲ್ಟಾ ಯೋಗ!"}, {"id": 56, "duration_s": 1.8, "emotion": "curious", "text": "ಗಡ್ಡ... ಉಲ್ಟಾ ಇದೆ."}, {"id": 57, "duration_s": 1.08, "emotion": "serious", "text": "ನೋಟ್ ಮಾಡು!"}, {"id": 58, "duration_s": 4.0, "emotion": "proud", "text": "ಭೂತ-ಪ್ರೂಫ್ ನಿಂಬೆ ಮಾರಾಯ! ಐನೂರು ಮಾತ್ರ!"}, {"id": 59, "duration_s": 4.46, "emotion": "shocked", "text": "ಐನೂರಾ? ನನ್ ಅಂಗಡೀಲಿ ಎರಡು ರೂಪಾಯಿ!"}, {"id": 60, "duration_s": 2.34, "emotion": "comic_panic", "text": "ಎರಡು! ಬೇಗ!"}, {"id": 61, "duration_s": 1.87, "emotion": "excited", "text": "ಬಾಬಾ, ನಂಗೆ ನಿಂಬೆ-ಮೆಣಸಿನ ಕಾಂಬೋ!"}, {"id": 62, "duration_s": 2.73, "emotion": "proud", "text": "ಎಂಟು ನಿಂಬೆ! ಪೂರ್ತಿ ಎಂಟು!"}, {"id": 63, "duration_s": 4.62, "emotion": "proud", "text": "ಎಂಟಾ? ಹೂಂ! ಹತ್ತು ಕೊಡಿ! ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ!"}, {"id": 64, "duration_s": 1.56, "emotion": "happy", "text": "ಹತ್ತು! ಒಂದು ಫ್ರೀ!"}, {"id": 65, "duration_s": 2.12, "emotion": "angry", "text": "ಹಲೋ? ಬಾಬಾಜಿ, ಹನ್ನೆರಡು ಸಿಗುತ್ತಾ?"}, {"id": 66, "duration_s": 2.1, "emotion": "proud", "text": "ಈಗ ನಾನ್ಯಾರಿಗೂ ಹೆದ್ರಲ್ಲ!"}, {"id": 67, "duration_s": 1.126, "emotion": "sarcastic", "text": "ಹಲ್ಲಿಗೂ?"}, {"id": 68, "duration_s": 2.055, "emotion": "sarcastic", "text": "ತುಂಬಾ ಉಪಯೋಗ ಆದ್ವು ನಿಂಬೆ."}, {"id": 69, "duration_s": 2.72, "emotion": "sarcastic", "text": "ಐದು ಸಾವಿರದ ನಿಂಬೆ, ಮಾವ!"}, {"id": 70, "duration_s": 1.59, "emotion": "calm", "text": "ಪಾನಕ ಚೆನ್ನಾಗಿ ಆಗುತ್ತೆ."}, {"id": 71, "duration_s": 4.39, "emotion": "mischievous", "text": "ಸಂಜೆಗೆ ಕಾಲೋನಿಲಿ ಜನ ಕಮ್ಮಿ, ನಿಂಬೆ ಜಾಸ್ತಿ."}, {"id": 72, "duration_s": 4.32, "emotion": "mischievous", "text": "ಇವತ್ತು ರಾತ್ರಿ ಒಂದು ಜೋರಾದ 'ಊಊಊ' ಬೇಕು."}, {"id": 73, "duration_s": 3.26, "emotion": "mischievous", "text": "ಗಾಳಿ ಬೀಸಿದ್ರೆ... ಡಬಲ್ ಧಂದೆ ಮಾರಾಯ!"}, {"id": 74, "duration_s": 3.35, "emotion": "mischievous", "text": "ರಾತ್ರಿಗೆ... ಇಡೀ ಕಾಲೋನಿ ಅಜ್ಜನ ಅಂಗಳದಲ್ಲಿ."}, {"id": 75, "duration_s": 6.081, "emotion": "tired", "text": "ತನಿಖೆ... ಆಗುತ್ತೆ... ಗೊರ್ರ್..."}, {"id": 76, "duration_s": 3.91, "emotion": "serious", "text": "ವಿಜ್ಞಾನ ಹೇಳುತ್ತೆ, ಭೂತ ಸರಿಯಾಗಿ ಹನ್ನೆರಡಕ್ಕೆ ಬರುತ್ತೆ."}, {"id": 77, "duration_s": 2.41, "emotion": "tired", "text": "ಇನ್ನೂ ಹನ್ನೊಂದೂವರೆ. ಮಲಕ್ಕೊಳ್ಳಿ."}, {"id": 78, "duration_s": 1.66, "emotion": "angry", "text": "ಗೊತ್ತಾ? ಕಳ್ಳತನ!"}, {"id": 79, "duration_s": 3.17, "emotion": "guilty", "text": "ಇದೆಲ್ಲಾ... ನನ್ ಕಥೆಯಿಂದ ಆಗಿದ್ದು."}, {"id": 80, "duration_s": 1.19, "emotion": "serious", "text": "ಚುಪ್! ಕೇಳು."}, {"id": 81, "duration_s": 4.1, "emotion": "shouting", "text": "ಯಾರು? ತನಿಖೆ ಆಗ್ಲಿ!"}, {"id": 82, "duration_s": 1.92, "emotion": "excited", "text": "ವಾಹ್! ಹತ್ತರಲ್ಲಿ ಹತ್ತು!"}, {"id": 83, "duration_s": 1.96, "emotion": "comic_panic", "text": "ಭೂತ! ಭೂತ! ಭೂತ!"}, {"id": 84, "duration_s": 0.72, "emotion": "panicked", "text": "ಭೂತ!"}, {"id": 85, "duration_s": 2.39, "emotion": "comic_panic", "text": "ನಾನು! ಶಿವಣ್ಣ!"}, {"id": 86, "duration_s": 1.58, "emotion": "panicked", "text": "ಭೂತ ಮಾತಾಡ್ತಿದೆ ಬೇರೆ!"}, {"id": 87, "duration_s": 2.32, "emotion": "determined", "text": "ಭೂತ? ನನ್ ಚಪ್ಪಲಿ ನೋಡು!"}, {"id": 88, "duration_s": 3.83, "emotion": "embarrassed", "text": "ಅಮ್ಮಾ... ಗುರಿ... ಇನ್ನೂ... ಸೂಪರ್ ಆಗಿದೆ."}, {"id": 89, "duration_s": 2.02, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ಐದು ಲಕ್ಷ!"}, {"id": 90, "duration_s": 2.11, "emotion": "comic_panic", "text": "ಬನ್ನಿ! ಎಲ್ರೂ ಆಟೋದಲ್ಲಿ!"}, {"id": 91, "duration_s": 1.82, "emotion": "determined", "text": "ಸಾಕು! ಈಗ ನಾನು ನೋಡ್ತೀನಿ!"}, {"id": 92, "duration_s": 3.76, "emotion": "calm", "text": "ಸೊಸೆ, ಸ್ವಲ್ಪ ಎಣಿಸು. ಮಕ್ಕಳೆಲ್ಲಿ?"}, {"id": 93, "duration_s": 3.05, "emotion": "determined", "text": "ನಂಗೊಂದು ಐಡಿಯಾ! ಭೂತಕ್ಕೇ ಪ್ರಶ್ನೆ ಕೇಳೋಣ."}, {"id": 94, "duration_s": 2.89, "emotion": "curious", "text": "ನಾ ಹೇಳ್ಲಾ? ಪ್ರಶ್ನೆ ಕಂಡ್ರೆ ಭಯ ಓಡುತ್ತೆ."}, {"id": 95, "duration_s": 1.32, "emotion": "stern_warning", "text": "ಚುಪ್! ಮೊದ್ಲು ನಾನು."}, {"id": 96, "duration_s": 2.08, "emotion": "proud", "text": "ನಾನು... ತಿಂಡಿ ಕಾಯ್ತೀನಿ."}, {"id": 97, "duration_s": 3.14, "emotion": "sarcastic", "text": "ಭೂತ ಸಿಕ್ತು. ತಿಂಡಿಪೋತ ಭೂತ."}, {"id": 98, "duration_s": 2.76, "emotion": "curious", "text": "ನೋಡಿ! ಗಾಳಿ ಬೀಸಿದ್ರೇನೇ ಸದ್ದು ಬರೋದು!"}, {"id": 99, "duration_s": 2.94, "emotion": "laughing", "text": "ಭೂತ... ನನ್ ಬೆರಳಿಗೆ ಹೆದರುತ್ತೆ!"}, {"id": 100, "duration_s": 3.74, "emotion": "proud", "text": "ಗಾಳಿ, ಪೈಪು, ಬಿರುಕು. ಭೂತ ನಂಬರ್ ಒಂದು ಸಾಲ್ವ್."}, {"id": 101, "duration_s": 4.09, "emotion": "curious", "text": "ಸದ್ದು ಪೈಪು. ಕಣ್ಣುಗಳು?"}, {"id": 102, "duration_s": 2.8, "emotion": "proud", "text": "ಟಾರ್ಚ್ ಬೆಳಕು, ಬೆಕ್ಕಿನ ಕಣ್ಣಲ್ಲಿ ಹೊಳೆಯುತ್ತೆ."}, {"id": 103, "duration_s": 1.81, "emotion": "happy", "text": "ಭೂತ ಅಲ್ಲ, ಬೆಕ್ಕು!"}, {"id": 104, "duration_s": 3.13, "emotion": "stern_warning", "text": "ಒಳಗೆ ಯಾರೂ ಹೋಗಲ್ಲ. ಬೊಂಡ, ಚೀಲ ಕೊಡು!"}, {"id": 105, "duration_s": 2.63, "emotion": "sad", "text": "ನನ್ ಸಮೋಸ-ಬಿಸ್ಕತ್... ಟಾಟಾ."}, {"id": 106, "duration_s": 1.66, "emotion": "happy", "text": "ಬಾ ಪುಟ್ಟ ಭೂತ!"}, {"id": 107, "duration_s": 2.22, "emotion": "tender", "text": "ಇದು ಬಿಸ್ಕತ್ ತಿನ್ನೋಕೆ ಒಳಗೆ ಹೋಗಿತ್ತು."}, {"id": 108, "duration_s": 2.24, "emotion": "surprised", "text": "ಅರೆ! ಒಳಗೆ ಒಂದು ಡಬ್ಬಾನೂ ಇದೆ!"}, {"id": 109, "duration_s": 4.96, "emotion": "embarrassed", "text": "ಹಸಿವಾಗಿತ್ತು! ಅದೇ ತಂಪಾದ ಜಾಗ!"}, {"id": 110, "duration_s": 1.3, "emotion": "stern_warning", "text": "ಚುಪ್! ...ಸರಿ, ಒಂದು ಕೊಡು."}, {"id": 111, "duration_s": 3.27, "emotion": "shouting", "text": "ನಿಲ್ಲಿ! ಭೂತ ತುಂಬಾ ಅಪಾಯಕಾರಿ ಉಂಟು!"}, {"id": 112, "duration_s": 1.27, "emotion": "proud", "text": "ಇದೇ ನಿಮ್ಮ ಭೂತ!"}, {"id": 113, "duration_s": 3.57, "emotion": "excited", "text": "ಹತ್ತು ಲಕ್ಷ! ಭೂತ ಅಲ್ಲ, ಬೆಕ್ಕು ವೈರಲ್!"}, {"id": 114, "duration_s": 2.786, "emotion": "proud", "text": "ಇದೇ ಭೂತದ ಹಾಡು. ಒಡೆದ ಪೈಪು."}, {"id": 115, "duration_s": 4.14, "emotion": "proud", "text": "ವಿಜ್ಞಾನ ಹೇಳುತ್ತೆ... ನಂಗೆ ಮೊದ್ಲೇ ಗೊತ್ತಿತ್ತು."}, {"id": 116, "duration_s": 1.77, "emotion": "shocked", "text": "ಅರೆ! ಇವ ಜಾತ್ರೆ ಬಲೂನ್ ಮಾರೋನು!"}, {"id": 117, "duration_s": 1.812, "emotion": "excited", "text": "ಗೊತ್ತಾ? ಬಾಬಾ ನಕಲಿ!"}, {"id": 118, "duration_s": 1.78, "emotion": "comic_panic", "text": "ಹೆ ಹೆ... ಬಾಬಾನ ಟೈಮ್ ಮುಗೀತು!"}, {"id": 119, "duration_s": 2.71, "emotion": "angry", "text": "ನನ್ ನಿಂಬೆಯ ಸಾವಿರ ರೂಪಾಯಿ!"}, {"id": 120, "duration_s": 1.45, "emotion": "shouting", "text": "ಒಂದ್ರೂಪಾಯಿ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 121, "duration_s": 2.0, "emotion": "stern_warning", "text": "ಸೀನಾ! ದುಡ್ಡು ವಾಪಸ್!"}, {"id": 122, "duration_s": 2.99, "emotion": "embarrassed", "text": "ಟೆನ್ಷನ್ ಬೇಡ, ಅತ್ತಿಗೆ... ಎಲ್ರಿಗೂ ವಾಪಸ್!"}, {"id": 123, "duration_s": 1.73, "emotion": "determined", "text": "ಮತ್ತೆ ನನ್ ಹತ್ತು ನಿಂಬೆ?"}, {"id": 124, "duration_s": 1.98, "emotion": "embarrassed", "text": "ಚಪ್ಪಲಿ... ಯಾವತ್ತೂ ತಪ್ಪಲ್ಲ."}, {"id": 125, "duration_s": 3.84, "emotion": "sad", "text": "ಸಾವಿರ ರೂಪಾಯಿಗೆ... ಒಂದು ಚಪ್ಪಲಿ."}, {"id": 126, "duration_s": 5.14, "emotion": "mischievous", "text": "ಟ್ಯಾಂಕ್ ಸುಮ್ಮನಾಯ್ತು... ಈಗ ದಾಸಪ್ಪ 'ಊಊಊ' ಅಂತಿದ್ರು."}, {"id": 127, "duration_s": 2.13, "emotion": "happy", "text": "ಹೋಗ್ಲಿ! ಭೂತಕ್ಕೆ ರಜೆ!"}, {"id": 128, "duration_s": 3.19, "emotion": "proud", "text": "ಭೂತ-ಪ್ರೂಫ್ ನಿಂಬೆ... ಈಗ ಬಾಯಾರಿಕೆ-ಪ್ರೂಫ್!"}, {"id": 129, "duration_s": 2.62, "emotion": "proud", "text": "ನನ್ ಗ್ಲಾಸ್ ದೊಡ್ಡದು. ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ!"}, {"id": 130, "duration_s": 3.121, "emotion": "embarrassed", "text": "ದೃಷ್ಟಿ ಅಲ್ಲ... ಬಾಯಾರಿಕೆ ಆಗಿದೆ."}, {"id": 131, "duration_s": 2.694, "emotion": "guilty", "text": "ಗೊತ್ತಾ? ...ಮೊದ್ಲು ಪರೀಕ್ಷೆ ಮಾಡ್ತೀನಿ."}, {"id": 132, "duration_s": 3.5, "emotion": "happy", "text": "ಹಸಿವಲ್ಲ... ಇವತ್ತು ಬಾಯಾರಿಕೆ!"}, {"id": 133, "duration_s": 4.09, "emotion": "guilty", "text": "ಅಜ್ಜ, ಎಲ್ಲಾ ನನ್ ಭೂತದ ಕಥೆಯಿಂದ ಶುರುವಾಯ್ತು."}, {"id": 134, "duration_s": 4.55, "emotion": "serious", "text": "ಭಯಕ್ಕೆ ಮದ್ದು ಪ್ರಶ್ನೆ... ಬಾಬಾ ಅಲ್ಲ."}, {"id": 135, "duration_s": 4.64, "emotion": "calm", "text": "ಮೊದ್ಲು ಕೇಳು, ಪರೀಕ್ಷಿಸು, ಆಮೇಲೆ ನಂಬು."}, {"id": 136, "duration_s": 2.8, "emotion": "proud", "text": "ಭಯ ಮಾರೋರಿಗೆ... ದುಡ್ಡಿಲ್ಲ!"}, {"id": 137, "duration_s": 2.0, "emotion": "stern_warning", "text": "ಕೇಳ್ಸಿತಾ? ಈಗ ಚುಪ್!"}, {"id": 138, "duration_s": 3.16, "emotion": "proud", "text": "ನಾ ಹೇಳಿದ್ನಲ್ಲ? ನಾನ್ಯಾರಿಗೂ ಹೆದ್ರಲ್ಲ!"}]