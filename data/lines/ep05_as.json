[{"id": 1, "duration_s": 3.0, "emotion": "excited", "text": "পাৰাৰ আটাইতকৈ ডাঙৰ যুঁজ... ৰছীটনা!"}, {"id": 2, "duration_s": 3.93, "emotion": "proud", "text": "সাত দিনৰ পাউদাৰ! মই কাকো নডৰোঁ!"}, {"id": 3, "duration_s": 2.11, "emotion": "calm", "text": "ধনৰাম দা, চাহ গৰম ৰাখিবা।"}, {"id": 4, "duration_s": 1.94, "emotion": "excited", "text": "লাইভ চলিছে! শ্ল' মোছনত!"}, {"id": 5, "duration_s": 2.54, "emotion": "mischievous", "text": "সকলো শুৰু... এটা কৌটাৰ পৰা।"}, {"id": 6, "duration_s": 2.46, "emotion": "happy", "text": "সাত দিন আগতে। পাৰাৰ খেল সপ্তাহ।"}, {"id": 7, "duration_s": 3.82, "emotion": "excited", "text": "এই দেওবাৰে ৰছীটনা! বৰুৱা পৰিয়াল বনাম ধনৰাম পৰিয়াল!"}, {"id": 8, "duration_s": 3.83, "emotion": "proud", "text": "বৰুৱা জিকিব! মই কাকো নডৰোঁ!"}, {"id": 9, "duration_s": 3.62, "emotion": "sarcastic", "text": "হিচাপ কৰিলোঁ। বৰুৱা জিকাৰ সম্ভাৱনা... শূন্য।"}, {"id": 10, "duration_s": 1.32, "emotion": "sarcastic", "text": "কাকো নডৰে, হৰি?"}, {"id": 11, "duration_s": 2.37, "emotion": "comic_panic", "text": "কাকো নহয়! টিকটিকী... কোনো নাই!"}, {"id": 12, "duration_s": 2.17, "emotion": "stern_warning", "text": "চুপ! কাকাই আকৌ জঁপিয়াব।"}, {"id": 13, "duration_s": 1.35, "emotion": "happy", "text": "বলা, যাওঁ বলা!"}, {"id": 14, "duration_s": 1.9, "emotion": "calm", "text": "আতৰা ভাই, মই চাওঁ।"}, {"id": 15, "duration_s": 2.45, "emotion": "shocked", "text": "বৌ, আপুনি ট্ৰেক্টৰো টানিব!"}, {"id": 16, "duration_s": 1.19, "emotion": "excited", "text": "টেনচন নলবা, দাদা!"}, {"id": 17, "duration_s": 2.56, "emotion": "worried", "text": "টেনচন? অটোটো টানিলে, ধনু!"}, {"id": 18, "duration_s": 3.62, "emotion": "proud", "text": "মোৰ ল'ৰা জিকিব! গোটেই পাৰাই চাব!"}, {"id": 19, "duration_s": 3.5, "emotion": "mischievous", "text": "শুনিলা? হৰি দা টিকটিকীৰ হাতত হাৰিল!"}, {"id": 20, "duration_s": 2.82, "emotion": "sad", "text": "চিপ্স ক'ত গ'ল? ভোক লাগিছে!"}, {"id": 21, "duration_s": 2.9, "emotion": "excited", "text": "সুলতান পাৱাৰ পাউদাৰ! সাত দিনত বডি!"}, {"id": 22, "duration_s": 3.26, "emotion": "excited", "text": "মাত্ৰ ন শ নিৰানব্বৈ! এক্সপ্ৰেছ ডেলিভাৰি!"}, {"id": 23, "duration_s": 2.01, "emotion": "excited", "text": "এটা বুদ্ধি আছে! দেউতাৰ বাবে!"}, {"id": 24, "duration_s": 3.45, "emotion": "excited", "text": "দেউতা! সাত দিনত বডি! দেওবাৰো সাত দিনত!"}, {"id": 25, "duration_s": 2.59, "emotion": "excited", "text": "সুলতান... বডি... সাত দিন!"}, {"id": 26, "duration_s": 1.42, "emotion": "sarcastic", "text": "সাত দিনত আচাৰো নপকে!"}, {"id": 27, "duration_s": 2.64, "emotion": "proud", "text": "এইটো বিজ্ঞান, ৰূপা! অৰ্ডাৰ!"}, {"id": 28, "duration_s": 3.04, "emotion": "proud", "text": "মোৰ ল'ৰা সুলতান হ'ব! গোটেই পাৰাই চাব!"}, {"id": 29, "duration_s": 2.24, "emotion": "curious", "text": "পাউদাৰ মিঠা হ'বনে? মোকো লাগে।"}, {"id": 30, "duration_s": 2.78, "emotion": "excited", "text": "সুলতান পাউদাৰ! এক্সপ্ৰেছ ডেলিভাৰি!"}, {"id": 31, "duration_s": 1.54, "emotion": "loving", "text": "আহিল মোৰ সুলতান!"}, {"id": 32, "duration_s": 0.58, "emotion": "mischievous", "text": "শুনিলা? হৰি দাই কৌটাত বডি মগালে!"}, {"id": 33, "duration_s": 1.6, "emotion": "determined", "text": "আহ! শক্তি আহিছে!"}, {"id": 34, "duration_s": 0.913, "emotion": "curious", "text": "দেউতা... মাছল ক'ত লুকাইছে?"}, {"id": 35, "duration_s": 0.55, "emotion": "excited", "text": "আহিল! এডালি নোম থিয় হ'ল!"}, {"id": 36, "duration_s": 0.52, "emotion": "shocked", "text": "শুনিছানে? বৰুৱাৰ বুটাম বৰষিছে!"}, {"id": 37, "duration_s": 0.24, "emotion": "embarrassed", "text": "বডি ডাঙৰ হৈছে, বাইদেউ!"}, {"id": 38, "duration_s": 0.17, "emotion": "shocked", "text": "আধা ইঞ্চি..."}, {"id": 39, "duration_s": 0.57, "emotion": "shocked", "text": "...কমিল!"}, {"id": 40, "duration_s": 0.342, "emotion": "proud", "text": "ভিতৰৰ পৰা বাঢ়িছে!"}, {"id": 41, "duration_s": 0.56, "emotion": "happy", "text": "শুঙিলেও শক্তি আহে!"}, {"id": 42, "duration_s": 2.84, "emotion": "worried", "text": "হৰি, নাকত নিদিবা!"}, {"id": 43, "duration_s": 0.873, "emotion": "comic_panic", "text": "আ... আ... আ..."}, {"id": 44, "duration_s": 1.97, "emotion": "proud", "text": "দেখিলা? পাউদাৰে বাহিৰৰ পৰাও কাম কৰে!"}, {"id": 45, "duration_s": 1.74, "emotion": "determined", "text": "বাস! এতিয়া মই চাওঁ।"}, {"id": 46, "duration_s": 4.05, "emotion": "shocked", "text": "হায় হায়! মোৰ সুলতান বৰফৰ পুতলা হ'ল!"}, {"id": 47, "duration_s": 1.86, "emotion": "serious", "text": "ৰ'ব! বিজ্ঞানে কয়..."}, {"id": 48, "duration_s": 3.49, "emotion": "proud", "text": "এইটো এশ শতাংশ চক!"}, {"id": 49, "duration_s": 5.519, "emotion": "laughing", "text": "<laugh> পণ্ডিত পবিত্ৰৰ বিজ্ঞান? তেন্তে ভুলেই!"}, {"id": 50, "duration_s": 3.87, "emotion": "giggly", "text": "পণ্ডিত পবিত্ৰে কৈছিল, ডাৱৰ ছিলিণ্ডাৰত হয়!"}, {"id": 51, "duration_s": 2.44, "emotion": "giggly", "text": "আৰু কুকুৰাই গাখীৰ দিয়ে!"}, {"id": 52, "duration_s": 4.59, "emotion": "laughing", "text": "আৰু জোনত চাহৰ দোকান আছে!"}, {"id": 53, "duration_s": 1.68, "emotion": "pleading", "text": "কিন্তু এইবাৰ সঁচাকৈয়ে!"}, {"id": 54, "duration_s": 2.41, "emotion": "serious", "text": "মোৰ সুলতানক নজৰ নলগাক!"}, {"id": 55, "duration_s": 2.13, "emotion": "proud", "text": "সুলতান দেওবাৰে দেখা যাব!"}, {"id": 56, "duration_s": 3.65, "emotion": "sad", "text": "চোৱা... লিখেও। কোনেও নেচায়।"}, {"id": 57, "duration_s": 2.16, "emotion": "excited", "text": "টেনচন নলবা! এইটো সোণৰ খনি!"}, {"id": 58, "duration_s": 1.82, "emotion": "mischievous", "text": "এশত লোৱা, দুশত বেচা!"}, {"id": 59, "duration_s": 2.438, "emotion": "mischievous", "text": "ধনৰাম দা, ডিলাৰশ্বিপ! পঞ্চাশ কৌটা!"}, {"id": 60, "duration_s": 4.84, "emotion": "curious", "text": "পঞ্চাশটা সুলতান? হিচাপ কৰোঁ।"}, {"id": 61, "duration_s": 2.32, "emotion": "serious", "text": "পাঁচ হাজাৰ। দুবাৰ গণিলোঁ... তৃতীয়বাৰো।"}, {"id": 62, "duration_s": 2.65, "emotion": "pleading", "text": "এটকাও কম নহয়!"}, {"id": 63, "duration_s": 0.88, "emotion": "stern_warning", "text": "ধনৰাম!"}, {"id": 64, "duration_s": 3.1, "emotion": "embarrassed", "text": "মনি, এইটো ব্যৱসায়! দুগুণ লাভ!"}, {"id": 65, "duration_s": 1.68, "emotion": "sarcastic", "text": "নে দুগুণ লোকচান?"}, {"id": 66, "duration_s": 2.3, "emotion": "proud", "text": "পঞ্চাশ কৌটা! গোটেই পাৰা সুলতান হ'ব!"}, {"id": 67, "duration_s": 2.32, "emotion": "happy", "text": "মই একো খোৱা নাই।"}, {"id": 68, "duration_s": 1.85, "emotion": "surprised", "text": "ই মিঠা নহয়... চক!"}, {"id": 69, "duration_s": 1.78, "emotion": "shouting", "text": "চুপ! ব্যৱসায়!"}, {"id": 70, "duration_s": 3.25, "emotion": "mischievous", "text": "ট্ৰেইনিং সপ্তাহ। কোচ... ধনু।"}, {"id": 71, "duration_s": 3.07, "emotion": "proud", "text": "কোচ ধনু! তোমালোকে দৌৰা, মই গণোঁ।"}, {"id": 72, "duration_s": 2.01, "emotion": "proud", "text": "দৌৰিম কিয়? পাউদাৰ আছেই!"}, {"id": 73, "duration_s": 2.04, "emotion": "determined", "text": "আজি গছ উভালিয়েই ছাড়িম!"}, {"id": 74, "duration_s": 2.45, "emotion": "worried", "text": "তিনি খোজ! জোতা ক্ষয় হ'লে?"}, {"id": 75, "duration_s": 1.4, "emotion": "proud", "text": "এয়া মোৰ ট্ৰেইনিং!"}, {"id": 76, "duration_s": 1.38, "emotion": "calm", "text": "মোক ট্ৰেইনিং নালাগে।"}, {"id": 77, "duration_s": 1.85, "emotion": "tired", "text": "দেউতা, কি পাউদাৰ খোৱা?"}, {"id": 78, "duration_s": 0.962, "emotion": "calm", "text": "ৰুটী।"}, {"id": 79, "duration_s": 0.818, "emotion": "stern_warning", "text": "ৰুটী খোৱা!"}, {"id": 80, "duration_s": 1.759, "emotion": "proud", "text": "সুলতানে ৰুটী নাখায়!"}, {"id": 81, "duration_s": 1.81, "emotion": "curious", "text": "ছয় দিন হ'ল। মাছল?"}, {"id": 82, "duration_s": 1.47, "emotion": "sarcastic", "text": "চুপ! ভিতৰত বাঢ়িছে।"}, {"id": 83, "duration_s": 1.3, "emotion": "determined", "text": "মোৰ দেউতা সুলতান!"}, {"id": 84, "duration_s": 2.55, "emotion": "excited", "text": "দেওবাৰ। পাৰাৰ মহামুকাবিলা!"}, {"id": 85, "duration_s": 3.65, "emotion": "serious", "text": "তদন্ত হ'ব! সমূচাৰ।"}, {"id": 86, "duration_s": 2.4, "emotion": "excited", "text": "লাইভ চলিছে! মহামুকাবিলা!"}, {"id": 87, "duration_s": 1.7, "emotion": "proud", "text": "আজি সুলতানৰ দিন!"}, {"id": 88, "duration_s": 2.99, "emotion": "mischievous", "text": "জিকিলে পাউদাৰ বিক্ৰী, হাৰিলেও!"}, {"id": 89, "duration_s": 2.17, "emotion": "calm", "text": "ধনৰাম দা, পিছফালে ধৰিবা।"}, {"id": 90, "duration_s": 3.07, "emotion": "sarcastic", "text": "ধৰিলোঁ। খাটনিৰ বিল বেলেগ।"}, {"id": 91, "duration_s": 4.13, "emotion": "excited", "text": "গোটেই পাৰাই চাব! বৰুৱা জিন্দাবাদ!"}, {"id": 92, "duration_s": 6.551, "emotion": "serious", "text": "নজৰ নলগাক! এতিয়া ৰছী পবিত্ৰ।"}, {"id": 93, "duration_s": 3.78, "emotion": "shouting", "text": "সাজু... টানা!"}, {"id": 94, "duration_s": 3.6, "emotion": "determined", "text": "সম্পূৰ্ণ... শক্তি... লগোৱা!"}, {"id": 95, "duration_s": 3.22, "emotion": "curious", "text": "ধনৰাম দা, শুৰু কেতিয়া?"}, {"id": 96, "duration_s": 1.96, "emotion": "comic_panic", "text": "টেনচন নলবা... আহ... টেনচন!"}, {"id": 97, "duration_s": 3.23, "emotion": "tired", "text": "ধনৰাম দা, চাহ ঠাণ্ডা হৈছে।"}, {"id": 98, "duration_s": 1.59, "emotion": "laughing", "text": "শ্ল' মোছনত আকৌ!"}, {"id": 99, "duration_s": 2.92, "emotion": "embarrassed", "text": "মই... কাকো নডৰোঁ।"}, {"id": 100, "duration_s": 0.878, "emotion": "curious", "text": "দেউতা, পাউদাৰ ভিতৰত বাঢ়িছিল নে?"}, {"id": 101, "duration_s": 1.83, "emotion": "shocked", "text": "আই অ'! নজৰ লাগিল!"}, {"id": 102, "duration_s": 0.323, "emotion": "embarrassed", "text": "হায়! গোটেই পাৰাই দেখিলে!"}, {"id": 103, "duration_s": 2.16, "emotion": "excited", "text": "জিকিলোঁ! এতিয়া পাউদাৰৰ দাম দুগুণ!"}, {"id": 104, "duration_s": 1.067, "emotion": "happy", "text": "জিকাৰ মিঠাই!"}, {"id": 105, "duration_s": 1.79, "emotion": "tired", "text": "ধনৰাম পৰিয়াল জিকিল! তদন্ত... শেষ..."}, {"id": 106, "duration_s": 0.16, "emotion": "excited", "text": "দহ লাখ ভিউ! সুলতান ভাইৰেল!"}, {"id": 107, "duration_s": 0.56, "emotion": "excited", "text": "শুনিছানে? আমেৰিকাৰ মানুহেও চাইছে!"}, {"id": 108, "duration_s": 0.66, "emotion": "sad", "text": "এতিয়া মোক কোনেও নেদেখে।"}, {"id": 109, "duration_s": 0.28, "emotion": "curious", "text": "দেউতা? ভিতৰত?"}, {"id": 110, "duration_s": 1.21, "emotion": "sad", "text": "নাই।"}, {"id": 111, "duration_s": 0.56, "emotion": "sarcastic", "text": "ভাত বাল্টিত দিওঁনে?"}, {"id": 112, "duration_s": 0.99, "emotion": "determined", "text": "ৰুটী নালাগে... পাউদাৰ!"}, {"id": 113, "duration_s": 1.5, "emotion": "proud", "text": "মই কওঁ?"}, {"id": 114, "duration_s": 1.37, "emotion": "serious", "text": "কোম্পানীৰ ঠিকনা? নাই। লাইচেন্স? নাই।"}, {"id": 115, "duration_s": 2.8, "emotion": "sarcastic", "text": "আৰু সকলো ৰিভিউ... এজনৰেই!"}, {"id": 116, "duration_s": 1.73, "emotion": "angry", "text": "মানে... সকলো ঠগ!"}, {"id": 117, "duration_s": 2.74, "emotion": "guilty", "text": "বুদ্ধিটো মোৰ আছিল... দেউতাক ক'ব লাগিব।"}, {"id": 118, "duration_s": 3.97, "emotion": "sad", "text": "পঞ্চাশ কৌটা। গ্ৰাহক... শূন্য।"}, {"id": 119, "duration_s": 1.26, "emotion": "happy", "text": "টেনচন নলবা, ধনৰাম!"}, {"id": 120, "duration_s": 1.27, "emotion": "angry", "text": "টেনচন তুমিয়েই!"}, {"id": 121, "duration_s": 3.83, "emotion": "proud", "text": "ল'ৰা-ছোৱালীয়ে প্ৰমাণ কৰিলে! বিজ্ঞানে কয়... চক!"}, {"id": 122, "duration_s": 2.57, "emotion": "tired", "text": "হয় পবিত্ৰ, তুমি শুদ্ধ।"}, {"id": 123, "duration_s": 1.95, "emotion": "shocked", "text": "মই... শুদ্ধ? প্ৰথমবাৰ?"}, {"id": 124, "duration_s": 3.56, "emotion": "happy", "text": "ভাল চক! ব্লেকব'ৰ্ডৰ বাবে সব নিম।"}, {"id": 125, "duration_s": 0.77, "emotion": "pleading", "text": "কিমান দিবা?"}, {"id": 126, "duration_s": 0.87, "emotion": "loving", "text": "আশীৰ্বাদ।"}, {"id": 127, "duration_s": 3.02, "emotion": "determined", "text": "ভুৱা বিজ্ঞাপন... ৰিপৰ্ট! আৰু ব্লক!"}, {"id": 128, "duration_s": 2.7, "emotion": "embarrassed", "text": "ন শ নিৰানব্বৈ... চকত।"}, {"id": 129, "duration_s": 4.54, "emotion": "calm", "text": "হৰি, যি কৌটাই সাত দিনত বডি দিয়ে..."}, {"id": 130, "duration_s": 2.49, "emotion": "sarcastic", "text": "...সি সাত দিনত জেপ খালী কৰে।"}, {"id": 131, "duration_s": 4.47, "emotion": "serious", "text": "বডি কৌটাৰে নহয়, ৰুটী আৰু দৌৰেৰে হয়।"}, {"id": 132, "duration_s": 8.41, "emotion": "determined", "text": "আৰু ঠিকনা, লাইচেন্স, আচল ৰিভিউ চাবা!"}, {"id": 133, "duration_s": 2.51, "emotion": "happy", "text": "সুলতানে... ৰুটী খায়!"}, {"id": 134, "duration_s": 2.57, "emotion": "tired", "text": "দেউতা... অলপ লাহেকৈ!"}, {"id": 135, "duration_s": 2.5, "emotion": "happy", "text": "বলা, যাওঁ... খোজকাঢ়ি!"}, {"id": 136, "duration_s": 0.88, "emotion": "happy", "text": "সোনকালে!"}, {"id": 137, "duration_s": 3.63, "emotion": "happy", "text": "দৌৰা বিনামূলীয়া! আটাইতকৈ ভাল স্কীম!"}, {"id": 138, "duration_s": 4.21, "emotion": "excited", "text": "টেনচন নলবা! সুলতান কেশতেল! সাত দিনত চুলি!"}, {"id": 139, "duration_s": 2.76, "emotion": "embarrassed", "text": "টেনচন... ল'লোঁ।"}, {"id": 140, "duration_s": 1.67, "emotion": "excited", "text": "দেউতা! আচল মাছল!"}]