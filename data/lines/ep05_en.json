[{"id": 1, "duration_s": 14.45, "emotion": "excited", "text": "The colony's biggest contest... tug of war!"}, {"id": 2, "duration_s": 2.93, "emotion": "proud", "text": "Seven days of powder! I fear nobody!"}, {"id": 3, "duration_s": 2.24, "emotion": "calm", "text": "Seth ji, keep my tea hot."}, {"id": 4, "duration_s": 2.12, "emotion": "excited", "text": "We're live! Slow motion!"}, {"id": 5, "duration_s": 3.24, "emotion": "mischievous", "text": "It all began... with one tin."}, {"id": 6, "duration_s": 2.89, "emotion": "happy", "text": "Seven days ago. Colony Sports Week."}, {"id": 7, "duration_s": 3.36, "emotion": "excited", "text": "This Sunday, tug of war! Sharmas versus Seths!"}, {"id": 8, "duration_s": 2.57, "emotion": "proud", "text": "Sharmas will win! I fear nobody!"}, {"id": 9, "duration_s": 4.39, "emotion": "sarcastic", "text": "I did the maths. Sharma's winning chance... zero."}, {"id": 10, "duration_s": 2.13, "emotion": "sarcastic", "text": "Fear nobody, Ramesh ji?"}, {"id": 11, "duration_s": 3.22, "emotion": "comic_panic", "text": "Nobody! Lizards... don't even exist!"}, {"id": 12, "duration_s": 2.48, "emotion": "stern_warning", "text": "Shh! Uncle will jump again."}, {"id": 13, "duration_s": 1.57, "emotion": "happy", "text": "Let's go, let's go!"}, {"id": 14, "duration_s": 1.94, "emotion": "calm", "text": "Move, bhaiya. I'll see."}, {"id": 15, "duration_s": 2.45, "emotion": "shocked", "text": "Bhabhi ji, you'd tow a tractor!"}, {"id": 16, "duration_s": 1.0, "emotion": "excited", "text": "Don't take tension, bhaiya!"}, {"id": 17, "duration_s": 2.95, "emotion": "worried", "text": "Tension? She pulled an auto, Tinku!"}, {"id": 18, "duration_s": 4.47, "emotion": "proud", "text": "My son will win! Whole colony will watch!"}, {"id": 19, "duration_s": 3.295, "emotion": "mischievous", "text": "Did you hear? Ramesh ji lost to a lizard!"}, {"id": 20, "duration_s": 3.478, "emotion": "sad", "text": "Where are the chips? I'm hungry!"}, {"id": 21, "duration_s": 3.53, "emotion": "excited", "text": "Sultan Power Powder! Body in seven days!"}, {"id": 22, "duration_s": 2.46, "emotion": "excited", "text": "Just nine ninety-nine! Express delivery!"}, {"id": 23, "duration_s": 2.07, "emotion": "excited", "text": "I have an idea! For Papa!"}, {"id": 24, "duration_s": 3.84, "emotion": "excited", "text": "Papa! Body in seven days! Sunday's seven days away!"}, {"id": 25, "duration_s": 4.005, "emotion": "excited", "text": "Sultan... body... seven days!"}, {"id": 26, "duration_s": 3.15, "emotion": "sarcastic", "text": "Seven days? Even pickle takes longer!"}, {"id": 27, "duration_s": 2.57, "emotion": "proud", "text": "It's science, Pooja! Order!"}, {"id": 28, "duration_s": 4.78, "emotion": "proud", "text": "My son will become Sultan! Whole colony will watch!"}, {"id": 29, "duration_s": 2.95, "emotion": "curious", "text": "Will the powder be sweet? I want some."}, {"id": 30, "duration_s": 2.94, "emotion": "excited", "text": "Sultan Power Powder, sir! Express delivery only!"}, {"id": 31, "duration_s": 1.76, "emotion": "loving", "text": "My Sultan has arrived!"}, {"id": 32, "duration_s": 3.15, "emotion": "mischievous", "text": "Did you hear? Ramesh ji ordered a body in a box!"}, {"id": 33, "duration_s": 1.98, "emotion": "determined", "text": "Aah! Power is coming!"}, {"id": 34, "duration_s": 2.29, "emotion": "curious", "text": "Papa... where's the muscle hiding?"}, {"id": 35, "duration_s": 2.23, "emotion": "excited", "text": "It's here! One hair stood up!"}, {"id": 36, "duration_s": 2.6, "emotion": "shocked", "text": "Did you hear? Sharma ji's buttons are raining!"}, {"id": 37, "duration_s": 3.597, "emotion": "embarrassed", "text": "Body is growing, Aunty!"}, {"id": 38, "duration_s": 2.11, "emotion": "shocked", "text": "Half an inch..."}, {"id": 39, "duration_s": 1.43, "emotion": "shocked", "text": "...less!"}, {"id": 40, "duration_s": 1.67, "emotion": "proud", "text": "It's growing inside!"}, {"id": 41, "duration_s": 2.29, "emotion": "happy", 