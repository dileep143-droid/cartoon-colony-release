[{"id": 1, "duration_s": 3.74, "emotion": "calm", "text": "रविवार संध्याकाळ. गणपतरावांकडे सत्यनारायण."}, {"id": 2, "duration_s": 2.21, "emotion": "excited", "text": "बनाना किंगडम! ऊ ऊ आ आ!"}, {"id": 3, "duration_s": 2.0, "emotion": "excited", "text": "फक्त नव्व्याण्णव रुपये!"}, {"id": 4, "duration_s": 0.8, "emotion": "shocked", "text": "पुन्हा कापले?!"}, {"id": 5, "duration_s": 1.35, "emotion": "embarrassed", "text": "ऊ ऊ आ आ?"}, {"id": 6, "duration_s": 3.59, "emotion": "mischievous", "text": "हे सगळं सुरू झालं होतं... तीन दिवसांपूर्वी."}, {"id": 7, "duration_s": 2.32, "emotion": "mischievous", "text": "एका केळ्याच्या गेमपासून."}, {"id": 8, "duration_s": 3.55, "emotion": "angry", "text": "बंड्या! हा फोन 'गुड मॉर्निंग' पाठवतच नाही!"}, {"id": 9, "duration_s": 2.35, "emotion": "proud", "text": "झालं! चौदा ग्रुपवर गेलं."}, {"id": 10, "duration_s": 1.81, "emotion": "proud", "text": "अख्खी कॉलनी बघेल!"}, {"id": 11, "duration_s": 2.0, "emotion": "excited", "text": "सखू आजी! माकडाचा गेम आहे!"}, {"id": 12, "duration_s": 3.44, "emotion": "tired", "text": "पाच मिनिटं खेळा. मी जरा डोळे मिटून..."}, {"id": 13, "duration_s": 2.9, "emotion": "excited", "text": "बनाना किंगडमात तुमचं स्वागत हाय!"}, {"id": 14, "duration_s": 0.82, "emotion": "excited", "text": "संपली! फकस्त नव्व्याण्णवात शंभर केळी!"}, {"id": 15, "duration_s": 6.62, "emotion": "curious", "text": "नव्व्याण्णव रुपये? खरे का?"}, {"id": 16, "duration_s": 3.11, "emotion": "mischievous", "text": "वेडा! गेमचे पैसे खोटे असतात."}, {"id": 17, "duration_s": 1.01, "emotion": "mischievous", "text": "एक आयडिया!"}, {"id": 18, "duration_s": 1.12, "emotion": "excited", "text": "आवाज ऐकला? पैसे मिळतायत!"}, {"id": 19, "duration_s": 1.27, "emotion": "laughing", "text": "अजून एक! <laugh> एक!"}, {"id": 20, "duration_s": 3.75, "emotion": "happy", "text": "अख्खी कॉलनी... बघेल..."}, {"id": 21, "duration_s": 3.93, "emotion": "excited", "text": "शाबास! तुमी बनाना किंगडमचे राजे!"}, {"id": 22, "duration_s": 3.33, "emotion": "calm", "text": "त्याच सकाळी. पडवीत गणपतराव निवांत."}, {"id": 23, "duration_s": 3.45, "emotion": "proud", "text": "माझं बँक अकाउंट म्हणजे किल्लाच, सोन्या!"}, {"id": 24, "duration_s": 1.02, "emotion": "sarcastic", "text": "आत काही आहे का?"}, {"id": 25, "duration_s": 3.49, "emotion": "neutral", "text": "नव्व्याण्णव कापले? जाऊ दे... चहापाणी."}, {"id": 26, "duration_s": 1.33, "emotion": "shocked", "text": "चारशे नव्व्याण्णव?!"}, {"id": 27, "duration_s": 1.83, "emotion": "curious", "text": "दादा, तिजोरीला भोक!"}, {"id": 28, "duration_s": 3.01, "emotion": "panicked", "text": "नऊशे नव्व्याण्णव! चोर नाही... डाकू!"}, {"id": 29, "duration_s": 1.68, "emotion": "excited", "text": "टेन्शन नको! फोनच विका!"}, {"id": 30, "duration_s": 3.18, "emotion": "determined", "text": "मी कोणाला घाबरत नाही! त्या चोराला मी..."}, {"id": 31, "duration_s": 0.88, "emotion": "comic_panic", "text": "पा... पाल!"}, {"id": 32, "duration_s": 3.12, "emotion": "sarcastic", "text": "कोणाला घाबरत नाही? पालीलाही नाही?"}, {"id": 33, "duration_s": 2.04, "emotion": "embarrassed", "text": "ती पाल चोराची गुप्तहेर!"}, {"id": 34, "duration_s": 1.62, "emotion": "calm", "text": "बस्स! आता मी बघते—"}, {"id": 35, "duration_s": 2.26, "emotion": "shouting", "text": "नको! हे पोलीस केस आहे!"}, {"id": 36, "duration_s": 4.47, "emotion": "scared_whisper", "text": "हॅलो, ठाणं? माझं अकाउंट... लुटतंय!"}, {"id": 37, "duration_s": 4.32, "emotion": "serious", "text": "चौकशी होणार! चौकशी!"}, {"id": 38, "duration_s": 2.47, "emotion": "panicked", "text": "साहेब, चोर दिसत नाही... फक्त पैसे कापतो!"}, {"id": 39, "duration_s": 4.736, "emotion": "curious", "text": "हम्म... पुराव्याचा वास."}, {"id": 40, "duration_s": 6.59, "emotion": "serious", "text": "चोर कधी येतो? काय घालतो? चटणी कुठंय?"}, {"id": 41, "duration_s": 1.43, "emotion": "embarrassed", "text": "भूक लागलीय!"}, {"id": 42, "duration_s": 3.87, "emotion": "serious", "text": "लिहा... चोर... भुकेला."}, {"id": 43, "duration_s": 2.14, "emotion": "curious", "text": "भुकेला? हे कसं कळलं?"}, {"id": 44, "duration_s": 2.1, "emotion": "proud", "text": "अरे, भजी संपली ना!"}, {"id": 45, "duration_s": 2.48, "emotion": "pleading", "text": "साहेब? साहेब! चोर!"}, {"id": 46, "duration_s": 0.9, "emotion": "sarcastic", "text": "अजून एक भजी?"}, {"id": 47, "duration_s": 0.87, "emotion": "excited", "text": "चौकशी!"}, {"id": 48, "duration_s": 7.38, "emotion": "serious", "text": "ठाण्यात जाऊन रिपोर्ट खाईन. म्हणजे... लिहीन."}, {"id": 49, "duration_s": 1.38, "emotion": "sad", "text": "<sigh> चोरही भुकेला... हवालदारही भुकेला."}, {"id": 50, "duration_s": 3.33, "emotion": "mischievous", "text": "तासाभरात... बातमी अख्ख्या कॉलनीत."}, {"id": 51, "duration_s": 2.19, "emotion": "excited", "text": "ऐकलंत का? फोनमध्ये चोर!"}, {"id": 52, "duration_s": 2.56, "emotion": "scared_whisper", "text": "ऐकलंत का? चोर अदृश्य!"}, {"id": 53, "duration_s": 2.0, "emotion": "shocked", "text": "ऐकलंत का? चोर माकड!"}, {"id": 54, "duration_s": 1.09, "emotion": "proud", "text": "विज्ञान सांगतं..."}, {"id": 55, "duration_s": 1.8, "emotion": "serious", "text": "चोर... डावखुरा आहे!"}, {"id": 56, "duration_s": 0.72, "emotion": "curious", "text": "कसं कळलं?"}, {"id": 57, "duration_s": 2.13, "emotion": "proud", "text": "पैसा नेहमी डाव्या हातानं जातो!"}, {"id": 58, "duration_s": 1.03, "emotion": "stern_warning", "text": "धनाजी!"}, {"id": 59, "duration_s": 4.48, "emotion": "serious", "text": "माझा डावा हात फक्त मोजतो. एक रुपया कमी नाही!"}, {"id": 60, "duration_s": 3.47, "emotion": "serious", "text": "दृष्ट लागली! प्रत्येक फोनला लिंबू-मिरची!"}, {"id": 61, "duration_s": 2.37, "emotion": "excited", "text": "लाईव्ह सुरू आहे! कॉलनीत चोर!"}, {"id": 62, "duration_s": 4.11, "emotion": "determined", "text": "चला, निघूया! चोर पकडायला!"}, {"id": 63, "duration_s": 0.84, "emotion": "embarrassed", "text": "<sigh> चोर पायीच पकडू."}, {"id": 64, "duration_s": 3.78, "emotion": "comic_panic", "text": "एकोणीसशे नव्व्याण्णव! आत्ता! इथेच!"}, {"id": 65, "duration_s": 1.47, "emotion": "shocked", "text": "चोर आपल्यातच आहे!"}, {"id": 66, "duration_s": 1.6, "emotion": "shouting", "text": "तू! नाही, तू!"}, {"id": 67, "duration_s": 0.7, "emotion": "shouting", "text": "गप्प!"}, {"id": 68, "duration_s": 3.59, "emotion": "curious", "text": "मी सांगू? चोर कदाचित घरचाच..."}, {"id": 69, "duration_s": 1.52, "emotion": "shouting", "text": "नाही!"}, {"id": 70, "duration_s": 3.46, "emotion": "sarcastic", "text": "पोरांना विज्ञान कळत नाही!"}, {"id": 71, "duration_s": 5.16, "emotion": "scared_whisper", "text": "रात्रीचे दोन वाजले. अख्खी कॉलनी झोपलीय..."}, {"id": 72, "duration_s": 1.57, "emotion": "mischievous", "text": "...जवळपास अख्खी."}, {"id": 73, "duration_s": 3.42, "emotion": "scared_whisper", "text": "फक्त एक लेव्हल... मग झोपते."}, {"id": 74, "duration_s": 2.2, "emotion": "scared_whisper", "text": "श्शू! माकड भुकेलंय."}, {"id": 75, "duration_s": 1.489, "emotion": "scared_whisper", "text": "चोर... घरातच आहे!"}, {"id": 76, "duration_s": 2.39, "emotion": "scared_whisper", "text": "मी कोणाला घाबरत नाही... मी कोणाला..."}, {"id": 77, "duration_s": 1.39, "emotion": "scared_whisper", "text": "कोण आहे? हात वर!"}, {"id": 78, "duration_s": 3.734, "emotion": "angry", "text": "रात्री टॉर्च?!"}, {"id": 79, "duration_s": 1.95, "emotion": "embarrassed", "text": "आई... तुम्ही कोणी चोर पाहिला का?"}, {"id": 80, "duration_s": 4.51, "emotion": "tired", "text": "चोर? <short pause> इथे फक्त मीच."}, {"id": 81, "duration_s": 0.84, "emotion": "relieved", "text": "हो... तुम्ही तर झोपल्या."}, {"id": 82, "duration_s": 3.2, "emotion": "serious", "text": "कॉलनीत चोर फिरतोय. एक रुपया कमी नाही!"}, {"id": 83, "duration_s": 0.84, "emotion": "excited", "text": "टेन्शन नको!"}, {"id": 84, "duration_s": 3.31, "emotion": "mischievous", "text": "गेम हॅक! अनलिमिटेड केळी! फक्त दोनशेत!"}, {"id": 85, "duration_s": 3.02, "emotion": "curious", "text": "दोनशे नाही... दोन समोसे."}, {"id": 86, "duration_s": 1.57, "emotion": "happy", "text": "चालेल! डील पक्की!"}, {"id": 87, "duration_s": 1.8, "emotion": "shocked", "text": "अरे! पेमेंटच खाल्लं!"}, {"id": 88, "duration_s": 3.12, "emotion": "stern_warning", "text": "गेम हॅक? दाखवू खरा हॅक?"}, {"id": 89, "duration_s": 2.64, "emotion": "pleading", "text": "वहिनी... ही तर समाजसेवा!"}, {"id": 90, "duration_s": 2.28, "emotion": "excited", "text": "दोनशे? त्यात माझे दहा टक्के!"}, {"id": 91, "duration_s": 1.49, "emotion": "stern_warning", "text": "धनाजी!"}, {"id": 92, "duration_s": 1.87, "emotion": "happy", "text": "हॅक मस्त होता."}, {"id": 93, "duration_s": 4.59, "emotion": "calm", "text": "तीन दिवसांनी. तीच पूजा... जिथून आम्ही सुरू केलं."}, {"id": 94, "duration_s": 3.62, "emotion": "scared_whisper", "text": "आज खर्च नाही. आज पूजा आहे."}, {"id": 95, "duration_s": 3.05, "emotion": "scared_whisper", "text": "लाईव्ह! गणपतराव पूजा, एक्सक्लुसिव्ह!"}, {"id": 96, "duration_s": 3.98, "emotion": "serious", "text": "आणि मग लीलावतीनं... प्रसाद खाल्ला नाही."}, {"id": 97, "duration_s": 1.36, "emotion": "curious", "text": "हा कोणता अध्याय आहे?"}, {"id": 98, "duration_s": 3.29, "emotion": "excited", "text": "हे... नवं भजन आहे! केळं भजन!"}, {"id": 99, "duration_s": 1.26, "emotion": "shocked", "text": "दृष्ट लागली!"}, {"id": 100, "duration_s": 1.9, "emotion": "excited", "text": "ऐकलं? आजींचं डिस्को भजन!"}, {"id": 101, "duration_s": 2.63, "emotion": "excited", "text": "धन्यवाद! नव्व्याण्णव रुपये!"}, {"id": 102, "duration_s": 0.78, "emotion": "shocked", "text": "पुन्हा कापले?!"}, {"id": 103, "duration_s": 1.42, "emotion": "embarrassed", "text": "ऊ ऊ आ आ?"}, {"id": 104, "duration_s": 1.08, "emotion": "shouting", "text": "चौकशी!"}, {"id": 105, "duration_s": 0.76, "emotion": "shocked", "text": "आजी?!"}, {"id": 106, "duration_s": 0.94, "emotion": "curious", "text": "मी सांगू?"}, {"id": 107, "duration_s": 0.92, "emotion": "shouting", "text": "सांगा!"}, {"id": 108, "duration_s": 5.1, "emotion": "serious", "text": "नव्व्याण्णव... चारशे नव्व्याण्णव... नऊशे नव्व्याण्णव..."}, {"id": 109, "duration_s": 3.6, "emotion": "serious", "text": "सगळं फोनवर. पेमेंट गणपतकाकांचं कार्ड."}, {"id": 110, "duration_s": 2.48, "emotion": "shocked", "text": "माझं कार्ड? आईच्या फोनमध्ये?"}, {"id": 111, "duration_s": 3.89, "emotion": "sarcastic", "text": "तूच टाकलंस ना! लाईटबिल भरायला!"}, {"id": 112, "duration_s": 1.31, "emotion": "sad", "text": "<sigh> आणि काढायला विसरलो."}, {"id": 113, "duration_s": 4.3, "emotion": "guilty", "text": "बाबा... आधीचे नव्व्याण्णव... मी दाबले."}, {"id": 114, "duration_s": 5.2, "emotion": "guilty", "text": "आणि चारशे नव्व्याण्णव... आम्ही दोघांनी."}, {"id": 115, "duration_s": 2.6, "emotion": "guilty", "text": "आम्हाला वाटलं गेमचे पैसे खोटे."}, {"id": 116, "duration_s": 2.87, "emotion": "serious", "text": "पैसे खरे होते. फक्त केळी खोटी होती."}, {"id": 117, "duration_s": 3.57, "emotion": "guilty", "text": "आणि रात्री दोनचे... मी."}, {"id": 118, "duration_s": 2.956, "emotion": "shocked", "text": "रात्री दोन वाजता?!"}, {"id": 119, "duration_s": 2.34, "emotion": "pleading", "text": "माकड भुकेलं!"}, {"id": 120, "duration_s": 2.7, "emotion": "proud", "text": "बघा! मी म्हटलं, चोर भुकेला!"}, {"id": 121, "duration_s": 3.25, "emotion": "proud", "text": "आणि आजी डावखुऱ्या आहेत! विज्ञान सांगतं!"}, {"id": 122, "duration_s": 2.5, "emotion": "excited", "text": "ऐकलं? चोर... आजीच!"}, {"id": 123, "duration_s": 2.59, "emotion": "proud", "text": "आता मी बघतो! मी कोणाला—"}, {"id": 124, "duration_s": 3.5, "emotion": "determined", "text": "बस्स! आता मी बघते."}, {"id": 125, "duration_s": 2.52, "emotion": "serious", "text": "एक - प्रत्येक पेमेंटला पिन."}, {"id": 126, "duration_s": 2.2, "emotion": "serious", "text": "दोन - महिन्याची मर्यादा."}, {"id": 127, "duration_s": 2.32, "emotion": "serious", "text": "तीन - कार्ड काढा, ऑटो-पे बंद."}, {"id": 128, "duration_s": 1.96, "emotion": "shocked", "text": "बस? दहा सेकंदात?"}, {"id": 129, "duration_s": 1.98, "emotion": "pleading", "text": "आणि... आमचा गेम?"}, {"id": 130, "duration_s": 3.408, "emotion": "calm", "text": "रोज तीस मिनिटं. मग बाहेर क्रिकेट!"}, {"id": 131, "duration_s": 1.7, "emotion": "excited", "text": "क्रिकेटनंतर समोसे?"}, {"id": 132, "duration_s": 1.77, "emotion": "worried", "text": "आणि गेलेल्या पैशांचं?"}, {"id": 133, "duration_s": 5.55, "emotion": "calm", "text": "कंपनीकडे तक्रार करू. आणि पुढे... पिन!"}, {"id": 134, "duration_s": 0.99, "emotion": "calm", "text": "मुलांना फोनपेक्षा... आपली साथ हवी."}, {"id": 135, "duration_s": 3.477, "emotion": "serious", "text": "फोनला पिन... मुलांसाठी वेळ."}, {"id": 136, "duration_s": 2.77, "emotion": "laughing", "text": "आणि आजीच्या फोनला डबल पिन!"}, {"id": 137, "duration_s": 2.65, "emotion": "proud", "text": "मी कोणाला घाबरत नाही! टाका बॉल!"}, {"id": 138, "duration_s": 4.24, "emotion": "mischievous", "text": "डावखुरी. विज्ञान सांगतं."}, {"id": 139, "duration_s": 1.49, "emotion": "sad", "text": "<sigh> अगदी चपलेसारखा."}, {"id": 140, "duration_s": 1.63, "emotion": "laughing", "text": "आजी कधी चुकत नाही!"}]