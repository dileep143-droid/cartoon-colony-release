[{"id": 1, "duration_s": 2.99, "emotion": "excited", "text": "বৰষুণৰ বতৰ... কলোনীত সকলো বিৰক্ত!"}, {"id": 2, "duration_s": 4.58, "emotion": "excited", "text": "বৰষুণৰ চেলফি! এতিয়া লাখ লাইক আহিব!"}, {"id": 3, "duration_s": 2.93, "emotion": "sad", "text": "শূন্য লাইক? আইয়েও নকৰিলে!"}, {"id": 4, "duration_s": 3.18, "emotion": "proud", "text": "খোৱাৰ ফটো! সমুচা সদায় ভাইৰেল!"}, {"id": 5, "duration_s": 1.14, "emotion": "embarrassed", "text": "ভোক লাগিছিল!"}, {"id": 6, "duration_s": 3.663, "emotion": "excited", "text": "কেপ্তেইন কুমীৰৰ নাও! সবাতকৈ বেগী!"}, {"id": 7, "duration_s": 1.43, "emotion": "shocked", "text": "অ'! মোৰ কেপ্তেইন কুমীৰ!"}, {"id": 8, "duration_s": 1.66, "emotion": "stern_warning", "text": "ৰ'! নলালৈ নাযাবি!"}, {"id": 9, "duration_s": 1.89, "emotion": "mischievous", "text": "টেনচন নলবা! বুদ্ধি আহিল!"}, {"id": 10, "duration_s": 3.04, "emotion": "mischievous", "text": "অলপ ডাঙৰ... অলপ... ব্যাস!"}, {"id": 11, "duration_s": 3.33, "emotion": "excited", "text": "দহ মিনিটত দহ হাজাৰ লাইক! মই ষ্টাৰ!"}, {"id": 12, "duration_s": 1.26, "emotion": "proud", "text": "আচল কুমীৰ কাৰ লাগে?"}, {"id": 13, "duration_s": 2.07, "emotion": "scared_whisper", "text": "শুনিছা নেকি? নলাত কুমীৰ!"}, {"id": 14, "duration_s": 3.55, "emotion": "proud", "text": "চল্লিশ গ্ৰুপ! এটা উশাহত! মোৰ ৰেকৰ্ড!"}, {"id": 15, "duration_s": 2.49, "emotion": "serious", "text": "দহ ছেকেণ্ডত... গোটেই কলোনীয়ে গম পালে।"}, {"id": 16, "duration_s": 2.63, "emotion": "excited", "text": "হয়, সেইটো! দুয়োকে কৈ আছোঁ!"}, {"id": 17, "duration_s": 1.1, "emotion": "panicked", "text": "চাৰ! কুমীৰ!"}, {"id": 18, "duration_s": 2.19, "emotion": "calm", "text": "কুমুৰা? তৰকাৰী কৰক!"}, {"id": 19, "duration_s": 2.42, "emotion": "shocked", "text": "কু... কুমীৰ?! মোৰ ধুতিখন!"}, {"id": 20, "duration_s": 3.38, "emotion": "serious", "text": "চকু লাগিল! কুমীৰকো নেমু-জলকীয়া!"}, {"id": 21, "duration_s": 4.04, "emotion": "proud", "text": "বিজ্ঞানে কয়, কুমীৰে বৰষুণত কেৱল চেণ্ডেল খায়!"}, {"id": 22, "duration_s": 4.09, "emotion": "panicked", "text": "দুৱাৰ বন্ধ! খিৰিকী বন্ধ! গা-ধোৱা নলীও বন্ধ!"}, {"id": 23, "duration_s": 2.63, "emotion": "excited", "text": "এটা বুদ্ধি আছে! কুমীৰ চাবলৈ যাওঁ!"}, {"id": 24, "duration_s": 2.56, "emotion": "stern_warning", "text": "বুদ্ধি জেপত ৰাখ। হোমৱৰ্ক উলিওৱা।"}, {"id": 25, "duration_s": 2.97, "emotion": "proud", "text": "ভয় নকৰিবা! মই কাকো নেডৰাওঁ!"}, {"id": 26, "duration_s": 2.12, "emotion": "determined", "text": "কুমীৰ আহিলে... পোনে পেভিলিয়ন পঠাম!"}, {"id": 27, "duration_s": 1.53, "emotion": "comic_panic", "text": "কু... কু... কুমীৰৰ পোৱালী!"}, {"id": 28, "duration_s": 1.42, "emotion": "determined", "text": "হ'ল! এতিয়া মই চাওঁ।"}, {"id": 29, "duration_s": 2.34, "emotion": "scared_whisper", "text": "ৰূপা... গ'ল? পাক্কা গ'ল?"}, {"id": 30, "duration_s": 3.92, "emotion": "proud", "text": "মোৰ ল'ৰা সিংহ! গোটেই কলোনীয়ে চাব!"}, {"id": 31, "duration_s": 3.91, "emotion": "determined", "text": "আজি ৰাতি... মই গেটত পহৰা দিম!"}, {"id": 32, "duration_s": 1.566, "emotion": "guilty", "text": "সেয়া... আচলতে... ফটো..."}, {"id": 33, "duration_s": 1.79, "emotion": "angry", "text": "চুপ! অশুভ নকবি!"}, {"id": 34, "duration_s": 2.48, "emotion": "giggly", "text": "দেউতা... ভেকুলীৰ পৰা?"}, {"id": 35, "duration_s": 3.76, "emotion": "scared_whisper", "text": "ৰাতি বাৰ বজাত... বৰুৱা গেটত... পহৰা।"}, {"id": 36, "duration_s": 4.549, "emotion": "tired", "text": "মই কাকো নেডৰাওঁ... কেৱল টোপনিক।"}, {"id": 37, "duration_s": 1.08, "emotion": "comic_panic", "text": "কো... কোন? সন্মুখলৈ আহ!"}, {"id": 38, "duration_s": 3.29, "emotion": "relieved", "text": "<sigh> মেকুৰী মাহী। ডৰালি।"}, {"id": 39, "duration_s": 1.31, "emotion": "comic_panic", "text": "কু... কু... কুমীৰ!"}, {"id": 40, "duration_s": 4.739, "emotion": "curious", "text": "হৰি বোপা, মাজৰাতি গেটত কিয় ওলমি আছা?"}, {"id": 41, "duration_s": 3.29, "emotion": "embarrassed", "text": "যোগ, চাৰ! ইয়াক কয়... গেট-আসন!"}, {"id": 42, "duration_s": 2.51, "emotion": "excited", "text": "শুনিছা নেকি? হৰি গেটত ওলমি আছে!"}, {"id": 43, "duration_s": 3.88, "emotion": "excited", "text": "কুমীৰ-প্ৰুফ গামবুট! কামুৰিলে দাঁত ভাগিব!"}, {"id": 44, "duration_s": 2.35, "emotion": "proud", "text": "কালিলৈকে এশ। আজি তিনিশ!"}, {"id": 45, "duration_s": 3.43, "emotion": "sarcastic", "text": "ধনৰাম, কুমীৰতকৈ আপোনাৰ দাঁত ডাঙৰ!"}, {"id": 46, "duration_s": 1.55, "emotion": "proud", "text": "এটকাও কম নহয়!"}, {"id": 47, "duration_s": 1.38, "emotion": "proud", "text": "ইয়াই ললে? মোকো দিয়া!"}, {"id": 48, "duration_s": 0.58, "emotion": "angry", "text": "মোক তিনি!"}, {"id": 49, "duration_s": 2.33, "emotion": "proud", "text": "মোক চাৰি! গোটেই কলোনীয়ে চাব!"}, {"id": 50, "duration_s": 3.42, "emotion": "happy", "text": "বলা, যাওঁ! খালী ভৰি আটাইতকৈ শস্তা।"}, {"id": 51, "duration_s": 2.26, "emotion": "calm", "text": "ধনৰাম! আৰু আনোনে?"}, {"id": 52, "duration_s": 6.47, "emotion": "happy", "text": "এক, দুই, তিনি... আকৌ... এক, দুই..."}, {"id": 53, "duration_s": 3.49, "emotion": "excited", "text": "বুটৰ ভিতৰত বিস্কুট! কি অফাৰ!"}, {"id": 54, "duration_s": 1.94, "emotion": "angry", "text": "বিস্কুট বেলেগ! বিশ টকা!"}, {"id": 55, "duration_s": 3.7, "emotion": "guilty", "text": "শুনা সকলো... সেই কুমীৰটো আচলতে..."}, {"id": 56, "duration_s": 1.78, "emotion": "shouting", "text": "পিছৰজন! শাৰীত!"}, {"id": 57, "duration_s": 4.46, "emotion": "serious", "text": "দুপৰীয়া দুই বজাত... কুমীৰ সন্ধান, লাইভ!"}, {"id": 58, "duration_s": 3.04, "emotion": "excited", "text": "হেল' বন্ধুসকল! লাইভ চলিছে! ক্ৰক হাণ্ট!"}, {"id": 59, "duration_s": 3.01, "emotion": "proud", "text": "বিজ্ঞানে কয়, কুমীৰ হুইছলত আহে।"}, {"id": 60, "duration_s": 3.774, "emotion": "pleading", "text": "ধনৰাম, আগত থাকক। আপুনি... ডাঙৰ।"}, {"id": 61, "duration_s": 3.07, "emotion": "angry", "text": "মই? মোৰ বুট তিনিশ টকীয়া!"}, {"id": 62, "duration_s": 3.67, "emotion": "pleading", "text": "সকলো শুনা! সেই কুমীৰ আচল নহয়..."}, {"id": 63, "duration_s": 2.79, "emotion": "shocked", "text": "সে... সেয়া... লৰি আছে!"}, {"id": 64, "duration_s": 4.33, "emotion": "panicked", "text": "কুমীৰ!!!"}, {"id": 65, "duration_s": 0.933, "emotion": "sad", "text": "...নহয়।"}, {"id": 66, "duration_s": 2.0, "emotion": "surprised", "text": "অ'! সেয়া মোৰ চেণ্ডেল!"}, {"id": 67, "duration_s": 3.57, "emotion": "proud", "text": "দেখিলা? বিজ্ঞান! কুমীৰে উগলি দিলে!"}, {"id": 68, "duration_s": 2.28, "emotion": "pleading", "text": "মনি! টানা!"}, {"id": 69, "duration_s": 2.27, "emotion": "excited", "text": "শুনিছা নেকি? কুমীৰে চেণ্ডেল উগলিলে!"}, {"id": 70, "duration_s": 1.85, "emotion": "excited", "text": "ভিউ দুগুণ! চেণ্ডেলো ভাইৰেল!"}, {"id": 71, "duration_s": 5.24, "emotion": "guilty", "text": "<sigh> মোৰ ফটো... চেণ্ডেলতকৈও ডাঙৰ।"}, {"id": 72, "duration_s": 2.01, "emotion": "shouting", "text": "কনেষ্টবল তপনৰাম! কুমীৰ!"}, {"id": 73, "duration_s": 2.61, "emotion": "sarcastic", "text": "পকৌৰা, কনেষ্টবল।"}, {"id": 74, "duration_s": 1.55, "emotion": "surprised", "text": "হয়? ক'ত? তদন্ত!"}, {"id": 75, "duration_s": 4.34, "emotion": "determined", "text": "কুমীৰ হওক বা তাৰ বাপেক... তদন্ত হ'ব!"}, {"id": 76, "duration_s": 0.96, "emotion": "scared_whisper", "text": "চুঃ... আইন আহি আছে।"}, {"id": 77, "duration_s": 5.49, "emotion": "comic_panic", "text": "কু... কুমীৰ... সৰু... সেউজীয়া..."}, {"id": 78, "duration_s": 0.87, "emotion": "worried", "text": "চকু!"}, {"id": 79, "duration_s": 1.54, "emotion": "sarcastic", "text": "পানী নে পকৌৰা?"}, {"id": 80, "duration_s": 2.96, "emotion": "tired", "text": "তদন্ত... চলি থাকিব..."}, {"id": 81, "duration_s": 1.56, "emotion": "sad", "text": "মোৰ কুমীৰো গ'ল..."}, {"id": 82, "duration_s": 2.78, "emotion": "excited", "text": "এটা বুদ্ধি আছে! ভয় নকৰোঁ, তদন্ত কৰোঁ!"}, {"id": 83, "duration_s": 3.4, "emotion": "serious", "text": "মই কওঁনে? আচল বিশেষজ্ঞ মাতা। বন বিভাগ!"}, {"id": 84, "duration_s": 0.46, "emotion": "stern_warning", "text": "ৰ'!"}, {"id": 85, "duration_s": 3.25, "emotion": "serious", "text": "হেল', বন বিভাগ? নলাত কুমীৰ... হয়তো।"}, {"id": 86, "duration_s": 1.54, "emotion": "determined", "text": "মই জলপান চাওঁ।"}, {"id": 87, "duration_s": 3.01, "emotion": "excited", "text": "ব্ৰেকিং নিউজ! কলোনীৰ নলাত কুমির!"}, {"id": 88, "duration_s": 3.74, "emotion": "proud", "text": "আমাৰ নলা টিভিত! গোটেই কলোনীয়ে চাব!"}, {"id": 89, "duration_s": 2.7, "emotion": "comic_panic", "text": "টেনচন নলবা... নলবা... টেনচন হ'ল!"}, {"id": 90, "duration_s": 4.16, "emotion": "sarcastic", "text": "গোটেই কলোনী চাদত। ৰাস্তাত কেৱল ম'হ।"}, {"id": 91, "duration_s": 3.7, "emotion": "happy", "text": "বলা বলা! বন চাহাব আহিল!"}, {"id": 92, "duration_s": 3.35, "emotion": "tired", "text": "প্ৰতিবাৰ! আটাইতকৈ দৰকাৰী সময়ত!"}, {"id": 93, "duration_s": 2.59, "emotion": "happy", "text": "সাবাস! তইহে আচল মেকানিক!"}, {"id": 94, "duration_s": 2.09, "emotion": "serious", "text": "কুমির কুত আছে? মোক দেখাওক।"}, {"id": 95, "duration_s": 1.02, "emotion": "panicked", "text": "তাত!!!"}, {"id": 96, "duration_s": 1.76, "emotion": "scared_whisper", "text": "কলোনীয়ে উশাহ ৰুধিলে..."}, {"id": 97, "duration_s": 3.016, "emotion": "scared_whisper", "text": "মই কাকো নেডৰাওঁ... মই কাকো..."}, {"id": 98, "duration_s": 2.821, "emotion": "sarcastic", "text": "কুমির? এইটো তো ৰবাৰৰ হে।"}, {"id": 99, "duration_s": 4.038, "emotion": "shocked", "text": "ইমান সৰু? মোৰ গামবুটৰ কি হ'ব?"}, {"id": 100, "duration_s": 2.75, "emotion": "loving", "text": "মোৰ কেপ্তেইন কুমীৰ! পালোঁ!"}, {"id": 101, "duration_s": 2.7, "emotion": "curious", "text": "কিন্তু ফটোত তো ডাঙৰ আছিল!"}, {"id": 102, "duration_s": 3.09, "emotion": "proud", "text": "মই কওঁনে? এই ফটোত তিনিটা ভুল আছে।"}, {"id": 103, "duration_s": 1.95, "emotion": "excited", "text": "ফেক্ট-চেক, লাইভ চলিছে!"}, {"id": 104, "duration_s": 3.04, "emotion": "serious", "text": "এক: মেকুৰীৰ ছাঁ... কুমীৰৰ নহয়!"}, {"id": 105, "duration_s": 3.1, "emotion": "serious", "text": "দুই: কুমীৰ নলাতকৈ ডাঙৰ! সোমাব?"}, {"id": 106, "duration_s": 3.9, "emotion": "proud", "text": "বিজ্ঞানে কয়, কুমীৰে উশাহ বন্ধ কৰি চিকোন হয়!"}, {"id": 107, "duration_s": 0.59, "emotion": "stern_warning", "text": "ৰ'!"}, {"id": 108, "duration_s": 2.67, "emotion": "excited", "text": "আৰু তিনি: নেজত পিঠাৰ দাঁতৰ দাগ!"}, {"id": 109, "duration_s": 1.1, "emotion": "embarrassed", "text": "ভোক লাগিছিল।"}, {"id": 110, "duration_s": 5.24, "emotion": "sarcastic", "text": "কুমীৰৰ চকুপানী শুনিছিলোঁ... কুমীৰৰ ফটো প্ৰথমবাৰ!"}, {"id": 111, "duration_s": 1.42, "emotion": "serious", "text": "এই ফটো তুলিছিল কোনে?"}, {"id": 112, "duration_s": 3.556, "emotion": "guilty", "text": "হয়... মই বনাইছিলোঁ। লাইকৰ বাবে।"}, {"id": 113, "duration_s": 0.88, "emotion": "angry", "text": "লাইক?!"}, {"id": 114, "duration_s": 3.27, "emotion": "embarrassed", "text": "আইতাৰ নিশান... সদায় ঠিক।"}, {"id": 115, "duration_s": 3.6, "emotion": "guilty", "text": "আৰু মই... চল্লিশ গ্ৰুপত নেদেখাকৈ পঠালোঁ।"}, {"id": 116, "duration_s": 3.53, "emotion": "sad", "text": "মোৰ তিনিশ টকীয়া বুট... এতিয়া কোনে লব?"}, {"id": 117, "duration_s": 1.02, "emotion": "stern_warning", "text": "ধনৰাম!"}, {"id": 118, "duration_s": 2.65, "emotion": "embarrassed", "text": "হ'ল হ'ল... এশ টকা। পুৰণি দাম।"}, {"id": 119, "duration_s": 3.14, "emotion": "tired", "text": "আৰু মই ৰাতিটো গেট-আসন কৰিলোঁ!"}, {"id": 120, "duration_s": 3.63, "emotion": "determined", "text": "হ'ল! এতিয়া মই চাওঁ। যিয়ে নলা বিখ্যাত কৰিলে..."}, {"id": 121, "duration_s": 1.43, "emotion": "stern_warning", "text": "...সেইজনেই নলা চাফা!"}, {"id": 122, "duration_s": 3.14, "emotion": "tired", "text": "টেনচন নলবা... টেনচন বহুত।"}, {"id": 123, "duration_s": 2.87, "emotion": "excited", "text": "লাইভ চলিছে! নলা চাফা, এপিছড এক!"}, {"id": 124, "duration_s": 2.88, "emotion": "serious", "text": "সংশোধন চল্লিশ গ্ৰুপলৈ যাব... কিন্তু আগতে চেক!"}, {"id": 125, "duration_s": 1.44, "emotion": "curious", "text": "বিস্কুট আছেনে?"}, {"id": 126, "duration_s": 2.26, "emotion": "excited", "text": "মোৰ চেণ্ডেল! দেখিলা? বিজ্ঞান!"}, {"id": 127, "duration_s": 4.18, "emotion": "serious", "text": "তদন্ত... শেষ। কেছ বন্ধ।"}, {"id": 128, "duration_s": 4.29, "emotion": "calm", "text": "সন্ধিয়া হ'ল, বৰষুণ ৰ'ল... আৰু নলা জিলিকিল।"}, {"id": 129, "duration_s": 5.65, "emotion": "calm", "text": "এখন নকলী ফটো... আৰু গোটেই কলোনী চাদত।"}, {"id": 130, "duration_s": 2.02, "emotion": "guilty", "text": "কোকা, মাত্ৰ ধেমালি আছিল..."}, {"id": 131, "duration_s": 4.1, "emotion": "serious", "text": "ধেমালি তোমাৰ আছিল। ভয় কলোনীৰ।"}, {"id": 132, "duration_s": 2.67, "emotion": "curious", "text": "তেন্তে সঁচা কেনেকৈ গম পাম, কোকা?"}, {"id": 133, "duration_s": 5.29, "emotion": "serious", "text": "মই কওঁনে? কোনে পঠালে, ছাঁ, জোখ - আগতে পৰীক্ষা কৰা।"}, {"id": 134, "duration_s": 3.1, "emotion": "stern_warning", "text": "সন্দেহ হ'লে নপঠাবা! আৰু মিছাৰ ৰিপৰ্ট কৰা!"}, {"id": 135, "duration_s": 4.05, "emotion": "serious", "text": "ফৰৱাৰ্ডৰ আগতে ভাবা..."}, {"id": 136, "duration_s": 3.93, "emotion": "tender", "text": "...নহ'লে এদিন সঁচাকো মিছা লাগিব।"}, {"id": 137, "duration_s": 2.47, "emotion": "relieved", "text": "বলা! এতিয়া কুমীৰ-টুমীৰ নাই।"}, {"id": 138, "duration_s": 2.18, "emotion": "excited", "text": "দেউতা! নলাত সঁচাকৈ আছে!"}, {"id": 139, "duration_s": 3.08, "emotion": "sarcastic", "text": "হয় হয়... কুমীৰ। যথেষ্ট হ'ল।"}, {"id": 140, "duration_s": 0.9, "emotion": "comic_panic", "text": "মই কাকো নেডৰাওঁ!"}]