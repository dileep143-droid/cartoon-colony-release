[{"id": 1, "duration_s": 3.94, "emotion": "mischievous", "text": "দীপাবলির রাত। পাড়া জুড়ে ঝলমল..."}, {"id": 2, "duration_s": 3.05, "emotion": "sarcastic", "text": "...আর গোটা পাড়া এক লাইনে দাঁড়িয়ে!"}, {"id": 3, "duration_s": 2.49, "emotion": "comic_panic", "text": "শুনেছ গো? আমার পেটে বোমা ফাটছে!"}, {"id": 4, "duration_s": 2.88, "emotion": "worried", "text": "নজর লেগেছে! বাথরুমে নজর লেগেছে!"}, {"id": 5, "duration_s": 3.22, "emotion": "determined", "text": "পেট কনকন করছে... তবু খিদে পাচ্ছে!"}, {"id": 6, "duration_s": 1.66, "emotion": "comic_panic", "text": "ভেতরে কে? জলদি!"}, {"id": 7, "duration_s": 0.93, "emotion": "calm", "text": "চিন্তা নেই!"}, {"id": 8, "duration_s": 2.4, "emotion": "calm", "text": "এ সবের শুরু... তিন দিন আগে।"}, {"id": 9, "duration_s": 3.35, "emotion": "mischievous", "text": "একটা বেজায় চকচকে মিষ্টি থেকে।"}, {"id": 10, "duration_s": 2.77, "emotion": "happy", "text": "দীপাবলির সপ্তাহ। পাড়া সাজছে।"}, {"id": 11, "duration_s": 3.64, "emotion": "proud", "text": "মেগা সেল! কাজুকাতলি অর্ধেক দামে!"}, {"id": 12, "duration_s": 4.01, "emotion": "excited", "text": "চকচকে মিষ্টি! খিদে পেয়েছে!"}, {"id": 13, "duration_s": 5.25, "emotion": "mischievous", "text": "হারেনদা, দুশো বাক্স, আদ্দেক দামে, খাঁটি রুপো!"}, {"id": 14, "duration_s": 3.02, "emotion": "excited", "text": "সস্তার মাল, মোটা লাভ!"}, {"id": 15, "duration_s": 4.45, "emotion": "stern_warning", "text": "হিসেবি হারেন! অর্ধেক দামে খাঁটি রুপো?"}, {"id": 16, "duration_s": 3.19, "emotion": "proud", "text": "ভবানী, এ দীপাবলির বরকত!"}, {"id": 17, "duration_s": 0.87, "emotion": "excited", "text": "একটা বুদ্ধি!"}, {"id": 18, "duration_s": 3.95, "emotion": "excited", "text": "ঠাকুমা! খোকার মায়ের চেয়ে বড় থালা, অর্ধেক দাম!"}, {"id": 19, "duration_s": 4.84, "emotion": "mischievous", "text": "এবার আমার থালা দেখে... গোটা পাড়া হাঁ হবে!"}, {"id": 20, "duration_s": 3.96, "emotion": "serious", "text": "মা, অর্ধেক দামে কাজুকাতলি? কিছু গোলমাল আছে।"}, {"id": 21, "duration_s": 2.74, "emotion": "proud", "text": "গোলমাল নয়, সাশ্রয়!"}, {"id": 22, "duration_s": 2.52, "emotion": "mischievous", "text": "আর শুরু হলো... থালার যুদ্ধ!"}, {"id": 23, "duration_s": 3.0, "emotion": "proud", "text": "পাঁচ বাক্স! সবচেয়ে বড়গুলো!"}, {"id": 24, "duration_s": 2.94, "emotion": "proud", "text": "এক পয়সাও কম নয়!"}, {"id": 25, "duration_s": 2.97, "emotion": "shocked", "text": "শুনেছ গো? কমলা ঠাকুমার পাঁচ বাক্স!"}, {"id": 26, "duration_s": 2.45, "emotion": "proud", "text": "ছয় বাক্স, হারেন! ছয়!"}, {"id": 27, "duration_s": 1.09, "emotion": "determined", "text": "সাত!"}, {"id": 28, "duration_s": 0.68, "emotion": "excited", "text": "চিন্তা নেই! ভোম্বলের প্রিমিয়াম হ্যাম্পার!"}, {"id": 29, "duration_s": 5.62, "emotion": "mischievous", "text": "ডবল দাম মাসিমা... ডবল সম্মান!"}, {"id": 30, "duration_s": 3.15, "emotion": "worried", "text": "এত মিষ্টি! নজর লেগে যাবে!"}, {"id": 31, "duration_s": 2.38, "emotion": "proud", "text": "গোটা পাড়া দেখবে!"}, {"id": 32, "duration_s": 2.68, "emotion": "proud", "text": "আমি কাউকে ডরাই না! খোকার মাকেও না!"}, {"id": 33, "duration_s": 3.55, "emotion": "curious", "text": "অর্ধেক দামে রুপো? সন্দেহ হচ্ছে।"}, {"id": 34, "duration_s": 1.86, "emotion": "sarcastic", "text": "বড়দের কে বোঝাবে?"}, {"id": 35, "duration_s": 5.61, "emotion": "giggly", "text": "স্কোর? বারো-বারো বাক্স। লড়াই সমান!"}, {"id": 36, "duration_s": 3.58, "emotion": "stern_warning", "text": "রসো, তুই পাহারাদার। এক টুকরোও নয়!"}, {"id": 37, "duration_s": 1.27, "emotion": "determined", "text": "এক টুকরোও নয়!"}, {"id": 38, "duration_s": 2.47, "emotion": "proud", "text": "আমার আলপনা বড়।"}, {"id": 39, "duration_s": 1.86, "emotion": "sarcastic", "text": "আমার আলপনায় রং বেশি।"}, {"id": 40, "duration_s": 4.16, "emotion": "serious", "text": "তদন্ত হবে! মিষ্টির নিরাপত্তার!"}, {"id": 41, "duration_s": 1.13, "emotion": "excited", "text": "মিষ্টি?"}, {"id": 42, "duration_s": 1.49, "emotion": "happy", "text": "তদন্ত শেষ।"}, {"id": 43, "duration_s": 2.9, "emotion": "shocked", "text": "রসো! থালাগুলো কোথায়?"}, {"id": 44, "duration_s": 2.58, "emotion": "guilty", "text": "ইয়ে... নজর লেগেছে!"}, {"id": 45, "duration_s": 1.99, "emotion": "excited", "text": "দেখলি! বলেছিলাম!"}, {"id": 46, "duration_s": 2.72, "emotion": "excited", "text": "হ্যাম্পার নিন! গোটা পাড়ার জন্য!"}, {"id": 47, "duration_s": 4.01, "emotion": "serious", "text": "এখন হারেনের মিষ্টি... ঘরে ঘরে পৌঁছে গেছে।"}, {"id": 48, "duration_s": 2.26, "emotion": "excited", "text": "হাই গাইজ! লাইভ চলছে!"}, {"id": 49, "duration_s": 2.59, "emotion": "sarcastic", "text": "এত সবুজ তো... পাতাও হয় না।"}, {"id": 50, "duration_s": 5.04, "emotion": "excited", "text": "মিষ্টি মুকবাং! আজকের বরফি... নিয়ন সবুজ!"}, {"id": 51, "duration_s": 3.77, "emotion": "proud", "text": "বিজ্ঞান বলে... যত রং, তত ভিটামিন!"}, {"id": 52, "duration_s": 2.11, "emotion": "happy", "text": "শুনেছ গাইজ? হেলদি!"}, {"id": 53, "duration_s": 4.9, "emotion": "serious", "text": "সবুজ জিভ? বিজ্ঞান বলে... এ হলো সবুজায়ন।"}, {"id": 54, "duration_s": 3.2, "emotion": "shocked", "text": "গাইজ, জিভ নীল হয়ে গেল! নতুন ফিল্টার?"}, {"id": 55, "duration_s": 3.69, "emotion": "embarrassed", "text": "বিজ্ঞান বলে... এ হলো ব্যথা।"}, {"id": 56, "duration_s": 3.48, "emotion": "proud", "text": "দুই লাখ ভিউ! সবাই নীল বরফি খাও!"}, {"id": 57, "duration_s": 3.53, "emotion": "happy", "text": "দীপাবলির সন্ধ্যে। কমলা ঠাকুমার মিষ্টির পার্টি!"}, {"id": 58, "duration_s": 4.22, "emotion": "proud", "text": "আসুন, আসুন! গোটা পাড়া দেখবে... আর খাবে!"}, {"id": 59, "duration_s": 3.32, "emotion": "sarcastic", "text": "কমলাদি, আপনার কাতলি এত চকচক করে কেন?"}, {"id": 60, "duration_s": 3.17, "emotion": "proud", "text": "খাঁটি রুপো! অর্ধেক দামের!"}, {"id": 61, "duration_s": 0.82, "emotion": "proud", "text": "আমারও!"}, {"id": 62, "duration_s": 2.89, "emotion": "curious", "text": "মাস্টারমশাই, এ মিষ্টি খাঁটি?"}, {"id": 63, "duration_s": 3.12, "emotion": "happy", "text": "ময়না সবুজ? হ্যাঁ হ্যাঁ, খুব সুন্দর!"}, {"id": 64, "duration_s": 2.46, "emotion": "shocked", "text": "ময়না নয়, মাস্টারমশাই... মিষ্টি!"}, {"id": 65, "duration_s": 3.34, "emotion": "excited", "text": "ময়না সবুজ, বরফিও সবুজ! বাঃ!"}, {"id": 66, "duration_s": 2.65, "emotion": "proud", "text": "বিজ্ঞান বলে... চকচক মানে তাজা!"}, {"id": 67, "duration_s": 2.837, "emotion": "proud", "text": "আমি কোনো মিষ্টিকে ডরাই না!"}, {"id": 68, "duration_s": 3.47, "emotion": "happy", "text": "মেঘ ডাকছে? দীপাবলিতে বৃষ্টি!"}, {"id": 69, "duration_s": 3.5, "emotion": "comic_panic", "text": "শুনেছ গো? আমার পেটও কথা বলছে!"}, {"id": 70, "duration_s": 4.43, "emotion": "giggly", "text": "আর তারপর... গোটা পাড়ার পেট একসাথে ডাকল।"}, {"id": 71, "duration_s": 2.839, "emotion": "sarcastic", "text": "চোদ্দোজন। একটাই বাথরুম।"}, {"id": 72, "duration_s": 2.62, "emotion": "comic_panic", "text": "আমি কাউকে ডরাই না... কিন্তু জলদি!"}, {"id": 73, "duration_s": 1.8, "emotion": "stern_warning", "text": "হারেন! লাইনে!"}, {"id": 74, "duration_s": 3.15, "emotion": "pleading", "text": "এগিয়ে যেতে... দুটো টাকা দেব?"}, {"id": 75, "duration_s": 4.18, "emotion": "sarcastic", "text": "খোকার মা, তোর পেট... আমার চেয়েও বেশি বকে!"}, {"id": 76, "duration_s": 2.35, "emotion": "comic_panic", "text": "লাইভ চলছে... বাথরুমের লাইন থেকে!"}, {"id": 77, "duration_s": 1.88, "emotion": "determined", "text": "থামো! এবার আমি দেখছি।"}, {"id": 78, "duration_s": 3.07, "emotion": "serious", "text": "এক লিটার ফোটানো ঠান্ডা জল, ছয় চামচ চিনি..."}, {"id": 79, "duration_s": 2.28, "emotion": "serious", "text": "...আধ চামচ নুন। চুমুকে চুমুকে খাও।"}, {"id": 80, "duration_s": 3.2, "emotion": "worried", "text": "দুটো লেবু কম... এই তৃতীয়টা!"}, {"id": 81, "duration_s": 2.31, "emotion": "calm", "text": "দু মিনিট... চিন্তা নেই!"}, {"id": 82, "duration_s": 3.49, "emotion": "crying", "text": "ভোম্বল, তোর দু মিনিট... রাতের চেয়েও লম্বা!"}, {"id": 83, "duration_s": 1.83, "emotion": "guilty", "text": "শেষটা... পাক্কা শেষ।"}, {"id": 84, "duration_s": 1.69, "emotion": "determined", "text": "ওষুধের দোকান! চলো, চলো!"}, {"id": 85, "duration_s": 3.86, "emotion": "tired", "text": "তদন্ত হবে... হেঁটে।"}, {"id": 86, "duration_s": 3.87, "emotion": "curious", "text": "সবার পেট খারাপ... আমরা তিনজন ঠিক কেন?"}, {"id": 87, "duration_s": 2.3, "emotion": "proud", "text": "কারণ আমরা মিতালি মাসির ঘরের নাড়ু খেয়েছি!"}, {"id": 88, "duration_s": 4.44, "emotion": "determined", "text": "আর এই প্রমাণ। কাল সকালে... বিজ্ঞান পরীক্ষা!"}, {"id": 89, "duration_s": 3.18, "emotion": "sarcastic", "text": "সে রাতে বাজি কম ফাটল... পেট বেশি।"}, {"id": 90, "duration_s": 2.43, "emotion": "curious", "text": "পরদিন সকাল। টুব্লুর ল্যাব।"}, {"id": 91, "duration_s": 2.65, "emotion": "proud", "text": "বিজ্ঞান বলে... চকচক মানে তাজা!"}, {"id": 92, "duration_s": 2.16, "emotion": "angry", "text": "আমার মিষ্টি খাঁটি ছিল!"}, {"id": 93, "duration_s": 1.39, "emotion": "angry", "text": "আমারটা আরও খাঁটি!"}, {"id": 94, "duration_s": 1.51, "emotion": "shouting", "text": "চুপ! টুব্লু বলছে!"}, {"id": 95, "duration_s": 2.54, "emotion": "proud", "text": "আমি বলি? স্কুলের পরীক্ষা।"}, {"id": 96, "duration_s": 2.82, "emotion": "stern_warning", "text": "আয়োডিন ঘায়ের ওষুধ। খাওয়ার নয়!"}, {"id": 97, "duration_s": 3.68, "emotion": "serious", "text": "নীল-কালো মানে স্টার্চ। ময়দা বা আরারুট মেশানো!"}, {"id": 98, "duration_s": 2.92, "emotion": "serious", "text": "খাঁটি ক্ষীরে স্টার্চ নেই... রং বাদামিই থাকে।"}, {"id": 99, "duration_s": 2.94, "emotion": "serious", "text": "খাঁটি রুপোর পাত... ঘষলে গুঁড়ো হয়ে যায়।"}, {"id": 100, "duration_s": 3.49, "emotion": "stern_warning", "text": "এটা সেঁটে গেল, চকচকই রইল... নকল পাত!"}, {"id": 101, "duration_s": 1.43, "emotion": "proud", "text": "বিজ্ঞান বলে..."}, {"id": 102, "duration_s": 0.52, "emotion": "stern_warning", "text": "চুপ!"}, {"id": 103, "duration_s": 3.13, "emotion": "serious", "text": "আর এত ঝকঝকে রং? বিপদের ঘণ্টা।"}, {"id": 104, "duration_s": 2.12, "emotion": "stern_warning", "text": "পরীক্ষার মিষ্টি... খাওয়া বারণ!"}, {"id": 105, "duration_s": 3.08, "emotion": "proud", "text": "সাবাস টুব্লু! পরীক্ষার টুকরো ডাস্টবিনে।"}, {"id": 106, "duration_s": 3.58, "emotion": "embarrassed", "text": "আর আমি... ময়না ভেবে খেয়েই গেলাম।"}, {"id": 107, "duration_s": 2.91, "emotion": "serious", "text": "চেনা দোকান, বাক্সে তারিখ আর লাইসেন্স।"}, {"id": 108, "duration_s": 3.86, "emotion": "guilty", "text": "আর আমি... শুধু বড় থালার পিছনে ছুটছিলাম।"}, {"id": 109, "duration_s": 1.46, "emotion": "determined", "text": "চলো! হারেনের দোকান!"}, {"id": 110, "duration_s": 3.74, "emotion": "mischievous", "text": "গোটা পাড়া চলল... হারেনের দোকানে!"}, {"id": 111, "duration_s": 4.86, "emotion": "comic_panic", "text": "হ্যালো! তোমার খাঁটি রুপো... নকল বেরোল!"}, {"id": 112, "duration_s": 2.88, "emotion": "mischievous", "text": "কেডা হারেন? রং নাম্বার!"}, {"id": 113, "duration_s": 3.27, "emotion": "sad", "text": "আমাকেও ঠকিয়ে দিল... সস্তার লোভে।"}, {"id": 114, "duration_s": 4.19, "emotion": "stern_warning", "text": "হিসেবি হারেন! সব বাক্স ফেরত। সব টাকা ফেরত।"}, {"id": 115, "duration_s": 2.12, "emotion": "pleading", "text": "ভবানী... একটু কম?"}, {"id": 116, "duration_s": 1.48, "emotion": "angry", "text": "এক পয়সাও কম নয়!"}, {"id": 117, "duration_s": 2.31, "emotion": "crying", "text": "বিদায়... আদরের পয়সারা।"}, {"id": 118, "duration_s": 2.11, "emotion": "mischievous", "text": "চিন্তা নেই... আমি তো চললাম।"}, {"id": 119, "duration_s": 2.79, "emotion": "sarcastic", "text": "ডবল নিয়েছ... ডবল ফেরত দাও।"}, {"id": 120, "duration_s": 3.37, "emotion": "sad", "text": "মেগা সেল... মেগা ফেল।"}, {"id": 121, "duration_s": 2.75, "emotion": "happy", "text": "এবার মিষ্টি... ঘরেই হবে!"}, {"id": 122, "duration_s": 4.12, "emotion": "happy", "text": "বেসন, ঘি, চিনি... ব্যস! আর কিচ্ছু না।"}, {"id": 123, "duration_s": 2.5, "emotion": "loving", "text": "কমলাদি, আমার নারকেল বরফি... ঘরের।"}, {"id": 124, "duration_s": 2.69, "emotion": "happy", "text": "এবার থালা এক... আর দুজনের!"}, {"id": 125, "duration_s": 2.03, "emotion": "giggly", "text": "শুনলে গো? আমাদের ভাব হল!"}, {"id": 126, "duration_s": 1.99, "emotion": "excited", "text": "একটা বুদ্ধি! সবচেয়ে বড় নাড়ু!"}, {"id": 127, "duration_s": 1.25, "emotion": "sarcastic", "text": "চুপ! গোল বানাও।"}, {"id": 128, "duration_s": 3.24, "emotion": "giggly", "text": "রসো, আজ থেকে তুমি... টেস্টার!"}, {"id": 129, "duration_s": 2.18, "emotion": "excited", "text": "এই কাজ... আমার জন্যই বানানো!"}, {"id": 130, "duration_s": 1.68, "emotion": "proud", "text": "কোয়ালিটি চেক... চলছে।"}, {"id": 131, "duration_s": 4.36, "emotion": "happy", "text": "আর এল... খাঁটি, পরিষ্কার, মিষ্টি দীপাবলি!"}, {"id": 132, "duration_s": 2.95, "emotion": "proud", "text": "গোটা পাড়া দেখবে... একই থালা!"}, {"id": 133, "duration_s": 1.88, "emotion": "embarrassed", "text": "এবার... মাগনা!"}, {"id": 134, "duration_s": 5.02, "emotion": "worried", "text": "হারেনদা, বিনি পয়সায়? চলো, চলো... ডাক্তারের কাছে!"}, {"id": 135, "duration_s": 3.79, "emotion": "proud", "text": "বিজ্ঞান বলে... ঘরের তৈরি, সেরা!"}, {"id": 136, "duration_s": 5.23, "emotion": "proud", "text": "এবার ঠিক শুনেছি... মিষ্টি খাঁটি!"}, {"id": 137, "duration_s": 1.11, "emotion": "curious", "text": "দাদু! আজকের শিক্ষা?"}, {"id": 138, "duration_s": 3.57, "emotion": "calm", "text": "সস্তা দেখে নয়... খাঁটি দেখে কিনো।"}, {"id": 139, "duration_s": 1.5, "emotion": "happy", "text": "শুভ দীপাবলি!"}]