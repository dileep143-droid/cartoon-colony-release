[{"id": 1, "duration_s": 3.77, "emotion": "mischievous", "text": "இது நம்ம காலனி, இது நம்ம பெரிய டேங்க்."}, {"id": 2, "duration_s": 6.51, "emotion": "mischievous", "text": "இந்த டேங்குக்குள்ள... ஒரு பேய் இருக்கு! ஊஊஊ!"}, {"id": 3, "duration_s": 1.84, "emotion": "curious", "text": "பேய்லாம் இல்ல. நான் சொல்லவா?"}, {"id": 4, "duration_s": 0.8, "emotion": "stern_warning", "text": "உஷ்!"}, {"id": 5, "duration_s": 3.92, "emotion": "mischievous", "text": "என் புதையல்... இங்க யாரும் தேட மாட்டாங்க."}, {"id": 6, "duration_s": 2.1, "emotion": "sarcastic", "text": "உன் பேய் டார்ச்சுக்கே பயப்படுது."}, {"id": 7, "duration_s": 2.55, "emotion": "mischievous", "text": "பேய் நிஜம்! இன்னிக்கு ராத்திரி பாரு!"}, {"id": 8, "duration_s": 1.78, "emotion": "calm", "text": "பசங்களா! சாப்பாடு ரெடி!"}, {"id": 9, "duration_s": 2.48, "emotion": "giggly", "text": "போண்டா முன்னாடியே ஓடிட்டான்!"}, {"id": 10, "duration_s": 3.49, "emotion": "scared_whisper", "text": "அப்புறம்... நடுராத்திரி பன்னிரண்டுக்கு..."}, {"id": 11, "duration_s": 1.86, "emotion": "scared_whisper", "text": "ப... ப... பே... பேய்!"}, {"id": 12, "duration_s": 2.38, "emotion": "panicked", "text": "கண்ணு பட்டுடுச்சு... டேங்குக்கு!"}, {"id": 13, "duration_s": 3.56, "emotion": "scared_whisper", "text": "காமாட்சி! எந்திரி! டேங்குல பேய்!"}, {"id": 14, "duration_s": 1.91, "emotion": "comic_panic", "text": "எலுமிச்சை! மிளகா!"}, {"id": 15, "duration_s": 2.1, "emotion": "excited", "text": "பேயா? அடடா! நெஜமா?"}, {"id": 16, "duration_s": 1.68, "emotion": "excited", "text": "கேட்டியா? டேங்குல பேய்!"}, {"id": 17, "duration_s": 2.96, "emotion": "mischievous", "text": "பத்தே நொடி... காலனிக்கே தெரிஞ்சு போச்சு."}, {"id": 18, "duration_s": 2.01, "emotion": "excited", "text": "ஹலோ ஃப்ரெண்ட்ஸ்! Live-la இருக்கோம்!"}, {"id": 19, "duration_s": 2.17, "emotion": "excited", "text": "பேய் லைவ்! ரெண்டு லட்சம் வியூஸ்!"}, {"id": 20, "duration_s": 1.4, "emotion": "scared_whisper", "text": "பேய் சார், ஒரு செல்ஃபி?"}, {"id": 21, "duration_s": 3.11, "emotion": "proud", "text": "அறிவியல் சொல்லுது... பேய் வைஃபைல வருது!"}, {"id": 22, "duration_s": 1.66, "emotion": "proud", "text": "வைஃபை ஆஃப். பேய் காலி."}, {"id": 23, "duration_s": 2.3, "emotion": "serious", "text": "ஸ்ருதி தப்பு. பத்துக்கு நாலு."}, {"id": 24, "duration_s": 1.72, "emotion": "happy", "text": "ஆங்! இப்போ ஏழு!"}, {"id": 25, "duration_s": 1.81, "emotion": "proud", "text": "பேயாவது பிசாசாவது!"}, {"id": 26, "duration_s": 1.36, "emotion": "proud", "text": "நான் யாருக்கும் பயப்பட மாட்டேன்!"}, {"id": 27, "duration_s": 3.286, "emotion": "sarcastic", "text": "நேத்து பல்லியைப் பார்த்து பீரோ மேல ஏறினது யாரு?"}, {"id": 28, "duration_s": 2.79, "emotion": "embarrassed", "text": "அது... பீரோ மேல தூசி பார்த்தேன்."}, {"id": 29, "duration_s": 2.33, "emotion": "proud", "text": "போ ராசா! ஊரே பார்க்கட்டும்!"}, {"id": 30, "duration_s": 3.394, "emotion": "scared_whisper", "text": "பேய் அண்ணே... நான் சும்மா... காத்து வாங்க வந்தேன்."}, {"id": 31, "duration_s": 2.09, "emotion": "sarcastic", "text": "வந்துட்டீங்களா? காத்து வாங்கியாச்சா?"}, {"id": 32, "duration_s": 2.75, "emotion": "scared_whisper", "text": "ஆமா... ரொம்ப... நல்ல காத்து."}, {"id": 33, "duration_s": 3.83, "emotion": "guilty", "text": "நான் சும்மா... வெளையாட்டுக்குதான் சொன்னேன்."}, {"id": 34, "duration_s": 2.58, "emotion": "mischievous", "text": "கவலை வேணாம்! பேய் இருந்தா பிசினஸ்!"}, {"id": 35, "duration_s": 3.91, "emotion": "mischievous", "text": "மறுநாள் காலை... காலனிக்கு பயம். கந்தசாமிக்கு சந்தோஷம்."}, {"id": 36, "duration_s": 2.23, "emotion": "comic_panic", "text": "பேய் தண்ணியா? ஐயோ வேணாம்!"}, {"id": 37, "duration_s": 1.54, "emotion": "sarcastic", "text": "அப்போ டீ எதுல போடுறது?"}, {"id": 38, "duration_s": 2.9, "emotion": "proud", "text": "ஒரு வாளி ரெண்டு ரூபா! வரிசைல!"}, {"id": 39, "duration_s": 2.108, "emotion": "serious", "text": "நாய் குடிச்சாலும் ரெண்டு ரூபா."}, {"id": 40, "duration_s": 2.3, "emotion": "proud", "text": "ஒரு ரூபா கூட கம்மி இல்ல!"}, {"id": 41, "duration_s": 2.15, "emotion": "stern_warning", "text": "கந்தசாமி! வீட்டுலயுமா காசு?"}, {"id": 42, "duration_s": 2.22, "emotion": "embarrassed", "text": "வீட்டாளுக்கு... பாதி விலை."}, {"id": 43, "duration_s": 2.6, "emotion": "comic_panic", "text": "போண்டா! நாப்பது வாளி ஆச்சு!"}, {"id": 44, "duration_s": 1.54, "emotion": "happy", "text": "தாகமா இருந்துச்சு!"}, {"id": 45, "duration_s": 1.46, "emotion": "happy", "text": "போலாம் வாங்க! தண்ணிக்கு!"}, {"id": 46, "duration_s": 1.1, "emotion": "sad", "text": "இன்னிக்குமா ராணி?"}, {"id": 47, "duration_s": 2.62, "emotion": "excited", "text": "கேட்டியா? பேய் ராத்திரி என் பேரைச் சொல்லுச்சு!"}, {"id": 48, "duration_s": 2.7, "emotion": "proud", "text": "ஹும்! என் பேரை ரெண்டு தடவை!"}, {"id": 49, "duration_s": 3.04, "emotion": "proud", "text": "அறிவியல் சொல்லுது... பேய்க்கு ஜில் தண்ணி புடிக்கும்."}, {"id": 50, "duration_s": 1.48, "emotion": "stern_warning", "text": "உஷ்!"}, {"id": 51, "duration_s": 1.07, "emotion": "curious", "text": "நான் சொல்லவா? அப்புறம்."}, {"id": 52, "duration_s": 2.33, "emotion": "excited", "text": "மக்களே! பேய் பயமா? கவலை வேணாம்!"}, {"id": 53, "duration_s": 1.99, "emotion": "proud", "text": "இதோ... தாந்திரீக சாமியப்பா!"}, {"id": 54, "duration_s": 4.02, "emotion": "serious", "text": "அலக் நிரஞ்சன்! பேயி ரொம்பப் பெருசுலே!"}, {"id": 55, "duration_s": 3.73, "emotion": "embarrassed", "text": "ஹி ஹி... இது சாமியோட... தலைகீழ் யோகம்!"}, {"id": 56, "duration_s": 1.83, "emotion": "curious", "text": "தாடி தலைகீழ்!"}, {"id": 57, "duration_s": 0.69, "emotion": "serious", "text": "குறிச்சுக்கோ!"}, {"id": 58, "duration_s": 3.18, "emotion": "proud", "text": "பேய்ப்ரூஃப் எலுமிச்சை! அஞ்சுநூறுதான்லே!"}, {"id": 59, "duration_s": 3.81, "emotion": "shocked", "text": "அஞ்சு நூறா? என் கடைல ரெண்டு ரூபா!"}, {"id": 60, "duration_s": 1.08, "emotion": "comic_panic", "text": "ரெண்டு குடுங்க!"}, {"id": 61, "duration_s": 2.69, "emotion": "excited", "text": "சாமி, எனக்கு எலுமிச்சை-மிளகா காம்போ!"}, {"id": 62, "duration_s": 1.28, "emotion": "proud", "text": "எட்டு எலுமிச்சை! எட்டு!"}, {"id": 63, "duration_s": 5.68, "emotion": "proud", "text": "எட்டா? ஹும்! பத்து குடு! ஊரே பார்க்கட்டும்!"}, {"id": 64, "duration_s": 1.71, "emotion": "happy", "text": "பத்து! ஒண்ணு ஃப்ரீ!"}, {"id": 65, "duration_s": 3.94, "emotion": "angry", "text": "ஹலோ? சாமி, பன்னிரண்டு கிடைக்குமா?"}, {"id": 66, "duration_s": 3.38, "emotion": "proud", "text": "இனிமே நான் யாருக்கும் பயப்படமாட்டேன்!"}, {"id": 67, "duration_s": 1.09, "emotion": "sarcastic", "text": "பல்லிக்குமா?"}, {"id": 68, "duration_s": 1.56, "emotion": "sarcastic", "text": "எலுமிச்சை நல்லா உதவுச்சு."}, {"id": 69, "duration_s": 2.46, "emotion": "sarcastic", "text": "அஞ்சாயிரத்துக்கு எலுமிச்சை, மாமா!"}, {"id": 70, "duration_s": 1.35, "emotion": "calm", "text": "லெமன் ஜூஸ் நல்லா இருக்கும்."}, {"id": 71, "duration_s": 4.43, "emotion": "mischievous", "text": "சாயங்காலம் மனுஷங்க கம்மி, எலுமிச்சை அதிகம்."}, {"id": 72, "duration_s": 2.45, "emotion": "mischievous", "text": "இன்னிக்கு ராத்திரி ஒரு தூள் 'ஊஊஊ' வேணும்."}, {"id": 73, "duration_s": 2.9, "emotion": "mischievous", "text": "காத்து அடிச்சா... டபுள் வியாபாரம்லே!"}, {"id": 74, "duration_s": 3.25, "emotion": "mischievous", "text": "ராத்திரி... காலனி முழுக்க தாத்தா வீட்டு முற்றத்துல."}, {"id": 75, "duration_s": 4.51, "emotion": "tired", "text": "விசாரணை... குர்ர்ர்..."}, {"id": 76, "duration_s": 2.52, "emotion": "serious", "text": "அறிவியல்படி பேய் பன்னிரண்டுக்குதான் வரும்."}, {"id": 77, "duration_s": 2.07, "emotion": "tired", "text": "இப்போ பதினொன்றரை. தூங்குங்க."}, {"id": 78, "duration_s": 1.42, "emotion": "angry", "text": "கேட்டியா? திருட்டு!"}, {"id": 79, "duration_s": 2.89, "emotion": "guilty", "text": "இதெல்லாம்... என் கதையாலதான்."}, {"id": 80, "duration_s": 0.99, "emotion": "serious", "text": "உஷ்! கேளு."}, {"id": 81, "duration_s": 2.72, "emotion": "shouting", "text": "யாரது? விசாரணை!"}, {"id": 82, "duration_s": 1.64, "emotion": "excited", "text": "அடடா! பத்துக்குப் பத்து!"}, {"id": 83, "duration_s": 1.38, "emotion": "comic_panic", "text": "பேய்! பேய்! பேய்!"}, {"id": 84, "duration_s": 1.05, "emotion": "panicked", "text": "ஐயோ பேய்!"}, {"id": 85, "duration_s": 2.37, "emotion": "comic_panic", "text": "நான்தான்! முருகேசன்!"}, {"id": 86, "duration_s": 0.96, "emotion": "panicked", "text": "பேய் பேசுதே!"}, {"id": 87, "duration_s": 2.26, "emotion": "determined", "text": "பேயா? என் செருப்பைப் பாரு!"}, {"id": 88, "duration_s": 3.74, "emotion": "embarrassed", "text": "அம்மா... குறி இன்னும்... பிசகல."}, {"id": 89, "duration_s": 1.88, "emotion": "excited", "text": "Live-la இருக்கோம்! அஞ்சு லட்சம்!"}, {"id": 90, "duration_s": 2.11, "emotion": "comic_panic", "text": "வாங்க, போகலாம்! எல்லாரும் ஆட்டோல!"}, {"id": 91, "duration_s": 1.58, "emotion": "determined", "text": "போதும்! இப்போ நான் பாக்குறேன்!"}, {"id": 92, "duration_s": 3.43, "emotion": "calm", "text": "மருமகளே, கொஞ்சம் எண்ணிப் பாரு. பசங்க எங்க?"}, {"id": 93, "duration_s": 2.79, "emotion": "determined", "text": "ஒரு idea இருக்கு! பேய்கிட்டயே கேள்வி கேட்போம்."}, {"id": 94, "duration_s": 3.55, "emotion": "curious", "text": "நான் சொல்லவா? பயம் கேள்விக்கு ஓடும்."}, {"id": 95, "duration_s": 1.63, "emotion": "stern_warning", "text": "உஷ்! முதல்ல நான்."}, {"id": 96, "duration_s": 2.09, "emotion": "proud", "text": "நான் ஸ்நாக்ஸைக் காப்பாத்துவேன்."}, {"id": 97, "duration_s": 2.06, "emotion": "sarcastic", "text": "பேய் மாட்டிச்சு. பசிப்பேய்!"}, {"id": 98, "duration_s": 3.87, "emotion": "curious", "text": "பாருங்க! காத்து அடிச்சாதான் சத்தம் வருது!"}, {"id": 99, "duration_s": 1.82, "emotion": "laughing", "text": "பேய்... என் விரலுக்கே பயப்படுது!"}, {"id": 100, "duration_s": 4.28, "emotion": "proud", "text": "காத்து, பைப், விரிசல். பேய் ஒண்ணு க்ளோஸ்!"}, {"id": 101, "duration_s": 3.15, "emotion": "curious", "text": "சத்தம் பைப்பு சரி. அப்போ கண்ணு?"}, {"id": 102, "duration_s": 2.28, "emotion": "proud", "text": "டார்ச் வெளிச்சம் பூனை கண்ணுல மின்னும்."}, {"id": 103, "duration_s": 1.82, "emotion": "happy", "text": "பேய் இல்ல, பூனை!"}, {"id": 104, "duration_s": 2.25, "emotion": "stern_warning", "text": "உள்ள யாரும் போகக்கூடாது. போண்டா, பை குடு!"}, {"id": 105, "duration_s": 4.08, "emotion": "sad", "text": "என் சமோசா, பிஸ்கட்... டாட்டா."}, {"id": 106, "duration_s": 1.04, "emotion": "happy", "text": "வா வா, குட்டிப் பேய்!"}, {"id": 107, "duration_s": 2.08, "emotion": "tender", "text": "பிஸ்கட் திங்கத்தான் உள்ள போச்சு."}, {"id": 108, "duration_s": 1.92, "emotion": "surprised", "text": "அட! உள்ள ஒரு டப்பாவும் இருக்கு!"}, {"id": 109, "duration_s": 3.36, "emotion": "embarrassed", "text": "பசிச்சுது! அதான் ஜில்லுனு இடம்!"}, {"id": 110, "duration_s": 2.09, "emotion": "stern_warning", "text": "உஷ்! ...சரி, ஒண்ணு குடு."}, {"id": 111, "duration_s": 3.14, "emotion": "shouting", "text": "நில்லுலே! பேயி ரொம்ப ஆபத்துலே!"}, {"id": 112, "duration_s": 2.44, "emotion": "proud", "text": "இதோ உங்க பேய்!"}, {"id": 113, "duration_s": 3.2, "emotion": "excited", "text": "பத்து லட்சம்! பேய் இல்ல, பூனை வைரல்!"}, {"id": 114, "duration_s": 2.39, "emotion": "proud", "text": "இதான் பேய் பாட்டு. ஓட்டை பைப்பு."}, {"id": 115, "duration_s": 2.68, "emotion": "proud", "text": "அறிவியல் சொல்லுது... எனக்கு முன்னாடியே தெரியும்."}, {"id": 116, "duration_s": 2.73, "emotion": "shocked", "text": "அடடா! இவர் திருவிழா பலூன்காரர்!"}, {"id": 117, "duration_s": 2.09, "emotion": "excited", "text": "கேட்டியா? சாமி போலி!"}, {"id": 118, "duration_s": 2.63, "emotion": "comic_panic", "text": "ஹி ஹி... சாமிக்கு நேரம் முடிஞ்சுலே!"}, {"id": 119, "duration_s": 2.26, "emotion": "angry", "text": "என் எலுமிச்சை ஆயிரம் ரூபா!"}, {"id": 120, "duration_s": 1.87, "emotion": "shouting", "text": "ஒரு ரூபா கூட கம்மி இல்ல!"}, {"id": 121, "duration_s": 2.5, "emotion": "stern_warning", "text": "சேகர்! காசைத் திருப்பு!"}, {"id": 122, "duration_s": 1.76, "emotion": "embarrassed", "text": "கவலை வேணாம் அண்ணி... எல்லாம் திரும்ப!"}, {"id": 123, "duration_s": 1.87, "emotion": "determined", "text": "என் பத்து எலுமிச்சை?"}, {"id": 124, "duration_s": 2.44, "emotion": "embarrassed", "text": "செருப்பு... என்னைக்கும் தப்பாது."}, {"id": 125, "duration_s": 3.33, "emotion": "sad", "text": "ஆயிரம் ரூபாய்க்கு... ஒத்தைச் செருப்பு."}, {"id": 126, "duration_s": 5.19, "emotion": "mischievous", "text": "டேங்க் அமைதி... இப்போ கந்தசாமி 'ஊஊஊ'ன்னு அழறார்."}, {"id": 127, "duration_s": 1.64, "emotion": "happy", "text": "போங்க! பேய்க்கு லீவு!"}, {"id": 128, "duration_s": 2.73, "emotion": "proud", "text": "பேய்-ப்ரூஃப் எலுமிச்சை... இப்போ தாக-ப்ரூஃப்!"}, {"id": 129, "duration_s": 3.76, "emotion": "proud", "text": "என் கிளாஸ் பெருசு. ஊரே பார்க்கட்டும்!"}, {"id": 130, "duration_s": 3.17, "emotion": "embarrassed", "text": "கண்ணு இல்ல... தாகம்தான்."}, {"id": 131, "duration_s": 3.77, "emotion": "guilty", "text": "கேட்டியா? ...முதல்ல விசாரிச்சுக்கறேன்."}, {"id": 132, "duration_s": 2.86, "emotion": "happy", "text": "பசி இல்ல... இன்னிக்கு தாகம்!"}, {"id": 133, "duration_s": 2.63, "emotion": "guilty", "text": "தாத்தா, எல்லாம் என் பேய்க் கதையாலதான்."}, {"id": 134, "duration_s": 3.84, "emotion": "serious", "text": "பயத்துக்கு மருந்து கேள்வி... சாமியார் இல்ல."}, {"id": 135, "duration_s": 3.9, "emotion": "calm", "text": "கேளு, சோதிச்சுப் பாரு, அப்புறம் நம்பு."}, {"id": 136, "duration_s": 2.94, "emotion": "proud", "text": "பயத்தை விக்கிறவங்களுக்கு... காசு இல்ல!"}, {"id": 137, "duration_s": 2.493, "emotion": "stern_warning", "text": "கேட்டீங்களா? இனி உஷ்!"}, {"id": 138, "duration_s": 2.27, "emotion": "proud", "text": "நான் சொன்னேன்ல? நான் யாருக்கும் பயப்பட மாட்டேன்!"}]