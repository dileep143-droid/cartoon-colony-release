[{"id": 1, "duration_s": 3.44, "emotion": "mischievous", "text": "रात्रीचे दोन... अख्खी कॉलनी झोपली होती."}, {"id": 2, "duration_s": 0.77, "emotion": "mischievous", "text": "एकाशिवाय."}, {"id": 3, "duration_s": 1.2, "emotion": "angry", "text": "माझ्या कानात विमानतळ?"}, {"id": 4, "duration_s": 2.12, "emotion": "proud", "text": "मी कुणाला घाबरत नाही!"}, {"id": 5, "duration_s": 3.63, "emotion": "giggly", "text": "दहा टाळ्या... वीस... तीस..."}, {"id": 6, "duration_s": 2.12, "emotion": "sarcastic", "text": "टाळ्या कसल्या? वरात आली का?"}, {"id": 7, "duration_s": 2.95, "emotion": "scared_whisper", "text": "चाळिसावी... आणि शेवटची."}, {"id": 8, "duration_s": 6.47, "emotion": "giggly", "text": "चाळीस टाळ्या. डास: शून्य. गणपत: चाळीस."}, {"id": 9, "duration_s": 5.21, "emotion": "determined", "text": "हटा! माझी चप्पल कधी चुकत नाही!"}, {"id": 10, "duration_s": 1.23, "emotion": "embarrassed", "text": "चुकली नाही... थेट मलाच बसली!"}, {"id": 11, "duration_s": 2.38, "emotion": "proud", "text": "बघ? नेम अचूक!"}, {"id": 12, "duration_s": 4.12, "emotion": "mischievous", "text": "आणि हे तर... फक्त सुरुवात होती."}, {"id": 13, "duration_s": 4.054, "emotion": "giggly", "text": "आणि सकाळपर्यंत... अख्खी कॉलनी खाजवत होती."}, {"id": 14, "duration_s": 4.22, "emotion": "excited", "text": "ऐकलंत का? रात्री डासांची फौज आली होती!"}, {"id": 15, "duration_s": 3.74, "emotion": "mischievous", "text": "कुलकर्णींनी स्वतःलाच चाळीस थपडा मारल्या!"}, {"id": 16, "duration_s": 2.94, "emotion": "embarrassed", "text": "तो डास नव्हता... हत्ती होता!"}, {"id": 17, "duration_s": 2.33, "emotion": "sarcastic", "text": "हत्ती नव्हे, आईची चप्पल होती."}, {"id": 18, "duration_s": 3.37, "emotion": "serious", "text": "दृष्ट लागली! डासांची दृष्ट!"}, {"id": 19, "duration_s": 2.33, "emotion": "shocked", "text": "अगं बाई! मिरचीही खाल्ली!"}, {"id": 20, "duration_s": 3.47, "emotion": "stern_warning", "text": "समोसा? थांबा! चौकशी!"}, {"id": 21, "duration_s": 1.94, "emotion": "happy", "text": "चौकशी संपली! भुकेला!"}, {"id": 22, "duration_s": 5.65, "emotion": "proud", "text": "सायन्स सांगतं, डास फक्त घाण गटारातच वाढतात!"}, {"id": 23, "duration_s": 0.75, "emotion": "curious", "text": "मी सांगू?"}, {"id": 24, "duration_s": 2.08, "emotion": "proud", "text": "पोरांनो गप्प! सायन्स बोलतंय."}, {"id": 25, "duration_s": 3.74, "emotion": "proud", "text": "आमची कॉलनी स्वच्छ, डास बाहेरून येतात!"}, {"id": 26, "duration_s": 4.09, "emotion": "excited", "text": "डासप्रूफ उदबत्ती! एक लावा, डास गायब!"}, {"id": 27, "duration_s": 1.94, "emotion": "determined", "text": "चाळीस द्या! एका टाळीमागे एक."}, {"id": 28, "duration_s": 2.26, "emotion": "stern_warning", "text": "दहाला एक. एक रुपयाही कमी नाही!"}, {"id": 29, "duration_s": 2.84, "emotion": "angry", "text": "धनाजी शेठ! ह्या तर मागच्या वर्षीच्या पूजेच्या!"}, {"id": 30, "duration_s": 3.49, "emotion": "embarrassed", "text": "जुनी पूजा... नवीन डास."}, {"id": 31, "duration_s": 5.55, "emotion": "giggly", "text": "संध्याकाळपर्यंत कॉलनीत ढग आले. डास नाही गेले."}, {"id": 32, "duration_s": 2.57, "emotion": "excited", "text": "लाईव्ह सुरू आहे! कॉलनीत ढग आले!"}, {"id": 33, "duration_s": 1.87, "emotion": "determined", "text": "धनाजी शेठ, हलू नका."}, {"id": 34, "duration_s": 3.54, "emotion": "tired", "text": "धूर गेला... डास नाही गेला."}, {"id": 35, "duration_s": 2.49, "emotion": "serious", "text": "दोन दिवसांनी. शेठच्या घरी."}, {"id": 36, "duration_s": 2.27, "emotion": "loving", "text": "ऊठ रे बाळा. तुझे आवडते लाडू."}, {"id": 37, "duration_s": 2.89, "emotion": "shocked", "text": "पेढ्याने... लाडूला नकार दिला?!"}, {"id": 38, "duration_s": 3.4, "emotion": "tired", "text": "आई... भूक... नाही लागली."}, {"id": 39, "duration_s": 3.06, "emotion": "worried", "text": "ताप आहे! अहो, डॉक्टर!"}, {"id": 40, "duration_s": 2.05, "emotion": "worried", "text": "फी...? असू दे! असू दे!"}, {"id": 41, "duration_s": 1.9, "emotion": "calm", "text": "ताप हाय तं सकाळी क्लिनिकला घिऊन या."}, {"id": 42, "duration_s": 2.45, "emotion": "serious", "text": "डेंग्यू तपासणी गरजंची. घाबरू नगा."}, {"id": 43, "duration_s": 2.76, "emotion": "serious", "text": "आन घराभोवती साचलेलं पानी हाय का?"}, {"id": 44, "duration_s": 1.69, "emotion": "proud", "text": "आमचं घर स्वच्छ आहे!"}, {"id": 45, "duration_s": 3.43, "emotion": "serious", "text": "डेंग्यूचा डास साफ, साचलेल्या पान्यातच वाढतोय."}, {"id": 46, "duration_s": 2.528, "emotion": "happy", "text": "चला, निघूया!"}, {"id": 47, "duration_s": 1.27, "emotion": "giggly", "text": "...आणि पोहोचलोही."}, {"id": 48, "duration_s": 2.57, "emotion": "relieved", "text": "डेंग्यू नाही निघाला. किरकोळ ताप आहे."}, {"id": 49, "duration_s": 2.36, "emotion": "pleading", "text": "मग... लाडू?"}, {"id": 50, "duration_s": 1.2, "emotion": "stern_warning", "text": "बरा झाल्यावर. फक्त एक."}, {"id": 51, "duration_s": 1.23, "emotion": "shocked", "text": "एक?!"}, {"id": 52, "duration_s": 1.98, "emotion": "excited", "text": "एक आयडिया सुचली! आपण होऊ..."}, {"id": 53, "duration_s": 1.69, "emotion": "excited", "text": "...डास गुप्तहेर!"}, {"id": 54, "duration_s": 1.47, "emotion": "proud", "text": "मी सांगू? यावेळी खरंच?"}, {"id": 55, "duration_s": 1.96, "emotion": "stern_warning", "text": "बोल! लौकर!"}, {"id": 56, "duration_s": 2.08, "emotion": "serious", "text": "डेंग्यूचा डास बहुतेक दिवसा चावतो."}, {"id": 57, "duration_s": 4.0, "emotion": "serious", "text": "गटारात नाही, स्वच्छ साचलेल्या पाण्यात अंडी देतो."}, {"id": 58, "duration_s": 3.43, "emotion": "shocked", "text": "हुशार हरीशदादाचं सायन्स... उलटं!"}, {"id": 59, "duration_s": 3.02, "emotion": "serious", "text": "पाण्यात छोटे किडे दिसले, तर तो लार्वा."}, {"id": 60, "duration_s": 2.49, "emotion": "serious", "text": "एका आठवड्यात, लार्व्यापासून डास!"}, {"id": 61, "duration_s": 3.4, "emotion": "determined", "text": "गुप्तहेरांनो! माझा बदला घ्या!"}, {"id": 62, "duration_s": 3.62, "emotion": "determined", "text": "प्रत्येक भांडं! प्रत्येक कुंडी! प्रत्येक टायर!"}, {"id": 63, "duration_s": 2.38, "emotion": "proud", "text": "हेरगिरी? मोठे सांभाळतील!"}, {"id": 64, "duration_s": 0.65, "emotion": "angry", "text": "गप्प!"}, {"id": 65, "duration_s": 3.21, "emotion": "excited", "text": "आणि सुरू झाली... डास हेरगिरी!"}, {"id": 66, "duration_s": 2.83, "emotion": "excited", "text": "सापडला! कुलरमध्ये लार्वा!"}, {"id": 67, "duration_s": 4.58, "emotion": "proud", "text": "माझा कुलर? नुसते... भाडेकरू आहेत."}, {"id": 68, "duration_s": 2.3, "emotion": "scared_whisper", "text": "मी... कुणाला... घाबरत नाही."}, {"id": 69, "duration_s": 2.45, "emotion": "panicked", "text": "सुनंदा! हा भाडं मागतोय!"}, {"id": 70, "duration_s": 2.89, "emotion": "stern_warning", "text": "सखू आजी, कुंडीच्या बशीतही!"}, {"id": 71, "duration_s": 2.37, "emotion": "proud", "text": "माझ्या कुंड्यांची तर रोज पूजा होते!"}, {"id": 72, "duration_s": 2.8, "emotion": "sarcastic", "text": "पूजाही, पाणीही... डासही."}, {"id": 73, "duration_s": 1.92, "emotion": "determined", "text": "बस्स! आता मी बघते."}, {"id": 74, "duration_s": 3.59, "emotion": "proud", "text": "आठवड्याला रिकामं, वाळवा. दहा सेकंद."}, {"id": 75, "duration_s": 2.963, "emotion": "embarrassed", "text": "मीही... मदत करत होतो."}, {"id": 76, "duration_s": 3.1, "emotion": "mischievous", "text": "आणि गच्चीवर... सोन्याचा नवा धंदा."}, {"id": 77, "duration_s": 0.93, "emotion": "excited", "text": "टेन्शन घेऊ नका!"}, {"id": 78, "duration_s": 4.86, "emotion": "proud", "text": "हा माझा टायर बिझनेस! वीस टायर, पुढच्या वर्षी वीस लाख!"}, {"id": 79, "duration_s": 2.63, "emotion": "serious", "text": "एका टायरमध्ये... शंभरावर लार्वा."}, {"id": 80, "duration_s": 1.1, "emotion": "shocked", "text": "आणि वीस टायरमध्ये?"}, {"id": 81, "duration_s": 2.0, "emotion": "shocked", "text": "अख्खी डासांची कॉलनी!"}, {"id": 82, "duration_s": 2.34, "emotion": "mischievous", "text": "मग... यांना भाडं लावू?"}, {"id": 83, "duration_s": 3.99, "emotion": "proud", "text": "माझ्या लोणच्याला ऊन! निदान मी तरी..."}, {"id": 84, "duration_s": 1.68, "emotion": "mischievous", "text": "आजी... तुमच्या झाकणातही."}, {"id": 85, "duration_s": 3.16, "emotion": "shocked", "text": "अरे देवा! अख्खी कॉलनी बघेल!"}, {"id": 86, "duration_s": 2.38, "emotion": "angry", "text": "हे सगळं तुझ्या टायरांमुळे!"}, {"id": 87, "duration_s": 2.002, "emotion": "panicked", "text": "बरण्याही!"}, {"id": 88, "duration_s": 1.8, "emotion": "embarrassed", "text": "नेम... पुन्हा अचूक."}, {"id": 89, "duration_s": 2.42, "emotion": "determined", "text": "टायर उलटे, पाणी बाहेर, धंदा आत!"}, {"id": 90, "duration_s": 4.23, "emotion": "excited", "text": "ऐका! कुलकर्णींच्या गच्चीवर वीस लाख!"}, {"id": 91, "duration_s": 3.5, "emotion": "panicked", "text": "वीस लाख... डास! डेंग्यू आला!"}, {"id": 92, "duration_s": 4.08, "emotion": "serious", "text": "दृष्ट लागली! प्रत्येक दारावर लिंबू!"}, {"id": 93, "duration_s": 3.46, "emotion": "mischievous", "text": "मच्छरदाणी! आज दुप्पट भाव!"}, {"id": 94, "duration_s": 4.51, "emotion": "giggly", "text": "आणि मग... कॉलनीत भुतांची वरात निघाली."}, {"id": 95, "duration_s": 3.01, "emotion": "shouting", "text": "प्रत्येक डासाची चौकशी होणार!"}, {"id": 96, "duration_s": 0.58, "emotion": "angry", "text": "गप्प!"}, {"id": 97, "duration_s": 4.24, "emotion": "serious", "text": "धूर, लिंबू, रॅकेटने नाही. साचलेलं पाणी फेका!"}, {"id": 98, "duration_s": 0.91, "emotion": "excited", "text": "आयडिया सुचली!"}, {"id": 99, "duration_s": 3.01, "emotion": "excited", "text": "स्वच्छता रेस! ज्याला जास्त पाणी सापडेल!"}, {"id": 100, "duration_s": 3.188, "emotion": "determined", "text": "रेस? कुलकर्णी कधी हरले?"}, {"id": 101, "duration_s": 2.26, "emotion": "excited", "text": "कॉलनीची पहिली... स्वच्छता रेस!"}, {"id": 102, "duration_s": 3.982, "emotion": "serious", "text": "नियम ऐका! ज्याला सगळ्यात जास्त..."}, {"id": 103, "duration_s": 1.61, "emotion": "serious", "text": "लार्वा, गुरुजी! लार्वा!"}, {"id": 104, "duration_s": 2.34, "emotion": "shocked", "text": "लव्हर? या कॉलनीत?"}, {"id": 105, "duration_s": 3.49, "emotion": "scared_whisper", "text": "कोणाचे? कुठे? या वयात?"}, {"id": 106, "duration_s": 1.44, "emotion": "sarcastic", "text": "डासाची पिल्लं, गुरुजी!"}, {"id": 107, "duration_s": 2.72, "emotion": "embarrassed", "text": "अच्छा... मग ठीक आहे. सुरू!"}, {"id": 108, "duration_s": 2.3, "emotion": "tired", "text": "पूर्ण बाह्या... पूर्ण घाम!"}, {"id": 109, "duration_s": 2.94, "emotion": "giggly", "text": "पण डास घसरला!"}, {"id": 110, "duration_s": 1.23, "emotion": "determined", "text": "आजी, तुमची वाटीही!"}, {"id": 111, "duration_s": 2.68, "emotion": "embarrassed", "text": "दृष्ट... पाण्याला लागली होती."}, {"id": 112, "duration_s": 4.22, "emotion": "happy", "text": "अरेच्चा, छपरावरही तळं!"}, {"id": 113, "duration_s": 6.29, "emotion": "shouting", "text": "पाऊस? समोसा? चौकशी होणार!"}, {"id": 114, "duration_s": 2.31, "emotion": "mischievous", "text": "धनाजी शेठ, फुकटचे भाडेकरू!"}, {"id": 115, "duration_s": 4.45, "emotion": "sad", "text": "माझ्या दुकानात फुकट कुणीच राहत नाही!"}, {"id": 116, "duration_s": 2.34, "emotion": "proud", "text": "सायन्स सांगतं... हे हलणार नाही."}, {"id": 117, "duration_s": 1.043, "emotion": "calm", "text": "बाजूला."}, {"id": 118, "duration_s": 3.11, "emotion": "embarrassed", "text": "सायन्स सांगतं... पोरांचं ऐका."}, {"id": 119, "duration_s": 2.597, "emotion": "excited", "text": "लाईव्ह सुरू आहे! हॅशटॅग डासमुक्त!"}, {"id": 120, "duration_s": 4.01, "emotion": "proud", "text": "तासाभरात, कॉलनीत थेंबही साचलं पाणी नाही."}, {"id": 121, "duration_s": 2.77, "emotion": "excited", "text": "दहा हजार व्ह्यूज! कॉलनी व्हायरल!"}, {"id": 122, "duration_s": 1.86, "emotion": "excited", "text": "ऐकलंत का? यावेळी चांगली बातमी!"}, {"id": 123, "duration_s": 2.96, "emotion": "proud", "text": "आणि रीलमध्ये सगळ्यात पुढे मी! अख्खी कॉलनी बघेल!"}, {"id": 124, "duration_s": 3.98, "emotion": "proud", "text": "डेंग्यूमुक्त कॉलनी. आणि लव्हरमुक्तही."}, {"id": 125, "duration_s": 2.39, "emotion": "sarcastic", "text": "लार्वा, गुरुजी... लार्वा."}, {"id": 126, "duration_s": 5.8, "emotion": "happy", "text": "कॉलनी डासाला जिंकली... पाण्याशी लढून."}, {"id": 127, "duration_s": 1.13, "emotion": "stern_warning", "text": "डॉक्टर म्हणाले होते. फक्त एक."}, {"id": 128, "duration_s": 3.34, "emotion": "loving", "text": "एकच... मग हळूहळू खाईन."}, {"id": 129, "duration_s": 2.51, "emotion": "tired", "text": "पेढा, वीस मिनिटं झाली!"}, {"id": 130, "duration_s": 3.92, "emotion": "happy", "text": "बरा झालो! आणि आता... भूक लागलीय!"}, {"id": 131, "duration_s": 4.732, "emotion": "proud", "text": "मी म्हटलं होतं ना, मी कुणाला घाबरत नाही."}, {"id": 132, "duration_s": 0.952, "emotion": "mischievous", "text": "भुण्ण..."}, {"id": 133, "duration_s": 1.108, "emotion": "calm", "text": "ऐका, जासूस हो."}, {"id": 134, "duration_s": 3.523, "emotion": "serious", "text": "डासाशी लढायचं... तर पाण्याशी लढा."}, {"id": 135, "duration_s": 5.16, "emotion": "serious", "text": "आठवड्यातून एकदा, सर्व भांडी रिकामी, टाकी झाका."}, {"id": 136, "duration_s": 5.25, "emotion": "loving", "text": "पूर्ण बाह्यांचे कपडे. आणि ताप आला, तर थेट डॉक्टर."}, {"id": 137, "duration_s": 1.07, "emotion": "excited", "text": "केस बंद!"}, {"id": 138, "duration_s": 4.08, "emotion": "mischievous", "text": "कॉलनी सुधारली... पण गणपतच्या टाळ्या?"}, {"id": 139, "duration_s": 1.6, "emotion": "scared_whisper", "text": "एक्केचाळिसावी..."}]