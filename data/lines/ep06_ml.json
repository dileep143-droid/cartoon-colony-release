[{"id": 1, "duration_s": 5.42, "emotion": "calm", "text": "ഇതാണ് നമ്മുടെ കോളനി. ശാന്തം, സുന്ദരം, സുരക്ഷിതം..."}, {"id": 2, "duration_s": 2.86, "emotion": "excited", "text": "ഇതാ... കോളനിയുടെ പുതിയ രാജാവ്!"}, {"id": 3, "duration_s": 3.0, "emotion": "proud", "text": "രാജാവോ? ഈ കോളനിയിലെ രാജാവ് ഞാനാ!"}, {"id": 4, "duration_s": 0.69, "emotion": "sarcastic", "text": "തെറ്റ്."}, {"id": 5, "duration_s": 3.29, "emotion": "proud", "text": "റാണി ഞാനാ! കോളനി മുഴുവൻ കാണട്ടെ!"}, {"id": 6, "duration_s": 1.34, "emotion": "sarcastic", "text": "വീണ്ടും തെറ്റ്."}, {"id": 7, "duration_s": 3.0, "emotion": "proud", "text": "റാണിയൊക്കെ വിട്! ഫോളോവേഴ്സ് എനിക്കാ കൂടുതൽ!"}, {"id": 8, "duration_s": 4.6, "emotion": "mischievous", "text": "മൂന്നും തെറ്റ്. എല്ലാം തുടങ്ങിയത് ഇന്നലെ വൈകിട്ട്..."}, {"id": 9, "duration_s": 1.73, "emotion": "mischievous", "text": "...ഒരു പഴത്തിൽ നിന്ന്."}, {"id": 10, "duration_s": 3.23, "emotion": "calm", "text": "ആ വൈകുന്നേരം കോളനിയിൽ ഒരു കുരങ്ങൻ വന്നു."}, {"id": 11, "duration_s": 3.43, "emotion": "excited", "text": "അയ്യോ! കുരങ്ങൻ! ഭയങ്കര ശുഭമാ!"}, {"id": 12, "duration_s": 3.39, "emotion": "loving", "text": "ഇതാ മോനേ, പഴം തിന്ന്. കണ്ണു പറ്റില്ല."}, {"id": 13, "duration_s": 3.04, "emotion": "excited", "text": "കുരങ്ങൻ! ശരിക്കും കുരങ്ങൻ! നമ്മുടെ കോളനിയിൽ!"}, {"id": 14, "duration_s": 3.667, "emotion": "excited", "text": "എനിക്കൊരു ഐഡിയ! വളർത്താം! പേര്... മംഗളൻ!"}, {"id": 15, "duration_s": 3.46, "emotion": "worried", "text": "വളർത്താനോ? എന്ത് തീറ്റിക്കും? എന്റെ ചിപ്സ് തരില്ല!"}, {"id": 16, "duration_s": 3.25, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? കുരങ്ങൻ കാട്ടുമൃഗമാ, വളർത്തുമൃഗമല്ല."}, {"id": 17, "duration_s": 2.2, "emotion": "stern_warning", "text": "മിണ്ടരുത്! മംഗളൻ ചങ്ങാതിയാ."}, {"id": 18, "duration_s": 1.59, "emotion": "sarcastic", "text": "ശരി. ഞാൻ എഴുതിവെക്കുവാ."}, {"id": 19, "duration_s": 2.98, "emotion": "happy", "text": "ദിവസവും കൊടുക്കാം. ഭാഗ്യക്കുരങ്ങാ!"}, {"id": 20, "duration_s": 2.93, "emotion": "mischievous", "text": "മംഗളൻ തിന്നു... എന്നിട്ട് വീട്ടിലേക്ക് ഫോൺ ചെയ്തു."}, {"id": 21, "duration_s": 1.68, "emotion": "mischievous", "text": "കുടുംബം മുഴുവനെയും."}, {"id": 22, "duration_s": 2.988, "emotion": "calm", "text": "ശുഭം... ശുഭം... ഭയങ്കര ശുഭം..."}, {"id": 23, "duration_s": 4.32, "emotion": "mischievous", "text": "പിറ്റേന്ന് രാവിലെ... ഒരു കുരങ്ങൻ ഇരുപതായി!"}, {"id": 24, "duration_s": 3.78, "emotion": "excited", "text": "ഇത്രേം പേരോ? ആഹാ! എന്തൊരു ഭാഗ്യം!"}, {"id": 25, "duration_s": 2.53, "emotion": "proud", "text": "സയൻസ് പറയുന്നു, കുരങ്ങിന് മനുഷ്യനെ പേടിയാ."}, {"id": 26, "duration_s": 2.4, "emotion": "serious", "text": "ചേട്ടാ, സയൻസ് പറയുന്നു, പേടിക്കണ്ട."}, {"id": 27, "duration_s": 4.17, "emotion": "loving", "text": "ചേട്ടന് നല്ല ഉയരമാ... വിശക്കുന്നുണ്ടോ? ഇത് കഴിക്ക്!"}, {"id": 28, "duration_s": 3.87, "emotion": "happy", "text": "വിശക്കുന്നേ! പറാത്ത, നാലെണ്ണം മുഴുവൻ!"}, {"id": 29, "duration_s": 4.09, "emotion": "shocked", "text": "എന്നെക്കാൾ വേഗത്തിലോ? എന്നെ?! ഇത് അപമാനമാ!"}, {"id": 30, "duration_s": 6.13, "emotion": "stern_warning", "text": "ചവച്ചു തിന്ന്! മുപ്പത്തിരണ്ട് വട്ടം! മര്യാദ എന്നൊരു സാധനം..."}, {"id": 31, "duration_s": 2.77, "emotion": "laughing", "text": "ഹി ഹി ചിരിക്കല്ലേ ഉണ്ണീ... അയ്യോ! എന്റെ സോക്സ്!"}, {"id": 32, "duration_s": 4.36, "emotion": "worried", "text": "ഇന്നലെ ഒന്ന്. ഇന്ന് ഇരുപത്തിയേഴ്. നാളെ എത്രയാകും?"}, {"id": 33, "duration_s": 2.376, "emotion": "happy", "text": "ഇരുപത്തിയേഴ് മടങ്ങ് ശുഭം!"}, {"id": 34, "duration_s": 2.502, "emotion": "excited", "text": "കേട്ടോ? കോളനിയിൽ കുരങ്ങൻമാർ വന്നു!"}, {"id": 35, "duration_s": 2.76, "emotion": "excited", "text": "പ്രകാശിന്റെ കണ്ണട പോയി, ഉണ്ണിയുടെ പൊതി പോയി..."}, {"id": 36, "duration_s": 3.08, "emotion": "proud", "text": "...പക്ഷേ എന്റേത്? എന്റെ ഒന്നും പോകില്ല!"}, {"id": 37, "duration_s": 1.16, "emotion": "shocked", "text": "അയ്യോ! ഫോൺ!"}, {"id": 38, "duration_s": 3.0, "emotion": "laughing", "text": "ചേച്ചീ, അവൻ ചേച്ചിയെക്കാൾ നല്ല ഗോസിപ്പാ!"}, {"id": 39, "duration_s": 2.51, "emotion": "angry", "text": "ചിരിക്കല്ലേ! അതിൽ എന്റെ മുന്നൂറ് ഗ്രൂപ്പുണ്ട്!"}, {"id": 40, "duration_s": 2.02, "emotion": "determined", "text": "വാ, പോകാം! ഫോൺ തിരിച്ചെടുക്കാം!"}, {"id": 41, "duration_s": 4.86, "emotion": "tired", "text": "ശ്ശൊ! ഓരോ അത്യാവശ്യത്തിനും... ഓരോ തവണയും!"}, {"id": 42, "duration_s": 5.5, "emotion": "serious", "text": "ഒന്ന്, രണ്ട്, മൂന്ന്... ഒരു പഴം പോലും കുറയില്ല!"}, {"id": 43, "duration_s": 5.86, "emotion": "shocked", "text": "വീണ്ടും എണ്ണ്... ഒന്ന്... രണ്ട്... അയ്യോ! കാണുന്നില്ല!"}, {"id": 44, "duration_s": 2.12, "emotion": "stern_warning", "text": "കാശുകുട്ടപ്പാ! നമ്മുടെ അരി!"}, {"id": 45, "duration_s": 1.09, "emotion": "stern_warning", "text": "തൊട്ടു നോക്ക്!"}, {"id": 46, "duration_s": 3.488, "emotion": "relieved", "text": "കുരങ്ങനും ഇവളെ പേടിയാ. ഞാനൊറ്റയ്ക്കല്ല!"}, {"id": 47, "duration_s": 3.37, "emotion": "excited", "text": "ഹായ് ഗയ്സ്! ലൈവാ, ലൈവ്! കുരങ്ങൻ സ്പെഷ്യൽ!"}, {"id": 48, "duration_s": 3.2, "emotion": "happy", "text": "നോക്ക്, എന്റെ ഫാൻസ്! ഹായ് മങ്കീസ്!"}, {"id": 49, "duration_s": 3.21, "emotion": "comic_panic", "text": "എന്റെ ലൈവ്! എന്റെ റിംഗ് ലൈറ്റ്! എന്റെ കരിയർ!"}, {"id": 50, "duration_s": 2.33, "emotion": "angry", "text": "കുരങ്ങന്റെ ലൈവിൽ... പത്തു ലക്ഷം പേർ!"}, {"id": 51, "duration_s": 3.83, "emotion": "sarcastic", "text": "ആ രാവിലെ കോളനിയിലെ വലിയ ഇൻഫ്ലുവൻസർ... ഒരു കുരങ്ങൻ."}, {"id": 52, "duration_s": 0.713, "emotion": "embarrassed", "text": "...ഞാനും ഫോളോ ചെയ്തു."}, {"id": 53, "duration_s": 6.2, "emotion": "mischievous", "text": "ഉച്ചയായപ്പോഴേക്കും കോളനിയുടെ അടിയന്തര യോഗം കൂടി."}, {"id": 54, "duration_s": 2.68, "emotion": "stern_warning", "text": "നിശ്ശബ്ദത! ഓരോരുത്തരായി! കൈ പൊക്കണം!"}, {"id": 55, "duration_s": 2.16, "emotion": "sarcastic", "text": "നിങ്ങൾ ഈ കോളനിയിലെ അംഗങ്ങളല്ല!"}, {"id": 56, "duration_s": 2.94, "emotion": "proud", "text": "എനിക്കാരെയും പേടിയില്ല! കുരങ്ങനെ ഞാൻ പിടിക്കും!"}, {"id": 57, "duration_s": 4.827, "emotion": "sarcastic", "text": "പല്ലിയെ പേടിയുള്ളവൻ കുരങ്ങനെ പിടിക്കുമോ?"}, {"id": 58, "duration_s": 1.74, "emotion": "embarrassed", "text": "ഞാൻ... തൂണിന്റെ ബലം നോക്കുവായിരുന്നു."}, {"id": 59, "duration_s": 3.62, "emotion": "serious", "text": "കണ്ണു പറ്റി! എല്ലാ വീട്ടിലും നാരങ്ങയും മുളകും!"}, {"id": 60, "duration_s": 2.88, "emotion": "proud", "text": "എന്റെ ലഡ്ഡു ആരെങ്കിലും തൊട്ടു നോക്കട്ടെ!"}, {"id": 61, "duration_s": 2.59, "emotion": "scared_whisper", "text": "കേട്ടോ, കുരങ്ങൻ മധുരം മണത്തറിയുമെന്ന്..."}, {"id": 62, "duration_s": 2.24, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? കുരങ്ങൻ വരുന്നത് എന്തിനാന്നാൽ..."}, {"id": 63, "duration_s": 2.15, "emotion": "serious", "text": "കുട്ടികൾ വേണ്ട! വലിയവരുടെ യോഗമാ!"}, {"id": 64, "duration_s": 1.81, "emotion": "stern_warning", "text": "മിണ്ടല്ലേ! ചേട്ടൻ പറയട്ടെ..."}, {"id": 65, "duration_s": 2.65, "emotion": "excited", "text": "ടെൻഷനടിക്കണ്ട! എന്റെ കയ്യിൽ പ്ലാനുണ്ട്!"}, {"id": 66, "duration_s": 5.32, "emotion": "sad", "text": "ശ്ശൊ. വല്യവരുടെ യോഗം. കാര്യം... നാളെ."}, {"id": 67, "duration_s": 4.11, "emotion": "proud", "text": "ഇതാണ് സയൻസ്! പഴം അകത്ത്, കുരങ്ങൻ അകത്ത്, ദിം!"}, {"id": 68, "duration_s": 3.24, "emotion": "worried", "text": "അച്ഛാ, കുരങ്ങൻ ദാ മുകളിലെ മരത്തിലാ..."}, {"id": 69, "duration_s": 1.35, "emotion": "determined", "text": "പഴം ഒന്ന് നേരെയിട്ടോട്ടെ..."}, {"id": 70, "duration_s": 3.87, "emotion": "comic_panic", "text": "എനിക്കാരെയും പേടിയില്ല... എന്നെ പുറത്തെടുക്ക്!"}, {"id": 71, "duration_s": 3.88, "emotion": "worried", "text": "അങ്കിളിന് കുഴപ്പമില്ലല്ലോ? പഴത്തിനോ?"}, {"id": 72, "duration_s": 1.59, "emotion": "determined", "text": "മതി! ഇനി ഞാൻ നോക്കാം."}, {"id": 73, "duration_s": 3.67, "emotion": "proud", "text": "ഞാൻ അവനെ മനഃപൂർവം വിട്ടതാ. ദയ തോന്നി."}, {"id": 74, "duration_s": 2.03, "emotion": "proud", "text": "ടെൻഷനടിക്കണ്ട! കരിങ്കുരങ്ങ് എത്തി!"}, {"id": 75, "duration_s": 4.2, "emotion": "curious", "text": "ശിബു മാമാ, കണ്ടാൽ... വലിയ കുരങ്ങനെപ്പോലുണ്ട്."}, {"id": 76, "duration_s": 2.06, "emotion": "proud", "text": "അതാ! കുരങ്ങിന് ലംഗൂറിനെ പേടിയാ!"}, {"id": 77, "duration_s": 2.44, "emotion": "shouting", "text": "ഹൂ ഹൂ ഹാ ഹാ! ഓടിക്കോ!"}, {"id": 78, "duration_s": 2.41, "emotion": "surprised", "text": "ങേ? ഇവർ... കുനിഞ്ഞോ?"}, {"id": 79, "duration_s": 3.93, "emotion": "proud", "text": "ഞാനാ ഇവരുടെ രാജാവ്! ശിബു മഹാരാജാവ്!"}, {"id": 80, "duration_s": 3.9, "emotion": "giggly", "text": "ഹഹ! ഇക്കിളി! എനിക്ക് പേനില്ല!"}, {"id": 81, "duration_s": 2.31, "emotion": "excited", "text": "കേട്ടോ? ശിബു കുരങ്ങൻമാരുടെ തലവനായി!"}, {"id": 82, "duration_s": 2.77, "emotion": "stern_warning", "text": "പുറത്ത്! നിന്റെ മുഴുവൻ പട്ടാളവുമായി!"}, {"id": 83, "duration_s": 2.02, "emotion": "tired", "text": "ശ്ശൊ... ടെൻഷൻ ലേശമുണ്ട്."}, {"id": 84, "duration_s": 2.78, "emotion": "stern_warning", "text": "അന്വേഷണം ഉണ്ടാകും! കോളനി മുഴുവൻ!"}, {"id": 85, "duration_s": 2.69, "emotion": "sarcastic", "text": "അന്വേഷണം തുടങ്ങി. രണ്ടു മിനിറ്റിൽ..."}, {"id": 86, "duration_s": 3.36, "emotion": "excited", "text": "സമൂസ? അന്വേഷണം!"}, {"id": 87, "duration_s": 9.053, "emotion": "shocked", "text": "ജയ് ഹിന്ദ്! അയ്യോ... എന്റെ തൊപ്പി!"}, {"id": 88, "duration_s": 4.24, "emotion": "comic_panic", "text": "ഹെഡ് ഓഫീസ്! കുരങ്ങൻമാർ എന്റെ തൊപ്പി അറസ്റ്റ് ചെയ്തു!"}, {"id": 89, "duration_s": 3.6, "emotion": "tender", "text": "അങ്കിൾ, പകുതി സമൂസ. പകുതി മാത്രം."}, {"id": 90, "duration_s": 3.88, "emotion": "proud", "text": "എന്റെ കടലമാവ് ലഡ്ഡു! നാടു കാണട്ടെ!"}, {"id": 91, "duration_s": 1.3, "emotion": "shocked", "text": "അയ്യോ! ലഡ്ഡു!"}, {"id": 92, "duration_s": 1.87, "emotion": "determined", "text": "ഇന്ന് നീ രക്ഷപ്പെടില്ല."}, {"id": 93, "duration_s": 4.54, "emotion": "excited", "text": "ഇതാ തുടങ്ങി... കോളനി ചരിത്രത്തിലെ ഏറ്റവും വലിയ ഓട്ടം!"}, {"id": 94, "duration_s": 1.39, "emotion": "excited", "text": "അമ്മച്ചീ! അമ്മച്ചീ!"}, {"id": 95, "duration_s": 2.74, "emotion": "excited", "text": "അമ്മച്ചി വേഴ്സസ് കുരങ്ങൻ! ലൈവാ, ലൈവ്!"}, {"id": 96, "duration_s": 1.09, "emotion": "excited", "text": "കലക്കി, അമ്മച്ചീ!"}, {"id": 97, "duration_s": 3.09, "emotion": "shocked", "text": "നാല്പത് ലഡ്ഡു... നാനൂറ് രൂപയുടെ സാധനം!"}, {"id": 98, "duration_s": 2.67, "emotion": "shocked", "text": "അമ്മയുടെ ഉന്നം... തെറ്റിയോ?"}, {"id": 99, "duration_s": 3.42, "emotion": "sad", "text": "ആദ്യമായിട്ട്... ജീവിതത്തിൽ ആദ്യമായിട്ട്!"}, {"id": 100, "duration_s": 3.57, "emotion": "sarcastic", "text": "കോളനി മുഴുവൻ കണ്ടു... അമ്മച്ചിയുടെ ഉന്നം തെറ്റുന്നത്."}, {"id": 101, "duration_s": 3.43, "emotion": "stern_warning", "text": "മിണ്ടരുത്! എല്ലാരും മിണ്ടരുത്! ഇനി ചേട്ടൻ പറയും!"}, {"id": 102, "duration_s": 2.14, "emotion": "determined", "text": "ഞാൻ പറയട്ടെ? ... എന്റെ കൂടെ വാ."}, {"id": 103, "duration_s": 4.17, "emotion": "sarcastic", "text": "കോളനിക്ക് പിന്നിൽ... കുരങ്ങൻമാരുടെ ഫ്രീ ഹോട്ടൽ."}, {"id": 104, "duration_s": 2.02, "emotion": "angry", "text": "ഛീ! ഈ ചപ്പ് ആരുടെയാ?"}, {"id": 105, "duration_s": 1.22, "emotion": "embarrassed", "text": "...ആരുടെയും ആകാം."}, {"id": 106, "duration_s": 3.89, "emotion": "serious", "text": "തുറന്ന ചവറ്, മേലെ ദിവസവും പഴം... ഫ്രീ ഭക്ഷണം!"}, {"id": 107, "duration_s": 3.34, "emotion": "calm", "text": "ഫ്രീ ഭക്ഷണമുള്ളിടത്ത് കുരങ്ങൻ. ലളിതമായ കണക്ക്."}, {"id": 108, "duration_s": 2.61, "emotion": "proud", "text": "സയൻസ് പറയുന്നു, കുരങ്ങൻ നമ്മളെ സ്നേഹിക്കുന്നു!"}, {"id": 109, "duration_s": 3.05, "emotion": "sarcastic", "text": "അവർ ഭക്ഷണത്തെ സ്നേഹിക്കും. ചേട്ടൻ ചവറ്റുകുട്ടയെ."}, {"id": 110, "duration_s": 3.53, "emotion": "serious", "text": "തീറ്റിയാൽ മനുഷ്യനോടുള്ള പേടി പോകും. പിന്നെ പിടിച്ചുപറി."}, {"id": 111, "duration_s": 3.37, "emotion": "serious", "text": "നമ്മുടെ ചിപ്സും മധുരവും കഴിച്ച് കുരങ്ങൻമാർക്ക് അസുഖവും വരും."}, {"id": 112, "duration_s": 3.08, "emotion": "guilty", "text": "ഞാനൊരു പഴമല്ലേ കൊടുത്തുള്ളൂ... ശുഭത്തിന്."}, {"id": 113, "duration_s": 3.139, "emotion": "guilty", "text": "ദിവസം തീറ്റാനുള്ള ഐഡിയ... എന്റേത്."}, {"id": 114, "duration_s": 2.27, "emotion": "guilty", "text": "ഞാൻ ഒരേയൊരു ചിപ്സേ..."}, {"id": 115, "duration_s": 1.71, "emotion": "determined", "text": "മതി! ഇനി ഞാൻ നോക്കാം."}, {"id": 116, "duration_s": 1.47, "emotion": "shouting", "text": "കുട്ടപ്പാ, ചൂല്!"}, {"id": 117, "duration_s": 4.28, "emotion": "tired", "text": "ഒരു ചൂല്, രണ്ട് ചൂല്... ഫ്രീയായി പണി!"}, {"id": 118, "duration_s": 2.66, "emotion": "mischievous", "text": "ഇനി പഴം ഞാൻ മാത്രം തിന്നും."}, {"id": 119, "duration_s": 4.59, "emotion": "calm", "text": "ഹലോ, വനംവകുപ്പോ? കോളനിയിൽ കുരങ്ങന്മാർ! വരൂ!"}, {"id": 120, "duration_s": 3.28, "emotion": "calm", "text": "പേടിക്കണ്ട കൊച്ചേ. ടീം സുരക്ഷിതമായിട്ട് കൊണ്ടുപൊക്കോളും."}, {"id": 121, "duration_s": 4.55, "emotion": "calm", "text": "തല്ലരുത്, പേടിപ്പിക്കരുത്, തീറ്റരുത്. ഇച്ചിരി സ്നേഹം മാത്രം മതി."}, {"id": 122, "duration_s": 3.61, "emotion": "surprised", "text": "ഇന്ന് ആദ്യമായി... രാജന്റെ ഓട്ടോ നിന്നില്ല."}, {"id": 123, "duration_s": 1.79, "emotion": "happy", "text": "ദാ, എത്തി! ഇനി നീ ഉറങ്ങിക്കോ."}, {"id": 124, "duration_s": 2.38, "emotion": "proud", "text": "ടെൻഷനടിക്കണ്ട! ഇവർ എന്റെ വാക്ക് കേൾക്കും!"}, {"id": 125, "duration_s": 2.56, "emotion": "happy", "text": "കേട്ടോ? ഹ ഹ കുരങ്ങൻ ഫോൺ തിരിച്ചു തന്നു!"}, {"id": 126, "duration_s": 5.422, "emotion": "proud", "text": "അന്വേഷണം... കഴിഞ്ഞു!"}, {"id": 127, "duration_s": 1.35, "emotion": "embarrassed", "text": "ഓഹോ... വിളക്കുകാലാ? സോറി."}, {"id": 128, "duration_s": 2.62, "emotion": "excited", "text": "കൊളാബ്! അഞ്ജു ആൻഡ് മങ്കി!"}, {"id": 129, "duration_s": 2.09, "emotion": "stern_warning", "text": "അടുത്ത തവണ... ഉന്നം തെറ്റില്ല."}, {"id": 130, "duration_s": 1.68, "emotion": "tender", "text": "വാല് വെച്ചോ... ഓർമ്മയ്ക്ക്."}, {"id": 131, "duration_s": 3.42, "emotion": "tender", "text": "കുരങ്ങൻമാർ സ്വന്തം വീട്ടിലേക്ക് പോയി... കാട്ടിലേക്ക്."}, {"id": 132, "duration_s": 3.9, "emotion": "curious", "text": "പക്ഷേ അപ്പൂപ്പാ, കുരങ്ങന് പഴം കൊടുക്കുന്നത് ശുഭമല്ലേ?"}, {"id": 133, "duration_s": 2.61, "emotion": "calm", "text": "മൃഗത്തിന് തീറ്റ കൊടുക്കുന്നത് സ്നേഹമല്ല..."}, {"id": 134, "duration_s": 3.29, "emotion": "tender", "text": "...കാട് കാടായിത്തന്നെ ഇരിക്കട്ടെ."}, {"id": 135, "duration_s": 3.93, "emotion": "serious", "text": "ചവറ് മൂടിവെക്കണം. കുരങ്ങനെ കണ്ടാൽ വനംവകുപ്പിനെ വിളിക്കണം."}, {"id": 136, "duration_s": 2.84, "emotion": "stern_warning", "text": "പിന്നെ കളിയാക്കരുത്! കേട്ടോ? മിണ്ടരുത്!"}, {"id": 137, "duration_s": 2.438, "emotion": "giggly", "text": "ഈ ശുഭപ്പഴം... എനിക്ക്!"}, {"id": 138, "duration_s": 3.37, "emotion": "determined", "text": "ഇനി പരിശീലനം! ഉന്നം തിരിച്ചു പിടിക്കണം!"}, {"id": 139, "duration_s": 1.7, "emotion": "tired", "text": "അമ്മേ!"}, {"id": 140, "duration_s": 2.02, "emotion": "proud", "text": "ഉന്നം തിരിച്ചെത്തി!"}]