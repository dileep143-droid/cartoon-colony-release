[{"id": 1, "duration_s": 3.88, "emotion": "mischievous", "text": "দেওৱালীৰ ৰাতি। গোটেই পাৰাটো জিলিকি আছে..."}, {"id": 2, "duration_s": 2.49, "emotion": "sarcastic", "text": "...আৰু গোটেই পাৰা এটাই শাৰীত থিয়।"}, {"id": 3, "duration_s": 2.24, "emotion": "comic_panic", "text": "শুনিছেনে? মোৰ পেটত বোমা ফুটিছে!"}, {"id": 4, "duration_s": 2.56, "emotion": "worried", "text": "নজৰ লাগিল! বাথৰুমত নজৰ লাগিল!"}, {"id": 5, "duration_s": 3.76, "emotion": "determined", "text": "পেট বিষাইছে... কিন্তু ভোকো লাগিছে!"}, {"id": 6, "duration_s": 1.75, "emotion": "comic_panic", "text": "ভিতৰত কোন? বেগাই!"}, {"id": 7, "duration_s": 1.02, "emotion": "calm", "text": "টেনচন নলবা!"}, {"id": 8, "duration_s": 2.34, "emotion": "calm", "text": "এইবোৰ আৰম্ভ হৈছিল... তিনিদিন আগতে।"}, {"id": 9, "duration_s": 3.63, "emotion": "mischievous", "text": "বৰ বেছি জিলিকা এটা মিঠাইৰ পৰা।"}, {"id": 10, "duration_s": 3.53, "emotion": "happy", "text": "দেওৱালীৰ সপ্তাহ। গোটেই পাৰা সাজি-কাচি আছে।"}, {"id": 11, "duration_s": 4.89, "emotion": "proud", "text": "মেগা ছেল! কাজু বৰফী আধা দামত!"}, {"id": 12, "duration_s": 2.76, "emotion": "excited", "text": "জিলিকা মিঠাই! ভোক লাগিছে!"}, {"id": 13, "duration_s": 5.64, "emotion": "mischievous", "text": "ধনৰাম দা, দুশ বাক্স, আধা দামত, হসা ৰূপৰ!"}, {"id": 14, "duration_s": 5.68, "emotion": "excited", "text": "সস্তীয়া মাল, মোটা লাভ!"}, {"id": 15, "duration_s": 1.89, "emotion": "stern_warning", "text": "ধনৰাম! আধা দামত আচল ৰূপ?"}, {"id": 16, "duration_s": 3.04, "emotion": "proud", "text": "মনি, এইটো দেওৱালীৰ বৰকত!"}, {"id": 17, "duration_s": 1.12, "emotion": "excited", "text": "এটা বুদ্ধি আছে!"}, {"id": 18, "duration_s": 4.08, "emotion": "excited", "text": "আইতা! মৃদুলাতকৈ ডাঙৰ থাল... আধা দামত!"}, {"id": 19, "duration_s": 4.17, "emotion": "mischievous", "text": "এইবাৰ মোৰ থাল... গোটেই পাৰাই চাব!"}, {"id": 20, "duration_s": 4.54, "emotion": "serious", "text": "আইতা, আধা দামত কাজু বৰফী? কিবা গণ্ডগোল আছে।"}, {"id": 21, "duration_s": 3.15, "emotion": "proud", "text": "গণ্ডগোল নহয়, সঞ্চয়!"}, {"id": 22, "duration_s": 3.52, "emotion": "mischievous", "text": "আৰু আৰম্ভ হ'ল... থালৰ যুদ্ধ!"}, {"id": 23, "duration_s": 3.38, "emotion": "proud", "text": "পাঁচটা বাকচ! আটাইতকৈ ডাঙৰ!"}, {"id": 24, "duration_s": 1.57, "emotion": "proud", "text": "এটকাও কম নহয়!"}, {"id": 25, "duration_s": 3.0, "emotion": "shocked", "text": "শুনিছা? জোনাকীয়ে পাঁচ বাকচ ল'লে!"}, {"id": 26, "duration_s": 2.68, "emotion": "proud", "text": "ছটা বাকচ, ধনৰাম! ছটা!"}, {"id": 27, "duration_s": 1.08, "emotion": "determined", "text": "সাত!"}, {"id": 28, "duration_s": 3.07, "emotion": "excited", "text": "টেনচন নলবা! ধনুৰ প্ৰিমিয়াম হেম্পাৰ!"}, {"id": 29, "duration_s": 2.72, "emotion": "mischievous", "text": "দুগুণ দাম, বাইদেউ... দুগুণ মান!"}, {"id": 30, "duration_s": 2.7, "emotion": "worried", "text": "ইমান মিঠাই! নজৰ লাগিব!"}, {"id": 31, "duration_s": 1.81, "emotion": "proud", "text": "গোটেই পাৰাই চাব!"}, {"id": 32, "duration_s": 2.67, "emotion": "proud", "text": "মই কাকো নাডৰো! মৃদুলা বাইদেউকো নাডৰো!"}, {"id": 33, "duration_s": 2.68, "emotion": "curious", "text": "আধা দামত ৰূপ? সন্দেহ লাগিছে।"}, {"id": 34, "duration_s": 1.72, "emotion": "sarcastic", "text": "ডাঙৰক কোনে বুজাব?"}, {"id": 35, "duration_s": 3.57, "emotion": "giggly", "text": "স্ক'ৰ? বাৰ-বাৰ বাকচ। যুদ্ধ সমান!"}, {"id": 36, "duration_s": 3.48, "emotion": "stern_warning", "text": "পিঠা, তই চকীদাৰ। এটুকুৰাও নহয়!"}, {"id": 37, "duration_s": 1.77, "emotion": "determined", "text": "এটুকুৰাও নহয়!"}, {"id": 38, "duration_s": 1.704, "emotion": "proud", "text": "মোৰ ৰংগোলী ডাঙৰ।"}, {"id": 39, "duration_s": 1.66, "emotion": "sarcastic", "text": "মোৰ ৰংগোলীত ৰং বেছি।"}, {"id": 40, "duration_s": 4.56, "emotion": "serious", "text": "তদন্ত হ'ব! মিঠাইৰ সুৰক্ষাৰ!"}, {"id": 41, "duration_s": 0.75, "emotion": "excited", "text": "মিঠাই?"}, {"id": 42, "duration_s": 1.49, "emotion": "happy", "text": "তদন্ত শেষ।"}, {"id": 43, "duration_s": 2.55, "emotion": "shocked", "text": "পিঠা! থালবোৰ ক'লৈ গ'ল?"}, {"id": 44, "duration_s": 2.97, "emotion": "guilty", "text": "সেইটো... নজৰ লাগিল!"}, {"id": 45, "duration_s": 2.0, "emotion": "excited", "text": "দেখিলা! মই কৈছিলোঁ!"}, {"id": 46, "duration_s": 2.19, "emotion": "excited", "text": "হেম্পাৰ লওক! গোটেই পাৰাৰ বাবে!"}, {"id": 47, "duration_s": 3.88, "emotion": "serious", "text": "এতিয়া ধনৰামৰ মিঠাই... ঘৰে ঘৰে পাইছিল।"}, {"id": 48, "duration_s": 1.65, "emotion": "excited", "text": "হাই গাইজ! লাইভ চলি আছে!"}, {"id": 49, "duration_s": 2.73, "emotion": "sarcastic", "text": "ইমান সেউজীয়া তো... পাতো নহয়।"}, {"id": 50, "duration_s": 3.52, "emotion": "excited", "text": "মিঠাই মুকবেং! আজিৰ বৰফী... নিয়ন গ্ৰীণ!"}, {"id": 51, "duration_s": 4.32, "emotion": "proud", "text": "বিজ্ঞানে কয়... যিমান ৰং, সিমান ভিটামিন!"}, {"id": 52, "duration_s": 1.88, "emotion": "happy", "text": "শুনিছা গাইজ? হেল্দী!"}, {"id": 53, "duration_s": 4.15, "emotion": "serious", "text": "সেউজীয়া জিভা? বিজ্ঞানে কয়... এয়া সেউজীয়া!"}, {"id": 54, "duration_s": 3.22, "emotion": "shocked", "text": "গাইজ, জিভা নীলা হ'ল! নতুন ফিল্টাৰ?"}, {"id": 55, "duration_s": 2.64, "emotion": "embarrassed", "text": "বিজ্ঞানে কয়... এইটো বিষ।"}, {"id": 56, "duration_s": 3.44, "emotion": "proud", "text": "দুলাখ ভিউ! সকলোৱে নীলা বৰফী খাওক!"}, {"id": 57, "duration_s": 3.54, "emotion": "happy", "text": "দেৱালীৰ সন্ধিয়া। জোনাকী আইতাৰ মিঠাই পাৰ্টী!"}, {"id": 58, "duration_s": 3.44, "emotion": "proud", "text": "আহক, আহক! গোটেই পাৰাই চাব... আৰু খাব!"}, {"id": 59, "duration_s": 2.55, "emotion": "sarcastic", "text": "জোনাকী, তোমাৰ কাজু বৰফী ইমান জিলিকে কিয়?"}, {"id": 60, "duration_s": 2.71, "emotion": "proud", "text": "আচল ৰূপ! আধা দামৰ!"}, {"id": 61, "duration_s": 0.84, "emotion": "proud", "text": "মোৰটোও!"}, {"id": 62, "duration_s": 2.73, "emotion": "curious", "text": "চাৰ, এই মিঠাই খাটি নে?"}, {"id": 63, "duration_s": 3.62, "emotion": "happy", "text": "মইনা সেউজীয়া? হয়, বৰ ধুনীয়া!"}, {"id": 64, "duration_s": 2.46, "emotion": "shocked", "text": "মইনা নহয় চাৰ... মিঠাই!"}, {"id": 65, "duration_s": 3.26, "emotion": "excited", "text": "মইনা সেউজ, বৰফী সেউজ! বাহ!"}, {"id": 66, "duration_s": 3.1, "emotion": "proud", "text": "বিজ্ঞানে কয়... জিলিকা মানে টাটকা!"}, {"id": 67, "duration_s": 2.01, "emotion": "proud", "text": "মই কোনো মিঠাইকো নাডৰো!"}, {"id": 68, "duration_s": 2.88, "emotion": "happy", "text": "ডাৱৰ গাজিছে? দেওৱালীত বৰষুণ!"}, {"id": 69, "duration_s": 2.07, "emotion": "comic_panic", "text": "শুনিছেনে? মোৰ পেটেও কিবা কৈছে!"}, {"id": 70, "duration_s": 3.94, "emotion": "giggly", "text": "আৰু... গোটেই পাৰাৰ পেট একেলগে কথা কলে।"}, {"id": 71, "duration_s": 3.43, "emotion": "sarcastic", "text": "চৈধ্যজন মানুহ। এটা বাথৰুম।"}, {"id": 72, "duration_s": 2.51, "emotion": "comic_panic", "text": "মই কাকো নাডৰো... কিন্তু বেগাই!"}, {"id": 73, "duration_s": 1.93, "emotion": "stern_warning", "text": "ধনৰাম! শাৰীত!"}, {"id": 74, "duration_s": 2.51, "emotion": "pleading", "text": "আগলৈ যাবলৈ... দুটকা দিওঁ?"}, {"id": 75, "duration_s": 3.94, "emotion": "sarcastic", "text": "মৃদুলা, তোৰ পেটে... মোতকৈ বেছি কথা কয়!"}, {"id": 76, "duration_s": 2.5, "emotion": "comic_panic", "text": "লাইভ চলি আছে... বাথৰুমৰ শাৰীৰ পৰা!"}, {"id": 77, "duration_s": 2.41, "emotion": "determined", "text": "যথেষ্ট! এতিয়া মই চাওঁ।"}, {"id": 78, "duration_s": 2.11, "emotion": "serious", "text": "এক লিটাৰ উতলা-ঠাণ্ডা পানী, ছটা চামুচ চেনি..."}, {"id": 79, "duration_s": 5.08, "emotion": "serious", "text": "...আধা চামুচ নিমখ। অলপ অলপকৈ খোৱা।"}, {"id": 80, "duration_s": 3.24, "emotion": "worried", "text": "দুটা নেমু কমিল... এইটো তৃতীয়!"}, {"id": 81, "duration_s": 2.08, "emotion": "calm", "text": "মাত্ৰ দুমিনিট... টেনচন নলবা!"}, {"id": 82, "duration_s": 3.61, "emotion": "crying", "text": "ধনু, তোৰ দুমিনিট... দেওৱালীতকৈ দীঘল!"}, {"id": 83, "duration_s": 2.9, "emotion": "guilty", "text": "শেষৰটো... নিশ্চয়।"}, {"id": 84, "duration_s": 2.14, "emotion": "determined", "text": "দৰৱৰ দোকান! বলা, যাওঁ!"}, {"id": 85, "duration_s": 4.09, "emotion": "tired", "text": "জাঁচ হ'ব... খোজকাঢ়ি।"}, {"id": 86, "duration_s": 3.66, "emotion": "curious", "text": "সকলোৰে পেট বেয়া... আমি তিনিও ভাল কিয়?"}, {"id": 87, "duration_s": 3.32, "emotion": "proud", "text": "কিয়নো আমি ৰূপা মাহীৰ ঘৰৰ লাড়ু খালোঁ!"}, {"id": 88, "duration_s": 5.04, "emotion": "determined", "text": "আৰু এইটো প্ৰমাণ। কাইলৈ পুৱা... বিজ্ঞান পৰীক্ষা!"}, {"id": 89, "duration_s": 4.16, "emotion": "sarcastic", "text": "সেইৰাতি বাজি কম ফুটিল... পেট বেছি।"}, {"id": 90, "duration_s": 2.67, "emotion": "curious", "text": "পিছদিনা পুৱা। ৰিংকুৰ লেব।"}, {"id": 91, "duration_s": 2.3, "emotion": "proud", "text": "বিজ্ঞানে কয়... জিলিকা মানে টাটকা!"}, {"id": 92, "duration_s": 1.62, "emotion": "angry", "text": "মোৰ মিঠাই আচল আছিল!"}, {"id": 93, "duration_s": 1.21, "emotion": "angry", "text": "মোৰটো বেছি আচল!"}, {"id": 94, "duration_s": 2.06, "emotion": "shouting", "text": "মনে মনে! ৰিংকুৱে কৈ আছে!"}, {"id": 95, "duration_s": 2.13, "emotion": "proud", "text": "মই কওঁ? স্কুলৰ পৰীক্ষা।"}, {"id": 96, "duration_s": 2.67, "emotion": "stern_warning", "text": "আইঅ'ডিন ঘাঁৰ দৰৱ। খোৱাৰ নহয়!"}, {"id": 97, "duration_s": 4.28, "emotion": "serious", "text": "নীলা-ক'লা মানে ষ্টাৰ্চ। মৈদা বা অৰাৰুট মিহলাইছে!"}, {"id": 98, "duration_s": 4.27, "emotion": "serious", "text": "আচল মিঠাইত ষ্টাৰ্চ নাথাকে... ৰং বাদামীয়েই থাকে।"}, {"id": 99, "duration_s": 3.05, "emotion": "serious", "text": "আচল ৰূপৰ বৰ্ক... ঘহিলেই গুড়ি হয়।"}, {"id": 100, "duration_s": 4.52, "emotion": "stern_warning", "text": "এইটো লাগি থাকিল, জিলিকি থাকিল... নকল পন্নী!"}, {"id": 101, "duration_s": 1.45, "emotion": "proud", "text": "বিজ্ঞানে কয়..."}, {"id": 102, "duration_s": 0.73, "emotion": "stern_warning", "text": "চুপ!"}, {"id": 103, "duration_s": 4.19, "emotion": "serious", "text": "আৰু ইমান চটকা ৰং? বিপদৰ ঘণ্টা।"}, {"id": 104, "duration_s": 2.64, "emotion": "stern_warning", "text": "পৰীক্ষাৰ মিঠাই... খোৱা মানা!"}, {"id": 105, "duration_s": 4.226, "emotion": "proud", "text": "বাহ ৰিংকু! পৰীক্ষাৰ টুকুৰাবোৰ ডাষ্টবিনত।"}, {"id": 106, "duration_s": 3.01, "emotion": "embarrassed", "text": "আৰু মই... মইনা ভাবি খাই থাকিলোঁ।"}, {"id": 107, "duration_s": 3.23, "emotion": "serious", "text": "চিনাকি দোকান, বাকচত তাৰিখ আৰু লাইচেন্স।"}, {"id": 108, "duration_s": 3.77, "emotion": "guilty", "text": "মই... মাত্ৰ মৃদুলাতকৈ ডাঙৰ থাল চাই আছিলোঁ।"}, {"id": 109, "duration_s": 2.1, "emotion": "determined", "text": "বলা! ধনৰামৰ দোকান!"}, {"id": 110, "duration_s": 2.91, "emotion": "mischievous", "text": "গোটেই পাৰা গ'ল... ধনৰামৰ দোকান!"}, {"id": 111, "duration_s": 4.06, "emotion": "comic_panic", "text": "হেল্লো! তোমাৰ আচল ৰূপ... নকল ওলাল!"}, {"id": 112, "duration_s": 2.3, "emotion": "mischievous", "text": "কুন ধনৰাম? ভুল নম্বৰ!"}, {"id": 113, "duration_s": 4.18, "emotion": "sad", "text": "মোকো ঠগিলে... সস্তাৰ লোভত।"}, {"id": 114, "duration_s": 4.5, "emotion": "stern_warning", "text": "ধনৰাম! প্ৰতিটো বাকচ ঘূৰাই। প্ৰতিটো টকা ঘূৰাই।"}, {"id": 115, "duration_s": 2.01, "emotion": "pleading", "text": "মনি... অলপ কম?"}, {"id": 116, "duration_s": 1.52, "emotion": "angry", "text": "এটকাও কম নহয়!"}, {"id": 117, "duration_s": 2.67, "emotion": "crying", "text": "বিদায়... মোৰ মৰমৰ টকা।"}, {"id": 118, "duration_s": 1.89, "emotion": "mischievous", "text": "টেনচন নলবা... মই গ'লোঁ।"}, {"id": 119, "duration_s": 2.71, "emotion": "sarcastic", "text": "দুগুণ দাম লৈছিলা... দুগুণ ঘূৰাই দিয়া।"}, {"id": 120, "duration_s": 2.39, "emotion": "sad", "text": "মেগা ছেল... মেগা ফেইল।"}, {"id": 121, "duration_s": 2.23, "emotion": "happy", "text": "এইবাৰ মিঠাই... ঘৰতে হ'ব!"}, {"id": 122, "duration_s": 3.69, "emotion": "happy", "text": "বেচন, ঘিউ, চেনি... ব্যস! আৰু একো নাই।"}, {"id": 123, "duration_s": 2.92, "emotion": "loving", "text": "জোনাকী, মোৰ নাৰিকল বৰফী... ঘৰুৱা।"}, {"id": 124, "duration_s": 2.59, "emotion": "happy", "text": "এইবাৰ থাল এখন... আৰু দুয়োৰে!"}, {"id": 125, "duration_s": 2.76, "emotion": "giggly", "text": "শুনিছেনে? আমাৰ বন্ধুত্ব হ'ল!"}, {"id": 126, "duration_s": 2.75, "emotion": "excited", "text": "এটা বুদ্ধি আছে! আটাইতকৈ ডাঙৰ লাড়ু!"}, {"id": 127, "duration_s": 2.34, "emotion": "sarcastic", "text": "চুপ! গোল বনা।"}, {"id": 128, "duration_s": 3.07, "emotion": "giggly", "text": "পিঠা, আজিৰ পৰা তুমি... টেষ্টাৰ!"}, {"id": 129, "duration_s": 2.47, "emotion": "excited", "text": "এই চাকৰি... মোৰ বাবেই বনোৱা!"}, {"id": 130, "duration_s": 2.05, "emotion": "proud", "text": "কোৱালিটী চেক... চলি আছে।"}, {"id": 131, "duration_s": 5.54, "emotion": "happy", "text": "আৰু আহিল... আচল, চাফ, মিঠা দেওৱালী!"}, {"id": 132, "duration_s": 4.02, "emotion": "proud", "text": "গোটেই পাৰাই চাব... এখনেই থাল!"}, {"id": 133, "duration_s": 1.98, "emotion": "embarrassed", "text": "এইবাৰ... ফ্ৰী!"}, {"id": 134, "duration_s": 5.31, "emotion": "worried", "text": "ধনৰাম, ফ্ৰী? বলা, যাওঁ... ডাক্তৰৰ ওচৰলৈ!"}, {"id": 135, "duration_s": 3.95, "emotion": "proud", "text": "বিজ্ঞানে কয়... ঘৰত বনোৱা, আটাইতকৈ ভাল!"}, {"id": 136, "duration_s": 3.98, "emotion": "proud", "text": "এইবাৰ ঠিকেই শুনিলোঁ... মিঠাই খাটি!"}, {"id": 137, "duration_s": 1.48, "emotion": "curious", "text": "ককা! আজিৰ শিক্ষা?"}, {"id": 138, "duration_s": 3.26, "emotion": "calm", "text": "সস্তা দেখি নহয়... চাফ দেখি কিনা।"}, {"id": 139, "duration_s": 1.67, "emotion": "happy", "text": "শুভ দেওৱালী!"}]