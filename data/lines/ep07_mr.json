[{"id": 1, "duration_s": 4.72, "emotion": "mischievous", "text": "दिवाळीची रात्र. अख्खी सोसायटी एकच गोष्ट बघतेय..."}, {"id": 2, "duration_s": 3.918, "emotion": "excited", "text": "सोन्याचा... सुपर बॉम्ब!"}, {"id": 3, "duration_s": 2.51, "emotion": "proud", "text": "टेन्शन नको! चंद्रापेक्षा जास्त आवाज!"}, {"id": 4, "duration_s": 2.02, "emotion": "excited", "text": "लाइव्ह सुरू आहे! दिवाळी स्पेशल!"}, {"id": 5, "duration_s": 2.581, "emotion": "stern_warning", "text": "गप्प! सगळे रेषेमागे!"}, {"id": 6, "duration_s": 1.75, "emotion": "scared_whisper", "text": "झालं... का?"}, {"id": 7, "duration_s": 3.33, "emotion": "mischievous", "text": "थांबा थांबा! हे सुरू झालं... आज सकाळी."}, {"id": 8, "duration_s": 3.11, "emotion": "happy", "text": "दिवाळीची सकाळ. सोसायटी चमकत होती..."}, {"id": 9, "duration_s": 5.32, "emotion": "sarcastic", "text": "...आणि सोन्या घोरत होता."}, {"id": 10, "duration_s": 3.59, "emotion": "excited", "text": "सुपर बॉम्ब! चंद्रापेक्षा बी जास्त आवाज शे! फक्त आज!"}, {"id": 11, "duration_s": 0.93, "emotion": "excited", "text": "चंद्रापेक्षा जास्त?!"}, {"id": 12, "duration_s": 2.32, "emotion": "curious", "text": "भाऊ... चंद्राचा आवाज किती असतो?"}, {"id": 13, "duration_s": 1.177, "emotion": "serious", "text": "...यापेक्षा कमी!"}, {"id": 14, "duration_s": 2.28, "emotion": "loving", "text": "माझा सुपर बॉम्ब... माझं बाळ."}, {"id": 15, "duration_s": 2.14, "emotion": "serious", "text": "मी सांगू? त्या डब्यावर नावच नाही!"}, {"id": 16, "duration_s": 3.29, "emotion": "serious", "text": "कंपनी नाही, पत्ता नाही! आणि गाडीवाला पळाला!"}, {"id": 17, "duration_s": 1.84, "emotion": "proud", "text": "टेन्शन नको! सोन्या आहे ना!"}, {"id": 18, "duration_s": 1.55, "emotion": "happy", "text": "चला, निघूया!"}, {"id": 19, "duration_s": 1.97, "emotion": "comic_panic", "text": "वाचला! माझा बॉम्ब वाचला!"}, {"id": 20, "duration_s": 3.8, "emotion": "embarrassed", "text": "अरे सोन्या, ती माझ्या रिक्षाची शिंक होती!"}, {"id": 21, "duration_s": 0.89, "emotion": "excited", "text": "आयडिया सुचली!"}, {"id": 22, "duration_s": 4.18, "emotion": "determined", "text": "आज रात्री... मुलांचं सेफ्टी पथक!"}, {"id": 23, "duration_s": 1.17, "emotion": "excited", "text": "ऐकलं? सोन्या बॉम्ब आणला!"}, {"id": 24, "duration_s": 3.32, "emotion": "sarcastic", "text": "आणि दहा सेकंदात... अख्ख्या सोसायटीला कळलं."}, {"id": 25, "duration_s": 3.99, "emotion": "excited", "text": "बघा! सुपर बॉम्ब! चंद्रापेक्षा मोठा आवाज!"}, {"id": 26, "duration_s": 2.39, "emotion": "proud", "text": "कमल काकूंचे फटाके फुस्स! सगळी सोसायटी बघेल!"}, {"id": 27, "duration_s": 3.1, "emotion": "angry", "text": "सोन्या!"}, {"id": 28, "duration_s": 3.11, "emotion": "embarrassed", "text": "आई गं! हा नेम कधी चुकत नाही..."}, {"id": 29, "duration_s": 3.8, "emotion": "stern_warning", "text": "दिव्याशेजारी दारू? अक्कल गवत चरायला गेली का?"}, {"id": 30, "duration_s": 1.92, "emotion": "calm", "text": "बास! आता मी बघते."}, {"id": 31, "duration_s": 2.98, "emotion": "stern_warning", "text": "फटाके आगीपासून दूर, थंड जागी."}, {"id": 32, "duration_s": 3.28, "emotion": "proud", "text": "आज पहिली फुलझडी मी लावणार! मी कुणाला भीत नाही!"}, {"id": 33, "duration_s": 4.05, "emotion": "sarcastic", "text": "मागच्या दिवाळीत भुईनळा बघून कपाटात कोण लपलं होतं?"}, {"id": 34, "duration_s": 2.61, "emotion": "embarrassed", "text": "ते... कपाट साफ करत होतो. आतून."}, {"id": 35, "duration_s": 2.88, "emotion": "proud", "text": "चप्पल परत. नेम तयार."}, {"id": 36, "duration_s": 6.29, "emotion": "shouting", "text": "सायलेंट फटाके! ना धूर, ना आवाज, ना भीती!"}, {"id": 37, "duration_s": 2.97, "emotion": "proud", "text": "शंभर रुपये डबा! एक रुपयाही कमी नाही!"}, {"id": 38, "duration_s": 3.81, "emotion": "curious", "text": "शेठजी, सायलेंट फटाका पेटतो कसा?"}, {"id": 39, "duration_s": 4.351, "emotion": "mischievous", "text": "इतका गुपचूप... की कळतही नाही!"}, {"id": 40, "duration_s": 2.78, "emotion": "proud", "text": "विज्ञान सांगतं... आवाज थेट मेंदूत येतो!"}, {"id": 41, "duration_s": 1.6, "emotion": "excited", "text": "हो... ऐकू येतंय!"}, {"id": 42, "duration_s": 2.34, "emotion": "sad", "text": "यात तर खायलाही काही नाही!"}, {"id": 43, "duration_s": 1.34, "emotion": "happy", "text": "भूक लागलीय!"}, {"id": 44, "duration_s": 2.97, "emotion": "shocked", "text": "ऐकलंत का? शेठ रिकामे डबे विकतोय!"}, {"id": 45, "duration_s": 0.88, "emotion": "stern_warning", "text": "धनाजी!"}, {"id": 46, "duration_s": 5.888, "emotion": "embarrassed", "text": "शालू... हे प्रदूषणमुक्त पॅकिंग आहे!"}, {"id": 47, "duration_s": 4.67, "emotion": "sad", "text": "<sigh> सायलेंट फटाके... सायलेंट गिऱ्हाईक."}, {"id": 48, "duration_s": 3.76, "emotion": "serious", "text": "फटाक्यांनाही दृष्ट लागते, बाळा!"}, {"id": 49, "duration_s": 0.97, "emotion": "worried", "text": "आजी, लिंबू फुटलं तर?"}, {"id": 50, "duration_s": 1.28, "emotion": "serious", "text": "तर आंबट धमाका!"}, {"id": 51, "duration_s": 2.31, "emotion": "sarcastic", "text": "हवालदार झोपाजी पहारा देत होते..."}, {"id": 52, "duration_s": 1.68, "emotion": "happy", "text": "भोंग्यालाही दृष्ट लागली!"}, {"id": 53, "duration_s": 2.53, "emotion": "pleading", "text": "एकच... फक्त चौकशीसाठी."}, {"id": 54, "duration_s": 2.35, "emotion": "stern_warning", "text": "चौकशी!"}, {"id": 55, "duration_s": 1.96, "emotion": "sad", "text": "<sigh> चौकशीनेच मिठाई खाल्ली."}, {"id": 56, "duration_s": 5.117, "emotion": "proud", "text": "मी कुणाला भीत नाही! फक्त आग, ठिणगी, आवाजाला."}, {"id": 57, "duration_s": 2.1, "emotion": "loving", "text": "मग एक लिंबू तुझ्यासाठीही."}, {"id": 58, "duration_s": 3.32, "emotion": "excited", "text": "संध्याकाळी... मुलांनी सूत्रं हाती घेतली."}, {"id": 59, "duration_s": 2.44, "emotion": "determined", "text": "ही सेफ्टी रेषा! याच्या पुढे कोणी नाही!"}, {"id": 60, "duration_s": 5.41, "emotion": "serious", "text": "मी सांगू? पाण्याची बादली, वाळूची बादली, आणि अंतर!"}, {"id": 61, "duration_s": 2.16, "emotion": "excited", "text": "पाणीपुरी? कुठे आहे पाणीपुरी?"}, {"id": 62, "duration_s": 2.26, "emotion": "excited", "text": "पाणीपुरी?! कुठे?!"}, {"id": 63, "duration_s": 2.34, "emotion": "sarcastic", "text": "पाण्याची बादली, गुरुजी! आणि वाळू!"}, {"id": 64, "duration_s": 2.72, "emotion": "curious", "text": "वाळू? पाणीपुरीत वाळू घालतात?"}, {"id": 65, "duration_s": 1.93, "emotion": "embarrassed", "text": "प्रत्येक महत्त्वाच्या वेळी हिची सुट्टी!"}, {"id": 66, "duration_s": 3.01, "emotion": "shouting", "text": "सगळे मोठे इकडे! नियम ऐका!"}, {"id": 67, "duration_s": 3.83, "emotion": "stern_warning", "text": "हातात फक्त फुलझडी! बाकी फटाका कधीच नाही!"}, {"id": 68, "duration_s": 2.98, "emotion": "stern_warning", "text": "रेशमी कपडे दिव्यांपासून दूर! सुती घाला!"}, {"id": 69, "duration_s": 1.62, "emotion": "comic_panic", "text": "पाच मिनिटं! आलोच!"}, {"id": 70, "duration_s": 1.6, "emotion": "shouting", "text": "गप्प! मागे!"}, {"id": 71, "duration_s": 2.36, "emotion": "embarrassed", "text": "मी तर... रेषा तपासत होतो."}, {"id": 72, "duration_s": 3.47, "emotion": "sarcastic", "text": "रात्र झाली... आणि हिरो सुती कुर्त्यात परतला."}, {"id": 73, "duration_s": 2.96, "emotion": "proud", "text": "मी कुणाला भीत नाही! लावा!"}, {"id": 74, "duration_s": 4.04, "emotion": "stern_warning", "text": "हात सरळ! चेहरा दूर! बादली जवळ!"}, {"id": 75, "duration_s": 0.96, "emotion": "comic_panic", "text": "ठि... ठिणगी!"}, {"id": 76, "duration_s": 0.92, "emotion": "comic_panic", "text": "आआआआ!"}, {"id": 77, "duration_s": 1.07, "emotion": "comic_panic", "text": "ही विझत का नाही?!"}, {"id": 78, "duration_s": 2.14, "emotion": "excited", "text": "ऐकलंत का? गणपत मॅरेथॉन धावतोय!"}, {"id": 79, "duration_s": 3.67, "emotion": "sarcastic", "text": "फुलझडी तर दोन मिनिटांपूर्वीच विझली होती."}, {"id": 80, "duration_s": 1.62, "emotion": "tired", "text": "...सांगितलं का नाही?"}, {"id": 81, "duration_s": 3.21, "emotion": "giggly", "text": "बाबा, फुलझडी उभं राहून लावतात, पळत नाही!"}, {"id": 82, "duration_s": 5.16, "emotion": "serious", "text": "आणि जळकी तार थेट पाण्यात. पायात नाही."}, {"id": 83, "duration_s": 4.54, "emotion": "giggly", "text": "पहिली फुलझडी... आणि पहिली मॅरेथॉन!"}, {"id": 84, "duration_s": 2.806, "emotion": "mischievous", "text": "नवा प्रँक! चॉकलेट बॉम्ब!"}, {"id": 85, "duration_s": 5.01, "emotion": "curious", "text": "बॉम्बमधून... चॉकलेटचा वास?"}, {"id": 86, "duration_s": 0.66, "emotion": "shouting", "text": "बू... बू... बूम!"}, {"id": 87, "duration_s": 0.73, "emotion": "panicked", "text": "पेढा फुटला!"}, {"id": 88, "duration_s": 1.43, "emotion": "shouting", "text": "पेढा!!"}, {"id": 89, "duration_s": 4.21, "emotion": "giggly", "text": "आत चॉकलेट होतं! भूक लागली होती!"}, {"id": 90, "duration_s": 3.56, "emotion": "excited", "text": "ऐकलंत का? पेढा... पुन्हा भुकेला!"}, {"id": 91, "duration_s": 3.04, "emotion": "stern_warning", "text": "फटाक्यांची थट्टा नाही, ताई! सगळे घाबरले."}, {"id": 92, "duration_s": 3.41, "emotion": "embarrassed", "text": "सॉरी... रील डिलीट."}, {"id": 93, "duration_s": 3.36, "emotion": "mischievous", "text": "आणि आता... परत तिथेच, जिथे गोष्ट थांबली होती."}, {"id": 94, "duration_s": 4.34, "emotion": "stern_warning", "text": "लांब उदबत्ती! हात सरळ! लावा आणि मागे!"}, {"id": 95, "duration_s": 3.19, "emotion": "comic_panic", "text": "पेटला! पळा... म्हणजे, मागे सरका!"}, {"id": 96, "duration_s": 2.19, "emotion": "proud", "text": "थांबा... हा विचारात."}, {"id": 97, "duration_s": 3.03, "emotion": "serious", "text": "विज्ञान सांगतं... हा झोपलाय."}, {"id": 98, "duration_s": 3.02, "emotion": "shouting", "text": "थांबा! फुसक्या फटाक्याजवळ कोणी जाणार नाही!"}, {"id": 99, "duration_s": 3.62, "emotion": "serious", "text": "मी सांगू? पंधरा मिनिटं थांबा, मग पाणी ओता."}, {"id": 100, "duration_s": 3.46, "emotion": "sarcastic", "text": "पंधरा मिनिटं? माझं व्याज चालू आहे!"}, {"id": 101, "duration_s": 1.79, "emotion": "embarrassed", "text": "...चंद्रापेक्षा जास्त."}, {"id": 102, "duration_s": 2.1, "emotion": "sarcastic", "text": "लाइव्ह सुरू आहे... दुर्दैवाने."}, {"id": 103, "duration_s": 1.19, "emotion": "angry", "text": "सोन्या..."}, {"id": 104, "duration_s": 1.4, "emotion": "shouting", "text": "चौकशी!"}, {"id": 105, "duration_s": 4.95, "emotion": "embarrassed", "text": "भोंग्यामुळे! खरंच!"}, {"id": 106, "duration_s": 2.56, "emotion": "curious", "text": "काय झालं? मिठाई वाटतेय?"}, {"id": 107, "duration_s": 3.89, "emotion": "tender", "text": "अरे मोती... तूही घाबरलास?"}, {"id": 108, "duration_s": 2.38, "emotion": "worried", "text": "जनावरांचे कान आपल्यापेक्षा खूप तेज असतात."}, {"id": 109, "duration_s": 0.7, "emotion": "serious", "text": "आपल्याला फटाका वाटतो, त्यांना वादळ वाटतं."}, {"id": 110, "duration_s": 2.18, "emotion": "tender", "text": "श्श्श... मोतीसाठी शांत कोपरा!"}, {"id": 111, "duration_s": 3.68, "emotion": "calm", "text": "धमाक्यांपासून दूर... एक छोटा शांत कोपरा."}, {"id": 112, "duration_s": 3.14, "emotion": "happy", "text": "माझे कान म्हातारे! मीही इथेच!"}, {"id": 113, "duration_s": 1.92, "emotion": "tender", "text": "ये मोती, इथे धमाका नाही."}, {"id": 114, "duration_s": 2.53, "emotion": "serious", "text": "बिचाऱ्याला दृष्ट लागली होती!"}, {"id": 115, "duration_s": 3.36, "emotion": "proud", "text": "शाब्बास, माझं सेफ्टी पथक."}, {"id": 116, "duration_s": 2.86, "emotion": "mischievous", "text": "आणि मग... सुपर बॉम्बचं पोस्टमॉर्टेम."}, {"id": 117, "duration_s": 4.25, "emotion": "serious", "text": "चौकशी होणार! ...थरामागून थर."}, {"id": 118, "duration_s": 3.64, "emotion": "sad", "text": "एवढा मोठा डबा... आत फक्त इतकंसं?"}, {"id": 119, "duration_s": 2.9, "emotion": "serious", "text": "नाव नसलेला फटाका धोकादायकही असू शकतो."}, {"id": 120, "duration_s": 3.25, "emotion": "loving", "text": "काका, परवाना दुकानातून घ्या. गाडीतून नाही."}, {"id": 121, "duration_s": 3.42, "emotion": "guilty", "text": "बरोबर. पुढच्या वेळी आधी विचारीन."}, {"id": 122, "duration_s": 2.29, "emotion": "giggly", "text": "टेन्शन घेतो... थोडंसं."}, {"id": 123, "duration_s": 2.42, "emotion": "stern_warning", "text": "शेठजी! रिकामे डबे?"}, {"id": 124, "duration_s": 5.17, "emotion": "guilty", "text": "ठीक आहे! सगळ्यांना... मोफत मिठाई!"}, {"id": 125, "duration_s": 3.14, "emotion": "crying", "text": "मोफत... म्हणायलाही त्रास होतो."}, {"id": 126, "duration_s": 1.83, "emotion": "serious", "text": "चौकशी पूर्ण झाली."}, {"id": 127, "duration_s": 1.39, "emotion": "happy", "text": "बरोबर वाटलं!"}, {"id": 128, "duration_s": 4.27, "emotion": "calm", "text": "त्या रात्री सोसायटीत धूर कमी होता... आणि उजेड जास्त."}, {"id": 129, "duration_s": 3.76, "emotion": "loving", "text": "हे दिवे गुपचूप जळतात... आणि रात्रभर."}, {"id": 130, "duration_s": 2.22, "emotion": "giggly", "text": "आणि यांच्यासाठी शिट्टीही लागत नाही!"}, {"id": 131, "duration_s": 2.98, "emotion": "excited", "text": "नवी रील... 'सायलेंट दिवाळी'! लाइव्ह सुरू आहे!"}, {"id": 132, "duration_s": 2.22, "emotion": "excited", "text": "ऐकलंत का? रिंकूची रील व्हायरल!"}, {"id": 133, "duration_s": 6.861, "emotion": "proud", "text": "बघितलं? अख्ख्या सोसायटीनं! अख्ख्या देशानंही!"}, {"id": 134, "duration_s": 1.62, "emotion": "giggly", "text": "आणि रीलमध्ये तुमची चप्पलही!"}, {"id": 135, "duration_s": 4.07, "emotion": "proud", "text": "विज्ञान सांगतं... दिवा सर्वात सेफ फटाका आहे."}, {"id": 136, "duration_s": 3.12, "emotion": "shocked", "text": "हरीश बरोबर?! मी नीट ऐकलं?"}, {"id": 137, "duration_s": 6.11, "emotion": "serious", "text": "फटाका हातात नको, बादली जवळ, मुलं मोठ्यांसोबत."}, {"id": 138, "duration_s": 4.22, "emotion": "loving", "text": "आणि प्राणी-वयस्करांसाठी एक शांत कोपरा."}, {"id": 139, "duration_s": 5.44, "emotion": "calm", "text": "प्रकाश मनात असावा... धमाका हातात नको."}, {"id": 140, "duration_s": 1.44, "emotion": "excited", "text": "हॅपी सेफ दिवाळी!"}]