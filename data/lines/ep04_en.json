[{"id": 1, "duration_s": 4.68, "emotion": "calm", "text": "Sunday evening. Satyanarayan katha at Sharma ji's house."}, {"id": 2, "duration_s": 2.78, "emotion": "excited", "text": "Banana Kingdom! Oo oo aa aa!"}, {"id": 3, "duration_s": 2.19, "emotion": "excited", "text": "Only ninety-nine rupees!"}, {"id": 4, "duration_s": 1.42, "emotion": "shocked", "text": "Deducted again?!"}, {"id": 5, "duration_s": 1.07, "emotion": "embarrassed", "text": "Oo oo aa aa?"}, {"id": 6, "duration_s": 2.83, "emotion": "mischievous", "text": "It all began... three days ago."}, {"id": 7, "duration_s": 1.55, "emotion": "mischievous", "text": "With one banana game."}, {"id": 8, "duration_s": 11.22, "emotion": "angry", "text": "Chhotu! This phone won't send 'Good Morning'!"}, {"id": 9, "duration_s": 2.893, "emotion": "proud", "text": "Done. Sent to fourteen groups."}, {"id": 10, "duration_s": 2.53, "emotion": "proud", "text": "The whole colony will see!"}, {"id": 11, "duration_s": 2.62, "emotion": "excited", "text": "Dadi! It has the monkey game!"}, {"id": 12, "duration_s": 4.07, "emotion": "tired", "text": "Play five minutes. I'll just close my eyes..."}, {"id": 13, "duration_s": 2.16, "emotion": "excited", "text": "Welcome to Banana Kingdom!"}, {"id": 14, "duration_s": 3.9, "emotion": "excited", "text": "Bananas over! Hundred bananas, ninety-nine rupees only!"}, {"id": 15, "duration_s": 3.09, "emotion": "curious", "text": "Ninety-nine rupees? Real ones?"}, {"id": 16, "duration_s": 2.484, "emotion": "mischievous", "text": "Silly! Game money is fake."}, {"id": 17, "duration_s": 1.345, "emotion": "mischievous", "text": "I have an idea!"}, {"id": 18, "duration_s": 3.18, "emotion": "excited", "text": "Did you hear that? We're getting money!"}, {"id": 19, "duration_s": 2.26, "emotion": "laughing", "text": "One more! Hehe! More!"}, {"id": 20, "duration_s": 3.17, "emotion": "happy", "text": "The whole colony... will see..."}, {"id": 21, "duration_s": 4.75, "emotion": "excited", "text": "Super, super! You are the King of Banana Kingdom!"}, {"id": 22, "duration_s": 3.47, "emotion": "calm", "text": "Same morning. Ramesh ji relaxing in the verandah."}, {"id": 23, "duration_s": 3.19, "emotion": "proud", "text": "My bank account is an iron vault, Tinku!"}, {"id": 24, "duration_s": 2.24, "emotion": "sarcastic", "text": "Is anything inside, though?"}, {"id": 25, "duration_s": 3.13, "emotion": "neutral", "text": "Ninety-nine gone? Fine... tea expense."}, {"id": 26, "duration_s": 1.78, "emotion": "shocked", "text": "Four hundred ninety-nine?!"}, {"id": 27, "duration_s": 2.11, "emotion": "curious", "text": "Bhaiya, your vault has a hole."}, {"id": 28, "duration_s": 3.57, "emotion": "panicked", "text": "Nine hundred ninety-nine! Not a thief... a dacoit!"}, {"id": 29, "duration_s": 2.68, "emotion": "excited", "text": "Don't take tension! Just sell the phone!"}, {"id": 30, "duration_s": 2.93, "emotion": "determined", "text": "I fear nobody! That thief, I will..."}, {"id": 31, "duration_s": 1.95, "emotion": "comic_panic", "text": "Li-lizard!"}, {"id": 32, "duration_s": 2.8, "emotion": "sarcastic", "text": "Fear nobody? Not even lizards?"}, {"id": 33, "duration_s": 2.72, "emotion": "embarrassed", "text": "She was the thief's spy! Secret agent!"}, {"id": 34, "duration_s": 2.49, "emotion": "calm", "text": "Enough! Now I will see—"}, {"id": 35, "duration_s": 2.53, "emotion": "shouting", "text": "No! This is a police case!"}, {"id": 36, "duration_s": 4.47, "emotion": "scared_whisper", "text": "Hello, police station? My account is being looted!"}, {"id": 37, "duration_s": 5.94, "emotion": "serious", "text": "There will be an inquiry! Full inquiry!"}, {"id": 38, "duration_s": 3.91, "emotion": "panicked", "text": "Sir, thief is invisible... he only cuts money!"}, {"id": 39, "duration_s": 3.98, "emotion": "curious", "text": "Hmm... smell of a clue."}, {"id": 40, "duration_s": 7.52, "emotion": "serious", "text": "When does thief come? What does he wear? Where is the chutney?"}, {"id": 41, "duration_s": 0.96, "emotion": "embarrassed", "text": "I'm hungry!"}, {"id": 42, "duration_s": 4.82, "emotion": "serious", "text": "Write... thief... is hungry."}, {"id": 43, "duration_s": 2.69, "emotion": "curious", "text": "Hungry? How did you know?"}, {"id": 44, "duration_s": 1.61, "emotion": "proud", "text": "Pakodas are finished, no!"}, {"id": 45, "duration_s": 2.71, "emotion": "pleading", "text": "Sir? Sir! The thief!"}, {"id": 46, "duration_s": 1.34, "emotion": "sarcastic", "text": "One more pakoda?"}, {"id": 47, "duration_s": 1.82, "emotion": "excited", "text": "Inquiry!"}, {"id": 48, "duration_s": 4.563, "emotion": "serious", "text": "I will go to the station and eat the report. I mean... write."}, {"id": 49, "duration_s": 6.271, "emotion": "sad", "text": "Sigh. Thief is hungry... Havaldar is hungry."}, {"id": 50, "duration_s": 4.037, "emotion": "mischievous", "text": "In one hour... news in the whole colony."}, {"id": 51, "duration_s": 2.96, "emotion": "excited", "text": "Did you hear? Thief in Sharma ji's phone!"}, {"id": 52, "duration_s": 2.475, "emotion": "scared_whisper", "text": "Did you hear? The thief is invisible!"}, {"id": 53, "duration_s": 2.68, "emotion": "shocked", "text": "Did you hear? The thief is a monkey!"}, {"id": 54, "duration_s": 1.92, "emotion": "proud", "text": "Science says..."}, {"id": 55, "duration_s": 3.15, "emotion": "serious", "text": "Thief... is left-handed!"}, {"id": 56, "duration_s": 1.15, "emotion": "curious", "text": "How do you know?"}, {"id": 57, "duration_s": 2.22, "emotion": "proud", "text": "Money always leaves by the left hand!"}, {"id": 58, "duration_s": 1.11, "emotion": "stern_warning", "text": "Seth ji!"}, {"id": 59, "duration_s": 3.83, "emotion": "serious", "text": "My left hand only counts. Not one rupee less!"}, {"id": 60, "duration_s": 3.2, "emotion": "serious", "text": "Evil eye! Lemon-chilli on every phone!"}, {"id": 61, "duration_s": 1.8, "emotion": "excited", "text": "We're live! Thief in the colony!"}, {"id": 62, "duration_s": 2.26, "emotion": "determined", "text": "Let's go, let's go! Catch the thief!"}, {"id": 63, "duration_s": 2.55, "emotion": "embarrassed", "text": "Sigh. We'll catch the thief on foot."}, {"id": 64, "duration_s": 3.24, "emotion": "comic_panic", "text": "Nineteen ninety-nine! Now! Right here!"}, {"id": 65, "duration_s": 0.96, "emotion": "shocked", "text": "Thief among us!"}, {"id": 66, "duration_s": 1.98, "emotion": "shouting", "text": "You! No, you!"}, {"id": 67, "duration_s": 1.12, "emotion": "shouting", "text": "Quiet!"}, {"id": 68, "duration_s": 3.93, "emotion": "curious", "text": "May I say? Thief is maybe from home itself..."}, {"id": 69, "duration_s": 1.02, "emotion": "shouting", "text": "No!"}, {"id": 70, "duration_s": 2.52, "emotion": "sarcastic", "text": "Kids don't understand science!"}, {"id": 71, "duration_s": 2.89, "emotion": "scared_whisper", "text": "Two a.m. The whole colony is sleeping..."}, {"id": 72, "duration_s": 0.89, "emotion": "mischievous", "text": "...almost whole."}, {"id": 73, "duration_s": 2.32, "emotion": "scared_whisper", "text": "Just one more level... then I'll sleep."}, {"id": 74, "duration_s": 1.75, "emotion": "scared_whisper", "text": "Shh! Monkey is hungry."}, {"id": 75, "duration_s": 2.21, "emotion": "scared_whisper", "text": "Thief... is inside the house!"}, {"id": 76, "duration_s": 3.71, "emotion": "scared_whisper", "text": "I fear nobody... I fear no-nobody..."}, {"id": 77, "duration_s": 1.77, "emotion": "scared_whisper", "text": "Who is it? Hands up!"}, {"id": 78, "duration_s": 1.23, "emotion": "angry", "text": "Torch at night?!"}, {"id": 79, "duration_s": 2.1, "emotion": "embarrassed", "text": "Ma... did you see any thief?"}, {"id": 80, "duration_s": 4.009, "emotion": "tired", "text": "Thief? Only me here."}, {"id": 81, "duration_s": 1.37, "emotion": "relieved", "text": "Yes... you were sleeping only."}, {"id": 82, "duration_s": 4.3, "emotion": "serious", "text": "Thief roaming in colony. Not one rupee less!"}, {"id": 83, "duration_s": 1.04, "emotion": "excited", "text": "Don't take tension!"}, {"id": 84, "duration_s": 3.74, "emotion": "mischievous", "text": "Game hack! Unlimited bananas! Only two hundred!"}, {"id": 85, "duration_s": 2.73, "emotion": "curious", "text": "Not two hundred... two samosas."}, {"id": 86, "duration_s": 1.45, "emotion": "happy", "text": "Okay! Deal done!"}, {"id": 87, "duration_s": 1.96, "emotion": "shocked", "text": "Arey! He ate the payment!"}, {"id": 88, "duration_s": 3.1, "emotion": "stern_warning", "text": "Game hack? Shall I show you real hack?"}, {"id": 89, "duration_s": 2.98, "emotion": "pleading", "text": "Bhabhi... this was social service!"}, {"id": 90, "duration_s": 2.75, "emotion": "excited", "text": "Two hundred? My ten percent!"}, {"id": 91, "duration_s": 2.03, "emotion": "stern_warning", "text": "Seth ji!"}, {"id": 92, "duration_s": 1.28, "emotion": "happy", "text": "Nice hack."}, {"id": 93, "duration_s": 3.44, "emotion": "calm", "text": "Three days later. Same puja... where we started."}, {"id": 94, "duration_s": 2.4, "emotion": "scared_whisper", "text": "No expenses today. Today is puja."}, {"id": 95, "duration_s": 2.43, "emotion": "scared_whisper", "text": "We're live! Sharma puja, exclusive!"}, {"id": 96, "duration_s": 4.07, "emotion": "serious", "text": "And then Leelavati... did not eat the prasad."}, {"id": 97, "duration_s": 1.35, "emotion": "curious", "text": "Which chapter is this?"}, {"id": 98, "duration_s": 3.79, "emotion": "excited", "text": "This... is a new bhajan! Banana bhajan!"}, {"id": 99, "duration_s": 1.43, "emotion": "shocked", "text": "Evil eye!"}, {"id": 100, "duration_s": 2.36, "emotion": "excited", "text": "Did you hear? Dadi's disco bhajan!"}, {"id": 101, "duration_s": 2.99, "emotion": "excited", "text": "Thank you! Ninety-nine rupees debited!"}, {"id": 102, "duration_s": 1.41, "emotion": "shocked", "text": "Deducted again?!"}, {"id": 103, "duration_s": 1.61, "emotion": "embarrassed", "text": "Oo oo aa aa?"}, {"id": 104, "duration_s": 1.71, "emotion": "shouting", "text": "Inquiry!"}, {"id": 105, "duration_s": 0.85, "emotion": "shocked", "text": "Dadi?!"}, {"id": 106, "duration_s": 0.8, "emotion": "curious", "text": "May I say?"}, {"id": 107, "duration_s": 0.93, "emotion": "shouting", "text": "Say it!"}, {"id": 108, "duration_s": 5.58, "emotion": "serious", "text": "Ninety-nine... four ninety-nine... nine ninety-nine..."}, {"id": 109, "duration_s": 4.07, "emotion": "serious", "text": "All from this phone. Payment from Ramesh Uncle's card."}, {"id": 110, "duration_s": 2.97, "emotion": "shocked", "text": "My card? In Dadi's phone?"}, {"id": 111, "duration_s": 2.87, "emotion": "sarcastic", "text": "You only put it! To pay electricity bill!"}, {"id": 112, "duration_s": 4.39, "emotion": "sad", "text": "Sigh. And forgot to remove."}, {"id": 113, "duration_s": 4.24, "emotion": "guilty", "text": "Papa... first ninety-nine... I pressed."}, {"id": 114, "duration_s": 2.9, "emotion": "guilty", "text": "And four ninety-nine... both of us."}, {"id": 115, "duration_s": 2.236, "emotion": "guilty", "text": "We thought game money is fake."}, {"id": 116, "duration_s": 2.96, "emotion": "serious", "text": "Money was real. Only bananas were fake."}, {"id": 117, "duration_s": 2.79, "emotion": "guilty", "text": "And the two a.m. ones... me."}, {"id": 118, "duration_s": 1.24, "emotion": "shocked", "text": "Two a.m.?!"}, {"id": 119, "duration_s": 1.66, "emotion": "pleading", "text": "Monkey was hungry!"}, {"id": 120, "duration_s": 3.79, "emotion": "proud", "text": "See! I told you, thief is hungry!"}, {"id": 121, "duration_s": 3.71, "emotion": "proud", "text": "And Dadi is left-handed! Science says!"}, {"id": 122, "duration_s": 3.04, "emotion": "excited", "text": "Did you hear? Thief... turned out to be Dadi!"}, {"id": 123, "duration_s": 2.9, "emotion": "proud", "text": "Now I will handle it! I fear no—"}, {"id": 124, "duration_s": 2.56, "emotion": "determined", "text": "Enough! Now I will see."}, {"id": 125, "duration_s": 2.62, "emotion": "serious", "text": "One - PIN on every payment."}, {"id": 126, "duration_s": 1.83, "emotion": "serious", "text": "Two - monthly limit."}, {"id": 127, "duration_s": 3.12, "emotion": "serious", "text": "Three - remove card, auto-pay off."}, {"id": 128, "duration_s": 0.73, "emotion": "shocked", "text": "That's all? In ten seconds?"}, {"id": 129, "duration_s": 2.33, "emotion": "pleading", "text": "And... our game?"}, {"id": 130, "duration_s": 3.27, "emotion": "calm", "text": "Daily thirty minutes. Then cricket outside!"}, {"id": 131, "duration_s": 1.72, "emotion": "excited", "text": "Samosas after cricket?"}, {"id": 132, "duration_s": 1.16, "emotion": "worried", "text": "And the money that's gone?"}, {"id": 133, "duration_s": 3.43, "emotion": "calm", "text": "Complaint to company. And from now... PIN!"}, {"id": 134, "duration_s": 2.52, "emotion": "calm", "text": "Children need our company more than phones."}, {"id": 135, "duration_s": 2.54, "emotion": "serious", "text": "PIN on phone... time with children."}, {"id": 136, "duration_s": 2.16, "emotion": "laughing", "text": "And double PIN on Dadi's phone!"}, {"id": 137, "duration_s": 1.18, "emotion": "proud", "text": "I fear nobody! Bowl the ball!"}, {"id": 138, "duration_s": 1.35, "emotion": "mischievous", "text": "Left-handed. Science says."}, {"id": 139, "duration_s": 0.99, "emotion": "sad", "text": "Sigh. Same to same, like chappal."}, {"id": 140, "duration_s": 2.69, "emotion": "laughing", "text": "Dadi never misses!"}]