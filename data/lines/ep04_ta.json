[{"id": 1, "duration_s": 4.91, "emotion": "calm", "text": "ஞாயிறு சாயங்காலம். முருகேசன் வீட்டுல சத்தியநாராயண பூஜை."}, {"id": 2, "duration_s": 1.55, "emotion": "excited", "text": "பனானா கிங்டம்! ஊ ஊ ஆ ஆ!"}, {"id": 3, "duration_s": 3.02, "emotion": "excited", "text": "தொண்ணூத்தொம்பது ரூவாதானுங்க!"}, {"id": 4, "duration_s": 0.7, "emotion": "shocked", "text": "மறுபடியுமா?!"}, {"id": 5, "duration_s": 2.15, "emotion": "embarrassed", "text": "ஊ ஊ ஆ ஆ?"}, {"id": 6, "duration_s": 3.36, "emotion": "mischievous", "text": "இதெல்லாம் ஆரம்பிச்சது... மூணு நாள் முன்னாடி."}, {"id": 7, "duration_s": 1.75, "emotion": "mischievous", "text": "ஒரு வாழைப்பழ கேமால."}, {"id": 8, "duration_s": 3.01, "emotion": "angry", "text": "குட்டி! போன்ல குட்மார்னிங் போகவே மாட்டேங்குது!"}, {"id": 9, "duration_s": 2.22, "emotion": "proud", "text": "ஆச்சு! பதினாலு குரூப்புக்கும் போச்சு."}, {"id": 10, "duration_s": 1.37, "emotion": "proud", "text": "தெரு முழுக்க பார்க்கும்!"}, {"id": 11, "duration_s": 2.24, "emotion": "excited", "text": "பட்டம்மா! குரங்கு கேம் இருக்கு!"}, {"id": 12, "duration_s": 3.16, "emotion": "tired", "text": "அஞ்சு நிமிஷம் விளையாடுங்க. நான் கண்ணை மூடி..."}, {"id": 13, "duration_s": 2.338, "emotion": "excited", "text": "பனானா கிங்டமுக்கு வாங்கோங்க!"}, {"id": 14, "duration_s": 4.17, "emotion": "excited", "text": "பழம் தீந்துபோச்சுங்க! தொண்ணூத்தொம்பது ரூவாக்கு நூறு பழம்!"}, {"id": 15, "duration_s": 3.21, "emotion": "curious", "text": "தொண்ணூத்தொம்பது ரூபாயா? நிஜமாவா?"}, {"id": 16, "duration_s": 2.89, "emotion": "mischievous", "text": "மண்டு! கேம் காசு டூப்புடா!"}, {"id": 17, "duration_s": 1.09, "emotion": "mischievous", "text": "ஒரு ஐடியா இருக்கு!"}, {"id": 18, "duration_s": 3.65, "emotion": "excited", "text": "சத்தம் கேட்டுச்சா? நமக்கு காசு வருது!"}, {"id": 19, "duration_s": 2.27, "emotion": "laughing", "text": "இன்னொண்ணு! ஹா ஹா! இன்னொண்ணு!"}, {"id": 20, "duration_s": 2.97, "emotion": "happy", "text": "தெரு முழுக்க... பார்க்கும்..."}, {"id": 21, "duration_s": 3.74, "emotion": "excited", "text": "சபாஷ் கண்ணு! நீங்கதானுங்க பனானா கிங்டம் ராஜா!"}, {"id": 22, "duration_s": 3.56, "emotion": "calm", "text": "அதே காலைல. திண்ணையில முருகேசனோட ஓய்வு."}, {"id": 23, "duration_s": 2.97, "emotion": "proud", "text": "என் பேங்க் அக்கவுண்ட்... இரும்புப் பெட்டி, சேகர்!"}, {"id": 24, "duration_s": 1.1, "emotion": "sarcastic", "text": "உள்ள ஏதாவது இருக்கா?"}, {"id": 25, "duration_s": 3.27, "emotion": "neutral", "text": "தொண்ணூத்தொம்பது போச்சா? போகட்டும்... டீ செலவு."}, {"id": 26, "duration_s": 1.24, "emotion": "shocked", "text": "நானூத்து தொண்ணூத்தொம்பதா?!"}, {"id": 27, "duration_s": 1.64, "emotion": "curious", "text": "அண்ணே, பெட்டியில ஓட்டை!"}, {"id": 28, "duration_s": 2.16, "emotion": "panicked", "text": "தொள்ளாயிரத்தொம்பது! இவன் கொள்ளைக்காரன்!"}, {"id": 29, "duration_s": 2.29, "emotion": "excited", "text": "டென்ஷன் ஆகாதீங்க! போனையே வித்துடுங்க!"}, {"id": 30, "duration_s": 1.64, "emotion": "determined", "text": "நான் யாருக்கும் பயப்படமாட்டேன்! அவனை..."}, {"id": 31, "duration_s": 2.8, "emotion": "comic_panic", "text": "பல்... பல்லி!"}, {"id": 32, "duration_s": 2.69, "emotion": "sarcastic", "text": "யாருக்கும் பயப்படமாட்டீங்க? பல்லிக்குமா?"}, {"id": 33, "duration_s": 2.08, "emotion": "embarrassed", "text": "திருடன் உளவாளி! ரகசியம்!"}, {"id": 34, "duration_s": 1.73, "emotion": "calm", "text": "போதும்! இனி நான் பாக்குறேன்—"}, {"id": 35, "duration_s": 1.6, "emotion": "shouting", "text": "வேணாம்! இது போலீஸ் கேஸ்!"}, {"id": 36, "duration_s": 2.78, "emotion": "scared_whisper", "text": "ஹலோ, ஸ்டேஷனா? என் அக்கவுண்ட்... கொள்ளை போகுது!"}, {"id": 37, "duration_s": 3.3, "emotion": "serious", "text": "விசாரணை நடக்கும்! முழுசா!"}, {"id": 38, "duration_s": 2.9, "emotion": "panicked", "text": "ஐயா, திருடன் தெரியல... காசு மட்டும் போகுது!"}, {"id": 39, "duration_s": 3.98, "emotion": "curious", "text": "ம்ம்... துப்பு வாசனை அடிக்குது."}, {"id": 40, "duration_s": 7.229, "emotion": "serious", "text": "திருடன் எப்ப வருவான்? என்ன போடுவான்? சட்னி எங்கே?"}, {"id": 41, "duration_s": 1.44, "emotion": "embarrassed", "text": "பசிக்குது!"}, {"id": 42, "duration_s": 3.88, "emotion": "serious", "text": "எழுது... கள்ளன் பசி!"}, {"id": 43, "duration_s": 1.96, "emotion": "curious", "text": "பசியா? எப்படி தெரியும்?"}, {"id": 44, "duration_s": 1.9, "emotion": "proud", "text": "பக்கோடா தீர்ந்துபோச்சுல்ல!"}, {"id": 45, "duration_s": 2.16, "emotion": "pleading", "text": "ஐயா? ஐயா! திருடன்!"}, {"id": 46, "duration_s": 0.98, "emotion": "sarcastic", "text": "இன்னொரு பக்கோடா?"}, {"id": 47, "duration_s": 1.925, "emotion": "excited", "text": "விசாரணை!"}, {"id": 48, "duration_s": 5.29, "emotion": "serious", "text": "ஸ்டேஷன் போய் ரிப்போர்ட் சாப்பிடுவேன். அதாவது... எழுதுவேன்."}, {"id": 49, "duration_s": 5.774, "emotion": "sad", "text": "ஹூம்... திருடனுக்கும் பசி... கான்ஸ்டபிளுக்கும் பசி."}, {"id": 50, "duration_s": 3.98, "emotion": "mischievous", "text": "ஒரு மணி நேரத்துல... செய்தி தெரு முழுக்க."}, {"id": 51, "duration_s": 2.02, "emotion": "excited", "text": "கேட்டியா? முருகேசன் போன்ல திருடன்!"}, {"id": 52, "duration_s": 1.55, "emotion": "scared_whisper", "text": "கேளு! திருடன் தெரியாதாம்!"}, {"id": 53, "duration_s": 1.73, "emotion": "shocked", "text": "கேட்டியா? திருடன் குரங்காம்!"}, {"id": 54, "duration_s": 1.46, "emotion": "proud", "text": "சயின்ஸ் சொல்றது..."}, {"id": 55, "duration_s": 2.44, "emotion": "serious", "text": "திருடன்... இடது கை பழக்கம்!"}, {"id": 56, "duration_s": 0.51, "emotion": "curious", "text": "எப்படி?"}, {"id": 57, "duration_s": 2.4, "emotion": "proud", "text": "காசு எப்பவும் இடது கையாலதான் போகும்!"}, {"id": 58, "duration_s": 1.15, "emotion": "stern_warning", "text": "கந்தசாமி!"}, {"id": 59, "duration_s": 3.46, "emotion": "serious", "text": "என் இடது கை எண்ணத்தான்! ஒரு ரூபா கூட கம்மி இல்ல!"}, {"id": 60, "duration_s": 3.26, "emotion": "serious", "text": "கண்ணு பட்டுச்சு! போனுக்கெல்லாம் எலுமிச்சை மிளகா!"}, {"id": 61, "duration_s": 2.27, "emotion": "excited", "text": "லைவ்-ல இருக்கோம்! தெருவுல திருடன்!"}, {"id": 62, "duration_s": 1.94, "emotion": "determined", "text": "வாங்க, போலாம்! திருடனை பிடிக்க!"}, {"id": 63, "duration_s": 2.56, "emotion": "embarrassed", "text": "ஹூம்... திருடனை நடந்தே பிடிப்போம்."}, {"id": 64, "duration_s": 2.41, "emotion": "comic_panic", "text": "ஆயிரத்தொள்ளாயிரத்தொம்பது! இப்போ!"}, {"id": 65, "duration_s": 1.22, "emotion": "shocked", "text": "திருடன் நம்ம நடுவுல!"}, {"id": 66, "duration_s": 1.8, "emotion": "shouting", "text": "நீ! இல்ல, நீ!"}, {"id": 67, "duration_s": 0.67, "emotion": "shouting", "text": "அமைதி!"}, {"id": 68, "duration_s": 3.0, "emotion": "curious", "text": "நான் சொல்லவா? திருடன் வீட்டுக்குள்ளயே இருப்பான்..."}, {"id": 69, "duration_s": 0.94, "emotion": "shouting", "text": "வேணாம்!"}, {"id": 70, "duration_s": 1.84, "emotion": "sarcastic", "text": "பசங்களுக்கு சயின்ஸ் புரியாது!"}, {"id": 71, "duration_s": 3.25, "emotion": "scared_whisper", "text": "ராத்திரி ரெண்டு மணி. தெரு முழுக்க தூக்கத்துல..."}, {"id": 72, "duration_s": 1.27, "emotion": "mischievous", "text": "...கிட்டத்தட்ட முழுக்க."}, {"id": 73, "duration_s": 2.99, "emotion": "scared_whisper", "text": "இன்னும் ஒரே ஒரு லெவல்... அப்புறம் தூங்குறேன்."}, {"id": 74, "duration_s": 2.58, "emotion": "scared_whisper", "text": "ஷ்ஷ்! குரங்குக்கு பசி."}, {"id": 75, "duration_s": 1.8, "emotion": "scared_whisper", "text": "திருடன்... வீட்டுக்குள்ள!"}, {"id": 76, "duration_s": 2.87, "emotion": "scared_whisper", "text": "நான் யாருக்கும் பயப்படமாட்டேன்... நான்..."}, {"id": 77, "duration_s": 1.72, "emotion": "scared_whisper", "text": "யாரது? கையை தூக்கு!"}, {"id": 78, "duration_s": 1.37, "emotion": "angry", "text": "ராத்திரி டார்ச்சா?!"}, {"id": 79, "duration_s": 1.88, "emotion": "embarrassed", "text": "அம்மா... திருடனைப் பார்த்தீங்களா?"}, {"id": 80, "duration_s": 3.37, "emotion": "tired", "text": "திருடனா? இங்க நான் மட்டும்தான்!"}, {"id": 81, "duration_s": 2.46, "emotion": "relieved", "text": "ஆமா... நீங்க தூங்குறீங்க."}, {"id": 82, "duration_s": 4.14, "emotion": "serious", "text": "தெருவுல திருடன் சுத்துறான். ஒரு ரூபா கூட கம்மி இல்ல!"}, {"id": 83, "duration_s": 0.7, "emotion": "excited", "text": "டென்ஷன் வேணாம்!"}, {"id": 84, "duration_s": 3.16, "emotion": "mischievous", "text": "கேம் ஹேக்! அன்லிமிடெட் பழம்! இருநூறுதான்!"}, {"id": 85, "duration_s": 2.72, "emotion": "curious", "text": "இருநூறில்ல... ரெண்டு சமோசா!"}, {"id": 86, "duration_s": 0.98, "emotion": "happy", "text": "சரி! டீல் ஓகே!"}, {"id": 87, "duration_s": 1.95, "emotion": "shocked", "text": "அடடா! பேமெண்டையே தின்னுட்டான்!"}, {"id": 88, "duration_s": 3.47, "emotion": "stern_warning", "text": "கேம் ஹேக்கா? அசல் ஹேக் காட்டவா?"}, {"id": 89, "duration_s": 2.27, "emotion": "pleading", "text": "அண்ணி... இது சமூக சேவை!"}, {"id": 90, "duration_s": 2.62, "emotion": "excited", "text": "இருநூறா? அதுல என் பத்து பர்சன்ட்!"}, {"id": 91, "duration_s": 1.12, "emotion": "stern_warning", "text": "சேட்டுஜி!"}, {"id": 92, "duration_s": 1.29, "emotion": "happy", "text": "ஹேக் சூப்பர்!"}, {"id": 93, "duration_s": 4.21, "emotion": "calm", "text": "மூணு நாள் கழிச்சு. அதே பூஜை... நாம ஆரம்பிச்ச இடம்."}, {"id": 94, "duration_s": 2.45, "emotion": "scared_whisper", "text": "இன்னிக்கு செலவே இல்ல. இன்னிக்கு பூஜை."}, {"id": 95, "duration_s": 3.15, "emotion": "scared_whisper", "text": "லைவ்-ல இருக்கோம்! முருகேசன் பூஜை, எக்ஸ்க்ளூசிவ்!"}, {"id": 96, "duration_s": 2.67, "emotion": "serious", "text": "அப்புறம் கலாவதி... பிரசாதம் சாப்பிடலை."}, {"id": 97, "duration_s": 1.92, "emotion": "curious", "text": "இது என்ன அத்தியாயம்?"}, {"id": 98, "duration_s": 4.42, "emotion": "excited", "text": "இது... புது பஜனை! வாழைப்பழ பஜனை!"}, {"id": 99, "duration_s": 1.78, "emotion": "shocked", "text": "கண்ணு பட்டுடுச்சு!"}, {"id": 100, "duration_s": 2.6, "emotion": "excited", "text": "கேட்டியா? பட்டம்மாவோட டிஸ்கோ பஜனை!"}, {"id": 101, "duration_s": 1.97, "emotion": "excited", "text": "நன்றிங்க! தொண்ணூத்தொம்பது ரூவா!"}, {"id": 102, "duration_s": 1.15, "emotion": "shocked", "text": "மறுபடியுமா?!"}, {"id": 103, "duration_s": 1.22, "emotion": "embarrassed", "text": "ஊ ஊ ஆ ஆ?"}, {"id": 104, "duration_s": 1.23, "emotion": "shouting", "text": "விசாரணை!"}, {"id": 105, "duration_s": 0.85, "emotion": "shocked", "text": "பட்டம்மா?!"}, {"id": 106, "duration_s": 0.78, "emotion": "curious", "text": "நான் சொல்லவா?"}, {"id": 107, "duration_s": 0.99, "emotion": "shouting", "text": "சொல்லு!"}, {"id": 108, "duration_s": 3.54, "emotion": "serious", "text": "தொண்ணூத்தொம்பது... நானூத்தொம்பது... தொள்ளாயிரத்தொம்பது..."}, {"id": 109, "duration_s": 3.27, "emotion": "serious", "text": "எல்லாம் இதே போன்ல. பணம் முருகேசன் சித்தப்பா கார்டுல."}, {"id": 110, "duration_s": 1.93, "emotion": "shocked", "text": "என் கார்டா? பட்டம்மா போன்ல?"}, {"id": 111, "duration_s": 4.581, "emotion": "sarcastic", "text": "நீதானே போட்ட! கரண்ட் பில் கட்ட!"}, {"id": 112, "duration_s": 1.29, "emotion": "sad", "text": "ஹூம்... எடுக்கவும் மறந்துட்டேன்."}, {"id": 113, "duration_s": 4.78, "emotion": "guilty", "text": "அப்பா... முதல் தொண்ணூத்தொம்பது... நான்தான் அழுத்தினேன்."}, {"id": 114, "duration_s": 3.54, "emotion": "guilty", "text": "நானூத்து தொண்ணூத்தொம்பது... நாங்க ரெண்டு பேரும்."}, {"id": 115, "duration_s": 1.77, "emotion": "guilty", "text": "கேம் காசு டூப்புன்னு நினைச்சோம்."}, {"id": 116, "duration_s": 2.84, "emotion": "serious", "text": "காசு நிஜம். வாழைப்பழம்தான் டூப்பு."}, {"id": 117, "duration_s": 3.68, "emotion": "guilty", "text": "ராத்திரி ரெண்டு மணிக்கு போனது... நான்தான்."}, {"id": 118, "duration_s": 1.32, "emotion": "shocked", "text": "ராத்திரி ரெண்டுக்கா?!"}, {"id": 119, "duration_s": 1.69, "emotion": "pleading", "text": "குரங்குக்கு பசி!"}, {"id": 120, "duration_s": 3.03, "emotion": "proud", "text": "பார்த்தீங்களா! திருடன் பசின்னு சொன்னேன்ல!"}, {"id": 121, "duration_s": 2.89, "emotion": "proud", "text": "பட்டம்மா இடது கை! சயின்ஸ் சொல்லுது!"}, {"id": 122, "duration_s": 2.51, "emotion": "excited", "text": "கேட்டியா? திருடன்... பட்டம்மாவாம்!"}, {"id": 123, "duration_s": 2.85, "emotion": "proud", "text": "இனி நான் பாத்துக்கறேன்! நான் யாருக்கும்—"}, {"id": 124, "duration_s": 2.08, "emotion": "determined", "text": "போதும்! இனி நான் பாக்குறேன்."}, {"id": 125, "duration_s": 2.72, "emotion": "serious", "text": "ஒண்ணு - ஒவ்வொரு பேமெண்டுக்கும் பின்."}, {"id": 126, "duration_s": 1.92, "emotion": "serious", "text": "ரெண்டு - மாசம் லிமிட்."}, {"id": 127, "duration_s": 3.08, "emotion": "serious", "text": "மூணு - கார்டை எடு, ஆட்டோ-பே நிறுத்து."}, {"id": 128, "duration_s": 2.03, "emotion": "shocked", "text": "அவ்ளோ? பத்து செகண்டா?"}, {"id": 129, "duration_s": 2.01, "emotion": "pleading", "text": "அப்போ... எங்க கேம்?"}, {"id": 130, "duration_s": 2.74, "emotion": "calm", "text": "தினம் முப்பது நிமிஷம். அப்புறம் கிரிக்கெட்!"}, {"id": 131, "duration_s": 2.24, "emotion": "excited", "text": "கிரிக்கெட் முடிஞ்சதும் சமோசா?"}, {"id": 132, "duration_s": 0.92, "emotion": "worried", "text": "போன காசு?"}, {"id": 133, "duration_s": 3.06, "emotion": "calm", "text": "கம்பெனிக்கு புகார் அனுப்புவோம். இனிமே... பின்!"}, {"id": 134, "duration_s": 5.5, "emotion": "calm", "text": "குழந்தைகளுக்கு போனை விட... நம்ம துணை வேணும்."}, {"id": 135, "duration_s": 3.16, "emotion": "serious", "text": "போனுக்கு பின்... பிள்ளைகளோட நேரம்."}, {"id": 136, "duration_s": 2.793, "emotion": "laughing", "text": "பட்டம்மா போன்ல டபுள் பின்!"}, {"id": 137, "duration_s": 2.56, "emotion": "proud", "text": "நான் யாருக்கும் பயப்படமாட்டேன்! பந்தைப் போடு!"}, {"id": 138, "duration_s": 4.38, "emotion": "mischievous", "text": "இடது கை. சயின்ஸ் சொல்லுது."}, {"id": 139, "duration_s": 1.47, "emotion": "sad", "text": "ஹூம்... செருப்படி மாதிரி!"}, {"id": 140, "duration_s": 2.07, "emotion": "laughing", "text": "பட்டம்மா குறி தப்பாது!"}]