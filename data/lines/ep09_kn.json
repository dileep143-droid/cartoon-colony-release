[{"id": 1, "duration_s": 3.31, "emotion": "excited", "text": "ಮಳೆಗಾಲ... ಕಾಲೋನಿ ತುಂಬಾ ಬೋರೋ ಬೋರು!"}, {"id": 2, "duration_s": 3.03, "emotion": "excited", "text": "ಮಳೆ ಸೆಲ್ಫಿ! ಲಕ್ಷ ಲೈಕ್ಸ್ ಬರ್ತವೆ!"}, {"id": 3, "duration_s": 3.18, "emotion": "sad", "text": "ಸೊನ್ನೆ ಲೈಕ್ಸ್? ಅಮ್ಮನೂ ಒತ್ತಿಲ್ಲ!"}, {"id": 4, "duration_s": 3.43, "emotion": "proud", "text": "ಫುಡ್ ಫೋಟೋ! ಸಮೋಸಾ ಯಾವಾಗ್ಲೂ ವೈರಲ್!"}, {"id": 5, "duration_s": 1.73, "emotion": "embarrassed", "text": "ಹಸಿವಾಗಿತ್ತು!"}, {"id": 6, "duration_s": 2.31, "emotion": "excited", "text": "ಕ್ಯಾಪ್ಟನ್ ಮೊಸಳೆ ದೋಣಿ! ಸೂಪರ್ ಫಾಸ್ಟ್!"}, {"id": 7, "duration_s": 2.83, "emotion": "shocked", "text": "ಅಯ್ಯೋ! ನನ್ ಕ್ಯಾಪ್ಟನ್ ಮೊಸಳೆ!"}, {"id": 8, "duration_s": 1.49, "emotion": "stern_warning", "text": "ಚರಂಡಿ ಹತ್ರ ಹೋಗ್ಬೇಡ!"}, {"id": 9, "duration_s": 1.44, "emotion": "mischievous", "text": "ಟೆನ್ಷನ್ ಬೇಡ! ಐಡಿಯಾ!"}, {"id": 10, "duration_s": 3.53, "emotion": "mischievous", "text": "ಸ್ವಲ್ಪ ದೊಡ್ಡದು... ಇನ್ನೂ... ಸಾಕು!"}, {"id": 11, "duration_s": 2.78, "emotion": "excited", "text": "ಹತ್ತು ನಿಮಿಷ, ಹತ್ತು ಸಾವಿರ ಲೈಕ್ಸ್! ನಾನೇ ಸ್ಟಾರ್!"}, {"id": 12, "duration_s": 2.17, "emotion": "proud", "text": "ನಿಜ ಮೊಸಳೆ ಯಾರಿಗ್ಬೇಕು?"}, {"id": 13, "duration_s": 2.15, "emotion": "scared_whisper", "text": "ಕೇಳಿದ್ರಾ? ಚರಂಡೀಲಿ ಮೊಸಳೆ!"}, {"id": 14, "duration_s": 2.86, "emotion": "proud", "text": "ನಲವತ್ತು ಗ್ರೂಪ್! ಒಂದೇ ಉಸಿರು! ರೆಕಾರ್ಡ್!"}, {"id": 15, "duration_s": 3.72, "emotion": "serious", "text": "ಹತ್ತೇ ಸೆಕೆಂಡ್... ಇಡೀ ಕಾಲೋನಿಗೆ ಗೊತ್ತಾಯ್ತು."}, {"id": 16, "duration_s": 1.74, "emotion": "excited", "text": "ಹೌದು ಹೌದು! ಇಬ್ರಿಗೂ ಹೇಳ್ತಿದ್ದೀನಿ!"}, {"id": 17, "duration_s": 1.3, "emotion": "panicked", "text": "ಮೇಷ್ಟ್ರೇ! ಮೊಸಳೆ!"}, {"id": 18, "duration_s": 3.4, "emotion": "calm", "text": "ಸೊಳ್ಳೆ? ಸೊಳ್ಳೆ ಪರದೆ ಹಾಕಿ!"}, {"id": 19, "duration_s": 2.45, "emotion": "shocked", "text": "ಮೊ... ಮೊಸಳೆ?! ಅಯ್ಯೋ ನನ್ ಪಂಚೆ!"}, {"id": 20, "duration_s": 3.63, "emotion": "serious", "text": "ದೃಷ್ಟಿ ಆಯ್ತು! ಮೊಸಳೆಗೂ ನಿಂಬೆ-ಮೆಣಸಿನಕಾಯಿ!"}, {"id": 21, "duration_s": 4.5, "emotion": "proud", "text": "ವಿಜ್ಞಾನ ಹೇಳತ್ತೆ, ಮಳೆಲಿ ಮೊಸಳೆ ಚಪ್ಪಲಿ ಮಾತ್ರ ತಿನ್ನತ್ತೆ!"}, {"id": 22, "duration_s": 4.59, "emotion": "panicked", "text": "ಬಾಗಿಲು ಬಂದ್! ಕಿಟಕಿ ಬಂದ್! ಬಚ್ಚಲ ಮೋರಿನೂ ಬಂದ್!"}, {"id": 23, "duration_s": 2.15, "emotion": "excited", "text": "ಒಂದ್ ಐಡಿಯಾ ಇದೆ! ಮೊಸಳೆ ನೋಡೋಣ!"}, {"id": 24, "duration_s": 2.26, "emotion": "stern_warning", "text": "ಐಡಿಯಾ ಜೇಬಲ್ಲಿಡು. ಹೋಂವರ್ಕ್ ತೆಗಿ."}, {"id": 25, "duration_s": 2.19, "emotion": "proud", "text": "ಹೆದರ್ಬೇಡಿ! ನಂಗ್ಯಾರ ಭಯ ಇಲ್ಲ!"}, {"id": 26, "duration_s": 4.21, "emotion": "determined", "text": "ಮೊಸಳೆ ಬಂದ್ರೆ ಸಿಕ್ಸರ್! ಸೀದಾ ಪೆವಿಲಿಯನ್ನಿಗೆ!"}, {"id": 27, "duration_s": 1.23, "emotion": "comic_panic", "text": "ಮೊ... ಮೊ... ಮೊಸಳೆ ಮರಿ!"}, {"id": 28, "duration_s": 2.08, "emotion": "determined", "text": "ಸಾಕು! ಈಗ ನಾನ್ ನೋಡ್ತೀನಿ."}, {"id": 29, "duration_s": 2.65, "emotion": "scared_whisper", "text": "ಕಾವೇರಿ... ಹೋಯ್ತಾ? ನಿಜ್ವಾಗ್ಲೂ?"}, {"id": 30, "duration_s": 3.87, "emotion": "proud", "text": "ನನ್ ಮಗ ಸಿಂಹ! ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ!"}, {"id": 31, "duration_s": 2.5, "emotion": "determined", "text": "ಇವತ್ತು ರಾತ್ರಿ... ನಾನೇ ಗೇಟ್ ಕಾಯ್ತೀನಿ!"}, {"id": 32, "duration_s": 2.7, "emotion": "guilty", "text": "ಅದು... ಅಂದ್ರೆ... ಆ ಫೋಟೋ..."}, {"id": 33, "duration_s": 3.03, "emotion": "angry", "text": "ಸುಮ್ನಿರು! ಅಪಶಕುನ!"}, {"id": 34, "duration_s": 3.1, "emotion": "giggly", "text": "ಅಪ್ಪಾ... ಕಪ್ಪೆಗೆ ಹೆದರೋದಾ?"}, {"id": 35, "duration_s": 3.96, "emotion": "scared_whisper", "text": "ಮಧ್ಯರಾತ್ರಿ ಹನ್ನೆರಡು... ಹೆಗಡೆ ಮನೆ ಗೇಟ್... ಕಾವಲು."}, {"id": 36, "duration_s": 3.68, "emotion": "tired", "text": "ನಂಗ್ಯಾರ ಭಯ ಇಲ್ಲ... ನಿದ್ದೆ ಬಿಟ್ಟು."}, {"id": 37, "duration_s": 3.21, "emotion": "comic_panic", "text": "ಯಾ... ಯಾರದು? ಮುಂದೆ ಬಾ!"}, {"id": 38, "duration_s": 3.224, "emotion": "relieved", "text": "<sigh> ಬೆಕ್ಕಕ್ಕ. ಹೆದರಿಸ್ಬಿಟ್ಟೆ."}, {"id": 39, "duration_s": 0.91, "emotion": "comic_panic", "text": "ಮೊ... ಮೊ... ಮೊಸಳೆ!"}, {"id": 40, "duration_s": 4.02, "emotion": "curious", "text": "ಶಿವಣ್ಣ, ಮಧ್ಯರಾತ್ರಿ ಗೇಟಲ್ಲಿ ಯಾಕ್ ಜೋತಾಡ್ತಿದ್ದೀಯ?"}, {"id": 41, "duration_s": 3.51, "emotion": "embarrassed", "text": "ಯೋಗ ಮೇಷ್ಟ್ರೇ! ಇದಕ್ಕೆ ಗೇಟ್-ಆಸನ ಅಂತಾರೆ!"}, {"id": 42, "duration_s": 2.69, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಶಿವಣ್ಣ ಗೇಟಲ್ಲಿ ನೇತಾಡ್ತಿದ್ದಾರೆ!"}, {"id": 43, "duration_s": 3.84, "emotion": "excited", "text": "ಮೊಸಳೆ-ಪ್ರೂಫ್ ಗಮ್‌ಬೂಟ್! ಕಚ್ಚಿದ್ರೆ ಹಲ್ಲೇ ಮುರೀತು!"}, {"id": 44, "duration_s": 2.9, "emotion": "proud", "text": "ನಿನ್ನೆ ತನಕ ನೂರು. ಇವತ್ತು ಮುನ್ನೂರು!"}, {"id": 45, "duration_s": 3.2, "emotion": "sarcastic", "text": "ದಾಸಪ್ಪನವ್ರೇ, ಮೊಸಳೆಗಿಂತ ನಿಮ್ ಹಲ್ಲೇ ದೊಡ್ಡವು!"}, {"id": 46, "duration_s": 1.78, "emotion": "proud", "text": "ಒಂದ್ ರೂಪಾಯಿ ಕಡಿಮೆ ಇಲ್ಲ!"}, {"id": 47, "duration_s": 2.18, "emotion": "proud", "text": "ಇವ್ಳಿಗೊಂದಾ? ನಂಗೆರಡು!"}, {"id": 48, "duration_s": 0.79, "emotion": "angry", "text": "ನಂಗೆ ಮೂರು!"}, {"id": 49, "duration_s": 2.27, "emotion": "proud", "text": "ನಂಗೆ ನಾಲ್ಕು! ಕಾಲೋನಿ ನೋಡ್ಲಿ!"}, {"id": 50, "duration_s": 4.03, "emotion": "happy", "text": "ನಡೀರಿ ಹೋಗೋಣ! ಬರಿಗಾಲೇ ಬಹಳ ಅಗ್ಗ."}, {"id": 51, "duration_s": 2.59, "emotion": "calm", "text": "ದಾಸಪ್ಪನವ್ರೇ! ಇನ್ನೂ ತರ್ಲಾ?"}, {"id": 52, "duration_s": 7.51, "emotion": "happy", "text": "ಒಂದು, ಎರಡು, ಮೂರು... ಮತ್ತೆ ಒಂದು..."}, {"id": 53, "duration_s": 3.92, "emotion": "excited", "text": "ಬೂಟಲ್ಲಿ ಬಿಸ್ಕತ್ತು! ಏನ್ ಆಫರ್!"}, {"id": 54, "duration_s": 2.77, "emotion": "angry", "text": "ಬಿಸ್ಕತ್ತು ಬೇರೆ! ಇಪ್ಪತ್ತು ರೂಪಾಯಿ!"}, {"id": 55, "duration_s": 2.39, "emotion": "guilty", "text": "ಎಲ್ರೂ ಕೇಳಿ... ಆ ಮೊಸಳೆ ನಿಜವಾಗಿ..."}, {"id": 56, "duration_s": 2.01, "emotion": "shouting", "text": "ನೆಕ್ಸ್ಟ್! ಲೈನಲ್ಲಿ ಬನ್ನಿ!"}, {"id": 57, "duration_s": 4.69, "emotion": "serious", "text": "ಮಧ್ಯಾಹ್ನ ಎರಡು... ಮೊಸಳೆ ಬೇಟೆ, ಲೈವ್!"}, {"id": 58, "duration_s": 2.873, "emotion": "excited", "text": "ಹಲೋ ಫ್ರೆಂಡ್ಸ್! ಲೈವ್ ನಡೀತಿದೆ! ಕ್ರೋಕ್ ಹಂಟ್!"}, {"id": 59, "duration_s": 3.12, "emotion": "proud", "text": "ವಿಜ್ಞಾನ ಹೇಳತ್ತೆ, ಮೊಸಳೆ ಸೀಟಿಗೆ ಬರತ್ತೆ."}, {"id": 60, "duration_s": 3.94, "emotion": "pleading", "text": "ದಾಸಪ್ಪನವ್ರೇ, ನೀವ್ ಮುಂದೆ ಹೋಗಿ. ನೀವು... ದೊಡ್ಡವ್ರು."}, {"id": 61, "duration_s": 2.73, "emotion": "angry", "text": "ನಾನಾ? ನನ್ ಬೂಟ್ ಮುನ್ನೂರು ರೂಪಾಯಿದು!"}, {"id": 62, "duration_s": 2.71, "emotion": "pleading", "text": "ಎಲ್ರೂ ಕೇಳಿ! ಆ ಮೊಸಳೆ ನಿಜವಲ್ಲ..."}, {"id": 63, "duration_s": 1.36, "emotion": "shocked", "text": "ಅ... ಅದು ಅಲ್ಲಾಡ್ತಿದೆ!"}, {"id": 64, "duration_s": 2.15, "emotion": "panicked", "text": "ಮೊಸಳೆ!!!"}, {"id": 65, "duration_s": 0.69, "emotion": "sad", "text": "...ಇಲ್ಲ."}, {"id": 66, "duration_s": 2.47, "emotion": "surprised", "text": "ಅರೆ! ಅದು ನನ್ ಚಪ್ಪಲಿ!"}, {"id": 67, "duration_s": 2.82, "emotion": "proud", "text": "ನೋಡಿದ್ರಾ? ವಿಜ್ಞಾನ! ಮೊಸಳೆ ಉಗುಳ್ತು!"}, {"id": 68, "duration_s": 1.92, "emotion": "pleading", "text": "ಭಾಗ್ಯ! ಎಳೆ!"}, {"id": 69, "duration_s": 3.1, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಮೊಸಳೆ ಚಪ್ಪಲಿ ಉಗುಳ್ತು!"}, {"id": 70, "duration_s": 4.63, "emotion": "excited", "text": "ವ್ಯೂಸ್ ಡಬಲ್! ಚಪ್ಪಲಿನೂ ವೈರಲ್!"}, {"id": 71, "duration_s": 1.44, "emotion": "guilty", "text": "<sigh> ನನ್ ಫೋಟೋ... ಚಪ್ಪಲಿಗಿಂತ ದೊಡ್ಡದು."}, {"id": 72, "duration_s": 1.67, "emotion": "shouting", "text": "ಕಾನ್ಸ್ಟೇಬಲ್ ಸಾಹೇಬ್ರೇ! ಮೊಸಳೆ!"}, {"id": 73, "duration_s": 1.923, "emotion": "sarcastic", "text": "ಪಕೋಡಾ, ಸಾಹೇಬ್ರೇ."}, {"id": 74, "duration_s": 2.5, "emotion": "surprised", "text": "ಹ್ಞಾ? ಎಲ್ಲಿ? ತನಿಖೆ!"}, {"id": 75, "duration_s": 9.37, "emotion": "determined", "text": "ಮೊಸಳೆ ಆಗ್ಲಿ, ಅದ್ರಪ್ಪನೇ ಆಗ್ಲಿ... ತನಿಖೆ ಆಗುತ್ತೆ!"}, {"id": 76, "duration_s": 1.35, "emotion": "scared_whisper", "text": "ಶ್ಶ್... ಕಾನೂನು ಬರ್ತಿದೆ."}, {"id": 77, "duration_s": 3.02, "emotion": "comic_panic", "text": "ಮೊ...ಮೊಸಳೆ... ಚಿಕ್ಕದು... ಹಸಿರು..."}, {"id": 78, "duration_s": 0.837, "emotion": "worried", "text": "ದೃಷ್ಟಿ!"}, {"id": 79, "duration_s": 2.66, "emotion": "sarcastic", "text": "ಪಕೋಡಾ?"}, {"id": 80, "duration_s": 5.02, "emotion": "tired", "text": "ತನಿಖೆ... ಸಾಗುತ್ತೆ..."}, {"id": 81, "duration_s": 2.11, "emotion": "sad", "text": "ನನ್ ಮೊಸಳೆನೂ ಹೋಯ್ತು..."}, {"id": 82, "duration_s": 2.71, "emotion": "excited", "text": "ಐಡಿಯಾ ಇದೆ! ಹೆದರ್ಬೇಡಿ, ತನಿಖೆ ಮಾಡೋಣ!"}, {"id": 83, "duration_s": 4.22, "emotion": "serious", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ನಿಜ ಎಕ್ಸ್ಪರ್ಟ್ ಕರೀರಿ. ಅರಣ್ಯ ಇಲಾಖೆ!"}, {"id": 84, "duration_s": 0.76, "emotion": "stern_warning", "text": "ಸುಮ್ನಿರಿ!"}, {"id": 85, "duration_s": 5.881, "emotion": "serious", "text": "ಹಲೋ, ಅರಣ್ಯ ಇಲಾಖೆ? ಚರಂಡೀಲಿ ಮೊಸಳೆ... ಇರಬಹುದು."}, {"id": 86, "duration_s": 2.44, "emotion": "determined", "text": "ತಿಂಡಿ ನಾನ್ ನೋಡ್ಕೊಳ್ತೀನಿ."}, {"id": 87, "duration_s": 3.04, "emotion": "excited", "text": "ಬ್ರೇಕಿಂಗ್ ನ್ಯೂಸ್! ಕಾಲನಿ ಚರಂಡ್ಯಾಗ ಮೊಸಳಿ ಐತಿ!"}, {"id": 88, "duration_s": 3.88, "emotion": "proud", "text": "ನಮ್ ಚರಂಡಿ ಟಿವೀಲಿ! ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ!"}, {"id": 89, "duration_s": 2.41, "emotion": "comic_panic", "text": "ಟೆನ್ಷನ್ ಬೇಡ... ಟೆನ್ಷನ್ ಬೇಡ... ಟೆನ್ಷನ್ ಆಯ್ತು!"}, {"id": 90, "duration_s": 4.07, "emotion": "sarcastic", "text": "ಇಡೀ ಕಾಲೋನಿ ತಾರಸಿ ಮೇಲೆ. ರಸ್ತೇಲಿ ಎಮ್ಮೆ ಮಾತ್ರ."}, {"id": 91, "duration_s": 1.99, "emotion": "happy", "text": "ನಡೀರಿ ಹೋಗೋಣ! ಫಾರೆಸ್ಟ್ ಸಾಹೇಬ್ರು ಬಂದ್ರು!"}, {"id": 92, "duration_s": 3.21, "emotion": "tired", "text": "ಪ್ರತಿ ಸಲ! ಅತಿ ಮುಖ್ಯ ಟೈಮಲ್ಲೇ!"}, {"id": 93, "duration_s": 3.4, "emotion": "happy", "text": "ಶಭಾಷ್! ನೀನೇ ನಿಜವಾದ ಮೆಕ್ಯಾನಿಕ್!"}, {"id": 94, "duration_s": 2.44, "emotion": "serious", "text": "ಮೊಸಳೆ ಎಲ್ಲಿ ಗುರು? ತೋರ್ಸು ಮಗಾ."}, {"id": 95, "duration_s": 0.76, "emotion": "panicked", "text": "ಅಲ್ಲಿ!!!"}, {"id": 96, "duration_s": 3.61, "emotion": "scared_whisper", "text": "ಇಡೀ ಕಾಲೋನಿ ಉಸಿರು ಬಿಗಿ ಹಿಡೀತು..."}, {"id": 97, "duration_s": 2.57, "emotion": "scared_whisper", "text": "ನಂಗ್ಯಾರ ಭಯ ಇಲ್ಲ... ನಂಗೆ... ಯಾರ..."}, {"id": 98, "duration_s": 2.85, "emotion": "sarcastic", "text": "ಮೊಸಳೆ? ಇದು ರಬ್ಬರ್ದು ಗುರು!"}, {"id": 99, "duration_s": 2.61, "emotion": "shocked", "text": "ಇಷ್ಟೇ ಚಿಕ್ಕದಾ? ನನ್ ಗಮ್‌ಬೂಟ್ ಗತಿ ಏನು?"}, {"id": 100, "duration_s": 2.3, "emotion": "loving", "text": "ನನ್ ಕ್ಯಾಪ್ಟನ್ ಮೊಸಳೆ! ಸಿಕ್ತು!"}, {"id": 101, "duration_s": 2.67, "emotion": "curious", "text": "ಆದ್ರೆ ಫೋಟೋದಲ್ಲಿ ದೊಡ್ಡದಿತ್ತಲ್ಲ!"}, {"id": 102, "duration_s": 3.56, "emotion": "proud", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಈ ಫೋಟೋದಲ್ಲಿ ಮೂರು ತಪ್ಪಿವೆ."}, {"id": 103, "duration_s": 1.75, "emotion": "excited", "text": "ಫ್ಯಾಕ್ಟ್-ಚೆಕ್, ಲೈವ್ ನಡೀತಿದೆ!"}, {"id": 104, "duration_s": 3.41, "emotion": "serious", "text": "ಒಂದು: ಇದು ಬೆಕ್ಕಿನ ನೆರಳು... ಮೊಸಳೆದಲ್ಲ!"}, {"id": 105, "duration_s": 4.59, "emotion": "serious", "text": "ಎರಡು: ಮೊಸಳೆ ಚರಂಡಿಗಿಂತ ದೊಡ್ಡ! ಹೆಂಗೆ?"}, {"id": 106, "duration_s": 3.86, "emotion": "proud", "text": "ವಿಜ್ಞಾನ ಹೇಳತ್ತೆ, ಮೊಸಳೆ ಉಸಿರು ಬಿಗಿಹಿಡಿದು ಸಣ್ಣಗಾಗತ್ತೆ!"}, {"id": 107, "duration_s": 0.59, "emotion": "stern_warning", "text": "ಶ್ಶ್!"}, {"id": 108, "duration_s": 3.42, "emotion": "excited", "text": "ಮೂರು: ಬಾಲದಲ್ಲಿ ಬೊಂಡನ ಹಲ್ಲಿನ ಗುರುತು!"}, {"id": 109, "duration_s": 2.89, "emotion": "embarrassed", "text": "ಅದು... ಹಸಿವಾಗಿತ್ತು."}, {"id": 110, "duration_s": 5.06, "emotion": "sarcastic", "text": "ಮೊಸಳೆ ಕಣ್ಣೀರು ಕೇಳಿದ್ದೆ... ಮೊಸಳೆ ಫೋಟೋ ಇದೇ ಮೊದಲು!"}, {"id": 111, "duration_s": 1.71, "emotion": "serious", "text": "ಈ ಫೋಟೋ ತೆಗೆದಿದ್ದು ಯಾರು?"}, {"id": 112, "duration_s": 3.63, "emotion": "guilty", "text": "ಹೌದು... ನಾನೇ ಮಾಡಿದ್ದು. ಬರೀ ಲೈಕ್ಸ್‌ಗೋಸ್ಕರ."}, {"id": 113, "duration_s": 1.06, "emotion": "angry", "text": "ಲೈಕ್ಸ್?!"}, {"id": 114, "duration_s": 2.35, "emotion": "embarrassed", "text": "ಗೌರಮ್ಮನ ಗುರಿ... ಯಾವತ್ತೂ ತಪ್ಪಲ್ಲ."}, {"id": 115, "duration_s": 3.54, "emotion": "guilty", "text": "ನಾನೂ... ನಲವತ್ತು ಗ್ರೂಪಿಗೆ ನೋಡ್ದೇ ಕಳ್ಸಿದೆ."}, {"id": 116, "duration_s": 3.57, "emotion": "sad", "text": "ನನ್ ಮುನ್ನೂರರ ಬೂಟ್... ಇನ್ಯಾರ್ ಕೊಳ್ತಾರೆ?"}, {"id": 117, "duration_s": 2.56, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪಾ!"}, {"id": 118, "duration_s": 3.57, "emotion": "embarrassed", "text": "ಸರಿ ಸರಿ... ನೂರು ರೂಪಾಯಿ. ಹಳೇ ರೇಟು."}, {"id": 119, "duration_s": 3.17, "emotion": "tired", "text": "ನಾನು ರಾತ್ರಿ ಪೂರ್ತಿ ಗೇಟ್-ಆಸನ ಮಾಡ್ದೆ!"}, {"id": 120, "duration_s": 4.02, "emotion": "determined", "text": "ಸಾಕು! ಈಗ ನಾನ್ ನೋಡ್ತೀನಿ. ಚರಂಡಿ ಫೇಮಸ್ ಮಾಡಿದೋನು..."}, {"id": 121, "duration_s": 1.07, "emotion": "stern_warning", "text": "...ಅವ್ನೇ ಸ್ವಚ್ಛ ಮಾಡ್ಲಿ!"}, {"id": 122, "duration_s": 4.301, "emotion": "tired", "text": "ಟೆನ್ಷನ್ ಬೇಡ... ಟೆನ್ಷನ್ ಜಾಸ್ತಿ."}, {"id": 123, "duration_s": 3.62, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ಚರಂಡಿ ಸ್ವಚ್ಛತೆ, ಎಪಿಸೋಡ್ ಒಂದು!"}, {"id": 124, "duration_s": 2.54, "emotion": "serious", "text": "ತಿದ್ದುಪಡಿ ನಲವತ್ತು ಗ್ರೂಪಿಗೆ ಹೋಗುತ್ತೆ... ಮೊದ್ಲು ಚೆಕ್!"}, {"id": 125, "duration_s": 2.3, "emotion": "curious", "text": "ಇದ್ರಲ್ಲಿ ಬಿಸ್ಕತ್ತಿದ್ಯಾ?"}, {"id": 126, "duration_s": 2.59, "emotion": "excited", "text": "ನನ್ ಚಪ್ಪಲಿ! ನೋಡಿದ್ರಾ? ವಿಜ್ಞಾನ!"}, {"id": 127, "duration_s": 5.4, "emotion": "serious", "text": "ತನಿಖೆ... ಮುಗೀತು. ಕೇಸ್ ಕ್ಲೋಸ್."}, {"id": 128, "duration_s": 5.24, "emotion": "calm", "text": "ಸಂಜೆಯಾಯ್ತು, ಮಳೆ ನಿಂತಿತು... ಚರಂಡಿ ಥಳಥಳ ಹೊಳೆಯಿತು."}, {"id": 129, "duration_s": 4.63, "emotion": "calm", "text": "ಒಂದು ನಕಲಿ ಫೋಟೋ... ಇಡೀ ಕಾಲೋನಿ ತಾರಸಿ ಮೇಲೆ."}, {"id": 130, "duration_s": 2.95, "emotion": "guilty", "text": "ಅಜ್ಜಾ, ಸುಮ್ನೆ ತಮಾಷೆಗೆ..."}, {"id": 131, "duration_s": 4.43, "emotion": "serious", "text": "ತಮಾಷೆ ನಿಂದು. ಭಯ ಇಡೀ ಕಾಲೋನಿದು."}, {"id": 132, "duration_s": 2.64, "emotion": "curious", "text": "ಹಾಗಾದ್ರೆ ನಿಜ ಹೇಗೆ ಗೊತ್ತಾಗುತ್ತೆ ಅಜ್ಜಾ?"}, {"id": 133, "duration_s": 4.49, "emotion": "serious", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಯಾರ್ ಕಳಿಸಿದ್ರು, ನೆರಳು, ಅಳತೆ - ಮೊದ್ಲು ಚೆಕ್ ಮಾಡಿ."}, {"id": 134, "duration_s": 3.46, "emotion": "stern_warning", "text": "ಅನುಮಾನ ಇದ್ರೆ ಕಳಿಸ್ಬೇಡಿ! ಸುಳ್ಳು ರಿಪೋರ್ಟ್ ಮಾಡಿ!"}, {"id": 135, "duration_s": 2.42, "emotion": "serious", "text": "ಫಾರ್ವರ್ಡ್ ಮುಂಚೆ ಯೋಚಿಸಿ..."}, {"id": 136, "duration_s": 4.58, "emotion": "tender", "text": "...ಇಲ್ದಿದ್ರೆ ಒಂದಿನ ನಿಜನೂ ಸುಳ್ಳು ಅನ್ಸುತ್ತೆ."}, {"id": 137, "duration_s": 4.29, "emotion": "relieved", "text": "ಅಬ್ಬಾ! ಇನ್ನು ಮೊಸಳೆ-ಗೀಸಳೆ ಇಲ್ಲ."}, {"id": 138, "duration_s": 2.27, "emotion": "excited", "text": "ಅಪ್ಪಾ! ಚರಂಡೀಲಿ ನಿಜ್ವಾಗ್ಲೂ ಏನೋ ಇದೆ!"}, {"id": 139, "duration_s": 2.35, "emotion": "sarcastic", "text": "ಹೂಂ ಹೂಂ... ಮೊಸಳೆ. ಸಾಕು ಬಿಡು."}, {"id": 140, "duration_s": 1.16, "emotion": "comic_panic", "text": "ನಂಗ್ಯಾರ ಭಯ ಇಲ್ಲ!"}]