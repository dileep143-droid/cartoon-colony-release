[{"id": 1, "duration_s": 4.52, "emotion": "calm", "text": "રવિવારની સાંજ. શાહભાઈના ઘરે સત્યનારાયણની કથા."}, {"id": 2, "duration_s": 2.48, "emotion": "excited", "text": "કેળા કિંગડમ! ઊ ઊ આ આ!"}, {"id": 3, "duration_s": 1.67, "emotion": "excited", "text": "ખાલી નવ્વાણું રૂપરડી!"}, {"id": 4, "duration_s": 2.27, "emotion": "shocked", "text": "ફરી કપાયા?!"}, {"id": 5, "duration_s": 0.55, "emotion": "embarrassed", "text": "ઊ ઊ આ આ?"}, {"id": 6, "duration_s": 3.2, "emotion": "mischievous", "text": "આ બધું શરૂ થયું... ત્રણ દિવસ પહેલાં."}, {"id": 7, "duration_s": 2.05, "emotion": "mischievous", "text": "એક કેળાવાળી ગેમથી."}, {"id": 8, "duration_s": 3.02, "emotion": "angry", "text": "પિન્ટુ! આ ફોન 'ગુડ મોર્નિંગ' મોકલતો જ નથી!"}, {"id": 9, "duration_s": 2.22, "emotion": "proud", "text": "થઈ ગયું. ચૌદ ગ્રુપમાં મોકલી દીધું."}, {"id": 10, "duration_s": 1.97, "emotion": "proud", "text": "આખી સોસાયટી જોશે!"}, {"id": 11, "duration_s": 1.98, "emotion": "excited", "text": "બા! એમાં વાંદરાવાળી ગેમ છે!"}, {"id": 12, "duration_s": 4.36, "emotion": "tired", "text": "પાંચ મિનિટ રમો. હું બસ આંખ મીંચીને..."}, {"id": 13, "duration_s": 2.63, "emotion": "excited", "text": "કેળા કિંગડમમાં આવકાર સે!"}, {"id": 14, "duration_s": 3.49, "emotion": "excited", "text": "કેળાં ખૂટ્યાં સે! ખાલી નવ્વાણુંમાં સો કેળાં!"}, {"id": 15, "duration_s": 2.79, "emotion": "curious", "text": "નવ્વાણું રૂપિયા? સાચ્ચા વાળા?"}, {"id": 16, "duration_s": 3.14, "emotion": "mischievous", "text": "ડોબા! ગેમના પૈસા તો નકલી હોય!"}, {"id": 17, "duration_s": 1.69, "emotion": "mischievous", "text": "એક આઈડિયા છે!"}, {"id": 18, "duration_s": 2.64, "emotion": "excited", "text": "અવાજ સાંભળ્યો? આપણને પૈસા મળે છે!"}, {"id": 19, "duration_s": 2.88, "emotion": "laughing", "text": "બીજો! હા હા હા! બીજો!"}, {"id": 20, "duration_s": 2.59, "emotion": "happy", "text": "આખી સોસાયટી... જોશે..."}, {"id": 21, "duration_s": 3.69, "emotion": "excited", "text": "શાબાશ ગગા! તું સે કેળા કિંગડમનો રાજા!"}, {"id": 22, "duration_s": 3.02, "emotion": "calm", "text": "એ જ સવારે. ઓટલે જયેશભાઈનો આરામ."}, {"id": 23, "duration_s": 5.12, "emotion": "proud", "text": "મારું બેંક ખાતું... લોખંડની તિજોરી, લાલા!"}, {"id": 24, "duration_s": 1.22, "emotion": "sarcastic", "text": "અંદર કંઈ છે?"}, {"id": 25, "duration_s": 4.05, "emotion": "neutral", "text": "નવ્વાણું કપાયા? ચાલો... ચાનો ખર્ચો."}, {"id": 26, "duration_s": 3.99, "emotion": "shocked", "text": "ચારસો નવ્વાણું?!"}, {"id": 27, "duration_s": 1.47, "emotion": "curious", "text": "ભાઈ, તિજોરીમાં બાકોરું!"}, {"id": 28, "duration_s": 4.66, "emotion": "panicked", "text": "નવસો નવ્વાણું! આ ચોર નથી... ડાકુ છે!"}, {"id": 29, "duration_s": 1.84, "emotion": "excited", "text": "ટેન્શન ના લો! ફોન જ વેચી દો!"}, {"id": 30, "duration_s": 3.03, "emotion": "determined", "text": "હું કોઈથી નથી ડરતો! એ ચોરને હું..."}, {"id": 31, "duration_s": 0.86, "emotion": "comic_panic", "text": "ગ... ગ... ગરોળી!"}, {"id": 32, "duration_s": 2.57, "emotion": "sarcastic", "text": "કોઈથી નથી ડરતા? ગરોળીથી પણ નહીં?"}, {"id": 33, "duration_s": 3.13, "emotion": "embarrassed", "text": "એ... ચોરની જાસૂસ હતી! ખુફિયા!"}, {"id": 34, "duration_s": 2.12, "emotion": "calm", "text": "બસ! હવે હું જોઉં છું—"}, {"id": 35, "duration_s": 2.48, "emotion": "shouting", "text": "ના! આ પોલીસ કેસ છે!"}, {"id": 36, "duration_s": 4.62, "emotion": "scared_whisper", "text": "હેલો, ચોકી? મારું ખાતું... લૂંટાય છે!"}, {"id": 37, "duration_s": 5.19, "emotion": "serious", "text": "તપાસ થશે! પૂરી તપાસ થશે!"}, {"id": 38, "duration_s": 4.325, "emotion": "panicked", "text": "સાહેબ, ચોર દેખાતો નથી... બસ પૈસા કાપે છે!"}, {"id": 39, "duration_s": 3.8, "emotion": "curious", "text": "હમ્મ... સગડની સુગંધ."}, {"id": 40, "duration_s": 7.109, "emotion": "serious", "text": "ચોર ક્યારે આવે? શું પહેરે? ચટણી ક્યાં છે?"}, {"id": 41, "duration_s": 1.48, "emotion": "embarrassed", "text": "ભૂખ લાગી છે!"}, {"id": 42, "duration_s": 4.24, "emotion": "serious", "text": "લખો... ચોર... ભૂખ્યો છે."}, {"id": 43, "duration_s": 2.45, "emotion": "curious", "text": "ભૂખ્યો? એ કેમ ખબર પડી?"}, {"id": 44, "duration_s": 1.66, "emotion": "proud", "text": "ભજિયાં ખલાસ થઈ ગયાં!"}, {"id": 45, "duration_s": 2.04, "emotion": "pleading", "text": "સાહેબ? સાહેબ! ચોર!"}, {"id": 46, "duration_s": 2.03, "emotion": "sarcastic", "text": "એક ભજિયું વધારે?"}, {"id": 47, "duration_s": 2.009, "emotion": "excited", "text": "તપાસ થશે!"}, {"id": 48, "duration_s": 5.42, "emotion": "serious", "text": "ચોકીએ જઈને રિપોર્ટ ખાઈશ. એટલે કે... લખીશ."}, {"id": 49, "duration_s": 6.311, "emotion": "sad", "text": "હાય! ચોર ભૂખ્યો... હવાલદાર પણ ભૂખ્યો."}, {"id": 50, "duration_s": 3.94, "emotion": "mischievous", "text": "એક કલાકમાં... ખબર આખી સોસાયટીમાં."}, {"id": 51, "duration_s": 2.56, "emotion": "excited", "text": "સાંભળ્યું કે? જયેશના ફોનમાં ચોર!"}, {"id": 52, "duration_s": 2.15, "emotion": "scared_whisper", "text": "સાંભળ્યું કે? ચોર અદૃશ્ય છે!"}, {"id": 53, "duration_s": 2.0, "emotion": "shocked", "text": "સાંભળ્યું કે? ચોર વાંદરો છે!"}, {"id": 54, "duration_s": 1.95, "emotion": "proud", "text": "સાયન્સ કહે છે..."}, {"id": 55, "duration_s": 1.63, "emotion": "serious", "text": "ચોર... ડાબોડી છે!"}, {"id": 56, "duration_s": 0.93, "emotion": "curious", "text": "કેમ ખબર?"}, {"id": 57, "duration_s": 2.06, "emotion": "proud", "text": "પૈસા હંમેશાં ડાબા હાથે જાય!"}, {"id": 58, "duration_s": 1.37, "emotion": "stern_warning", "text": "ચીમન શેઠ!"}, {"id": 59, "duration_s": 4.24, "emotion": "serious", "text": "મારો ડાબો હાથ ફક્ત ગણે છે. એક રૂપિયો પણ ઓછો નહીં!"}, {"id": 60, "duration_s": 3.8, "emotion": "serious", "text": "નજર લાગી ગઈ! દરેક ફોનને લીંબુ-મરચું!"}, {"id": 61, "duration_s": 2.39, "emotion": "excited", "text": "લાઈવ ચાલે છે! સોસાયટીમાં ચોર!"}, {"id": 62, "duration_s": 4.12, "emotion": "determined", "text": "ચાલો, જલદી! ચોર પકડવા!"}, {"id": 63, "duration_s": 1.35, "emotion": "embarrassed", "text": "હાય... ચોર ચાલતા પકડીશું."}, {"id": 64, "duration_s": 3.02, "emotion": "comic_panic", "text": "ઓગણીસસો નવ્વાણું! હમણાં! અહીં જ!"}, {"id": 65, "duration_s": 1.6, "emotion": "shocked", "text": "ચોર આપણા વચ્ચે છે!"}, {"id": 66, "duration_s": 1.58, "emotion": "shouting", "text": "તમે! ના, તમે!"}, {"id": 67, "duration_s": 0.58, "emotion": "shouting", "text": "ચૂપ!"}, {"id": 68, "duration_s": 2.66, "emotion": "curious", "text": "હું કહું? ચોર કદાચ ઘરનો જ..."}, {"id": 69, "duration_s": 0.89, "emotion": "shouting", "text": "ના!"}, {"id": 70, "duration_s": 1.74, "emotion": "sarcastic", "text": "છોકરાંને સાયન્સ ના સમજાય!"}, {"id": 71, "duration_s": 3.68, "emotion": "scared_whisper", "text": "રાતના બે વાગ્યે. આખી સોસાયટી ઊંઘે છે..."}, {"id": 72, "duration_s": 1.14, "emotion": "mischievous", "text": "...લગભગ આખી."}, {"id": 73, "duration_s": 2.95, "emotion": "scared_whisper", "text": "બસ એક લેવલ વધારે... પછી સૂઈ જઈશ."}, {"id": 74, "duration_s": 2.21, "emotion": "scared_whisper", "text": "શશ્શ! વાંદરો ભૂખ્યો છે."}, {"id": 75, "duration_s": 2.01, "emotion": "scared_whisper", "text": "ચોર... ઘરની અંદર છે!"}, {"id": 76, "duration_s": 1.77, "emotion": "scared_whisper", "text": "હું કોઈથી નથી ડરતો... હું કોઈથી..."}, {"id": 77, "duration_s": 1.37, "emotion": "scared_whisper", "text": "કોણ છે? હાથ ઉપર!"}, {"id": 78, "duration_s": 2.2, "emotion": "angry", "text": "રાતે ટોર્ચ?! ચંપલ!"}, {"id": 79, "duration_s": 1.82, "emotion": "embarrassed", "text": "બા... તમે કોઈ ચોર જોયો?"}, {"id": 80, "duration_s": 3.663, "emotion": "tired", "text": "ચોર? અહીં તો બસ હું છું."}, {"id": 81, "duration_s": 0.96, "emotion": "relieved", "text": "હા... તમે તો ઊંઘો છો."}, {"id": 82, "duration_s": 3.38, "emotion": "serious", "text": "સોસાયટીમાં ચોર ફરે છે. એક રૂપિયો પણ ઓછો નહીં!"}, {"id": 83, "duration_s": 0.83, "emotion": "excited", "text": "ટેન્શન ના લો!"}, {"id": 84, "duration_s": 3.39, "emotion": "mischievous", "text": "ગેમ હેક! અનલિમિટેડ કેળાં! બસો રૂપિયામાં!"}, {"id": 85, "duration_s": 2.31, "emotion": "curious", "text": "બસો નથી... બે સમોસા છે."}, {"id": 86, "duration_s": 1.51, "emotion": "happy", "text": "ચાલશે! ડીલ પાક્કી!"}, {"id": 87, "duration_s": 1.67, "emotion": "shocked", "text": "અરે! પેમેન્ટ જ ખાઈ ગયો!"}, {"id": 88, "duration_s": 2.41, "emotion": "stern_warning", "text": "ગેમ હેક? બતાવું સાચું હેક?"}, {"id": 89, "duration_s": 2.37, "emotion": "pleading", "text": "હંસા ભાભી, સમાજસેવા!"}, {"id": 90, "duration_s": 2.64, "emotion": "excited", "text": "બસો? એમાં મારા દસ ટકા!"}, {"id": 91, "duration_s": 1.28, "emotion": "stern_warning", "text": "ચીમન શેઠ!"}, {"id": 92, "duration_s": 2.29, "emotion": "happy", "text": "હેક જોરદાર હતો."}, {"id": 93, "duration_s": 6.35, "emotion": "calm", "text": "ત્રણ દિવસ પછી. એ જ પૂજા... જ્યાંથી શરૂ કર્યું હતું."}, {"id": 94, "duration_s": 3.02, "emotion": "scared_whisper", "text": "આજે કોઈ ખર્ચો નહીં થાય. આજે પૂજા છે."}, {"id": 95, "duration_s": 3.76, "emotion": "scared_whisper", "text": "લાઈવ ચાલે છે! શાહ પૂજા, એક્સક્લુઝિવ!"}, {"id": 96, "duration_s": 5.21, "emotion": "serious", "text": "અને પછી લીલાવતીએ... પ્રસાદ ન ખાધો."}, {"id": 97, "duration_s": 1.26, "emotion": "curious", "text": "આ કયો અધ્યાય છે?"}, {"id": 98, "duration_s": 4.49, "emotion": "excited", "text": "આ... નવું ભજન છે! કેળા ભજન!"}, {"id": 99, "duration_s": 0.9, "emotion": "shocked", "text": "નજર લાગી ગઈ!"}, {"id": 100, "duration_s": 2.63, "emotion": "excited", "text": "સાંભળ્યું કે? કાંતા બાનું ડિસ્કો ભજન!"}, {"id": 101, "duration_s": 2.61, "emotion": "excited", "text": "આભાર બાપુ! નવ્વાણું રૂપિયા!"}, {"id": 102, "duration_s": 1.13, "emotion": "shocked", "text": "ફરી કપાયા?!"}, {"id": 103, "duration_s": 1.84, "emotion": "embarrassed", "text": "ઊ ઊ આ આ?"}, {"id": 104, "duration_s": 1.49, "emotion": "shouting", "text": "તપાસ થશે!"}, {"id": 105, "duration_s": 0.79, "emotion": "shocked", "text": "કાંતા બા?!"}, {"id": 106, "duration_s": 0.64, "emotion": "curious", "text": "હું કહું?"}, {"id": 107, "duration_s": 0.94, "emotion": "shouting", "text": "કહો!"}, {"id": 108, "duration_s": 3.42, "emotion": "serious", "text": "નવ્વાણું... ચારસો નવ્વાણું... નવસો નવ્વાણું..."}, {"id": 109, "duration_s": 3.34, "emotion": "serious", "text": "બધું આ જ ફોનથી. પેમેન્ટ જયેશકાકાના કાર્ડથી."}, {"id": 110, "duration_s": 2.74, "emotion": "shocked", "text": "મારું કાર્ડ? બાના ફોનમાં?"}, {"id": 111, "duration_s": 3.39, "emotion": "sarcastic", "text": "તેં જ નાખ્યું હતું! લાઈટબિલ ભરવા!"}, {"id": 112, "duration_s": 2.98, "emotion": "sad", "text": "હાય... અને કાઢવું ભૂલ્યો."}, {"id": 113, "duration_s": 4.11, "emotion": "guilty", "text": "પપ્પા... પહેલાં નવ્વાણું... મેં દબાવ્યા."}, {"id": 114, "duration_s": 3.96, "emotion": "guilty", "text": "અને ચારસો નવ્વાણું... અમે બંનેએ."}, {"id": 115, "duration_s": 2.01, "emotion": "guilty", "text": "અમને થયું ગેમના પૈસા નકલી છે."}, {"id": 116, "duration_s": 4.43, "emotion": "serious", "text": "પૈસા અસલી હતા. બસ કેળાં નકલી હતાં."}, {"id": 117, "duration_s": 3.25, "emotion": "guilty", "text": "અને રાતે બે વાગ્યાવાળા... મેં."}, {"id": 118, "duration_s": 2.09, "emotion": "shocked", "text": "રાતે બે વાગ્યે?!"}, {"id": 119, "duration_s": 1.79, "emotion": "pleading", "text": "વાંદરો ભૂખ્યો હતો!"}, {"id": 120, "duration_s": 4.59, "emotion": "proud", "text": "જોયું! મેં કહ્યું હતું, ચોર ભૂખ્યો છે!"}, {"id": 121, "duration_s": 3.61, "emotion": "proud", "text": "અને કાંતા બા ડાબોડી છે! સાયન્સ કહે છે!"}, {"id": 122, "duration_s": 3.11, "emotion": "excited", "text": "સાંભળ્યું કે? ચોર... કાંતા બા નીકળ્યાં!"}, {"id": 123, "duration_s": 2.89, "emotion": "proud", "text": "હવે હું સંભાળું છું! હું કોઈથી—"}, {"id": 124, "duration_s": 1.76, "emotion": "determined", "text": "બસ! હવે હું જોઉં છું."}, {"id": 125, "duration_s": 1.37, "emotion": "serious", "text": "એક - દરેક પેમેન્ટ પર પિન."}, {"id": 126, "duration_s": 1.6, "emotion": "serious", "text": "બે - મહિનાની લિમિટ."}, {"id": 127, "duration_s": 3.35, "emotion": "serious", "text": "ત્રણ - કાર્ડ કાઢો, ઓટો-પે બંધ."}, {"id": 128, "duration_s": 2.24, "emotion": "shocked", "text": "બસ? દસ સેકન્ડમાં?"}, {"id": 129, "duration_s": 1.97, "emotion": "pleading", "text": "અને... અમારી ગેમ?"}, {"id": 130, "duration_s": 3.19, "emotion": "calm", "text": "રોજ ત્રીસ મિનિટ. પછી બહાર ક્રિકેટ!"}, {"id": 131, "duration_s": 1.55, "emotion": "excited", "text": "ક્રિકેટ પછી સમોસા?"}, {"id": 132, "duration_s": 1.49, "emotion": "worried", "text": "અને જે પૈસા ગયા?"}, {"id": 133, "duration_s": 3.76, "emotion": "calm", "text": "કંપનીને ફરિયાદ કરીશું. અને હવે પછી... પિન!"}, {"id": 134, "duration_s": 4.767, "emotion": "calm", "text": "બાળકોને ફોન કરતાં વધુ... આપણો સાથ જોઈએ."}, {"id": 135, "duration_s": 4.43, "emotion": "serious", "text": "ફોનમાં પિન... બાળકો સાથે સમય."}, {"id": 136, "duration_s": 2.82, "emotion": "laughing", "text": "અને બાના ફોનમાં ડબલ પિન!"}, {"id": 137, "duration_s": 2.4, "emotion": "proud", "text": "હું કોઈથી નથી ડરતો! ફેંકો બોલ!"}, {"id": 138, "duration_s": 3.688, "emotion": "mischievous", "text": "ડાબોડી. સાયન્સ કહે છે."}, {"id": 139, "duration_s": 2.178, "emotion": "sad", "text": "હાય... સાવ ચંપલ જેવો."}, {"id": 140, "duration_s": 1.35, "emotion": "laughing", "text": "બા કદી નથી ચૂકતાં!"}]