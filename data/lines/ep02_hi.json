[{"id": 1, "duration_s": 4.76, "emotion": "mischievous", "text": "ये है हमारी कॉलोनी, और उसकी सबसे बड़ी टंकी।"}, {"id": 2, "duration_s": 3.11, "emotion": "mischievous", "text": "इस टंकी में... एक भूत रहता है! ऊऊऊ!"}, {"id": 3, "duration_s": 4.04, "emotion": "curious", "text": "भूत नहीं होते। मैं बताऊँ?"}, {"id": 4, "duration_s": 0.44, "emotion": "stern_warning", "text": "चुप!"}, {"id": 5, "duration_s": 4.1, "emotion": "mischievous", "text": "मेरा ख़ज़ाना... यहाँ कोई नहीं ढूँढेगा।"}, {"id": 6, "duration_s": 2.37, "emotion": "sarcastic", "text": "तुम्हारा भूत... टॉर्च से डरता है।"}, {"id": 7, "duration_s": 2.31, "emotion": "mischievous", "text": "भूत असली है! आज रात देखना!"}, {"id": 8, "duration_s": 1.79, "emotion": "calm", "text": "बच्चो! खाना तैयार है!"}, {"id": 9, "duration_s": 3.29, "emotion": "giggly", "text": "लड्डू पहले ही पहुँच गया।"}, {"id": 10, "duration_s": 5.43, "emotion": "scared_whisper", "text": "और फिर... रात के ठीक बारह बजे..."}, {"id": 11, "duration_s": 1.18, "emotion": "scared_whisper", "text": "भ... भ... भूत!"}, {"id": 12, "duration_s": 2.1, "emotion": "panicked", "text": "नज़र लग गई... टंकी को!"}, {"id": 13, "duration_s": 2.7, "emotion": "scared_whisper", "text": "गुप्ता! उठ! टंकी में भूत!"}, {"id": 14, "duration_s": 3.38, "emotion": "comic_panic", "text": "निम्बू! मिर्ची! निम्बू! मिर्ची!"}, {"id": 15, "duration_s": 2.37, "emotion": "excited", "text": "हाँ चम्पा? भूत? <gasp> सच में?"}, {"id": 16, "duration_s": 1.64, "emotion": "excited", "text": "सुना क्या? टंकी में भूत है!"}, {"id": 17, "duration_s": 3.37, "emotion": "mischievous", "text": "दस सेकंड में... पूरी कॉलोनी को पता था।"}, {"id": 18, "duration_s": 2.14, "emotion": "excited", "text": "हेलो दोस्तो! लाइव चल रहा है!"}, {"id": 19, "duration_s": 3.0, "emotion": "excited", "text": "भूत लाइव! दो लाख व्यूअर्स!"}, {"id": 20, "duration_s": 1.79, "emotion": "scared_whisper", "text": "भूत जी, एक सेल्फ़ी प्लीज़?"}, {"id": 21, "duration_s": 3.482, "emotion": "proud", "text": "साइंस कहता है... भूत वाई-फ़ाई से आता है!"}, {"id": 22, "duration_s": 2.32, "emotion": "proud", "text": "वाई-फ़ाई बंद। भूत ख़त्म।"}, {"id": 23, "duration_s": 3.28, "emotion": "serious", "text": "सुर ग़लत है। दस में से चार।"}, {"id": 24, "duration_s": 2.2, "emotion": "happy", "text": "हाँ! अब सात!"}, {"id": 25, "duration_s": 1.56, "emotion": "proud", "text": "भूत-वूत कुछ नहीं होता!"}, {"id": 26, "duration_s": 1.4, "emotion": "proud", "text": "मैं किसी से नहीं डरता!"}, {"id": 27, "duration_s": 2.93, "emotion": "sarcastic", "text": "कल छिपकली देखकर अलमारी पर कौन चढ़ा था?"}, {"id": 28, "duration_s": 3.18, "emotion": "embarrassed", "text": "वो... अलमारी की धूल देख रहा था।"}, {"id": 29, "duration_s": 2.87, "emotion": "proud", "text": "जा बेटा! पूरी कॉलोनी देखेगी!"}, {"id": 30, "duration_s": 3.5, "emotion": "scared_whisper", "text": "ओ भूत जी... मैं तो बस... टहलने आया था।"}, {"id": 31, "duration_s": 3.309, "emotion": "sarcastic", "text": "आ गए? टहलना हो गया?"}, {"id": 32, "duration_s": 3.12, "emotion": "scared_whisper", "text": "हाँ... बहुत... अच्छी हवा है।"}, {"id": 33, "duration_s": 2.6, "emotion": "guilty", "text": "मैंने तो बस... मज़ाक किया था।"}, {"id": 34, "duration_s": 2.81, "emotion": "mischievous", "text": "टेंशन मत लो! भूत है... तो बिज़नेस है!"}, {"id": 35, "duration_s": 5.31, "emotion": "mischievous", "text": "अगली सुबह... कॉलोनी डरी हुई थी। सेठ जी ख़ुश थे।"}, {"id": 36, "duration_s": 2.11, "emotion": "comic_panic", "text": "भूत वाला पानी? ना बाबा ना!"}, {"id": 37, "duration_s": 1.86, "emotion": "sarcastic", "text": "तो चाय किससे बनाऊँ?"}, {"id": 38, "duration_s": 2.81, "emotion": "proud", "text": "एक बाल्टी, दो रुपये! लाइन में!"}, {"id": 39, "duration_s": 2.43, "emotion": "serious", "text": "कुत्ते का भी दो रुपये।"}, {"id": 40, "duration_s": 1.62, "emotion": "proud", "text": "एक रुपया भी कम नहीं!"}, {"id": 41, "duration_s": 2.9, "emotion": "stern_warning", "text": "सेठ जी! घरवालों से भी पैसे?"}, {"id": 42, "duration_s": 3.23, "emotion": "embarrassed", "text": "घरवालों को... आधे दाम।"}, {"id": 43, "duration_s": 2.54, "emotion": "comic_panic", "text": "लड्डू! ये चालीस बाल्टी हो गईं!"}, {"id": 44, "duration_s": 2.39, "emotion": "happy", "text": "प्यास भी लगी थी।"}, {"id": 45, "duration_s": 1.69, "emotion": "happy", "text": "चलो, चलते हैं! पानी लाने!"}, {"id": 46, "duration_s": 1.24, "emotion": "sad", "text": "आज भी नहीं, रानी?"}, {"id": 47, "duration_s": 2.75, "emotion": "excited", "text": "सुना क्या? भूत ने रात मेरा नाम लिया!"}, {"id": 48, "duration_s": 1.69, "emotion": "proud", "text": "हुँह! मेरा तो दो बार लिया!"}, {"id": 49, "duration_s": 3.84, "emotion": "proud", "text": "साइंस कहता है... भूत को ठंडा पानी पसंद है।"}, {"id": 50, "duration_s": 0.55, "emotion": "stern_warning", "text": "चुप!"}, {"id": 51, "duration_s": 1.85, "emotion": "curious", "text": "मैं बताऊँ? बाद में।"}, {"id": 52, "duration_s": 2.974, "emotion": "excited", "text": "भाइयो-बहनो! भूत की टेंशन? टेंशन मत लो!"}, {"id": 53, "duration_s": 3.02, "emotion": "proud", "text": "पेश हैं... तांत्रिक टिंगू बाबा!"}, {"id": 54, "duration_s": 5.052, "emotion": "serious", "text": "अलख निरंजन! भूत... बहुत बड़ा है।"}, {"id": 55, "duration_s": 3.08, "emotion": "embarrassed", "text": "हे हे... ये बाबा का... उल्टा योग है!"}, {"id": 56, "duration_s": 1.97, "emotion": "curious", "text": "दाढ़ी... उल्टी है।"}, {"id": 57, "duration_s": 0.83, "emotion": "serious", "text": "नोट करो!"}, {"id": 58, "duration_s": 4.65, "emotion": "proud", "text": "भूत-प्रूफ़ निम्बू! सिर्फ़ पाँच सौ!"}, {"id": 59, "duration_s": 2.48, "emotion": "shocked", "text": "पाँच सौ? मेरी दुकान में दो का है!"}, {"id": 60, "duration_s": 0.94, "emotion": "comic_panic", "text": "दो दे दो! जल्दी!"}, {"id": 61, "duration_s": 2.78, "emotion": "excited", "text": "बाबा, मुझे निम्बू-मिर्ची वाला कॉम्बो!"}, {"id": 62, "duration_s": 1.98, "emotion": "proud", "text": "आठ निम्बू! पूरे आठ!"}, {"id": 63, "duration_s": 4.01, "emotion": "proud", "text": "आठ? हुँह! दस दो! पूरी कॉलोनी देखेगी!"}, {"id": 64, "duration_s": 1.2, "emotion": "happy", "text": "दस! और एक फ़्री!"}, {"id": 65, "duration_s": 2.04, "emotion": "angry", "text": "हैलो? बाबा जी, बारह मिलेंगे?"}, {"id": 66, "duration_s": 1.73, "emotion": "proud", "text": "अब मैं किसी से नहीं डरता!"}, {"id": 67, "duration_s": 0.99, "emotion": "sarcastic", "text": "छिपकली से भी?"}, {"id": 68, "duration_s": 1.26, "emotion": "sarcastic", "text": "बहुत काम आए निम्बू।"}, {"id": 69, "duration_s": 2.5, "emotion": "sarcastic", "text": "पाँच हज़ार के निम्बू, पिताजी!"}, {"id": 70, "duration_s": 2.16, "emotion": "calm", "text": "शिकंजी अच्छी बनेगी।"}, {"id": 71, "duration_s": 4.04, "emotion": "mischievous", "text": "शाम तक कॉलोनी में लोग कम, निम्बू ज़्यादा थे।"}, {"id": 72, "duration_s": 2.41, "emotion": "mischievous", "text": "आज रात एक ज़ोरदार 'ऊऊऊ' चाहिए।"}, {"id": 73, "duration_s": 3.409, "emotion": "mischievous", "text": "हवा चली... तो डबल धंधा!"}, {"id": 74, "duration_s": 7.19, "emotion": "mischievous", "text": "रात को... पूरी कॉलोनी दादाजी के आँगन में।"}, {"id": 75, "duration_s": 3.299, "emotion": "tired", "text": "जाँच... होगी... खर्र्र..."}, {"id": 76, "duration_s": 2.98, "emotion": "serious", "text": "साइंस कहता है, भूत ठीक बारह बजे आता है।"}, {"id": 77, "duration_s": 2.76, "emotion": "tired", "text": "अभी साढ़े ग्यारह हैं। सो जाओ।"}, {"id": 78, "duration_s": 2.402, "emotion": "angry", "text": "सुना क्या? चोरी!"}, {"id": 79, "duration_s": 3.34, "emotion": "guilty", "text": "ये सब... मेरी कहानी की वजह से।"}, {"id": 80, "duration_s": 1.39, "emotion": "serious", "text": "चुप! सुनो।"}, {"id": 81, "duration_s": 3.66, "emotion": "shouting", "text": "कौन है? जाँच होगी!"}, {"id": 82, "duration_s": 2.61, "emotion": "excited", "text": "वाह! दस में से दस!"}, {"id": 83, "duration_s": 1.64, "emotion": "comic_panic", "text": "भूत! भूत! भूत!"}, {"id": 84, "duration_s": 2.11, "emotion": "panicked", "text": "भूत!"}, {"id": 85, "duration_s": 1.88, "emotion": "comic_panic", "text": "मैं हूँ! रमेश!"}, {"id": 86, "duration_s": 1.17, "emotion": "panicked", "text": "भूत बोल भी रहा है!"}, {"id": 87, "duration_s": 1.93, "emotion": "determined", "text": "भूत? मेरी चप्पल देख!"}, {"id": 88, "duration_s": 4.71, "emotion": "embarrassed", "text": "अम्मा... निशाना... अब भी... बढ़िया है।"}, {"id": 89, "duration_s": 2.22, "emotion": "excited", "text": "लाइव चल रहा है! पाँच लाख!"}, {"id": 90, "duration_s": 2.24, "emotion": "comic_panic", "text": "चलो, चलते हैं! सब ऑटो में!"}, {"id": 91, "duration_s": 1.84, "emotion": "determined", "text": "बस! अब मैं देखती हूँ।"}, {"id": 92, "duration_s": 4.32, "emotion": "calm", "text": "बहू, ज़रा गिनती करो। बच्चे कहाँ हैं?"}, {"id": 93, "duration_s": 3.1, "emotion": "determined", "text": "एक आइडिया है! भूत से सवाल पूछते हैं।"}, {"id": 94, "duration_s": 2.32, "emotion": "curious", "text": "मैं बताऊँ? डर सवालों से भागता है।"}, {"id": 95, "duration_s": 1.33, "emotion": "stern_warning", "text": "चुप! पहले मैं।"}, {"id": 96, "duration_s": 3.56, "emotion": "proud", "text": "मैं... स्नैक्स की रक्षा करूँगा।"}, {"id": 97, "duration_s": 2.87, "emotion": "sarcastic", "text": "भूत मिल गया। मोटा वाला।"}, {"id": 98, "duration_s": 3.37, "emotion": "curious", "text": "देखो! हवा चलती है, तभी आवाज़ आती है!"}, {"id": 99, "duration_s": 2.41, "emotion": "laughing", "text": "भूत... मेरी उंगली से डरता है!"}, {"id": 100, "duration_s": 4.25, "emotion": "proud", "text": "हवा, पाइप, दरार। भूत नंबर एक हल।"}, {"id": 101, "duration_s": 3.2, "emotion": "curious", "text": "आवाज़ तो पाइप है। और आँखें?"}, {"id": 102, "duration_s": 3.19, "emotion": "proud", "text": "टॉर्च की रोशनी, बिल्ली की आँखों में चमकती है।"}, {"id": 103, "duration_s": 1.82, "emotion": "happy", "text": "भूत नहीं, बिल्ली!"}, {"id": 104, "duration_s": 2.91, "emotion": "stern_warning", "text": "अंदर कोई नहीं जाएगा। लड्डू, पोटली दो!"}, {"id": 105, "duration_s": 3.61, "emotion": "sad", "text": "मेरी समोसा-बिस्कुट... अलविदा।"}, {"id": 106, "duration_s": 1.55, "emotion": "happy", "text": "आ जा, छोटे भूत!"}, {"id": 107, "duration_s": 2.25, "emotion": "tender", "text": "ये तो बिस्कुट खाने अंदर गई थी।"}, {"id": 108, "duration_s": 1.97, "emotion": "surprised", "text": "अरे! अंदर एक डिब्बा भी है!"}, {"id": 109, "duration_s": 3.76, "emotion": "embarrassed", "text": "भूख लगी थी! सबसे ठंडी जगह थी!"}, {"id": 110, "duration_s": 2.99, "emotion": "stern_warning", "text": "चुप! ...अच्छा, एक दो।"}, {"id": 111, "duration_s": 3.77, "emotion": "shouting", "text": "रुको! भूत बहुत ख़तरनाक है!"}, {"id": 112, "duration_s": 2.09, "emotion": "proud", "text": "ये रहा आपका भूत!"}, {"id": 113, "duration_s": 3.08, "emotion": "excited", "text": "दस लाख! भूत नहीं, बिल्ली वायरल!"}, {"id": 114, "duration_s": 3.47, "emotion": "proud", "text": "और ये रहा भूत का गाना। टूटा पाइप।"}, {"id": 115, "duration_s": 3.11, "emotion": "proud", "text": "साइंस कहता है... मैं पहले से जानता था।"}, {"id": 116, "duration_s": 2.28, "emotion": "shocked", "text": "अरे! ये तो मेले वाला गुब्बारे वाला है!"}, {"id": 117, "duration_s": 1.67, "emotion": "excited", "text": "सुना क्या? बाबा नकली है!"}, {"id": 118, "duration_s": 2.47, "emotion": "comic_panic", "text": "हे हे... बाबा का टाइम ख़त्म!"}, {"id": 119, "duration_s": 1.6, "emotion": "angry", "text": "मेरे निम्बू के हज़ार रुपये!"}, {"id": 120, "duration_s": 1.88, "emotion": "shouting", "text": "एक रुपया भी कम नहीं!"}, {"id": 121, "duration_s": 2.83, "emotion": "stern_warning", "text": "टिंकू! पैसे वापस!"}, {"id": 122, "duration_s": 1.81, "emotion": "embarrassed", "text": "टेंशन मत लो, भाभी... सबके वापस!"}, {"id": 123, "duration_s": 1.33, "emotion": "determined", "text": "और मेरे दस निम्बू?"}, {"id": 124, "duration_s": 1.8, "emotion": "embarrassed", "text": "चप्पल... कभी नहीं चूकती।"}, {"id": 125, "duration_s": 4.75, "emotion": "sad", "text": "हज़ार रुपये की... एक चप्पल।"}, {"id": 126, "duration_s": 5.91, "emotion": "mischievous", "text": "टंकी चुप थी... अब सेठ जी 'ऊऊऊ' कर रहे थे।"}, {"id": 127, "duration_s": 1.94, "emotion": "happy", "text": "चलो! भूत की छुट्टी!"}, {"id": 128, "duration_s": 3.0, "emotion": "proud", "text": "भूत-प्रूफ़ निम्बू... अब प्यास-प्रूफ़!"}, 