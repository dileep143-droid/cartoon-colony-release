[{"id": 1, "duration_s": 5.02, "emotion": "mischievous", "text": "தீபாவளி ராத்திரி. காலனி முழுக்க ஒரே ஒண்ணைத்தான் பாத்துட்டிருக்கு..."}, {"id": 2, "duration_s": 2.83, "emotion": "excited", "text": "சேகரோட... சூப்பர் பாம்!"}, {"id": 3, "duration_s": 3.46, "emotion": "proud", "text": "டென்ஷன் வேணாம்! நிலாவை விட சத்தம்!"}, {"id": 4, "duration_s": 2.61, "emotion": "excited", "text": "லைவ்லயே இருக்கோம்! தீபாவளி ஸ்பெஷல்!"}, {"id": 5, "duration_s": 3.377, "emotion": "stern_warning", "text": "அமைதி! எல்லாரும் கோட்டுக்குப் பின்னாடி!"}, {"id": 6, "duration_s": 0.99, "emotion": "scared_whisper", "text": "அவ்ளோதானா...?"}, {"id": 7, "duration_s": 3.41, "emotion": "mischievous", "text": "நில்லுங்க நில்லுங்க! இது ஆரம்பிச்சது... இன்னிக்கு காலைல."}, {"id": 8, "duration_s": 3.51, "emotion": "happy", "text": "தீபாவளி காலை. காலனியே ஜொலிச்சுது..."}, {"id": 9, "duration_s": 1.757, "emotion": "sarcastic", "text": "...சேகர் குறட்டை விட்டான்."}, {"id": 10, "duration_s": 4.03, "emotion": "excited", "text": "சூப்பர் பாம்! நிலாவை விட சத்தம்! இன்னிக்கு மட்டும்தான், வாங்கோ!"}, {"id": 11, "duration_s": 0.86, "emotion": "excited", "text": "நிலாவை விடவா?!"}, {"id": 12, "duration_s": 2.06, "emotion": "curious", "text": "அண்ணா... நிலா எவ்ளோ சத்தம் போடும்?"}, {"id": 13, "duration_s": 1.1, "emotion": "serious", "text": "இதுக்கு கம்மி!"}, {"id": 14, "duration_s": 2.72, "emotion": "loving", "text": "என் சூப்பர் பாம்... என் செல்லக்குட்டி."}, {"id": 15, "duration_s": 3.57, "emotion": "serious", "text": "நான் சொல்லவா? அந்த டப்பாவுல பேரே இல்ல!"}, {"id": 16, "duration_s": 3.81, "emotion": "serious", "text": "கம்பெனி இல்ல, அட்ரஸ் இல்ல! வண்டிக்காரனும் ஓடிட்டான்!"}, {"id": 17, "duration_s": 2.25, "emotion": "proud", "text": "டென்ஷன் வேணாம்! சேகர் இருக்கேன்ல!"}, {"id": 18, "duration_s": 1.13, "emotion": "happy", "text": "வாங்க, போகலாம்!"}, {"id": 19, "duration_s": 2.26, "emotion": "comic_panic", "text": "தப்பிச்சுது! என் பாம் தப்பிச்சுது!"}, {"id": 20, "duration_s": 3.39, "emotion": "embarrassed", "text": "அட சேகர், அது என் ஆட்டோவோட தும்மல்!"}, {"id": 21, "duration_s": 0.82, "emotion": "excited", "text": "ஒரு ஐடியா இருக்கு!"}, {"id": 22, "duration_s": 2.93, "emotion": "determined", "text": "இன்னிக்கு... குழந்தைங்க சேஃப்டி ஸ்குவாட்!"}, {"id": 23, "duration_s": 2.32, "emotion": "excited", "text": "கேட்டியா? சேகர் பாம் வாங்கிட்டு வந்துட்டான்!"}, {"id": 24, "duration_s": 3.4, "emotion": "sarcastic", "text": "பத்தே செகண்ட்ல... காலனி முழுக்க தெரிஞ்சு போச்சு."}, {"id": 25, "duration_s": 2.71, "emotion": "excited", "text": "பாருங்க! சூப்பர் பாம்! நிலாவை விட சத்தம்!"}, {"id": 26, "duration_s": 5.68, "emotion": "proud", "text": "காமாட்சி மாமி வெடி இதுக்கு முன்னாடி புஸ்ஸு! காலனியே பாக்கும்!"}, {"id": 27, "duration_s": 0.63, "emotion": "angry", "text": "சேகர்!"}, {"id": 28, "duration_s": 3.27, "emotion": "embarrassed", "text": "அம்மா! இந்தக் குறி என்னிக்கும் தப்பாது..."}, {"id": 29, "duration_s": 4.43, "emotion": "stern_warning", "text": "விளக்குப் பக்கத்துல வெடியா? புத்தி புல் மேயப் போயிடுச்சா?"}, {"id": 30, "duration_s": 1.81, "emotion": "calm", "text": "போதும்! இனி நான் பாத்துக்கறேன்."}, {"id": 31, "duration_s": 2.96, "emotion": "stern_warning", "text": "வெடிய நெருப்புக்குத் தூரமா, குளிர்ச்சியா வைங்க."}, {"id": 32, "duration_s": 4.5, "emotion": "proud", "text": "இன்னிக்கு முதல் மத்தாப்பு நான்தான் கொளுத்துவேன்! நான் யாருக்கும் பயப்பட மாட்டேன்"}, {"id": 33, "duration_s": 4.0, "emotion": "sarcastic", "text": "போன தீபாவளிக்கு பூந்தொட்டியைப் பாத்து பீரோவுல ஒளிஞ்சது யாரு?"}, {"id": 34, "duration_s": 3.4, "emotion": "embarrassed", "text": "அது... பீரோவை சுத்தம் பண்ணேன். உள்ள இருந்து."}, {"id": 35, "duration_s": 1.9, "emotion": "proud", "text": "செருப்பைக் குடு. குறி ரெடி."}, {"id": 36, "duration_s": 4.85, "emotion": "shouting", "text": "சைலன்ட் வெடி! புகை இல்ல, சத்தம் இல்ல, பயம் இல்ல!"}, {"id": 37, "duration_s": 3.03, "emotion": "proud", "text": "நூறு ரூபா டப்பா! ஒரு ரூபா கூட கம்மி இல்ல!"}, {"id": 38, "duration_s": 2.56, "emotion": "curious", "text": "முதலாளி, சைலன்ட் வெடி எப்படிப் பத்தும்?"}, {"id": 39, "duration_s": 3.27, "emotion": "mischievous", "text": "அவ்ளோ அமைதியா... தெரியவே தெரியாது!"}, {"id": 40, "duration_s": 3.23, "emotion": "proud", "text": "அறிவியல் சொல்லுது... சத்தம் நேரா மூளைக்கே வரும்!"}, {"id": 41, "duration_s": 1.02, "emotion": "excited", "text": "ஆமா... கேக்குது!"}, {"id": 42, "duration_s": 3.23, "emotion": "sad", "text": "இதுல தின்னக் கூட ஒண்ணும் இல்லையே!"}, {"id": 43, "duration_s": 0.87, "emotion": "happy", "text": "பசிக்குது!"}, {"id": 44, "duration_s": 2.29, "emotion": "shocked", "text": "கேளு! கந்தசாமி காலி டப்பா விக்கறாரு!"}, {"id": 45, "duration_s": 0.97, "emotion": "stern_warning", "text": "கந்தசாமி!"}, {"id": 46, "duration_s": 5.651, "emotion": "embarrassed", "text": "ராஜாத்தி... இது மாசில்லாத பேக்கிங்!"}, {"id": 47, "duration_s": 2.66, "emotion": "sad", "text": "<sigh> சைலன்ட் வெடி... சைலன்ட் கஸ்டமர்."}, {"id": 48, "duration_s": 2.17, "emotion": "serious", "text": "வெடிக்கும் கண் படும், கண்ணு!"}, {"id": 49, "duration_s": 2.87, "emotion": "worried", "text": "ஆயா, எலுமிச்சை வெடிச்சா?"}, {"id": 50, "duration_s": 1.62, "emotion": "serious", "text": "புளிப்பா வெடிக்கும்."}, {"id": 51, "duration_s": 3.42, "emotion": "sarcastic", "text": "கான்ஸ்டபிள் தூங்கு சாமி காலனியைக் காவல் காத்துட்டிருந்தார்..."}, {"id": 52, "duration_s": 2.04, "emotion": "happy", "text": "ஹார்னுக்கும் கண் பட்டுடுச்சு!"}, {"id": 53, "duration_s": 3.92, "emotion": "pleading", "text": "ஒண்ணே ஒண்ணு... சும்மா சோதனைக்கு."}, {"id": 54, "duration_s": 4.34, "emotion": "stern_warning", "text": "விசாரணை!"}, {"id": 55, "duration_s": 2.86, "emotion": "sad", "text": "<sigh> விசாரணை ஸ்வீட் தின்னுச்சே."}, {"id": 56, "duration_s": 4.82, "emotion": "proud", "text": "நான் யாருக்கும் பயப்பட மாட்டேன்! நெருப்பு, பொறி, சத்தம் தவிர."}, {"id": 57, "duration_s": 2.82, "emotion": "loving", "text": "அப்ப ஒரு எலுமிச்சை உனக்கும்."}, {"id": 58, "duration_s": 2.57, "emotion": "excited", "text": "சாயங்காலம்... பசங்க பொறுப்பெடுத்தாங்க."}, {"id": 59, "duration_s": 3.2, "emotion": "determined", "text": "இதான் பாதுகாப்புக் கோடு! இதைத் தாண்டி யாரும் வரக்கூடாது!"}, {"id": 60, "duration_s": 3.92, "emotion": "serious", "text": "நான் சொல்லவா? தண்ணி வாளி, மணல் வாளி, தூரம்!"}, {"id": 61, "duration_s": 2.33, "emotion": "excited", "text": "பானிபூரியா? எங்கே பானிபூரி?"}, {"id": 62, "duration_s": 2.05, "emotion": "excited", "text": "பானிபூரியா?! எங்கே?!"}, {"id": 63, "duration_s": 2.09, "emotion": "sarcastic", "text": "தண்ணி வாளி, வாத்தியாரே! மணல்!"}, {"id": 64, "duration_s": 3.21, "emotion": "curious", "text": "மணல் ரேட்டா? பானிபூரி ரேட் என்ன?"}, {"id": 65, "duration_s": 2.21, "emotion": "embarrassed", "text": "முக்கியமான நேரத்துலதான் இது லீவு போடும்!"}, {"id": 66, "duration_s": 2.51, "emotion": "shouting", "text": "பெரியவங்க இங்க! விதி கேளுங்க!"}, {"id": 67, "duration_s": 3.76, "emotion": "stern_warning", "text": "கையில மத்தாப்பு மட்டும்! மத்த வெடி எப்பவும் கூடாது!"}, {"id": 68, "duration_s": 3.0, "emotion": "stern_warning", "text": "பட்டுத் துணி விளக்கு பக்கம் வேணாம்! பருத்தி போடுங்க!"}, {"id": 69, "duration_s": 1.65, "emotion": "comic_panic", "text": "அஞ்சு நிமிஷம்! இதோ வந்துட்டேன்!"}, {"id": 70, "duration_s": 1.41, "emotion": "shouting", "text": "நில்லு! திரும்பு!"}, {"id": 71, "duration_s": 2.24, "emotion": "embarrassed", "text": "நான்... கோடு செக் பண்ணிட்டிருந்தேன்."}, {"id": 72, "duration_s": 3.11, "emotion": "sarcastic", "text": "ராத்திரி... ஹீரோ பருத்தி குர்தாவுல வந்தார்."}, {"id": 73, "duration_s": 2.34, "emotion": "proud", "text": "நான் யாருக்கும் பயப்பட மாட்டேன்! கொளுத்துங்க!"}, {"id": 74, "duration_s": 3.66, "emotion": "stern_warning", "text": "கை நேரா! முகம் தூரம்! வாளி பக்கத்துல!"}, {"id": 75, "duration_s": 0.85, "emotion": "comic_panic", "text": "பொ... பொறி!"}, {"id": 76, "duration_s": 0.67, "emotion": "comic_panic", "text": "ஆஆஆஆ!"}, {"id": 77, "duration_s": 1.36, "emotion": "comic_panic", "text": "இது ஏன் அணையல?!"}, {"id": 78, "duration_s": 2.35, "emotion": "excited", "text": "கேட்டியா? முருகேசன் மாரத்தான் ஓடறான்!"}, {"id": 79, "duration_s": 7.298, "emotion": "sarcastic", "text": "மத்தாப்பு ரெண்டு நிமிஷம் முன்னாடியே அணைஞ்சுடுச்சு."}, {"id": 80, "duration_s": 1.12, "emotion": "tired", "text": "...அதை ஏன் சொல்லல?"}, {"id": 81, "duration_s": 4.12, "emotion": "giggly", "text": "அப்பா, மத்தாப்பை நின்னுதான் கொளுத்தணும், ஓடிக்கிட்டு இல்ல!"}, {"id": 82, "duration_s": 3.84, "emotion": "serious", "text": "எரிஞ்ச கம்பி நேரா தண்ணியில. காலுல இல்ல."}, {"id": 83, "duration_s": 2.72, "emotion": "giggly", "text": "முதல் மத்தாப்பு... முதல் மாரத்தான்!"}, {"id": 84, "duration_s": 3.1, "emotion": "mischievous", "text": "புது பிராங்க்! சாக்லேட் பாம்!"}, {"id": 85, "duration_s": 2.7, "emotion": "curious", "text": "பாம்ல இருந்து... சாக்லேட் வாசனை?"}, {"id": 86, "duration_s": 1.9, "emotion": "shouting", "text": "பூ... பூ... பூம்!"}, {"id": 87, "duration_s": 1.55, "emotion": "panicked", "text": "போண்டா வெடிச்சிடுச்சு!"}, {"id": 88, "duration_s": 1.26, "emotion": "shouting", "text": "போண்டா!!"}, {"id": 89, "duration_s": 3.85, "emotion": "giggly", "text": "உள்ள சாக்லேட் இருந்துச்சு! பசிச்சுது!"}, {"id": 90, "duration_s": 2.82, "emotion": "excited", "text": "கேட்டியா? போண்டா... மறுபடியும் பசியாம்!"}, {"id": 91, "duration_s": 2.98, "emotion": "stern_warning", "text": "வெடியோட விளையாடாதீங்க, அக்கா! பயந்துட்டாங்க."}, {"id": 92, "duration_s": 1.57, "emotion": "embarrassed", "text": "சாரி... ரீல் டெலீட்."}, {"id": 93, "duration_s": 3.01, "emotion": "mischievous", "text": "இப்ப... கதை நின்ன இடத்துக்கே திரும்பப் போவோம்."}, {"id": 94, "duration_s": 4.27, "emotion": "stern_warning", "text": "நீளமான ஊதுபத்தி! கை நேரா! கொளுத்திட்டு பின்னாடி!"}, {"id": 95, "duration_s": 2.46, "emotion": "comic_panic", "text": "பத்திக்கிச்சு! ஓடு... அதாவது, பின்னாடி போ!"}, {"id": 96, "duration_s": 1.92, "emotion": "proud", "text": "பொறுங்க... அது யோசிக்குது."}, {"id": 97, "duration_s": 2.42, "emotion": "serious", "text": "அறிவியல் சொல்லுது... அது தூங்கிடுச்சு."}, {"id": 98, "duration_s": 3.65, "emotion": "shouting", "text": "நில்லுங்க! புஸ்ஸு வெடி பக்கத்துல யாரும் போகக்கூடாது!"}, {"id": 99, "duration_s": 3.16, "emotion": "serious", "text": "நான் சொல்றேன்! பதினஞ்சு நிமிஷம் கழிச்சு தண்ணி ஊத்துங்க."}, {"id": 100, "duration_s": 3.43, "emotion": "sarcastic", "text": "பதினஞ்சு நிமிஷமா? என் வட்டி ஓடிட்டிருக்கே!"}, {"id": 101, "duration_s": 1.53, "emotion": "embarrassed", "text": "...நிலாவை விட சத்தம்."}, {"id": 102, "duration_s": 2.39, "emotion": "sarcastic", "text": "லைவ்லயே இருக்கோம்... துரதிர்ஷ்டவசமா."}, {"id": 103, "duration_s": 0.94, "emotion": "angry", "text": "சேகர்..."}, {"id": 104, "duration_s": 1.35, "emotion": "shouting", "text": "விசாரணை!"}, {"id": 105, "duration_s": 2.01, "emotion": "embarrassed", "text": "ஹார்னால தான்! சத்தியமா!"}, {"id": 106, "duration_s": 4.69, "emotion": "curious", "text": "என்ன ஆச்சு? இனிப்பு குடுக்கறாங்களா?"}, {"id": 107, "duration_s": 3.29, "emotion": "tender", "text": "அட மணி... நீயும் பயந்துட்டியா?"}, {"id": 108, "duration_s": 2.84, "emotion": "worried", "text": "மிருகங்களுக்கு நம்மளை விட காது ரொம்பக் கூர்மை."}, {"id": 109, "duration_s": 2.48, "emotion": "serious", "text": "நமக்கு வெடின்னா, அவங்களுக்கு புயல்."}, {"id": 110, "duration_s": 3.131, "emotion": "tender", "text": "ஷ்ஷ்... மணிக்கு அமைதி மூலை!"}, {"id": 111, "duration_s": 3.49, "emotion": "calm", "text": "வெடிச்சத்தம் தூரமா... ஒரு குட்டி அமைதி மூலை."}, {"id": 112, "duration_s": 3.48, "emotion": "happy", "text": "என் காதும் வயசாயிடுச்சு. நானும் இங்கதான்!"}, {"id": 113, "duration_s": 1.92, "emotion": "tender", "text": "வா மணி, இங்க வெடியே இல்ல."}, {"id": 114, "duration_s": 1.99, "emotion": "serious", "text": "பாவம், கண் பட்டுடுச்சு!"}, {"id": 115, "duration_s": 2.37, "emotion": "proud", "text": "சபாஷ், என் சேஃப்டி ஸ்குவாட்."}, {"id": 116, "duration_s": 3.29, "emotion": "mischievous", "text": "அப்புறம்... சூப்பர் பாம்க்கு பிரேத பரிசோதனை."}, {"id": 117, "duration_s": 5.624, "emotion": "serious", "text": "விசாரணை நடக்கும்! ...அடுக்கு அடுக்கா."}, {"id": 118, "duration_s": 4.31, "emotion": "sad", "text": "இவ்ளோ பெரிய டப்பா... உள்ள இவ்ளோதானா?"}, {"id": 119, "duration_s": 2.23, "emotion": "serious", "text": "பேர் இல்லாத வெடி ஆபத்தாவும் இருக்கலாம்."}, {"id": 120, "duration_s": 3.22, "emotion": "loving", "text": "சித்தப்பா, லைசென்ஸ் கடையில வாங்குங்க. வேன்ல இல்ல."}, {"id": 121, "duration_s": 2.7, "emotion": "guilty", "text": "சரியாச் சொன்ன. அடுத்த தடவை முதல்ல கேப்பேன்."}, {"id": 122, "duration_s": 1.64, "emotion": "giggly", "text": "டென்ஷன் ஆகறேன்... கொஞ்சமா."}, {"id": 123, "duration_s": 4.96, "emotion": "stern_warning", "text": "கந்தசாமி! காலியா?"}, {"id": 124, "duration_s": 4.54, "emotion": "guilty", "text": "சரி! எல்லாருக்கும்... இலவச இனிப்பு!"}, {"id": 125, "duration_s": 6.849, "emotion": "crying", "text": "இலவசம்... சொல்லவே வலிக்குது."}, {"id": 126, "duration_s": 2.67, "emotion": "serious", "text": "விசாரணை ஓவர்."}, {"id": 127, "duration_s": 2.89, "emotion": "happy", "text": "சமமா பிரிஞ்சுது!"}, {"id": 128, "duration_s": 4.23, "emotion": "calm", "text": "அன்னிக்கு ராத்திரி காலனியில புகை கம்மி... வெளிச்சம் அதிகம்."}, {"id": 129, "duration_s": 3.67, "emotion": "loving", "text": "இந்த விளக்குகள் அமைதியா எரியும்... ராத்திரி முழுக்க."}, {"id": 130, "duration_s": 1.46, "emotion": "giggly", "text": "இதுக்கு விசிலே தேவையில்ல!"}, {"id": 131, "duration_s": 3.31, "emotion": "excited", "text": "புது ரீல்... 'சைலன்ட் தீபாவளி'! லைவ்லயே இருக்கோம்!"}, {"id": 132, "duration_s": 2.1, "emotion": "excited", "text": "கேட்டியா? திவ்யா ரீல் வைரல்!"}, {"id": 133, "duration_s": 3.34, "emotion": "proud", "text": "பாத்தியா? காலனியே பாத்துச்சு! நாடே பாத்துச்சு!"}, {"id": 134, "duration_s": 2.69, "emotion": "giggly", "text": "ரீல்ல உங்க செருப்பும் இருக்கு!"}, {"id": 135, "duration_s": 3.54, "emotion": "proud", "text": "அறிவியல் சொல்லுது... அகல் விளக்குதான் பாதுகாப்பான வெடி."}, {"id": 136, "duration_s": 3.35, "emotion": "shocked", "text": "அறிவு சரியாச் சொன்னானா?! ...நிஜமா?"}, {"id": 137, "duration_s": 5.73, "emotion": "serious", "text": "வெடி கையில இல்ல, வாளி பக்கத்துல, பெரியவங்க துணையோட."}, {"id": 138, "duration_s": 4.01, "emotion": "loving", "text": "மிருகங்களுக்கும் பெரியவங்களுக்கும் ஒரு அமைதி மூலை."}, {"id": 139, "duration_s": 3.66, "emotion": "calm", "text": "வெளிச்சம் மனசுல... வெடி கையில இல்ல."}, {"id": 140, "duration_s": 2.18, "emotion": "excited", "text": "ஹேப்பி சேஃப் தீபாவளி!"}]