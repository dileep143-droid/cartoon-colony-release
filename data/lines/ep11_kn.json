[{"id": 1, "duration_s": 3.24, "emotion": "embarrassed", "text": "ಹೌದು, ನಾನೇ. ಹೇಗಾಯ್ತು ಅಂತ ಯೋಚಿಸ್ತಿದ್ದೀರಾ?"}, {"id": 2, "duration_s": 5.02, "emotion": "mischievous", "text": "ಬೆಳಿಗ್ಗೆಯಿಂದ ಶುರು ಮಾಡೋಣ. ಕಾಲೋನಿಗೆ ಬಂತು... ಹೊಸ ಬೈಕು!"}, {"id": 3, "duration_s": 5.27, "emotion": "proud", "text": "ಹೊಸ ಬೈಕು! ಎಂಬತ್ತು ಸಾವಿರ... ಒಂದ್ರೂಪಾಯಿ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 4, "duration_s": 2.56, "emotion": "mischievous", "text": "ನಮ್ಮಪ್ಪನ ಬೈಕು! ನಿಮ್ಮಪ್ಪನ ಹತ್ರ ಏನಿದೆ?"}, {"id": 5, "duration_s": 2.56, "emotion": "proud", "text": "ನಮ್ಮಪ್ಪನ ಹತ್ರ... ಮೀಸೆ ಇದೆ!"}, {"id": 6, "duration_s": 3.34, "emotion": "sarcastic", "text": "ಮೀಸೆ ನಮ್ಮಪ್ಪಂಗೂ ಇದೆ... ಬೈಕ್ ಜೊತೆ!"}, {"id": 7, "duration_s": 2.97, "emotion": "shocked", "text": "ಮೀಸೆ?! ಇದು ನನ್ ಮರ್ಯಾದೆ ಪ್ರಶ್ನೆ!"}, {"id": 8, "duration_s": 3.09, "emotion": "proud", "text": "ಸಂಜೆಗೆ ಈ ಗಲ್ಲಿಲಿ ನನ್ ಗಾಡಿ ಓಡುತ್ತೆ!"}, {"id": 9, "duration_s": 3.14, "emotion": "excited", "text": "ಗೊತ್ತಾ ಸುದ್ದಿ? ಶಿವಣ್ಣ ವಿಮಾನದಷ್ಟು ಗಾಡಿ ತರ್ತಾನಂತೆ!"}, {"id": 10, "duration_s": 2.91, "emotion": "sarcastic", "text": "ಸಂಜೆ ಗಾಡಿ ಬಂತು... ಓಡ್ಕೊಂಡಲ್ಲ!"}, {"id": 11, "duration_s": 2.448, "emotion": "tired", "text": "ಬಂದ್ಳು... ನನ್ ಸಿಂಹಿಣಿ."}, {"id": 12, "duration_s": 2.39, "emotion": "sarcastic", "text": "ಇದು ಓಡುತ್ತಾ, ಇದಕ್ಕೂ ತಳ್ಳಬೇಕಾ?"}, {"id": 13, "duration_s": 5.46, "emotion": "proud", "text": "ವಿಂಟೇಜ್ ಇದು! ವಿಂಟೇಜ್ ಅಂದ್ರೆ... ಹಳೇದು, ಆದ್ರೆ ಬೆಲೆಬಾಳೋದು!"}, {"id": 14, "duration_s": 2.37, "emotion": "comic_panic", "text": "ನಾನು... ಯಾರಿಗೂ ಹೆದರಲ್ಲ!"}, {"id": 15, "duration_s": 4.81, "emotion": "laughing", "text": "ಹ ಹ ಹ! ಸ್ಕೂಟಿ ಹದಿನೈದು ಸಾವಿರ, ಹೊಗೆ ಫ್ರೀ!"}, {"id": 16, "duration_s": 1.24, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪ!"}, {"id": 17, "duration_s": 1.85, "emotion": "excited", "text": "ಓಡ್ತು! ಅಪ್ಪಾ, ಓಡ್ತು!"}, {"id": 18, "duration_s": 4.35, "emotion": "serious", "text": "ದೃಷ್ಟಿ ಆದ್ರೆ? ನಿಂಬೆ-ಮೆಣಸಿನಕಾಯಿ ಬೇಕೇಬೇಕು!"}, {"id": 19, "duration_s": 4.37, "emotion": "proud", "text": "ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ! ನನ್ ಮಗನ ಗಾಡಿ!"}, {"id": 20, "duration_s": 4.42, "emotion": "proud", "text": "ಇವತ್ತು ಕೂದಲು ಹೇಗಿದೆ ಅಂದ್ರೆ... ಬೈಕೇ ನಾಚ್ಕೋಬೇಕು."}, {"id": 21, "duration_s": 0.96, "emotion": "stern_warning", "text": "ಹೆಲ್ಮೆಟ್ ಹಾಕಿ."}, {"id": 22, "duration_s": 3.59, "emotion": "pleading", "text": "ಹೆಲ್ಮೆಟ್ ಹಾಕಿದ್ರೆ ಕೂದಲು ಹಾಳು, ಕಾವೇರಿ! ಎಂದೂ ಇಲ್ಲ!"}, {"id": 23, "duration_s": 1.85, "emotion": "determined", "text": "ಸಾಕು! ಈಗ ನಾನು ನೋಡ್ತೀನಿ."}, {"id": 24, "duration_s": 2.24, "emotion": "comic_panic", "text": "ನಾನ್ಯಾರಿಗೂ ಹೆದರಲ್ಲ... ಹಲ್ಲಿ ಬಿಟ್ಟು!"}, {"id": 25, "duration_s": 2.84, "emotion": "sarcastic", "text": "ಹಲ್ಲಿ ಹೋಯ್ತು. ಈಗ ಕೂದಲೂ ಹೋಗುತ್ತೆ."}, {"id": 26, "duration_s": 3.0, "emotion": "giggly", "text": "ಅಪ್ಪಾ, ಹೆಲ್ಮೆಟ್ ಉಲ್ಟಾ ಇದೆ!"}, {"id": 27, "duration_s": 2.17, "emotion": "proud", "text": "ಗೊತ್ತು! ಇದು ಹಿಂದೆ ಕೂರೋರಿಗೆ!"}, {"id": 28, "duration_s": 2.772, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ಅಪ್ಪನ ಉಲ್ಟಾ ಹೆಲ್ಮೆಟ್!"}, {"id": 29, "duration_s": 3.1, "emotion": "sad", "text": "ನನ್ ಕೂದಲು... ವೀರಸ್ವರ್ಗ ಸೇರ್ತು."}, {"id": 30, "duration_s": 1.01, "emotion": "stern_warning", "text": "ಪಟ್ಟಿನೂ ಕಟ್ಟಿ."}, {"id": 31, "duration_s": 1.03, "emotion": "mischievous", "text": "ನಾಳೆಯಿಂದ."}, {"id": 32, "duration_s": 3.0, "emotion": "excited", "text": "ಟೆನ್ಷನ್ ಬೇಡ! ಇವತ್ತು ನಾನು ಕಲಿಸ್ತೀನಿ."}, {"id": 33, "duration_s": 2.25, "emotion": "proud", "text": "ಸ್ಕೂಟಿಗೆ ಕ್ಲಚ್ ಇಲ್ಲ, ಸುಮ್ನೆ ರೇಸ್ ಕೊಡಿ!"}, {"id": 34, "duration_s": 1.99, "emotion": "sarcastic", "text": "ಅಣ್ಣಾ, ಮೊದ್ಲು ಸ್ಟಾರ್ಟ್ ಮಾಡಿ!"}, {"id": 35, "duration_s": 1.8, "emotion": "excited", "text": "ನೋಡಿ! ನಾನು ಹಾರ್ತಿದ್ದೀನಿ!"}, {"id": 36, "duration_s": 2.86, "emotion": "proud", "text": "ಹೀರೋ! ಹತ್ತು ಕಿಲೋಮೀಟರ್ ಆಯ್ತು!"}, {"id": 37, "duration_s": 0.57, "emotion": "proud", "text": "ಇದ್ದಲ್ಲೇ!"}, {"id": 38, "duration_s": 2.34, "emotion": "shouting", "text": "ರೇಸ್ ಕೊಡಿ! ಮುಂದೆ! ಮುಂದೆ!"}, {"id": 39, "duration_s": 2.39, "emotion": "comic_panic", "text": "ಮುಂದೆ ಹೇಗೆ? ಗಾಡಿ ಹಿಂದೆ ಹೋಗ್ತಿದೆ!"}, {"id": 40, "duration_s": 2.03, "emotion": "comic_panic", "text": "ಬ್ರೇಕ್! ಬ್ರೇಕ್! ಕೈ ಬ್ರೇಕ್!"}, {"id": 41, "duration_s": 2.68, "emotion": "embarrassed", "text": "ನಾನು ಸರಿ ಇದ್ದೀನಿ. ಗಾಡಿನೂ ಸರಿ."}, {"id": 42, "duration_s": 2.73, "emotion": "serious", "text": "ದೃಷ್ಟಿ ಆಯ್ತು! ಹೇಳಿದ್ದೆ ತಾನೇ?"}, {"id": 43, "duration_s": 3.68, "emotion": "sad", "text": "ಅಯ್ಯೋ... ನಿಂಬೆಹಣ್ಣಿಂದ ಬ್ರೇಕ್ ಬೀಳಲ್ಲ, ಅಜ್ಜಿ."}, {"id": 44, "duration_s": 2.39, "emotion": "angry", "text": "ಸೀನ! ಮೊದ್ಲು ನೀನು ಕಲಿ!"}, {"id": 45, "duration_s": 2.22, "emotion": "embarrassed", "text": "ಟೆನ್ಷನ್ ಬೇಡ... ಅವರ ಗುರಿ ಪಕ್ಕಾ ಇದೆ."}, {"id": 46, "duration_s": 3.61, "emotion": "mischievous", "text": "ಒಂದು ಐಡಿಯಾ ಇದೆ! ಅಪ್ಪನಿಗಿಂತ ಚೆನ್ನಾಗಿ ನಾವೇ ಓಡಿಸ್ತೀವಿ."}, {"id": 47, "duration_s": 2.71, "emotion": "excited", "text": "ನಾನು ಹಿಂದೆ ಕೂರ್ತೀನಿ... ತಿಂಡಿ ಜೊತೆ."}, {"id": 48, "duration_s": 1.66, "emotion": "stern_warning", "text": "ಸುಮ್ನಿರು! ಕೈ ತೆಗಿ!"}, {"id": 49, "duration_s": 3.93, "emotion": "serious", "text": "ಮಕ್ಕಳು ಗಾಡಿ ಓಡಿಸಲ್ಲ. ಎಂದೂ ಇಲ್ಲ. ತಿಳೀತಾ?"}, {"id": 50, "duration_s": 3.84, "emotion": "serious", "text": "ನಾನು ಹೇಳ್ಲಾ? ಹದಿನೆಂಟು ವರ್ಷದ ಮೊದ್ಲು ಗಾಡಿ ಓಡಿಸೋದು ಅಪರಾಧ."}, {"id": 51, "duration_s": 2.63, "emotion": "serious", "text": "ಕಾಲು ನೆಲಕ್ಕೆ ಎಟುಕಲ್ಲ. ಬ್ರೇಕ್ ಹೇಗೆ ಹಾಕ್ತೀರಿ?"}, {"id": 52, "duration_s": 3.977, "emotion": "proud", "text": "ಕೀ ವಶ!"}, {"id": 53, "duration_s": 1.57, "emotion": "excited", "text": "ಇನ್ನೊಂದು ಐಡಿಯಾ ಇದೆ! ಅಪ್ಪನಿಗೇ ನಾವು ಕಲಿಸೋಣ!"}, {"id": 54, "duration_s": 5.49, "emotion": "tired", "text": "ನಾನ್ಯಾರಿಗೂ ಹೆದರಲ್ಲ... ಗೊರ್ರ್..."}, {"id": 55, "duration_s": 4.66, "emotion": "proud", "text": "ನೋಡಿ ಕಾಲೋನಿ! ಶಿವಣ್ಣ... ರಸ್ತೆಯಲ್ಲಿ!"}, {"id": 56, "duration_s": 4.0, "emotion": "proud", "text": "ಹೌದು ದಾಸಪ್ಪ? ಸ್ಕೂಟಿ ಗಾಳಿ ಜೊತೆ ಮಾತಾಡ್ತಿದೆ!"}, {"id": 57, "duration_s": 4.33, "emotion": "sarcastic", "text": "ಗಾಳಿ ಜೊತೆ ಅಲ್ಲ, ನನ್ ಜೊತೆ ಮಾತಾಡ್ತಿದ್ದೀಯ. ಗಮನ ಕೊಡು!"}, {"id": 58, "duration_s": 4.05, "emotion": "happy", "text": "ನಮಸ್ತೆ ಸರಸು ಆಂಟಿ! ಹೌದು ದಾಸಪ್ಪ, ಹೇಳಿ!"}, {"id": 59, "duration_s": 4.67, "emotion": "sarcastic", "text": "ಒಂದು ಕೈಲಿ ಫೋನ್, ಇನ್ನೊಂದ್ರಲ್ಲಿ ನಮಸ್ತೆ... ಗಾಡಿ ಯಾರ ಕೈಲಿ?"}, {"id": 60, "duration_s": 2.5, "emotion": "comic_panic", "text": "ಶಿವಣ್ಣ! ಮುಂದೆ ನೋಡು! ಮುಂದೆ!"}, {"id": 61, "duration_s": 5.71, "emotion": "curious", "text": "ಮುಂದೆ? ದಾಸಪ್ಪ, ನೀವು ಫೋನಲ್ಲಿದ್ದೀರಲ್ಲ!"}, {"id": 62, "duration_s": 5.28, "emotion": "embarrassed", "text": "ನಾನು ಸರಿ! ಗಾಡಿನೂ ಸರಿ! ಡಬ್ಬಿ...?"}, {"id": 63, "duration_s": 3.53, "emotion": "crying", "text": "ನನ್ ಡಬ್ಬಿಗಳು! ನನ್ ಶೋಕೇಸ್!"}, {"id": 64, "duration_s": 2.21, "emotion": "shocked", "text": "ಖಾಲಿ! ಇದೂ ಖಾಲಿ!"}, {"id": 65, "duration_s": 3.25, "emotion": "sad", "text": "ಎಲ್ಲಾ ಖಾಲಿ! ಒಂದೂ ಸಿಹಿ ಇಲ್ಲ!"}, {"id": 66, "duration_s": 2.42, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪ! ಡಬ್ಬಿ ಖಾಲಿ?"}, {"id": 67, "duration_s": 3.72, "emotion": "embarrassed", "text": "ತೋರಿಸೋಕೆ ಇರೋದು! ತುಂಬಿದ ಡಬ್ಬಿ ದುಬಾರಿ!"}, {"id": 68, "duration_s": 3.05, "emotion": "proud", "text": "ನೋಡಿದ್ರಾ? ಹೆಲ್ಮೆಟ್ ಮೇಲೆ ಡಬ್ಬಿ ಬಿತ್ತಷ್ಟೇ."}, {"id": 69, "duration_s": 2.08, "emotion": "serious", "text": "ಯೋಚಿಸಿ, ಹೆಲ್ಮೆಟ್ ಇಲ್ಲದಿದ್ರೆ?"}, {"id": 70, "duration_s": 1.03, "emotion": "happy", "text": "ಕೂದಲು ಉಳೀತಿತ್ತು!"}, {"id": 71, "duration_s": 3.49, "emotion": "sarcastic", "text": "ಇಷ್ಟು ಗದ್ದಲದಲ್ಲೂ... ಕಾನ್ಸ್ಟೇಬಲ್ ನಿದ್ದೆ ಗೌಡ ಮಲಗಿದ್ರು."}, {"id": 72, "duration_s": 3.64, "emotion": "shouting", "text": "ಸಮೋಸಾ? ಅಂದ್ರೆ... ತನಿಖೆ ಆಗುತ್ತೆ!"}, {"id": 73, "duration_s": 9.63, "emotion": "stern_warning", "text": "ಪಟ್ಟಿ ಬಿಚ್ಚಿದೆ, ಕೈಯಲ್ಲಿ ಫೋನ್... ಲೈಸೆನ್ಸ್ ತೋರಿಸು!"}, {"id": 74, "duration_s": 2.16, "emotion": "sarcastic", "text": "ಇದು ರೇಷನ್ ಕಾರ್ಡ್."}, {"id": 75, "duration_s": 4.27, "emotion": "curious", "text": "ಇದು ಜಿಮ್ ಕಾರ್ಡ್. ನೀನು ಜಿಮ್ಗೆ ಹೋಗ್ತೀಯಾ?"}, {"id": 76, "duration_s": 4.42, "emotion": "embarrassed", "text": "ಕಾರ್ಡ್ ಮಾತ್ರ ಹೋಗುತ್ತೆ."}, {"id": 77, "duration_s": 6.02, "emotion": "shocked", "text": "ಇದು... ಯಾರೋ ಮಗುವಿನ ರಿಪೋರ್ಟ್ ಕಾರ್ಡ್!"}, {"id": 78, "duration_s": 3.28, "emotion": "embarrassed", "text": "ಅಪ್ಪಾ! ಅದು ನಂದು!"}, {"id": 79, "duration_s": 6.05, "emotion": "serious", "text": "ಲೈಸೆನ್ಸ್ ಇಲ್ಲ, ಫೋನಲ್ಲಿ ಮಾತು... ದಂಡ ಬೀಳುತ್ತೆ!"}, {"id": 80, "duration_s": 3.67, "emotion": "pleading", "text": "ಕಾನ್ಸ್ಟೇಬಲ್ ಸಾರ್... ಬಿಸಿ ಬಿಸಿ ಸಮೋಸಾ? ದಂಡದ ಬದಲು?"}, {"id": 81, "duration_s": 7.14, "emotion": "stern_warning", "text": "ಲಂಚ? ಅದೂ ಆಲೂಗಡ್ಡೆಯದು? ಖಂಡಿತ ಇಲ್ಲ!"}, {"id": 82, "duration_s": 1.32, "emotion": "embarrassed", "text": "ಹಸಿವಾಗಿದೆ!"}, {"id": 83, "duration_s": 4.66, "emotion": "serious", "text": "ಮೊದ್ಲು ಆರ್ಟಿಒ ಹೋಗಿ. ಲರ್ನರ್ ಲೈಸೆನ್ಸ್ ಮಾಡ್ಸಿ."}, {"id": 84, "duration_s": 2.92, "emotion": "sarcastic", "text": "ದಂಡ ನಿಮ್ಮ ಪಾಕೆಟ್ ಮನಿಯಿಂದ ಕಟ್ ಆಗುತ್ತೆ."}, {"id": 85, "duration_s": 4.1, "emotion": "shocked", "text": "ನನ್ ಪಾಕೆಟ್ ಮನಿ? ನಾನು ಅಪ್ಪ ಕಣೇ!"}, {"id": 86, "duration_s": 2.81, "emotion": "determined", "text": "ಅಪ್ಪಾ, ನಾಳೆಯಿಂದ... ಕಾಲೋನಿ ಡ್ರೈವಿಂಗ್ ಸ್ಕೂಲ್!"}, {"id": 87, "duration_s": 4.28, "emotion": "excited", "text": "ಒಂದು ವಾರದ ನಂತರ... ಮಕ್ಕಳು ತೆರೆದ್ರು ಡ್ರೈವಿಂಗ್ ಸ್ಕೂಲ್!"}, {"id": 88, "duration_s": 2.34, "emotion": "excited", "text": "ಕಾಲೋನಿ ಡ್ರೈವಿಂಗ್ ಸ್ಕೂಲ್! ಇವತ್ತು ಎಲ್ರಿಗೂ ಟೆಸ್ಟ್!"}, {"id": 89, "duration_s": 7.34, "emotion": "serious", "text": "ನಾನು ಹೇಳ್ಲಾ? ನಾಲ್ಕು ನಿಯಮ: ಹೆಲ್ಮೆಟ್, ಎರಡೂ ಕೈ, ಫೋನ್ ಇಲ್ಲ, ಲೈಸೆನ್ಸ್."}, {"id": 90, "duration_s": 2.46, "emotion": "proud", "text": "ಮತ್ತೆ ಮಕ್ಕಳು? ಬರೀ ಚಪ್ಪಾಳೆ!"}, {"id": 91, "duration_s": 4.15, "emotion": "proud", "text": "ಆರ್ಟಿಒ ಲರ್ನರ್ ಲೈಸೆನ್ಸ್! ಈಗ ನಾನು ಅರ್ಧ ಡ್ರೈವರ್!"}, {"id": 92, "duration_s": 3.3, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ, ಹೆಲ್ಮೆಟ್ನಿಂದ ತಲೆ ಬಿಸಿಯಾಗುತ್ತೆ."}, {"id": 93, "duration_s": 4.72, "emotion": "serious", "text": "ಸೈನ್ಸ್ ಇದನ್ನೂ ಹೇಳುತ್ತೆ: ಹೆಲ್ಮೆಟ್ ತಲೆ ಕಾಪಾಡುತ್ತೆ."}, {"id": 94, "duration_s": 1.16, "emotion": "embarrassed", "text": "ಹೂಂ, ಅದೂ."}, {"id": 95, "duration_s": 2.67, "emotion": "serious", "text": "ರಘು ಮೇಷ್ಟ್ರೇ, ಮೊದಲ ನಿಯಮ: ಬ್ರೇಕ್!"}, {"id": 96, "duration_s": 3.22, "emotion": "happy", "text": "ಬ್ರೇಕ್? ಹೌದು ಹೌದು, ಊಟದ ಬ್ರೇಕ್!"}, {"id": 97, "duration_s": 1.02, "emotion": "shouting", "text": "ಇಂಡಿಕೇಟರ್!"}, {"id": 98, "duration_s": 2.76, "emotion": "proud", "text": "ಇಂಡಿಯಾ ಗೇಟ್? ದೆಹಲೀಲಿದೆ, ಮಗು!"}, {"id": 99, "duration_s": 1.08, "emotion": "shouting", "text": "ಲೈಸೆನ್ಸ್!"}, {"id": 100, "duration_s": 3.3, "emotion": "stern_warning", "text": "ಸೈಲೆನ್ಸ್? ಹೌದು! ಎಲ್ರೂ ಸುಮ್ನಿರಿ!"}, {"id": 101, "duration_s": 1.62, "emotion": "happy", "text": "ಹೋಗೋಣ, ನಡೀರಿ!"}, {"id": 102, "duration_s": 1.629, "emotion": "serious", "text": "ಇದಕ್ಕೂ ದೃಷ್ಟಿ ಆಯ್ತು!"}, {"id": 103, "duration_s": 2.89, "emotion": "curious", "text": "ಮೊದಲ ಅಭ್ಯರ್ಥಿ... ಆಟೋ?"}, {"id": 104, "duration_s": 2.85, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ಕಾಲೋನಿಯ ಮಹಾ ಟೆಸ್ಟ್!"}, {"id": 105, "duration_s": 3.42, "emotion": "proud", "text": "ಟೆನ್ಷನ್ ಬೇಡ! ಹೀರೋಗೆ ಹೆಲ್ಮೆಟ್ ಬೇಡ!"}, {"id": 106, "duration_s": 1.55, "emotion": "stern_warning", "text": "ಹೆಲ್ಮೆಟ್ ಇಲ್ಲ? ಹೊರಗೆ!"}, {"id": 107, "duration_s": 8.29, "emotion": "serious", "text": "ಒಂದು, ಎರಡು, ಮೂರು... ತಡಿ, ಮತ್ತೆ... ಒಂದು..."}, {"id": 108, "duration_s": 2.97, "emotion": "angry", "text": "ರೀ ದಾಸಪ್ಪ! ಟೆಸ್ಟ್ ಇದು, ಲೆಕ್ಕ ಅಲ್ಲ!"}, {"id": 109, "duration_s": 2.81, "emotion": "stern_warning", "text": "ನನ್ ಡಬ್ಬಿಗಳು! ಒಂದೂ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 110, "duration_s": 2.497, "emotion": "serious", "text": "ಟೈಮ್ ಮುಗೀತು! ಮುಂದಿನೋರು!"}, {"id": 111, "duration_s": 1.71, "emotion": "excited", "text": "ಗೊತ್ತಾ? ನಾನು ಟೆಸ್ಟ್ ಕೊಡ್ತಿದ್ದೀನಿ..."}, {"id": 112, "duration_s": 0.737, "emotion": "stern_warning", "text": "ಫೋನ್!"}, {"id": 113, "duration_s": 1.59, "emotion": "embarrassed", "text": "...ಆಮೇಲೆ ಹೇಳ್ತೀನಿ."}, {"id": 114, "duration_s": 2.56, "emotion": "shocked", "text": "ಅಮ್ಮಾ! ನೀವು? ಸ್ಕೂಟಿ ಮೇಲೆ?"}, {"id": 115, "duration_s": 2.14, "emotion": "proud", "text": "ಎಂಬತ್ತರ ಇಸವಿ ಲೈಸೆನ್ಸ್, ಮಗನೇ!"}, {"id": 116, "duration_s": 1.87, "emotion": "determined", "text": "ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ!"}, {"id": 117, "duration_s": 2.62, "emotion": "proud", "text": "ಇವರಿಗೂ ಸ್ಕೂಟಿ ನಾನೇ ಕಲಿಸಿದ್ದು!"}, {"id": 118, "duration_s": 2.46, "emotion": "excited", "text": "ಫಸ್ಟ್ ಕ್ಲಾಸ್! ನೂರಕ್ಕೆ ನೂರು!"}, {"id": 119, "duration_s": 2.05, "emotion": "proud", "text": "ನಾನ್ಯಾರಿಗೂ ಹೆದರಲ್ಲ!"}, {"id": 120, "duration_s": 2.96, "emotion": "giggly", "text": "ಅಪ್ಪಾ... ಮತ್ತೆ ಉಲ್ಟಾ!"}, {"id": 121, "duration_s": 1.81, "emotion": "mischievous", "text": "ಈಗ ನೋಡ್ತೀನಿ..."}, {"id": 122, "duration_s": 2.52, "emotion": "determined", "text": "ಗಾಡಿ ಓಡಿಸುವಾಗ... ಫೋನ್ ಇಲ್ಲ!"}, {"id": 123, "duration_s": 1.45, "emotion": "tender", "text": "ಮೊದಲು ನೀವು."}, {"id": 124, "duration_s": 1.3, "emotion": "excited", "text": "ಪಾಸ್!"}, {"id": 125, "duration_s": 3.54, "emotion": "serious", "text": "ಆದ್ರೆ ನಿಜವಾದ ಲೈಸೆನ್ಸ್ ಆರ್ಟಿಒ ಕೊಡುತ್ತೆ, ನಾನಲ್ಲ."}, {"id": 126, "duration_s": 2.63, "emotion": "excited", "text": "ಶಿವಣ್ಣ ಪಾಸ್! ಶಿವಣ್ಣ ಪಾಸ್!"}, {"id": 127, "duration_s": 2.95, "emotion": "excited", "text": "ನಮ್ಮಪ್ಪನ ಹತ್ರ ಈಗ... ಮೀಸೆನೂ, ಲೈಸೆನ್ಸೂ!"}, {"id": 128, "duration_s": 1.79, "emotion": "happy", "text": "ದಾಸ! ಚಪ್ಪಾಳೆ!"}, {"id": 129, "duration_s": 3.26, "emotion": "excited", "text": "'ಅಪ್ಪನ ಮೊದಲ ರೈಡ್'! ಹತ್ತು ಲಕ್ಷ ವ್ಯೂಸ್!"}, {"id": 130, "duration_s": 3.31, "emotion": "comic_panic", "text": "ನನ್ ಕೂದಲು! ಹತ್ತು ಲಕ್ಷ ಜನ ನೋಡಿದ್ರಾ?!"}, {"id": 131, "duration_s": 3.06, "emotion": "laughing", "text": "ಹ ಹ! ಈಗ ಬಾಚಣಿಗೆಗೂ ಹೆಲ್ಮೆಟ್ ಬೇಕು!"}, {"id": 132, "duration_s": 2.54, "emotion": "calm", "text": "ಶಿವಣ್ಣ... ಒಂದು ಮಾತು ನೆನಪಿಡು."}, {"id": 133, "duration_s": 3.57, "emotion": "serious", "text": "ಹೆಲ್ಮೆಟ್ ತಲೆಗಾಗಿ, ಕೂದಲಿಗಲ್ಲ."}, {"id": 134, "duration_s": 5.13, "emotion": "calm", "text": "ಪಟ್ಟಿ ಕಟ್ಟು, ಎರಡೂ ಕೈ ಹ್ಯಾಂಡಲ್ ಮೇಲೆ, ಫೋನ್ ಜೇಬಲ್ಲಿ."}, {"id": 135, "duration_s": 5.54, "emotion": "tender", "text": "ಮತ್ತೆ ಮಕ್ಕಳೇ? ಗಾಡಿ ಹದಿನೆಂಟರ ಮೇಲೆ, ಲೈಸೆನ್ಸ್ ಜೊತೆ."}, {"id": 136, "duration_s": 2.1, "emotion": "proud", "text": "ಅಷ್ಟೊತ್ತು... ಚಪ್ಪಾಳೆ!"}, {"id": 137, "duration_s": 4.62, "emotion": "happy", "text": "ಅರ್ಥ ಆಯ್ತು, ಅಪ್ಪಾಜಿ! ತಲೆ ಮೊದಲು, ಕೂದಲು ಆಮೇಲೆ!"}, {"id": 138, "duration_s": 0.77, "emotion": "excited", "text": "ಶಿವಣ್ಣ, ಸ್ಮೈಲ್!"}, {"id": 139, "duration_s": 4.46, "emotion": "shocked", "text": "ನನ್ ಸಿಂಹಿಣಿ...?"}, {"id": 140, "duration_s": 3.47, "emotion": "sad", "text": "ನಲ್ವತ್ತೆರಡು... ಎಣಿಸ್ಲಾ?"}]