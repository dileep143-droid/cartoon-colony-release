[{"id": 1, "duration_s": 5.12, "emotion": "calm", "text": "ରବିବାର ସନ୍ଧ୍ୟା। ମହାନ୍ତି ବାବୁଙ୍କ ଘରେ ସତ୍ୟନାରାୟଣ ପୂଜା।"}, {"id": 2, "duration_s": 2.95, "emotion": "excited", "text": "ବାନାନା କିଙ୍ଗଡମ୍! ଊ ଊ ଆ ଆ!"}, {"id": 3, "duration_s": 1.66, "emotion": "excited", "text": "ଖାଲି ନିରାନବେ ଟଙ୍କା ବା!"}, {"id": 4, "duration_s": 0.78, "emotion": "shocked", "text": "ପୁଣି କଟିଲା?!"}, {"id": 5, "duration_s": 1.39, "emotion": "embarrassed", "text": "ଊ ଊ ଆ ଆ?"}, {"id": 6, "duration_s": 3.92, "emotion": "mischievous", "text": "ଏ ସବୁ ଆରମ୍ଭ ହୋଇଥିଲା... ତିନି ଦିନ ଆଗରୁ।"}, {"id": 7, "duration_s": 2.0, "emotion": "mischievous", "text": "ଗୋଟେ କଦଳୀ ଖେଳରୁ।"}, {"id": 8, "duration_s": 3.22, "emotion": "angry", "text": "ତୁକୁ! ଏ ଫୋନ୍ 'ଗୁଡ୍ ମର୍ଣ୍ଣିଂ' ପଠାଉନି!"}, {"id": 9, "duration_s": 2.68, "emotion": "proud", "text": "ହୋଇଗଲା। ଚଉଦ ଗ୍ରୁପ୍‌କୁ ପଠେଇଦେଲି।"}, {"id": 10, "duration_s": 1.79, "emotion": "proud", "text": "ସାରା ପଡ଼ା ଦେଖିବେ!"}, {"id": 11, "duration_s": 2.329, "emotion": "excited", "text": "ଆଈ! ଏଥିରେ ମାଙ୍କଡ଼ ଖେଳ ଅଛି!"}, {"id": 12, "duration_s": 3.92, "emotion": "tired", "text": "ପାଞ୍ଚ ମିନିଟ୍ ଖେଳ। ମୁଁ ଖାଲି ଆଖି ବୁଜି..."}, {"id": 13, "duration_s": 2.81, "emotion": "excited", "text": "ବାନାନା କିଙ୍ଗଡମ୍‌କୁ ସ୍ୱାଗତ ବା!"}, {"id": 14, "duration_s": 3.88, "emotion": "excited", "text": "କଦଳୀ ସରିଲା! ନିରାନବେ ଟଙ୍କାକେ ଶହେ କଦଳୀ!"}, {"id": 15, "duration_s": 2.79, "emotion": "curious", "text": "ନିରାନବେ ଟଙ୍କା? ସତରେ ଟଙ୍କା?"}, {"id": 16, "duration_s": 2.63, "emotion": "mischievous", "text": "ବାୟା ହେଲୁ କି? ଖେଳର ଟଙ୍କା ନକଲି!"}, {"id": 17, "duration_s": 1.33, "emotion": "mischievous", "text": "ଗୋଟେ ଆଇଡିଆ ଅଛି!"}, {"id": 18, "duration_s": 3.17, "emotion": "excited", "text": "ଶବ୍ଦ ଶୁଣିଲୁ? ଆମକୁ ଟଙ୍କା ମିଳୁଛି!"}, {"id": 19, "duration_s": 1.83, "emotion": "laughing", "text": "ଆଉ ଗୋଟେ! ହା! ଆଉ!"}, {"id": 20, "duration_s": 2.13, "emotion": "happy", "text": "ସାରା ପଡ଼ା... ଦେଖିବେ..."}, {"id": 21, "duration_s": 3.55, "emotion": "excited", "text": "ଶାବାସ୍! ତୁମେ କଦଳୀ କିଙ୍ଗଡମ୍‌ର ରାଜା ବା!"}, {"id": 22, "duration_s": 3.14, "emotion": "calm", "