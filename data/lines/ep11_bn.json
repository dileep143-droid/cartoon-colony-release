[{"id": 1, "duration_s": 3.37, "emotion": "embarrassed", "text": "হ্যাঁ, এটা আমি! ভাবছ, এ কী করে হল?"}, {"id": 2, "duration_s": 5.05, "emotion": "mischievous", "text": "সকাল থেকেই শুরু করি। পাড়ায় এল... এক নতুন বাইক।"}, {"id": 3, "duration_s": 5.26, "emotion": "proud", "text": "নতুন বাইক! পুরো আশি হাজার... এক টাকাও কম নয়!"}, {"id": 4, "duration_s": 2.53, "emotion": "mischievous", "text": "আমার বাবার বাইক! তোর বাবার কী আছে?"}, {"id": 5, "duration_s": 2.18, "emotion": "proud", "text": "আমার বাবার আছে... গোঁফ!"}, {"id": 6, "duration_s": 3.31, "emotion": "sarcastic", "text": "গোঁফ তো আমার বাবারও আছে... বাইকসুদ্ধ!"}, {"id": 7, "duration_s": 2.84, "emotion": "shocked", "text": "গোঁফ?! এ যে মান-সম্মানের প্রশ্ন!"}, {"id": 8, "duration_s": 2.49, "emotion": "proud", "text": "সন্ধ্যেয় আমার গাড়ি ছুটবে এই গলিতে!"}, {"id": 9, "duration_s": 3.99, "emotion": "excited", "text": "শুনেছ? হারু গাড়ি আনছে... জাহাজের সাইজ!"}, {"id": 10, "duration_s": 3.01, "emotion": "sarcastic", "text": "সন্ধ্যায় গাড়ি এল... কিন্তু চলে নয়!"}, {"id": 11, "duration_s": 2.4, "emotion": "tired", "text": "এল... আমার বাঘিনী।"}, {"id": 12, "duration_s": 2.41, "emotion": "sarcastic", "text": "এটা চলে, না এটাকেও ঠেলতে হয়?"}, {"id": 13, "duration_s": 7.729, "emotion": "proud", "text": "ভিন্টেজ! মানে পুরোনো চাল... ভাতে বাড়ে!"}, {"id": 14, "duration_s": 3.471, "emotion": "comic_panic", "text": "আমি... কাউকে ডরাই না!"}, {"id": 15, "duration_s": 3.73, "emotion": "laughing", "text": "হা হা! স্কুটি পনেরো হাজার, ধোঁয়া ফ্রি!"}, {"id": 16, "duration_s": 0.64, "emotion": "stern_warning", "text": "হারেন!"}, {"id": 17, "duration_s": 2.13, "emotion": "excited", "text": "চলল! বাবা, চলল!"}, {"id": 18, "duration_s": 3.76, "emotion": "serious", "text": "নজর লাগলে? নেবু-লঙ্কা লাগবেই!"}, {"id": 19, "duration_s": 3.49, "emotion": "proud", "text": "সারা পাড়া দেখবে! আমার ছেলের গাড়ি!"}, {"id": 20, "duration_s": 2.88, "emotion": "proud", "text": "আজ চুল এমন সেট... বাইকও লজ্জা পাবে।"}, {"id": 21, "duration_s": 0.84, "emotion": "stern_warning", "text": "হেলমেট পরো।"}, {"id": 22, "duration_s": 3.18, "emotion": "pleading", "text": "হেলমেটে চুল নষ্ট হয়, মিতালী! কক্ষনো না!"}, {"id": 23, "duration_s": 1.94, "emotion": "determined", "text": "ব্যস! এবার আমি দেখছি।"}, {"id": 24, "duration_s": 2.18, "emotion": "comic_panic", "text": "কাউকে ডরাই না... শুধু টিকটিকি!"}, {"id": 25, "duration_s": 3.16, "emotion": "sarcastic", "text": "টিকটিকি গেছে। এবার চুলও যাবে।"}, {"id": 26, "duration_s": 2.02, "emotion": "giggly", "text": "বাবা, হেলমেট উল্টো!"}, {"id": 27, "duration_s": 2.53, "emotion": "proud", "text": "জানি! এটা পেছনের লোকের জন্য!"}, {"id": 28, "duration_s": 2.0, "emotion": "excited", "text": "লাইভ চলছে! বাবার উল্টো হেলমেট!"}, {"id": 29, "duration_s": 3.798, "emotion": "sad", "text": "আমার চুল... শহিদ হল।"}, {"id": 30, "duration_s": 1.33, "emotion": "stern_warning", "text": "ফিতেটাও বাঁধো।"}, {"id": 31, "duration_s": 0.66, "emotion": "mischievous", "text": "কাল থেকে।"}, {"id": 32, "duration_s": 2.03, "emotion": "excited", "text": "চিন্তা নেই! আজ আমি শেখাব।"}, {"id": 33, "duration_s": 2.04, "emotion": "proud", "text": "স্কুটিতে ক্লাচ নেই, শুধু রেস দাও!"}, {"id": 34, "duration_s": 2.1, "emotion": "sarcastic", "text": "দাদা, আগে চালু তো করো!"}, {"id": 35, "duration_s": 2.08, "emotion": "excited", "text": "দেখো! আমি উড়ছি!"}, {"id": 36, "duration_s": 2.35, "emotion": "proud", "text": "হিরো! দশ কিলোমিটার হয়ে গেল!"}, {"id": 37, "duration_s": 0.99, "emotion": "proud", "text": "না নড়ে!"}, {"id": 38, "duration_s": 1.99, "emotion": "shouting", "text": "রেস দাও! এগো! এগো!"}, {"id": 39, "duration_s": 1.97, "emotion": "comic_panic", "text": "এগোব কী? গাড়ি যে পেছোচ্ছে!"}, {"id": 40, "duration_s": 1.43, "emotion": "comic_panic", "text": "ব্রেক! ব্রেক! হাতের ব্রেক!"}, {"id": 41, "duration_s": 3.24, "emotion": "embarrassed", "text": "আমি ঠিক আছি। গাড়িও ঠিক।"}, {"id": 42, "duration_s": 2.96, "emotion": "serious", "text": "নজর লেগেছে! বলিনি আমি?"}, {"id": 43, "duration_s": 3.06, "emotion": "sad", "text": "উফ! নেবুতে ব্রেক কষে না, দিদিমা।"}, {"id": 44, "duration_s": 4.335, "emotion": "angry", "text": "ভোম্বল! আগে নিজে শেখ!"}, {"id": 45, "duration_s": 2.12, "emotion": "embarrassed", "text": "চিন্তা নেই... টিপ একদম পাকা ওনার।"}, {"id": 46, "duration_s": 3.29, "emotion": "mischievous", "text": "একটা আইডিয়া! বাবার চেয়ে আমরাই ভালো চালাব।"}, {"id": 47, "duration_s": 2.44, "emotion": "excited", "text": "পেছনে বসব... খাবারসহ।"}, {"id": 48, "duration_s": 1.19, "emotion": "stern_warning", "text": "চুপ! হাত সরাও!"}, {"id": 49, "duration_s": 2.74, "emotion": "serious", "text": "বাচ্চারা গাড়ি চালায় না। কক্ষনো না। বুঝলে?"}, {"id": 50, "duration_s": 2.96, "emotion": "serious", "text": "বলব? আঠারোর আগে গাড়ি চালানো বারণ।"}, {"id": 51, "duration_s": 3.37, "emotion": "serious", "text": "পা মাটি ছোঁয় না। ব্রেক কষবে কী করে?"}, {"id": 52, "duration_s": 1.34, "emotion": "proud", "text": "চাবি জব্দ!"}, {"id": 53, "duration_s": 2.8, "emotion": "excited", "text": "আরেকটা আইডিয়া! বাবাকে আমরা শেখাব!"}, {"id": 54, "duration_s": 4.19, "emotion": "tired", "text": "আমি কাউকে ডরাই না... ঘ্যাঁ-র-র..."}, {"id": 55, "duration_s": 3.91, "emotion": "proud", "text": "দেখো পাড়া! হারু ঘোষ... অন দ্য রোড!"}, {"id": 56, "duration_s": 3.0, "emotion": "proud", "text": "হ্যাঁ হিসেবি হারেন? স্কুটি হাওয়ায় উড়ছে!"}, {"id": 57, "duration_s": 3.71, "emotion": "sarcastic", "text": "হাওয়া নয়, আমার সঙ্গে কথা বলছ। সামনে দেখো!"}, {"id": 58, "duration_s": 2.59, "emotion": "happy", "text": "নমস্কার খোকার মা! হ্যাঁ হারেন, বলো!"}, {"id": 59, "duration_s": 4.81, "emotion": "sarcastic", "text": "এক হাতে ফোন, অন্য হাতে নমস্কার... গাড়ি কার হাতে?"}, {"id": 60, "duration_s": 2.01, "emotion": "comic_panic", "text": "হারু! সামনে দেখো! সামনে!"}, {"id": 61, "duration_s": 3.14, "emotion": "curious", "text": "সামনে? হিসেবি হারেন, আপনি তো ফোনে!"}, {"id": 62, "duration_s": 3.59, "emotion": "embarrassed", "text": "আমি ঠিক! গাড়িও ঠিক! বাক্স...?"}, {"id": 63, "duration_s": 3.69, "emotion": "crying", "text": "আমার বাক্স! আমার শোকেস!"}, {"id": 64, "duration_s": 2.92, "emotion": "shocked", "text": "খালি! এটাও খালি!"}, {"id": 65, "duration_s": 5.15, "emotion": "sad", "text": "ইশ! সব খালি! একটাও মিষ্টি নেই!"}, {"id": 66, "duration_s": 2.42, "emotion": "stern_warning", "text": "হারেন! বাক্স খালি?"}, {"id": 67, "duration_s": 3.77, "emotion": "embarrassed", "text": "দেখানোর জন্য! ভরা বাক্সে খরচ বেশি!"}, {"id": 68, "duration_s": 3.0, "emotion": "proud", "text": "দেখলে? হেলমেটে শুধু বাক্স পড়ল।"}, {"id": 69, "duration_s": 1.73, "emotion": "serious", "text": "ভাবো, হেলমেট না থাকলে?"}, {"id": 70, "duration_s": 1.63, "emotion": "happy", "text": "তাহলে চুল বাঁচত!"}, {"id": 71, "duration_s": 5.11, "emotion": "sarcastic", "text": "এত হইচইয়েও... কনস্টেবল ঘুমরাম ঘুমোচ্ছিলেন।"}, {"id": 72, "duration_s": 7.772, "emotion": "shouting", "text": "সিঙাড়া? মানে... তদন্ত হবে!"}, {"id": 73, "duration_s": 7.47, "emotion": "stern_warning", "text": "ফিতে খোলা, হাতে ফোন... লাইসেন্স দেখাও!"}, {"id": 74, "duration_s": 4.21, "emotion": "sarcastic", "text": "এটা রেশন কার্ড।"}, {"id": 75, "duration_s": 5.21, "emotion": "curious", "text": "এটা জিম কার্ড। তুমি জিমে যাও?"}, {"id": 76, "duration_s": 3.27, "emotion": "embarrassed", "text": "কার্ডই যায়।"}, {"id": 77, "duration_s": 3.37, "emotion": "shocked", "text": "এ তো... কোনো বাচ্চার রিপোর্ট কার্ড!"}, {"id": 78, "duration_s": 1.25, "emotion": "embarrassed", "text": "বাবা! ওটা আমার!"}, {"id": 79, "duration_s": 5.05, "emotion": "serious", "text": "লাইসেন্স নেই, ফোনে কথা... চালান কাটব!"}, {"id": 80, "duration_s": 4.08, "emotion": "pleading", "text": "কনস্টেবলবাবু... গরম সিঙাড়া? চালানের বদলে?"}, {"id": 81, "duration_s": 4.77, "emotion": "stern_warning", "text": "ঘুষ? তাও আলুর সিঙাড়ায়? একদম না!"}, {"id": 82, "duration_s": 1.25, "emotion": "embarrassed", "text": "খিদে পেয়েছে!"}, {"id": 83, "duration_s": 3.05, "emotion": "serious", "text": "আগে আরটিও যাও। লার্নার লাইসেন্স করাও।"}, {"id": 84, "duration_s": 2.29, "emotion": "sarcastic", "text": "জরিমানা কাটব তোমার হাতখরচ থেকে।"}, {"id": 85, "duration_s": 3.37, "emotion": "shocked", "text": "আমার হাতখরচ? আমি তো বাবা!"}, {"id": 86, "duration_s": 2.44, "emotion": "determined", "text": "বাবা, কাল থেকে... পাড়া ড্রাইভিং স্কুল!"}, {"id": 87, "duration_s": 2.84, "emotion": "excited", "text": "এক সপ্তাহ পর... বাচ্চারা খুলল ড্রাইভিং স্কুল!"}, {"id": 88, "duration_s": 3.06, "emotion": "excited", "text": "পাড়া ড্রাইভিং স্কুল! আজ সবার টেস্ট!"}, {"id": 89, "duration_s": 6.12, "emotion": "serious", "text": "বলব? চার নিয়ম: হেলমেট, দু'হাত, ফোন নয়, লাইসেন্স।"}, {"id": 90, "duration_s": 3.07, "emotion": "proud", "text": "আর বাচ্চারা? শুধু হাততালি!"}, {"id": 91, "duration_s": 5.36, "emotion": "proud", "text": "আরটিওর লার্নার লাইসেন্স! এখন আমি আধা ড্রাইভার!"}, {"id": 92, "duration_s": 2.76, "emotion": "proud", "text": "বিজ্ঞান বলে, হেলমেটে মাথা গরম হয়।"}, {"id": 93, "duration_s": 2.95, "emotion": "serious", "text": "বিজ্ঞান এটাও বলে: হেলমেটে মাথা বাঁচে।"}, {"id": 94, "duration_s": 3.97, "emotion": "embarrassed", "text": "...হ্যাঁ, সেটাও।"}, {"id": 95, "duration_s": 0.61, "emotion": "serious", "text": "মাস্টারমশাই, প্রথম নিয়ম: ব্রেক!"}, {"id": 96, "duration_s": 2.9, "emotion": "happy", "text": "ব্রেক? হ্যাঁ হ্যাঁ, টিফিন ব্রেক!"}, {"id": 97, "duration_s": 1.08, "emotion": "shouting", "text": "ইন্ডিকেটর!"}, {"id": 98, "duration_s": 2.95, "emotion": "proud", "text": "ইন্ডিয়া গেট? সে তো দিল্লিতে, বাবা!"}, {"id": 99, "duration_s": 1.21, "emotion": "shouting", "text": "লাইসেন্স!"}, {"id": 100, "duration_s": 2.54, "emotion": "stern_warning", "text": "সাইলেন্স? হ্যাঁ! সবাই চুপ!"}, {"id": 101, "duration_s": 1.48, "emotion": "happy", "text": "চলো, যাই!"}, {"id": 102, "duration_s": 2.23, "emotion": "serious", "text": "এটাকেও নজর লেগেছে!"}, {"id": 103, "duration_s": 1.82, "emotion": "curious", "text": "প্রথম ক্যান্ডিডেট... অটো?"}, {"id": 104, "duration_s": 2.55, "emotion": "excited", "text": "লাইভ চলছে! পাড়ার মহা-টেস্ট!"}, {"id": 105, "duration_s": 2.12, "emotion": "proud", "text": "চিন্তা নেই! হিরোর হেলমেট লাগে না!"}, {"id": 106, "duration_s": 4.8, "emotion": "stern_warning", "text": "হেলমেট নেই? বাইরে!"}, {"id": 107, "duration_s": 3.68, "emotion": "serious", "text": "এক, দুই, তিন... দাঁড়াও, আবার... এক..."}, {"id": 108, "duration_s": 2.83, "emotion": "angry", "text": "হারেন! এটা টেস্ট, হিসেব নয়!"}, {"id": 109, "duration_s": 2.11, "emotion": "stern_warning", "text": "আমার বাক্স! একটাও কম নয়!"}, {"id": 110, "duration_s": 2.03, "emotion": "serious", "text": "সময় শেষ! পরের জন!"}, {"id": 111, "duration_s": 1.77, "emotion": "excited", "text": "শুনেছ? আমি টেস্ট দিচ্ছি..."}, {"id": 112, "duration_s": 1.26, "emotion": "stern_warning", "text": "ফোন!"}, {"id": 113, "duration_s": 0.8, "emotion": "embarrassed", "text": "...পরে শোনাব।"}, {"id": 114, "duration_s": 2.62, "emotion": "shocked", "text": "মা! আপনি? স্কুটিতে?"}, {"id": 115, "duration_s": 2.5, "emotion": "proud", "text": "উনিশশো আশির লাইসেন্স, বাবা!"}, {"id": 116, "duration_s": 1.75, "emotion": "determined", "text": "সারা পাড়া দেখবে!"}, {"id": 117, "duration_s": 2.74, "emotion": "proud", "text": "এঁকেও স্কুটি আমিই শিখিয়েছিলাম!"}, {"id": 118, "duration_s": 2.43, "emotion": "excited", "text": "ফার্স্ট ক্লাস! একশোয় একশো!"}, {"id": 119, "duration_s": 1.38, "emotion": "proud", "text": "আমি কাউকে ডরাই না!"}, {"id": 120, "duration_s": 2.94, "emotion": "giggly", "text": "বাবা... আবার উল্টো!"}, {"id": 121, "duration_s": 1.45, "emotion": "mischievous", "text": "এবার দেখছি..."}, {"id": 122, "duration_s": 2.61, "emotion": "determined", "text": "গাড়ি চালানোর সময়... ফোন নয়!"}, {"id": 123, "duration_s": 0.72, "emotion": "tender", "text": "আগে আপনি।"}, {"id": 124, "duration_s": 1.23, "emotion": "excited", "text": "পাশ!"}, {"id": 125, "duration_s": 3.56, "emotion": "serious", "text": "কিন্তু আসল লাইসেন্স দেবে আরটিও, আমি নয়।"}, {"id": 126, "duration_s": 3.18, "emotion": "excited", "text": "হারু পাশ! হারু পাশ!"}, {"id": 127, "duration_s": 3.25, "emotion": "excited", "text": "আমার বাবার এখন গোঁফও, লাইসেন্সও!"}, {"id": 128, "duration_s": 2.21, "emotion": "happy", "text": "হারেন! তালি!"}, {"id": 129, "duration_s": 2.54, "emotion": "excited", "text": "'বাবার প্রথম রাইড'! দশ লাখ ভিউজ!"}, {"id": 130, "duration_s": 3.94, "emotion": "comic_panic", "text": "আমার চুল! দশ লাখ লোক দেখে ফেলল?!"}, {"id": 131, "duration_s": 2.46, "emotion": "laughing", "text": "হা হা! চিরুনিরও হেলমেট চাই!"}, {"id": 132, "duration_s": 3.55, "emotion": "calm", "text": "হারু... একটা কথা মনে রেখো।"}, {"id": 133, "duration_s": 3.87, "emotion": "serious", "text": "হেলমেট মাথার জন্য, চুলের জন্য নয়।"}, {"id": 134, "duration_s": 6.02, "emotion": "calm", "text": "ফিতে বাঁধো, দু'হাত হ্যান্ডেলে, ফোন পকেটে।"}, {"id": 135, "duration_s": 5.48, "emotion": "tender", "text": "আর বাচ্চারা? গাড়ি আঠারোর পরে, লাইসেন্স নিয়ে।"}, {"id": 136, "duration_s": 1.66, "emotion": "proud", "text": "ততদিন... তালি!"}, {"id": 137, "duration_s": 4.5, "emotion": "happy", "text": "বুঝেছি, বাবা! মাথা আগে, চুল পরে।"}, {"id": 138, "duration_s": 1.12, "emotion": "excited", "text": "স্মাইল, বাবা!"}, {"id": 139, "duration_s": 1.64, "emotion": "shocked", "text": "আমার বাঘিনী...?"}, {"id": 140, "duration_s": 2.79, "emotion": "sad", "text": "বিয়াল্লিশ... আবার গুনব?"}]