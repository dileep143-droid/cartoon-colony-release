[{"id": 1, "duration_s": 4.42, "emotion": "calm", "text": "রবিবারের সন্ধ্যে। হারুবাবুর বাড়িতে সত্যনারায়ণের পুজো।"}, {"id": 2, "duration_s": 2.13, "emotion": "excited", "text": "বানানা কিংডম! উ উ আ আ!"}, {"id": 3, "duration_s": 1.8, "emotion": "excited", "text": "মাত্তর নিরানব্বই বাহে!"}, {"id": 4, "duration_s": 1.08, "emotion": "shocked", "text": "আবার কাটল?!"}, {"id": 5, "duration_s": 1.4, "emotion": "embarrassed", "text": "উ উ আ আ?"}, {"id": 6, "duration_s": 2.93, "emotion": "mischievous", "text": "সব শুরু... তিনদিন আগে।"}, {"id": 7, "duration_s": 1.79, "emotion": "mischievous", "text": "একটা কলার গেম থেকে।"}, {"id": 8, "duration_s": 2.52, "emotion": "angry", "text": "বাপি! ফোনটা 'গুড মর্নিং' পাঠাচ্ছেই না!"}, {"id": 9, "duration_s": 2.12, "emotion": "proud", "text": "হয়ে গেছে। চোদ্দোটা গ্রুপে গেছে।"}, {"id": 10, "duration_s": 1.61, "emotion": "proud", "text": "পাড়াসুদ্ধু দেখবে!"}, {"id": 11, "duration_s": 2.99, "emotion": "excited", "text": "ঠাকুমা! ওতে বাঁদরের গেম আছে!"}, {"id": 12, "duration_s": 2.82, "emotion": "tired", "text": "পাঁচ মিনিট খেল। আমি শুধু চোখ বুজে..."}, {"id": 13, "duration_s": 3.49, "emotion": "excited", "text": "বানানা কিংডমত স্বাগতম বাহে!"}, {"id": 14, "duration_s": 4.35, "emotion": "excited", "text": "কলা শ্যাষ! খালি নিরানব্বই টাকাত একশো কলা!"}, {"id": 15, "duration_s": 2.97, "emotion": "curious", "text": "নিরানব্বই টাকা? সত্যিকারের?"}, {"id": 16, "duration_s": 2.55, "emotion": "mischievous", "text": "বোকা! গেমের টাকা নকল হয়।"}, {"id": 17, "duration_s": 0.98, "emotion": "mischievous", "text": "একটা আইডিয়া!"}, {"id": 18, "duration_s": 2.53, "emotion": "excited", "text": "শুনলি? আমরা টাকা পাচ্ছি!"}, {"id": 19, "duration_s": 0.63, "emotion": "laughing", "text": "আরেক! হি হি! আরেক!"}, {"id": 20, "duration_s": 3.22, "emotion": "happy", "text": "পাড়াসুদ্ধু... দেখবে..."}, {"id": 21, "duration_s": 3.66, "emotion": "excited", "text": "সাবাশ বাহে! তুই কলা কিংডমের রাজা!"}, {"id": 22, "duration_s": 4.01, "emotion": "calm", "text": "সেদিন সকালে। বারান্দায় হারুবাবুর আরাম।"}, {"id": 23, "duration_s": 4.34, "emotion": "proud", "text": "আমার ব্যাংক অ্যাকাউন্ট... লোহার সিন্দুক, ভোম্বল!"}, {"id": 24, "duration_s": 1.06, "emotion": "sarcastic", "text": "ভেতরে কিছু আছে?"}, {"id": 25, "duration_s": 3.9, "emotion": "neutral", "text": "নিরানব্বই কাটল? যাক... চায়ের খরচ।"}, {"id": 26, "duration_s": 2.02, "emotion": "shocked", "text": "চারশো নিরানব্বই?!"}, {"id": 27, "duration_s": 2.36, "emotion": "curious", "text": "দাদা, সিন্দুকে ফুটো!"}, {"id": 28, "duration_s": 4.26, "emotion": "panicked", "text": "নশো নিরানব্বই! এ চোর নয়... ডাকাত!"}, {"id": 29, "duration_s": 1.67, "emotion": "excited", "text": "ঘাবড়িও না! ফোনটাই বেচে দাও!"}, {"id": 30, "duration_s": 2.6, "emotion": "determined", "text": "আমি কাউকে ডরাই না! চোরকে..."}, {"id": 31, "duration_s": 1.0, "emotion": "comic_panic", "text": "টি-টিকটিকি!"}, {"id": 32, "duration_s": 1.11, "emotion": "sarcastic", "text": "কাউকে ডরাও না? টিকটিকিকেও না?"}, {"id": 33, "duration_s": 4.1, "emotion": "embarrassed", "text": "ও তো চোরের চর! গুপ্তচর!"}, {"id": 34, "duration_s": 1.99, "emotion": "calm", "text": "ব্যস! এবার আমি দেখছি—"}, {"id": 35, "duration_s": 2.05, "emotion": "shouting", "text": "না! এ পুলিশ কেস!"}, {"id": 36, "duration_s": 4.37, "emotion": "scared_whisper", "text": "হ্যালো, থানা? আমার অ্যাকাউন্ট... লুট হচ্ছে!"}, {"id": 37, "duration_s": 3.75, "emotion": "serious", "text": "তদন্ত হবে! পুরো তদন্ত হবে!"}, {"id": 38, "duration_s": 3.07, "emotion": "panicked", "text": "স্যার, চোর দেখা যায় না... শুধু টাকা কাটে!"}, {"id": 39, "duration_s": 4.77, "emotion": "curious", "text": "হুম... সূত্রের গন্ধ পাচ্ছি।"}, {"id": 40, "duration_s": 4.89, "emotion": "serious", "text": "চোর কখন আসে? কী পরে? চাটনি কোথায়?"}, {"id": 41, "duration_s": 1.54, "emotion": "embarrassed", "text": "খিদে পেয়েছে!"}, {"id": 42, "duration_s": 4.54, "emotion": "serious", "text": "লেখো... চোর... খিদেয় কাতর।"}, {"id": 43, "duration_s": 2.26, "emotion": "curious", "text": "খিদেয়? কী করে বুঝলেন?"}, {"id": 44, "duration_s": 2.06, "emotion": "proud", "text": "পকোড়া শেষ হয়ে গেল না!"}, {"id": 45, "duration_s": 2.13, "emotion": "pleading", "text": "স্যার? স্যার! চোর!"}, {"id": 46, "duration_s": 1.34, "emotion": "sarcastic", "text": "আরেকটা পকোড়া?"}, {"id": 47, "duration_s": 2.26, "emotion": "excited", "text": "তদন্ত হবে!"}, {"id": 48, "duration_s": 6.125, "emotion": "serious", "text": "থানায় গিয়ে রিপোর্ট খাব। মানে... লিখব।"}, {"id": 49, "duration_s": 3.43, "emotion": "sad", "text": "উফ! চোরও খিদেয়... কনস্টেবলও খিদেয়!"}, {"id": 50, "duration_s": 3.73, "emotion": "mischievous", "text": "এক ঘণ্টায়... খবর পুরো পাড়ায়।"}, {"id": 51, "duration_s": 2.39, "emotion": "excited", "text": "শুনেছ কী? হারুর ফোনে চোর!"}, {"id": 52, "duration_s": 2.71, "emotion": "scared_whisper", "text": "শুনেছ কী? চোর অদৃশ্য!"}, {"id": 53, "duration_s": 2.04, "emotion": "shocked", "text": "শুনেছ কী? চোর বাঁদর!"}, {"id": 54, "duration_s": 1.04, "emotion": "proud", "text": "বিজ্ঞান বলছে..."}, {"id": 55, "duration_s": 2.08, "emotion": "serious", "text": "চোর... বাঁহাতি!"}, {"id": 56, "duration_s": 0.83, "emotion": "curious", "text": "কীসে জানলে?"}, {"id": 57, "duration_s": 1.93, "emotion": "proud", "text": "টাকা সবসময় বাঁ হাতে যায়!"}, {"id": 58, "duration_s": 1.72, "emotion": "stern_warning", "text": "হারেন দা!"}, {"id": 59, "duration_s": 3.12, "emotion": "serious", "text": "আমার বাঁ হাত শুধু গোনে। এক পয়সাও কম নয়!"}, {"id": 60, "duration_s": 3.28, "emotion": "serious", "text": "নজর লেগেছে! প্রতিটা ফোনে লেবু-লঙ্কা!"}, {"id": 61, "duration_s": 1.87, "emotion": "excited", "text": "লাইভ চলছে! পাড়ায় চোর!"}, {"id": 62, "duration_s": 1.23, "emotion": "determined", "text": "চলো চলো! চোর ধরতে!"}, {"id": 63, "duration_s": 1.79, "emotion": "embarrassed", "text": "উফ! চোর হেঁটেই ধরব।"}, {"id": 64, "duration_s": 2.51, "emotion": "comic_panic", "text": "উনিশশো নিরানব্বই! এক্ষুনি! হেথায়!"}, {"id": 65, "duration_s": 1.36, "emotion": "shocked", "text": "চোর আমাদের মধ্যেই!"}, {"id": 66, "duration_s": 1.49, "emotion": "shouting", "text": "তুমি! না, তুমি!"}, {"id": 67, "duration_s": 0.43, "emotion": "shouting", "text": "চুপ!"}, {"id": 68, "duration_s": 3.6, "emotion": "curious", "text": "আমি বলব? ঘরের শত্রু বিভীষণ..."}, {"id": 69, "duration_s": 0.58, "emotion": "shouting", "text": "না!"}, {"id": 70, "duration_s": 2.27, "emotion": "sarcastic", "text": "বাচ্চারা বিজ্ঞান বোঝে না!"}, {"id": 71, "duration_s": 3.34, "emotion": "scared_whisper", "text": "রাত দুটো। পুরো পাড়া ঘুমোচ্ছে..."}, {"id": 72, "duration_s": 1.35, "emotion": "mischievous", "text": "...প্রায় পুরোটা।"}, {"id": 73, "duration_s": 4.13, "emotion": "scared_whisper", "text": "আর একটা লেভেল... তারপর ঘুমোব।"}, {"id": 74, "duration_s": 1.21, "emotion": "scared_whisper", "text": "চুপ! বাঁদরটার খিদে পেল!"}, {"id": 75, "duration_s": 2.67, "emotion": "scared_whisper", "text": "চোর... ঘরের ভেতরে!"}, {"id": 76, "duration_s": 2.763, "emotion": "scared_whisper", "text": "আমি কাউকে ডরাই না... আমি কাউকে..."}, {"id": 77, "duration_s": 0.66, "emotion": "scared_whisper", "text": "কে? হাত তোলো!"}, {"id": 78, "duration_s": 1.94, "emotion": "angry", "text": "রাত-বিরেতে টর্চ?!"}, {"id": 79, "duration_s": 2.42, "emotion": "embarrassed", "text": "মা... আপনি কোনো চোর দেখেছেন?"}, {"id": 80, "duration_s": 2.73, "emotion": "tired", "text": "চোর? এখানে তো শুধু আমি।"}, {"id": 81, "duration_s": 2.11, "emotion": "relieved", "text": "হ্যাঁ... আপনি তো ঘুমোচ্ছেন।"}, {"id": 82, "duration_s": 3.38, "emotion": "serious", "text": "পাড়ায় চোর ঘুরছে। এক পয়সাও কম নয়!"}, {"id": 83, "duration_s": 1.01, "emotion": "excited", "text": "ঘাবড়িও না!"}, {"id": 84, "duration_s": 3.68, "emotion": "mischievous", "text": "গেম হ্যাক! আনলিমিটেড কলা! মোটে দুশো!"}, {"id": 85, "duration_s": 3.09, "emotion": "curious", "text": "দুশো নেই... দুটো সিঙাড়া আছে।"}, {"id": 86, "duration_s": 1.88, "emotion": "happy", "text": "চলবে! ডিল পাকা!"}, {"id": 87, "duration_s": 1.97, "emotion": "shocked", "text": "আরে! পেমেন্টই খেয়ে ফেলল!"}, {"id": 88, "duration_s": 2.59, "emotion": "stern_warning", "text": "গেম হ্যাক? আসল হ্যাক দেখবি?"}, {"id": 89, "duration_s": 2.57, "emotion": "pleading", "text": "বউদি... এ তো সমাজসেবা ছিল!"}, {"id": 90, "duration_s": 2.4, "emotion": "excited", "text": "দুশো? ওতে আমার দশ পার্সেন্ট!"}, {"id": 91, "duration_s": 0.77, "emotion": "stern_warning", "text": "হারেন দা!"}, {"id": 92, "duration_s": 2.31, "emotion": "happy", "text": "হ্যাকটা দারুণ ছিল।"}, {"id": 93, "duration_s": 4.33, "emotion": "calm", "text": "তিনদিন পর। সেই পুজো... যেখান থেকে শুরু করেছিলাম।"}, {"id": 94, "duration_s": 2.5, "emotion": "scared_whisper", "text": "আজ কোনো খরচ হবে না। আজ পুজো।"}, {"id": 95, "duration_s": 2.87, "emotion": "scared_whisper", "text": "লাইভ চলছে! হারুবাবুর পুজো, এক্সক্লুসিভ!"}, {"id": 96, "duration_s": 4.3, "emotion": "serious", "text": "আর তখন লীলাবতী... প্রসাদ খেলেন না।"}, {"id": 97, "duration_s": 1.09, "emotion": "curious", "text": "এ কোন অধ্যায়?"}, {"id": 98, "duration_s": 4.82, "emotion": "excited", "text": "এ... নতুন ভজন! কলা ভজন!"}, {"id": 99, "duration_s": 1.38, "emotion": "shocked", "text": "নজর লেগেছে!"}, {"id": 100, "duration_s": 1.91, "emotion": "excited", "text": "শুনেছ কী? ঠাকুমার ডিস্কো ভজন!"}, {"id": 101, "duration_s": 3.93, "emotion": "excited", "text": "ধন্যবাদ বাহে! নিরানব্বই টাকা!"}, {"id": 102, "duration_s": 0.99, "emotion": "shocked", "text": "আবার কাটল?!"}, {"id": 103, "duration_s": 1.44, "emotion": "embarrassed", "text": "উ উ আ আ?"}, {"id": 104, "duration_s": 1.85, "emotion": "shouting", "text": "তদন্ত হবে!"}, {"id": 105, "duration_s": 0.89, "emotion": "shocked", "text": "ঠাকুমা?!"}, {"id": 106, "duration_s": 0.88, "emotion": "curious", "text": "আমি বলব?"}, {"id": 107, "duration_s": 1.17, "emotion": "shouting", "text": "বলো!"}, {"id": 108, "duration_s": 4.26, "emotion": "serious", "text": "নিরানব্বই... চারশো নিরানব্বই... নশো নিরানব্বই..."}, {"id": 109, "duration_s": 3.34, "emotion": "serious", "text": "সব এই ফোন থেকে। পেমেন্ট হারুকাকুর কার্ডে।"}, {"id": 110, "duration_s": 2.44, "emotion": "shocked", "text": "আমার কার্ড? মায়ের ফোনে?"}, {"id": 111, "duration_s": 2.87, "emotion": "sarcastic", "text": "তুইই তো দিয়েছিলি! বিদ্যুতের বিল দিতে!"}, {"id": 112, "duration_s": 2.61, "emotion": "sad", "text": "উফ! আর সরাতে ভুলে গেছি।"}, {"id": 113, "duration_s": 3.93, "emotion": "guilty", "text": "বাবা... আগের নিরানব্বই... আমি টিপেছি।"}, {"id": 114, "duration_s": 4.03, "emotion": "guilty", "text": "আর চারশো নিরানব্বই... আমরা দুজনে।"}, {"id": 115, "duration_s": 2.65, "emotion": "guilty", "text": "ভেবেছিলাম গেমের টাকা নকল।"}, {"id": 116, "duration_s": 3.21, "emotion": "serious", "text": "টাকা আসল ছিল। শুধু কলাগুলো নকল।"}, {"id": 117, "duration_s": 2.06, "emotion": "guilty", "text": "আর রাত দুটোরগুলো... আমি।"}, {"id": 118, "duration_s": 1.06, "emotion": "shocked", "text": "রাত দুটোয়?!"}, {"id": 119, "duration_s": 2.4, "emotion": "pleading", "text": "বাঁদর খিদেয় কাতর!"}, {"id": 120, "duration_s": 5.4, "emotion": "proud", "text": "দেখলে! বলেছিলাম না, চোর খিদেয় কাতর!"}, {"id": 121, "duration_s": 3.69, "emotion": "proud", "text": "আর ঠাকুমা বাঁহাতি! বিজ্ঞান বলছে!"}, {"id": 122, "duration_s": 3.03, "emotion": "excited", "text": "শুনেছ কী? চোর... ঠাকুমা বেরোল!"}, {"id": 123, "duration_s": 2.07, "emotion": "proud", "text": "এবার আমি দেখছি! আমি কাউকে—"}, {"id": 124, "duration_s": 2.28, "emotion": "determined", "text": "ব্যস! এবার আমি দেখছি।"}, {"id": 125, "duration_s": 3.13, "emotion": "serious", "text": "এক - প্রতি পেমেন্টে পিন।"}, {"id": 126, "duration_s": 1.76, "emotion": "serious", "text": "দুই - মাসের লিমিট।"}, {"id": 127, "duration_s": 2.62, "emotion": "serious", "text": "তিন - কার্ড সরাও, অটো-পে বন্ধ।"}, {"id": 128, "duration_s": 3.56, "emotion": "shocked", "text": "এইটুকু? দশ সেকেন্ডে?"}, {"id": 129, "duration_s": 1.0, "emotion": "pleading", "text": "আর... আমাদের গেম?"}, {"id": 130, "duration_s": 3.25, "emotion": "calm", "text": "রোজ আধঘণ্টা। তারপর বাইরে ক্রিকেট!"}, {"id": 131, "duration_s": 1.68, "emotion": "excited", "text": "ক্রিকেটের পর সিঙাড়া?"}, {"id": 132, "duration_s": 0.86, "emotion": "worried", "text": "আর যে টাকা গেল?"}, {"id": 133, "duration_s": 3.93, "emotion": "calm", "text": "কোম্পানিকে অভিযোগ পাঠাব। আর এরপর... পিন!"}, {"id": 134, "duration_s": 3.96, "emotion": "calm", "text": "বাচ্চাদের ফোনের চেয়ে... আমাদের সঙ্গ বেশি দরকার।"}, {"id": 135, "duration_s": 3.2, "emotion": "serious", "text": "ফোনে পিন... বাচ্চাদের সঙ্গে সময়।"}, {"id": 136, "duration_s": 3.26, "emotion": "laughing", "text": "আর ঠাকুমার ফোনে ডবল পিন!"}, {"id": 137, "duration_s": 2.68, "emotion": "proud", "text": "আমি কাউকে ডরাই না! বল ছোড়ো!"}, {"id": 138, "duration_s": 2.63, "emotion": "mischievous", "text": "বাঁহাতি। বিজ্ঞান বলছে।"}, {"id": 139, "duration_s": 2.793, "emotion": "sad", "text": "উফ! ঠিক চটির মতো।"}, {"id": 140, "duration_s": 2.01, "emotion": "laughing", "text": "ঠাকুমা কক্ষনো ফসকায় না!"}]