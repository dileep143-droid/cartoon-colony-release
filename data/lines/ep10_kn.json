[{"id": 1, "duration_s": 3.97, "emotion": "mischievous", "text": "ರಾತ್ರಿ ಎರಡು ಗಂಟೆ... ಇಡೀ ಕಾಲೊನಿ ಗೊರಕೆ!"}, {"id": 2, "duration_s": 1.23, "emotion": "mischievous", "text": "ಒಬ್ಬರ ಬಿಟ್ಟು."}, {"id": 3, "duration_s": 1.53, "emotion": "angry", "text": "ಕಿವೀಲಿ ಏರ್‌ಪೋರ್ಟಾ?"}, {"id": 4, "duration_s": 1.66, "emotion": "proud", "text": "ನಾ ಯಾರಿಗೂ ಹೆದರಲ್ಲ!"}, {"id": 5, "duration_s": 4.35, "emotion": "giggly", "text": "ಹತ್ತು ಚಪ್ಪಾಳೆ... ಇಪ್ಪತ್ತು... ಮೂವತ್ತು..."}, {"id": 6, "duration_s": 2.35, "emotion": "sarcastic", "text": "ಚಪ್ಪಾಳೆ ಯಾಕ್ರೀ? ಮೆರವಣಿಗೆನಾ?"}, {"id": 7, "duration_s": 1.79, "emotion": "scared_whisper", "text": "ನಲವತ್ತನೇದು... ಕೊನೇದು."}, {"id": 8, "duration_s": 5.96, "emotion": "giggly", "text": "ನಲ್ವತ್ತು ಏಟು. ಸೊಳ್ಳೆ ಸೊನ್ನೆ. ಶಿವಣ್ಣ ನಲ್ವತ್ತು!"}, {"id": 9, "duration_s": 2.97, "emotion": "determined", "text": "ಸರೀರಿ! ನನ್ ಚಪ್ಪಲಿ ತಪ್ಪಲ್ಲ!"}, {"id": 10, "duration_s": 2.7, "emotion": "embarrassed", "text": "ತಪ್ಪಲಿಲ್ಲ... ನೇರ ನಂಗೇ ಬಿತ್ತು!"}, {"id": 11, "duration_s": 2.45, "emotion": "proud", "text": "ನೋಡ್ದ್ಯಾ? ಗುರಿ ಪಕ್ಕಾ."}, {"id": 12, "duration_s": 1.79, "emotion": "mischievous", "text": "ಇದು ಬರೀ... ಶುರು ಅಷ್ಟೇ."}, {"id": 13, "duration_s": 4.21, "emotion": "giggly", "text": "ಬೆಳಗಾಗ್ತಿದ್ದಂತೆ... ಇಡೀ ಕಾಲೊನಿ ಕೆರೆದ್ಕೊಳ್ತಿತ್ತು."}, {"id": 14, "duration_s": 3.13, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ರಾತ್ರಿ ಸೊಳ್ಳೆ ಸೈನ್ಯ ಬಂದಿತ್ತಂತೆ!"}, {"id": 15, "duration_s": 3.28, "emotion": "mischievous", "text": "ಶಿವಣ್ಣ ತಮ್ಗೇ ನಲವತ್ತು ಏಟು ಹೊಡ್ಕೊಂಡ್ರಂತೆ!"}, {"id": 16, "duration_s": 3.49, "emotion": "embarrassed", "text": "ಅದು ಸೊಳ್ಳೆ ಅಲ್ಲ... ಆನೆ!"}, {"id": 17, "duration_s": 2.58, "emotion": "sarcastic", "text": "ಆನೆ ಅಲ್ಲ, ಅಜ್ಜಿ ಚಪ್ಪಲಿ!"}, {"id": 18, "duration_s": 3.48, "emotion": "serious", "text": "ದೃಷ್ಟಿ ಆಯ್ತು! ಸೊಳ್ಳೆ ದೃಷ್ಟಿ!"}, {"id": 19, "duration_s": 2.49, "emotion": "shocked", "text": "ಅಯ್ಯೋ! ಮೆಣಸಿನಕಾಯೂ ತಿಂದ್ಬಿಟ್ಟಿದೆ!"}, {"id": 20, "duration_s": 3.56, "emotion": "stern_warning", "text": "ಸಮೋಸಾ? ನಿಲ್ಲಿ! ತನಿಖೆ!"}, {"id": 21, "duration_s": 3.23, "emotion": "happy", "text": "ತನಿಖೆ ಮುಗೀತು. ಹಸಿವು!"}, {"id": 22, "duration_s": 3.716, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ, ಸೊಳ್ಳೆ ಚರಂಡೀಲೇ ಹುಟ್ಟೋದು!"}, {"id": 23, "duration_s": 1.17, "emotion": "curious", "text": "ನಾನ್ ಹೇಳ್ಲಾ?"}, {"id": 24, "duration_s": 2.62, "emotion": "proud", "text": "ಮಕ್ಳು ಸುಮ್ನಿರಿ! ಸೈನ್ಸ್ ಮಾತಾಡ್ತಿದೆ."}, {"id": 25, "duration_s": 2.82, "emotion": "proud", "text": "ನಮ್ ಕಾಲೊನಿ ಕ್ಲೀನ್, ಸೊಳ್ಳೆ ಹೊರಗಿಂದ ಬರುತ್ತೆ!"}, {"id": 26, "duration_s": 5.04, "emotion": "excited", "text": "ಸೊಳ್ಳೆ-ಪ್ರೂಫ್ ಊದುಬತ್ತಿ! ಒಂದ್ ಹಚ್ಚಿ, ಸೊಳ್ಳೆ ಮಾಯ!"}, {"id": 27, "duration_s": 3.01, "emotion": "determined", "text": "ನಲವತ್ತು ಕೊಡಿ! ಒಂದು ಚಪ್ಪಾಳೆಗೆ ಒಂದು."}, {"id": 28, "duration_s": 2.88, "emotion": "stern_warning", "text": "ಹತ್ತಕ್ಕೊಂದು. ಒಂದ್ ರೂಪಾಯೂ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 29, "duration_s": 2.98, "emotion": "angry", "text": "ದಾಸಪ್ಪಣ್ಣ! ಇವು ಹೋದ್ವರ್ಷದ ಪೂಜೆದು!"}, {"id": 30, "duration_s": 3.34, "emotion": "embarrassed", "text": "ಹಳೇ ಪೂಜೆ... ಹೊಸ ಸೊಳ್ಳೆ."}, {"id": 31, "duration_s": 4.27, "emotion": "giggly", "text": "ಸಂಜೆಗೆ ಕಾಲೊನಿಗೆ ಮೋಡ ಬಂತು. ಸೊಳ್ಳೆ ಹೋಗ್ಲಿಲ್ಲ."}, {"id": 32, "duration_s": 2.84, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ಕಾಲೊನಿಗೆ ಮೋಡ!"}, {"id": 33, "duration_s": 1.88, "emotion": "determined", "text": "ದಾಸಪ್ಪಣ್ಣ, ಅಲುಗಾಡ್ಬೇಡಿ."}, {"id": 34, "duration_s": 3.24, "emotion": "tired", "text": "ಹೊಗೆ ಹೋಯ್ತು... ಸೊಳ್ಳೆ ಹೋಗ್ಲಿಲ್ಲ."}, {"id": 35, "duration_s": 3.645, "emotion": "serious", "text": "ಎರಡು ದಿನ. ದಾಸಪ್ಪನ ಮನೆ."}, {"id": 36, "duration_s": 2.95, "emotion": "loving", "text": "ಏಳು ಬೋಂಡಾ. ನಿನ್ ಇಷ್ಟದ ಲಡ್ಡು."}, {"id": 37, "duration_s": 2.68, "emotion": "shocked", "text": "ಬೋಂಡಾ... ಲಡ್ಡು ಬೇಡ ಅಂದ?!"}, {"id": 38, "duration_s": 3.142, "emotion": "tired", "text": "ಅಮ್ಮಾ... ಹಸಿವೇ... ಆಗ್ತಿಲ್ಲ."}, {"id": 39, "duration_s": 5.66, "emotion": "worried", "text": "ಜ್ವರ ಇದೆ! ರೀ, ಡಾಕ್ಟ್ರನ್ನ ಕರೀರಿ!"}, {"id": 40, "duration_s": 1.24, "emotion": "worried", "text": "ಫೀಸು... ಪರವಾಗಿಲ್ಲ! ಪರವಾಗಿಲ್ಲ!"}, {"id": 41, "duration_s": 2.9, "emotion": "calm", "text": "ಜ್ವರ ಐತಿ ಅಂದ್ರ ಬೆಳಿಗ್ಗೆ ಕ್ಲಿನಿಕ್‌ಗೆ ಬರ್ರಿ."}, {"id": 42, "duration_s": 2.52, "emotion": "serious", "text": "ಡೆಂಗ್ಯೂ ತಪಾಸಣಿ ಬೇಕು. ಭಾಳ ಹೆದರಬ್ಯಾಡ್ರಿ."}, {"id": 43, "duration_s": 1.99, "emotion": "serious", "text": "ಮನಿ ಸುತ್ತ ನಿಂತ ನೀರ ಐತೇನ್ರಿ?"}, {"id": 44, "duration_s": 1.59, "emotion": "proud", "text": "ನಮ್ ಮನೆ ಕ್ಲೀನ್!"}, {"id": 45, "duration_s": 2.77, "emotion": "serious", "text": "ಡೆಂಗ್ಯೂ ಸೊಳ್ಳಿ ಸ್ವಚ್ಛ ನಿಂತ ನೀರಾಗ ಹುಟ್ಟತೈತ್ರಿ."}, {"id": 46, "duration_s": 2.35, "emotion": "happy", "text": "ನಡೀರಿ, ಹೋಗೋಣ!"}, {"id": 47, "duration_s": 1.44, "emotion": "giggly", "text": "...ಮತ್ತೆ ತಲುಪಿದ್ವಲ್ಲ!"}, {"id": 48, "duration_s": 2.6, "emotion": "relieved", "text": "ಡೆಂಗ್ಯೂ ಅಲ್ಲ. ಸಣ್ಣ ಜ್ವರ ಅಷ್ಟೇ."}, {"id": 49, "duration_s": 2.72, "emotion": "pleading", "text": "ಸೋ... ಲಡ್ಡು?"}, {"id": 50, "duration_s": 2.14, "emotion": "stern_warning", "text": "ಗುಣ ಆದ್ಮೇಲೆ. ಒಂದೇ ಒಂದು."}, {"id": 51, "duration_s": 0.85, "emotion": "shocked", "text": "ಒಂದೇ?!"}, {"id": 52, "duration_s": 2.01, "emotion": "excited", "text": "ಒಂದ್ ಐಡಿಯಾ ಇದೆ! ನಾವೆಲ್ಲಾ..."}, {"id": 53, "duration_s": 1.69, "emotion": "excited", "text": "...ಸೊಳ್ಳೆ ಗೂಢಚಾರರು!"}, {"id": 54, "duration_s": 2.27, "emotion": "proud", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಈ ಸಲ ನಿಜಕ್ಕೂ?"}, {"id": 55, "duration_s": 1.41, "emotion": "stern_warning", "text": "ಹೇಳು! ಬೇಗ!"}, {"id": 56, "duration_s": 2.81, "emotion": "serious", "text": "ಡೆಂಗ್ಯೂ ಸೊಳ್ಳೆ ಜಾಸ್ತಿ ಹಗಲೇ ಕಚ್ಚುತ್ತೆ."}, {"id": 57, "duration_s": 3.77, "emotion": "serious", "text": "ಚರಂಡೀಲಲ್ಲ, ಶುದ್ಧ ನಿಂತ ನೀರಲ್ಲಿ ಮೊಟ್ಟೆ ಇಡುತ್ತೆ."}, {"id": 58, "duration_s": 3.89, "emotion": "shocked", "text": "ಅಂದ್ರೆ ಗ್ನಾನಿ ಅಣ್ಣನ ಸೈನ್ಸ್... ತಲೆಕೆಳಗೆ!"}, {"id": 59, "duration_s": 3.3, "emotion": "serious", "text": "ನೀರಲ್ಲಿ ಪುಟ್ಟ ಹುಳ ಕಂಡ್ರೆ, ಅದೇ ಲಾರ್ವಾ."}, {"id": 60, "duration_s": 2.96, "emotion": "serious", "text": "ಒಂದೇ ವಾರದಲ್ಲಿ, ಲಾರ್ವಾ ಸೊಳ್ಳೆ!"}, {"id": 61, "duration_s": 2.97, "emotion": "determined", "text": "ಗೂಢಚಾರರೇ! ನನ್ ಸೇಡು ತೀರ್ಸಿ!"}, {"id": 62, "duration_s": 3.51, "emotion": "determined", "text": "ಪ್ರತಿ ಪಾತ್ರೆ! ಪ್ರತಿ ಕುಂಡ! ಪ್ರತಿ ಟಯರ್!"}, {"id": 63, "duration_s": 3.49, "emotion": "proud", "text": "ಗೂಢಚಾರ? ದೊಡ್ಡೋರು ನೋಡ್ಕೊಳ್ತೀವಿ!"}, {"id": 64, "duration_s": 0.88, "emotion": "angry", "text": "ಸುಮ್ನಿರಿ!"}, {"id": 65, "duration_s": 3.09, "emotion": "excited", "text": "ಶುರುವಾಯ್ತು... ಸೊಳ್ಳೆ ಬೇಟೆ!"}, {"id": 66, "duration_s": 1.89, "emotion": "excited", "text": "ಸಿಕ್ತು! ಕೂಲರ್‌ನಲ್ಲಿ ಲಾರ್ವಾ!"}, {"id": 67, "duration_s": 4.58, "emotion": "proud", "text": "ನನ್ ಕೂಲರ್? ಅವು ಬರೀ... ಬಾಡಿಗೆದಾರರು."}, {"id": 68, "duration_s": 1.73, "emotion": "scared_whisper", "text": "ನಾ... ಯಾರಿಗೂ... ಹೆದರಲ್ಲ."}, {"id": 69, "duration_s": 2.44, "emotion": "panicked", "text": "ಕಾವೇರಿ! ಇದು ಬಾಡಿಗೆ ಕೇಳ್ತಿದೆ!"}, {"id": 70, "duration_s": 1.9, "emotion": "stern_warning", "text": "ಗೌರಮ್ಮಜ್ಜಿ, ತಟ್ಟೇಲೂ ಇದೆ!"}, {"id": 71, "duration_s": 2.39, "emotion": "proud", "text": "ನನ್ ಕುಂಡಗಳಿಗೆ ದಿನಾ ಪೂಜೆ ಆಗುತ್ತೆ!"}, {"id": 72, "duration_s": 2.615, "emotion": "sarcastic", "text": "ಪೂಜೆನೂ, ನೀರೂ... ಸೊಳ್ಳೆನೂ."}, {"id": 73, "duration_s": 2.11, "emotion": "determined", "text": "ಸಾಕು! ಈಗ ನಾನ್ ನೋಡ್ತೀನಿ."}, {"id": 74, "duration_s": 3.6, "emotion": "proud", "text": "ವಾರಕ್ಕೊಮ್ಮೆ ಖಾಲಿ ಮಾಡಿ, ಒಣಗಿಸಿ. ಹತ್ತು ಸೆಕೆಂಡ್."}, {"id": 75, "duration_s": 4.67, "emotion": "embarrassed", "text": "ನಾನೂ... ಸಹಾಯ ಮಾಡ್ತಿದ್ದೆ."}, {"id": 76, "duration_s": 3.96, "emotion": "mischievous", "text": "ಮತ್ತೆ ತಾರಸಿ ಮೇಲೆ... ಸೀನನ ಬಿಸಿನೆಸ್."}, {"id": 77, "duration_s": 0.76, "emotion": "excited", "text": "ಟೆನ್ಶನ್ ಬೇಡ!"}, {"id": 78, "duration_s": 4.13, "emotion": "proud", "text": "ಇದೇ ನನ್ ಟಯರ್ ಬಿಸಿನೆಸ್! ಇಪ್ಪತ್ತು ಟಯರ್, ಮುಂದ್ವರ್ಷ ಇಪ್ಪತ್ತು ಲಕ್ಷ!"}, {"id": 79, "duration_s": 3.03, "emotion": "serious", "text": "ಒಂದು ಟಯರ್‌ನಲ್ಲಿ... ನೂರಕ್ಕೂ ಹೆಚ್ಚು ಲಾರ್ವಾ."}, {"id": 80, "duration_s": 1.09, "emotion": "shocked", "text": "ಇಪ್ಪತ್ತರಲ್ಲಿ?"}, {"id": 81, "duration_s": 1.64, "emotion": "shocked", "text": "ಇಡೀ ಸೊಳ್ಳೆ ಕಾಲೊನಿ!"}, {"id": 82, "duration_s": 2.38, "emotion": "mischievous", "text": "ಸೋ... ಇವ್ಕೆ ಬಾಡಿಗೆ ಕೇಳ್ಲಾ?"}, {"id": 83, "duration_s": 3.56, "emotion": "proud", "text": "ನನ್ ಉಪ್ಪಿನಕಾಯಿಗೆ ಬಿಸಿಲು! ಕಡೇಪಕ್ಷ ನಾನು..."}, {"id": 84, "duration_s": 2.33, "emotion": "mischievous", "text": "ಅಜ್ಜಿ... ನಿಮ್ ಮುಚ್ಚಳದಲ್ಲೂ ಇದೆ."}, {"id": 85, "duration_s": 2.74, "emotion": "shocked", "text": "ಅಯ್ಯೋ ದೇವ್ರೇ! ಇಡೀ ಕಾಲೊನಿ ನೋಡುತ್ತೆ!"}, {"id": 86, "duration_s": 2.02, "emotion": "angry", "text": "ಇದೆಲ್ಲಾ ನಿನ್ ಟಯರ್‌ಗಳಿಂದ!"}, {"id": 87, "duration_s": 0.89, "emotion": "panicked", "text": "ಭರಣೀನೂ!"}, {"id": 88, "duration_s": 1.87, "emotion": "embarrassed", "text": "ಗುರಿ... ಮತ್ತೆ ಪಕ್ಕಾ."}, {"id": 89, "duration_s": 3.67, "emotion": "determined", "text": "ಟಯರ್ ಕೆಳಗೆ, ನೀರು ಹೊರಗೆ, ಬಿಸಿನೆಸ್ ಒಳಗೆ!"}, {"id": 90, "duration_s": 3.08, "emotion": "excited", "text": "ಕೇಳ್ದ್ರಾ? ಶಿವಣ್ಣನ ತಾರಸಿ ಇಪ್ಪತ್ತು ಲಕ್ಷ!"}, {"id": 91, "duration_s": 3.55, "emotion": "panicked", "text": "ಇಪ್ಪತ್ತು ಲಕ್ಷ... ಸೊಳ್ಳೆ! ಡೆಂಗ್ಯೂ ಬಂತು!"}, {"id": 92, "duration_s": 2.98, "emotion": "serious", "text": "ದೃಷ್ಟಿ ಆಯ್ತು! ಪ್ರತಿ ಬಾಗಿಲಿಗೆ ನಿಂಬೆ!"}, {"id": 93, "duration_s": 3.89, "emotion": "mischievous", "text": "ಸೊಳ್ಳೆ ಪರದೆ! ಇವತ್ತು ರೇಟ್ ಡಬಲ್!"}, {"id": 94, "duration_s": 4.61, "emotion": "giggly", "text": "ಆಮೇಲೆ... ಕಾಲೊನಿಲಿ ಭೂತಗಳ ಮೆರವಣಿಗೆ!"}, {"id": 95, "duration_s": 2.68, "emotion": "shouting", "text": "ಪ್ರತಿ ಸೊಳ್ಳೆ ವಿಚಾರಣೆ ಆಗ್ಬೇಕು!"}, {"id": 96, "duration_s": 0.76, "emotion": "angry", "text": "ಸುಮ್ನಿರಿ!"}, {"id": 97, "duration_s": 4.0, "emotion": "serious", "text": "ಹೊಗೆ, ನಿಂಬೆ, ರಾಕೆಟ್ ಅಲ್ಲ. ನಿಂತ ನೀರು ಚೆಲ್ಲಿ!"}, {"id": 98, "duration_s": 0.94, "emotion": "excited", "text": "ಒಂದ್ ಐಡಿಯಾ ಇದೆ!"}, {"id": 99, "duration_s": 3.27, "emotion": "excited", "text": "ಸ್ವಚ್ಛತೆ ರೇಸ್! ಜಾಸ್ತಿ ನೀರು ಹುಡುಕಿದೋರು ಗೆಲ್ತಾರೆ!"}, {"id": 100, "duration_s": 2.43, "emotion": "determined", "text": "ರೇಸಾ? ಈ ಸಲ ಕಪ್ ನಮ್ದೇ!"}, {"id": 101, "duration_s": 3.76, "emotion": "excited", "text": "ಕಾಲೊನಿಯ ಮೊದಲ... ಸ್ವಚ್ಛತೆ ರೇಸ್!"}, {"id": 102, "duration_s": 3.37, "emotion": "serious", "text": "ನಿಯಮ ಕೇಳಿ! ಯಾರಿಗೆ ಜಾಸ್ತಿ..."}, {"id": 103, "duration_s": 1.81, "emotion": "serious", "text": "ಲಾರ್ವಾ, ಮೇಷ್ಟ್ರೇ! ಲಾರ್ವಾ!"}, {"id": 104, "duration_s": 2.62, "emotion": "shocked", "text": "ಲವರಾ? ಈ ಕಾಲೊನಿಲಿ?"}, {"id": 105, "duration_s": 3.72, "emotion": "scared_whisper", "text": "ಯಾರದು? ಎಲ್ಲಿ? ಈ ವಯಸ್ಸಲ್ಲಿ?"}, {"id": 106, "duration_s": 2.24, "emotion": "sarcastic", "text": "ಸೊಳ್ಳೆ ಮರಿಗಳು, ಮೇಷ್ಟ್ರೇ!"}, {"id": 107, "duration_s": 2.8, "emotion": "embarrassed", "text": "ಓಹೋ... ಹಾಗಾದ್ರೆ ಸರಿ. ಶುರು!"}, {"id": 108, "duration_s": 4.404, "emotion": "tired", "text": "ಪೂರ್ತಿ ತೋಳು... ಪೂರ್ತಿ ಬೆವರು!"}, {"id": 109, "duration_s": 2.09, "emotion": "giggly", "text": "ಆದ್ರೆ ಸೊಳ್ಳೆ ಜಾರಿ ಹೋಯ್ತು!"}, {"id": 110, "duration_s": 2.27, "emotion": "determined", "text": "ಅಜ್ಜೀ, ನಿಮ್ ಬಟ್ಟಲೂ!"}, {"id": 111, "duration_s": 2.54, "emotion": "embarrassed", "text": "ದೃಷ್ಟಿ... ನೀರಿಗೆ ಆಗಿತ್ತು."}, {"id": 112, "duration_s": 2.44, "emotion": "happy", "text": "ಅಯ್ಯೋ, ಛಾವಣೀಲೂ ಕೆರೆ!"}, {"id": 113, "duration_s": 4.07, "emotion": "shouting", "text": "ಮಳೆ? ಸಮೋಸಾ? ವಿಚಾರಣೆ ಆಗ್ಬೇಕು!"}, {"id": 114, "duration_s": 2.59, "emotion": "mischievous", "text": "ದಾಸಪ್ಪಣ್ಣ, ಫ್ರೀ ಬಾಡಿಗೆದಾರರು!"}, {"id": 115, "duration_s": 2.8, "emotion": "sad", "text": "ನನ್ ಅಂಗಡೀಲಿ ಫ್ರೀ ಆಗಿ ಯಾರೂ ಇರಲ್ಲ!"}, {"id": 116, "duration_s": 2.58, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ... ಇದು ಅಲುಗಲ್ಲ."}, {"id": 117, "duration_s": 0.77, "emotion": "calm", "text": "ಪಕ್ಕಕ್ಕೆ."}, {"id": 118, "duration_s": 2.74, "emotion": "embarrassed", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ... ಮಕ್ಕಳ ಮಾತು ಕೇಳಿ."}, {"id": 119, "duration_s": 3.082, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ಹ್ಯಾಶ್‌ಟ್ಯಾಗ್ ಸೊಳ್ಳೆಮುಕ್ತ!"}, {"id": 120, "duration_s": 3.86, "emotion": "proud", "text": "ಒಂದೇ ಗಂಟೇಲಿ, ಕಾಲೊನಿಯಲ್ಲಿ ಒಂದ್ ಹನಿ ನಿಂತ ನೀರಿಲ್ಲ."}, {"id": 121, "duration_s": 2.64, "emotion": "excited", "text": "ಹತ್ತು ಸಾವಿರ ವ್ಯೂಸ್! ಕಾಲೊನಿ ವೈರಲ್!"}, {"id": 122, "duration_s": 1.95, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಈ ಸಲ ಒಳ್ಳೇ ಸುದ್ದಿ!"}, {"id": 123, "duration_s": 4.7, "emotion": "proud", "text": "ರೀಲ್‌ನಲ್ಲಿ ಮುಂದೆ ನಾನೇ! ಇಡೀ ಕಾಲೊನಿ ನೋಡುತ್ತೆ!"}, {"id": 124, "duration_s": 3.53, "emotion": "proud", "text": "ಡೆಂಗ್ಯೂ ಮುಕ್ತ ಕಾಲೊನಿ. ಲವರ್ ಮುಕ್ತವೂ ಕೂಡ."}, {"id": 125, "duration_s": 2.21, "emotion": "sarcastic", "text": "ಲಾರ್ವಾ, ಮೇಷ್ಟ್ರೇ... ಲಾರ್ವಾ."}, {"id": 126, "duration_s": 3.41, "emotion": "happy", "text": "ಕಾಲೊನಿ ಸೊಳ್ಳೆ ಸೋಲಿಸ್ತು... ನೀರಿನ ಜೊತೆ ಹೋರಾಡಿ."}, {"id": 127, "duration_s": 2.46, "emotion": "stern_warning", "text": "ಡಾಕ್ಟ್ರು ಹೇಳಿದ್ರು. ಒಂದೇ ಒಂದು."}, {"id": 128, "duration_s": 3.27, "emotion": "loving", "text": "ಒಂದೇ ಇದ್ರೆ... ನಿಧಾನಕ್ಕೆ ತಿನ್ತೀನಿ."}, {"id": 129, "duration_s": 2.65, "emotion": "tired", "text": "ಬೋಂಡಾ, ಇಪ್ಪತ್ತು ನಿಮಿಷ ಆಯ್ತು!"}, {"id": 130, "duration_s": 3.73, "emotion": "happy", "text": "ಗುಣ ಆಯ್ತು! ಈಗ... ಹಸಿವಾಗ್ತಿದೆ!"}, {"id": 131, "duration_s": 2.72, "emotion": "proud", "text": "ನಾ ಹೇಳಿದ್ದೆ ಅಲ್ವಾ, ನಾ ಯಾರಿಗೂ ಹೆದರಲ್ಲ."}, {"id": 132, "duration_s": 2.01, "emotion": "mischievous", "text": "ಝೂಂಂಂ..."}, {"id": 133, "duration_s": 1.17, "emotion": "calm", "text": "ಕೇಳ್ರೋ, ಜಾಸೂಸ್."}, {"id": 134, "duration_s": 3.81, "emotion": "serious", "text": "ಸೊಳ್ಳೆ ಜೊತೆ ಹೋರಾಡ್ಬೇಕಂದ್ರೆ... ನೀರ್ ಜೊತೆ ಹೋರಾಡಿ."}, {"id": 135, "duration_s": 5.92, "emotion": "serious", "text": "ವಾರಕ್ಕೊಮ್ಮೆ, ಎಲ್ಲಾ ಪಾತ್ರೆ ಖಾಲಿ, ಟ್ಯಾಂಕ್ ಮುಚ್ಚಿ."}, {"id": 136, "duration_s": 6.23, "emotion": "loving", "text": "ಪೂರ್ತಿ ತೋಳಿನ ಬಟ್ಟೆ. ಜ್ವರ ಬಂದ್ರೆ, ನೇರ ಡಾಕ್ಟ್ರ ಹತ್ರ."}, {"id": 137, "duration_s": 1.07, "emotion": "excited", "text": "ಕೇಸ್ ಕ್ಲೋಸ್!"}, {"id": 138, "duration_s": 5.548, "emotion": "mischievous", "text": "ಕಾಲೊನಿ ಸುಧಾರಿಸ್ತು... ಆದ್ರೆ ಶಿವಣ್ಣನ ಚಪ್ಪಾಳೆ?"}, {"id": 139, "duration_s": 1.203, "emotion": "scared_whisper", "text": "ನಲ್ವತ್ತೊಂದನೇ..."}]