[{"id": 1, "duration_s": 19.27, "emotion": "calm", "text": "এয়াই আমাৰ কলনী। শান্ত, ধুনীয়া, নিৰাপদ..."}, {"id": 2, "duration_s": 2.09, "emotion": "excited", "text": "আৰু এয়া... কলনীৰ নতুন ৰজা!"}, {"id": 3, "duration_s": 3.08, "emotion": "proud", "text": "ৰজা? এই কলনীৰ ৰজা মইহে!"}, {"id": 4, "duration_s": 1.09, "emotion": "sarcastic", "text": "ভুল উত্তৰ।"}, {"id": 5, "duration_s": 3.38, "emotion": "proud", "text": "ৰাণী তো মই! গোটেই কলনীয়ে চাব!"}, {"id": 6, "duration_s": 1.02, "emotion": "sarcastic", "text": "আকৌ ভুল।"}, {"id": 7, "duration_s": 3.0, "emotion": "proud", "text": "ৰাণী-টাণী এৰা। ফলোৱাৰ মোৰহে বেছি!"}, {"id": 8, "duration_s": 3.63, "emotion": "mischievous", "text": "তিনিওটা ভুল। আৰম্ভ হ'ল কালি সন্ধিয়া..."}, {"id": 9, "duration_s": 1.16, "emotion": "mischievous", "text": "...এটা কলতেই।"}, {"id": 10, "duration_s": 3.39, "emotion": "calm", "text": "সেই সন্ধিয়া কলনীলৈ মাত্ৰ এটা বান্দৰ আহিল।"}, {"id": 11, "duration_s": 3.86, "emotion": "excited", "text": "অ' মোৰ আই! বান্দৰ আহিছে! বৰ শুভ!"}, {"id": 12, "duration_s": 3.34, "emotion": "loving", "text": "লোৱা বোপাই, কল খোৱা। চকু নালাগিব।"}, {"id": 13, "duration_s": 2.74, "emotion": "excited", "text": "বান্দৰ! আচল বান্দৰ! আমাৰ কলনীত!"}, {"id": 14, "duration_s": 3.79, "emotion": "excited", "text": "মোৰ এটা বুদ্ধি আছে! পুহিম! নাম... মংগল!"}, {"id": 15, "duration_s": 3.29, "emotion": "worried", "text": "পুহিবা? কি খুৱাবা? মোৰ চিপ্ছ নালাগে!"}, {"id": 16, "duration_s": 4.65, "emotion": "serious", "text": "মই কওঁ? বান্দৰ বনৰীয়া জন্তু, ঘৰুৱা নহয়।"}, {"id": 17, "duration_s": 1.43, "emotion": "stern_warning", "text": "চুপ! মংগল আমাৰ বন্ধু।"}, {"id": 18, "duration_s": 1.71, "emotion": "sarcastic", "text": "ঠিক আছে। মই লিখি আছোঁ।"}, {"id": 19, "duration_s": 2.98, "emotion": "happy", "text": "প্ৰতিদিনে খুৱাম। ভাগ্যবন্ত বান্দৰ!"}, {"id": 20, "duration_s": 3.81, "emotion": "mischievous", "text": "মংগলে খালে... আৰু ঘৰলৈ ফোন কৰি দিলে।"}, {"id": 21, "duration_s": 1.17, "emotion": "mischievous", "text": "গোটেই বংশকে।"}, {"id": 22, "duration_s": 2.93, "emotion": "calm", "text": "শুভ... শুভ... বৰ শুভ..."}, {"id": 23, "duration_s": 3.73, "emotion": "mischievous", "text": "পিছদিনা ৰাতিপুৱা... এটা বান্দৰ, বিশটা!"}, {"id": 24, "duration_s": 2.63, "emotion": "excited", "text": "ইমানবোৰ? <gasp> ইমান ভাগ্য!"}, {"id": 25, "duration_s": 2.59, "emotion": "proud", "text": "বিজ্ঞানে কয়, বান্দৰে মানুহক ভয় কৰে।"}, {"id": 26, "duration_s": 2.47, "emotion": "serious", "text": "চাওক দাদা, বিজ্ঞানে কয়, ভয় নাখাব।"}, {"id": 27, "duration_s": 4.79, "emotion": "loving", "text": "আপুনি বৰ দীঘল... আৰু বৰ চিকন। অলপ খাওক!"}, {"id": 28, "duration_s": 3.89, "emotion": "happy", "text": "ভোক লাগিছে! আলুৰ পৰোঠা, পুৰা চাৰিখন!"}, {"id": 29, "duration_s": 4.11, "emotion": "shocked", "text": "মোতকৈ জোৰে? মোতকৈ?! এইটো অপমান!"}, {"id": 30, "duration_s": 4.19, "emotion": "stern_warning", "text": "চোবাই খোৱা! বত্ৰিশবাৰ! ভদ্ৰতা বুলি কিবা..."}, {"id": 31, "duration_s": 3.84, "emotion": "laughing", "text": "<laugh> নাহাঁহিবি পিঠা... আৰে! মোৰ মোজা!"}, {"id": 32, "duration_s": 3.67, "emotion": "worried", "text": "কালি এটা, আজি সাতাইশ। কাইলৈ কিমান হ'ব?"}, {"id": 33, "duration_s": 2.08, "emotion": "happy", "text": "সাতাইশ গুণ শুভ!"}, {"id": 34, "duration_s": 2.03, "emotion": "excited", "text": "শুনিছা নে? কলনীত বান্দৰ আহিল!"}, {"id": 35, "duration_s": 2.14, "emotion": "excited", "text": "পবিত্ৰৰ চশমা, পিঠাৰ টিফিন গ'ল..."}, {"id": 36, "duration_s": 3.17, "emotion": "proud", "text": "...কিন্তু মোৰ? মোৰ একো নাযায়!"}, {"id": 37, "duration_s": 0.68, "emotion": "shocked", "text": "<gasp> মোৰ ফোন!"}, {"id": 38, "duration_s": 3.13, "emotion": "laughing", "text": "বাইদেউ, সি তো আপোনাতকৈ ভাল গছিপ কৰে!"}, {"id": 39, "duration_s": 2.41, "emotion": "angry", "text": "নাহাঁহিবা! তাত মোৰ তিনিশ গ্ৰুপ আছে!"}, {"id": 40, "duration_s": 3.483, "emotion": "determined", "text": "বলা বলা, সোনকালে! ফোন ঘূৰাই আনোঁ!"}, {"id": 41, "duration_s": 2.98, "emotion": "tired", "text": "<sigh> প্ৰতিটো জৰুৰী সময়তে... প্ৰতিবাৰেই!"}, {"id": 42, "duration_s": 4.22, "emotion": "serious", "text": "এক, দুই, তিনি... এটা কলো কম নহয়!"}, {"id": 43, "duration_s": 3.89, "emotion": "shocked", "text": "আকৌ গণা... এক... দুই... <gasp> নাই!"}, {"id": 44, "duration_s": 2.19, "emotion": "stern_warning", "text": "ধনৰাম! আমাৰ চাউল!"}, {"id": 45, "duration_s": 2.2, "emotion": "stern_warning", "text": "হাত দি দেখুৱাচোন!"}, {"id": 46, "duration_s": 2.89, "emotion": "relieved", "text": "বান্দৰেও ইয়াক ভয় কৰে। মই অকলে নহয়!"}, {"id": 47, "duration_s": 4.09, "emotion": "excited", "text": "হেল্লো বন্ধুসকল! লাইভ চলিছে! বান্দৰ স্পেচিয়েল!"}, {"id": 48, "duration_s": 2.24, "emotion": "happy", "text": "চাওক মোৰ ফেন! হাই বান্দৰ!"}, {"id": 49, "duration_s": 3.33, "emotion": "comic_panic", "text": "মোৰ লাইভ! মোৰ ৰিং লাইট! মোৰ কেৰিয়াৰ!"}, {"id": 50, "duration_s": 5.12, "emotion": "angry", "text": "বান্দৰৰ লাইভত... দহ লাখ মানুহ!"}, {"id": 51, "duration_s": 3.42, "emotion": "sarcastic", "text": "সেই ৰাতিপুৱা কলনীৰ ডাঙৰ ইনফ্লুয়েঞ্চাৰ... বান্দৰ।"}, {"id": 52, "duration_s": 0.867, "emotion": "embarrassed", "text": "...মইও ফলো কৰি দিলোঁ।"}, {"id": 53, "duration_s": 3.03, "emotion": "mischievous", "text": "দুপৰলৈ কলনীত জৰুৰী সভা বহিল।"}, {"id": 54, "duration_s": 3.39, "emotion": "stern_warning", "text": "শান্ত! এজন এজনকৈ! হাত দাঙা!"}, {"id": 55, "duration_s": 1.95, "emotion": "sarcastic", "text": "তোমালোক এই কলনীৰ সদস্য নহয়!"}, {"id": 56, "duration_s": 3.14, "emotion": "proud", "text": "মই কাকো নাডৰো! বান্দৰ মই ধৰিম!"}, {"id": 57, "duration_s": 6.56, "emotion": "sarcastic", "text": "টিকটিকিলৈ ভয়, আৰু বান্দৰ ধৰিব?"}, {"id": 58, "duration_s": 5.109, "emotion": "embarrassed", "text": "মই... খুটাটো কিমান মজবুত চাই আছিলোঁ।"}, {"id": 59, "duration_s": 3.49, "emotion": "serious", "text": "চকু লাগিল! ঘৰে ঘৰে নেমু-জলকীয়া!"}, {"id": 60, "duration_s": 3.22, "emotion": "proud", "text": "মোৰ লাডু চুই দেখুৱাওক!"}, {"id": 61, "duration_s": 3.0, "emotion": "scared_whisper", "text": "শুনিছোঁ, বান্দৰে মিঠাইৰ গোন্ধ পায়..."}, {"id": 62, "duration_s": 3.52, "emotion": "serious", "text": "মই কওঁ? বান্দৰ কিয় আহিছে, কাৰণ..."}, {"id": 63, "duration_s": 2.54, "emotion": "serious", "text": "ল'ৰাবোৰ আঁতৰ! ডাঙৰৰ সভা!"}, {"id": 64, "duration_s": 1.85, "emotion": "stern_warning", "text": "চুপ! দাদাৰ কথা শুনা..."}, {"id": 65, "duration_s": 2.35, "emotion": "excited", "text": "চিন্তা নকৰিবা! মোৰ প্লেন আছে!"}, {"id": 66, "duration_s": 5.41, "emotion": "sad", "text": "<sigh> ডাঙৰৰ সভা। সৰুৰ কথা... কাইলৈ।"}, {"id": 67, "duration_s": 5.24, "emotion": "proud", "text": "চোৱা, বিজ্ঞান! কল ভিতৰত, বান্দৰ ভিতৰত, ধপ্!"}, {"id": 68, "duration_s": 4.2, "emotion": "worried", "text": "দেউতা, বান্দৰটো তো ওপৰ গছত..."}, {"id": 69, "duration_s": 2.09, "emotion": "determined", "text": "কলটো অলপ ঠিক কৰি লওঁ..."}, {"id": 70, "duration_s": 3.21, "emotion": "comic_panic", "text": "মই কাকো নাডৰো... <short pause> উলিয়াই আনা!"}, {"id": 71, "duration_s": 3.22, "emotion": "worried", "text": "খুড়া ঠিকনে? <short pause> কলটো ঠিকনে?"}, {"id": 72, "duration_s": 1.9, "emotion": "determined", "text": "হ'ল! এতিয়া মই চাওঁ।"}, {"id": 73, "duration_s": 6.71, "emotion": "proud", "text": "মই ইচ্ছা কৰিয়েই এৰিলোঁ। মৰম লাগিল।"}, {"id": 74, "duration_s": 2.21, "emotion": "proud", "text": "চিন্তা নকৰিবা! হনুমান আহিল!"}, {"id": 75, "duration_s": 3.9, "emotion": "curious", "text": "খুড়া, আপুনি তো... ডাঙৰ বান্দৰ যেন লাগিছে।"}, {"id": 76, "duration_s": 2.6, "emotion": "proud", "text": "সেইটোৱেই! বান্দৰে হনুমানক ডৰায়!"}, {"id": 77, "duration_s": 1.89, "emotion": "shouting", "text": "হু-হু-হা-হা! পলাওক!"}, {"id": 78, "duration_s": 2.64, "emotion": "surprised", "text": "আৰে? এয়া... মূৰ দোঁৱালে?"}, {"id": 79, "duration_s": 2.64, "emotion": "proud", "text": "মই ইহঁতৰ ৰজা! ধনু মহাৰাজ!"}, {"id": 80, "duration_s": 3.85, "emotion": "giggly", "text": "<laugh> সুৰসুৰি! আৰে, মোৰ উকুণ নাই!"}, {"id": 81, "duration_s": 2.44, "emotion": "excited", "text": "শুনিছা নে? ধনু বান্দৰৰ সৰ্দাৰ হ'ল!"}, {"id": 82, "duration_s": 2.75, "emotion": "stern_warning", "text": "বাহিৰ! তোমাৰ গোটেই সেনাৰ সৈতে!"}, {"id": 83, "duration_s": 3.0, "emotion": "tired", "text": "<sigh> চিন্তা... অলপ আছে।"}, {"id": 84, "duration_s": 4.11, "emotion": "stern_warning", "text": "তদন্ত হ'ব! গোটেই কলনীৰ তদন্ত!"}, {"id": 85, "duration_s": 3.02, "emotion": "sarcastic", "text": "তদন্ত আৰম্ভ। দুমিনিট পিছত..."}, {"id": 86, "duration_s": 3.2, "emotion": "excited", "text": "সিঙাৰা? <short pause> তদন্ত হ'ব!"}, {"id": 87, "duration_s": 3.17, "emotion": "shocked", "text": "জয় হিন্দ! <gasp> আৰে... মোৰ টুপী!"}, {"id": 88, "duration_s": 2.87, "emotion": "comic_panic", "text": "হেড অফিচ! বান্দৰে মোৰ টুপী গ্ৰেপ্তাৰ কৰিলে!"}, {"id": 89, "duration_s": 3.4, "emotion": "tender", "text": "খুড়া, আধা সিঙাৰা। মাত্ৰ আধা।"}, {"id": 90, "duration_s": 4.91, "emotion": "proud", "text": "মোৰ বেচনৰ লাডু! গোটেই কলনীয়ে চাব!"}, {"id": 91, "duration_s": 1.33, "emotion": "shocked", "text": "<gasp> মোৰ লাডু!"}, {"id": 92, "duration_s": 1.8, "emotion": "determined", "text": "আজি তোৰ ৰক্ষা নাই।"}, {"id": 93, "duration_s": 4.9, "emotion": "excited", "text": "আৰম্ভ হ'ল... কলনীৰ ইতিহাসৰ আটাইতকৈ ডাঙৰ দৌৰ!"}, {"id": 94, "duration_s": 1.36, "emotion": "excited", "text": "আইতা! আইতা!"}, {"id": 95, "duration_s": 2.63, "emotion": "excited", "text": "আইতা বনাম বান্দৰ! লাইভ চলিছে!"}, {"id": 96, "duration_s": 1.42, "emotion": "excited", "text": "সাবাশ আইতা!"}, {"id": 97, "duration_s": 3.8, "emotion": "shocked", "text": "চল্লিশটা লাডু... চাৰিশ টকাৰ মাল!"}, {"id": 98, "duration_s": 2.2, "emotion": "shocked", "text": "মাৰ নিশানা... ভুল হ'ল?"}, {"id": 99, "duration_s": 3.52, "emotion": "sad", "text": "প্ৰথমবাৰ... জীৱনত প্ৰথমবাৰ!"}, {"id": 100, "duration_s": 2.94, "emotion": "sarcastic", "text": "গোটেই কলনীয়ে দেখিলে... আইতাৰ নিশানা ভুল হোৱা।"}, {"id": 101, "duration_s": 0.84, "emotion": "stern_warning", "text": "চুপ! সকলো চুপ! এতিয়া দাদাই ক'ব!"}, {"id": 102, "duration_s": 1.12, "emotion": "determined", "text": "মই কওঁ? <short pause> মোৰ লগত আহা।"}, {"id": 103, "duration_s": 3.44, "emotion": "sarcastic", "text": "কলনীৰ পিছফালে... বান্দৰৰ ফ্ৰী হোটেল।"}, {"id": 104, "duration_s": 0.98, "emotion": "angry", "text": "ছি! এই আৱৰ্জনা কাৰ?"}, {"id": 105, "duration_s": 1.5, "emotion": "embarrassed", "text": "...যিকোনোৰে হ'ব পাৰে।"}, {"id": 106, "duration_s": 3.77, "emotion": "serious", "text": "খোলা আৱৰ্জনা, ৰোজ কল... ফ্ৰী খাদ্য!"}, {"id": 107, "duration_s": 3.51, "emotion": "calm", "text": "য'ত ফ্ৰী খাদ্য, ত'তে বান্দৰ। সহজ হিচাপ।"}, {"id": 108, "duration_s": 3.84, "emotion": "proud", "text": "বিজ্ঞানে কয়, বান্দৰে আমাক মৰম কৰে!"}, {"id": 109, "duration_s": 4.78, "emotion": "sarcastic", "text": "তেওঁলোকে খাদ্যক মৰম কৰে। আপুনি ডাষ্টবিনক।"}, {"id": 110, "duration_s": 4.17, "emotion": "serious", "text": "খুৱালে, মানুহৰ ভয় শেষ। তাৰ পিছত কাঢ়ি নিয়া।"}, {"id": 111, "duration_s": 2.947, "emotion": "serious", "text": "আৰু আমাৰ চিপ্ছ-মিঠাইত বান্দৰ বেমাৰীও হয়।"}, {"id": 112, "duration_s": 3.84, "emotion": "guilty", "text": "মই তো... শুভৰ বাবে এটা কলহে দিছিলোঁ।"}, {"id": 113, "duration_s": 3.09, "emotion": "guilty", "text": "প্ৰতিদিনে খুওৱাৰ বুদ্ধি... মোৰ আছিল।"}, {"id": 114, "duration_s": 3.3, "emotion": "guilty", "text": "মই তো মাত্ৰ... এটা চিপ্ছ।"}, {"id": 115, "duration_s": 2.08, "emotion": "determined", "text": "হ'ল! মই চাওঁ এতিয়া।"}, {"id": 116, "duration_s": 2.058, "emotion": "shouting", "text": "শেঠ! জাৰণি!"}, {"id": 117, "duration_s": 4.946, "emotion": "tired", "text": "এক জাৰণি, দুই জাৰণি... ফ্ৰী কাম!"}, {"id": 118, "duration_s": 1.66, "emotion": "mischievous", "text": "এতিয়া কল মইহে খাম।"}, {"id": 119, "duration_s": 4.02, "emotion": "calm", "text": "হেল্লো, বন বিভাগ? কলনীত বান্দৰ আছে। আহক প্লীজ।"}, {"id": 120, "duration_s": 6.67, "emotion": "calm", "text": "ভয় নাখাবা। টিমগিলা ধীৰে, সুৰক্ষিতে নি যাবাক।"}, {"id": 121, "duration_s": 0.93, "emotion": "calm", "text": "মাৰা নাই, ডৰোৱা নাই, খুৱোৱা নাই। খালি মৰমেদি।"}, {"id": 122, "duration_s": 3.42, "emotion": "surprised", "text": "আজি প্ৰথমবাৰ... ৰাজুৰ অটো নৰ'ল।"}, {"id": 123, "duration_s": 2.55, "emotion": "happy", "text": "ল, পালোহি! এতিয়া তই শো।"}, {"id": 124, "duration_s": 3.68, "emotion": "proud", "text": "চিন্তা নকৰিবা! ইহঁতে মোৰ কথা শুনে!"}, {"id": 125, "duration_s": 4.2, "emotion": "happy", "text": "শুনিছা নে? <laugh> বান্দৰে ফোন ঘূৰাই দিলে!"}, {"id": 126, "duration_s": 3.19, "emotion": "proud", "text": "তদন্ত... সম্পূৰ্ণ!"}, {"id": 127, "duration_s": 3.02, "emotion": "embarrassed", "text": "অ'হ... আপুনি লেম্প পোষ্ট। দুঃখিত।"}, {"id": 128, "duration_s": 2.1, "emotion": "excited", "text": "কলাব! পৰি আৰু বান্দৰ!"}, {"id": 129, "duration_s": 3.48, "emotion": "stern_warning", "text": "পিছবাৰ... নিশানা নাচুকিব।"}, {"id": 130, "duration_s": 2.35, "emotion": "tender", "text": "নেজ ৰাখা... সোঁৱৰণি।"}, {"id": 131, "duration_s": 3.53, "emotion": "tender", "text": "বান্দৰ গ'ল নিজৰ ঘৰলৈ... বনলৈ।"}, {"id": 132, "duration_s": 3.92, "emotion": "curious", "text": "কিন্তু কোকা, বান্দৰক কল দিয়াটো শুভ নহয়নে?"}, {"id": 133, "duration_s": 2.42, "emotion": "calm", "text": "জন্তুক খাদ্য দিয়া মৰম নহয়..."}, {"id": 134, "duration_s": 2.07, "emotion": "tender", "text": "...বনক বন হৈ থাকিব দিয়া।"}, {"id": 135, "duration_s": 3.98, "emotion": "serious", "text": "আৱৰ্জনা ঢাকি থ'বা। বান্দৰ দেখিলে বন বিভাগলৈ ফোন।"}, {"id": 136, "duration_s": 3.07, "emotion": "stern_warning", "text": "আৰু খুচৰিব নালাগে! বুজিলা? চুপ!"}, {"id": 137, "duration_s": 3.04, "emotion": "giggly", "text": "তেন্তে শুভ কল... মোৰ!"}, {"id": 138, "duration_s": 4.13, "emotion": "determined", "text": "এতিয়া অভ্যাস! নিশানা ঘূৰাই আনো!"}, {"id": 139, "duration_s": 2.351, "emotion": "tired", "text": "আই!"}, {"id": 140, "duration_s": 0.164, "emotion": "proud", "text": "নিশানা ঘূৰিল!"}]