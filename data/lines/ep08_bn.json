[{"id": 1, "duration_s": 5.01, "emotion": "calm", "text": "জ্যৈষ্ঠের গরম। সকাল সাতটা। সবই ঠিকঠাক ছিল..."}, {"id": 2, "duration_s": 4.88, "emotion": "happy", "text": "ঠান্ডা ঠান্ডা জল... গরম গরম আমি! লা-লা-লা!"}, {"id": 3, "duration_s": 2.63, "emotion": "curious", "text": "ও? বৃষ্টি থেমে গেল নাকি?"}, {"id": 4, "duration_s": 3.94, "emotion": "comic_panic", "text": "জল... জল! চোখে সাবান! মিতালীইই!"}, {"id": 5, "duration_s": 3.82, "emotion": "surprised", "text": "মা, এখানেও জল নেই! খালি হাওয়া!"}, {"id": 6, "duration_s": 4.31, "emotion": "serious", "text": "কল অসুস্থ। জ্বর নয়, তেষ্টা!"}, {"id": 7, "duration_s": 2.63, "emotion": "excited", "text": "শুনেছ? আমার কলও কাশছে!"}, {"id": 8, "duration_s": 3.3, "emotion": "angry", "text": "এক ফোঁটা? পুরো মাসের বিল দিয়েছি আমি!"}, {"id": 9, "duration_s": 3.15, "emotion": "worried", "text": "নজর লেগেছে! কলে নজর লেগেছে!"}, {"id": 10, "duration_s": 2.87, "emotion": "proud", "text": "বিজ্ঞান বলে... কল ঘুমোচ্ছে।"}, {"id": 11, "duration_s": 2.537, "emotion": "excited", "text": "আমরা লাইভ! পুরো পাড়া শুকনো!"}, {"id": 12, "duration_s": 2.64, "emotion": "shouting", "text": "কে জল বন্ধ করল? ভয় পাই না কাউকে!"}, {"id": 13, "duration_s": 3.75, "emotion": "mischievous", "text": "আর তারপর... গোটা পাড়ার জল বন্ধ!"}, {"id": 14, "duration_s": 2.61, "emotion": "shouting", "text": "ট্যাংকার এসেছে! ট্যাংকার!"}, {"id": 15, "duration_s": 2.47, "emotion": "determined", "text": "পথ ছাড়ো! সাবানওয়ালা আসছে!"}, {"id": 16, "duration_s": 4.69, "emotion": "proud", "text": "আমার বালতি! বিলিতি! এক টাকাও কম নয়!"}, {"id": 17, "duration_s": 2.51, "emotion": "happy", "text": "চলো চলো! ড্রাম ভরে আনব!"}, {"id": 18, "duration_s": 2.22, "emotion": "sarcastic", "text": "এক মিটার। রেকর্ড।"}, {"id": 19, "duration_s": 2.71, "emotion": "shouting", "text": "এক বাড়ি, দুই বালতি! ধাক্কাইয়ো না!"}, {"id": 20, "duration_s": 2.56, "emotion": "determined", "text": "ঢের হইছে! আমি দেখছি।"}, {"id": 21, "duration_s": 3.042, "emotion": "surprised", "text": "হারেনদা, এ বালতি?"}, {"id": 22, "duration_s": 1.43, "emotion": "mischievous", "text": "বালতির দাদা!"}, {"id": 23, "duration_s": 2.9, "emotion": "stern_warning", "text": "হারেন! পুরো পাড়া দেখছে!"}, {"id": 24, "duration_s": 2.8, "emotion": "sad", "text": "খিদে পেয়েছে... তেষ্টাও।"}, {"id": 25, "duration_s": 3.77, "emotion": "calm", "text": "শ্যাষ! পরের ট্যাংকার... দুফুরে।"}, {"id": 26, "duration_s": 3.29, "emotion": "excited", "text": "শুনেছ? পরের ট্যাংকার... তিন দিন পর!"}, {"id": 27, "duration_s": 3.98, "emotion": "excited", "text": "হ্যালো ঘোষদা, শুনেছ? হ্যালো বোসদা, শুনেছ?"}, {"id": 28, "duration_s": 1.93, "emotion": "serious", "text": "পায়রাবাবু... শুনেছ?"}, {"id": 29, "duration_s": 4.67, "emotion": "panicked", "text": "তিন দিন? ওমা... তিন ঘণ্টায় সব শেষ!"}, {"id": 30, "duration_s": 4.15, "emotion": "comic_panic", "text": "তিন ঘণ্টা? না... তিন মিনিট! দৌড়!"}, {"id": 31, "duration_s": 4.426, "emotion": "mischievous", "text": "দুপুরের ট্যাংকার, তিন মিনিটে তিন দিন!"}, {"id": 32, "duration_s": 3.08, "emotion": "mischievous", "text": "বোতল কুড়ি! তাড়াতাড়ি, দাম বাড়ছে!"}, {"id": 33, "duration_s": 4.39, "emotion": "mischievous", "text": "চল্লিশ! দাম তো আবহাওয়ার মতো, বদলায়!"}, {"id": 34, "duration_s": 4.91, "emotion": "proud", "text": "বারো বোতল! একটায় চান... এগারোটায় আবার চান!"}, {"id": 35, "duration_s": 1.25, "emotion": "curious", "text": "একটা বোতল কত?"}, {"id": 36, "duration_s": 0.7, "emotion": "proud", "text": "শো!"}, {"id": 37, "duration_s": 3.36, "emotion": "calm", "text": "তাহলে থাক। হাওয়া ফ্রি।"}, {"id": 38, "duration_s": 3.11, "emotion": "mischievous", "text": "চিন্তা নেই! সব বোতল আমায় দাও, দ্বিগুণে বেচব!"}, {"id": 39, "duration_s": 1.99, "emotion": "sarcastic", "text": "আমি নিজেই তিনগুণে বেচছি।"}, {"id": 40, "duration_s": 0.85, "emotion": "stern_warning", "text": "হারেন!"}, {"id": 41, "duration_s": 2.84, "emotion": "embarrassed", "text": "কুড়ি... কুড়িই ছিল, কুড়ি!"}, {"id": 42, "duration_s": 3.15, "emotion": "excited", "text": "লাইভ! জল এখন সোনার চেয়ে দামি!"}, {"id": 43, "duration_s": 4.22, "emotion": "proud", "text": "বারো বোতল জল! আজ রাজার মতো চান করব!"}, {"id": 44, "duration_s": 3.71, "emotion": "stern_warning", "text": "রাজা নয়, প্রজার মতো। এক মগ।"}, {"id": 45, "duration_s": 1.3, "emotion": "pleading", "text": "আধ মগ? এত সাবানের জন্য?"}, {"id": 46, "duration_s": 2.9, "emotion": "proud", "text": "আমাদের কালে আধ মগে বরযাত্রী চান করত!"}, {"id": 47, "duration_s": 4.66, "emotion": "proud", "text": "ঠিক আছে! ভয় পাই না কাউকে! আধ মগ, চলো!"}, {"id": 48, "duration_s": 3.12, "emotion": "determined", "text": "দাঁড়াও! যে জল পড়বে, তুলসীর গাছে।"}, {"id": 49, "duration_s": 3.0, "emotion": "surprised", "text": "বাবা, সাবান সব জল খেয়ে ফেলল!"}, {"id": 50, "duration_s": 3.48, "emotion": "stern_warning", "text": "আরেক মগ? পিঠে পড়বে কিন্তু!"}, {"id": 51, "duration_s": 1.03, "emotion": "shocked", "text": "ট-টিকটিকি!"}, {"id": 52, "duration_s": 3.33, "emotion": "embarrassed", "text": "ভয় পাইনি... ওর তেষ্টায় ভয় পেয়েছি।"}, {"id": 53, "duration_s": 2.71, "emotion": "worried", "text": "মা, রাতে ট্যাংক ভরা ছিল।"}, {"id": 54, "duration_s": 2.53, "emotion": "curious", "text": "সকাল গেল কই?"}, {"id": 55, "duration_s": 2.19, "emotion": "excited", "text": "আইডিয়া এসেছে! জলের গোয়েন্দা!"}, {"id": 56, "duration_s": 2.12, "emotion": "excited", "text": "গোয়েন্দা দল, তৈরি?"}, {"id": 57, "duration_s": 1.33, "emotion": "stern_warning", "text": "চুপ! গোয়েন্দারা কথা বলে না।"}, {"id": 58, "duration_s": 3.53, "emotion": "serious", "text": "আমি বলব? জলের পিছু ধরো... চোর মিলবে!"}, {"id": 59, "duration_s": 0.75, "emotion": "serious", "text": "এক!"}, {"id": 60, "duration_s": 0.69, "emotion": "serious", "text": "দুই!"}, {"id": 61, "duration_s": 2.6, "emotion": "happy", "text": "এই ফোঁটা কল... সবচেয়ে মিষ্টি!"}, {"id": 62, "duration_s": 3.16, "emotion": "shocked", "text": "চোদ্দোটা কল ঝরছে! চোদ্দো!"}, {"id": 63, "duration_s": 3.0, "emotion": "mischievous", "text": "আর এই জলের নদী... যায় কোথায়?"}, {"id": 64, "duration_s": 4.82, "emotion": "proud", "text": "ভোম্বল কার ওয়াশ! গাড়ি, স্কুটার, মোষ... সব সাফ!"}, {"id": 65, "duration_s": 1.98, "emotion": "angry", "text": "চুপ! পাইপ বন্ধ করো!"}, {"id": 66, "duration_s": 4.8, "emotion": "mischievous", "text": "বন্ধ? এ তো ব্যবসা! জল ফ্রি, লাভ ষোলো আনা!"}, {"id": 67, "duration_s": 3.8, "emotion": "serious", "text": "আমি বলব? এই পাইপ ভোর পাঁচটা থেকে চলছে।"}, {"id": 68, "duration_s": 1.18, "emotion": "shocked", "text": "তাই আমাদের ট্যাংক খালি!"}, {"id": 69, "duration_s": 3.06, "emotion": "calm", "text": "চিন্তা কোরো না! জল তো আমার নয়, পাড়ার!"}, {"id": 70, "duration_s": 1.8, "emotion": "angry", "text": "সেই জন্যই তো চিন্তা!"}, {"id": 71, "duration_s": 2.8, "emotion": "shouting", "text": "তদন্ত হবে! কে?"}, {"id": 72, "duration_s": 4.56, "emotion": "proud", "text": "বিজ্ঞান বলে... হাওয়া আর জল, সমান বৃষ্টি!"}, {"id": 73, "duration_s": 1.01, "emotion": "stern_warning", "text": "চুপ! দেখি।"}, {"id": 74, "duration_s": 2.59, "emotion": "excited", "text": "আমরা লাইভ! পাড়ার প্রথম বৃষ্টি!"}, {"id": 75, "duration_s": 3.92, "emotion": "proud", "text": "বিজ্ঞান বলে... বৃষ্টি শুধু বিজ্ঞানীদের ওপরেই পড়ে।"}, {"id": 76, "duration_s": 7.277, "emotion": "sad", "text": "গোপু চান করে ফেলল? আমি এখনও সাবানে!"}, {"id": 77, "duration_s": 3.41, "emotion": "laughing", "text": "<laugh> পুরো পাড়া দেখবে... গোপুর চান!"}, {"id": 78, "duration_s": 3.29, "emotion": "sarcastic", "text": "আরেক বালতি গেল। পনেরো নম্বর কল!"}, {"id": 79, "duration_s": 2.6, "emotion": "embarrassed", "text": "শুধু... একটু ক্যালিব্রেশন বাকি।"}, {"id": 80, "duration_s": 1.78, "emotion": "panicked", "text": "শুনেছ? শেষ ট্যাংকার!"}, {"id": 81, "duration_s": 3.57, "emotion": "excited", "text": "আর শুরু হল... পাড়ার সবচেয়ে বড় বালতি-দৌড়!"}, {"id": 82, "duration_s": 1.89, "emotion": "determined", "text": "এবার প্রথম বালতি আমার!"}, {"id": 83, "duration_s": 0.74, "emotion": "excited", "text": "চলো চলো!"}, {"id": 84, "duration_s": 1.68, "emotion": "sad", "text": "আরে... আজও?"}, {"id": 85, "duration_s": 2.22, "emotion": "curious", "text": "কেউ বলবে... আমি কোথায়?"}, {"id": 86, "duration_s": 1.37, "emotion": "angry", "text": "বালতি থেকে নামো!"}, {"id": 87, "duration_s": 3.17, "emotion": "sarcastic", "text": "এ বালতি নয়... বালতির দাদা!"}, {"id": 88, "duration_s": 7.91, "emotion": "shouting", "text": "তদন্ত হবে! থামো! না, চলো! না, থামো!"}, {"id": 89, "duration_s": 2.84, "emotion": "excited", "text": "লাইভ! বালতি জ্যাম, একশো মিটার লম্বা!"}, {"id": 90, "duration_s": 2.31, "emotion": "angry", "text": "পুরো পাড়া দেখছে... আর কেউ নড়ছে না!"}, {"id": 91, "duration_s": 1.88, "emotion": "excited", "text": "পায়রাবাবু, শুনেছ...? আরে!"}, {"id": 92, "duration_s": 0.703, "emotion": "shouting", "text": "চুপ!!!"}, {"id": 93, "duration_s": 3.42, "emotion": "serious", "text": "জলের জন্য ঝগড়া... আর কল এখনও চুঁইছে!"}, {"id": 94, "duration_s": 2.01, "emotion": "determined", "text": "আমি বলব? হিসেব দেখো!"}, {"id": 95, "duration_s": 3.18, "emotion": "stern_warning", "text": "শান্ত! আজকের ক্লাস... জল!"}, {"id": 96, "duration_s": 3.2, "emotion": "serious", "text": "আমি বলব? একটা কল, সেকেন্ডে এক জলবিন্দু।"}, {"id": 97, "duration_s": 1.82, "emotion": "excited", "text": "বোঁদে? কোথায় বোঁদে?"}, {"id": 98, "duration_s": 1.68, "emotion": "sarcastic", "text": "বোঁদে নয়, বিন্দু!"}, {"id": 99, "duration_s": 3.35, "emotion": "proud", "text": "একটা কল, একটা মাস... ষাট বালতি!"}, {"id": 100, "duration_s": 2.17, "emotion": "shocked", "text": "<gasp> ষাট? ওমা!"}, {"id": 101, "duration_s": 3.9, "emotion": "shocked", "text": "চোদ্দো গুণ ষাট... আটশো চল্লিশ বালতি!"}, {"id": 102, "duration_s": 2.22, "emotion": "mischievous", "text": "এত বোতল বেচলে তো..."}, {"id": 103, "duration_s": 1.37, "emotion": "stern_warning", "text": "হারেন!"}, {"id": 104, "duration_s": 3.72, "emotion": "serious", "text": "আর ভোম্বল কাকুর পাইপ... এক ঘণ্টায় পঞ্চাশ বালতি!"}, {"id": 105, "duration_s": 2.78, "emotion": "embarrassed", "text": "চিন্তা... একটু একটু হচ্ছে।"}, {"id": 106, "duration_s": 4.17, "emotion": "calm", "text": "ম্যাডাম, লাইন মেরামত চলেসে। সাঁঝের আগত জল আসিবে।"}, {"id": 107, "duration_s": 3.21, "emotion": "embarrassed", "text": "সন্ধ্যে পর্যন্ত? তিন দিন নয়?"}, {"id": 108, "duration_s": 1.23, "emotion": "sarcastic", "text": "তিন দিন কায় কইসে?"}, {"id": 109, "duration_s": 4.17, "emotion": "guilty", "text": "মানে জল বন্ধ হয়নি... আমরাই বইয়ে দিয়েছি!"}, {"id": 110, "duration_s": 3.73, "emotion": "serious", "text": "চোদ্দো কল, এক পাইপ, এক বাথটাব..."}, {"id": 111, "duration_s": 1.7, "emotion": "mischievous", "text": "আর এক সাবানওয়ালা বাবা!"}, {"id": 112, "duration_s": 2.46, "emotion": "determined", "text": "ব্যস! এবার সবাই দেখছি।"}, {"id": 113, "duration_s": 0.84, "emotion": "determined", "text": "দশ সেকেন্ড।"}, {"id": 114, "duration_s": 3.62, "emotion": "proud", "text": "নয় সেকেন্ড! পুরো পাড়া দেখুক!"}, {"id": 115, "duration_s": 4.255, "emotion": "proud", "text": "এ তো আমার বাঁ হাতের খেলা!"}, {"id": 116, "duration_s": 2.43, "emotion": "relieved", "text": "আহ... চান হল! শেষমেশ!"}, {"id": 117, "duration_s": 2.0, "emotion": "excited", "text": "শুনেছ? হারু চান করেছে!"}, {"id": 118, "duration_s": 3.06, "emotion": "happy", "text": "এক বালতি, এক ন্যাতা... গাড়ি ঝকঝক!"}, {"id": 119, "duration_s": 3.65, "emotion": "laughing", "text": "<laugh> মোষও! তবে বালতিতে!"}, {"id": 120, "duration_s": 4.34, "emotion": "proud", "text": "চুঁইয়ে পড়া জলও আমার! এক ফোঁটা নষ্ট নয়!"}, {"id": 121, "duration_s": 6.55, "emotion": "proud", "text": "বিজ্ঞান বলে... ফুটো কল সারাও।"}, {"id": 122, "duration_s": 1.28, "emotion": "surprised", "text": "গোপুদা... জীবনে প্রথমবার ঠিক!"}, {"id": 123, "duration_s": 1.47, "emotion": "sad", "text": "মিষ্টি কল... অবসর নিল।"}, {"id": 124, "duration_s": 2.32, "emotion": "happy", "text": "ছাদের জল, সোজা ড্রামে!"}, {"id": 125, "duration_s": 2.41, "emotion": "loving", "text": "এবার বৃষ্টিকে নজর লাগবে না।"}, {"id": 126, "duration_s": 2.42, "emotion": "excited", "text": "আমরা লাইভ! হ্যাশট্যাগ ফোঁটা বাঁচাও!"}, {"id": 127, "duration_s": 3.9, "emotion": "happy", "text": "সেদিন চোদ্দোটা কল সারল... আর এক বাবা চান করল।"}, {"id": 128, "duration_s": 4.1, "emotion": "calm", "text": "সন্ধ্যা নামল... আর কলে আবার জল এল।"}, {"id": 129, "duration_s": 3.45, "emotion": "proud", "text": "আজ থেকে হারু ঘোষ... এক বালতিতে চান করবে!"}, {"id": 130, "duration_s": 0.74, "emotion": "stern_warning", "text": "আধা।"}, {"id": 131, "duration_s": 2.81, "emotion": "calm", "text": "ফোঁটা ফোঁটা করে সাগর ভরে..."}, {"id": 132, "duration_s": 3.37, "emotion": "serious", "text": "...আবার ফোঁটা ফোঁটা করেই শুকোয়।"}, {"id": 133, "duration_s": 4.12, "emotion": "serious", "text": "ফুটো কল আজই সারাও... কাল নয়।"}, {"id": 134, "duration_s": 3.51, "emotion": "calm", "text": "আর আকাশের জল... ড্রামে।"}, {"id": 135, "duration_s": 1.85, "emotion": "determined", "text": "গাড়ি বালতিতে!"}, {"id": 136, "duration_s": 1.13, "emotion": "determined", "text": "পাইপ খোলা নয়!"}, {"id": 137, "duration_s": 1.97, "emotion": "proud", "text": "আর বৃষ্টির জল... ছাদে!"}, {"id": 138, "duration_s": 1.56, "emotion": "excited", "text": "বৃষ্টি!"}, {"id": 139, "duration_s": 2.85, "emotion": "excited", "text": "ফ্রি শাওয়ার! ঠাকুর, চালু করো!"}]