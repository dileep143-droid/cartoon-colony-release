[{"id": 1, "duration_s": 5.29, "emotion": "mischievous", "text": "આ છે અમારી સોસાયટી, ને આ એની સૌથી મોટી ટાંકી."}, {"id": 2, "duration_s": 4.51, "emotion": "mischievous", "text": "આ ટાંકીમાં... ભૂત રહે છે! ઊઊઊ!"}, {"id": 3, "duration_s": 1.94, "emotion": "curious", "text": "ભૂત નથી હોતા. બતાવું?"}, {"id": 4, "duration_s": 1.12, "emotion": "stern_warning", "text": "ચૂપ!"}, {"id": 5, "duration_s": 3.36, "emotion": "mischievous", "text": "મારો ખજાનો... અહીં કોઈ નહીં શોધે."}, {"id": 6, "duration_s": 2.87, "emotion": "sarcastic", "text": "તારું ભૂત... ટોર્ચથી ડરે છે."}, {"id": 7, "duration_s": 2.53, "emotion": "mischievous", "text": "ભૂત સાચું છે! આજે રાત્રે જોજે!"}, {"id": 8, "duration_s": 1.98, "emotion": "calm", "text": "બાળકો! જમવા આવો!"}, {"id": 9, "duration_s": 1.82, "emotion": "giggly", "text": "ઢોકળું તો પહેલાં પહોંચી ગયો."}, {"id": 10, "duration_s": 4.19, "emotion": "scared_whisper", "text": "અને પછી... બરાબર રાતના બાર વાગ્યે..."}, {"id": 11, "duration_s": 1.14, "emotion": "scared_whisper", "text": "ભૂ... ભૂ... ભૂત!"}, {"id": 12, "duration_s": 1.45, "emotion": "panicked", "text": "નજર લાગી... ટાંકીને!"}, {"id": 13, "duration_s": 2.02, "emotion": "scared_whisper", "text": "મંજુલા! ઊઠ! ટાંકીમાં ભૂત!"}, {"id": 14, "duration_s": 2.609, "emotion": "comic_panic", "text": "લીંબુ! મરચાં! લીંબુ!"}, {"id": 15, "duration_s": 3.47, "emotion": "excited", "text": "હા બા? ભૂત? અરે! સાચ્ચે?"}, {"id": 16, "duration_s": 2.355, "emotion": "excited", "text": "સાંભળ્યું કે? ટાંકીમાં ભૂત છે!"}, {"id": 17, "duration_s": 3.21, "emotion": "mischievous", "text": "દસ સેકન્ડે... આખી સોસાયટીને ખબર!"}, {"id": 18, "duration_s": 2.1, "emotion": "excited", "text": "હેલો ફ્રેન્ડ્સ! લાઈવ ચાલુ છે!"}, {"id": 19, "duration_s": 3.29, "emotion": "excited", "text": "ભૂત લાઈવ! બે લાખ વ્યૂઝ!"}, {"id": 20, "duration_s": 1.91, "emotion": "scared_whisper", "text": "ભૂતજી, એક સેલ્ફી પ્લીઝ?"}, {"id": 21, "duration_s": 3.39, "emotion": "proud", "text": "સાયન્સ કહે છે... ભૂત વાઈફાઈથી આવે!"}, {"id": 22, "duration_s": 1.72, "emotion": "proud", "text": "વાઈફાઈ બંધ. ભૂત ખતમ."}, {"id": 23, "duration_s": 4.63, "emotion": "serious", "text": "સૂર ખોટો છે. દસમાંથી ચાર."}, {"id": 24, "duration_s": 0.89, "emotion": "happy", "text": "હા! હવે સાત!"}, {"id": 25, "duration_s": 1.65, "emotion": "proud", "text": "ભૂત-બૂત કંઈ નથી હોતું!"}, {"id": 26, "duration_s": 1.42, "emotion": "proud", "text": "હું કોઈથી ના ડરું!"}, {"id": 27, "duration_s": 3.13, "emotion": "sarcastic", "text": "ગઈકાલે ગરોળી જોઈને કબાટ પર કોણ ચડ્યું'તું?"}, {"id": 28, "duration_s": 2.68, "emotion": "embarrassed", "text": "એ તો... કબાટની ધૂળ જોતો હતો."}, {"id": 29, "duration_s": 2.7, "emotion": "proud", "text": "જા બેટા! આખી સોસાયટી જોશે!"}, {"id": 30, "duration_s": 3.04, "emotion": "scared_whisper", "text": "ઓ ભૂતજી... હું તો બસ... ફરવા આવ્યો'તો."}, {"id": 31, "duration_s": 2.48, "emotion": "sarcastic", "text": "આવી ગયા? ફરવાનું પતી ગયું?"}, {"id": 32, "duration_s": 3.6, "emotion": "scared_whisper", "text": "હા... બહુ... સરસ હવા છે."}, {"id": 33, "duration_s": 2.68, "emotion": "guilty", "text": "મેં તો બસ... મજાક કરી'તી."}, {"id": 34, "duration_s": 3.39, "emotion": "mischievous", "text": "ટેન્શન ના લો! ભૂત છે... તો ધંધો છે!"}, {"id": 35, "duration_s": 5.48, "emotion": "mischievous", "text": "બીજી સવારે... સોસાયટી ડરેલી હતી. શેઠ ખુશ હતા."}, {"id": 36, "duration_s": 2.71, "emotion": "comic_panic", "text": "ભૂતવાળું પાણી? ના બાપ રે ના!"}, {"id": 37, "duration_s": 1.92, "emotion": "sarcastic", "text": "તો ચા શેમાંથી બનાવું?"}, {"id": 38, "duration_s": 2.77, "emotion": "proud", "text": "એક ડોલ, બે રૂપિયા! લાઈનમાં!"}, {"id": 39, "duration_s": 1.95, "emotion": "serious", "text": "કૂતરાના પણ બે રૂ."}, {"id": 40, "duration_s": 1.71, "emotion": "proud", "text": "એક રૂપિયો ઓછો નહીં!"}, {"id": 41, "duration_s": 2.91, "emotion": "stern_warning", "text": "શેઠ! ઘરનાં પાસેથી પણ પૈસા?"}, {"id": 42, "duration_s": 2.89, "emotion": "embarrassed", "text": "ઘરનાંને... અડધા ભાવ."}, {"id": 43, "duration_s": 3.43, "emotion": "comic_panic", "text": "લડ્ડુ! ચાલીસ ડોલ થઈ ગઈ!"}, {"id": 44, "duration_s": 1.31, "emotion": "happy", "text": "તરસ લાગી'તી."}, {"id": 45, "duration_s": 1.56, "emotion": "happy", "text": "ચાલો, ચાલો! પાણી લેવા!"}, {"id": 46, "duration_s": 1.28, "emotion": "sad", "text": "આજે પણ નહીં, રાણી?"}, {"id": 47, "duration_s": 2.89, "emotion": "excited", "text": "સાંભળ્યું કે? ભૂતે રાત્રે મારું નામ લીધું!"}, {"id": 48, "duration_s": 2.33, "emotion": "proud", "text": "હુંહ! મારું તો બે વાર લીધું!"}, {"id": 49, "duration_s": 2.99, "emotion": "proud", "text": "સાયન્સ કહે છે... ભૂતને ઠંડું પાણી ગમે."}, {"id": 50, "duration_s": 0.49, "emotion": "stern_warning", "text": "ચૂપ!"}, {"id": 51, "duration_s": 1.36, "emotion": "curious", "text": "હું સમજાવું? પછી."}, {"id": 52, "duration_s": 3.03, "emotion": "excited", "text": "ભાઈઓ-બહેનો! ભૂતનું ટેન્શન? ટેન્શન ના લો!"}, {"id": 53, "duration_s": 2.71, "emotion": "proud", "text": "રજૂ કરું છું... તાંત્રિક ભીખા બાપુ!"}, {"id": 54, "duration_s": 5.89, "emotion": "serious", "text": "અલખ નિરંજન! ભૂત... જાજું મોટું સે."}, {"id": 55, "duration_s": 4.43, "emotion": "embarrassed", "text": "હે હે... આ બાપુનો... ઊંધો યોગ છે!"}, {"id": 56, "duration_s": 0.96, "emotion": "curious", "text": "દાઢી... ઊંધી છે."}, {"id": 57, "duration_s": 0.99, "emotion": "serious", "text": "નોંધ કરો!"}, {"id": 58, "duration_s": 3.99, "emotion": "proud", "text": "ભૂત-પ્રૂફ લીંબુ! ખાલી પાંચસો!"}, {"id": 59, "duration_s": 2.48, "emotion": "shocked", "text": "પાંચસો? મારી દુકાનમાં બેનું છે!"}, {"id": 60, "duration_s": 0.97, "emotion": "comic_panic", "text": "બે આપો! જલદી!"}, {"id": 61, "duration_s": 2.89, "emotion": "excited", "text": "બાપુ, મને લીંબુ-મરચાંનું કોમ્બો!"}, {"id": 62, "duration_s": 2.23, "emotion": "proud", "text": "આઠ લીંબુ! પૂરા આઠ!"}, {"id": 63, "duration_s": 4.18, "emotion": "proud", "text": "આઠ? હુંહ! દસ આપો! આખી સોસાયટી જોશે!"}, {"id": 64, "duration_s": 1.5, "emotion": "happy", "text": "દસ! ને એક ફ્રી!"}, {"id": 65, "duration_s": 2.53, "emotion": "angry", "text": "હેલો? બાપુ, બાર મળશે?"}, {"id": 66, "duration_s": 1.59, "emotion": "proud", "text": "હવે હું કોઈથી ના ડરું!"}, {"id": 67, "duration_s": 0.97, "emotion": "sarcastic", "text": "ગરોળીથી પણ?"}, {"id": 68, "duration_s": 1.4, "emotion": "sarcastic", "text": "બહુ કામ આવ્યાં લીંબુ."}, {"id": 69, "duration_s": 2.72, "emotion": "sarcastic", "text": "પાંચ હજારનાં લીંબુ, બાપુજી!"}, {"id": 70, "duration_s": 1.92, "emotion": "calm", "text": "શરબત મસ્ત બનશે."}, {"id": 71, "duration_s": 4.16, "emotion": "mischievous", "text": "સાંજ સુધીમાં સોસાયટીમાં માણસ ઓછા, લીંબુ વધારે."}, {"id": 72, "duration_s": 4.25, "emotion": "mischievous", "text": "આજે રાત્રે એક જોરદાર 'ઊઊઊ' જોઈએ."}, {"id": 73, "duration_s": 2.29, "emotion": "mischievous", "text": "હવા હાલી... તો ડબલ ધંધો!"}, {"id": 74, "duration_s": 4.0, "emotion": "mischievous", "text": "રાત્રે... આખી સોસાયટી દાદાના આંગણામાં."}, {"id": 75, "duration_s": 5.37, "emotion": "tired", "text": "તપાસ... થશે... ઘર્ર..."}, {"id": 76, "duration_s": 3.45, "emotion": "serious", "text": "સાયન્સ કહે છે, ભૂત બરાબર બારે આવે."}, {"id": 77, "duration_s": 2.19, "emotion": "tired", "text": "હજી સાડા અગિયાર છે. સૂઈ જાઓ."}, {"id": 78, "duration_s": 1.79, "emotion": "angry", "text": "સાંભળ્યું કે? ચોરી!"}, {"id": 79, "duration_s": 3.15, "emotion": "guilty", "text": "આ બધું... મારી વાર્તાને લીધે."}, {"id": 80, "duration_s": 1.4, "emotion": "serious", "text": "ચૂપ! સાંભળો."}, {"id": 81, "duration_s": 4.55, "emotion": "shouting", "text": "કોણ છે? તપાસ થશે!"}, {"id": 82, "duration_s": 2.21, "emotion": "excited", "text": "વાહ! દસમાંથી દસ!"}, {"id": 83, "duration_s": 1.69, "emotion": "comic_panic", "text": "ભૂત! ભૂત! ભૂત!"}, {"id": 84, "duration_s": 0.59, "emotion": "panicked", "text": "ભૂત!"}, {"id": 85, "duration_s": 1.77, "emotion": "comic_panic", "text": "હું છું! જયેશ!"}, {"id": 86, "duration_s": 1.31, "emotion": "panicked", "text": "ભૂત બોલે પણ છે!"}, {"id": 87, "duration_s": 2.4, "emotion": "determined", "text": "ભૂત? મારી ચંપલ જો!"}, {"id": 88, "duration_s": 3.58, "emotion": "embarrassed", "text": "કાંતા બા... નિશાન... હજી... જોરદાર છે."}, {"id": 89, "duration_s": 1.84, "emotion": "excited", "text": "લાઈવ ચાલુ છે! પાંચ લાખ!"}, {"id": 90, "duration_s": 1.47, "emotion": "comic_panic", "text": "ચાલો ચાલો! બધા રિક્ષામાં!"}, {"id": 91, "duration_s": 1.84, "emotion": "determined", "text": "બસ! હવે હું જોઉં છું."}, {"id": 92, "duration_s": 3.87, "emotion": "calm", "text": "વહુ, ગણતરી કરો. બાળકો ક્યાં છે?"}, {"id": 93, "duration_s": 2.9, "emotion": "determined", "text": "એક આઈડિયા છે! ભૂતને સવાલ પૂછીએ."}, {"id": 94, "duration_s": 2.98, "emotion": "curious", "text": "હું સમજાવું? ડર સવાલોથી ભાગે છે."}, {"id": 95, "duration_s": 1.62, "emotion": "stern_warning", "text": "ચૂપ! પહેલાં હું."}, {"id": 96, "duration_s": 2.7, "emotion": "proud", "text": "હું... નાસ્તાની રક્ષા કરીશ."}, {"id": 97, "duration_s": 2.27, "emotion": "sarcastic", "text": "ભૂત મળી ગયું. ખાઉધરું વાળું."}, {"id": 98, "duration_s": 3.49, "emotion": "curious", "text": "જુઓ! હવા ચાલે, તો જ અવાજ આવે!"}, {"id": 99, "duration_s": 2.42, "emotion": "laughing", "text": "ભૂત... મારી આંગળીથી ડરે છે!"}, {"id": 100, "duration_s": 5.0, "emotion": "proud", "text": "હવા, પાઇપ, તિરાડ. ભૂત નંબર એક ઉકેલ્યું."}, {"id": 101, "duration_s": 2.62, "emotion": "curious", "text": "અવાજ તો પાઇપનો. ને આંખો?"}, {"id": 102, "duration_s": 2.91, "emotion": "proud", "text": "ટોર્ચનું અજવાળું, બિલાડીની આંખમાં ચમકે."}, {"id": 103, "duration_s": 1.52, "emotion": "happy", "text": "ભૂત નહીં, બિલાડી!"}, {"id": 104, "duration_s": 3.09, "emotion": "stern_warning", "text": "અંદર કોઈ નહીં જાય. ઢોકળું, પોટલી આપ!"}, {"id": 105, "duration_s": 3.07, "emotion": "sad", "text": "મારાં સમોસાં-બિસ્કિટ... આવજો."}, {"id": 106, "duration_s": 1.96, "emotion": "happy", "text": "આવ, નાના ભૂત!"}, {"id": 107, "duration_s": 1.75, "emotion": "tender", "text": "આ તો બિસ્કિટ ખાવા અંદર ગઈ'તી."}, {"id": 108, "duration_s": 1.99, "emotion": "surprised", "text": "અરે! અંદર એક ડબ્બો પણ છે!"}, {"id": 109, "duration_s": 3.86, "emotion": "embarrassed", "text": "ભૂખ લાગી'તી! સૌથી ઠંડી જગ્યા હતી!"}, {"id": 110, "duration_s": 1.77, "emotion": "stern_warning", "text": "ચૂપ! ...સારું, એક આપ."}, {"id": 111, "duration_s": 3.41, "emotion": "shouting", "text": "ઊભા રો! ભૂત બવ ખતરનાક સે!"}, {"id": 112, "duration_s": 1.57, "emotion": "proud", "text": "આ રહ્યું તમારું ભૂત!"}, {"id": 113, "duration_s": 4.21, "emotion": "excited", "text": "દસ લાખ! ભૂત નહીં, બિલાડી વાયરલ!"}, {"id": 114, "duration_s": 3.85, "emotion": "proud", "text": "ને આ રહ્યું ભૂતનું ગીત. તૂટેલો પાઇપ."}, {"id": 115, "duration_s": 3.4, "emotion": "proud", "text": "સાયન્સ કહે છે... મને તો પહેલેથી ખબર હતી."}, {"id": 116, "duration_s": 2.04, "emotion": "shocked", "text": "અરે! આ તો મેળાવાળો ફુગ્ગાવાળો છે!"}, {"id": 117, "duration_s": 1.84, "emotion": "excited", "text": "સાંભળ્યું કે? બાપુ નકલી છે!"}, {"id": 118, "duration_s": 2.16, "emotion": "comic_panic", "text": "હે હે... બાપુનો ટેમ પૂરો!"}, {"id": 119, "duration_s": 1.85, "emotion": "angry", "text": "મારાં લીંબુના હજાર રૂપિયા!"}, {"id": 120, "duration_s": 1.17, "emotion": "shouting", "text": "એક રૂપિયો ઓછો નહીં!"}, {"id": 121, "duration_s": 2.08, "emotion": "stern_warning", "text": "લાલો! પૈસા પાછા!"}, {"id": 122, "duration_s": 1.72, "emotion": "embarrassed", "text": "ટેન્શન ના લો, ભાભી... બધાના પાછા!"}, {"id": 123, "duration_s": 1.53, "emotion": "determined", "text": "ને મારાં દસ લીંબુ?"}, {"id": 124, "duration_s": 1.906, "emotion": "embarrassed", "text": "ચંપલ... કદી ચૂકતી નથી."}, {"id": 125, "duration_s": 2.12, "emotion": "sad", "text": "હજાર રૂપિયાની... એક ચંપલ."}, {"id": 126, "duration_s": 4.73, "emotion": "mischievous", "text": "ટાંકી ચૂપ હતી... હવે શેઠ 'ઊઊઊ' કરતા હતા."}, {"id": 127, "duration_s": 3.07, "emotion": "happy", "text": "ચાલો! ભૂતની રજા!"}, {"id": 128, "duration_s": 3.08, "emotion": "proud", "text": "ભૂત-પ્રૂફ લીંબુ... હવે તરસ-પ્રૂફ!"}, {"id": 129, "duration_s": 3.63, "emotion": "proud", "text": "મારો ગ્લાસ મોટો. આખી સોસાયટી જોશે!"}, {"id": 130, "duration_s": 2.58, "emotion": "embarrassed", "text": "નજર નહીં... તરસ લાગી છે."}, {"id": 131, "duration_s": 2.1, "emotion": "guilty", "text": "સાંભળ્યું? ...પહેલાં તપાસ કરું."}, {"id": 132, "duration_s": 2.18, "emotion": "happy", "text": "ભૂખ નહીં... આજે તરસ લાગી'તી!"}, {"id": 133, "duration_s": 3.06, "emotion": "guilty", "text": "દાદા, બધું મારી ભૂતવાળી વાર્તાથી શરૂ થયું."}, {"id": 134, "duration_s": 4.19, "emotion": "serious", "text": "ડરનો ઇલાજ સવાલ છે... બાવા નહીં."}, {"id": 135, "duration_s": 4.96, "emotion": "calm", "text": "પહેલાં પૂછો, પછી તપાસો, પછી માનો."}, {"id": 136, "duration_s": 3.14, "emotion": "proud", "text": "ને ડર વેચનારાને... પૈસા નહીં!"}, {"id": 137, "duration_s": 1.84, "emotion": "stern_warning", "text": "સાંભળ્યું? હવે ચૂપ!"}, {"id": 138, "duration_s": 2.75, "emotion": "proud", "text": "મેં કહ્યું'તું ને? હું કોઈથી ના ડરું!"}]