[{"id": 1, "duration_s": 15.15, "emotion": "mischievous", "text": "This is our colony, and its biggest water tank."}, {"id": 2, "duration_s": 3.62, "emotion": "mischievous", "text": "In this tank... lives a ghost! Oooo!"}, {"id": 3, "duration_s": 2.17, "emotion": "curious", "text": "Ghosts don't exist. Shall I explain?"}, {"id": 4, "duration_s": 0.79, "emotion": "stern_warning", "text": "Quiet!"}, {"id": 5, "duration_s": 2.89, "emotion": "mischievous", "text": "My treasure... nobody will look here."}, {"id": 6, "duration_s": 2.15, "emotion": "sarcastic", "text": "Your ghost... is scared of a torch."}, {"id": 7, "duration_s": 2.34, "emotion": "mischievous", "text": "The ghost is real! Watch tonight!"}, {"id": 8, "duration_s": 3.486, "emotion": "calm", "text": "Kids! Food is ready!"}, {"id": 9, "duration_s": 1.65, "emotion": "giggly", "text": "Laddu got there first!"}, {"id": 10, "duration_s": 4.81, "emotion": "scared_whisper", "text": "And then... exactly at midnight..."}, {"id": 11, "duration_s": 0.79, "emotion": "scared_whisper", "text": "G-g-ghost!"}, {"id": 12, "duration_s": 2.37, "emotion": "panicked", "text": "Evil eye... on the tank!"}, {"id": 13, "duration_s": 2.83, "emotion": "scared_whisper", "text": "Gupta! Wake up! Ghost in the tank!"}, {"id": 14, "duration_s": 3.308, "emotion": "comic_panic", "text": "Lemon! Chilli! Lemon! Chilli!"}, {"id": 15, "duration_s": 2.54, "emotion": "excited", "text": "Yes Champa? Ghost? Really?"}, {"id": 16, "duration_s": 2.44, "emotion": "excited", "text": "Did you hear? Ghost in the tank!"}, {"id": 17, "duration_s": 2.791, "emotion": "mischievous", "text": "In ten seconds... the whole colony knew."}, {"id": 18, "duration_s": 1.91, "emotion": "excited", "text": "Hello friends! We're live!"}, {"id": 19, "duration_s": 2.84, "emotion": "excited", "text": "Live ghost! Two lakh viewers!"}, {"id": 20, "duration_s": 2.689, "emotion": "scared_whisper", "text": "Ghost ji, one selfie please?"}, {"id": 21, "duration_s": 3.18, "emotion": "proud", "text": "Science says... ghosts come from Wi-Fi!"}, {"id": 22, "duration_s": 2.0, "emotion": "proud", "text": "Wi-Fi off. Ghost gone."}, {"id": 23, "duration_s": 2.84, "emotion": "serious", "text": "Off-key. Four out of ten."}, {"id": 24, "duration_s": 1.63, "emotion": "happy", "text": "Yes! Now seven!"}, {"id": 25, "duration_s": 1.34, "emotion": "proud", "text": "There are no ghosts!"}, {"id": 26, "duration_s": 1.1, "emotion": "proud", "text": "I fear nobody!"}, {"id": 27, "duration_s": 2.4, "emotion": "sarcastic", "text": "Who climbed the cupboard yesterday for a lizard?"}, {"id": 28, "duration_s": 2.52, "emotion": "embarrassed", "text": "I was... checking the cupboard dust."}, {"id": 29, "duration_s": 2.89, "emotion": "proud", "text": "Go, beta! Whole colony will watch!"}, {"id": 30, "duration_s": 3.33, "emotion": "scared_whisper", "text": "Oh Ghost ji... I just came... for a walk."}, {"id": 31, "duration_s": 2.07, "emotion": "sarcastic", "text": "Back? Walk finished?"}, {"id": 32, "duration_s": 3.01, "emotion": "scared_whisper", "text": "Yes... very... nice breeze."}, {"id": 33, "duration_s": 2.16, "emotion": "guilty", "text": "I only... made a joke."}, {"id": 34, "duration_s": 3.05, "emotion": "mischievous", "text": "Don't take tension! Ghost means business!"}, {"id": 35, "duration_s": 5.19, "emotion": "mischievous", "text": "Next morning... the colony was scared. Lallan Seth was thrilled."}, {"id": 36, "duration_s": 2.81, "emotion": "comic_panic", "text": "Ghost water? No baba no!"}, {"id": 37, "duration_s": 1.84, "emotion": "sarcastic", "text": "Then what do I make tea with?"}, {"id": 38, "duration_s": 2.94, "emotion": "proud", "text": "One bucket, two rupees! In line!"}, {"id": 39, "duration_s": 1.53, "emotion": "serious", "text": "Dog also, two rupees."}, {"id": 40, "duration_s": 1.16, "emotion": "proud", "text": "Not one rupee less!"}, {"id": 41, "duration_s": 3.04, "emotion": "stern_warning", "text": "Lallan Seth! Charging neighbours too?"}, {"id": 42, "duration_s": 2.85, "emotion": "embarrassed", "text": "For neighbours... half price."}, {"id": 43, "duration_s": 2.77, "emotion": "comic_panic", "text": "Laddu! That's forty buckets!"}, {"id": 44, "duration_s": 1.63, "emotion": "happy", "text": "I was thirsty too."}, {"id": 45, "duration_s": 2.32, "emotion": "happy", "text": "Let's go, let's go! Water run!"}, {"id": 46, "duration_s": 1.65, "emotion": "sad", "text": "Again today, Rani?"}, {"id": 47, "duration_s": 3.13, "emotion": "excited", "text": "Did you hear? Ghost took my name last night!"}, {"id": 48, "duration_s": 2.17, "emotion": "proud", "text": "Hmph! Mine, twice!"}, {"id": 49, "duration_s": 3.37, "emotion": "proud", "text": "Science says... ghosts love cold water."}, {"id": 50, "duration_s": 0.54, "emotion": "stern_warning", "text": "Quiet!"}, {"id": 51, "duration_s": 2.27, "emotion": "curious", "text": "Shall I explain? Later."}, {"id": 52, "duration_s": 4.39, "emotion": "excited", "text": "Brothers, sisters! Ghost tension? Don't take tension!"}, {"id": 53, "duration_s": 4.18, "emotion": "proud", "text": "Presenting... Tantrik Tinku Baba!"}, {"id": 54, "duration_s": 6.15, "emotion": "serious", "text": "Alakh Niranjan! Ghost is... very big, na."}, {"id": 55, "duration_s": 3.15, "emotion": "embarrassed", "text": "Hehe... this is Baba's... upside-down yoga!"}, {"id": 56, "duration_s": 1.68, "emotion": "curious", "text": "Beard is upside down."}, {"id": 57, "duration_s": 1.03, "emotion": "serious", "text": "Note it down!"}, {"id": 58, "duration_s": 2.01, "emotion": "proud", "text": "Ghost-proof lemon! Only five hundred, na!"}, {"id": 59, "duration_s": 5.19, "emotion": "shocked", "text": "Five hundred? In my shop it's two!"}, {"id": 60, "duration_s": 0.99, "emotion": "comic_panic", "text": "Give two! Quick!"}, {"id": 61, "duration_s": 2.94, "emotion": "excited", "text": "Baba, I want the lemon-chilli combo!"}, {"id": 62, "duration_s": 2.04, "emotion": "proud", "text": "Eight lemons! Full eight!"}, {"id": 63, "duration_s": 3.63, "emotion": "proud", "text": "Eight? Hmph! Give ten! Whole colony will watch!"}, {"id": 64, "duration_s": 2.29, "emotion": "happy", "text": "Ten! And one free!"}, {"id": 65, "duration_s": 2.62, "emotion": "angry", "text": "Hello? Baba ji, can I get twelve?"}, {"id": 66, "duration_s": 2.14, "emotion": "proud", "text": "Now I fear nobody!"}, {"id": 67, "duration_s": 1.16, "emotion": "sarcastic", "text": "Even lizards?"}, {"id": 68, "duration_s": 2.2, "emotion": "sarcastic", "text": "Lemons were so useful."}, {"id": 69, "duration_s": 2.96, "emotion": "sarcastic", "text": "Five thousand rupees of lemons, Papaji!"}, {"id": 70, "duration_s": 1.47, "emotion": "calm", "text": "Will make good lemonade."}, {"id": 71, "duration_s": 3.33, "emotion": "mischievous", "text": "By evening, fewer people, more lemons."}, {"id": 72, "duration_s": 4.22, "emotion": "mischievous", "text": "Tonight we need one powerful 'Oooo'."}, {"id": 73, "duration_s": 4.42, "emotion": "mischievous", "text": "Wind blows... double dhandha, na!"}, {"id": 74, "duration_s": 3.73, "emotion": "mischievous", "text": "At night... the entire colony in Dadaji's courtyard."}, {"id": 75, "duration_s": 3.97, "emotion": "tired", "text": "Inquiry will be... zzz"}, {"id": 76, "duration_s": 3.15, "emotion": "serious", "text": "Science says ghost comes at exactly twelve."}, {"id": 77, "duration_s": 2.676, "emotion": "tired", "text": "It's eleven thirty. Go to sleep."}, {"id": 78, "duration_s": 1.88, "emotion": "angry", "text": "Did you hear? Theft!"}, {"id": 79, "duration_s": 2.57, "emotion": "guilty", "text": "All this... because of my story."}, {"id": 80, "duration_s": 1.44, "emotion": "serious", "text": "Shh! Listen."}, {"id": 81, "duration_s": 2.31, "emotion": "shouting", "text": "Who's there? Inquiry will be!"}, {"id": 82, "duration_s": 2.02, "emotion": "excited", "text": "Wah! Ten out of ten!"}, {"id": 83, "duration_s": 1.511, "emotion": "comic_panic", "text": "Ghost! Ghost! Ghost!"}, {"id": 84, "duration_s": 1.0, "emotion": "panicked", "text": "Ghost!"}, {"id": 85, "duration_s": 2.09, "emotion": "comic_panic", "text": "It's me! Ramesh!"}, {"id": 86, "duration_s": 1.39, "emotion": "panicked", "text": "The ghost even talks!"}, {"id": 87, "duration_s": 2.43, "emotion": "determined", "text": "Ghost? See my chappal!"}, {"id": 88, "duration_s": 3.59, "emotion": "embarrassed", "text": "Ma... your aim... still... superb."}, {"id": 89, "duration_s": 2.31, "emotion": "excited", "text": "We're live! Five lakh!"}, {"id": 90, "duration_s": 2.11, "emotion": "comic_panic", "text": "Let's go! Everyone in the auto!"}, {"id": 91, "duration_s": 4.01, "emotion": "determined", "text": "Enough! Now I'll handle this."}, {"id": 92, "duration_s": 1.32, "emotion": "calm", "text": "Pooja, count the heads. Where are the kids?"}, {"id": 93, "duration_s": 1.229, "emotion": "determined", "text": "I have an idea! Let's question the ghost."}, {"id": 94, "duration_s": 1.321, "emotion": "curious", "text": "Shall I explain? Fear runs from questions."}, {"id": 95, "duration_s": 1.29, "emotion": "stern_warning", "text": "Quiet! Me first."}, {"id": 96, "duration_s": 1.56, "emotion": "proud", "text": "I... will guard the snacks."}, {"id": 97, "duration_s": 1.709, "emotion": "sarcastic", "text": "Found the ghost. The round one."}, {"id": 98, "duration_s": 0.66, "emotion": "curious", "text": "Look! Only when wind blows, sound comes!"}, {"id": 99, "duration_s": 0.3, "emotion": "laughing", "text": "Ghost... is scared of my finger!"}, {"id": 100, "duration_s": 0.6, "emotion": "proud", "text": "Wind, pipe, crack. Ghost number one, solved."}, {"id": 101, "duration_s": 0.83, "emotion": "curious", "text": "Sound is the pipe. And the eyes?"}, {"id": 102, "duration_s": 0.55, "emotion": "proud", "text": "Torch light shines in a cat's eyes."}, {"id": 103, "duration_s": 0.93, "emotion": "happy", "text": "Not a ghost, a cat!"}, {"id": 104, "duration_s": 2.13, "emotion": "stern_warning", "text": "Nobody goes inside. Laddu, give the pouch!"}, {"id": 105, "duration_s": 1.01, "emotion": "sad", "text": "My samosa-biscuits... goodbye."}, {"id": 106, "duration_s": 1.2, "emotion": "happy", "text": "Come, little ghost!"}, {"id": 107, "duration_s": 0.6, "emotion": "tender", "text": "She went in to eat biscuits."}, {"id": 108, "duration_s": 1.81, "emotion": "surprised", "text": "Arey! There's a tin inside too!"}, {"id": 109, "duration_s": 3.03, "emotion": "embarrassed", "text": "I was hungry! Coolest place!"}, {"id": 110, "duration_s": 2.35, "emotion": "stern_warning", "text": "Quiet! ...Okay, give one."}, {"id": 111, "duration_s": 3.08, "emotion": "shouting", "text": "Stop! The ghost is very dangerous, na!"}, {"id": 112, "duration_s": 1.36, "emotion": "proud", "text": "Here's your ghost!"}, {"id": 113, "duration_s": 3.2, "emotion": "excited", "text": "Ten lakh! Not ghost, cat gone viral!"}, {"id": 114, "duration_s": 4.38, "emotion": "proud", "text": "And here's the ghost's song. Broken pipe."}, {"id": 115, "duration_s": 2.63, "emotion": "proud", "text": "Science says... I knew it already."}, {"id": 116, "duration_s": 3.01, "emotion": "shocked", "text": "Arey! He's the balloon-seller from the mela!"}, {"id": 117, "duration_s": 2.11, "emotion": "excited", "text": "Did you hear? Baba is fake!"}, {"id": 118, "duration_s": 3.01, "emotion": "comic_panic", "text": "Hehe... Baba's time is up!"}, {"id": 119, "duration_s": 2.05, "emotion": "angry", "text": "My thousand rupees of lemons!"}, {"id": 120, "duration_s": 1.8, "emotion": "shouting", "text": "Not one rupee less!"}, {"id": 121, "duration_s": 1.72, "emotion": "stern_warning", "text": "Tinku! Money back!"}, {"id": 122, "duration_s": 3.34, "emotion": "embarrassed", "text": "Don't take tension, Bhabhi... everyone's refund!"}, {"id": 123, "duration_s": 1.54, "emotion": "determined", "text": "And my ten lemons?"}, {"id": 124, "duration_s": 3.09, "emotion": "embarrassed", "text": "Chappal... never misses."}, {"id": 125, "duration_s": 2.57, "emotion": "sad", "text": "A thousand rupees... for one chappal."}, {"id": 126, "duration_s": 4.42, "emotion": "mischievous", "text": "Tank was quiet... now Lallan Seth was going 'Oooo'."}, {"id": 127, "duration_s": 2.05, "emotion": "happy", "text": "Let's go! Ghost retired!"}, {"id": 128, "duration_s": 3.31, "emotion": "proud", "text": "Ghost-proof lemons... now thirst-proof!"}, {"id": 129, "duration_s": 2.72, "emotion": "proud", "text": "My glass is bigger. Whole colony will watch!"}, {"id": 130, "duration_s": 2.68, "emotion": "embarrassed", "text": "Not evil eye... just thirsty."}, {"id": 131, "duration_s": 2.35, "emotion": "guilty", "text": "Did you hear? ...let me check first."}, {"id": 132, "duration_s": 3.24, "emotion": "happy", "text": "Not hunger... today I was thirsty!"}, {"id": 133, "duration_s": 2.89, "emotion": "guilty", "text": "Dadaji, it all started with my ghost story."}, {"id": 134, "duration_s": 5.09, "emotion": "serious", "text": "Fear's cure is questions... not babas."}, {"id": 135, "duration_s": 4.77, "emotion": "calm", "text": "First ask, then check, then believe."}, {"id": 136, "duration_s": 2.42, "emotion": "proud", "text": "And to fear-sellers... no money!"}, {"id": 137, "duration_s": 2.0, "emotion": "stern_warning", "text": "Heard that? Now quiet!"}, {"id": 138, "duration_s": 3.35, "emotion": "proud", "text": "Told you, na? I fear nobody!"}]