[{"id": 1, "duration_s": 4.83, "emotion": "mischievous", "text": "ದೀಪಾವಳಿ ರಾತ್ರಿ. ಇಡೀ ಕಾಲೋನಿ ಒಂದೇ ಕಡೆ ನೋಡ್ತಿದೆ..."}, {"id": 2, "duration_s": 2.77, "emotion": "excited", "text": "ಸೀನನ... ಸೂಪರ್ ಬಾಂಬ್!"}, {"id": 3, "duration_s": 2.59, "emotion": "proud", "text": "ಹೆದರ್ಬೇಡಿ! ಚಂದ್ರನಿಗಿಂತ ಜೋರ್ ಸದ್ದು!"}, {"id": 4, "duration_s": 2.34, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ದೀಪಾವಳಿ ಸ್ಪೆಷಲ್!"}, {"id": 5, "duration_s": 2.28, "emotion": "stern_warning", "text": "ಸೈಲೆನ್ಸ್! ಎಲ್ರೂ ಗೆರೆ ಹಿಂದೆ!"}, {"id": 6, "duration_s": 1.76, "emotion": "scared_whisper", "text": "ಆಯ್ತಾ... ಮುಗೀತಾ?"}, {"id": 7, "duration_s": 3.83, "emotion": "mischievous", "text": "ಇರಿ ಇರಿ! ಇದೆಲ್ಲ ಶುರುವಾಗಿದ್ದು ಇವತ್ತು ಬೆಳಗ್ಗೆ."}, {"id": 8, "duration_s": 1.73, "emotion": "happy", "text": "ದೀಪಾವಳಿ ಬೆಳಗ್ಗೆ. ಕಾಲೋನಿ ಥಳಥಳ ಹೊಳೀತಿತ್ತು..."}, {"id": 9, "duration_s": 3.05, "emotion": "sarcastic", "text": "...ಸೀನ ಗೊರಕೆ ಹೊಡೆದ."}, {"id": 10, "duration_s": 3.78, "emotion": "excited", "text": "ಸೂಪರ್ ಬಾಂಬ್! ಚಂದ್ರಮಕ್ಕಿಂತ ಭಾಳ ಸದ್ದು! ಇವತ್ತೇ ಮಾತ್ರ!"}, {"id": 11, "duration_s": 1.28, "emotion": "excited", "text": "ಚಂದ್ರನಿಗಿಂತ ಜಾಸ್ತಿ?!"}, {"id": 12, "duration_s": 2.32, "emotion": "curious", "text": "ಅಣ್ಣಾ... ಚಂದ್ರನ ಸದ್ದು ಎಷ್ಟಿರುತ್ತೆ?"}, {"id": 13, "duration_s": 1.1, "emotion": "serious", "text": "...ಅದಕ್ಕಿಂತ ಕಮ್ಮಿ!"}, {"id": 14, "duration_s": 3.01, "emotion": "loving", "text": "ನನ್ ಸೂಪರ್ ಬಾಂಬ್... ನನ್ ಕಂದ."}, {"id": 15, "duration_s": 2.78, "emotion": "serious", "text": "ನಾ ಹೇಳ್ಲಾ? ಡಬ್ಬದ ಮೇಲೆ ಹೆಸರೇ ಇಲ್ಲ!"}, {"id": 16, "duration_s": 3.08, "emotion": "serious", "text": "ಕಂಪನಿ ಇಲ್ಲ, ವಿಳಾಸ ಇಲ್ಲ! ಗಾಡಿಯವನೂ ಓಡ್ಹೋದ!"}, {"id": 17, "duration_s": 2.3, "emotion": "proud", "text": "ಹೆದರ್ಬೇಡಿ! ಸೀನ ಇದ್ದಾನಲ್ಲ!"}, {"id": 18, "duration_s": 1.36, "emotion": "happy", "text": "ನಡೀರಿ, ಹೋಗೋಣ!"}, {"id": 19, "duration_s": 2.87, "emotion": "comic_panic", "text": "ಬದುಕಿತು! ನನ್ ಬಾಂಬ್ ಬದುಕಿತು!"}, {"id": 20, "duration_s": 3.04, "emotion": "embarrassed", "text": "ಅಯ್ಯೋ ಸೀನ, ಅದು ನನ್ ಆಟೋ ಸೀನು!"}, {"id": 21, "duration_s": 0.79, "emotion": "excited", "text": "ನಂಗೊಂದು ಐಡಿಯಾ!"}, {"id": 22, "duration_s": 2.71, "emotion": "determined", "text": "ಇವತ್ತು ರಾತ್ರಿ... ಮಕ್ಕಳ ಸೇಫ್ಟಿ ಸ್ಕ್ವಾಡ್!"}, {"id": 23, "duration_s": 2.41, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಸೀನ ಬಾಂಬ್ ತಂದಿದ್ದಾನೆ!"}, {"id": 24, "duration_s": 3.67, "emotion": "sarcastic", "text": "ಹತ್ತೇ ಸೆಕೆಂಡಲ್ಲಿ... ಇಡೀ ಕಾಲೋನಿಗೆ ಗೊತ್ತಾಯ್ತು."}, {"id": 25, "duration_s": 2.9, "emotion": "excited", "text": "ನೋಡಿ! ಸೂಪರ್ ಬಾಂಬ್! ಚಂದ್ರನಿಗಿಂತ ಜೋರು!"}, {"id": 26, "duration_s": 5.31, "emotion": "proud", "text": "ಸರಸು ಪಟಾಕಿ ಇದ್ರ ಮುಂದೆ ಠುಸ್! ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ!"}, {"id": 27, "duration_s": 1.14, "emotion": "angry", "text": "ಸೀನಾ!"}, {"id": 28, "duration_s": 3.59, "emotion": "embarrassed", "text": "ಅಮ್ಮಾ! ಈ ಗುರಿ ಎಂದೂ ತಪ್ಪಲ್ಲ..."}, {"id": 29, "duration_s": 3.88, "emotion": "stern_warning", "text": "ದೀಪದ ಹತ್ರ ಮದ್ದಾ? ಬುದ್ಧಿ ಇದ್ಯಾ?"}, {"id": 30, "duration_s": 2.81, "emotion": "calm", "text": "ಸಾಕು! ಈಗ ನಾನ್ ನೋಡ್ಕೊಳ್ತೀನಿ."}, {"id": 31, "duration_s": 3.13, "emotion": "stern_warning", "text": "ಪಟಾಕಿ ಬೆಂಕಿಯಿಂದ ದೂರ, ತಂಪು ಜಾಗದಲ್ಲಿ."}, {"id": 32, "duration_s": 5.237, "emotion": "proud", "text": "ಮೊದಲ ಬತ್ತಿ ನಾನೇ ಹಚ್ಚೋದು! ನಾನ್ಯಾರಿಗೂ ಹೆದರಲ್ಲ!"}, {"id": 33, "duration_s": 3.52, "emotion": "sarcastic", "text": "ಕಳೆದ ವರ್ಷ ಹೂಕುಂಡ ನೋಡಿ ಬೀರುವಿನಲ್ಲಿ ಅಡಗಿದ್ದು ಯಾರು?"}, {"id": 34, "duration_s": 2.5, "emotion": "embarrassed", "text": "ಅದು... ಬೀರು ಒಳಗಿಂದ ಕ್ಲೀನ್ ಮಾಡ್ತಿದ್ದೆ."}, {"id": 35, "duration_s": 2.85, "emotion": "proud", "text": "ಚಪ್ಪಲಿ ವಾಪಸ್. ಗುರಿ ರೆಡಿ."}, {"id": 36, "duration_s": 4.7, "emotion": "shouting", "text": "ಸೈಲೆಂಟ್ ಪಟಾಕಿ! ಹೊಗೆ ಇಲ್ಲ, ಸದ್ದಿಲ್ಲ, ಭಯ ಇಲ್ಲ!"}, {"id": 37, "duration_s": 2.62, "emotion": "proud", "text": "ನೂರು ರೂಪಾಯಿ ಡಬ್ಬ! ಒಂದ್ರೂಪಾಯಿ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 38, "duration_s": 3.49, "emotion": "curious", "text": "ದುಡ್ಡು ದಾಸಪ್ಪ, ಸೈಲೆಂಟ್ ಪಟಾಕಿ ಹಚ್ಚೋದು ಹೇಗೆ?"}, {"id": 39, "duration_s": 3.21, "emotion": "mischievous", "text": "ಅಷ್ಟು ಸೈಲೆಂಟು... ಹಚ್ಚಿದ್ದೇ ಗೊತ್ತಾಗಲ್ಲ!"}, {"id": 40, "duration_s": 3.49, "emotion": "proud", "text": "ವಿಜ್ಞಾನ ಹೇಳುತ್ತೆ... ಸದ್ದು ನೇರ ಮೆದುಳಿಗೆ ಬರುತ್ತೆ!"}, {"id": 41, "duration_s": 2.57, "emotion": "excited", "text": "ಓಹೋ... ಹೌದು, ಕೇಳಿಸ್ತಿದೆ!"}, {"id": 42, "duration_s": 2.49, "emotion": "sad", "text": "ಇದರಲ್ಲಿ ತಿನ್ನೋಕೂ ಏನಿಲ್ಲ!"}, {"id": 43, "duration_s": 1.38, "emotion": "happy", "text": "ಹಸಿವಾಗ್ತಿದೆ!"}, {"id": 44, "duration_s": 3.13, "emotion": "shocked", "text": "ಕೇಳಿದ್ರಾ? ದುಡ್ಡು ದಾಸಪ್ಪ ಖಾಲಿ ಡಬ್ಬ ಮಾರ್ತಿದ್ದಾರೆ!"}, {"id": 45, "duration_s": 0.92, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪ!"}, {"id": 46, "duration_s": 4.854, "emotion": "embarrassed", "text": "ಭಾಗ್ಯ... ಇದು ಮಾಲಿನ್ಯ ರಹಿತ ಪ್ಯಾಕಿಂಗ್!"}, {"id": 47, "duration_s": 3.46, "emotion": "sad", "text": "<sigh> ಸೈಲೆಂಟ್ ಪಟಾಕಿ... ಸೈಲೆಂಟ್ ಗಿರಾಕಿ."}, {"id": 48, "duration_s": 2.64, "emotion": "serious", "text": "ಪಟಾಕಿಗೂ ದೃಷ್ಟಿ ಆಗುತ್ತೆ, ಕಂದ!"}, {"id": 49, "duration_s": 2.14, "emotion": "worried", "text": "ಅಜ್ಜಿ, ನಿಂಬೆಹಣ್ಣು ಢಮಾರ್ ಅಂದ್ರೆ?"}, {"id": 50, "duration_s": 1.95, "emotion": "serious", "text": "ಹುಳಿ ಸ್ಫೋಟ ಆಗುತ್ತೆ."}, {"id": 51, "duration_s": 3.66, "emotion": "sarcastic", "text": "ಕಾನ್ಸ್ಟೇಬಲ್ ನಿದ್ದೆ ಗೌಡ ಕಾಲೋನಿ ಕಾಯ್ತಿದ್ರು..."}, {"id": 52, "duration_s": 2.14, "emotion": "happy", "text": "ಹಾರ್ನಿಗೂ ದೃಷ್ಟಿ ಆಯ್ತು!"}, {"id": 53, "duration_s": 4.814, "emotion": "pleading", "text": "ಒಂದೇ ಒಂದು... ತನಿಖೆಗೆ ಮಾತ್ರ."}, {"id": 54, "duration_s": 1.05, "emotion": "stern_warning", "text": "ತನಿಖೆ!"}, {"id": 55, "duration_s": 3.37, "emotion": "sad", "text": "<sigh> ತನಿಖೆನೇ ಸಿಹಿ ತಿಂದ್ಬಿಡ್ತು."}, {"id": 56, "duration_s": 4.2, "emotion": "proud", "text": "ನಾನ್ಯಾರಿಗೂ ಹೆದರಲ್ಲ! ಬೆಂಕಿ, ಕಿಡಿ, ಸದ್ದಿಗೆ ಮಾತ್ರ."}, {"id": 57, "duration_s": 2.52, "emotion": "loving", "text": "ಹಾಗಾದ್ರೆ ನಿಂಬೆ ನಿಂಗೂ ಒಂದು."}, {"id": 58, "duration_s": 3.21, "emotion": "excited", "text": "ಸಂಜೆ... ಮಕ್ಕಳು ಜವಾಬ್ದಾರಿ ತಗೊಂಡ್ರು."}, {"id": 59, "duration_s": 2.59, "emotion": "determined", "text": "ಇದು ಸೇಫ್ಟಿ ಗೆರೆ! ಇದರಾಚೆ ಯಾರೂ ಇಲ್ಲ!"}, {"id": 60, "duration_s": 4.16, "emotion": "serious", "text": "ನಾ ಹೇಳ್ಲಾ? ನೀರಿನ ಬಕೆಟ್, ಉಸುಕಿನ ಬಕೆಟ್, ಮತ್ತೆ ಅಂತರ!"}, {"id": 61, "duration_s": 2.61, "emotion": "excited", "text": "ನೀರ್ ದೋಸೆ? ಎಲ್ಲಿದೆ ನೀರ್ ದೋಸೆ?"}, {"id": 62, "duration_s": 2.11, "emotion": "excited", "text": "ನೀರ್ ದೋಸೆ?! ಎಲ್ಲಿ?!"}, {"id": 63, "duration_s": 3.01, "emotion": "sarcastic", "text": "ನೀರಿನ ಬಕೆಟ್, ಮೇಷ್ಟ್ರೇ! ಮತ್ತೆ ಉಸುಕು!"}, {"id": 64, "duration_s": 2.74, "emotion": "curious", "text": "ಉಸುಳಿ? ಉಸುಳಿ ರೇಟ್ ಎಷ್ಟು?"}, {"id": 65, "duration_s": 2.3, "emotion": "embarrassed", "text": "ಮುಖ್ಯ ಟೈಮ್ನಲ್ಲೇ ಇದಕ್ಕೆ ರಜೆ!"}, {"id": 66, "duration_s": 3.04, "emotion": "shouting", "text": "ದೊಡ್ಡೋರೆಲ್ಲ ಇಲ್ಲಿ ಬನ್ನಿ! ರೂಲ್ಸ್ ಕೇಳಿ!"}, {"id": 67, "duration_s": 2.93, "emotion": "stern_warning", "text": "ಕೈಯಲ್ಲಿ ಬರೀ ಬತ್ತಿ! ಬೇರೆ ಪಟಾಕಿ ಯಾವಾಗ್ಲೂ ಇಲ್ಲ!"}, {"id": 68, "duration_s": 2.98, "emotion": "stern_warning", "text": "ರೇಷ್ಮೆ ಬಟ್ಟೆ ದೀಪದಿಂದ ದೂರ! ಹತ್ತಿ ಹಾಕಿ!"}, {"id": 69, "duration_s": 1.51, "emotion": "comic_panic", "text": "ಐದು ನಿಮಿಷ! ಇಲ್ಲೇ ಬಂದೆ!"}, {"id": 70, "duration_s": 1.8, "emotion": "shouting", "text": "ಸೈಲೆಂಟ್! ವಾಪಸ್!"}, {"id": 71, "duration_s": 2.09, "emotion": "embarrassed", "text": "ನಾನು... ಗೆರೆ ಚೆಕ್ ಮಾಡ್ತಿದ್ದೆ."}, {"id": 72, "duration_s": 3.74, "emotion": "sarcastic", "text": "ರಾತ್ರಿ ಆಯ್ತು... ಹೀರೋ ಹತ್ತಿ ಜುಬ್ಬದಲ್ಲಿ ಬಂದ."}, {"id": 73, "duration_s": 1.03, "emotion": "proud", "text": "ನಾನ್ಯಾರಿಗೂ ಹೆದರಲ್ಲ! ಹಚ್ಚಿ!"}, {"id": 74, "duration_s": 5.58, "emotion": "stern_warning", "text": "ಕೈ ನೇರ! ಮುಖದಿಂದ ದೂರ! ಬಕೆಟ್ ಹತ್ರ!"}, {"id": 75, "duration_s": 0.99, "emotion": "comic_panic", "text": "ಕಿ... ಕಿಡಿ!"}, {"id": 76, "duration_s": 0.84, "emotion": "comic_panic", "text": "ಅಯ್ಯಯ್ಯೋ!"}, {"id": 77, "duration_s": 1.68, "emotion": "comic_panic", "text": "ಇದು ಆರೋದೇ ಇಲ್ವಲ್ಲಾ?!"}, {"id": 78, "duration_s": 2.24, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಶಿವಣ್ಣ ಮ್ಯಾರಥಾನ್ ಓಡ್ತಿದ್ದಾರೆ!"}, {"id": 79, "duration_s": 2.372, "emotion": "sarcastic", "text": "ಬತ್ತಿ ಎರಡು ನಿಮಿಷದ ಹಿಂದೇನೇ ಆರಿತ್ತು."}, {"id": 80, "duration_s": 1.27, "emotion": "tired", "text": "...ಮತ್ತೆ ಹೇಳ್ಲಿಲ್ಲ ಯಾಕೆ?"}, {"id": 81, "duration_s": 2.91, "emotion": "giggly", "text": "ಅಪ್ಪಾ, ಬತ್ತಿ ನಿಂತು ಹಚ್ತಾರೆ, ಓಡ್ತಾ ಅಲ್ಲ!"}, {"id": 82, "duration_s": 3.37, "emotion": "serious", "text": "ಸುಟ್ಟ ತಂತಿ ನೇರ ನೀರಿಗೆ. ಕಾಲಿಗಲ್ಲ."}, {"id": 83, "duration_s": 3.34, "emotion": "giggly", "text": "ಮೊದಲ ಬತ್ತಿ... ಮೊದಲ ಮ್ಯಾರಥಾನ್!"}, {"id": 84, "duration_s": 1.76, "emotion": "mischievous", "text": "ಹೊಸ ಪ್ರ್ಯಾಂಕ್! ಚಾಕೊಲೇಟ್ ಬಾಂಬ್!"}, {"id": 85, "duration_s": 3.34, "emotion": "curious", "text": "ಬಾಂಬಲ್ಲಿ... ಚಾಕೊಲೇಟ್ ವಾಸನೆ?"}, {"id": 86, "duration_s": 1.68, "emotion": "shouting", "text": "ಬೂ... ಬೂ... ಬೂಮ್!"}, {"id": 87, "duration_s": 1.31, "emotion": "panicked", "text": "ಬೊಂಡ ಸಿಡೀತು!"}, {"id": 88, "duration_s": 0.87, "emotion": "shouting", "text": "ಬೊಂಡಾ!!"}, {"id": 89, "duration_s": 3.4, "emotion": "giggly", "text": "ಒಳಗೆ ಚಾಕೊಲೇಟ್ ಇತ್ತು! ಹಸಿವಾಗಿತ್ತು!"}, {"id": 90, "duration_s": 2.89, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಬೊಂಡ... ಮತ್ತೆ ಹಸಿದಿದ್ದಾನೆ!"}, {"id": 91, "duration_s": 4.47, "emotion": "stern_warning", "text": "ಪಟಾಕಿ ಜೊತೆ ತಮಾಷೆ ಬೇಡ, ಅಕ್ಕಾ! ಎಲ್ರೂ ಹೆದರಿದ್ರು."}, {"id": 92, "duration_s": 1.71, "emotion": "embarrassed", "text": "ಸಾರಿ... ರೀಲ್ ಡಿಲೀಟ್."}, {"id": 93, "duration_s": 2.54, "emotion": "mischievous", "text": "ಈಗ... ಕಥೆ ನಿಂತ ಜಾಗಕ್ಕೇ ವಾಪಸ್."}, {"id": 94, "duration_s": 2.92, "emotion": "stern_warning", "text": "ಉದ್ದ ಊದುಬತ್ತಿ! ಕೈ ನೇರ! ಹಚ್ಚಿ, ಹಿಂದೆ!"}, {"id": 95, "duration_s": 2.15, "emotion": "comic_panic", "text": "ಹತ್ತಿತು! ಓಡು... ಅಂದ್ರೆ, ಹಿಂದೆ ಸರಿ!"}, {"id": 96, "duration_s": 2.04, "emotion": "proud", "text": "ಇರಿ... ಇದು ಯೋಚ್ನೆ ಮಾಡ್ತಿದೆ."}, {"id": 97, "duration_s": 2.8, "emotion": "serious", "text": "ವಿಜ್ಞಾನ ಹೇಳುತ್ತೆ... ಇದು ನಿದ್ದೆ ಮಾಡಿದೆ."}, {"id": 98, "duration_s": 3.01, "emotion": "shouting", "text": "ನಿಲ್ಲಿ! ಠುಸ್ ಪಟಾಕಿ ಹತ್ರ ಯಾರೂ ಹೋಗ್ಬೇಡಿ!"}, {"id": 99, "duration_s": 3.43, "emotion": "serious", "text": "ನಾ ಹೇಳ್ಲಾ? ಹದಿನೈದು ನಿಮಿಷ ಕಾಯಿರಿ, ಆಮೇಲೆ ನೀರು."}, {"id": 100, "duration_s": 3.77, "emotion": "sarcastic", "text": "ಹದಿನೈದು ನಿಮಿಷ? ನನ್ ಬಡ್ಡಿ ಓಡ್ತಿದೆ!"}, {"id": 101, "duration_s": 1.42, "emotion": "embarrassed", "text": "...ಚಂದ್ರನಿಗಿಂತ ಜೋರು."}, {"id": 102, "duration_s": 2.63, "emotion": "sarcastic", "text": "ಲೈವ್ ನಡೀತಿದೆ... ದುರದೃಷ್ಟಕ್ಕೆ."}, {"id": 103, "duration_s": 1.17, "emotion": "angry", "text": "ಸೀನಾ..."}, {"id": 104, "duration_s": 0.97, "emotion": "shouting", "text": "ತನಿಖೆ!"}, {"id": 105, "duration_s": 4.978, "emotion": "embarrassed", "text": "ಹಾರ್ನ್ ಕಾರಣ! ನಿಜವಾಗ್ಲೂ!"}, {"id": 106, "duration_s": 4.75, "emotion": "curious", "text": "ಏನಾಯ್ತು? ಸಿಹಿ ಹಂಚ್ತಿದ್ದಾರಾ?"}, {"id": 107, "duration_s": 3.33, "emotion": "tender", "text": "ಅಯ್ಯೋ ಟಾಮಿ... ನೀನೂ ಹೆದರಿದ್ಯಾ?"}, {"id": 108, "duration_s": 2.08, "emotion": "worried", "text": "ಪ್ರಾಣಿಗಳ ಕಿವಿ ನಮಗಿಂತ ಭಾಳ ಚುರುಕು."}, {"id": 109, "duration_s": 4.601, "emotion": "serious", "text": "ನಮಗೆ ಪಟಾಕಿ ಅನಿಸಿದ್ದು, ಅವಕ್ಕೆ ಬಿರುಗಾಳಿ."}, {"id": 110, "duration_s": 3.4, "emotion": "tender", "text": "ಶ್ಶ್ಶ್... ಟಾಮಿಗೆ ಶಾಂತ ಮೂಲೆ!"}, {"id": 111, "duration_s": 4.53, "emotion": "calm", "text": "ಸದ್ದಿನಿಂದ ದೂರ... ಒಂದು ಪುಟ್ಟ ಶಾಂತ ಮೂಲೆ."}, {"id": 112, "duration_s": 3.23, "emotion": "happy", "text": "ನನ್ ಕಿವಿನೂ ಮುದುಕಾಗಿದೆ. ನಾನೂ ಇಲ್ಲೇ!"}, {"id": 113, "duration_s": 1.88, "emotion": "tender", "text": "ಬಾ ಟಾಮಿ, ಇಲ್ಲಿ ಸದ್ದಿಲ್ಲ."}, {"id": 114, "duration_s": 2.48, "emotion": "serious", "text": "ಪಾಪ, ದೃಷ್ಟಿ ಆಗಿತ್ತು ಅದಕ್ಕೆ!"}, {"id": 115, "duration_s": 3.27, "emotion": "proud", "text": "ಭಲೇ, ನನ್ ಸೇಫ್ಟಿ ಸ್ಕ್ವಾಡ್."}, {"id": 116, "duration_s": 3.45, "emotion": "mischievous", "text": "ಆಮೇಲೆ... ಸೂಪರ್ ಬಾಂಬ್ ಪೋಸ್ಟ್ ಮಾರ್ಟಂ."}, {"id": 117, "duration_s": 5.23, "emotion": "serious", "text": "ತನಿಖೆ ಆಗುತ್ತೆ! ...ಪದರ ಪದರವಾಗಿ."}, {"id": 118, "duration_s": 2.35, "emotion": "sad", "text": "ಇಷ್ಟು ದೊಡ್ಡ ಡಬ್ಬ... ಒಳಗೆ ಇಷ್ಟೇನಾ?"}, {"id": 119, "duration_s": 2.07, "emotion": "serious", "text": "ಹೆಸರಿಲ್ಲದ ಪಟಾಕಿ ಅಪಾಯಕಾರಿ ಆಗಬಹುದು."}, {"id": 120, "duration_s": 3.11, "emotion": "loving", "text": "ಚಿಕ್ಕಪ್ಪ, ಲೈಸೆನ್ಸ್ ಅಂಗಡಿಲಿ ತಗೊಳ್ಳಿ. ವ್ಯಾನ್ನಲ್ಲಿ ಬೇಡ."}, {"id": 121, "duration_s": 4.95, "emotion": "guilty", "text": "ಸರಿ ಹೇಳ್ದೆ. ಮುಂದಿನಸಲ ಮೊದಲು ಕೇಳ್ತೀನಿ."}, {"id": 122, "duration_s": 2.17, "emotion": "giggly", "text": "ಟೆನ್ಷನ್ ಮಾಡ್ಕೊಳ್ತೀನಿ... ಸ್ವಲ್ಪ."}, {"id": 123, "duration_s": 2.85, "emotion": "stern_warning", "text": "ದುಡ್ಡು ದಾಸಪ್ಪ! ಖಾಲಿ?"}, {"id": 124, "duration_s": 6.45, "emotion": "guilty", "text": "ಸರಿ! ಎಲ್ರಿಗೂ... ಫ್ರೀ ಸಿಹಿ!"}, {"id": 125, "duration_s": 2.95, "emotion": "crying", "text": "ಫ್ರೀ... ಹೇಳೋಕೂ ನೋವಾಗುತ್ತೆ."}, {"id": 126, "duration_s": 2.778, "emotion": "serious", "text": "ತನಿಖೆ ಮುಗೀತು."}, {"id": 127, "duration_s": 1.63, "emotion": "happy", "text": "ಸಮ ಹಂಚ್ಕೊಂಡ್ವಿ!"}, {"id": 128, "duration_s": 4.93, "emotion": "calm", "text": "ಆ ರಾತ್ರಿ ಕಾಲೋನಿಯಲ್ಲಿ ಹೊಗೆ ಕಮ್ಮಿ... ಬೆಳಕು ಜಾಸ್ತಿ."}, {"id": 129, "duration_s": 3.69, "emotion": "loving", "text": "ಈ ದೀಪ ಸದ್ದಿಲ್ದೇ ಉರಿಯುತ್ತೆ... ರಾತ್ರಿ ಪೂರ್ತಿ."}, {"id": 130, "duration_s": 2.6, "emotion": "giggly", "text": "ಇದಕ್ಕೆ ವಿಸಿಲ್ ಕೂಡ ಬೇಕಿಲ್ಲ!"}, {"id": 131, "duration_s": 3.64, "emotion": "excited", "text": "ಹೊಸ ರೀಲ್... 'ಸೈಲೆಂಟ್ ದೀಪಾವಳಿ'! ಲೈವ್ ನಡೀತಿದೆ!"}, {"id": 132, "duration_s": 2.19, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಪಲ್ಲವಿ ರೀಲ್ ವೈರಲ್!"}, {"id": 133, "duration_s": 4.35, "emotion": "proud", "text": "ನೋಡಿದ್ರಾ? ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ತು! ದೇಶನೂ ನೋಡ್ತು!"}, {"id": 134, "duration_s": 3.12, "emotion": "giggly", "text": "ರೀಲ್ನಲ್ಲಿ ನಿಮ್ ಚಪ್ಪಲಿನೂ ಇದೆ!"}, {"id": 135, "duration_s": 2.81, "emotion": "proud", "text": "ವಿಜ್ಞಾನ ಹೇಳುತ್ತೆ... ದೀಪವೇ ಸೇಫ್ ಪಟಾಕಿ."}, {"id": 136, "duration_s": 3.65, "emotion": "shocked", "text": "ಜ್ಞಾನಿ ಸರಿ ಹೇಳಿದ?! ...ನಾ ಸರಿ ಕೇಳಿಸ್ಕೊಂಡ್ನಾ?"}, {"id": 137, "duration_s": 6.7, "emotion": "serious", "text": "ಪಟಾಕಿ ಕೈಯಲ್ಲಿ ಇಲ್ಲ, ಬಕೆಟ್ ಹತ್ರ, ಮಕ್ಕಳು ದೊಡ್ಡೋರ ಜೊತೆ."}, {"id": 138, "duration_s": 6.61, "emotion": "loving", "text": "ಮತ್ತೆ ಪ್ರಾಣಿಗಳಿಗೆ, ಹಿರಿಯರಿಗೆ ಒಂದು ಶಾಂತ ಮೂಲೆ."}, {"id": 139, "duration_s": 5.51, "emotion": "calm", "text": "ಬೆಳಕು ಮನಸ್ಸಲ್ಲಿರಲಿ... ಸ್ಫೋಟ ಕೈಯಲ್ಲಿ ಬೇಡ."}, {"id": 140, "duration_s": 2.42, "emotion": "excited", "text": "ಹ್ಯಾಪಿ ಸೇಫ್ ದೀಪಾವಳಿ!"}]