[{"id": 1, "duration_s": 11.12, "emotion": "embarrassed", "text": "হয়, এইটো মই। ভাবিছে, এয়া কেনেকৈ হ'ল?"}, {"id": 2, "duration_s": 12.13, "emotion": "mischievous", "text": "ৰাতিপুৱাৰ পৰা কওঁ। পাৰাত আহিল... এখন নতুন বাইক।"}, {"id": 3, "duration_s": 5.01, "emotion": "proud", "text": "নতুন বাইক! পুৰা আশী হাজাৰৰ... এটকাও কম নহয়!"}, {"id": 4, "duration_s": 3.11, "emotion": "mischievous", "text": "মোৰ দেউতাৰ বাইক! তোমাৰ দেউতাৰ কি আছে?"}, {"id": 5, "duration_s": 4.721, "emotion": "proud", "text": "মোৰ দেউতাৰ আছে... গোঁফ!"}, {"id": 6, "duration_s": 4.37, "emotion": "sarcastic", "text": "গোঁফ মোৰ দেউতাৰো আছে... বাইকৰ লগতে!"}, {"id": 7, "duration_s": 1.67, "emotion": "shocked", "text": "গোঁফ?! মোৰ ইজ্জতৰ প্ৰশ্ন!"}, {"id": 8, "duration_s": 3.47, "emotion": "proud", "text": "সন্ধিয়ালৈ বাটত মোৰ গাড়ী চলিব!"}, {"id": 9, "duration_s": 3.57, "emotion": "excited", "text": "শুনিছা নেকি? হৰিয়ে গাড়ী আনিছে... জাহাজৰ সমান ডাঙৰ!"}, {"id": 10, "duration_s": 3.17, "emotion": "sarcastic", "text": "সন্ধিয়া গাড়ী আহিল... ঠেলি ঠেলি।"}, {"id": 11, "duration_s": 2.53, "emotion": "tired", "text": "আহিলি... মোৰ বাঘিনী।"}, {"id": 12, "duration_s": 2.43, "emotion": "sarcastic", "text": "এইখন চলে, নে এইখনকো ঠেলিব লাগে?"}, {"id": 13, "duration_s": 3.91, "emotion": "proud", "text": "ভিণ্টেজ! মানে পুৰণি, কিন্তু দামী!"}, {"id": 14, "duration_s": 1.82, "emotion": "comic_panic", "text": "মই... কাকো ভয় নকৰোঁ!"}, {"id": 15, "duration_s": 4.81, "emotion": "laughing", "text": "হাহা! স্কুটী পোন্ধৰ হাজাৰ, ধোঁৱা ফ্ৰী!"}, {"id": 16, "duration_s": 0.89, "emotion": "stern_warning", "text": "ধনৰাম!"}, {"id": 17, "duration_s": 1.18, "emotion": "excited", "text": "চলিল দেউতা!"}, {"id": 18, "duration_s": 2.96, "emotion": "serious", "text": "নজৰ লাগিব! নেমু-জলকীয়া লাগিবই!"}, {"id": 19, "duration_s": 3.38, "emotion": "proud", "text": "গোটেই পাৰাই চাব! মোৰ ল'ৰাৰ গাড়ী!"}, {"id": 20, "duration_s": 3.57, "emotion": "proud", "text": "আজি চুলি এনেকৈ চেট... যে বাইকো লাজ পাব।"}, {"id": 21, "duration_s": 0.79, "emotion": "stern_warning", "text": "হেলমেট পিন্ধা।"}, {"id": 22, "duration_s": 2.93, "emotion": "pleading", "text": "হেলমেটত চুলি নষ্ট হয়, ৰূপা! কেতিয়াও নহয়!"}, {"id": 23, "duration_s": 1.9, "emotion": "determined", "text": "হ'ল! এতিয়া মই চাওঁ।"}, {"id": 24, "duration_s": 2.53, "emotion": "comic_panic", "text": "মই কাকো ভয় নকৰোঁ... টিকটিকী বাদে!"}, {"id": 25, "duration_s": 2.68, "emotion": "sarcastic", "text": "টিকটিকী গ'ল। এতিয়া চুলিও যাব।"}, {"id": 26, "duration_s": 1.97, "emotion": "giggly", "text": "দেউতা, হেলমেট ওলোটা!"}, {"id": 27, "duration_s": 2.84, "emotion": "proud", "text": "জানো! এইটো পিছৰ জনৰ বাবে!"}, {"id": 28, "duration_s": 2.77, "emotion": "excited", "text": "লাইভ চলিছে! দেউতাৰ ওলোটা হেলমেট!"}, {"id": 29, "duration_s": 0.95, "emotion": "sad", "text": "মোৰ চুলি... শ'হীদ হ'ল।"}, {"id": 30, "duration_s": 2.35, "emotion": "stern_warning", "text": "ফিতাও বান্ধা।"}, {"id": 31, "duration_s": 0.65, "emotion": "mischievous", "text": "কালিৰে।"}, {"id": 32, "duration_s": 2.12, "emotion": "excited", "text": "টেনচন নলবা! আজি মই শিকাম।"}, {"id": 33, "duration_s": 2.11, "emotion": "proud", "text": "স্কুটীত ক্লাচ নাই, খালি ৰেচ দিয়া!"}, {"id": 34, "duration_s": 2.07, "emotion": "sarcastic", "text": "দাদা, আগতে ষ্টাৰ্ট কৰা!"}, {"id": 35, "duration_s": 1.95, "emotion": "excited", "text": "চোৱা! মই উৰিছোঁ!"}, {"id": 36, "duration_s": 2.07, "emotion": "proud", "text": "হিৰো! দহ কিলোমিটাৰ হ'ল!"}, {"id": 37, "duration_s": 1.17, "emotion": "proud", "text": "নলৰাকৈয়ে!"}, {"id": 38, "duration_s": 1.45, "emotion": "shouting", "text": "ৰেচ দিয়া! আগলৈ!"}, {"id": 39, "duration_s": 2.31, "emotion": "comic_panic", "text": "আগলৈ কেনেকৈ? গাড়ী পিছলৈ যাইছে!"}, {"id": 40, "duration_s": 1.83, "emotion": "comic_panic", "text": "ব্ৰেক! ব্ৰেক! হাতৰ ব্ৰেক!"}, {"id": 41, "duration_s": 0.77, "emotion": "embarrassed", "text": "মই ঠিক। গাড়ীও ঠিক।"}, {"id": 42, "duration_s": 1.25, "emotion": "serious", "text": "নজৰ লাগিল! কৈছিলোঁ নহয়?"}, {"id": 43, "duration_s": 5.31, "emotion": "sad", "text": "নেমুৰে ব্ৰেক নধৰে, আইতা।"}, {"id": 44, "duration_s": 2.55, "emotion": "angry", "text": "ধনু! আগতে নিজে শিক!"}, {"id": 45, "duration_s": 3.68, "emotion": "embarrassed", "text": "টেনচন নলবা... নিশানা একেবাৰে পাকৈত।"}, {"id": 46, "duration_s": 2.97, "emotion": "mischievous", "text": "এটা বুদ্ধি আছে! দেউতাতকৈ আমিয়ে ভাল চলাম!"}, {"id": 47, "duration_s": 2.7, "emotion": "excited", "text": "মই পিছত বহিম... জলপানেৰে।"}, {"id": 48, "duration_s": 1.05, "emotion": "stern_warning", "text": "চুপ! হাত আতৰোৱা!"}, {"id": 49, "duration_s": 3.87, "emotion": "serious", "text": "ল'ৰাই গাড়ী নচলায়। কেতিয়াও! বুজিলা?"}, {"id": 50, "duration_s": 3.64, "emotion": "serious", "text": "মই কওঁ? আঠাৰ বছৰৰ আগত গাড়ী চলোৱা মানা।"}, {"id": 51, "duration_s": 3.13, "emotion": "serious", "text": "ভৰি মাটিত নালাগে। ব্ৰেক কেনেকৈ মাৰিবা?"}, {"id": 52, "duration_s": 1.54, "emotion": "proud", "text": "চাবি জব্দ!"}, {"id": 53, "duration_s": 2.5, "emotion": "excited", "text": "আৰু এটা বুদ্ধি আছে! দেউতাক আমি শিকাম!"}, {"id": 54, "duration_s": 4.16, "emotion": "tired", "text": "মই কাকো ভয় নকৰোঁ... ঘৰ্ৰ্ৰ..."}, {"id": 55, "duration_s": 4.28, "emotion": "proud", "text": "চোৱা পাৰা! হৰি শৰ্মা... অন দ্য ৰোড!"}, {"id": 56, "duration_s": 2.75, "emotion": "proud", "text": "হয় ধনৰাম? স্কুটী বতাহৰ লগত কথা কয়!"}, {"id": 57, "duration_s": 4.15, "emotion": "sarcastic", "text": "বতাহৰ লগত নহয়, মোৰ লগত! মন দিয়া!"}, {"id": 58, "duration_s": 3.432, "emotion": "happy", "text": "নমস্কাৰ মৃদুলা বাইদেউ! কওক ধনৰাম!"}, {"id": 59, "duration_s": 9.593, "emotion": "sarcastic", "text": "এখন হাতত ফোন, আনখনত নমস্কাৰ... গাড়ী কাৰ হাতত?"}, {"id": 60, "duration_s": 2.59, "emotion": "comic_panic", "text": "হৰি! আগলৈ চোৱা! আগলৈ!"}, {"id": 61, "duration_s": 3.58, "emotion": "curious", "text": "আগলৈ? ধনৰাম, আপুনি ফোনত!"}, {"id": 62, "duration_s": 3.56, "emotion": "embarrassed", "text": "মই ঠিক আছোঁ! গাড়ীও ঠিক! বাকচ...?"}, {"id": 63, "duration_s": 2.17, "emotion": "crying", "text": "মোৰ বাকচ! মোৰ শ্ব'কেচ!"}, {"id": 64, "duration_s": 1.85, "emotion": "shocked", "text": "খালী! ইয়াও খালী!"}, {"id": 65, "duration_s": 2.62, "emotion": "sad", "text": "সকলো খালী! এটা পিঠাও নাই!"}, {"id": 66, "duration_s": 1.96, "emotion": "stern_warning", "text": "ধনৰাম! বাকচ খালী?"}, {"id": 67, "duration_s": 2.83, "emotion": "embarrassed", "text": "দেখুৱাবলৈহে! ভৰা বাকচত বহুত খৰচ!"}, {"id": 68, "duration_s": 4.5, "emotion": "proud", "text": "দেখিছা? হেলমেটত খালি বাকচ পৰিল।"}, {"id": 69, "duration_s": 2.27, "emotion": "serious", "text": "ভাবি চোৱা, হেলমেট নাথাকিলে?"}, {"id": 70, "duration_s": 1.16, "emotion": "happy", "text": "চুলি বাচিলহেঁতেন!"}, {"id": 71, "duration_s": 4.14, "emotion": "sarcastic", "text": "ইমান হুলস্থূলতো... কনষ্টেবল তপনৰাম টোপনিত।"}, {"id": 72, "duration_s": 4.92, "emotion": "shouting", "text": "সমুচা? মানে... তদন্ত হ'ব!"}, {"id": 73, "duration_s": 4.13, "emotion": "stern_warning", "text": "ফিতা খোলা, হাতত ফোন... লাইচেন্স দেখুৱা!"}, {"id": 74, "duration_s": 2.9, "emotion": "sarcastic", "text": "এইটো ৰেচন কাৰ্ড।"}, {"id": 75, "duration_s": 2.95, "emotion": "curious", "text": "জিম কাৰ্ড! জিমলৈ যোৱা নেকি?"}, {"id": 76, "duration_s": 1.19, "emotion": "embarrassed", "text": "কাৰ্ডহে যায়।"}, {"id": 77, "duration_s": 3.42, "emotion": "shocked", "text": "এইটো... কোনোবা ল'ৰাৰ ৰিপৰ্ট কাৰ্ড!"}, {"id": 78, "duration_s": 1.87, "emotion": "embarrassed", "text": "দেউতা! মোৰেই!"}, {"id": 79, "duration_s": 5.37, "emotion": "serious", "text": "লাইচেন্স নাই, ফোনত কথা... চালান কটা হ'ব!"}, {"id": 80, "duration_s": 4.13, "emotion": "pleading", "text": "কনষ্টেবল চাহাব... গৰম সমুচা? চালানৰ সলনি?"}, {"id": 81, "duration_s": 5.409, "emotion": "stern_warning", "text": "ঘুচ? আলুৰ ঘুচ? একেবাৰে নহয়!"}, {"id": 82, "duration_s": 10.33, "emotion": "embarrassed", "text": "ভোক লাগিছে!"}, {"id": 83, "duration_s": 13.41, "emotion": "serious", "text": "আগতে আৰটিঅ' যোৱা। লাৰ্নাৰ লাইচেন্স উলিওৱা।"}, {"id": 84, "duration_s": 13.06, "emotion": "sarcastic", "text": "জৰিমনা হাত-খৰচৰ পৰা কটা যাব।"}, {"id": 85, "duration_s": 3.42, "emotion": "shocked", "text": "মোৰ হাত-খৰচ? মই তো দেউতা!"}, {"id": 86, "duration_s": 11.31, "emotion": "determined", "text": "দেউতা, কালিৰ পৰা... পাৰা ড্ৰাইভিং স্কুল!"}, {"id": 87, "duration_s": 14.95, "emotion": "excited", "text": "এসপ্তাহৰ পাছত... সৰুহঁতে খুলিলে ড্ৰাইভিং স্কুল!"}, {"id": 88, "duration_s": 11.46, "emotion": "excited", "text": "পাৰা ড্ৰাইভিং স্কুল! আজি সকলোৰে পৰীক্ষা!"}, {"id": 89, "duration_s": 5.47, "emotion": "serious", "text": "মই কওঁ? চাৰিটা নিয়ম: হেলমেট, দুয়ো হাত, ফোন নাই, লাইচেন্স।"}, {"id": 90, "duration_s": 2.45, "emotion": "proud", "text": "আৰু সৰুহঁতে? খালি হাত-চাপৰি!"}, {"id": 91, "duration_s": 3.81, "emotion": "proud", "text": "পৰিবহন অফিচৰ লাৰ্নাৰ! এতিয়া মই আধা ড্ৰাইভাৰ!"}, {"id": 92, "duration_s": 2.85, "emotion": "proud", "text": "বিজ্ঞানে কয়, হেলমেটত মূৰ গৰম হয়।"}, {"id": 93, "duration_s": 4.78, "emotion": "serious", "text": "বিজ্ঞানে এইটোও কয়: হেলমেটে মূৰ বচায়।"}, {"id": 94, "duration_s": 1.4, "emotion": "embarrassed", "text": "...তাকো।"}, {"id": 95, "duration_s": 2.31, "emotion": "serious", "text": "ধীৰেন চাৰ, প্ৰথম নিয়ম: ব্ৰেক!"}, {"id": 96, "duration_s": 2.82, "emotion": "happy", "text": "ব্ৰেক? হয়, লাঞ্চ ব্ৰেক!"}, {"id": 97, "duration_s": 0.9, "emotion": "shouting", "text": "ইণ্ডিকেটৰ!"}, {"id": 98, "duration_s": 3.21, "emotion": "proud", "text": "ইণ্ডিয়া গেট? দিল্লীত আছে, বোপাই!"}, {"id": 99, "duration_s": 0.98, "emotion": "shouting", "text": "লাইচেন্স!"}, {"id": 100, "duration_s": 4.09, "emotion": "stern_warning", "text": "চাইলেন্স? হয়! সকলো চুপ!"}, {"id": 101, "duration_s": 1.37, "emotion": "happy", "text": "বলা, যাওঁ!"}, {"id": 102, "duration_s": 1.54, "emotion": "serious", "text": "ইয়াকো নজৰ লাগিল!"}, {"id": 103, "duration_s": 2.94, "emotion": "curious", "text": "প্ৰথম প্ৰাৰ্থী... অটো?"}, {"id": 104, "duration_s": 2.66, "emotion": "excited", "text": "লাইভ চলিছে! পাৰাৰ মহা-পৰীক্ষা!"}, {"id": 105, "duration_s": 2.84, "emotion": "proud", "text": "টেনচন নলবা! হিৰোৰ হেলমেট নালাগে!"}, {"id": 106, "duration_s": 1.76, "emotion": "stern_warning", "text": "হেলমেট নাই? বাহিৰ!"}, {"id": 107, "duration_s": 7.32, "emotion": "serious", "text": "এক, দুই, তিনি... ৰ'ব, আকৌ... এক..."}, {"id": 108, "duration_s": 3.22, "emotion": "angry", "text": "ধনৰাম! পৰীক্ষা, হিচাপ নহয়!"}, {"id": 109, "duration_s": 2.86, "emotion": "stern_warning", "text": "মোৰ বাকচ! এটাও কম নহয়!"}, {"id": 110, "duration_s": 1.91, "emotion": "serious", "text": "শেষ! পাছৰজন!"}, {"id": 111, "duration_s": 1.89, "emotion": "excited", "text": "শুনিছা? মই পৰীক্ষা দিছোঁ..."}, {"id": 112, "duration_s": 1.581, "emotion": "stern_warning", "text": "ফোন!"}, {"id": 113, "duration_s": 3.061, "emotion": "embarrassed", "text": "...পিছত কওঁ।"}, {"id": 114, "duration_s": 1.67, "emotion": "shocked", "text": "আই! আপুনি? স্কুটীত?"}, {"id": 115, "duration_s": 2.24, "emotion": "proud", "text": "উনিশশ আশীৰ লাইচেন্স, বোপাই!"}, {"id": 116, "duration_s": 1.7, "emotion": "determined", "text": "গোটেই পাৰাই চাব!"}, {"id": 117, "duration_s": 3.898, "emotion": "proud", "text": "এওঁকো স্কুটী মইহে শিকাইছিলোঁ!"}, {"id": 118, "duration_s": 2.35, "emotion": "excited", "text": "ফাৰ্ষ্ট ক্লাছ! এশত এশ!"}, {"id": 119, "duration_s": 1.2, "emotion": "proud", "text": "মই কাকো ভয় নকৰোঁ!"}, {"id": 120, "duration_s": 2.26, "emotion": "giggly", "text": "দেউতা... আকৌ ওলোটা!"}, {"id": 121, "duration_s": 0.84, "emotion": "mischievous", "text": "এতিয়া চাওঁ..."}, {"id": 122, "duration_s": 2.82, "emotion": "determined", "text": "গাড়ী চলাওঁতে ফোন নহয়!"}, {"id": 123, "duration_s": 0.9, "emotion": "tender", "text": "আগতে আপুনি।"}, {"id": 124, "duration_s": 0.69, "emotion": "excited", "text": "পাছ!"}, {"id": 125, "duration_s": 2.53, "emotion": "serious", "text": "আচল লাইচেন্স অফিচে দিব, মই নহয়।"}, {"id": 126, "duration_s": 3.09, "emotion": "excited", "text": "হৰি পাছ! হৰি পাছ!"}, {"id": 127, "duration_s": 3.5, "emotion": "excited", "text": "মোৰ দেউতাৰ এতিয়া... গোঁফো, লাইচেন্সো!"}, {"id": 128, "duration_s": 1.91, "emotion": "happy", "text": "ধনৰাম! তালি!"}, {"id": 129, "duration_s": 3.44, "emotion": "excited", "text": "'দেউতাৰ প্ৰথম ৰাইড'! দহ লাখ ভিউজ!"}, {"id": 130, "duration_s": 2.68, "emotion": "comic_panic", "text": "মোৰ চুলি! দহ লাখ মানুহে দেখিলে?!"}, {"id": 131, "duration_s": 2.78, "emotion": "laughing", "text": "হাহা! চিৰুণীকো হেলমেট লাগিব!"}, {"id": 132, "duration_s": 2.46, "emotion": "calm", "text": "হৰি... এটা কথা মনত ৰাখিবা।"}, {"id": 133, "duration_s": 3.12, "emotion": "serious", "text": "হেলমেট মূৰৰ বাবে, চুলিৰ বাবে নহয়।"}, {"id": 134, "duration_s": 3.94, "emotion": "calm", "text": "ফিতা বান্ধা, দুয়ো হাত হেণ্ডেলত, ফোন জেপত।"}, {"id": 135, "duration_s": 5.66, "emotion": "tender", "text": "আৰু সৰুহঁতে? গাড়ী আঠাৰৰ পাছত, লাইচেন্সৰ লগত।"}, {"id": 136, "duration_s": 1.8, "emotion": "proud", "text": "তেতিয়ালৈ... তালি!"}, {"id": 137, "duration_s": 3.78, "emotion": "happy", "text": "বুজিলোঁ, দেউতা! মূৰ আগত, চুলি পাছত।"}, {"id": 138, "duration_s": 1.18, "emotion": "excited", "text": "স্মাইল, দেউতা!"}, {"id": 139, "duration_s": 0.91, "emotion": "shocked", "text": "মোৰ বাঘিনী...?"}, {"id": 140, "duration_s": 2.79, "emotion": "sad", "text": "বিয়াল্লিশ... আকৌ গণিম?"}]