[{"id": 1, "duration_s": 5.18, "emotion": "mischievous", "text": "ही आमची कॉलनी, आणि तिची सर्वात मोठी टाकी."}, {"id": 2, "duration_s": 4.61, "emotion": "mischievous", "text": "या टाकीत... एक भूत राहतं! हूऊऊ!"}, {"id": 3, "duration_s": 1.67, "emotion": "curious", "text": "भूत नसतात. मी सांगू?"}, {"id": 4, "duration_s": 0.63, "emotion": "stern_warning", "text": "गप्प!"}, {"id": 5, "duration_s": 3.86, "emotion": "mischievous", "text": "माझा खजिना... इथे कोणी शोधणार नाही."}, {"id": 6, "duration_s": 3.06, "emotion": "sarcastic", "text": "तुझं भूत... टॉर्चला घाबरतं."}, {"id": 7, "duration_s": 2.54, "emotion": "mischievous", "text": "भूत खरं आहे! आज रात्री बघ!"}, {"id": 8, "duration_s": 2.41, "emotion": "calm", "text": "मुलांनो! जेवण तयार!"}, {"id": 9, "duration_s": 2.46, "emotion": "giggly", "text": "पेढा आधीच पोहोचला!"}, {"id": 10, "duration_s": 5.39, "emotion": "scared_whisper", "text": "आणि मग... बरोबर रात्री बारा वाजता..."}, {"id": 11, "duration_s": 0.94, "emotion": "scared_whisper", "text": "भ... भ... भूत!"}, {"id": 12, "duration_s": 2.23, "emotion": "panicked", "text": "दृष्ट लागली... टाकीला!"}, {"id": 13, "duration_s": 2.42, "emotion": "scared_whisper", "text": "कमले! उठ! टाकीत भूत!"}, {"id": 14, "duration_s": 3.25, "emotion": "comic_panic", "text": "लिंबू! मिर्ची! लिंबू! मिर्ची!"}, {"id": 15, "duration_s": 3.98, "emotion": "excited", "text": "हो आजी? भूत? <gasp> खरंच?"}, {"id": 16, "duration_s": 1.84, "emotion": "excited", "text": "ऐकलं का? टाकीत भूत!"}, {"id": 17, "duration_s": 3.73, "emotion": "mischievous", "text": "दहा सेकंदात... अख्ख्या कॉलनीला कळलं."}, {"id": 18, "duration_s": 2.16, "emotion": "excited", "text": "हॅलो फ्रेंड्स! लाइव्ह सुरू आहे!"}, {"id": 19, "duration_s": 3.1, "emotion": "excited", "text": "भूत लाइव्ह! दोन लाख व्ह्यूज!"}, {"id": 20, "duration_s": 2.58, "emotion": "scared_whisper", "text": "भूतजी, एक सेल्फी प्लीज?"}, {"id": 21, "duration_s": 3.29, "emotion": "proud", "text": "सायन्स सांगतं... भूत वाय-फायवरून येतं!"}, {"id": 22, "duration_s": 1.57, "emotion": "proud", "text": "वाय-फाय बंद. भूत संपलं."}, {"id": 23, "duration_s": 3.52, "emotion": "serious", "text": "सूर चुकतोय. दहापैकी चार."}, {"id": 24, "duration_s": 1.63, "emotion": "happy", "text": "हां! आता सात!"}, {"id": 25, "duration_s": 1.03, "emotion": "proud", "text": "भूतबीत काही नसतं!"}, {"id": 26, "duration_s": 1.04, "emotion": "proud", "text": "मी कोणाला घाबरत नाही!"}, {"id": 27, "duration_s": 2.85, "emotion": "sarcastic", "text": "काल पाल पाहून कपाटावर कोण चढलं होतं?"}, {"id": 28, "duration_s": 2.61, "emotion": "embarrassed", "text": "ते... कपाटावरची धूळ बघत होतो."}, {"id": 29, "duration_s": 2.58, "emotion": "proud", "text": "जा रे बाळा! अख्खी कॉलनी बघेल!"}, {"id": 30, "duration_s": 3.95, "emotion": "scared_whisper", "text": "अहो भूतजी... मी आपलं... फिरायला आलो होतो."}, {"id": 31, "duration_s": 2.1, "emotion": "sarcastic", "text": "आलात? फिरून झालं?"}, {"id": 32, "duration_s": 4.22, "emotion": "scared_whisper", "text": "हो... खूपच... छान हवा आहे."}, {"id": 33, "duration_s": 2.91, "emotion": "guilty", "text": "मी तर फक्त... गंमत केली होती."}, {"id": 34, "duration_s": 2.59, "emotion": "mischievous", "text": "टेन्शन नको! भूत आहे... म्हणजे धंदा आहे!"}, {"id": 35, "duration_s": 4.11, "emotion": "mischievous", "text": "दुसऱ्या दिवशी सकाळी... कॉलनी घाबरलेली. शेठ खुश."}, {"id": 36, "duration_s": 2.46, "emotion": "comic_panic", "text": "भुताचं पाणी? नको रे बाबा!"}, {"id": 37, "duration_s": 1.86, "emotion": "sarcastic", "text": "मग चहा कशाचा करू?"}, {"id": 38, "duration_s": 4.28, "emotion": "proud", "text": "एक बादली, दोन रुपये! रांगेत!"}, {"id": 39, "duration_s": 1.79, "emotion": "serious", "text": "कुत्र्याचेही दोन रुपये."}, {"id": 40, "duration_s": 1.85, "emotion": "proud", "text": "एक रुपयाही कमी नाही!"}, {"id": 41, "duration_s": 3.19, "emotion": "stern_warning", "text": "शेठ! घरच्यांकडूनही पैसे?"}, {"id": 42, "duration_s": 3.16, "emotion": "embarrassed", "text": "घरच्यांना... निम्मे दाम."}, {"id": 43, "duration_s": 2.56, "emotion": "comic_panic", "text": "पेढा! चाळीस बादल्या झाल्या!"}, {"id": 44, "duration_s": 1.34, "emotion": "happy", "text": "तहान लागली!"}, {"id": 45, "duration_s": 1.96, "emotion": "happy", "text": "चला, निघूया! पाणी आणायला!"}, {"id": 46, "duration_s": 1.17, "emotion": "sad", "text": "आजही नाही, राणी?"}, {"id": 47, "duration_s": 2.32, "emotion": "excited", "text": "ऐकलं का? भुतानं माझं नाव घेतलं!"}, {"id": 48, "duration_s": 2.06, "emotion": "proud", "text": "हुंह! माझं दोनदा घेतलं!"}, {"id": 49, "duration_s": 3.27, "emotion": "proud", "text": "सायन्स सांगतं... भुताला थंड पाणी आवडतं."}, {"id": 50, "duration_s": 0.62, "emotion": "stern_warning", "text": "गप्प!"}, {"id": 51, "duration_s": 1.55, "emotion": "curious", "text": "मी सांगू? नंतर."}, {"id": 52, "duration_s": 1.44, "emotion": "excited", "text": "बंधूंनो-भगिनींनो! भुताचं टेन्शन? घेऊ नका!"}, {"id": 53, "duration_s": 5.06, "emotion": "proud", "text": "सादर... तांत्रिक टिंगू बाबा!"}, {"id": 54, "duration_s": 6.29, "emotion": "serious", "text": "अलख निरंजन! भूत... खूप मोठो आसा."}, {"id": 55, "duration_s": 3.16, "emotion": "embarrassed", "text": "ही ही... हा बाबांचा... उलटा योग आहे!"}, {"id": 56, "duration_s": 1.83, "emotion": "curious", "text": "दाढी... उलटी!"}, {"id": 57, "duration_s": 2.471, "emotion": "serious", "text": "नोंद करा!"}, {"id": 58, "duration_s": 3.16, "emotion": "proud", "text": "भूतप्रूफ लिंबू! फकस्त पाचशे!"}, {"id": 59, "duration_s": 2.95, "emotion": "shocked", "text": "पाचशे? माझ्या दुकानात दोनाला आहे!"}, {"id": 60, "duration_s": 1.33, "emotion": "comic_panic", "text": "दोन द्या! लौकर!"}, {"id": 61, "duration_s": 2.32, "emotion": "excited", "text": "बाबा, मला लिंबू-मिरचीचा कॉम्बो!"}, {"id": 62, "duration_s": 2.24, "emotion": "proud", "text": "आठ लिंबू! पूर्ण आठ!"}, {"id": 63, "duration_s": 3.08, "emotion": "proud", "text": "आठ? हुंह! दहा द्या! अख्खी कॉलनी बघेल!"}, {"id": 64, "duration_s": 2.08, "emotion": "happy", "text": "दहा! आणि एक फुकट!"}, {"id": 65, "duration_s": 2.16, "emotion": "angry", "text": "हॅलो? महाराज, बार