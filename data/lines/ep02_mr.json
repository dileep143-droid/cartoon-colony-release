on": "embarrassed", "text": "आई... नेम... अजून... भारी आहे."}, {"id": 89, "duration_s": 1.92, "emotion": "excited", "text": "लाइव्ह सुरू आहे! पाच लाख!"}, {"id": 90, "duration_s": 1.67, "emotion": "comic_panic", "text": "चला, निघूया! सगळे रिक्षात!"}, {"id": 91, "duration_s": 1.79, "emotion": "determined", "text": "बास! आता मी बघते."}, {"id": 92, "duration_s": 3.58, "emotion": "calm", "text": "सुनबाई, जरा मोजा. मुलं कुठेयत?"}, {"id": 93, "duration_s": 2.57, "emotion": "determined", "text": "एक आयडिया सुचलीय! भुताला प्रश्न विचारू."}, {"id": 94, "duration_s": 3.7, "emotion": "curious", "text": "मी सांगू? भीती प्रश्नांपासून पळते."}, {"id": 95, "duration_s": 1.76, "emotion": "stern_warning", "text": "गप्प! आधी मी."}, {"id": 96, "duration_s": 3.28, "emotion": "proud", "text": "मी... खाऊचं रक्षण करीन."}, {"id": 97, "duration_s": 2.57, "emotion": "sarcastic", "text": "भूत सापडलं. खादाड भूत!"}, {"id": 98, "duration_s": 5.96, "emotion": "curious", "text": "बघा! वारा सुटला की आवाज येतो!"}, {"id": 99, "duration_s": 2.23, "emotion": "laughing", "text": "भूत... माझ्या बोटाला घाबरतं!"}, {"id": 100, "duration_s": 5.8, "emotion": "proud", "text": "वारा, पाइप, भेग. भूत नंबर एक सुटलं."}, {"id": 101, "duration_s": 3.18, "emotion": "curious", "text": "आवाज पाइपचा. आणि डोळे?"}, {"id": 102, "duration_s": 2.6, "emotion": "proud", "text": "टॉर्चचा प्रकाश, मांजराच्या डोळ्यांत चमकतो."}, {"id": 103, "duration_s": 1.55, "emotion": "happy", "text": "भूत नाही, मांजर!"}, {"id": 104, "duration_s": 3.01, "emotion": "stern_warning", "text": "आत कोणी जाणार नाही. पेढा, पुरचुंडी दे!"}, {"id": 105, "duration_s": 3.53, "emotion": "sad", "text": "माझे समोसे-बिस्किटं... अलविदा."}, {"id": 106, "duration_s": 1.86, "emotion": "happy", "text": "ये रे, छोट्या भुता!"}, {"id": 107, "duration_s": 2.32, "emotion": "tender", "text": "ही तर बिस्किटं खायला आत गेली होती."}, {"id": 108, "duration_s": 2.07, "emotion": "surprised", "text": "अरे! आत एक डबाही आहे!"}, {"id": 109, "duration_s": 3.27, "emotion": "embarrassed", "text": "भूक लागली! सगळ्यात थंड जागा!"}, {"id": 110, "duration_s": 2.72, "emotion": "stern_warning", "text": "गप्प! ...बरं, एक दे."}, {"id": 111, "duration_s": 3.88, "emotion": "shouting", "text": "थांबा! भूत खूप खतरनाक आसा!"}, {"id": 112, "duration_s": 1.02, "emotion": "proud", "text": "हे घ्या तुमचं भूत!"}, {"id": 113, "duration_s": 3.97, "emotion": "excited", "text": "दहा लाख! भूत नाही, मांजर व्हायरल!"}, {"id": 114, "duration_s": 3.31, "emotion": "proud", "text": "आणि हे भुताचं गाणं. फुटका पाइप."}, {"id": 115, "duration_s": 3.24, "emotion": "proud", "text": "सायन्स सांगतं... मला आधीपासून माहीत होतं."}, {"id": 116, "duration_s": 2.85, "emotion": "shocked", "text": "अरेच्चा! हा तर जत्रेतला फुगेवाला!"}, {"id": 117, "duration_s": 2.32, "emotion": "excited", "text": "ऐकलं का? बाबा बनावट!"}, {"id": 118, "duration_s": 2.22, "emotion": "comic_panic", "text": "ही ही... बाबांचो टाइम संपलो!"}, {"id": 119, "duration_s": 2.25, "emotion": "angry", "text": "माझ्या लिंबांचे हजार रुपये!"}, {"id": 120, "duration_s": 1.64, "emotion": "shouting", "text": "एक रुपयाही कमी नाही!"}, {"id": 121, "duration_s": 2.17, "emotion": "stern_warning", "text": "सोन्या! पैसे परत!"}, {"id": 122, "duration_s": 2.79, "emotion": "embarrassed", "text": "टेन्शन नको, वहिनी... सगळ्यांचे परत!"}, {"id": 123, "duration_s": 1.66, "emotion": "determined", "text": "आणि माझी दहा लिंबं?"}, {"id": 124, "duration_s": 1.88, "emotion": "embarrassed", "text": "चप्पल... कधी चुकत नाही."}, {"id": 125, "duration_s": 2.22, "emotion": "sad", "text": "हजार रुपयांची... एक चप्पल."}, {"id": 126, "duration_s": 5.2, "emotion": "mischievous", "text": "टाकी शांत होती... आता शेठ 'हूऊऊ' करत होते."}, {"id": 127, "duration_s": 2.0, "emotion": "happy", "text": "चला! भुताला सुट्टी!"}, {"id": 128, "duration_s": 2.81, "emotion": "proud", "text": "भूतप्रूफ लिंबू... आता तहानप्रूफ!"}, {"id": 129, "duration_s": 3.94, "emotion": "proud", "text": "माझा ग्लास मोठा. अख्खी कॉलनी बघेल!"}, {"id": 130, "duration_s": 3.712, "emotion": "embarrassed", "text": "दृष्ट नाही... तहान लागलीय."}, {"id": 131, "duration_s": 3.71, "emotion": "guilty", "text": "ऐकलंत का? ...आधी चौकशी करते."}, {"id": 132, "duration_s": 2.14, "emotion": "happy", "text": "भूक नाही... आज तहान!"}, {"id": 133, "duration_s": 3.7, "emotion": "guilty", "text": "आजोबा, सगळं माझ्या भुताच्या गोष्टीपासून सुरू झालं."}, {"id": 134, "duration_s": 4.93, "emotion": "serious", "text": "भीतीवर इलाज प्रश्न आहे... <short pause> बुवा नाही."}, {"id": 135, "duration_s": 4.2, "emotion": "calm", "text": "आधी विचारा, तपासा, मग माना."}, {"id": 136, "duration_s": 4.03, "emotion": "proud", "text": "आणि भीती विकणाऱ्यांना... पैसे नाही!"}, {"id": 137, "duration_s": 2.14, "emotion": "stern_warning", "text": "ऐकलं? आता गप्प!"}, {"id": 138, "duration_s": 2.91, "emotion": "proud", "text": "मी म्हटलं होतं ना? मी कोणाला घाबरत नाही!"}]