[{"id": 1, "duration_s": 3.33, "emotion": "mischievous", "text": "এই আমাদের পাড়া, আর পাড়ার সবচেয়ে বড় ট্যাংক।"}, {"id": 2, "duration_s": 5.051, "emotion": "mischievous", "text": "এই ট্যাংকে... থাকে এক ভূত! ভূউউ!"}, {"id": 3, "duration_s": 2.79, "emotion": "curious", "text": "ভূত বলে কিছু নেই। বলব?"}, {"id": 4, "duration_s": 1.82, "emotion": "stern_warning", "text": "চুপ!"}, {"id": 5, "duration_s": 1.87, "emotion": "mischievous", "text": "আমার গুপ্তধন... এখানে কেউ খুঁজবে না।"}, {"id": 6, "duration_s": 2.545, "emotion": "sarcastic", "text": "তোর ভূত... টর্চকে ভয় পায়।"}, {"id": 7, "duration_s": 2.51, "emotion": "mischievous", "text": "ভূত সত্যিকারের! আজ রাতে দেখিস!"}, {"id": 8, "duration_s": 2.07, "emotion": "calm", "text": "বাচ্চারা! খাবার তৈরি!"}, {"id": 9, "duration_s": 2.95, "emotion": "giggly", "text": "রসো আগেই পৌঁছে গেছে।"}, {"id": 10, "duration_s": 5.919, "emotion": "scared_whisper", "text": "আর তারপর... ঠিক রাত বারোটায়..."}, {"id": 11, "duration_s": 0.86, "emotion": "scared_whisper", "text": "ভ... ভ... ভূত!"}, {"id": 12, "duration_s": 2.25, "emotion": "panicked", "text": "নজর লেগেছে... ট্যাংকে!"}, {"id": 13, "duration_s": 2.63, "emotion": "scared_whisper", "text": "খোকার মা! ওঠ! ট্যাংকে ভূত!"}, {"id": 14, "duration_s": 3.75, "emotion": "comic_panic", "text": "লেবু! লঙ্কা! লেবু! লঙ্কা!"}, {"id": 15, "duration_s": 2.78, "emotion": "excited", "text": "হ্যাঁ দিদি? ভূত? ওমা! সত্যি?"}, {"id": 16, "duration_s": 1.8, "emotion": "excited", "text": "শুনেছ গো? ট্যাংকে ভূত!"}, {"id": 17, "duration_s": 3.06, "emotion": "mischievous", "text": "দশ সেকেন্ডে... গোটা পাড়া জেনে গেল।"}, {"id": 18, "duration_s": 2.02, "emotion": "excited", "text": "হ্যালো বন্ধুরা! লাইভ চলছে!"}, {"id": 19, "duration_s": 3.355, "emotion": "excited", "text": "ভূত লাইভ! দুই লাখ দর্শক!"}, {"id": 20, "duration_s": 2.219, "emotion": "scared_whisper", "text": "ভূতমশাই, এক সেলফি প্লিজ?"}, {"id": 21, "duration_s": 3.86, "emotion": "proud", "text": "বিজ্ঞান বলে... ভূত আসে ওয়াই-ফাই থেকে!"}, {"id": 22, "duration_s": 2.09, "emotion": "proud", "text": "ওয়াই-ফাই বন্ধ। ভূত খতম।"}, {"id": 23, "duration_s": 2.46, "emotion": "serious", "text": "সুর ভুল। দশে চার।"}, {"id": 24, "duration_s": 1.89, "emotion": "happy", "text": "হ্যাঁ! এবার সাত!"}, {"id": 25, "duration_s": 1.14, "emotion": "proud", "text": "ভূত-টুত কিচ্ছু নেই!"}, {"id": 26, "duration_s": 1.05, "emotion": "proud", "text": "কাউকে ভয় পাই না!"}, {"id": 27, "duration_s": 2.66, "emotion": "sarcastic", "text": "কাল টিকটিকি দেখে আলমারিতে কে উঠেছিল?"}, {"id": 28, "duration_s": 3.1, "emotion": "embarrassed", "text": "ওটা... আলমারির ধুলো দেখছিলাম।"}, {"id": 29, "duration_s": 2.76, "emotion": "proud", "text": "যা বাবা! পাড়াশুদ্ধু দেখুক!"}, {"id": 30, "duration_s": 3.26, "emotion": "scared_whisper", "text": "ও ভূতমশাই... আমি শুধু... হাওয়া খেতে এলাম।"}, {"id": 31, "duration_s": 2.08, "emotion": "sarcastic", "text": "এলে? হাওয়া খাওয়া হল?"}, {"id": 32, "duration_s": 2.91, "emotion": "scared_whisper", "text": "হ্যাঁ... খুব... ভালো হাওয়া।"}, {"id": 33, "duration_s": 2.8, "emotion": "guilty", "text": "আমি তো শুধু... মজা করেছিলাম।"}, {"id": 34, "duration_s": 2.44, "emotion": "mischievous", "text": "ভয় নেই! ভূত মানেই... ব্যবসা!"}, {"id": 35, "duration_s": 5.37, "emotion": "mischievous", "text": "পরদিন সকালে... পাড়া ভয়ে কাঁপছে। হিসেবি হারেন খুশি।"}, {"id": 36, "duration_s": 2.4, "emotion": "comic_panic", "text": "ভূতের জল? না বাবা না!"}, {"id": 37, "duration_s": 1.5, "emotion": "sarcastic", "text": "তাহলে চা বানাব কীসে?"}, {"id": 38, "duration_s": 3.81, "emotion": "proud", "text": "এক বালতি, দুই টাকা! লাইনে!"}, {"id": 39, "duration_s": 1.61, "emotion": "serious", "text": "কুকুরেরও দুই টাকা।"}, {"id": 40, "duration_s": 1.83, "emotion": "proud", "text": "এক পয়সাও কম নয়!"}, {"id": 41, "duration_s": 2.92, "emotion": "stern_warning", "text": "শেঠজি! ঘরের লোকেরও পয়সা?"}, {"id": 42, "duration_s": 3.18, "emotion": "embarrassed", "text": "বাড়ির লোকের... অর্ধেক দাম।"}, {"id": 43, "duration_s": 3.82, "emotion": "comic_panic", "text": "লাড্ডু! এ যে চল্লিশ বালতি হয়ে গেল!"}, {"id": 44, "duration_s": 1.46, "emotion": "happy", "text": "তেষ্টাও পেয়েছিল।"}, {"id": 45, "duration_s": 1.71, "emotion": "happy", "text": "চলো চলো! জল আনতে!"}, {"id": 46, "duration_s": 0.96, "emotion": "sad", "text": "আজও না, রানী?"}, {"id": 47, "duration_s": 3.18, "emotion": "excited", "text": "শুনেছ গো? ভূত রাতে আমার নাম ধরেছে!"}, {"id": 48, "duration_s": 2.51, "emotion": "proud", "text": "হুঁহ! আমার নাম দুবার!"}, {"id": 49, "duration_s": 3.69, "emotion": "proud", "text": "বিজ্ঞান বলে... ভূত ঠান্ডা জল ভালোবাসে।"}, {"id": 50, "duration_s": 0.62, "emotion": "stern_warning", "text": "চুপ!"}, {"id": 51, "duration_s": 0.5, "emotion": "curious", "text": "বলব? পরে।"}, {"id": 52, "duration_s": 3.51, "emotion": "excited", "text": "ভাইসব, বোনসব! ভূতের ভয়? ভয় নেই!"}, {"id": 53, "duration_s": 2.9, "emotion": "proud", "text": "পেশ করছি... তান্ত্রিক নিতাই বাবা!"}, {"id": 54, "duration_s": 9.56, "emotion": "serious", "text": "অলখ নিরঞ্জন! ভূত কিন্তু... মহা বড় আসে!"}, {"id": 55, "duration_s": 0.73, "emotion": "embarrassed", "text": "হে হে... এ হল বাবার... উল্টো যোগ!"}, {"id": 56, "duration_s": 1.94, "emotion": "curious", "text": "দাড়ি... উল্টো।"}, {"id": 57, "duration_s": 0.68, "emotion": "serious", "text": "লিখে রাখ!"}, {"id": 58, "duration_s": 3.46, "emotion": "proud", "text": "ভূত-প্রুফ নেবু! মাত্তর পাঁচশো!"}, {"id": 59, "duration_s": 3.05, "emotion": "shocked", "text": "পাঁচশো? আমার দোকানে দুই টাকা!"}, {"id": 60, "duration_s": 1.3, "emotion": "comic_panic", "text": "দুটো দাও! জলদি!"}, {"id": 61, "duration_s": 3.21, "emotion": "excited", "text": "বাবা, আমায় লেবু-লঙ্কার কম্বো!"}, {"id": 62, "duration_s": 2.27, "emotion": "proud", "text": "আটটা লেবু! পুরো আট!"}, {"id": 63, "duration_s": 4.36, "emotion": "proud", "text": "আট? হুঁহ! দশটা দাও! পাড়াশুদ্ধু দেখুক!"}, {"id": 64, "duration_s": 1.83, "emotion": "happy", "text": "দশ! আর একটা ফ্রি!"}, {"id": 65, "duration_s": 2.57, "emotion": "angry", "text": "হ্যালো? বাবা, বারোটা মিলবে?"}, {"id": 66, "duration_s": 1.54, "emotion": "proud", "text": "এবার কাউকে ভয় পাই না!"}, {"id": 67, "duration_s": 1.05, "emotion": "sarcastic", "text": "টিকটিকিকেও?"}, {"id": 68, "duration_s": 1.653, "emotion": "sarcastic", "text": "খুব কাজে এল লেবু।"}, {"id": 69, "duration_s": 2.62, "emotion": "sarcastic", "text": "পাঁচ হাজার টাকার লেবু, বাবা!"}, {"id": 70, "duration_s": 1.76, "emotion": "calm", "text": "শরবত ভালোই হবে।"}, {"id": 71, "duration_s": 4.18, "emotion": "mischievous", "text": "সন্ধেয় পাড়ায় মানুষ কম, লেবু বেশি।"}, {"id": 72, "duration_s": 3.1, "emotion": "mischievous", "text": "আজ রাতে একখানা জোরদার 'ভূউউ' চাই।"}, {"id": 73, "duration_s": 2.95, "emotion": "mischievous", "text": "হাওয়া চইলে... ডবল কামাই!"}, {"id": 74, "duration_s": 3.87, "emotion": "mischievous", "text": "রাতে... গোটা পাড়া দাদুর উঠোনে।"}, {"id": 75, "duration_s": 7.51, "emotion": "tired", "text": "তদন্ত... হবে... ঘ্যাঁ..."}, {"id": 76, "duration_s": 1.82, "emotion": "serious", "text": "বিজ্ঞান বলে, ভূত ঠিক বারোটায় আসে।"}, {"id": 77, "duration_s": 2.81, "emotion": "tired", "text": "এখন সাড়ে এগারোটা। ঘুমোও।"}, {"id": 78, "duration_s": 1.27, "emotion": "angry", "text": "শুনেছ গো? চুরি!"}, {"id": 79, "duration_s": 3.14, "emotion": "guilty", "text": "এ সবই... আমার গল্পের জন্য।"}, {"id": 80, "duration_s": 1.23, "emotion": "serious", "text": "চুপ! শোন।"}, {"id": 81, "duration_s": 2.91, "emotion": "shouting", "text": "কে ওটা? তদন্ত হবে!"}, {"id": 82, "duration_s": 1.68, "emotion": "excited", "text": "বাহ! দশে দশ!"}, {"id": 83, "duration_s": 1.58, "emotion": "comic_panic", "text": "ভূত! ভূত! ভূত!"}, {"id": 84, "duration_s": 0.57, "emotion": "panicked", "text": "ভূত!"}, {"id": 85, "duration_s": 2.11, "emotion": "comic_panic", "text": "আমি! হারু!"}, {"id": 86, "duration_s": 1.65, "emotion": "panicked", "text": "ভূত কথাও বলছে!"}, {"id": 87, "duration_s": 2.56, "emotion": "determined", "text": "ভূত? আমার চটি দেখ!"}, {"id": 88, "duration_s": 3.62, "emotion": "embarrassed", "text": "মা... তাক... এখনও... একদম পাকা।"}, {"id": 89, "duration_s": 1.8, "emotion": "excited", "text": "লাইভ চলছে! পাঁচ লাখ!"}, {"id": 90, "duration_s": 1.95, "emotion": "comic_panic", "text": "চলো চলো! সবাই অটোয়!"}, {"id": 91, "duration_s": 2.11, "emotion": "determined", "text": "ব্যস! এবার আমি দেখছি।"}, {"id": 92, "duration_s": 4.35, "emotion": "calm", "text": "বৌমা, একটু গুনে দেখো তো। বাচ্চারা কোথায়?"}, {"id": 93, "duration_s": 2.36, "emotion": "determined", "text": "একটা আইডিয়া আছে! ভূতকে প্রশ্ন করি।"}, {"id": 94, "duration_s": 2.91, "emotion": "curious", "text": "বলব? ভয় প্রশ্নকে ভয় পায়।"}, {"id": 95, "duration_s": 1.71, "emotion": "stern_warning", "text": "চুপ! আগে আমি।"}, {"id": 96, "duration_s": 3.16, "emotion": "proud", "text": "আমি... খাবার পাহারা দেব।"}, {"id": 97, "duration_s": 1.92, "emotion": "sarcastic", "text": "ভূত পেলাম। গোলুমোলু।"}, {"id": 98, "duration_s": 2.89, "emotion": "curious", "text": "দেখো! হাওয়া বইলেই আওয়াজ হয়!"}, {"id": 99, "duration_s": 3.24, "emotion": "laughing", "text": "ভূত... আমার আঙুলকে ভয় পায়!"}, {"id": 100, "duration_s": 4.34, "emotion": "proud", "text": "হাওয়া, পাইপ, ফাটল। ভূত নম্বর এক সমাধান।"}, {"id": 101, "duration_s": 2.68, "emotion": "curious", "text": "আওয়াজ তো পাইপ। আর চোখ?"}, {"id": 102, "duration_s": 2.27, "emotion": "proud", "text": "টর্চের আলো বেড়ালের চোখে জ্বলে।"}, {"id": 103, "duration_s": 2.01, "emotion": "happy", "text": "ভূত না, বেড়াল!"}, {"id": 104, "duration_s": 3.2, "emotion": "stern_warning", "text": "ভেতরে কেউ যাবে না। রসো, পুঁটলি দে!"}, {"id": 105, "duration_s": 3.13, "emotion": "sad", "text": "আমার সিঙাড়া-বিস্কুট... বিদায়।"}, {"id": 106, "duration_s": 1.796, "emotion": "happy", "text": "আয় রে, ছোট্ট ভূত!"}, {"id": 107, "duration_s": 1.94, "emotion": "tender", "text": "ও তো বিস্কুট খেতে ঢুকেছিল।"}, {"id": 108, "duration_s": 2.21, "emotion": "surprised", "text": "আরে! ভেতরে একটা কৌটোও আছে!"}, {"id": 109, "duration_s": 2.48, "emotion": "embarrassed", "text": "খিদে পেল! সবচে ঠান্ডা জায়গা ছিল!"}, {"id": 110, "duration_s": 3.2, "emotion": "stern_warning", "text": "চুপ! ...আচ্ছা, একটা দে।"}, {"id": 111, "duration_s": 3.64, "emotion": "shouting", "text": "খাড়াও! ভূত মহা ভয়ংকর!"}, {"id": 112, "duration_s": 1.21, "emotion": "proud", "text": "এই নিন আপনার ভূত!"}, {"id": 113, "duration_s": 3.62, "emotion": "excited", "text": "দশ লাখ! ভূত না, বেড়াল ভাইরাল!"}, {"id": 114, "duration_s": 3.06, "emotion": "proud", "text": "আর এই ভূতের গান। ফাটা পাইপ।"}, {"id": 115, "duration_s": 2.45, "emotion": "proud", "text": "বিজ্ঞান বলে... আমি আগেই জানতাম।"}, {"id": 116, "duration_s": 2.32, "emotion": "shocked", "text": "ওমা! এ তো মেলার বেলুনওয়ালা!"}, {"id": 117, "duration_s": 1.81, "emotion": "excited", "text": "শুনেছ গো? বাবা ভণ্ড!"}, {"id": 118, "duration_s": 2.37, "emotion": "comic_panic", "text": "হে হে... বাবার সময় খতম!"}, {"id": 119, "duration_s": 2.3, "emotion": "angry", "text": "আমার লেবুর হাজার টাকা!"}, {"id": 120, "duration_s": 1.6, "emotion": "shouting", "text": "এক পয়সাও কম নয়!"}, {"id": 121, "duration_s": 1.97, "emotion": "stern_warning", "text": "ভোম্বল! টাকা ফেরত!"}, {"id": 122, "duration_s": 1.89, "emotion": "embarrassed", "text": "ভয় নেই, বৌদি... সবার ফেরত!"}, {"id": 123, "duration_s": 1.82, "emotion": "determined", "text": "আর আমার দশ লেবু?"}, {"id": 124, "duration_s": 1.54, "emotion": "embarrassed", "text": "চটি... কখনও ফসকায় না।"}, {"id": 125, "duration_s": 2.65, "emotion": "sad", "text": "হাজার টাকার... একখানা চটি।"}, {"id": 126, "duration_s": 8.44, "emotion": "mischievous", "text": "ট্যাংক চুপ। এবার হিসেবি হারেন 'ভূউউ' করছেন।"}, {"id": 127, "duration_s": 1.37, "emotion": "happy", "text": "চলো! ভূতের ছুটি!"}, {"id": 128, "duration_s": 3.3, "emotion": "proud", "text": "ভূত-প্রুফ লেবু... এবার তেষ্টা-প্রুফ!"}, {"id": 129, "duration_s": 3.97, "emotion": "proud", "text": "আমার গ্লাস বড়। পাড়াশুদ্ধু দেখুক!"}, {"id": 130, "duration_s": 3.23, "emotion": "embarrassed", "text": "নজর না... তেষ্টা পেয়েছে।"}, {"id": 131, "duration_s": 3.21, "emotion": "guilty", "text": "শুনেছ গো? ...আগে তদন্ত করে নিই।"}, {"id": 132, "duration_s": 2.41, "emotion": "happy", "text": "খিদে না... আজ তেষ্টা পেয়েছিল!"}, {"id": 133, "duration_s": 3.15, "emotion": "guilty", "text": "দাদু, সব আমার ভূতের গল্প থেকে শুরু।"}, {"id": 134, "duration_s": 4.49, "emotion": "serious", "text": "ভয়ের ওষুধ প্রশ্ন... বাবা নন।"}, {"id": 135, "duration_s": 4.6, "emotion": "calm", "text": "আগে জিজ্ঞেস করো, পরে যাচাই, তবে মানো।"}, {"id": 136, "duration_s": 3.32, "emotion": "proud", "text": "আর ভয় বেচা লোককে... পয়সা নয়!"}, {"id": 137, "duration_s": 1.55, "emotion": "stern_warning", "text": "শুনলে? এবার চুপ!"}, {"id": 138, "duration_s": 2.34, "emotion": "proud", "text": "বলেছিলাম না? কাউকে ভয় পাই না!"}]