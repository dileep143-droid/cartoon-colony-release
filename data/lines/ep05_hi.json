[{"id": 1, "duration_s": 3.45, "emotion": "excited", "text": "कॉलोनी का सबसे बड़ा मुकाबला... रस्साकशी!"}, {"id": 2, "duration_s": 3.98, "emotion": "proud", "text": "सात दिन का पाउडर! मैं किसी से नहीं डरता!"}, {"id": 3, "duration_s": 2.2, "emotion": "calm", "text": "सेठ जी, चाय गरम रखना।"}, {"id": 4, "duration_s": 1.87, "emotion": "excited", "text": "लाइव चल रहा है! स्लो मोशन में!"}, {"id": 5, "duration_s": 4.37, "emotion": "mischievous", "text": "ये सब शुरू हुआ... एक डिब्बे से।"}, {"id": 6, "duration_s": 4.3, "emotion": "happy", "text": "सात दिन पहले। कॉलोनी का स्पोर्ट्स वीक।"}, {"id": 7, "duration_s": 4.88, "emotion": "excited", "text": "इस रविवार रस्साकशी! शर्मा परिवार बनाम सेठ परिवार!"}, {"id": 8, "duration_s": 3.22, "emotion": "proud", "text": "शर्मा जीतेंगे! मैं किसी से नहीं डरता!"}, {"id": 9, "duration_s": 5.39, "emotion": "sarcastic", "text": "हिसाब लगाया। शर्मा जीतने का चांस... शून्य।"}, {"id": 10, "duration_s": 1.82, "emotion": "sarcastic", "text": "किसी से नहीं डरते, रमेश जी?"}, {"id": 11, "duration_s": 3.22, "emotion": "comic_panic", "text": "किसी से नहीं! छिपकली... कोई नहीं होती!"}, {"id": 12, "duration_s": 2.35, "emotion": "stern_warning", "text": "चुप! अंकल फिर से कूद जाएँगे।"}, {"id": 13, "duration_s": 1.97, "emotion": "happy", "text": "चलो, चलते हैं!"}, {"id": 14, "duration_s": 1.6, "emotion": "calm", "text": "हटो भैया, मैं देखती हूँ।"}, {"id": 15, "duration_s": 2.49, "emotion": "shocked", "text": "भाभी जी, आप तो ट्रैक्टर भी खींच लोगी!"}, {"id": 16, "duration_s": 2.05, "emotion": "excited", "text": "टेंशन मत लो, भैया!"}, {"id": 17, "duration_s": 3.15, "emotion": "worried", "text": "टेंशन? उसने ऑटो खींच लिया, टिंकू!"}, {"id": 18, "duration_s": 3.89, "emotion": "proud", "text": "मेरा बेटा जीतेगा! पूरी कॉलोनी देखेगी!"}, {"id": 19, "duration_s": 5.13, "emotion": "mischievous", "text": "सुना क्या? रमेश जी छिपकली से हार गए!"}, {"id": 20, "duration_s": 4.08, "emotion": "sad", "text": "चिप्स कहाँ गए? भूख लगी है!"}, {"id": 21, "duration_s": 3.8, "emotion": "excited", "text": "सुल्तान पावर पाउडर! सात दिन में बॉडी!"}, {"id": 22, "duration_s": 1.77, "emotion": "excited", "text": "सिर्फ़ नौ सौ निन्यानवे! एक्सप्रेस डिलीवरी!"}, {"id": 23, "duration_s": 3.41, "emotion": "excited", "text": "एक आइडिया है! पापा के लिए!"}, {"id": 24, "duration_s": 3.9, "emotion": "excited", "text": "पापा! सात दिन में बॉडी! रविवार भी सात दिन में!"}, {"id": 25, "duration_s": 2.94, "emotion": "excited", "text": "सुल्तान... बॉडी... सात दिन!"}, {"id": 26, "duration_s": 2.26, "emotion": "sarcastic", "text": "सात दिन में तो अचार भी नहीं बनता!"}, {"id": 27, "duration_s": 2.54, "emotion": "proud", "text": "ये साइंस है, पूजा! ऑर्डर!"}, {"id": 28, "duration_s": 3.91, "emotion": "proud", "text": "मेरा बेटा सुल्तान बनेगा! पूरी कॉलोनी देखेगी!"}, {"id": 29, "duration_s": 3.19, "emotion": "curious", "text": "पाउडर मीठा होगा? मुझे भी चाहिए।"}, {"id": 30, "duration_s": 2.51, "emotion": "excited", "text": "सुल्तान पावर पाउडर! एक्सप्रेस डिलीवरी!"}, {"id": 31, "duration_s": 1.49, "emotion": "loving", "text": "आ गया मेरा सुल्तान!"}, {"id": 32, "duration_s": 2.95, "emotion": "mischievous", "text": "सुना क्या? रमेश जी ने डिब्बे में बॉडी मंगाई!"}, {"id": 33, "duration_s": 2.17, "emotion": "determined", "text": "आह! ताकत आ रही है!"}, {"id": 34, "duration_s": 1.79, "emotion": "curious", "text": "पापा... मसल कहाँ छुपा है?"}, {"id": 35, "duration_s": 2.4, "emotion": "excited", "text": "आ गया! एक बाल खड़ा हुआ!"}, {"id": 36, "duration_s": 2.93, "emotion": "shocked", "text": "सुना क्या? शर्मा जी के बटन बरस रहे हैं!"}, {"id": 37, "duration_s": 2.19, "emotion": "embarrassed", "text": "बॉडी बढ़ रही है, आंटी!"}, {"id": 38, "duration_s": 2.04, "emotion": "shocked", "text": "आधा इंच..."}, {"id": 39, "duration_s": 0.55, "emotion": "shocked", "text": "...घट गया!"}, {"id": 40, "duration_s": 1.8, "emotion": "proud", "text": "अंदर से बढ़ रहा है!"}, {"id": 41, "duration_s": 1.9, "emotion": "happy", "text": "सूँघने से भी ताकत आती है!"}, {"id": 42, "duration_s": 2.15, "emotion": "worried", "text": "रमेश, नाक में मत डालो!"}, {"id": 43, "duration_s": 3.31, "emotion": "comic_panic", "text": "आ... आ... आ..."}, {"id": 44, "duration_s": 2.81, "emotion": "proud", "text": "देखा? पाउडर बाहर से भी काम करता है!"}, {"id": 45, "duration_s": 1.67, "emotion": "determined", "text": "बस! अब मैं देखती हूँ।"}, {"id": 46, "duration_s": 3.41, "emotion": "shocked", "text": "हाय! मेरा सुल्तान बर्फ़ का पुतला बन गया!"}, {"id": 47, "duration_s": 2.21, "emotion": "serious", "text": "रुको! साइंस कहता है..."}, {"id": 48, "duration_s": 4.12, "emotion": "proud", "text": "ये सौ प्रतिशत चॉक है!"}, {"id": 49, "duration_s": 3.17, "emotion": "laughing", "text": "<laugh> लखन की साइंस? फिर तो पक्का गलत!"}, {"id": 50, "duration_s": 4.34, "emotion": "giggly", "text": "लखन ने कहा था, बादल सिलेंडर से बनते हैं!"}, {"id": 51, "duration_s": 3.27, "emotion": "giggly", "text": "और ये कि मुर्गी दूध देती है!"}, {"id": 52, "duration_s": 3.47, "emotion": "laughing", "text": "और चाँद पर चाय की दुकान है!"}, {"id": 53, "duration_s": 1.61, "emotion": "pleading", "text": "पर इस बार सच में!"}, {"id": 54, "duration_s": 2.11, "emotion": "serious", "text": "नज़र न लगे मेरे सुल्तान को!"}, {"id": 55, "duration_s": 2.19, "emotion": "proud", "text": "सुल्तान रविवार को दिखेगा!"}, {"id": 56, "duration_s": 3.71, "emotion": "sad", "text": "देखो... लिखता भी है। कोई नहीं देखता।"}, {"id": 57, "duration_s": 2.86, "emotion": "excited", "text": "टेंशन मत लो! ये तो सोने की खान है!"}, {"id": 58, "duration_s": 1.97, "emotion": "mischievous", "text": "सौ का लो, दो सौ में बेचो!"}, {"id": 59, "duration_s": 2.94, "emotion": "mischievous", "text": "सेठ जी, डीलरशिप! पचास डिब्बे!"}, {"id": 60, "duration_s": 4.97, "emotion": "curious", "text": "पचास सुल्तान? हिसाब लगाता हूँ।"}, {"id": 61, "duration_s": 4.37, "emotion": "serious", "text": "पाँच हज़ार। दो बार गिने... तीसरी बार भी।"}, {"id": 62, "duration_s": 1.35, "emotion": "pleading", "text": "एक रुपया भी कम नहीं!"}, {"id": 63, "duration_s": 1.1, "emotion": "stern_warning", "text": "सेठ