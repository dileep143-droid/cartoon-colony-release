[{"id": 1, "duration_s": 3.07, "emotion": "excited", "text": "മഴക്കാലം... കോളനി മുഴുവൻ ബോറടി!"}, {"id": 2, "duration_s": 2.38, "emotion": "excited", "text": "മഴ സെൽഫി! ഇനി ലൈക്ക് പെരുമഴ!"}, {"id": 3, "duration_s": 2.34, "emotion": "sad", "text": "സീറോ ലൈക്ക്? അമ്മയും ഇട്ടില്ലേ!"}, {"id": 4, "duration_s": 2.68, "emotion": "proud", "text": "ഫുഡ് ഫോട്ടോ! സമൂസ എപ്പോഴും വൈറൽ!"}, {"id": 5, "duration_s": 2.39, "emotion": "embarrassed", "text": "വിശന്നു പോയി!"}, {"id": 6, "duration_s": 2.54, "emotion": "excited", "text": "ക്യാപ്റ്റൻ മുതലയുടെ വള്ളം! സൂപ്പർ ഫാസ്റ്റ്!"}, {"id": 7, "duration_s": 2.66, "emotion": "shocked", "text": "അയ്യോ! എന്റെ ക്യാപ്റ്റൻ മുതല!"}, {"id": 8, "duration_s": 2.59, "emotion": "stern_warning", "text": "ശ്ശ്! ഓടേടെ അടുത്ത് വേണ്ട!"}, {"id": 9, "duration_s": 1.81, "emotion": "mischievous", "text": "ടെൻഷൻ വേണ്ട! ഐഡിയ ഉണ്ട്!"}, {"id": 10, "duration_s": 2.22, "emotion": "mischievous", "text": "കുറച്ച് വലുത്... ഇനിയും... ദാ!"}, {"id": 11, "duration_s": 3.06, "emotion": "excited", "text": "പത്ത് മിനിറ്റ്, പതിനായിരം ലൈക്ക്! ഞാൻ സ്റ്റാറാ!"}, {"id": 12, "duration_s": 1.46, "emotion": "proud", "text": "ശരിക്കുള്ള മുതല ആർക്ക് വേണം?"}, {"id": 13, "duration_s": 2.07, "emotion": "scared_whisper", "text": "കേട്ടോ? ഓടയിൽ മുതല!"}, {"id": 14, "duration_s": 2.84, "emotion": "proud", "text": "നാല്പത് ഗ്രൂപ്പ്! ഒറ്റശ്വാസത്തിൽ! റെക്കോർഡ്!"}, {"id": 15, "duration_s": 3.91, "emotion": "serious", "text": "പത്ത് സെക്കൻഡ്... കോളനി മുഴുവൻ അറിഞ്ഞു."}, {"id": 16, "duration_s": 1.33, "emotion": "excited", "text": "ആഹാ, അതെ! രണ്ടാളോടും പറയാം!"}, {"id": 17, "duration_s": 1.08, "emotion": "panicked", "text": "മാഷേ, മുതല!"}, {"id": 18, "duration_s": 2.64, "emotion": "calm", "text": "മുതലോ? പലിശയുണ്ടോ?"}, {"id": 19, "duration_s": 3.41, "emotion": "shocked", "text": "മുതലയോ?! എന്റെ മുണ്ട്! അയ്യോ!"}, {"id": 20, "duration_s": 3.57, "emotion": "serious", "text": "കണ്ണ് തട്ടി! മുതലയ്ക്കും നാരങ്ങ-മുളക്!"}, {"id": 21, "duration_s": 4.63, "emotion": "proud", "text": "സയൻസ് പറയുന്നു, മഴക്കാലത്ത് മുതല ചെരിപ്പേ തിന്നൂ!"}, {"id": 22, "duration_s": 3.45, "emotion": "panicked", "text": "വാതിലടച്ചു! ജനലടച്ചു! കുളിമുറിയിലെ ഓടയും!"}, {"id": 23, "duration_s": 1.98, "emotion": "excited", "text": "ഒരു ഐഡിയ ഉണ്ട്! മുതലയെ കാണാം!"}, {"id": 24, "duration_s": 2.23, "emotion": "stern_warning", "text": "ഐഡിയ പോക്കറ്റിലിട്. ഹോംവർക്ക് എടുക്ക്."}, {"id": 25, "duration_s": 2.74, "emotion": "proud", "text": "പേടിക്കണ്ട! എനിക്കാരെയും പേടിയില്ല!"}, {"id": 26, "duration_s": 3.47, "emotion": "determined", "text": "മുതല വന്നാൽ... സിക്സർ! നേരെ പവലിയൻ!"}, {"id": 27, "duration_s": 1.63, "emotion": "comic_panic", "text": "മു...മു...മുതലക്കുഞ്ഞ്!"}, {"id": 28, "duration_s": 1.46, "emotion": "determined", "text": "മതി! ഇനി ഞാൻ നോക്കാം."}, {"id": 29, "duration_s": 2.51, "emotion": "scared_whisper", "text": "ശോഭേ... പോയോ? ശരിക്കും പോയോ?"}, {"id": 30, "duration_s": 4.295, "emotion": "proud", "text": "എന്റെ മോൻ സിംഹമാ! നാട് മുഴുവൻ കാണട്ടെ!"}, {"id": 31, "duration_s": 2.34, "emotion": "determined", "text": "ഇന്ന് രാത്രി... ഞാൻ ഗേറ്റിൽ കാവൽ!"}, {"id": 32, "duration_s": 2.97, "emotion": "guilty", "text": "അത്... സത്യത്തിൽ... ആ ഫോട്ടോ..."}, {"id": 33, "duration_s": 3.4, "emotion": "angry", "text": "മിണ്ടരുത്! അശുഭം പറയല്ലേ!"}, {"id": 34, "duration_s": 1.59, "emotion": "giggly", "text": "അച്ഛാ... ഒരു തവളയോ?"}, {"id": 35, "duration_s": 3.35, "emotion": "scared_whisper", "text": "പാതിരാത്രി... കൊച്ചുപറമ്പിൽ ഗേറ്റ്... കാവൽ."}, {"id": 36, "duration_s": 3.61, "emotion": "tired", "text": "എനിക്കാരെയും പേടിയില്ല... ഉറക്കത്തെ ഒഴിച്ച്."}, {"id": 37, "duration_s": 2.02, "emotion": "comic_panic", "text": "ആ...ആരാത്? മുന്നിൽ വാ!"}, {"id": 38, "duration_s": 4.34, "emotion": "relieved", "text": "<sigh> പൂച്ചമ്മായി! പേടിച്ചു!"}, {"id": 39, "duration_s": 1.63, "emotion": "comic_panic", "text": "മു...മു...മുതല!"}, {"id": 40, "duration_s": 3.59, "emotion": "curious", "text": "സുരേഷേ, പാതിരാത്രി ഗേറ്റിൽ തൂങ്ങുന്നതെന്താ?"}, {"id": 41, "duration_s": 4.03, "emotion": "embarrassed", "text": "യോഗയാ മാഷേ! ഇതിനെ പറയും... ഗേറ്റാസനം!"}, {"id": 42, "duration_s": 1.99, "emotion": "excited", "text": "കേട്ടോ? സുരേഷ് ഗേറ്റിൽ തൂങ്ങി!"}, {"id": 43, "duration_s": 3.58, "emotion": "excited", "text": "മുതല-പ്രൂഫ് ഗംബൂട്ട്! കടിച്ചാൽ പല്ല് പോകും!"}, {"id": 44, "duration_s": 2.07, "emotion": "proud", "text": "ഇന്നലെ നൂറ്. ഇന്ന് മുന്നൂറ്!"}, {"id": 45, "duration_s": 2.57, "emotion": "sarcastic", "text": "കുട്ടപ്പൻ ചേട്ടാ, മുതലയേക്കാൾ കടി നിങ്ങടെ വിലയ്ക്കാ!"}, {"id": 46, "duration_s": 2.21, "emotion": "proud", "text": "ഒരു രൂപ കുറയില്ല!"}, {"id": 47, "duration_s": 2.94, "emotion": "proud", "text": "ഇവളൊന്നെടുത്തോ? എനിക്ക് രണ്ട്!"}, {"id": 48, "duration_s": 1.13, "emotion": "angry", "text": "എനിക്ക് മൂന്ന്!"}, {"id": 49, "duration_s": 3.87, "emotion": "proud", "text": "എനിക്ക് നാല്! നാട്ടുകാർ കാണട്ടെ!"}, {"id": 50, "duration_s": 3.04, "emotion": "happy", "text": "വാ പോകാം! വെറും കാലാ ലാഭം!"}, {"id": 51, "duration_s": 2.32, "emotion": "calm", "text": "കുട്ടപ്പാ! ഇനി കൊണ്ടുവരാം?"}, {"id": 52, "duration_s": 8.95, "emotion": "happy", "text": "ഒന്ന്, രണ്ട്, മൂന്ന്... വീണ്ടും... ഒന്ന്, രണ്ട്..."}, {"id": 53, "duration_s": 2.68, "emotion": "excited", "text": "ബൂട്ടിനുള്ളിൽ ബിസ്കറ്റ്! എന്തൊരു ഓഫർ!"}, {"id": 54, "duration_s": 2.54, "emotion": "angry", "text": "ബിസ്കറ്റിന് വേറെ! ഇരുപത് രൂപ!"}, {"id": 55, "duration_s": 2.48, "emotion": "guilty", "text": "എല്ലാരും കേൾക്ക്... ആ മുതല ശരിക്കും..."}, {"id": 56, "duration_s": 1.6, "emotion": "shouting", "text": "അടുത്തത്! വരിയിൽ വാ!"}, {"id": 57, "duration_s": 2.96, "emotion": "serious", "text": "ഉച്ചയ്ക്ക് രണ്ട് മണി... മുതല വേട്ട, ലൈവ്!"}, {"id": 58, "duration_s": 2.53, "emotion": "excited", "text": "ഹായ് ഫ്രണ്ട്സ്! ലൈവ് ആണ്! ക്രോക്ക് ഹണ്ട്!"}, {"id": 59, "duration_s": 2.9, "emotion": "proud", "text": "സയൻസ് പറയുന്നു, മുതല ചൂളമടിച്ചാൽ വരും."}, {"id": 60, "duration_s": 3.89, "emotion": "pleading", "text": "ചേട്ടൻ മുന്നിൽ നിന്നോ. ചേട്ടൻ... വലിയ ആളല്ലേ!"}, {"id": 61, "duration_s": 2.34, "emotion": "angry", "text": "ഞാനോ? എന്റെ ബൂട്ടിന് മുന്നൂറാ!"}, {"id": 62, "duration_s": 3.78, "emotion": "pleading", "text": "എല്ലാരും കേൾക്ക്! ആ മുതല ശരിക്കുള്ളതല്ല..."}, {"id": 63, "duration_s": 1.175, "emotion": "shocked", "text": "അ...അത്... അനങ്ങുന്നു!"}, {"id": 64, "duration_s": 0.88, "emotion": "panicked", "text": "മുതല!!!"}, {"id": 65, "duration_s": 0.68, "emotion": "sad", "text": "...അല്ല."}, {"id": 66, "duration_s": 1.15, "emotion": "surprised", "text": "അയ്യോ! അത് എന്റെ ചെരിപ്പാ!"}, {"id": 67, "duration_s": 2.97, "emotion": "proud", "text": "കണ്ടോ? സയൻസ്! മുതല തുപ്പി!"}, {"id": 68, "duration_s": 2.06, "emotion": "pleading", "text": "കല്യാണീ! വലിക്ക്!"}, {"id": 69, "duration_s": 2.34, "emotion": "excited", "text": "കേട്ടോ? മുതല ചെരിപ്പ് തുപ്പി!"}, {"id": 70, "duration_s": 2.8, "emotion": "excited", "text": "വ്യൂസ് ഡബിൾ! ചെരിപ്പും വൈറൽ!"}, {"id": 71, "duration_s": 2.48, "emotion": "guilty", "text": "<sigh> എന്റെ ഫോട്ടോ... ചെരിപ്പിനേക്കാൾ വലുതായി."}, {"id": 72, "duration_s": 1.63, "emotion": "shouting", "text": "ഉറക്കം പിള്ളേ! മുതല!"}, {"id": 73, "duration_s": 3.82, "emotion": "sarcastic", "text": "പഴംപൊരി, സാറേ."}, {"id": 74, "duration_s": 1.94, "emotion": "surprised", "text": "എവിടെ? അന്വേഷണം!"}, {"id": 75, "duration_s": 8.83, "emotion": "determined", "text": "മുതലയോ അപ്പനോ... അന്വേഷണം ഉണ്ടാകും!"}, {"id": 76, "duration_s": 2.8, "emotion": "scared_whisper", "text": "ശ്ശ്... നിയമം വരുന്നു."}, {"id": 77, "duration_s": 3.2, "emotion": "comic_panic", "text": "മു...മുതല... ചെറുത്... പച്ച..."}, {"id": 78, "duration_s": 1.14, "emotion": "worried", "text": "അയ്യോ!"}, {"id": 79, "duration_s": 4.04, "emotion": "sarcastic", "text": "വെള്ളം, വട?"}, {"id": 80, "duration_s": 4.09, "emotion": "tired", "text": "അന്വേഷണം... തുടരും..."}, {"id": 81, "duration_s": 1.69, "emotion": "sad", "text": "എന്റെ മുതലയും പോയേ..."}, {"id": 82, "duration_s": 2.85, "emotion": "excited", "text": "ഒരു ഐഡിയ ഉണ്ട്! പേടിക്കണ്ട, അന്വേഷിക്കാം!"}, {"id": 83, "duration_s": 2.23, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? വനംവകുപ്പിനെ വിളിക്ക്!"}, {"id": 84, "duration_s": 0.69, "emotion": "stern_warning", "text": "മിണ്ടല്ലേ!"}, {"id": 85, "duration_s": 4.7, "emotion": "serious", "text": "ഹലോ, വനംവകുപ്പോ? ഓടയിൽ മുതല... ആണെന്ന് തോന്നുന്നു."}, {"id": 86, "duration_s": 2.075, "emotion": "determined", "text": "ഞാൻ സ്നാക്സ് നോക്കാം."}, {"id": 87, "duration_s": 2.76, "emotion": "excited", "text": "ബ്രേക്കിങ് ന്യൂസ്! കോളനീലെ ഓടേല് മുതല!"}, {"id": 88, "duration_s": 3.66, "emotion": "proud", "text": "നമ്മുടെ ഓട ടിവിയിൽ! നാട് മുഴുവൻ കാണും!"}, {"id": 89, "duration_s": 1.86, "emotion": "comic_panic", "text": "ടെൻഷനില്ല... ടെൻഷനില്ല... ടെൻഷൻ!"}, {"id": 90, "duration_s": 3.47, "emotion": "sarcastic", "text": "കോളനി മുഴുവൻ ടെറസ്സിൽ. റോഡിൽ എരുമ മാത്രം."}, {"id": 91, "duration_s": 1.47, "emotion": "happy", "text": "ദാ, വർഗീസ് സാറെത്തി!"}, {"id": 92, "duration_s": 2.82, "emotion": "tired", "text": "എല്ലാ തവണയും! അത്യാവശ്യ നേരത്ത്!"}, {"id": 93, "duration_s": 3.41, "emotion": "happy", "text": "മിടുക്കൻ! നീയാണ് ശരിക്കും മെക്കാനിക്!"}, {"id": 94, "duration_s": 1.946, "emotion": "serious", "text": "മുതല എബ്ടെ? കാണിച്ചു തരീ."}, {"id": 95, "duration_s": 0.78, "emotion": "panicked", "text": "അവിടെ!!!"}, {"id": 96, "duration_s": 2.747, "emotion": "scared_whisper", "text": "കോളനി മുഴുവൻ ശ്വാസം പിടിച്ചു..."}, {"id": 97, "duration_s": 2.74, "emotion": "scared_whisper", "text": "എനിക്കാരെയും പേടിയില്ല... എനിക്ക്..."}, {"id": 98, "duration_s": 3.03, "emotion": "sarcastic", "text": "ബല്ലാത്ത മുതല! റബ്ബറാ ഇത്."}, {"id": 99, "duration_s": 3.08, "emotion": "shocked", "text": "ഇത്രേം ചെറുതോ? എന്റെ ഗംബൂട്ടിന്റെ ഗതി?"}, {"id": 100, "duration_s": 3.13, "emotion": "loving", "text": "എന്റെ ക്യാപ്റ്റൻ മുതല! കിട്ടി!"}, {"id": 101, "duration_s": 2.14, "emotion": "curious", "text": "ഫോട്ടോയിൽ വലുതായിരുന്നല്ലോ!"}, {"id": 102, "duration_s": 2.91, "emotion": "proud", "text": "ഞാൻ പറയട്ടെ? ഈ ഫോട്ടോയിൽ മൂന്ന് കള്ളത്തരം!"}, {"id": 103, "duration_s": 1.81, "emotion": "excited", "text": "ഫാക്ട് ചെക്ക്, ലൈവ് ആണ്!"}, {"id": 104, "duration_s": 3.1, "emotion": "serious", "text": "ഒന്ന്: പൂച്ചയുടെ നിഴലാ... മുതലയുടേതല്ല!"}, {"id": 105, "duration_s": 4.7, "emotion": "serious", "text": "രണ്ട്: മുതല ഓടയേക്കാൾ വലുത്! കേറുന്നതെങ്ങനെ?"}, {"id": 106, "duration_s": 3.95, "emotion": "proud", "text": "സയൻസ് പറയുന്നു, മുതല ശ്വാസം പിടിച്ച് മെലിയും!"}, {"id": 107, "duration_s": 0.56, "emotion": "stern_warning", "text": "ശ്ശ്!"}, {"id": 108, "duration_s": 3.07, "emotion": "excited", "text": "മൂന്ന്: വാലിൽ ഉണ്ണിയുടെ പല്ലിന്റെ പാട്!"}, {"id": 109, "duration_s": 3.26, "emotion": "embarrassed", "text": "അത്... വിശന്നു പോയി."}, {"id": 110, "duration_s": 4.77, "emotion": "sarcastic", "text": "മുതലക്കണ്ണീര് കേട്ടിട്ടുണ്ട്... മുതലയുടെ ഫോട്ടോ ആദ്യമായാ!"}, {"id": 111, "duration_s": 1.8, "emotion": "serious", "text": "ഈ ഫോട്ടോ എടുത്തതാരാ?"}, {"id": 112, "duration_s": 4.74, "emotion": "guilty", "text": "ഞാനാ... ഞാൻ ഉണ്ടാക്കിയതാ. ലൈക്കിന് വേണ്ടി മാത്രം."}, {"id": 113, "duration_s": 0.93, "emotion": "angry", "text": "ലൈക്കോ?!"}, {"id": 114, "duration_s": 2.52, "emotion": "embarrassed", "text": "അമ്മിണി അമ്മച്ചിയുടെ ഏറ്... പിഴയ്ക്കില്ല."}, {"id": 115, "duration_s": 3.49, "emotion": "guilty", "text": "ഞാനോ... നോക്കാതെ നാല്പത് ഗ്രൂപ്പിൽ അയച്ചു."}, {"id": 116, "duration_s": 3.49, "emotion": "sad", "text": "എന്റെ മുന്നൂറിന്റെ ബൂട്ട്... ഇനി ആര് വാങ്ങും?"}, {"id": 117, "duration_s": 2.293, "emotion": "stern_warning", "text": "കുട്ടപ്പാ!"}, {"id": 118, "duration_s": 2.82, "emotion": "embarrassed", "text": "ശരി ശരി... നൂറു രൂപ. പഴയ വില."}, {"id": 119, "duration_s": 6.43, "emotion": "tired", "text": "ഞാൻ രാത്രി മുഴുവൻ ഗേറ്റാസനം ചെയ്തു!"}, {"id": 120, "duration_s": 3.62, "emotion": "determined", "text": "മതി! ഇനി ഞാൻ നോക്കാം. ഓട പ്രശസ്തമാക്കിയവൻ..."}, {"id": 121, "duration_s": 1.49, "emotion": "stern_warning", "text": "...തന്നെ ഓട വൃത്തിയാക്കും!"}, {"id": 122, "duration_s": 2.74, "emotion": "tired", "text": "ടെൻഷൻ വേണ്ട... ടെൻഷൻ ഒരുപാടുണ്ട്."}, {"id": 123, "duration_s": 3.4, "emotion": "excited", "text": "ലൈവ് ആണ്! ഓട വൃത്തിയാക്കൽ, എപ്പിസോഡ് വൺ!"}, {"id": 124, "duration_s": 3.11, "emotion": "serious", "text": "തിരുത്ത് നാല്പത് ഗ്രൂപ്പിൽ പോകും... പക്ഷേ ആദ്യം ചെക്ക്!"}, {"id": 125, "duration_s": 1.57, "emotion": "curious", "text": "ഇതിൽ ബിസ്കറ്റ് ഉണ്ടോ?"}, {"id": 126, "duration_s": 3.02, "emotion": "excited", "text": "എന്റെ ചെരിപ്പ്! കണ്ടോ? സയൻസ്!"}, {"id": 127, "duration_s": 5.52, "emotion": "serious", "text": "അന്വേഷണം... തീർന്നു. കേസ് ക്ലോസ്."}, {"id": 128, "duration_s": 4.02, "emotion": "calm", "text": "വൈകുന്നേരമായി, മഴ നിന്നു... ഓട തിളങ്ങി."}, {"id": 129, "duration_s": 4.52, "emotion": "calm", "text": "ഒരു വ്യാജ ഫോട്ടോ... കോളനി മുഴുവൻ ടെറസ്സിൽ."}, {"id": 130, "duration_s": 2.13, "emotion": "guilty", "text": "അപ്പൂപ്പാ, തമാശയാ..."}, {"id": 131, "duration_s": 4.43, "emotion": "serious", "text": "തമാശ നിന്റേത്. പേടി നാട് മുഴുവനും."}, {"id": 132, "duration_s": 1.81, "emotion": "curious", "text": "അപ്പോ സത്യം എങ്ങനെ അറിയും, അപ്പൂപ്പാ?"}, {"id": 133, "duration_s": 5.84, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? ആര് അയച്ചു, നിഴൽ, അളവ് - ആദ്യം പരിശോധിക്ക്."}, {"id": 134, "duration_s": 3.15, "emotion": "stern_warning", "text": "സംശയമുണ്ടെങ്കിൽ അയക്കല്ലേ! കള്ളം റിപ്പോർട്ട് ചെയ്യ്!"}, {"id": 135, "duration_s": 2.45, "emotion": "serious", "text": "ഫോർവേഡ് ചെയ്യും മുൻപ് ചിന്തിക്ക്..."}, {"id": 136, "duration_s": 4.862, "emotion": "tender", "text": "...ഇല്ലേൽ ഒരുനാൾ സത്യവും നുണയാകും."}, {"id": 137, "duration_s": 2.5, "emotion": "relieved", "text": "ഹൊ! ഇനി മുതലയുമില്ല, ഒന്നുമില്ല."}, {"id": 138, "duration_s": 2.44, "emotion": "excited", "text": "അച്ഛാ! ഓടയിൽ ശരിക്കും എന്തോ ഉണ്ട്!"}, {"id": 139, "duration_s": 2.21, "emotion": "sarcastic", "text": "ഉവ്വ് ഉവ്വ്... മുതല. മതി മതി."}, {"id": 140, "duration_s": 1.58, "emotion": "comic_panic", "text": "എനിക്കാരെയും പേടിയില്ല!"}]