[{"id": 1, "duration_s": 3.8, "emotion": "excited", "text": "पावसाळा... आणि कॉलनीत सगळे बोअर!"}, {"id": 2, "duration_s": 2.38, "emotion": "excited", "text": "पावसाची सेल्फी! आता लाखो लाईक्स!"}, {"id": 3, "duration_s": 2.83, "emotion": "sad", "text": "झीरो लाईक्स? आईनंही नाही दिला!"}, {"id": 4, "duration_s": 3.2, "emotion": "proud", "text": "फूड फोटो! समोसा नेहमीच व्हायरल!"}, {"id": 5, "duration_s": 1.91, "emotion": "embarrassed", "text": "भूक लागली!"}, {"id": 6, "duration_s": 2.52, "emotion": "excited", "text": "कॅप्टन मगरची नाव! सगळ्यात फास्ट!"}, {"id": 7, "duration_s": 2.11, "emotion": "shocked", "text": "अरे देवा! माझा कॅप्टन मगर!"}, {"id": 8, "duration_s": 1.71, "emotion": "stern_warning", "text": "थांब! नाल्याजवळ नाही!"}, {"id": 9, "duration_s": 1.82, "emotion": "mischievous", "text": "टेन्शन नको! आयडिया सुचली!"}, {"id": 10, "duration_s": 3.93, "emotion": "mischievous", "text": "जरा मोठा... अजून... बस!"}, {"id": 11, "duration_s": 3.41, "emotion": "excited", "text": "दहा मिनिटांत दहा हजार लाईक्स! मी स्टार!"}, {"id": 12, "duration_s": 1.18, "emotion": "proud", "text": "खऱ्या मगरीची गरज कोणाला?"}, {"id": 13, "duration_s": 2.24, "emotion": "scared_whisper", "text": "ऐकलं का? नाल्यात मगर!"}, {"id": 14, "duration_s": 3.72, "emotion": "proud", "text": "चाळीस ग्रुप! एका दमात! माझा रेकॉर्ड!"}, {"id": 15, "duration_s": 3.55, "emotion": "serious", "text": "दहा सेकंदात... अख्ख्या कॉलनीला कळलं."}, {"id": 16, "duration_s": 2.62, "emotion": "excited", "text": "हो, तेच! दोघांना सांगतेय!"}, {"id": 17, "duration_s": 1.72, "emotion": "panicked", "text": "गुरुजी! मगर!"}, {"id": 18, "duration_s": 2.35, "emotion": "calm", "text": "मच्छर? मच्छरदाणी लावा!"}, {"id": 19, "duration_s": 2.31, "emotion": "shocked", "text": "मगर? अरे! माझं धोतर!"}, {"id": 20, "duration_s": 3.895, "emotion": "serious", "text": "दृष्ट लागली! मगरीलाही लिंबू-मिरची!"}, {"id": 21, "duration_s": 3.85, "emotion": "proud", "text": "सायन्स सांगतं, पावसात मगर फक्त चप्पल खाते!"}, {"id": 22, "duration_s": 3.29, "emotion": "panicked", "text": "दार बंद! खिडकी बंद! मोरीसुद्धा बंद!"}, {"id": 23, "duration_s": 5.03, "emotion": "excited", "text": "आयडिया आहे! चला मगर बघूया!"}, {"id": 24, "duration_s": 1.75, "emotion": "stern_warning", "text": "आयडिया खिशात ठेव. अभ्यास काढ."}, {"id": 25, "duration_s": 1.46, "emotion": "proud", "text": "घाबरू नका! मी कुणाला भीत नाही!"}, {"id": 26, "duration_s": 3.12, "emotion": "determined", "text": "मगर आली तर... थेट पॅव्हेलियनमध्ये धाडीन!"}, {"id": 27, "duration_s": 1.69, "emotion": "comic_panic", "text": "म... म... मगरीचं पिल्लू!"}, {"id": 28, "duration_s": 1.87, "emotion": "determined", "text": "बास! आता मी बघते."}, {"id": 29, "duration_s": 3.33, "emotion": "scared_whisper", "text": "सुनंदा... गेली? नक्की गेली?"}, {"id": 30, "duration_s": 4.5, "emotion": "proud", "text": "माझा पोरगा वाघ आहे! अख्खी कॉलनी बघेल!"}, {"id": 31, "duration_s": 2.65, "emotion": "determined", "text": "आज रात्री... मी गेटवर पहारा देईन!"}, {"id": 32, "duration_s": 3.34, "emotion": "guilty", "text": "ते... खरं म्हणजे... तो फोटो..."}, {"id": 33, "duration_s": 2.84, "emotion": "angry", "text": "गप्प! अशुभ बोलू नकोस!"}, {"id": 34, "duration_s": 2.52, "emotion": "giggly", "text": "बाबा... एका बेडकाला?"}, {"id": 35, "duration_s": 3.84, "emotion": "scared_whisper", "text": "रात्रीचे बारा... जोशी गेटवर... पहारा."}, {"id": 36, "duration_s": 3.56, "emotion": "tired", "text": "मी कुणाला भीत नाही... फक्त झोपेला."}, {"id": 37, "duration_s": 4.44, "emotion": "comic_panic", "text": "क...कोण आहे? समोर या!"}, {"id": 38, "duration_s": 2.15, "emotion": "relieved", "text": "<sigh> मनीमावशी! भ्यालो!"}, {"id": 39, "duration_s": 1.49, "emotion": "comic_panic", "text": "म...म...मगर!"}, {"id": 40, "duration_s": 4.66, "emotion": "curious", "text": "गणपत बेटा, मध्यरात्री गेटवर का लटकलास?"}, {"id": 41, "duration_s": 5.03, "emotion": "embarrassed", "text": "योगा, गुरुजी! याला म्हणतात... गेट-आसन!"}, {"id": 42, "duration_s": 2.58, "emotion": "excited", "text": "ऐकलं? रमेश गेटवर लटकलाय!"}, {"id": 43, "duration_s": 3.63, "emotion": "excited", "text": "मगर-प्रूफ गमबूट! चावला तर दात तुटेल!"}, {"id": 44, "duration_s": 3.76, "emotion": "proud", "text": "काल शंभरचे होते. आज तीनशे!"}, {"id": 45, "duration_s": 3.16, "emotion": "sarcastic", "text": "शेठजी, मगरीपेक्षा तुमचेच दात मोठे!"}, {"id": 46, "duration_s": 2.26, "emotion": "proud", "text": "एक रुपयाही कमी नाही!"}, {"id": 47, "duration_s": 2.08, "emotion": "proud", "text": "हिनं एक घेतला? मला द्या!"}, {"id": 48, "duration_s": 0.91, "emotion": "angry", "text": "मग मला तीन!"}, {"id": 49, "duration_s": 2.83, "emotion": "proud", "text": "मला चार! अख्खी कॉलनी बघेल!"}, {"id": 50, "duration_s": 3.16, "emotion": "happy", "text": "चला निघू! उघडे पाय सगळ्यात स्वस्त."}, {"id": 51, "duration_s": 1.87, "emotion": "calm", "text": "शेठजी! आणखी माल आणू?"}, {"id": 52, "duration_s": 7.38, "emotion": "happy", "text": "एक, दोन, तीन... परत... एक, दोन..."}, {"id": 53, "duration_s": 2.7, "emotion": "excited", "text": "बुटात बिस्किट! काय ऑफर!"}, {"id": 54, "duration_s": 2.16, "emotion": "angry", "text": "बिस्किट वेगळं! वीस रुपये!"}, {"id": 55, "duration_s": 2.09, "emotion": "guilty", "text": "ऐका सगळे... तो मगर खरं तर..."}, {"id": 56, "duration_s": 2.05, "emotion": "shouting", "text": "पुढचा! रांगेत या!"}, {"id": 57, "duration_s": 5.09, "emotion": "serious", "text": "दुपारी दोन वाजता... मगरीचा शोध, लाइव्ह!"}, {"id": 58, "duration_s": 3.08, "emotion": "excited", "text": "हॅलो फ्रेंड्स! आम्ही लाइव्ह! क्रोक हंट!"}, {"id": 59, "duration_s": 2.67, "emotion": "proud", "text": "सायन्स सांगतं, मगर शिट्टीला येते."}, {"id": 60, "duration_s": 4.44, "emotion": "pleading", "text": "शेठजी, तुम्ही पुढे व्हा. तुम्ही... मोठे आहात."}, {"id": 61, "duration_s": 2.86, "emotion": "angry", "text": "मी? माझे बूट तीनशेचे आहेत!"}, {"id": 62, "duration_s": 3.64, "emotion": "pleading", "text": "सगळे ऐका! तो मगर खरा नाही..."}, {"id": 63, "duration_s": 1.34, "emotion": "shocked", "text": "तो... तो... हलतोय!"}, {"id": 64, "duration_s": 2.02, "emotion": "panicked", "text": "मगर!!!"}, {"id": 65, "duration_s": 1.47, "emotion": "sad", "text": "...नाही."}, {"id": 66, "duration_s": 1.96, "emotion": "surprised", "text": "अरे! ती तर माझी चप्पल!"}, {"id": 67, "duration_s": 3.54, "emotion": "proud", "text": "बघितलंत? सायन्स! मगरीनं ओकली!"}, {"id": 68, "duration_s": 1.64, "emotion": "pleading", "text": "शालू! ओढ!"}, {"id": 69, "duration_s": 2.06, "emotion": "excited", "text": "ऐकलं का? मगरीनं चप्पल ओकली!"}, {"id": 70, "duration_s": 3.64, "emotion": "excited", "text": "व्ह्यूज दुप्पट! चप्पलसुद्धा व्हायरल!"}, {"id": 71, "duration_s": 4.04, "emotion": "guilty", "text": "<sigh> माझा फोटो... आता चप्पलपेक्षा मोठा."}, {"id": 72, "duration_s": 1.74, "emotion": "shouting", "text": "हवालदार झोपाजी! मगर!"}, {"id": 73, "duration_s": 1.61, "emotion": "sarcastic", "text": "भजी, हवालदारसाहेब."}, {"id": 74, "duration_s": 2.8, "emotion": "surprised", "text": "कुठं? चौकशी होणार!"}, {"id": 75, "duration_s": 5.46, "emotion": "determined", "text": "मगर असो वा त्याचा बाप... चौकशी होणारच!"}, {"id": 76, "duration_s": 1.74, "emotion": "scared_whisper", "text": "श्श्श... कायदा येतोय."}, {"id": 77, "duration_s": 3.811, "emotion": "comic_panic", "text": "म...मगर... छोटा... हिरवा..."}, {"id": 78, "duration_s": 0.75, "emotion": "worried", "text": "दृष्ट!"}, {"id": 79, "duration_s": 3.932, "emotion": "sarcastic", "text": "पाणी की भजं?"}, {"id": 80, "duration_s": 4.6, "emotion": "tired", "text": "चौकशी... सुरू राहील..."}, {"id": 81, "duration_s": 4.19, "emotion": "sad", "text": "माझा मगर... गेला."}, {"id": 82, "duration_s": 2.77, "emotion": "excited", "text": "आयडिया! घाबरायचं नाही, चौकशी करू!"}, {"id": 83, "duration_s": 2.69, "emotion": "serious", "text": "मी सांगू? खरे एक्स्पर्ट बोलवा. वनखातं!"}, {"id": 84, "duration_s": 0.61, "emotion": "stern_warning", "text": "गप्प!"}, {"id": 85, "duration_s": 4.52, "emotion": "serious", "text": "हॅलो, वनविभाग? नाल्यात मगर... कदाचित."}, {"id": 86, "duration_s": 1.344, "emotion": "determined", "text": "खाऊ मी सांभाळतो."}, {"id": 87, "duration_s": 2.58, "emotion": "excited", "text": "ब्रेकिंग न्यूज! कॉलनीच्या नाल्यात मगर हाय!"}, {"id": 88, "duration_s": 4.41, "emotion": "proud", "text": "आपला नाला टीव्हीवर! अख्खी कॉलनी बघेल!"}, {"id": 89, "duration_s": 1.56, "emotion": "comic_panic", "text": "टेन्शन नको... टेन्शन नको... टेन्शन!"}, {"id": 90, "duration_s": 3.88, "emotion": "sarcastic", "text": "अख्खी कॉलनी गच्चीवर. रस्त्यावर फक्त म्हैस."}, {"id": 91, "duration_s": 1.55, "emotion": "happy", "text": "चला चला! साहेब आले!"}, {"id": 92, "duration_s": 3.35, "emotion": "tired", "text": "दरवेळी! नेमक्या मोक्याच्या वेळी!"}, {"id": 93, "duration_s": 2.44, "emotion": "happy", "text": "शाबास! तूच खरी मेकॅनिक!"}, {"id": 94, "duration_s": 2.48, "emotion": "serious", "text": "मगर कुठं हाय बे? मले दाखवा."}, {"id": 95, "duration_s": 0.49, "emotion": "panicked", "text": "तिकडे!!!"}, {"id": 96, "duration_s": 2.35, "emotion": "scared_whisper", "text": "अख्ख्या कॉलनीनं श्वास रोखला..."}, {"id": 97, "duration_s": 2.07, "emotion": "scared_whisper", "text": "मी कुणाला भीत नाही... मी कुणा..."}, {"id": 98, "duration_s": 2.33, "emotion": "sarcastic", "text": "मगर कसला? ह्यो रबराचा हाय."}, {"id": 99, "duration_s": 2.78, "emotion": "shocked", "text": "एवढा छोटा? माझ्या गमबूटचं काय?"}, {"id": 100, "duration_s": 3.81, "emotion": "loving", "text": "माझा कॅप्टन मगर! सापडला!"}, {"id": 101, "duration_s": 2.31, "emotion": "curious", "text": "पण फोटोत तर हा मोठा होता!"}, {"id": 102, "duration_s": 2.92, "emotion": "proud", "text": "मी सांगू? या फोटोत तीन गडबडी आहेत."}, {"id": 103, "duration_s": 3.43, "emotion": "excited", "text": "फॅक्ट-चेक, लाइव्ह सुरू!"}, {"id": 104, "duration_s": 3.21, "emotion": "serious", "text": "एक: मांजराची सावली आहे... मगरीची नाही!"}, {"id": 105, "duration_s": 2.9, "emotion": "serious", "text": "दोन: मगर नाल्यापेक्षा मोठी! शिरेल कशी?"}, {"id": 106, "duration_s": 3.1, "emotion": "proud", "text": "सायन्स सांगतं, मगर श्वास रोखून बारीक होते!"}, {"id": 107, "duration_s": 0.64, "emotion": "stern_warning", "text": "गप!"}, {"id": 108, "duration_s": 3.42, "emotion": "excited", "text": "आणि तीन: शेपटीवर पेढ्याचे दात!"}, {"id": 109, "duration_s": 2.96, "emotion": "embarrassed", "text": "ते... भूक लागली."}, {"id": 110, "duration_s": 3.84, "emotion": "sarcastic", "text": "मगरीचे अश्रू ऐकले होते... मगरीचा फोटो पहिल्यांदाच!"}, {"id": 111, "duration_s": 3.42, "emotion": "serious", "text": "हा फोटो काढला कोणी?"}, {"id": 112, "duration_s": 4.72, "emotion": "guilty", "text": "हो... मीच बनवला होता. फक्त लाईक्ससाठी."}, {"id": 113, "duration_s": 2.32, "emotion": "angry", "text": "लाईक्स?!"}, {"id": 114, "duration_s": 1.97, "emotion": "embarrassed", "text": "सखू आजीचा नेम... कधी चुकत नाही."}, {"id": 115, "duration_s": 3.72, "emotion": "guilty", "text": "आणि मी... चाळीस ग्रुपमध्ये न बघता पाठवला."}, {"id": 116, "duration_s": 4.06, "emotion": "sad", "text": "माझे तीनशेचे बूट... आता कोण घेईल?"}, {"id": 117, "duration_s": 0.88, "emotion": "stern_warning", "text": "शेठजी!"}, {"id": 118, "duration_s": 3.62, "emotion": "embarrassed", "text": "बरं बरं... शंभर रुपये. जुना भाव."}, {"id": 119, "duration_s": 2.54, "emotion": "tired", "text": "आणि मी रात्रभर गेट-आसन केलं!"}, {"id": 120, "duration_s": 3.27, "emotion": "determined", "text": "बास! आता मी बघते. ज्यानं नाला प्रसिद्ध केला..."}, {"id": 121, "duration_s": 1.1, "emotion": "stern_warning", "text": "...तोच नाला साफ करेल!"}, {"id": 122, "duration_s": 2.71, "emotion": "tired", "text": "टेन्शन नको... टेन्शन फार आहे."}, {"id": 123, "duration_s": 2.94, "emotion": "excited", "text": "लाइव्ह सुरू! नाला सफाई, एपिसोड एक!"}, {"id": 124, "duration_s": 2.47, "emotion": "serious", "text": "सुधार चाळीस ग्रुपवर जाणार... आधी तपासणी!"}, {"id": 125, "duration_s": 1.5, "emotion": "curious", "text": "यात बिस्किट आहे का?"}, {"id": 126, "duration_s": 4.519, "emotion": "excited", "text": "माझी चप्पल! बघितलं? सायन्स!"}, {"id": 127, "duration_s": 4.57, "emotion": "serious", "text": "चौकशी... पूर्ण झाली. केस बंद."}, {"id": 128, "duration_s": 4.92, "emotion": "calm", "text": "संध्याकाळ झा