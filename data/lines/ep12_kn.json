[{"id": 1, "duration_s": 4.67, "emotion": "mischievous", "text": "ಬೆಳಗ್ಗೆ ಏಳು ಗಂಟೆ... ಇಡೀ ಕಾಲೋನಿ ಫೋನ್ ಒಟ್ಟಿಗೆ ರಿಂಗಾಯ್ತು!"}, {"id": 2, "duration_s": 3.53, "emotion": "angry", "text": "ದುಡ್ಡು ದಾಸಪ್ಪ ಲೋನ್ ತಗೊಂಡಾನ! ವಸೂಲಿ ಆಗ್ತೈತಿ!"}, {"id": 3, "duration_s": 3.23, "emotion": "excited", "text": "ದಾಸಪ್ಪನ ಗಾಸಿಪ್... ನಂಗೇನಾ? <gasp>"}, {"id": 4, "duration_s": 2.48, "emotion": "scared_whisper", "text": "ನಾನು ಮನೇಲಿಲ್ಲ... ನಾನು ಅಕ್ಕಿ!"}, {"id": 5, "duration_s": 0.84, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪ!"}, {"id": 6, "duration_s": 3.59, "emotion": "mischievous", "text": "ಇದೆಲ್ಲ ಶುರುವಾಗಿದ್ದು ನಿನ್ನೆ... ಬರೀ ಎರಡು ನಿಮಿಷದಲ್ಲಿ."}, {"id": 7, "duration_s": 5.77, "emotion": "serious", "text": "ತೊಂಬತ್ತೆಂಟು, ತೊಂಬತ್ತೊಂಬತ್ತು... ಮತ್ತೆ ಎಣಿಸು! ಒಂದ್ ರೂಪಾಯಿ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 8, "duration_s": 3.38, "emotion": "worried", "text": "ಅಂಗಡಿ ಚಿಕ್ಕದು, ಹೊಟ್ಟೆ ದೊಡ್ಡದು! ಅಂಗಡಿ ಬೆಳೆಸ್ಬೇಕು!"}, {"id": 9, "duration_s": 2.91, "emotion": "mischievous", "text": "ದೊಡ್ಡ ಅಂಗಡಿ? ನಾನ್ ಈಗ್ಲೇ ಜಾಗ ಮಾಡ್ತಿದೀನಿ!"}, {"id": 10, "duration_s": 2.68, "emotion": "excited", "text": "ಎರಡ ನಿಮಿಷಕ್ಕ ಲೋನ್! ಕಾಗದ ಪತ್ರ ಬ್ಯಾಡ!"}, {"id": 11, "duration_s": 3.87, "emotion": "excited", "text": "ಎರಡು ನಿಮಿಷ? ಅಷ್ಟರಲ್ಲಿ ನನ್ ಕಾಫಿ ಕೂಡ ಆರಲ್ಲ!"}, {"id": 12, "duration_s": 2.07, "emotion": "curious", "text": "ದಾಸಪ್ಪನವರೇ, ಲೋನ್ ಅಂದ್ರೇನು?"}, {"id": 13, "duration_s": 4.45, "emotion": "proud", "text": "ಲೋನ್ ಅಂದ್ರೆ... ಬೇರೆಯವರ ದುಡ್ಡು, ನನ್ ಅಂಗಡಿ!"}, {"id": 14, "duration_s": 1.85, "emotion": "calm", "text": "ನಿಮ್ ಕಾಂಟ್ಯಾಕ್ಟ್ ಪರ್ಮಿಶನ್ ಕೊಡ್ರಿ ಸಾಕು."}, {"id": 15, "duration_s": 3.6, "emotion": "happy", "text": "ಬರೀ ಕಾಂಟ್ಯಾಕ್ಟ್ಸ್? ತಗೋ! ಫ್ರೀಯಾಗಿ!"}, {"id": 16, "duration_s": 1.56, "emotion": "calm", "text": "ಮತ್ತ ಫೋಟೋ ಗ್ಯಾಲರಿ ಭೀ."}, {"id": 17, "duration_s": 5.09, "emotion": "giggly", "text": "ಫೋಟೋ ಕೂಡ ತಗೋ! ನನ್ ಥರ ಹ್ಯಾಂಡ್ಸಮ್ ಯಾರಿದಾರೆ? ಹಿ ಹಿ!"}, {"id": 18, "duration_s": 2.47, "emotion": "calm", "text": "ಮತ್ತ ಈ ಷರತ್ತು... ಖಂಡಿತ ಓದ್ರಿ."}, {"id": 19, "duration_s": 3.17, "emotion": "serious", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಷರತ್ತು ಓದಿ, ದಾಸಪ್ಪ!"}, {"id": 20, "duration_s": 3.78, "emotion": "sarcastic", "text": "ಓದೋಕೆ ಟೈಮ್ ಬೇಕು. ಟೈಮ್ ಅಂದ್ರೆ ದುಡ್ಡು!"}, {"id": 21, "duration_s": 2.74, "emotion": "excited", "text": "ಮುಬಾರಕ್! ಲೋನ್ ಮಂಜೂರ್ ಆತು!"}, {"id": 22, "duration_s": 3.73, "emotion": "shocked", "text": "ಇಪ್ಪತ್ತು ಸಾವಿರ ಕೇಳ್ದೆ... ಹದಿಮೂರು ಬಂತಾ?"}, {"id": 23, "duration_s": 2.17, "emotion": "happy", "text": "ಏಳ ಸಾವಿರ ಪ್ರೊಸೆಸಿಂಗ್ ಫೀಸ್ ರೀ!"}, {"id": 24, "duration_s": 3.08, "emotion": "worried", "text": "ಏಳು ದಿನದಲ್ಲಿ ವಾಪಸ್... ಮೂವತ್ತು ಸಾವಿರ!"}, {"id": 25, "duration_s": 2.32, "emotion": "proud", "text": "ಏಳು ದಿನದಲ್ಲಿ ಅಂಗಡಿ ಡಬಲ್!"}, {"id": 26, "duration_s": 4.48, "emotion": "proud", "text": "ಇವತ್ತಿಂದ ದುಡ್ಡು ದಾಸಪ್ಪ... ಲೋನ್ ದಾಸಪ್ಪ!"}, {"id": 27, "duration_s": 4.11, "emotion": "happy", "text": "ಲಾನ್? ವಾಹ್! ಹುಲ್ಲು ಎಲ್ಲಿ ಹಾಕ್ತೀರಿ, ದಾಸಪ್ಪನವರೇ?"}, {"id": 28, "duration_s": 5.01, "emotion": "sarcastic", "text": "ಹುಲ್ಲಲ್ಲ ಮೇಷ್ಟ್ರೇ! ಲೋನ್! ದುಡ್ಡು!"}, {"id": 29, "duration_s": 4.0, "emotion": "tired", "text": "ದಾಸಪ್ಪಣ್ಣ, ಫ್ರೀಜರ್ ದೊಡ್ಡದಾ, ಬಾಗಿಲು ಚಿಕ್ಕದಾ ಗುರು?"}, {"id": 30, "duration_s": 3.08, "emotion": "serious", "text": "ದಾಸಪ್ಪ, ಇಷ್ಟೊಂದು ದುಡ್ಡು ಎಲ್ಲಿಂದ ಬಂತು?"}, {"id": 31, "duration_s": 3.15, "emotion": "happy", "text": "ದೇವರು ಕೊಟ್ಟ... ಎರಡು ನಿಮಿಷದಲ್ಲಿ."}, {"id": 32, "duration_s": 3.3, "emotion": "excited", "text": "ಎರಡು ನಿಮಿಷಕ್ಕೆ ದುಡ್ಡು? ಇದೇ ನನ್ ಕನಸು!"}, {"id": 33, "duration_s": 2.62, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ದಾಸಪ್ಪನ ಹೊಸ ಫ್ರೀಜರ್!"}, {"id": 34, "duration_s": 4.62, "emotion": "mischievous", "text": "ಆ ರಾತ್ರಿ... ಬಡ್ಡಿ ಎಚ್ಚರವಾಗಿತ್ತು. ದಾಸಪ್ಪನೂ ಕೂಡ."}, {"id": 35, "duration_s": 3.54, "emotion": "worried", "text": "ಹನ್ನೆರಡು ಗಂಟೆ... ಇಪ್ಪತ್ತೊಂದು ಸಾವಿರ!"}, {"id": 36, "duration_s": 2.65, "emotion": "panicked", "text": "ಒಂದು ಗಂಟೆ... ಇಪ್ಪತ್ತೆರಡು ಸಾವಿರ!"}, {"id": 37, "duration_s": 2.15, "emotion": "comic_panic", "text": "ಇದು ಬಡ್ಡಿನೋ, ಕರೆಂಟ್ ಮೀಟರೋ?"}, {"id": 38, "duration_s": 3.186, "emotion": "scared_whisper", "text": "ಜ್ಞಾನಿ! ಬಡ್ಡಿ ಗಂಟೆಗಂಟೆಗೂ ಏರ್ತಿದೆ!"}, {"id": 39, "duration_s": 3.3, "emotion": "proud", "text": "ವಿಜ್ಞಾನ ಹೇಳುತ್ತೆ... ಬಡ್ಡಿ ಕೂಡ ರಾತ್ರಿ ಮಲಗುತ್ತೆ."}, {"id": 40, "duration_s": 3.58, "emotion": "crying", "text": "ಬಡ್ಡಿ ಮಲಗಲ್ಲ ಜ್ಞಾನಿ... ನಾನೇ ಮಲಗಿಲ್ಲ!"}, {"id": 41, "duration_s": 2.89, "emotion": "tired", "text": "ದಾಸಪ್ಪ... ಲೆಕ್ಕ ನಾಳೆ."}, {"id": 42, "duration_s": 3.97, "emotion": "mischievous", "text": "ಆ್ಯಪ್ ದಾಸಪ್ಪನ ಎಲ್ಲ ಕಾಂಟ್ಯಾಕ್ಟಿಗೂ ಫೋನ್ ಹಚ್ಚಿತು."}, {"id": 43, "duration_s": 1.93, "emotion": "proud", "text": "ಯಾರದು? ನಂಗೆ ಯಾರ ಭಯಾನೂ ಇಲ್ಲ!"}, {"id": 44, "duration_s": 3.58, "emotion": "shouting", "text": "ಸೇಠನ ದುಡ್ಡು ತುಂಬ್ರಿ, ಇಲ್ಲಂದ್ರ ಎಲ್ರಿಗೂ ಫೋಟೋ ಕಳಸ್ತೀವಿ!"}, {"id": 45, "duration_s": 2.4, "emotion": "sarcastic", "text": "ಫೋನ್ರೀ ಅದು, ಹಲ್ಲಿ ಅಲ್ಲ."}, {"id": 46, "duration_s": 5.52, "emotion": "angry", "text": "ಎಲ್ರಿಗೂ ಫೋನ್ ಬಂತು, ನಂಗಿಲ್ವಾ? ದಾಸಪ್ಪ ನನ್ ನಂಬರ್ ಇಟ್ಕೊಂಡಿಲ್ವಾ?"}, {"id": 47, "duration_s": 7.05, "emotion": "proud", "text": "ಬಂತು! ಹಲೋ? ಹೌದು, ನಾನೇ... ಇಡೀ ಕಾಲೋನಿ ನೋಡುತ್ತೆ!"}, {"id": 48, "duration_s": 1.83, "emotion": "worried", "text": "ಫೋನಿಗೇ ದೃಷ್ಟಿ ಆಯ್ತು!"}, {"id": 49, "duration_s": 6.584, "emotion": "shouting", "text": "ತನಿಖೆ! ...ಯಾರದ್ದು?"}, {"id": 50, "duration_s": 3.17, "emotion": "tired", "text": "ಫೋನೂ ರಿಂಗು, ಆಟೋನೂ ಬಂದ್. ಹೋಗೋಣ..."}, {"id": 51, "duration_s": 1.48, "emotion": "stern_warning", "text": "ಚುಪ್!"}, {"id": 52, "duration_s": 2.92, "emotion": "excited", "text": "ಮುವ್ವತ್ತು ವರ್ಷದಿಂದ ದಾಸಪ್ಪನ ಸುದ್ದಿ ಸಿಕ್ಕಿರಲಿಲ್ಲ!"}, {"id": 53, "duration_s": 2.54, "emotion": "mischievous", "text": "ಕೇಳಿದ್ರಾ? ದಾಸಪ್ಪ ಲೋನ್ ತಗೊಂಡ್ರು!"}, {"id": 54, "duration_s": 2.4, "emotion": "sarcastic", "text": "ಗೊತ್ತು. ನಂಗೂ ಫೋನ್ ಬಂದಿತ್ತು."}, {"id": 55, "duration_s": 1.6, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ದಾಸಪ್ಪ—"}, {"id": 56, "duration_s": 2.59, "emotion": "calm", "text": "ಗೊತ್ತು. ನಿಂಬೆಹಣ್ಣೂ ಕಟ್ಟಿದೆ."}, {"id": 57, "duration_s": 0.85, "emotion": "pleading", "text": "ಕೇಳಿದ್ರಾ?"}, {"id": 58, "duration_s": 2.884, "emotion": "giggly", "text": "ಗೊತ್ತು ಆಂಟಿ! ಇಡೀ ಕಾಲೋನಿಗೇ ಗೊತ್ತು!"}, {"id": 59, "duration_s": 3.04, "emotion": "mischievous", "text": "ಹಲೋ, ಲೋನ್ ಅವರೇ? ದಾಸಪ್ಪ ಇನ್ನೇನೇನ್ ತಗೊಂಡ್ರು?"}, {"id": 60, "duration_s": 1.87, "emotion": "surprised", "text": "ಆಂಟಿ, ನೀವ ವಸೂಲಿ ಮಾಡ್ತೀರೇನ್ರಿ?"}, {"id": 61, "duration_s": 1.82, "emotion": "giggly", "text": "ಇಲ್ಲಪ್ಪಾ, ನಂಗೆ ಬರೀ ಸುದ್ದಿ ಸಾಕು."}, {"id": 62, "duration_s": 3.36, "emotion": "angry", "text": "ದಾಸಪ್ಪ! ಇಡೀ ಕಾಲೋನಿ ಏನ್ ಮಾತಾಡ್ತಿದೆ?!"}, {"id": 63, "duration_s": 3.19, "emotion": "serious", "text": "ದಾಸಪ್ಪ ಎಲ್ಲಿ?"}, {"id": 64, "duration_s": 1.21, "emotion": "giggly", "text": "ಅಕ್ಕಿಲಿ!"}, {"id": 65, "duration_s": 2.53, "emotion": "scared_whisper", "text": "ಭಾಗ್ಯ... ನಾನು ಚೀಲದಲ್ಲಿ ಇಲ್ಲ."}, {"id": 66, "duration_s": 1.97, "emotion": "guilty", "text": "ಬರೀ ಎರಡು ನಿಮಿಷದ ಲೋನ್ ಭಾಗ್ಯ."}, {"id": 67, "duration_s": 3.3, "emotion": "sarcastic", "text": "ಎರಡು ನಿಮಿಷದ ಲೋನ್... ಇಡೀ ಕಾಲೋನಿಗೆ ಫೋನ್?"}, {"id": 68, "duration_s": 3.53, "emotion": "pleading", "text": "ಅವರು ನನ್ ಫೋಟೋ ತಗೊಂಡ್ರು. ಎಲ್ರಿಗೂ ಕಳಸ್ತಾರಂತೆ!"}, {"id": 69, "duration_s": 2.86, "emotion": "laughing", "text": "ಇದು ಅಪ್ಪನ ಜಿಲೇಬಿ ಫೋಟೋ ಅಲ್ವಾ! ಹ ಹ!"}, {"id": 70, "duration_s": 2.62, "emotion": "determined", "text": "ಲೆಕ್ಕ ಈಗ ನಂದು."}, {"id": 71, "duration_s": 2.34, "emotion": "excited", "text": "ಟೆನ್ಷನ್ ಬೇಡ! ನನ್ ಹತ್ರ ಇನ್ನೊಂದ್ ಆ್ಯಪ್ ಇದೆ!"}, {"id": 72, "duration_s": 2.59, "emotion": "proud", "text": "ಲೋನ್ ತೀರಿಸೋಕೆ... ಹೊಸ ಲೋನ್!"}, {"id": 73, "duration_s": 2.09, "emotion": "excited", "text": "ನಿಜವಾ? ಎಷ್ಟು ನಿಮಿಷದಲ್ಲಿ?"}, {"id": 74, "duration_s": 1.82, "emotion": "comic_panic", "text": "...ತಮಾಷೆ ಮಾಡ್ದೆ ಅಷ್ಟೇ."}, {"id": 75, "duration_s": 3.7, "emotion": "angry", "text": "ಸಾಲದ ಮೇಲೆ ಸಾಲ? ನಿಲ್ಲು ಸೀನ!"}, {"id": 76, "duration_s": 2.86, "emotion": "embarrassed", "text": "ಗೌರಮ್ಮನ ಗುರಿ... ಯಾವತ್ತೂ ತಪ್ಪಲ್ಲ."}, {"id": 77, "duration_s": 2.37, "emotion": "determined", "text": "ಸಾಕು! ಈಗ ನಾನ್ ನೋಡ್ತೀನಿ."}, {"id": 78, "duration_s": 3.65, "emotion": "serious", "text": "ಮೊದಲು ಸಾಕ್ಷಿ. ಪ್ರತಿ ಬೆದರಿಕೆಯ ಸ್ಕ್ರೀನ್‌ಶಾಟ್."}, {"id": 79, "duration_s": 3.1, "emotion": "calm", "text": "ಆಮೇಲೆ ಕಾಂಟ್ಯಾಕ್ಟ್ ಫೋಟೋ ಅನುಮತಿ... ಆಫ್."}, {"id": 80, "duration_s": 2.33, "emotion": "shocked", "text": "ಆದ್ರೆ ಫ್ರೀಯಾಗಿ ಕೊಟ್ಟಿದ್ನಲ್ಲಾ!"}, {"id": 81, "duration_s": 0.46, "emotion": "shouting", "text": "ಚುಪ್!"}, {"id": 82, "duration_s": 2.39, "emotion": "excited", "text": "ಒಂದ್ ಐಡಿಯಾ ಇದೆ! ಅಸಲಿ ಬ್ಯಾಂಕಿಗೆ ಹೋಗೋಣ!"}, {"id": 83, "duration_s": 4.73, "emotion": "proud", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಒಂದು ಒಂಬತ್ತು ಮೂರು ಸೊನ್ನೆಗೆ ಸೈಬರ್ ದೂರು!"}, {"id": 84, "duration_s": 3.0, "emotion": "worried", "text": "ಬ್ಯಾಂಕ್? ಅಲ್ಲಿ ಕೂರೋಕೂ ಫೀಸ್ ಇರುತ್ತೆ!"}, {"id": 85, "duration_s": 0.63, "emotion": "stern_warning", "text": "ನಡೀರಿ!"}, {"id": 86, "duration_s": 0.94, "emotion": "happy", "text": "ಹೊರಡೋಣ!"}, {"id": 87, "duration_s": 6.28, "emotion": "sarcastic", "text": "ದಾಸಪ್ಪ, ಹೊಟ್ಟೆ ಸ್ವಲ್ಪ ಆಕಡೆ... ಬಡ್ಡಿ ಸಮೇತ!"}, {"id": 88, "duration_s": 1.69, "emotion": "tired", "text": "<sigh> ಇದು ಅರ್ಜೆಂಟ್ ಕೆಲಸಕ್ಕೇ ನಿಲ್ಲೋದು."}, {"id": 89, "duration_s": 2.08, "emotion": "stern_warning", "text": "ತಳ್ರಿ ಜೋರಾಗಿ! ನಾನ್ ಎಣಿಸ್ತಿದೀನಿ."}, {"id": 90, "duration_s": 3.02, "emotion": "scared_whisper", "text": "ಮೊದ್ಲೇ ಹೇಳಿ... ಕೂರೋಕೆ ಫೀಸ್ ಇಲ್ಲ ತಾನೇ?"}, {"id": 91, "duration_s": 3.62, "emotion": "calm", "text": "ಮೇಡಂ, ಆ್ಯಪ್ ದಿನಾ ಬಡ್ಡಿ ಏರಿಸಿ ಎಲ್ರನ್ನೂ ಬೆದರಿಸುತ್ತೆ."}, {"id": 92, "duration_s": 3.58, "emotion": "serious", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಯಾವ ಆ್ಯಪ್ಗೂ ಕಾಂಟ್ಯಾಕ್ಟ್-ಫೋಟೋ ಕೊಡ್ಬೇಡಿ."}, {"id": 93, "duration_s": 2.94, "emotion": "serious", "text": "ಸಾಲ ಬ್ಯಾಂಕ್ ಅಥವಾ ಆರ್‌ಬಿಐ ಕಂಪನಿಯಿಂದ ಮಾತ್ರ."}, {"id": 94, "duration_s": 3.34, "emotion": "guilty", "text": "ಮತ್ತೆ ನನ್ ಆ್ಯಪ್... ರಿಜಿಸ್ಟರ್ ಆಗಿತ್ತಾ?"}, {"id": 95, "duration_s": 5.04, "emotion": "proud", "text": "ಬೆದರಿಕೆ? ಒಂದೊಂಬತ್ತು ಮೂರು ಸೊನ್ನೆ ಫೋನ್, ಸೈಬರ್ ದೂರು."}, {"id": 96, "duration_s": 2.95, "emotion": "calm", "text": "ಸೈಬರ್ ಕ್ರೈಮ್ ಹೆಲ್ಪ್‌ಲೈನ್. ಹೇಳ್ರಿ, ಏನಾತು?"}, {"id": 97, "duration_s": 3.05, "emotion": "serious", "text": "ಲೋನ್ ಆ್ಯಪ್ ಬೆದರಿಸ್ತಿದೆ. ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಎಲ್ಲಾ ನಮ್ ಹತ್ರ ಇದೆ."}, {"id": 98, "duration_s": 3.6, "emotion": "calm", "text": "ಛಲೋ ಮಾಡಿದ್ರಿ. ದೂರು ದಾಖಲಾತು, ನಂಬರ್ ಮೆಸೇಜ್ ಬರತೈತಿ."}, {"id": 99, "duration_s": 2.01, "emotion": "worried", "text": "ಮತ್ತೆ... ಏನಾದ್ರೂ ಫೀಸ್?"}, {"id": 100, "duration_s": 1.08, "emotion": "calm", "text": "ಫೀಸ್ ಇಲ್ರಿ."}, {"id": 101, "duration_s": 3.36, "emotion": "happy", "text": "ಅಂಗಡಿಗೆ ಸರಿಯಾದ ಲೋನ್, ಸರಿಯಾದ ಕಾಗದ ಜೊತೆ."}, {"id": 102, "duration_s": 3.71, "emotion": "happy", "text": "ಮೇಡಂ, ನಿಮ್ ಸಲಹೆ... ಒಂದ್ ರೂಪಾಯಿ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 103, "duration_s": 2.78, "emotion": "calm", "text": "ಸಂಜೆ ದಾಸಪ್ಪ ಸತ್ಯನಾರಾಯಣ ಪೂಜೆ ಇಟ್ಕೊಂಡ್ರು."}, {"id": 104, "duration_s": 2.78, "emotion": "pleading", "text": "ದೇವ್ರೇ, ಇವತ್ತು ಯಾವ ಫೋನೂ ಬಾರಿಸದಿರ್ಲಿ."}, {"id": 105, "duration_s": 2.85, "emotion": "serious", "text": "ಕಥೆಯ ಮೊದಲ ಅಧ್ಯಾಯ... ಗಮನವಿಟ್ಟು ಕೇಳಿ."}, {"id": 106, "duration_s": 2.3, "emotion": "scared_whisper", "text": "ಬಂದ್ರು... ವಸೂಲಿಯವರು!"}, {"id": 107, "duration_s": 3.58, "emotion": "excited", "text": "ಪ್ಲಾನ್ ನೆನಪಿದ್ಯಾ? ಮೂರು... ಎರಡು... ಒಂದು!"}, {"id": 108, "duration_s": 1.79, "emotion": "calm", "text": "ದಾಸಪ್ಪ ಪೂಜೆ ಮಾಡ್ತಿದಾರೆ!"}, {"id": 109, "duration_s": 2.32, "emotion": "angry", "text": "ಪೂಜಾ? ದುಡ್ಡ ಯಾವಾಗ್ರೀ?!"}, {"id": 110, "duration_s": 5.08, "emotion": "proud", "text": "ದೂರು ಒಂದೊಂಬತ್ತು ಮೂರು ಸೊನ್ನೆಗೆ ಆಗಿದೆ! ಕಾಲೋನಿ ಸಾಕ್ಷಿ!"}, {"id": 111, "duration_s": 2.64, "emotion": "proud", "text": "ಮತ್ತೆ ನಂಗೆ... ಯಾರ ಭಯಾನೂ ಇಲ್ಲ!"}, {"id": 112, "duration_s": 2.96, "emotion": "sarcastic", "text": "ಬೆದರಿಕೆಗೆ ಹೆದರ್ಲಿಲ್ಲ... ಹಲ್ಲಿಗೆ ಹೆದರಿದ್ರು."}, {"id": 113, "duration_s": 4.22, "emotion": "mischievous", "text": "ಮಗೂ, ನಿನ್ ಹೆಸರೇನು? ನಾಳೆ ಇಡೀ ಕಾಲೋನಿಗೆ ಗೊತ್ತಾಗುತ್ತೆ."}, {"id": 114, "duration_s": 2.59, "emotion": "serious", "text": "ಎಲ್ಲ ಫೋನಿಗೂ ದೃಷ್ಟಿ ಆಗಿದೆ!"}, {"id": 115, "duration_s": 2.57, "emotion": "excited", "text": "ಪ್ರಸಾದ? ...ತನಿಖೆ!"}, {"id": 116, "duration_s": 3.18, "emotion": "guilty", "text": "ಹಸಿವಾಗಿದೆ! ದೇವರು ಕ್ಷಮಿಸ್ತಾರೆ."}, {"id": 117, "duration_s": 3.84, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ಜಗತ್ತಿನ ಮೊದಲ ಆ್ಯಂಟಿ-ಲೋನ್ ಆರತಿ!"}, {"id": 118, "duration_s": 0.57, "emotion": "shouting", "text": "ಚುಪ್!"}, {"id": 119, "duration_s": 3.0, "emotion": "calm", "text": "ಹಾಂ... ಕಥೆಯ ಮೊದಲ ಅಧ್ಯಾಯ."}, {"id": 120, "duration_s": 3.33, "emotion": "loving", "text": "ದಾಸಪ್ಪ, ಇನ್ನು ನೀವು ಒಬ್ಬರೇ ಅಲ್ಲ."}, {"id": 121, "duration_s": 3.43, "emotion": "tender", "text": "ಇಡೀ ಕಾಲೋನಿ... ಮತ್ತೆ ಯಾವ ಫೀಸೂ ಇಲ್ಲ."}, {"id": 122, "duration_s": 4.74, "emotion": "calm", "text": "ಮರುದಿನ... ಕಾಲೋನಿಯಲ್ಲಿ ಒಂದೂ ಫೋನ್ ಬಾರಿಸಲಿಲ್ಲ."}, {"id": 123, "duration_s": 6.35, "emotion": "proud", "text": "ತನಿಖೆ ಮುಗೀತು! ಸೈಬರ್ ಸೆಲ್ ದೂರು ದಾಖಲು ಮಾಡ್ಕೊಂಡಿದೆ."}, {"id": 124, "duration_s": 3.95, "emotion": "serious", "text": "ಆ್ಯಪ್ ರಿಪೋರ್ಟ್ ಆಗಿದೆ. ಬೆದರಿಕೆ ಫೋನ್ ಬಂದ್."}, {"id": 125, "duration_s": 3.55, "emotion": "excited", "text": "ಅಂದ್ರೆ... ಮೂವತ್ತು ಸಾವಿರ ಕೊಡ್ಬೇಕಿಲ್ವಾ?"}, {"id": 126, "duration_s": 4.88, "emotion": "serious", "text": "ಬೆದರಿಕೆಗೆ ಬಡ್ಡಿ ಇಲ್ಲ. ಎಷ್ಟು ಬಂತೋ, ಅಷ್ಟೇ ವಾಪಸ್ ಕೊಡು."}, {"id": 127, "duration_s": 4.58, "emotion": "sad", "text": "ಹದಿಮೂರು ಸಾವಿರ... ಪೂರ್ತಿ. ಒಂದ್ ರೂಪಾಯಿ ಕಮ್ಮಿ ಇಲ್ಲ..."}, {"id": 128, "duration_s": 4.28, "emotion": "determined", "text": "ಕಾಂಟ್ಯಾಕ್ಟ್ಸ್ ನಂದು, ಫೋಟೋ ನಂದು. ಯಾವ ಆ್ಯಪ್ದೂ ಅಲ್ಲ!"}, {"id": 129, "duration_s": 3.85, "emotion": "proud", "text": "ವಿಜ್ಞಾನ ಅಂತೆ: ಆ್ಯಪ್ ಡಿಲೀಟ್ ಆದ್ರೆ ಲೋನೂ ಡಿಲೀಟ್!"}, {"id": 130, "duration_s": 5.88, "emotion": "serious", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಅಸಲಿ ಸಾಲ ವಾಪಸ್ ಕೊಡ್ಬೇಕು. ಬೆದರಿಕೆ ಸಹಿಸ್ಬಾರ್ದು."}, {"id": 131, "duration_s": 4.75, "emotion": "proud", "text": "ಅಂಗಡಿ ಬೆಳೆಯುತ್ತೆ... ಬ್ಯಾಂಕಿಂದ, ಸರಿಯಾದ ಕಾಗದ ಜೊತೆ!"}, {"id": 132, "duration_s": 4.28, "emotion": "guilty", "text": "ಅಜ್ಜಾ, ಎರಡು ನಿಮಿಷದ ಲೋನ್... ಎರಡು ದಿನ ಅಳಿಸ್ತು."}, {"id": 133, "duration_s": 3.22, "emotion": "calm", "text": "ಬೇಗ ಬಂದ ದುಡ್ಡು... ತುಂಬಾ ಅಳಿಸುತ್ತೆ."}, {"id": 134, "duration_s": 6.84, "emotion": "serious", "text": "ಸಾಲ ಬ್ಯಾಂಕ್ ಅಥವಾ ಆರ್‌ಬಿಐ ನೋಂದಾಯಿತ ಕಡೆಯಿಂದ ಮಾತ್ರ. ಷರತ್ತು ಓದಿ."}, {"id": 135, "duration_s": 5.93, "emotion": "stern_warning", "text": "ಆ್ಯಪ್‌ಗೆ ಫೋಟೋ ಬೇಡ. ಬೆದರಿಕೆ? ಒಂದೊಂಬತ್ತು ಮೂರು ಸೊನ್ನೆ."}, {"id": 136, "duration_s": 2.15, "emotion": "happy", "text": "'ಟೈಮ್ ಈಸ್ ಮನಿ' ಅಲ್ಲ... 'ಓದೋದೇ ಮನಿ'!"}, {"id": 137, "duration_s": 3.25, "emotion": "happy", "text": "ಒಂದ್ ಅಕ್ಷರ ಕೂಡ ಕಮ್ಮಿ ಇಲ್ಲ... ಪೂರ್ತಿ ಓದ್ತೀನಿ!"}, {"id": 138, "duration_s": 1.53, "emotion": "excited", "text": "ಎರಡ ನಿಮಿಷಕ್ಕ ಲೋನ್!"}, {"id": 139, "duration_s": 2.49, "emotion": "happy", "text": "ಕಾಲೋನಿ ಕಥೆಗಳು... ಮತ್ತೆ ಸಿಗೋಣ!"}]