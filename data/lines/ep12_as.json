[{"id": 1, "duration_s": 3.58, "emotion": "mischievous", "text": "পুৱা সাতবজাত... চুবুৰীৰ সকলোৰে ফোন বাজিল।"}, {"id": 2, "duration_s": 2.59, "emotion": "angry", "text": "ধনৰামে লোন লৈছাক! উসুল হবই!"}, {"id": 3, "duration_s": 2.13, "emotion": "excited", "text": "ধনৰামৰ খবৰ... মোক? <gasp>"}, {"id": 4, "duration_s": 2.5, "emotion": "scared_whisper", "text": "মই ঘৰত নাই... মই চাউল।"}, {"id": 5, "duration_s": 0.7, "emotion": "stern_warning", "text": "ধনৰাম!"}, {"id": 6, "duration_s": 3.43, "emotion": "mischievous", "text": "এইবোৰ আৰম্ভ হৈছিল কালি... মাত্ৰ দুমিনিটত।"}, {"id": 7, "duration_s": 4.91, "emotion": "serious", "text": "আঠানব্বৈ, ঊনশ... আকৌ গণা। এক টকাও কম নহয়!"}, {"id": 8, "duration_s": 4.71, "emotion": "worried", "text": "দোকান সৰু, পেট ডাঙৰ। দোকান বঢ়াব লাগিব!"}, {"id": 9, "duration_s": 1.863, "emotion": "mischievous", "text": "ডাঙৰ দোকান? ঠাই এতিয়াই বনাইছোঁ।"}, {"id": 10, "duration_s": 1.56, "emotion": "excited", "text": "দুমিনিটত লোন! কাগজ নালাগে!"}, {"id": 11, "duration_s": 0.7, "emotion": "excited", "text": "দুমিনিট? ইমান সময়ত মোৰ চাহো নুজুৰায়!"}, {"id": 12, "duration_s": 1.19, "emotion": "curious", "text": "ধনৰাম, লোন মানে কি?"}, {"id": 13, "duration_s": 3.94, "emotion": "proud", "text": "লোন মানে... আনৰ ধন, মোৰ দোকান!"}, {"id": 14, "duration_s": 2.08, "emotion": "calm", "text": "খালি কণ্টেক্টৰ অনুমতি দিয়ক।"}, {"id": 15, "duration_s": 3.91, "emotion": "happy", "text": "খালি কণ্টেক্ট? লোৱা! বিনামূলীয়াকৈ!"}, {"id": 16, "duration_s": 1.46, "emotion": "calm", "text": "আৰু ফটো গেলেৰীও।"}, {"id": 17, "duration_s": 3.62, "emotion": "giggly", "text": "ফটোও লোৱা! মোৰ দৰে হেণ্ডছাম কোন?"}, {"id": 18, "duration_s": 2.87, "emotion": "calm", "text": "আৰু এই চৰ্তগিলা... নিশ্চয় পঢ়ি লব।"}, {"id": 19, "duration_s": 2.59, "emotion": "serious", "text": "মই কওঁ? চৰ্ত পঢ়িব লাগে, ধনৰাম!"}, {"id": 20, "duration_s": 4.08, "emotion": "sarcastic", "text": "পঢ়িবলৈ সময় লাগিব। আৰু সময়েই ধন!"}, {"id": 21, "duration_s": 2.49, "emotion": "excited", "text": "অভিনন্দন! লোন মঞ্জুৰ!"}, {"id": 22, "duration_s": 3.9, "emotion": "shocked", "text": "হায়! বিশ হাজাৰ বিচাৰিলোঁ... তেৰ আহিল?"}, {"id": 23, "duration_s": 2.94, "emotion": "happy", "text": "সাত হাজাৰ প্ৰচেছিং ফী, ধনৰাম!"}, {"id": 24, "duration_s": 3.62, "emotion": "worried", "text": "আৰু সাত দিনত ঘূৰাব লাগিব... ত্ৰিশ হাজাৰ!"}, {"id": 25, "duration_s": 3.18, "emotion": "proud", "text": "সাত দিনত দোকান দুগুণ!"}, {"id": 26, "duration_s": 3.21, "emotion": "proud", "text": "আজিৰ পৰা ধনৰাম... লোনৱালা!"}, {"id": 27, "duration_s": 3.59, "emotion": "happy", "text": "লন? বাঃ! ঘাঁহ ক'ত লগাবা, ধনৰাম?"}, {"id": 28, "duration_s": 3.86, "emotion": "sarcastic", "text": "ঘাঁহ নহয়, চাৰ! লোন! টকা!"}, {"id": 29, "duration_s": 3.01, "emotion": "tired", "text": "ধনৰাম, ফ্ৰিজ ডাঙৰ নে দুৱাৰ সৰু?"}, {"id": 30, "duration_s": 2.6, "emotion": "serious", "text": "ধনৰাম, ইমান টকা ক'ৰ পৰা?"}, {"id": 31, "duration_s": 2.54, "emotion": "happy", "text": "ভগৱানে দিলে... দুমিনিটতে।"}, {"id": 32, "duration_s": 2.39, "emotion": "excited", "text": "দুমিনিটত টকা? এয়াই মোৰ সপোন!"}, {"id": 33, "duration_s": 2.24, "emotion": "excited", "text": "লাইভ চলিছে! ধনৰামৰ নতুন ফ্ৰিজ!"}, {"id": 34, "duration_s": 3.9, "emotion": "mischievous", "text": "সেইৰাতি... সুত জাগি থাকিল। ধনৰামো।"}, {"id": 35, "duration_s": 2.3, "emotion": "worried", "text": "বাৰটা বাজিল... একৈশ হাজাৰ!"}, {"id": 36, "duration_s": 1.94, "emotion": "panicked", "text": "এটা বাজিল... বাইশ হাজাৰ!"}, {"id": 37, "duration_s": 1.68, "emotion": "comic_panic", "text": "এইটো সুত নে বিজুলী মিটাৰ?"}, {"id": 38, "duration_s": 2.39, "emotion": "scared_whisper", "text": "পণ্ডিত পবিত্ৰ! সুত ঘণ্টাই বাঢ়িছে!"}, {"id": 39, "duration_s": 2.74, "emotion": "proud", "text": "বিজ্ঞানে কয়... সুতেও ৰাতি শোৱে।"}, {"id": 40, "duration_s": 5.03, "emotion": "crying", "text": "সুতে নুশোৱে, পণ্ডিত... মই নুশুওঁ!"}, {"id": 41, "duration_s": 1.09, "emotion": "tired", "text": "ধনৰাম... কাইলৈ।"}, {"id": 42, "duration_s": 2.028, "emotion": "mischievous", "text": "এপে ধনৰামৰ প্ৰতিটো কণ্টেক্টলৈ ফোন কৰিলে।"}, {"id": 43, "duration_s": 5.2, "emotion": "proud", "text": "কোন? মই কাকো নেডৰাঁ!"}, {"id": 44, "duration_s": 3.677, "emotion": "shouting", "text": "ধনৰামৰ টকা ভৰ, নহলে ফটো পঠাম!"}, {"id": 45, "duration_s": 2.05, "emotion": "sarcastic", "text": "ফোন, টিকটিকি নহয় হে।"}, {"id": 46, "duration_s": 4.57, "emotion": "angry", "text": "সকলোকে ফোন, মোক নাই? ধনৰামে মোৰ নম্বৰ ৰখা নাই?"}, {"id": 47, "duration_s": 4.61, "emotion": "proud", "text": "আহিল! হেল্ল'? হয়, মই... গোটেই চুবুৰীয়ে চাব!"}, {"id": 48, "duration_s": 1.16, "emotion": "worried", "text": "ফোনত নজৰ লাগিল!"}, {"id": 49, "duration_s": 2.69, "emotion": "shouting", "text": "তদন্ত হ'ব! ...কাৰ?"}, {"id": 50, "duration_s": 1.9, "emotion": "tired", "text": "ফোনো বাজিল, অটোও বন্ধ। চলা..."}, {"id": 51, "duration_s": 1.638, "emotion": "stern_warning", "text": "চুপ!"}, {"id": 52, "duration_s": 2.12, "emotion": "excited", "text": "ত্ৰিশ বছৰে ধনৰামৰ কোনো খবৰ পোৱা নাছিলোঁ!"}, {"id": 53, "duration_s": 2.3, "emotion": "mischievous", "text": "শুনিছা নে? ধনৰামে লোন লৈছে!"}, {"id": 54, "duration_s": 2.29, "emotion": "sarcastic", "text": "গম পাইছোঁ। মোকো ফোন আহিছিল।"}, {"id": 55, "duration_s": 1.71, "emotion": "excited", "text": "শুনা? ধনৰামে—"}, {"id": 56, "duration_s": 2.66, "emotion": "calm", "text": "গম পাইছোঁ। নেমুও বান্ধি দিলোঁ।"}, {"id": 57, "duration_s": 0.9, "emotion": "pleading", "text": "শুনিছা নে...?"}, {"id": 58, "duration_s": 1.98, "emotion": "giggly", "text": "জানোঁ বাইদেউ! সকলোৱে জানে!"}, {"id": 59, "duration_s": 3.66, "emotion": "mischievous", "text": "হেল্ল', লোনৱালা? ধনৰামে আৰু কি কি লৈছে?"}, {"id": 60, "duration_s": 1.74, "emotion": "surprised", "text": "বাইদেউ, উসুল কৰিব?"}, {"id": 61, "duration_s": 1.89, "emotion": "giggly", "text": "নহয় বোপা, খবৰহে ল'ম।"}, {"id": 62, "duration_s": 2.9, "emotion": "angry", "text": "ধনৰাম! গোটেই চুবুৰীয়ে কি কৈ আছে?!"}, {"id": 63, "duration_s": 0.88, "emotion": "serious", "text": "ধনৰাম ক'ত?"}, {"id": 64, "duration_s": 0.76, "emotion": "giggly", "text": "চাউলত।"}, {"id": 65, "duration_s": 2.62, "emotion": "scared_whisper", "text": "মনি... মই বস্তাত নাই।"}, {"id": 66, "duration_s": 2.81, "emotion": "guilty", "text": "মাত্ৰ দুমিনিটৰ লোন আছিল, মনি।"}, {"id": 67, "duration_s": 3.75, "emotion": "sarcastic", "text": "দুমিনিটৰ লোন... আৰু গোটেই চুবুৰীলৈ ফোন?"}, {"id": 68, "duration_s": 3.3, "emotion": "pleading", "text": "মোৰ ফটো লৈ গ'ল! সকলোকে পঠাব!"}, {"id": 69, "duration_s": 2.95, "emotion": "laughing", "text": "এইটো দেউতাৰ জিলাপীৰ ফটো!"}, {"id": 70, "duration_s": 1.49, "emotion": "determined", "text": "এতিয়া হিচাপ মই লম।"}, {"id": 71, "duration_s": 2.96, "emotion": "excited", "text": "ভয় নাই ধনৰাম! মোৰ আন এপ আছে!"}, {"id": 72, "duration_s": 2.88, "emotion": "proud", "text": "লোন শুধিবলৈ... নতুন লোন!"}, {"id": 73, "duration_s": 2.06, "emotion": "excited", "text": "সঁচা? কিমান মিনিটত?"}, {"id": 74, "duration_s": 1.38, "emotion": "comic_panic", "text": "...মই ধেমালি কৰিছিলোঁ।"}, {"id": 75, "duration_s": 2.51, "emotion": "angry", "text": "ধাৰৰ ওপৰত ধাৰ? ৰ', ধনু!"}, {"id": 76, "duration_s": 3.03, "emotion": "embarrassed", "text": "আইতাৰ নিশানা... সদায় সঠিক।"}, {"id": 77, "duration_s": 0.77, "emotion": "determined", "text": "বাস! এতিয়া মই চাওঁ।"}, {"id": 78, "duration_s": 2.96, "emotion": "serious", "text": "প্ৰথমে প্ৰমাণ। প্ৰতিটো ভাবুকিৰ স্ক্ৰীণশ্বট।"}, {"id": 79, "duration_s": 3.18, "emotion": "calm", "text": "তেতিয়া কণ্টেক্ট-ফটোৰ অনুমতি... বন্ধ।"}, {"id": 80, "duration_s": 1.92, "emotion": "shocked", "text": "কিন্তু ফ্ৰীত দিছিলোঁ!"}, {"id": 81, "duration_s": 0.59, "emotion": "shouting", "text": "চুপ!"}, {"id": 82, "duration_s": 2.29, "emotion": "excited", "text": "এটা বুদ্ধি আছে! আচল বেংকলৈ যাওঁ!"}, {"id": 83, "duration_s": 3.26, "emotion": "proud", "text": "মই কওঁ? ঊনৈশ তিৰিশত অভিযোগ!"}, {"id": 84, "duration_s": 2.95, "emotion": "worried", "text": "বেংক? তাত বহিবলৈও ফী লাগিব!"}, {"id": 85, "duration_s": 0.68, "emotion": "stern_warning", "text": "চলা!"}, {"id": 86, "duration_s": 1.62, "emotion": "happy", "text": "চলা, যাওঁ!"}, {"id": 87, "duration_s": 5.17, "emotion": "sarcastic", "text": "ধনৰাম, পেট সিফালে... সুত সহিতে।"}, {"id": 88, "duration_s": 1.78, "emotion": "tired", "text": "<sigh> এইটো জৰুৰী কামতহে ৰৈ যায়।"}, {"id": 89, "duration_s": 2.16, "emotion": "stern_warning", "text": "জোৰ লগা! মই গণিছোঁ।"}, {"id": 90, "duration_s": 2.84, "emotion": "scared_whisper", "text": "আগতে কৈ দিয়া... বহিবলৈ ফী নালাগে তো?"}, {"id": 91, "duration_s": 4.322, "emotion": "calm", "text": "ম্যাডাম, এপে দৈনিক সুত বঢ়ায় আৰু সকলোকে ভাবুকি দিয়ে।"}, {"id": 92, "duration_s": 3.56, "emotion": "serious", "text": "মই কওঁ? এপক কণ্টেক্ট-ফটো কভু নিদিব।"}, {"id": 93, "duration_s": 6.16, "emotion": "serious", "text": "ধাৰ খালি বেংক বা আৰবিআইৰ পৰা।"}, {"id": 94, "duration_s": 2.37, "emotion": "guilty", "text": "আৰু মোৰ এপ... পঞ্জীভুক্ত নে?"}, {"id": 95, "duration_s": 2.91, "emotion": "proud", "text": "ভাবুকিত ঊনৈশ তিৰিশত ফোন বা অভিযোগ।"}, {"id": 96, "duration_s": 2.922, "emotion": "calm", "text": "চাইবাৰ ক্ৰাইম হেল্পলাইন। কওক, কি হলাক?"}, {"id": 97, "duration_s": 3.54, "emotion": "serious", "text": "লোন এপে ভাবুকি দিছে। স্ক্ৰীণশ্বট সকলো আমাৰ ওচৰত।"}, {"id": 98, "duration_s": 3.36, "emotion": "calm", "text": "ভাল কৰিলাক। নথিভুক্ত হলাক, নম্বৰ মেচেজত আহিবে।"}, {"id": 99, "duration_s": 2.11, "emotion": "worried", "text": "আৰু... কোনো ফী?"}, {"id": 100, "duration_s": 0.72, "emotion": "calm", "text": "কোনো ফী নাই।"}, {"id": 101, "duration_s": 3.28, "emotion": "happy", "text": "দোকানৰ বাবে সঠিক লোন, সঠিক কাগজৰ সৈতে।"}, {"id": 102, "duration_s": 3.87, "emotion": "happy", "text": "ম্যাডাম, আপোনাৰ পৰামৰ্শ... এক টকাও কম নহয়!"}, {"id": 103, "duration_s": 2.56, "emotion": "calm", "text": "সন্ধিয়া ধনৰামে সত্যনাৰায়ণ পূজা পাতিলে।"}, {"id": 104, "duration_s": 2.59, "emotion": "pleading", "text": "হে ভগৱান, আজি কোনো ফোন নাবাজক।"}, {"id": 105, "duration_s": 2.78, "emotion": "serious", "text": "পূজাৰ প্ৰথম অধ্যায়... মন দি শুনক।"}, {"id": 106, "duration_s": 3.12, "emotion": "scared_whisper", "text": "আহি গ'ল... উসুলকাৰী!"}, {"id": 107, "duration_s": 3.61, "emotion": "excited", "text": "প্লেন মনত? তিনি... দুই... এক!"}, {"id": 108, "duration_s": 1.58, "emotion": "calm", "text": "ধনৰামে পূজা কৰি আছে!"}, {"id": 109, "duration_s": 1.84, "emotion": "angry", "text": "পূজা? টকা কেতিয়া দিবে?!"}, {"id": 110, "duration_s": 4.22, "emotion": "proud", "text": "অভিযোগ হ'ল ঊনৈশ তিৰিশত। চুবুৰী সাক্ষী!"}, {"id": 111, "duration_s": 2.32, "emotion": "proud", "text": "আৰু মই... কাকো নেডৰাঁ!"}, {"id": 112, "duration_s": 2.88, "emotion": "sarcastic", "text": "ভাবুকিক নেডৰিলে... টিকটিকিক ডৰালে।"}, {"id": 113, "duration_s": 2.82, "emotion": "mischievous", "text": "বোপা, তোমাৰ নাম কি? কাইলৈ চুবুৰীয়ে জানিব।"}, {"id": 114, "duration_s": 2.35, "emotion": "serious", "text": "সকলো ফোনত নজৰ লাগিছে!"}, {"id": 115, "duration_s": 3.21, "emotion": "excited", "text": "প্ৰসাদ? ...তদন্ত হ'ব!"}, {"id": 116, "duration_s": 2.54, "emotion": "guilty", "text": "ভোক লাগিছে! ভগৱানে ক্ষমা কৰিব।"}, {"id": 117, "duration_s": 3.17, "emotion": "excited", "text": "লাইভ চলিছে! পৃথিৱীৰ প্ৰথম এণ্টি-লোন আৰতি!"}, {"id": 118, "duration_s": 0.44, "emotion": "shouting", "text": "চুপ!"}, {"id": 119, "duration_s": 3.26, "emotion": "calm", "text": "তেন্তে... পূজাৰ প্ৰথম অধ্যায়।"}, {"id": 120, "duration_s": 1.88, "emotion": "loving", "text": "ধনৰাম, আপুনি অকলে নহয়।"}, {"id": 121, "duration_s": 3.42, "emotion": "tender", "text": "গোটেই চুবুৰী... আৰু কোনো ফী নাই।"}, {"id": 122, "duration_s": 15.89, "emotion": "calm", "text": "পিছদিনা পুৱা... চুবুৰীত এটাও ফোন নাবাজিল।"}, {"id": 123, "duration_s": 5.07, "emotion": "proud", "text": "তদন্ত হৈ গ'ল! চাইবাৰ চেলে অভিযোগ নথিভুক্ত কৰিলে।"}, {"id": 124, "duration_s": 3.38, "emotion": "serious", "text": "এপৰ ৰিপৰ্ট হ'ল। ভাবুকিৰ ফোন বন্ধ।"}, {"id": 125, "duration_s": 31.99, "emotion": "excited", "text": "তেন্তে... ত্ৰিশ হাজাৰ নিদিওঁ?"}, {"id": 126, "duration_s": 5.11, "emotion": "serious", "text": "ভাবুকিৰ সুত নাই। যিমান পালা, সিমানেই ঘূৰাওঁ।"}, {"id": 127, "duration_s": 3.55, "emotion": "sad", "text": "তেৰ হাজাৰ... সম্পূৰ্ণ। এক টকাও কম নহয়..."}, {"id": 128, "duration_s": 4.1, "emotion": "determined", "text": "কণ্টেক্ট মোৰ, ফটো মোৰ। কোনো এপৰ নহয়!"}, {"id": 129, "duration_s": 2.94, "emotion": "proud", "text": "বিজ্ঞানে কয়, এপ ডিলিট হ'লে লোনো ডিলিট!"}, {"id": 130, "duration_s": 5.03, "emotion": "serious", "text": "মই কওঁ? আচল ধাৰ ঘূৰাব লাগিব। ভাবুকি সহিব নালাগে।"}, {"id": 131, "duration_s": 4.37, "emotion": "proud", "text": "আৰু দোকান বাঢ়িব... বেংকৰ পৰা, সঠিক কাগজেৰে!"}, {"id": 132, "duration_s": 4.94, "emotion": "guilty", "text": "কোকা, দুমিনিটৰ লোনে... দুদিন কন্দুৱালে।"}, {"id": 133, "duration_s": 3.18, "emotion": "calm", "text": "সোনকালৰ ধন... বহুত কন্দুৱায়।"}, {"id": 134, "duration_s": 5.53, "emotion": "serious", "text": "ধাৰ খালি বেংক বা আৰবিআই-পঞ্জীভুক্ত ঠাইৰ পৰা। চৰ্ত পঢ়ি।"}, {"id": 135, "duration_s": 1.92, "emotion": "stern_warning", "text": "কণ্টেক্ট-ফটো নিদিবা। ভাবুকিত ঊনৈশ তিৰিশ।"}, {"id": 136, "duration_s": 5.34, "emotion": "happy", "text": "আৰু 'সময়েই ধন' নহয়... 'পঢ়াই ধন'!"}, {"id": 137, "duration_s": 6.05, "emotion": "happy", "text": "এটা আখৰো কম নহয়... সম্পূৰ্ণ পঢ়িম!"}, {"id": 138, "duration_s": 1.46, "emotion": "excited", "text": "দুমিনিটত লোন!"}, {"id": 139, "duration_s": 2.52, "emotion": "happy", "text": "চুবুৰীৰ সাধু... আকৌ লগ পাম!"}]