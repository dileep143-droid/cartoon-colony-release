[{"id": 1, "duration_s": 4.26, "emotion": "mischievous", "text": "રાતના બે વાગ્યા... આખી સોસાયટી ઊંઘતી હતી."}, {"id": 2, "duration_s": 0.86, "emotion": "mischievous", "text": "એક સિવાય."}, {"id": 3, "duration_s": 1.02, "emotion": "angry", "text": "મારા કાનમાં એરપોર્ટ?"}, {"id": 4, "duration_s": 1.81, "emotion": "proud", "text": "હું કોઈથી ના ડરું!"}, {"id": 5, "duration_s": 3.64, "emotion": "giggly", "text": "દસ તાળી... વીસ તાળી... ત્રીસ તાળી..."}, {"id": 6, "duration_s": 2.5, "emotion": "sarcastic", "text": "તાળી કેમ? જાન આવી છે?"}, {"id": 7, "duration_s": 2.55, "emotion": "scared_whisper", "text": "ચાલીસમી... અને છેલ્લી."}, {"id": 8, "duration_s": 6.62, "emotion": "giggly", "text": "ચાલીસ તાળી. મચ્છર: ઝીરો. જયેશ: ગાલ લાલ!"}, {"id": 9, "duration_s": 3.06, "emotion": "determined", "text": "ખસો! મારી ચંપલ કદી ના ચૂકે!"}, {"id": 10, "duration_s": 2.76, "emotion": "embarrassed", "text": "ચૂકી નથી... સીધી મને વાગી!"}, {"id": 11, "duration_s": 2.57, "emotion": "proud", "text": "જોયું? નિશાન પાક્કું."}, {"id": 12, "duration_s": 2.75, "emotion": "mischievous", "text": "અને આ તો... બસ શરૂઆત હતી."}, {"id": 13, "duration_s": 4.91, "emotion": "giggly", "text": "સવાર સુધીમાં... આખી સોસાયટી ખંજવાળતી હતી."}, {"id": 14, "duration_s": 3.17, "emotion": "excited", "text": "સાંભળ્યું કે? રાત્રે મચ્છરોની સેના આવી હતી!"}, {"id": 15, "duration_s": 2.73, "emotion": "mischievous", "text": "અને જયેશભાઈએ પોતાને ચાલીસ તમાચા માર્યા!"}, {"id": 16, "duration_s": 3.22, "emotion": "embarrassed", "text": "એ મચ્છર નહોતો... હાથી હતો!"}, {"id": 17, "duration_s": 3.07, "emotion": "sarcastic", "text": "હાથી નહીં, મમ્મીની ચંપલ હતી."}, {"id": 18, "duration_s": 2.98, "emotion": "serious", "text": "નજર લાગી ગઈ! મચ્છરોની નજર!"}, {"id": 19, "duration_s": 2.17, "emotion": "shocked", "text": "હાય! મરચું પણ ખાધું!"}, {"id": 20, "duration_s": 3.35, "emotion": "stern_warning", "text": "સમોસા? ઊભા! તપાસ થશે!"}, {"id": 21, "duration_s": 3.23, "emotion": "happy", "text": "તપાસ પૂરી. ભૂખ લાગી!"}, {"id": 22, "duration_s": 4.8, "emotion": "proud", "text": "સાયન્સ કહે છે, મચ્છર ફક્ત ગંદી ગટરમાં જ થાય!"}, {"id": 23, "duration_s": 0.63, "emotion": "curious", "text": "હું કહું?"}, {"id": 24, "duration_s": 2.04, "emotion": "proud", "text": "બકા ચૂપ! સાયન્સ બોલે છે."}, {"id": 25, "duration_s": 3.41, "emotion": "proud", "text": "આપણી સોસાયટી ચોખ્ખી, મચ્છર બહારથી આવે!"}, {"id": 26, "duration_s": 5.33, "emotion": "excited", "text": "મચ્છર-પ્રૂફ અગરબત્તી! એક સળગાવો, મચ્છર ગાયબ!"}, {"id": 27, "duration_s": 2.67, "emotion": "determined", "text": "ચાલીસ આપો! એક તાળીના બદલે એક."}, {"id": 28, "duration_s": 2.46, "emotion": "stern_warning", "text": "દસની એક. એક રૂપિયો ઓછો નહીં!"}, {"id": 29, "duration_s": 4.07, "emotion": "angry", "text": "ચીમન શેઠ! આ તો ગયા વર્ષની પૂજાવાળી છે!"}, {"id": 30, "duration_s": 3.16, "emotion": "embarrassed", "text": "જૂની પૂજા... નવો મચ્છર."}, {"id": 31, "duration_s": 3.44, "emotion": "giggly", "text": "સાંજે સોસાયટીમાં વાદળ આવ્યાં. મચ્છર ના ગયા."}, {"id": 32, "duration_s": 5.667, "emotion": "excited", "text": "લાઈવ ચાલે છે! સોસાયટીમાં વાદળ આવ્યાં!"}, {"id": 33, "duration_s": 1.27, "emotion": "determined", "text": "શેઠ, હલતા નહીં."}, {"id": 34, "duration_s": 1.42, "emotion": "tired", "text": "ધુમાડો ગયો... મચ્છર ના ગયો."}, {"id": 35, "duration_s": 2.36, "emotion": "serious", "text": "બે દિવસ પછી. શેઠના ઘરે."}, {"id": 36, "duration_s": 2.23, "emotion": "loving", "text": "ઊઠ બેટા. તારા ફેવરિટ લાડુ."}, {"id": 37, "duration_s": 2.41, "emotion": "shocked", "text": "ઢોકળુએ... લાડુને ના પાડી?!"}, {"id": 38, "duration_s": 3.26, "emotion": "tired", "text": "મમ્મી... ભૂખ... નથી લાગી."}, {"id": 39, "duration_s": 5.65, "emotion": "worried", "text": "તાવ છે! શેઠ, ડૉક્ટર!"}, {"id": 40, "duration_s": 1.51, "emotion": "worried", "text": "ફી... કંઈ વાંધો નહીં! કંઈ વાંધો નહીં!"}, {"id": 41, "duration_s": 2.03, "emotion": "calm", "text": "તાવ સે તો સવારે ક્લિનિકે લઈ આવજો."}, {"id": 42, "duration_s": 2.63, "emotion": "serious", "text": "ડેંગ્યુની તપાસ જરૂરી સે. ગભરાતા નંઈ."}, {"id": 43, "duration_s": 2.27, "emotion": "serious", "text": "અને ઘરની આજુબાજુ ભરાઈ રિયેલું પાણી?"}, {"id": 44, "duration_s": 1.99, "emotion": "proud", "text": "અમારું ઘર ચોખ્ખું છે!"}, {"id": 45, "duration_s": 3.04, "emotion": "serious", "text": "ડેંગ્યુનો મચ્છર ચોખ્ખા, ભરાયેલા પાણીમાં જ ઉછરે સે."}, {"id": 46, "duration_s": 1.74, "emotion": "happy", "text": "ચાલો, નીકળીએ!"}, {"id": 47, "duration_s": 1.25, "emotion": "giggly", "text": "...અને પહોંચી પણ ગયા."}, {"id": 48, "duration_s": 2.82, "emotion": "relieved", "text": "ડેંગ્યુ નથી નીકળ્યો. હળવો તાવ છે."}, {"id": 49, "duration_s": 1.58, "emotion": "pleading", "text": "તો... લાડુ?"}, {"id": 50, "duration_s": 2.67, "emotion": "stern_warning", "text": "સાજા થયા પછી. ફક્ત એક."}, {"id": 51, "duration_s": 0.55, "emotion": "shocked", "text": "એક?!"}, {"id": 52, "duration_s": 2.62, "emotion": "excited", "text": "એક આઇડિયા છે! આપણે બનીશું..."}, {"id": 53, "duration_s": 2.29, "emotion": "excited", "text": "...મચ્છર જાસૂસ!"}, {"id": 54, "duration_s": 1.99, "emotion": "proud", "text": "હું કહું? આ વખતે સાચ્ચે?"}, {"id": 55, "duration_s": 1.67, "emotion": "stern_warning", "text": "બોલ! જલદી!"}, {"id": 56, "duration_s": 3.47, "emotion": "serious", "text": "ડેંગ્યુનો મચ્છર મોટા ભાગે દિવસે કરડે છે."}, {"id": 57, "duration_s": 3.7, "emotion": "serious", "text": "ગંદી ગટરમાં નહીં, ચોખ્ખા ભરાયેલા પાણીમાં ઈંડાં મૂકે."}, {"id": 58, "duration_s": 2.27, "emotion": "shocked", "text": "મતલબ હર્ષભાઈનું સાયન્સ ઊંધું!"}, {"id": 59, "duration_s": 3.4, "emotion": "serious", "text": "પાણીમાં નાના નાના કીડા દેખાય, તો એ લાર્વા."}, {"id": 60, "duration_s": 2.71, "emotion": "serious", "text": "અઠવાડિયે લાર્વાથી મચ્છર!"}, {"id": 61, "duration_s": 3.55, "emotion": "determined", "text": "જાસૂસો! મારો બદલો લેજો!"}, {"id": 62, "duration_s": 3.4, "emotion": "determined", "text": "દરેક વાસણ! દરેક કૂંડું! દરેક ટાયર!"}, {"id": 63, "duration_s": 2.76, "emotion": "proud", "text": "જાસૂસી? મોટા લોકો સંભાળશે!"}, {"id": 64, "duration_s": 0.59, "emotion": "angry", "text": "ચૂપ!"}, {"id": 65, "duration_s": 3.62, "emotion": "excited", "text": "અને શરૂ થઈ... મચ્છર જાસૂસી!"}, {"id": 66, "duration_s": 2.54, "emotion": "excited", "text": "મળી ગયો! કૂલરમાં લાર્વા!"}, {"id": 67, "duration_s": 3.59, "emotion": "proud", "text": "મારું કૂલર? આ તો બસ... ભાડૂઆત છે."}, {"id": 68, "duration_s": 1.91, "emotion": "scared_whisper", "text": "હું... કોઈથી... ના ડરું."}, {"id": 69, "duration_s": 2.2, "emotion": "panicked", "text": "હેતલ! આ ભાડું માગે છે!"}, {"id": 70, "duration_s": 2.41, "emotion": "stern_warning", "text": "કાંતા બા, કૂંડાની રકાબીમાં પણ!"}, {"id": 71, "duration_s": 2.24, "emotion": "proud", "text": "મારા કૂંડાની તો રોજ પૂજા થાય છે!"}, {"id": 72, "duration_s": 2.79, "emotion": "sarcastic", "text": "પૂજા, પાણી... મચ્છર પણ."}, {"id": 73, "duration_s": 1.96, "emotion": "determined", "text": "બસ! હવે હું જોઉં છું."}, {"id": 74, "duration_s": 5.07, "emotion": "proud", "text": "દર અઠવાડિયે ખાલી કરો, સૂકવો. દસ સેકન્ડ."}, {"id": 75, "duration_s": 1.75, "emotion": "embarrassed", "text": "હું પણ... મદદ કરતો હતો."}, {"id": 76, "duration_s": 3.89, "emotion": "mischievous", "text": "અને અગાસી પર... લાલોનો બિઝનેસ."}, {"id": 77, "duration_s": 0.88, "emotion": "excited", "text": "ટેન્શન ના લો!"}, {"id": 78, "duration_s": 4.96, "emotion": "proud", "text": "આ છે મારો ટાયર બિઝનેસ! વીસ ટાયર, આવતા વર્ષે વીસ લાખ!"}, {"id": 79, "duration_s": 3.77, "emotion": "serious", "text": "એક ટાયરમાં... સોથી વધુ લાર્વા."}, {"id": 80, "duration_s": 1.31, "emotion": "shocked", "text": "અને વીસ ટાયરમાં?"}, {"id": 81, "duration_s": 2.05, "emotion": "shocked", "text": "આખી મચ્છર-સોસાયટી!"}, {"id": 82, "duration_s": 0.99, "emotion": "mischievous", "text": "તો ભાડું લઉં?"}, {"id": 83, "duration_s": 4.63, "emotion": "proud", "text": "મારા અથાણાને તડકો! ઓછામાં ઓછું હું..."}, {"id": 84, "duration_s": 1.97, "emotion": "mischievous", "text": "કાંતા બા... તમારા ઢાંકણમાં પણ."}, {"id": 85, "duration_s": 3.075, "emotion": "shocked", "text": "અરે બાપ રે! આખી સોસાયટી જોશે!"}, {"id": 86, "duration_s": 2.41, "emotion": "angry", "text": "આ બધું તારા ટાયરોને લીધે!"}, {"id": 87, "duration_s": 1.669, "emotion": "panicked", "text": "જારેય!"}, {"id": 88, "duration_s": 1.04, "emotion": "embarrassed", "text": "નિશાન... ફરી પાક્કું."}, {"id": 89, "duration_s": 3.66, "emotion": "determined", "text": "ટાયર ઊંધાં, પાણી બહાર, બિઝનેસ અંદર!"}, {"id": 90, "duration_s": 3.31, "emotion": "excited", "text": "સાંભળ્યું? જયેશભાઈના ધાબે વીસ લાખ!"}, {"id": 91, "duration_s": 2.97, "emotion": "panicked", "text": "વીસ લાખ... મચ્છર! ડેંગ્યુ આવી ગયો!"}, {"id": 92, "duration_s": 3.279, "emotion": "serious", "text": "નજર લાગી ગઈ! દરેક બારણે લીંબુ!"}, {"id": 93, "duration_s": 3.53, "emotion": "mischievous", "text": "મચ્છરદાની! આજનો ભાવ ડબલ!"}, {"id": 94, "duration_s": 5.57, "emotion": "giggly", "text": "અને પછી... સોસાયટીમાં ભૂતોની જાન નીકળી."}, {"id": 95, "duration_s": 4.55, "emotion": "shouting", "text": "દરેક મચ્છરની તપાસ થશે!"}, {"id": 96, "duration_s": 0.53, "emotion": "angry", "text": "ચૂપ!"}, {"id": 97, "duration_s": 4.4, "emotion": "serious", "text": "ધુમાડા, લીંબુ નહીં. ભરેલું પાણી ફેંકો!"}, {"id": 98, "duration_s": 0.94, "emotion": "excited", "text": "એક આઇડિયા છે!"}, {"id": 99, "duration_s": 2.62, "emotion": "excited", "text": "સફાઈ રેસ! જે સૌથી વધુ પાણી શોધે!"}, {"id": 100, "duration_s": 2.62, "emotion": "determined", "text": "રેસ? જયેશ કદી ના હારે!"}, {"id": 101, "duration_s": 3.6, "emotion": "excited", "text": "સોસાયટીની પહેલી... સફાઈ રેસ!"}, {"id": 102, "duration_s": 3.01, "emotion": "serious", "text": "નિયમ સાંભળો! જેને સૌથી વધુ..."}, {"id": 103, "duration_s": 1.59, "emotion": "serious", "text": "લાર્વા, ગુરુજી! લાર્વા!"}, {"id": 104, "duration_s": 1.9, "emotion": "shocked", "text": "લવર? આ સોસાયટીમાં?"}, {"id": 105, "duration_s": 3.06, "emotion": "scared_whisper", "text": "કોના? ક્યાં? આ ઉંમરે?"}, {"id": 106, "duration_s": 1.94, "emotion": "sarcastic", "text": "મચ્છરનાં બચ્ચાં, ગુરુજી!"}, {"id": 107, "duration_s": 2.91, "emotion": "embarrassed", "text": "અચ્છા... તો વાંધો નહીં. શરૂ!"}, {"id": 108, "duration_s": 2.62, "emotion": "tired", "text": "પૂરી બાંય... પૂરો પરસેવો!"}, {"id": 109, "duration_s": 2.41, "emotion": "giggly", "text": "પણ મચ્છર લપસી ગયો!"}, {"id": 110, "duration_s": 2.21, "emotion": "determined", "text": "બા, તમારી વાટકી પણ!"}, {"id": 111, "duration_s": 2.59, "emotion": "embarrassed", "text": "નજર... પાણીને લાગી હતી."}, {"id": 112, "duration_s": 2.27, "emotion": "happy", "text": "અરે, છત પર પણ તળાવ!"}, {"id": 113, "duration_s": 3.98, "emotion": "shouting", "text": "વરસાદ? સમોસા? તપાસ થશે!"}, {"id": 114, "duration_s": 2.57, "emotion": "mischievous", "text": "ચીમન શેઠ, મફતના ભાડૂઆત!"}, {"id": 115, "duration_s": 3.33, "emotion": "sad", "text": "મારી દુકાનમાં મફતમાં કોઈ ના રહે!"}, {"id": 116, "duration_s": 2.23, "emotion": "proud", "text": "સાયન્સ કહે છે... આ નહીં હલે."}, {"id": 117, "duration_s": 2.736, "emotion": "calm", "text": "ખસો."}, {"id": 118, "duration_s": 2.4, "emotion": "embarrassed", "text": "સાયન્સ કહે છે... બાળકોનું સાંભળો."}, {"id": 119, "duration_s": 2.51, "emotion": "excited", "text": "લાઈવ ચાલે છે! હેશટેગ મચ્છર-મુક્ત!"}, {"id": 120, "duration_s": 3.15, "emotion": "proud", "text": "કલાકમાં સોસાયટીમાં એક ટીપું પાણી નહીં."}, {"id": 121, "duration_s": 3.19, "emotion": "excited", "text": "દસ હજાર વ્યુ! સોસાયટી વાયરલ!"}, {"id": 122, "duration_s": 2.13, "emotion": "excited", "text": "સાંભળ્યું કે? આ વખતે સારા સમાચાર!"}, {"id": 123, "duration_s": 3.79, "emotion": "proud", "text": "અને રીલમાં સૌથી આગળ હું! આખી સોસાયટી જોશે!"}, {"id": 124, "duration_s": 4.4, "emotion": "proud", "text": "ડેંગ્યુ-મુક્ત સોસાયટી. અને લવર-મુક્ત પણ."}, {"id": 125, "duration_s": 2.34, "emotion": "sarcastic", "text": "લાર્વા, ગુરુજી... લાર્વા."}, {"id": 126, "duration_s": 3.7, "emotion": "happy", "text": "સોસાયટી મચ્છરથી જીતી... પાણી સાથે લડીને."}, {"id": 127, "duration_s": 2.64, "emotion": "stern_warning", "text": "ડૉક્ટરે કહ્યું હતું. ફક્ત એક."}, {"id": 128, "duration_s": 2.72, "emotion": "loving", "text": "એક જ છે... તો ધીમે ધીમે ખાઈશ."}, {"id": 129, "duration_s": 1.88, "emotion": "tired", "text": "ઢોકળુ, વીસ મિનિટ થઈ ગઈ!"}, {"id": 130, "duration_s": 4.83, "emotion": "happy", "text": "સારું થઈ ગયું! અને હવે... ભૂખ લાગી છે!"}, {"id": 131, "duration_s": 1.95, "emotion": "proud", "text": "મેં કહ્યું હતું ને, હું કોઈથી ના ડરું."}, {"id": 132, "duration_s": 0.6, "emotion": "mischievous", "text": "ભણ..."}, {"id": 133, "duration_s": 1.65, "emotion": "calm", "text": "સાંભળો, જાસૂસો."}, {"id": 134, "duration_s": 3.6, "emotion": "serious", "text": "મચ્છર સામે લડવું છે... તો પાણી સામે લડો."}, {"id": 135, "duration_s": 3.95, "emotion": "serious", "text": "અઠવાડિયે એકવાર, વાસણ ખાલી, ટાંકી ઢાંકી."}, {"id": 136, "duration_s": 4.43, "emotion": "loving", "text": "પૂરી બાંયના કપડાં. અને તાવ આવે, તો સીધા ડૉક્ટર."}, {"id": 137, "duration_s": 1.12, "emotion": "excited", "text": "કેસ બંધ!"}, {"id": 138, "duration_s": 3.34, "emotion": "mischievous", "text": "સોસાયટી સુધરી ગઈ... પણ જયેશની તાળી?"}, {"id": 139, "duration_s": 1.23, "emotion": "scared_whisper", "text": "એકતાળીસમી..."}]