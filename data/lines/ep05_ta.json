[{"id": 1, "duration_s": 3.71, "emotion": "excited", "text": "காலனியின் பெரிய மோதல்... கயிறு இழுக்கும் போட்டி!"}, {"id": 2, "duration_s": 3.89, "emotion": "proud", "text": "ஏழு நாள் பவுடர்! நான் யாருக்கும் பயப்பட மாட்டேன்!"}, {"id": 3, "duration_s": 2.21, "emotion": "calm", "text": "கந்தசாமி, டீ சூடா வைங்க."}, {"id": 4, "duration_s": 1.8, "emotion": "excited", "text": "லைவ்-ல இருக்கோம்! ஸ்லோ மோஷன்ல!"}, {"id": 5, "duration_s": 3.27, "emotion": "mischievous", "text": "இதெல்லாம் தொடங்கினது... ஒரு டப்பாவிலே."}, {"id": 6, "duration_s": 3.29, "emotion": "happy", "text": "ஏழு நாள் முன்னாடி. காலனி விளையாட்டு வாரம்."}, {"id": 7, "duration_s": 5.0, "emotion": "excited", "text": "இந்த ஞாயிறு கயிறு இழுத்தல்! முருகேசன் குடும்பம் எதிர் கந்தசாமி குடும்பம்!"}, {"id": 8, "duration_s": 3.1, "emotion": "proud", "text": "நாங்க ஜெயிப்போம்! நான் யாருக்கும் பயப்பட மாட்டேன்!"}, {"id": 9, "duration_s": 4.8, "emotion": "sarcastic", "text": "கணக்கு போட்டேன்! முருகேசன் ஜெயிக்க சான்ஸ்... பூஜ்யம்!"}, {"id": 10, "duration_s": 3.06, "emotion": "sarcastic", "text": "யாருக்கும் பயமில்லையா, முருகேசன்?"}, {"id": 11, "duration_s": 2.48, "emotion": "comic_panic", "text": "பயமே இல்ல! பல்லி... பல்லின்னு ஒண்ணே இல்ல!"}, {"id": 12, "duration_s": 2.15, "emotion": "stern_warning", "text": "உஷ்! அங்கிள் திரும்ப குதிச்சிடுவாரு!"}, {"id": 13, "duration_s": 1.76, "emotion": "happy", "text": "போலாம் ரைட்!"}, {"id": 14, "duration_s": 1.66, "emotion": "calm", "text": "ஒதுங்குங்க அண்ணே, நான் பாக்கறேன்."}, {"id": 15, "duration_s": 2.25, "emotion": "shocked", "text": "அண்ணி, டிராக்டரையே இழுப்பீங்களே!"}, {"id": 16, "duration_s": 1.26, "emotion": "excited", "text": "டென்ஷன் வேணாம் அண்ணே!"}, {"id": 17, "duration_s": 3.02, "emotion": "worried", "text": "டென்ஷனா? அவ ஆட்டோவையே இழுத்துட்டா, சேகர்!"}, {"id": 18, "duration_s": 3.38, "emotion": "proud", "text": "என் புள்ள ஜெயிப்பான்! காலனியே பாக்கப் போகுது!"}, {"id": 19, "duration_s": 3.25, "emotion": "mischievous", "text": "கேட்டியா? முருகேசன் பல்லிகிட்ட தோத்துட்டாராம்!"}, {"id": 20, "duration_s": 4.1, "emotion": "sad", "text": "சிப்ஸ் எங்க? வட போச்சே... பசிக்குதே!"}, {"id": 21, "duration_s": 3.78, "emotion": "excited", "text": "சுல்தான் பவர் பவுடர்! ஏலே, ஏழு நாள்ல பாடி!"}, {"id": 22, "duration_s": 3.25, "emotion": "excited", "text": "தொள்ளாயிரத்து தொண்ணூத்தொம்பது! எக்ஸ்பிரஸ் டெலிவரி!"}, {"id": 23, "duration_s": 1.96, "emotion": "excited", "text": "ஒரு ஐடியா இருக்கு! அப்பாவுக்காக!"}, {"id": 24, "duration_s": 3.92, "emotion": "excited", "text": "அப்பா! ஏழு நாள்ல பாடி! ஞாயிறும் ஏழு நாள்ல வருது!"}, {"id": 25, "duration_s": 4.02, "emotion": "excited", "text": "சுல்தான்... பாடி... ஏழு நாள்!"}, {"id": 26, "duration_s": 3.4, "emotion": "sarcastic", "text": "ஏழு நாள்ல ஊறுகா கூட ஊறாது!"}, {"id": 27, "duration_s": 2.93, "emotion": "proud", "text": "இது சயின்ஸ், செல்வி! ஆர்டர்!"}, {"id": 28, "duration_s": 3.58, "emotion": "proud", "text": "என் பிள்ளை சுல்தான் ஆவான்! காலனியே பாக்கப் போகுது!"}, {"id": 29, "duration_s": 2.89, "emotion": "curious", "text": "பவுடர் இனிப்பா இருக்குமா? எனக்கும் வேணும்."}, {"id": 30, "duration_s": 2.55, "emotion": "excited", "text": "சுல்தான் பவுடர்! எக்ஸ்பிரஸ் டெலிவரி, வாங்கோ!"}, {"id": 31, "duration_s": 1.62, "emotion": "loving", "text": "வந்துட்டான் என் சுல்தான்!"}, {"id": 32, "duration_s": 2.46, "emotion": "mischievous", "text": "கேட்டியா? முருகேசன் டப்பால பாடி வாங்கினாராம்!"}, {"id": 33, "duration_s": 2.42, "emotion": "determined", "text": "ஆஹா! பலம் வருதே!"}, {"id": 34, "duration_s": 1.67, "emotion": "curious", "text": "அப்பா... மசில் எங்க போச்சு?"}, {"id": 35, "duration_s": 2.27, "emotion": "excited", "text": "வந்துடுச்சு! ஒரு முடி நிமிர்ந்துடுச்சு!"}, {"id": 36, "duration_s": 2.84, "emotion": "shocked", "text": "கேட்டியா? முருகேசன் பட்டன் மழை பொழியுது!"}, {"id": 37, "duration_s": 2.07, "emotion": "embarrassed", "text": "பாடி வளருது, மாமி!"}, {"id": 38, "duration_s": 1.15, "emotion": "shocked", "text": "அரை இன்ச்..."}, {"id": 39, "duration_s": 0.55, "emotion": "shocked", "text": "...கம்மி!"}, {"id": 40, "duration_s": 1.74, "emotion": "proud", "text": "உள்ளுக்குள்ள வளருது!"}, {"id": 41, "duration_s": 2.48, "emotion": "happy", "text": "மோந்தாலே பலம் வரும்!"}, {"id": 42, "duration_s": 2.15, "emotion": "worried", "text": "முருகேசன், மூக்குல இழுக்காதீங்க!"}, {"id": 43, "duration_s": 1.39, "emotion": "comic_panic", "text": "ஆ... ஆ... ஆ..."}, {"id": 44, "duration_s": 2.5, "emotion": "proud", "text": "பாத்தியா? பவுடர் வெளில கூட வேலை செய்யும்!"}, {"id": 45, "duration_s": 1.46, "emotion": "determined", "text": "போதும்! நான் பாத்துக்கறேன்."}, {"id": 46, "duration_s": 3.32, "emotion": "shocked", "text": "ஐயோ! என் சுல்தான் பனிச்சிலை ஆயிட்டானே!"}, {"id": 47, "duration_s": 1.51, "emotion": "serious", "text": "நில்லுங்க! சயின்ஸ் சொல்லுது..."}, {"id": 48, "duration_s": 2.6, "emotion": "proud", "text": "இது நூறு சதவீதம் சாக்பீஸ்!"}, {"id": 49, "duration_s": 3.97, "emotion": "laughing", "text": "<laugh> அறிவு சயின்ஸா? அப்ப கண்டிப்பா தப்பு!"}, {"id": 50, "duration_s": 2.46, "emotion": "giggly", "text": "அறிவு சொன்னான், மேகம் சிலிண்டர்ல இருந்து வருதாம்!"}, {"id": 51, "duration_s": 1.93, "emotion": "giggly", "text": "அப்புறம், கோழி பால் கொடுக்குமாம்!"}, {"id": 52, "duration_s": 1.5, "emotion": "laughing", "text": "அப்புறம் நிலாவுல டீக்கடை இருக்காம்!"}, {"id": 53, "duration_s": 1.58, "emotion": "pleading", "text": "இந்த தடவை நிஜமா!"}, {"id": 54, "duration_s": 2.58, "emotion": "serious", "text": "சுல்தானுக்கு கண்ணு படக்கூடாது!"}, {"id": 55, "duration_s": 1.77, "emotion": "proud", "text": "ஞாயிறு சுல்தான் தெரிவான்!"}, {"id": 56, "duration_s": 3.96, "emotion": "sad", "text": "பாருங்க... எழுதவும் செய்யுது. யாருமே பாக்கல."}, {"id": 57, "duration_s": 2.43, "emotion": "excited", "text": "டென்ஷன் வேணாம்! இது தங்கச் சுரங்கம்!"}, {"id": 58, "duration_s": 1.69, "emotion": "mischievous", "text": "நூறு போடு, இருநூறு!"}, {"id": 59, "duration_s": 2.61, "emotion": "mischievous", "text": "கந்தசாமி அண்ணே, டீலர்ஷிப்! ஐம்பது டப்பா!"}, {"id": 60, "duration_s": 2.02, "emotion": "curious", "text": "ஐம்பது சுல்தானா? கணக்கு போடறேன்."}, {"id": 61, "duration_s": 3.65, "emotion": "serious", "text": "ஐயாயிரம். ரெண்டு தடவ எண்ணினேன்... மூணாவதும்."}, {"id": 62, "duration_s": 1.62, "emotion": "pleading", "text": "ஒரு ரூபா கூட கம்மி இல்ல!"}, {"id": 63, "duration_s": 0.76, "emotion": "stern_warning", "text": "கந்தசாமி!"}, {"id": 64, "duration_s": 3.23, "emotion": "embarrassed", "text": "ராஜாத்தி, இது பிசினஸ்! டபுள் லாபம்!"}, {"id": 65, "duration_s": 1.69, "emotion": "sarcastic", "text": "இல்ல, டபுள் நஷ்டமா?"}, {"id": 66, "duration_s": 3.03, "emotion": "proud", "text": "ஐம்பது டப்பா! காலனியே சுல்தான் ஆகும்!"}, {"id": 67, "duration_s": 1.67, "emotion": "happy", "text": "நான் ஒண்ணுமே சாப்பிடல."}, {"id": 68, "duration_s": 3.49, "emotion": "surprised", "text": "இது இனிப்பு இல்ல... சாக்பீஸ்!"}, {"id": 69, "duration_s": 1.63, "emotion": "shouting", "text": "சும்மா இரு! பிசினஸ்!"}, {"id": 70, "duration_s": 3.27, "emotion": "mischievous", "text": "டிரெய்னிங் வாரம். கோச்... சேகர்."}, {"id": 71, "duration_s": 2.64, "emotion": "proud", "text": "கோச் சேகர்! நீங்க ஓடுங்க, நான் எண்ணுறேன்!"}, {"id": 72, "duration_s": 1.83, "emotion": "proud", "text": "ஓடணுமா? பவுடர் இருக்கே!"}, {"id": 73, "duration_s": 1.97, "emotion": "determined", "text": "இன்னிக்கு மரத்த புடுங்குவேன்!"}, {"id": 74, "duration_s": 3.04, "emotion": "worried", "text": "மூணு அடி! செருப்பு தேஞ்சுபோச்சுன்னா?"}, {"id": 75, "duration_s": 1.62, "emotion": "proud", "text": "இது என் டிரெய்னிங்!"}, {"id": 76, "duration_s": 1.51, "emotion": "calm", "text": "எனக்கு டிரெய்னிங் வேணாம்."}, {"id": 77, "duration_s": 2.33, "emotion": "tired", "text": "அப்பா, எந்த பவுடர்?"}, {"id": 78, "duration_s": 1.29, "emotion": "calm", "text": "சப்பாத்தி."}, {"id": 79, "duration_s": 1.191, "emotion": "stern_warning", "text": "சாப்பிடுங்க!"}, {"id": 80, "duration_s": 2.92, "emotion": "proud", "text": "சுல்தான் சப்பாத்தி திங்க மாட்டான்!"}, {"id": 81, "duration_s": 2.29, "emotion": "curious", "text": "ஆறு நாள் ஆச்சு. மசில்?"}, {"id": 82, "duration_s": 2.74, "emotion": "sarcastic", "text": "சும்மா இரு! உள்ளுக்குள்ள வளருது."}, {"id": 83, "duration_s": 1.6, "emotion": "determined", "text": "என் அப்பா சுல்தான்!"}, {"id": 84, "duration_s": 3.14, "emotion": "excited", "text": "ஞாயிற்றுக்கிழமை. காலனியின் மகா மோதல்!"}, {"id": 85, "duration_s": 2.08, "emotion": "serious", "text": "சமோசா விசாரணை!"}, {"id": 86, "duration_s": 1.94, "emotion": "excited", "text": "லைவ்-ல இருக்கோம்! மகா மோதல்!"}, {"id": 87, "duration_s": 2.42, "emotion": "proud", "text": "இன்னிக்கு சுல்தான் நாள்!"}, {"id": 88, "duration_s": 2.67, "emotion": "mischievous", "text": "ஜெயிச்சா பவுடர் விக்கும், தோத்தாலும்!"}, {"id": 89, "duration_s": 1.61, "emotion": "calm", "text": "கந்தசாமி, பின்னாடி புடிங்க."}, {"id": 90, "duration_s": 2.58, "emotion": "sarcastic", "text": "புடிச்சாச்சு. உழைப்புக்கு பில் தனி."}, {"id": 91, "duration_s": 3.52, "emotion": "excited", "text": "காலனியே பாக்கும்! முருகேசன் வாழ்க!"}, {"id": 92, "duration_s": 3.33, "emotion": "serious", "text": "கண்ணு படாது! கயிறு இப்போ புனிதம்."}, {"id": 93, "duration_s": 1.86, "emotion": "shouting", "text": "தயார்... இழுங்க!"}, {"id": 94, "duration_s": 2.04, "emotion": "determined", "text": "முழு... பலம்... போடுங்க!"}, {"id": 95, "duration_s": 2.76, "emotion": "curious", "text": "கந்தசாமி, எப்போ ஆரம்பம்?"}, {"id": 96, "duration_s": 2.16, "emotion": "comic_panic", "text": "டென்ஷன் வேணாம்... ஆ... டென்ஷன் ஆகுங்க!"}, {"id": 97, "duration_s": 2.55, "emotion": "tired", "text": "கந்தசாமி, டீ ஆறிப்போகுது."}, {"id": 98, "duration_s": 1.99, "emotion": "laughing", "text": "ஸ்லோ மோஷன்ல மறுபடியும்!"}, {"id": 99, "duration_s": 2.35, "emotion": "embarrassed", "text": "நான்... யாருக்கும் பயப்பட மாட்டேன்."}, {"id": 100, "duration_s": 2.38, "emotion": "curious", "text": "அப்பா, பவுடர் உள்ளுக்குள்ள வளர்ந்துச்சா?"}, {"id": 101, "duration_s": 2.21, "emotion": "shocked", "text": "ஆத்தி! கண்ணு பட்டுடுச்சு!"}, {"id": 102, "duration_s": 2.68, "emotion": "embarrassed", "text": "ஐயோ! காலனியே பாத்துடுச்சே!"}, {"id": 103, "duration_s": 4.24, "emotion": "excited", "text": "ஜெயிச்சாச்சு! இனி பவுடர் விலை டபுள்!"}, {"id": 104, "duration_s": 1.41, "emotion": "happy", "text": "வெற்றி இனிப்பு!"}, {"id": 105, "duration_s": 5.77, "emotion": "tired", "text": "கந்தசாமி ஜெயிச்சார்! விசாரணை... முடிஞ்சது..."}, {"id": 106, "duration_s": 2.79, "emotion": "excited", "text": "பத்து லட்சம் வியூஸ்! சுல்தான் வைரல்!"}, {"id": 107, "duration_s": 2.07, "emotion": "excited", "text": "கேட்டியா? அமெரிக்காவும் பாக்குது!"}, {"id": 108, "duration_s": 2.55, "emotion": "sad", "text": "இனி என்னை யாரும் பாக்கமாட்டாங்க."}, {"id": 109, "duration_s": 2.024, "emotion": "curious", "text": "அப்பா? உள்ளயா?"}, {"id": 110, "duration_s": 0.55, "emotion": "sad", "text": "இல்ல."}, {"id": 111, "duration_s": 1.74, "emotion": "sarcastic", "text": "சாப்பாடு வாளில போடவா?"}, {"id": 112, "duration_s": 2.96, "emotion": "determined", "text": "சப்பாத்தி வேணாம்... பவுடர்!"}, {"id": 113, "duration_s": 0.81, "emotion": "proud", "text": "நான் சொல்லவா?"}, {"id": 114, "duration_s": 4.34, "emotion": "serious", "text": "கம்பெனி முகவரி? இல்ல. லைசென்ஸ்? இல்ல."}, {"id": 115, "duration_s": 3.44, "emotion": "sarcastic", "text": "எல்லா ரிவியூவும்... ஒரே ஆளோடது!"}, {"id": 116, "duration_s": 3.29, "emotion": "angry", "text": "அப்படின்னா... எல்லாம் ஏமாத்து!"}, {"id": 117, "duration_s": 3.02, "emotion": "guilty", "text": "ஐடியா என்னோடது... அப்பாகிட்ட சொல்லணும்."}, {"id": 118, "duration_s": 3.92, "emotion": "sad", "text": "ஐம்பது டப்பா. வாடிக்கையாளர்... பூஜ்யம்."}, {"id": 119, "duration_s": 1.51, "emotion": "happy", "text": "டென்ஷன் வேணாம், கந்தசாமி!"}, {"id": 120, "duration_s": 1.64, "emotion": "angry", "text": "டென்ஷன் கொடுத்ததே நீதான்!"}, {"id": 121, "duration_s": 3.08, "emotion": "proud", "text": "பசங்க நிரூபிச்சாங்க! சயின்ஸ்: சாக்பீஸ்!"}, {"id": 122, "duration_s": 2.0, "emotion": "tired", "text": "ஆமா அறிவு, நீ சரி."}, {"id": 123, "duration_s": 2.67, "emotion": "shocked", "text": "நான்... சரியா? முதல் முறை?"}, {"id": 124, "duration_s": 3.71, "emotion": "happy", "text": "நல்ல சாக்பீஸ்! கரும்பலகைக்கு எல்லாத்தையும் எடுத்துக்கறேன்."}, {"id": 125, "duration_s": 1.12, "emotion": "pleading", "text": "எவ்வளவு?"}, {"id": 126, "duration_s": 0.89, "emotion": "loving", "text": "ஆசீர்வாதம்."}, {"id": 127, "duration_s": 1.76, "emotion": "determined", "text": "போலி விளம்பரம்... ரிப்போர்ட்! அப்புறம் பிளாக்!"}, {"id": 128, "duration_s": 2.14, "emotion": "embarrassed", "text": "ஆயிரம்-ஒண்ணு... சாக்பீசுக்கு"}, {"id": 129, "duration_s": 3.84, "emotion": "calm", "text": "முருகேசா, ஏழு நாள்ல பாடி தர்ற டப்பா..."}, {"id": 130, "duration_s": 2.64, "emotion": "sarcastic", "text": "...ஏழு நாள்ல பாக்கெட்டை காலி பண்ணும்."}, {"id": 131, "duration_s": 3.71, "emotion": "serious", "text": "பாடி டப்பால வராது, சப்பாத்தியும் ஓட்டமும் தான்!"}, {"id": 132, "duration_s": 2.57, "emotion": "determined", "text": "முகவரி, லைசென்ஸ், உண்மை ரிவியூ பாருங்க!"}, {"id": 133, "duration_s": 1.98, "emotion": "happy", "text": "சுல்தான்... சப்பாத்தி சாப்பிடுவான்!"}, {"id": 134, "duration_s": 2.38, "emotion": "tired", "text": "அப்பா... கொஞ்சம் மெதுவா!"}, {"id": 135, "duration_s": 2.42, "emotion": "happy", "text": "போலாம் ரைட்... நடந்தே!"}, {"id": 136, "duration_s": 1.09, "emotion": "happy", "text": "சீக்கிரம் வா!"}, {"id": 137, "duration_s": 2.3, "emotion": "happy", "text": "ஓட்டம் இலவசம்! சூப்பர் ஸ்கீம்!"}, {"id": 138, "duration_s": 3.31, "emotion": "excited", "text": "டென்ஷன் வேணாம்! சுல்தான் ஹேர் ஆயில்! ஏழு நாள்ல முடி!"}, {"id": 139, "duration_s": 2.41, "emotion": "embarrassed", "text": "டென்ஷன்... ஆயிடுச்சு."}, {"id": 140, "duration_s": 2.21, "emotion": "excited", "text": "அப்பா! நிஜ மசில்!"}]