[{"id": 1, "duration_s": 4.32, "emotion": "mischievous", "text": "দীপাবলির রাত। গোটা পাড়া একটাই জিনিস দেখছে..."}, {"id": 2, "duration_s": 2.24, "emotion": "excited", "text": "ভোম্বলের... সুপার বোমা!"}, {"id": 3, "duration_s": 2.15, "emotion": "proud", "text": "টেনশন নিয়ো না! চাঁদের চেয়েও জোর!"}, {"id": 4, "duration_s": 2.54, "emotion": "excited", "text": "লাইভ চলছে! দীপাবলি স্পেশাল!"}, {"id": 5, "duration_s": 1.2, "emotion": "stern_warning", "text": "চুপ! সবাই দাগের পিছনে!"}, {"id": 6, "duration_s": 0.99, "emotion": "scared_whisper", "text": "হয়ে... গেছে?"}, {"id": 7, "duration_s": 2.94, "emotion": "mischievous", "text": "দাঁড়াও দাঁড়াও! শুরু হয়েছিল... আজ সকালে।"}, {"id": 8, "duration_s": 3.23, "emotion": "happy", "text": "দীপাবলির সকাল। পাড়া ঝলমল করছিল..."}, {"id": 9, "duration_s": 3.61, "emotion": "sarcastic", "text": "...ভোম্বল? কুম্ভকর্ণের ভাই!"}, {"id": 10, "duration_s": 3.87, "emotion": "excited", "text": "সুপার বোমা! চান্দের থিকা বেশি আওয়াজ! খালি আইজ!"}, {"id": 11, "duration_s": 1.49, "emotion": "excited", "text": "চাঁদের চেয়েও বেশি?!"}, {"id": 12, "duration_s": 3.15, "emotion": "curious", "text": "দাদা... চাঁদের আওয়াজ কতটা হয়?"}, {"id": 13, "duration_s": 1.19, "emotion": "serious", "text": "...এর থিকা কম!"}, {"id": 14, "duration_s": 3.33, "emotion": "loving", "text": "আমার সুপার বোমা... আমার সোনা।"}, {"id": 15, "duration_s": 3.04, "emotion": "serious", "text": "আমি বলব? ওই বাক্সে কোনো নাম নেই!"}, {"id": 16, "duration_s": 3.82, "emotion": "serious", "text": "না কোম্পানি, না ঠিকানা! গাড়িওলাও হাওয়া!"}, {"id": 17, "duration_s": 2.3, "emotion": "proud", "text": "টেনশন নিয়ো না! ভোম্বল আছে!"}, {"id": 18, "duration_s": 0.78, "emotion": "happy", "text": "চলো, যাই!"}, {"id": 19, "duration_s": 2.75, "emotion": "comic_panic", "text": "বেঁচে গেছি! আমার বোমা বেঁচে গেল!"}, {"id": 20, "duration_s": 2.14, "emotion": "embarrassed", "text": "আরে ভোম্বল, ওটা আমার অটোর হাঁচি!"}, {"id": 21, "duration_s": 0.67, "emotion": "excited", "text": "আইডিয়া আছে!"}, {"id": 22, "duration_s": 3.11, "emotion": "determined", "text": "আজ রাতে... ছোটদের সেফটি স্কোয়াড!"}, {"id": 23, "duration_s": 3.07, "emotion": "excited", "text": "শুনেছ গো? ভোম্বল বোমা এনেছে!"}, {"id": 24, "duration_s": 3.86, "emotion": "sarcastic", "text": "আর দশ সেকেন্ডে... গোটা পাড়া জেনে গেল।"}, {"id": 25, "duration_s": 4.52, "emotion": "excited", "text": "দেখো! সুপার বোমা! চাঁদের চেয়েও জোর!"}, {"id": 26, "duration_s": 4.86, "emotion": "proud", "text": "খোকার মায়ের বাজি এর কাছে ফুস! গোটা পাড়া দেখবে!"}, {"id": 27, "duration_s": 0.82, "emotion": "angry", "text": "ভোম্বল!"}, {"id": 28, "duration_s": 3.07, "emotion": "embarrassed", "text": "উফ! এই নিশানা কখনও ফসকায় না..."}, {"id": 29, "duration_s": 3.44, "emotion": "stern_warning", "text": "পিদিমের পাশে বারুদ? বুদ্ধি কি ঘাস খেতে গেছে?"}, {"id": 30, "duration_s": 2.1, "emotion": "calm", "text": "থামো! এবার আমি দেখছি।"}, {"id": 31, "duration_s": 2.89, "emotion": "stern_warning", "text": "বাজি আগুন থেকে দূরে, ঠান্ডা জায়গায়।"}, {"id": 32, "duration_s": 4.12, "emotion": "proud", "text": "আজ প্রথম ফুলঝুরি আমি জ্বালব! কাউকে ডরাই না!"}, {"id": 33, "duration_s": 2.35, "emotion": "sarcastic", "text": "গতবার তুবড়ি দেখে আলমারিতে কে ঢুকেছিল?"}, {"id": 34, "duration_s": 4.57, "emotion": "embarrassed", "text": "ওটা... আলমারি সাফ করছিলাম। ভেতর থেকে।"}, {"id": 35, "duration_s": 3.08, "emotion": "proud", "text": "চটি ফেরত। নিশানা তৈরি।"}, {"id": 36, "duration_s": 5.57, "emotion": "shouting", "text": "সাইলেন্ট বাজি! না ধোঁয়া, না আওয়াজ, না ভয়!"}, {"id": 37, "duration_s": 3.89, "emotion": "proud", "text": "একশো টাকা বাক্স! এক পয়সাও কম নয়!"}, {"id": 38, "duration_s": 2.59, "emotion": "curious", "text": "হারেনদা, সাইলেন্ট বাজি জ্বলে কীভাবে?"}, {"id": 39, "duration_s": 3.18, "emotion": "mischievous", "text": "এত চুপচাপ... যে টেরই পাওয়া যায় না!"}, {"id": 40, "duration_s": 2.94, "emotion": "proud", "text": "বিজ্ঞান বলে... আওয়াজ সোজা মগজে আসে!"}, {"id": 41, "duration_s": 1.04, "emotion": "excited", "text": "হ্যাঁ... শুনতে পাচ্ছি!"}, {"id": 42, "duration_s": 2.63, "emotion": "sad", "text": "এতে তো খাওয়ার মতো কিছুই নেই!"}, {"id": 43, "duration_s": 1.08, "emotion": "happy", "text": "খিদে পেয়েছে!"}, {"id": 44, "duration_s": 3.5, "emotion": "shocked", "text": "শুনেছ গো? হারেন খালি বাক্স বেচছে!"}, {"id": 45, "duration_s": 1.18, "emotion": "stern_warning", "text": "হারেনদা!"}, {"id": 46, "duration_s": 4.96, "emotion": "embarrassed", "text": "ভবনী... এটা দূষণমুক্ত প্যাকেজিং!"}, {"id": 47, "duration_s": 3.9, "emotion": "sad", "text": "<sigh> সাইলেন্ট বাজি... সাইলেন্ট খদ্দের।"}, {"id": 48, "duration_s": 2.29, "emotion": "serious", "text": "বাজিরও নজর লাগে, দাদাভাই!"}, {"id": 49, "duration_s": 2.14, "emotion": "worried", "text": "দিদিমা, লেবু যদি ফেটে যায়?"}, {"id": 50, "duration_s": 1.65, "emotion": "serious", "text": "তাহলে টক ধামাকা!"}, {"id": 51, "duration_s": 2.67, "emotion": "sarcastic", "text": "কনস্টেবল ঘুমরাম পাড়া পাহারা দিচ্ছিলেন..."}, {"id": 52, "duration_s": 1.96, "emotion": "happy", "text": "হর্নেরও নজর লেগেছিল!"}, {"id": 53, "duration_s": 3.01, "emotion": "pleading", "text": "শুধু একটা... শুধু তদন্তের জন্য।"}, {"id": 54, "duration_s": 2.84, "emotion": "stern_warning", "text": "তদন্ত হবে!"}, {"id": 55, "duration_s": 2.05, "emotion": "sad", "text": "<sigh> তদন্তই মিষ্টি খেল।"}, {"id": 56, "duration_s": 5.1, "emotion": "proud", "text": "আমি কাউকে ডরাই না! শুধু আগুন, ফুলকি, আওয়াজ ছাড়া।"}, {"id": 57, "duration_s": 2.25, "emotion": "loving", "text": "তা, একটা লেবু তোমারও।"}, {"id": 58, "duration_s": 2.83, "emotion": "excited", "text": "সন্ধেবেলা... ছোটরা দায়িত্ব নিল।"}, {"id": 59, "duration_s": 2.79, "emotion": "determined", "text": "এই সেফটি লাইন! এর ওপারে কেউ না!"}, {"id": 60, "duration_s": 4.27, "emotion": "serious", "text": "আমি বলব? জলের বালতি, বালির বালতি, দূরত্ব!"}, {"id": 61, "duration_s": 2.48, "emotion": "excited", "text": "ফুচকার জল? কোথায় ফুচকা?"}, {"id": 62, "duration_s": 1.57, "emotion": "excited", "text": "ফুচকা?! কোথায়?!"}, {"id": 63, "duration_s": 3.174, "emotion": "sarcastic", "text": "জলের বালতি, মাস্টারমশাই! আর বালি!"}, {"id": 64, "duration_s": 2.77, "emotion": "curious", "text": "ঝালি? ফুচকার ঝাল কত?"}, {"id": 65, "duration_s": 1.84, "emotion": "embarrassed", "text": "দরকারের সময়েই ওর ছুটি!"}, {"id": 66, "duration_s": 2.55, "emotion": "shouting", "text": "সব বড়রা এদিকে! নিয়ম শোনো!"}, {"id": 67, "duration_s": 3.58, "emotion": "stern_warning", "text": "হাতে শুধু ফুলঝুরি! বাকি বাজি কক্ষনো না!"}, {"id": 68, "duration_s": 2.8, "emotion": "stern_warning", "text": "সিল্ক প্রদীপ থেকে দূরে! সুতি পরো!"}, {"id": 69, "duration_s": 1.31, "emotion": "comic_panic", "text": "পাঁচ মিনিট! আসছি!"}, {"id": 70, "duration_s": 1.52, "emotion": "shouting", "text": "এই! পিছনে!"}, {"id": 71, "duration_s": 2.05, "emotion": "embarrassed", "text": "আমি তো... লাইন চেক করছিলাম।"}, {"id": 72, "duration_s": 4.24, "emotion": "sarcastic", "text": "রাত হল... বীর ফিরল সুতির পাঞ্জাবিতে।"}, {"id": 73, "duration_s": 2.17, "emotion": "proud", "text": "আমি কাউকে ডরাই না! জ্বালাও!"}, {"id": 74, "duration_s": 4.82, "emotion": "stern_warning", "text": "হাত সোজা! মুখ থেকে দূরে! বালতি কাছে!"}, {"id": 75, "duration_s": 0.84, "emotion": "comic_panic", "text": "ফু... ফুলকি!"}, {"id": 76, "duration_s": 0.81, "emotion": "comic_panic", "text": "আআআআ!"}, {"id": 77, "duration_s": 1.26, "emotion": "comic_panic", "text": "নিভছে না কেন?!"}, {"id": 78, "duration_s": 2.48, "emotion": "excited", "text": "শুনেছ গো? হারু ম্যারাথন দৌড়চ্ছে!"}, {"id": 79, "duration_s": 2.55, "emotion": "sarcastic", "text": "ফুলঝুরি তো দু-মিনিট আগেই নিভে গেছে।"}, {"id": 80, "duration_s": 1.48, "emotion": "tired", "text": "...তা বলোনি কেন?"}, {"id": 81, "duration_s": 3.77, "emotion": "giggly", "text": "বাবা, ফুলঝুরি দাঁড়িয়ে জ্বালায়, দৌড়ে নয়!"}, {"id": 82, "duration_s": 3.71, "emotion": "serious", "text": "আর পোড়া তার সোজা জলে। পায়ে নয়।"}, {"id": 83, "duration_s": 4.32, "emotion": "giggly", "text": "প্রথম ফুলঝুরি... আর প্রথম ম্যারাথন!"}, {"id": 84, "duration_s": 2.31, "emotion": "mischievous", "text": "নতুন প্র্যাঙ্ক! চকোলেট বোমা!"}, {"id": 85, "duration_s": 2.27, "emotion": "curious", "text": "বোমা থেকে... চকোলেটের গন্ধ?"}, {"id": 86, "duration_s": 1.38, "emotion": "shouting", "text": "বু... বু... বুম!"}, {"id": 87, "duration_s": 1.07, "emotion": "panicked", "text": "রসো ফেটে গেল!"}, {"id": 88, "duration_s": 2.594, "emotion": "shouting", "text": "রসো!!"}, {"id": 89, "duration_s": 3.86, "emotion": "giggly", "text": "ভেতরে চকোলেট ছিল! খিদে পেয়েছিল!"}, {"id": 90, "duration_s": 3.29, "emotion": "excited", "text": "শুনেছ গো? রসো... আবার খিদে!"}, {"id": 91, "duration_s": 5.64, "emotion": "stern_warning", "text": "বাজি নিয়ে মজা নয়, দিদি! সবাই ভয় পেয়েছে।"}, {"id": 92, "duration_s": 0.64, "emotion": "embarrassed", "text": "সরি... রিল ডিলিট।"}, {"id": 93, "duration_s": 3.83, "emotion": "mischievous", "text": "এবার... ফিরি সেখানে, যেখানে গল্প থেমেছিল।"}, {"id": 94, "duration_s": 4.87, "emotion": "stern_warning", "text": "লম্বা ধূপকাঠি! হাত সোজা! জ্বালাও আর পিছনে!"}, {"id": 95, "duration_s": 2.62, "emotion": "comic_panic", "text": "জ্বলেছে! পালাও... মানে, পিছিয়ে এসো!"}, {"id": 96, "duration_s": 3.03, "emotion": "proud", "text": "দাঁড়াও... ও ভাবছে।"}, {"id": 97, "duration_s": 3.2, "emotion": "serious", "text": "বিজ্ঞান বলে... ও ঘুমিয়ে পড়েছে।"}, {"id": 98, "duration_s": 3.36, "emotion": "shouting", "text": "থামো! ফুস বাজির কাছে কেউ যাবে না!"}, {"id": 99, "duration_s": 2.96, "emotion": "serious", "text": "আমি বলব? পনেরো মিনিট পর জল ঢালো।"}, {"id": 100, "duration_s": 3.2, "emotion": "sarcastic", "text": "পনেরো মিনিট? আমার সুদ চলছে!"}, {"id": 101, "duration_s": 1.65, "emotion": "embarrassed", "text": "...চাঁদের চেয়েও জোর।"}, {"id": 102, "duration_s": 3.36, "emotion": "sarcastic", "text": "লাইভ চলছে... দুর্ভাগ্যবশত।"}, {"id": 103, "duration_s": 0.99, "emotion": "angry", "text": "ভোম্বল..."}, {"id": 104, "duration_s": 1.54, "emotion": "shouting", "text": "তদন্ত হবে!"}, {"id": 105, "duration_s": 3.56, "emotion": "embarrassed", "text": "হর্নের জন্যই! সত্যি!"}, {"id": 106, "duration_s": 4.807, "emotion": "curious", "text": "কী হল? মিষ্টি বিলি হচ্ছে?"}, {"id": 107, "duration_s": 3.83, "emotion": "tender", "text": "আরে ভুলু... তুইও ঘাবড়ে গেলি?"}, {"id": 108, "duration_s": 4.0, "emotion": "worried", "text": "পশুদের কান আমাদের চেয়ে অনেক সজাগ।"}, {"id": 109, "duration_s": 4.08, "emotion": "serious", "text": "আমাদের যেটা বাজি, ওদের কাছে ঝড়।"}, {"id": 110, "duration_s": 3.39, "emotion": "tender", "text": "শ্শ্শ... ভুলুর জন্য শান্ত কোণ!"}, {"id": 111, "duration_s": 3.75, "emotion": "calm", "text": "ধামাকা থেকে দূরে... একটা ছোট্ট শান্ত কোণ।"}, {"id": 112, "duration_s": 3.61, "emotion": "happy", "text": "আমার কানও বুড়ো। আমিও আছি!"}, {"id": 113, "duration_s": 1.65, "emotion": "tender", "text": "আয় ভুলু, এখানে আওয়াজ নেই।"}, {"id": 114, "duration_s": 2.28, "emotion": "serious", "text": "বেচারাকে নজর লেগেছিল!"}, {"id": 115, "duration_s": 3.03, "emotion": "proud", "text": "সাবাশ, আমার সেফটি স্কোয়াড।"}, {"id": 116, "duration_s": 4.76, "emotion": "mischievous", "text": "তারপর... সুপার বোমার ময়নাতদন্ত।"}, {"id": 117, "duration_s": 5.03, "emotion": "serious", "text": "তদন্ত হবে! ...পরতে পরতে।"}, {"id": 118, "duration_s": 3.21, "emotion": "sad", "text": "এত বড় বাক্স... ভেতরে এইটুকু?"}, {"id": 119, "duration_s": 2.84, "emotion": "serious", "text": "নামহীন বাজি বিপজ্জনকও হতে পারে।"}, {"id": 120, "duration_s": 3.0, "emotion": "loving", "text": "কাকু, লাইসেন্সের দোকানে কেনো। ভ্যানে নয়।"}, {"id": 121, "duration_s": 2.99, "emotion": "guilty", "text": "ঠিক বলেছিস। পরের বার আগে জিজ্ঞেস করব।"}, {"id": 122, "duration_s": 2.41, "emotion": "giggly", "text": "টেনশন নেব... একটু।"}, {"id": 123, "duration_s": 2.79, "emotion": "stern_warning", "text": "হারেনদা! খালি বাক্স?"}, {"id": 124, "duration_s": 3.35, "emotion": "guilty", "text": "ঠিক আছে! সবাইকে... মুফতে মিষ্টি!"}, {"id": 125, "duration_s": 3.99, "emotion": "crying", "text": "বিনি পয়সা... মুখে আনতেও কষ্ট!"}, {"id": 126, "duration_s": 2.46, "emotion": "serious", "text": "তদন্ত শেষ।"}, {"id": 127, "duration_s": 0.9, "emotion": "happy", "text": "সমান ভাগ!"}, {"id": 128, "duration_s": 3.82, "emotion": "calm", "text": "সে রাতে পাড়ায় ধোঁয়া কম ছিল... আলো বেশি।"}, {"id": 129, "duration_s": 3.02, "emotion": "loving", "text": "এই প্রদীপ চুপচাপ জ্বলে... সারা রাত।"}, {"id": 130, "duration_s": 1.77, "emotion": "giggly", "text": "আর এদের জন্য বাঁশিও লাগে না!"}, {"id": 131, "duration_s": 3.2, "emotion": "excited", "text": "নতুন রিল... 'সাইলেন্ট দীপাবলি'! লাইভ চলছে!"}, {"id": 132, "duration_s": 2.11, "emotion": "excited", "text": "শুনেছ গো? টুম্পার রিল ভাইরাল!"}, {"id": 133, "duration_s": 2.75, "emotion": "proud", "text": "দেখলে? গোটা পাড়া দেখেছে! গোটা দেশও!"}, {"id": 134, "duration_s": 1.88, "emotion": "giggly", "text": "আর রিলে আপনার চটিও আছে!"}, {"id": 135, "duration_s": 2.99, "emotion": "proud", "text": "বিজ্ঞান বলে... প্রদীপই সবচেয়ে নিরাপদ বাজি।"}, {"id": 136, "duration_s": 3.23, "emotion": "shocked", "text": "গোপু ঠিক বলল?! ...আমি ঠিক শুনলাম?"}, {"id": 137, "duration_s": 5.36, "emotion": "serious", "text": "বাজি হাতে নয়, বালতি পাশে, ছোটরা বড়দের সঙ্গে।"}, {"id": 138, "duration_s": 3.62, "emotion": "loving", "text": "আর পশু আর বয়স্কদের জন্য একটা শান্ত কোণ।"}, {"id": 139, "duration_s": 3.4, "emotion": "calm", "text": "আলো থাকুক মনে... ধামাকা নয় হাতে।"}, {"id": 140, "duration_s": 1.78, "emotion": "excited", "text": "হ্যাপি সেফ দীপাবলি!"}]