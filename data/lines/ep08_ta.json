[{"id": 1, "duration_s": 6.06, "emotion": "calm", "text": "மே மாச வெயில். காலை ஏழு மணி. எல்லாமே சரியா இருந்துச்சு..."}, {"id": 2, "duration_s": 3.89, "emotion": "happy", "text": "குளுகுளு தண்ணி... சூடான நான்! லா லா லா!"}, {"id": 3, "duration_s": 2.44, "emotion": "curious", "text": "அட? மழை நின்னுடுச்சா?"}, {"id": 4, "duration_s": 4.55, "emotion": "comic_panic", "text": "தண்ணி! தண்ணி! கண்ல சோப்பு! செல்வீஈ!"}, {"id": 5, "duration_s": 3.82, "emotion": "surprised", "text": "அத்தை, இங்கேயும் தண்ணி இல்ல! காத்து மட்டும்தான்!"}, {"id": 6, "duration_s": 3.45, "emotion": "serious", "text": "குழாய்க்கு உடம்பு சரியில்ல. காய்ச்சல் இல்ல, தாகம்!"}, {"id": 7, "duration_s": 2.04, "emotion": "excited", "text": "கேட்டியா? என் குழாயும் இருமுது!"}, {"id": 8, "duration_s": 3.25, "emotion": "angry", "text": "ஒரே ஒரு சொட்டா? மாசம் முழுக்க பில் கட்டினேனே!"}, {"id": 9, "duration_s": 2.93, "emotion": "worried", "text": "கண்ணு பட்டுடுச்சு! குழாய்க்கே கண்ணு பட்டுடுச்சு!"}, {"id": 10, "duration_s": 2.78, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது... குழாய் தூங்குது."}, {"id": 11, "duration_s": 2.07, "emotion": "excited", "text": "லைவ்-ல இருக்கோம்! காலனியே வறண்டுச்சு!"}, {"id": 12, "duration_s": 3.8, "emotion": "shouting", "text": "யாரு தண்ணி கட் பண்ணினது? நான் யாருக்கும் பயப்பட மாட்டேன்!"}, {"id": 13, "duration_s": 3.64, "emotion": "mischievous", "text": "அப்புறம்... காலனி முழுக்க தண்ணி கட்!"}, {"id": 14, "duration_s": 2.34, "emotion": "shouting", "text": "லாரி வந்தாச்சு! லாரி!"}, {"id": 15, "duration_s": 2.32, "emotion": "determined", "text": "வழி விடுங்க! சோப்பு மனுஷன் வர்றேன்!"}, {"id": 16, "duration_s": 3.96, "emotion": "proud", "text": "என் வாளி! இம்போர்ட்டெட்! ஒரு சொட்டு கூட கம்மி இல்ல!"}, {"id": 17, "duration_s": 2.09, "emotion": "happy", "text": "போகலாம்! டிரம் நிறைய கொண்டு வருவோம்!"}, {"id": 18, "duration_s": 2.36, "emotion": "sarcastic", "text": "ஒரே மீட்டர். சாதனை!"}, {"id": 19, "duration_s": 2.42, "emotion": "shouting", "text": "ஒரு வீடு, ரெண்டு வாளி! தள்ளாதீய!"}, {"id": 20, "duration_s": 1.77, "emotion": "determined", "text": "போதும்! இனி நான் பாக்குறேன்."}, {"id": 21, "duration_s": 1.77, "emotion": "surprised", "text": "அண்ணாச்சி, இது வாளியா?"}, {"id": 22, "duration_s": 1.17, "emotion": "mischievous", "text": "வாளியோட அண்ணன்!"}, {"id": 23, "duration_s": 2.87, "emotion": "stern_warning", "text": "காசு கந்தசாமி! ஊரே பாக்குது!"}, {"id": 24, "duration_s": 3.31, "emotion": "sad", "text": "பசிக்குது... தாகமும் எடுக்குது."}, {"id": 25, "duration_s": 4.01, "emotion": "calm", "text": "முடிஞ்சு போச்சு! அடுத்த டேங்கர்... மத்தியானம்தான்."}, {"id": 26, "duration_s": 2.57, "emotion": "excited", "text": "கேட்டியா? டேங்கர் மூணு நாள் கழிச்சு!"}, {"id": 27, "duration_s": 3.86, "emotion": "excited", "text": "ஹலோ சுந்தரம், கேட்டியா? ஹலோ வரதன், கேட்டியா?"}, {"id": 28, "duration_s": 1.05, "emotion": "serious", "text": "புறாவே... கேட்டியா?"}, {"id": 29, "duration_s": 4.69, "emotion": "panicked", "text": "மூணு நாளா? அய்யய்யோ... மூணு மணி நேரத்துல எல்லாம் காலி!"}, {"id": 30, "duration_s": 3.55, "emotion": "comic_panic", "text": "மூணு மணியா? மூணு நிமிஷம்! ஓடுங்க!"}, {"id": 31, "duration_s": 4.7, "emotion": "mischievous", "text": "மத்தியான டேங்கர், மூணு நிமிஷத்துல மூணு நாளா மாறிடுச்சு."}, {"id": 32, "duration_s": 2.7, "emotion": "mischievous", "text": "பாட்டில் இருபது ரூபா! சீக்கிரம், விலை ஏறப்போகுது!"}, {"id": 33, "duration_s": 4.06, "emotion": "mischievous", "text": "நாப்பது! விலை வானிலை மாதிரி, மாறிட்டே இருக்கும்!"}, {"id": 34, "duration_s": 4.86, "emotion": "proud", "text": "பன்னெண்டு பாட்டில்! ஒண்ணு குளிக்க... பதினொண்ணு மறுபடி குளிக்க!"}, {"id": 35, "duration_s": 1.5, "emotion": "curious", "text": "ஒரு பாட்டில் எவ்வளவு?"}, {"id": 36, "duration_s": 0.63, "emotion": "proud", "text": "நூறு!"}, {"id": 37, "duration_s": 2.66, "emotion": "calm", "text": "அப்ப வேணாம். காத்து இலவசம்."}, {"id": 38, "duration_s": 2.98, "emotion": "mischievous", "text": "கவலை வேணாம்! எல்லாம் குடுங்க, டபுள் விலைக்கு விப்பேன்!"}, {"id": 39, "duration_s": 2.17, "emotion": "sarcastic", "text": "நானே டிரிப்பிள்ல விக்கிறேன்."}, {"id": 40, "duration_s": 1.04, "emotion": "stern_warning", "text": "கந்தசாமி!"}, {"id": 41, "duration_s": 2.95, "emotion": "embarrassed", "text": "இருபது! இருபதுதான்!"}, {"id": 42, "duration_s": 2.52, "emotion": "excited", "text": "லைவ்-ல இருக்கோம்! தண்ணி தங்க விலை!"}, {"id": 43, "duration_s": 3.86, "emotion": "proud", "text": "பன்னிரண்டு பாட்டில் தண்ணி! இன்னிக்கு ராஜா மாதிரி குளிப்பேன்!"}, {"id": 44, "duration_s": 2.79, "emotion": "stern_warning", "text": "ராஜா இல்ல, பிரஜை மாதிரி. ஒரே சொம்பு."}, {"id": 45, "duration_s": 2.67, "emotion": "pleading", "text": "அரை சொம்பா? இவ்வளவு சோப்புக்கு?"}, {"id": 46, "duration_s": 3.72, "emotion": "proud", "text": "எங்க காலத்துல அரை சொம்புல கல்யாண கோஷ்டியே குளிக்கும்!"}, {"id": 47, "duration_s": 4.39, "emotion": "proud", "text": "சரி! நான் யாருக்கும் பயப்பட மாட்டேன்! அரை சொம்பு!"}, {"id": 48, "duration_s": 2.64, "emotion": "determined", "text": "நில்லுங்க! சிந்துற தண்ணி துளசிக்கு!"}, {"id": 49, "duration_s": 2.44, "emotion": "surprised", "text": "அப்பா, சோப்பு தண்ணியை குடிச்சிடுச்சு!"}, {"id": 50, "duration_s": 3.2, "emotion": "stern_warning", "text": "இன்னொரு சொம்பா? ஊரே பாக்கும்!"}, {"id": 51, "duration_s": 0.89, "emotion": "shocked", "text": "ப... பல்லி!"}, {"id": 52, "duration_s": 2.52, "emotion": "embarrassed", "text": "பயமில்ல... அதோட தாகம்தான் பயம்!"}, {"id": 53, "duration_s": 2.9, "emotion": "worried", "text": "அத்தை, ராத்திரி டேங்க் நிரம்பியிருந்துச்சே."}, {"id": 54, "duration_s": 1.16, "emotion": "curious", "text": "அப்ப எங்க போச்சு?"}, {"id": 55, "duration_s": 2.29, "emotion": "excited", "text": "ஒரு ஐடியா இருக்கு! தண்ணி டிடெக்டிவ்!"}, {"id": 56, "duration_s": 0.73, "emotion": "excited", "text": "டிடெக்டிவ் ரெடி?"}, {"id": 57, "duration_s": 2.49, "emotion": "stern_warning", "text": "ஷ்ஷ்! டிடெக்டிவ் பேசமாட்டாங்க!"}, {"id": 58, "duration_s": 3.96, "emotion": "serious", "text": "நான் சொல்லவா? தண்ணியை பின்தொடருங்க... திருடன் கிடைப்பான்!"}, {"id": 59, "duration_s": 0.85, "emotion": "serious", "text": "ஒண்ணு!"}, {"id": 60, "duration_s": 0.89, "emotion": "serious", "text": "ரெண்டு!"}, {"id": 61, "duration_s": 3.26, "emotion": "happy", "text": "இந்த சொட்டு குழாய்... ரொம்ப இனிப்பு!"}, {"id": 62, "duration_s": 2.74, "emotion": "shocked", "text": "பதினாலு குழாய் ஒழுகுது! பதினாலு!"}, {"id": 63, "duration_s": 3.7, "emotion": "mischievous", "text": "இந்த தண்ணி ஆறு... எங்கதான் போகுது?"}, {"id": 64, "duration_s": 3.87, "emotion": "proud", "text": "சேகர் கார் வாஷ்! கார், ஸ்கூட்டர், எருமை... எல்லாம் கழுவுவோம்!"}, {"id": 65, "duration_s": 1.68, "emotion": "angry", "text": "நிறுத்து! பைப்பை மூடு!"}, {"id": 66, "duration_s": 3.88, "emotion": "mischievous", "text": "மூடவா? இது பிசினஸ்! தண்ணி ஃப்ரீ, லாபம் முழுசும்!"}, {"id": 67, "duration_s": 3.58, "emotion": "serious", "text": "நான் சொல்லவா? இந்த பைப் காலை அஞ்சுலேர்ந்து ஓடுது."}, {"id": 68, "duration_s": 1.57, "emotion": "shocked", "text": "அதான் நம்ம டேங்க் காலி!"}, {"id": 69, "duration_s": 3.4, "emotion": "calm", "text": "டென்ஷன் வேணாம்! தண்ணி என்னதில்ல, காலனியோடது!"}, {"id": 70, "duration_s": 1.12, "emotion": "angry", "text": "அதான் டென்ஷனே!"}, {"id": 71, "duration_s": 2.57, "emotion": "shouting", "text": "விசாரணை! யாரது?"}, {"id": 72, "duration_s": 4.24, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது... காத்து ப்ளஸ் தண்ணி சமம் மழை!"}, {"id": 73, "duration_s": 2.39, "emotion": "stern_warning", "text": "ஷ்ஷ்! பாப்போம்."}, {"id": 74, "duration_s": 2.51, "emotion": "excited", "text": "லைவ்-ல இருக்கோம்! காலனியோட முதல் மழை!"}, {"id": 75, "duration_s": 3.44, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது... மழை விஞ்ஞானிக்கு மட்டும்தான்!"}, {"id": 76, "duration_s": 4.73, "emotion": "sad", "text": "அறிவு குளிச்சுட்டானா? நான் இன்னும் சோப்புலயே இருக்கேன்!"}, {"id": 77, "duration_s": 4.75, "emotion": "laughing", "text": "<laugh> ஊரே பாக்குது... அறிவோட ஸ்நானம்!"}, {"id": 78, "duration_s": 3.04, "emotion": "sarcastic", "text": "இன்னொரு வாளி போச்சு. பதினைஞ்சாவது குழாய்!"}, {"id": 79, "duration_s": 1.99, "emotion": "embarrassed", "text": "கொஞ்சம் கேலிப்ரேஷன் பாக்கி!"}, {"id": 80, "duration_s": 2.24, "emotion": "panicked", "text": "கேட்டியா? கடைசி டேங்கர்!"}, {"id": 81, "duration_s": 3.86, "emotion": "excited", "text": "ஆரம்பிச்சது... காலனியின் மிகப்பெரிய வாளி ரேஸ்!"}, {"id": 82, "duration_s": 1.614, "emotion": "determined", "text": "முதல் வாளி என்னுது!"}, {"id": 83, "duration_s": 0.96, "emotion": "excited", "text": "போகலாம்!"}, {"id": 84, "duration_s": 1.09, "emotion": "sad", "text": "இன்னிக்குமா?"}, {"id": 85, "duration_s": 3.17, "emotion": "curious", "text": "யாராவது சொல்லுங்களேன்... நான் எங்கே?"}, {"id": 86, "duration_s": 2.04, "emotion": "angry", "text": "என் வாளிலேர்ந்து இறங்கு!"}, {"id": 87, "duration_s": 3.02, "emotion": "sarcastic", "text": "இது வாளி இல்ல... பெரிய அண்ணன்!"}, {"id": 88, "duration_s": 5.01, "emotion": "shouting", "text": "விசாரணை! நில்லுங்க! போங்க! இல்ல, நில்லுங்க!"}, {"id": 89, "duration_s": 3.34, "emotion": "excited", "text": "லைவ்! வாளி ஜாம், நூறு மீட்டர் நீளம்!"}, {"id": 90, "duration_s": 3.11, "emotion": "angry", "text": "ஊரே பாக்குது... ஒருத்தனும் அசையல!"}, {"id": 91, "duration_s": 2.52, "emotion": "excited", "text": "புறாவே, கேட்டியா...? அடடா!"}, {"id": 92, "duration_s": 1.29, "emotion": "shouting", "text": "அமைதி!!!"}, {"id": 93, "duration_s": 2.97, "emotion": "serious", "text": "தண்ணிக்காக சண்டை... குழாய் இன்னும் ஒழுகுது!"}, {"id": 94, "duration_s": 1.6, "emotion": "determined", "text": "நான் சொல்லவா? கணக்கு பாருங்க!"}, {"id": 95, "duration_s": 3.06, "emotion": "stern_warning", "text": "அமைதி! இன்று பாடம்... தண்ணீர்!"}, {"id": 96, "duration_s": 4.51, "emotion": "serious", "text": "நான் சொல்லவா? ஒரு ஒழுகும் குழாய், ஒவ்வொரு நொடியும் ஒரு சொட்டு."}, {"id": 97, "duration_s": 1.97, "emotion": "excited", "text": "சோறா? எங்க சோறு?"}, {"id": 98, "duration_s": 3.01, "emotion": "sarcastic", "text": "சோறு இல்ல, சொட்டு!"}, {"id": 99, "duration_s": 3.32, "emotion": "proud", "text": "ஒரு குழாய், ஒரு மாசம்... அறுபது வாளி!"}, {"id": 100, "duration_s": 3.4, "emotion": "shocked", "text": "<gasp> அறுபதா? அய்யய்யோ!"}, {"id": 101, "duration_s": 4.1, "emotion": "shocked", "text": "பதினாலு அறுபது... எண்ணூத்து நாப்பது!"}, {"id": 102, "duration_s": 2.28, "emotion": "mischievous", "text": "இத்தனை பாட்டில் வித்திருந்தா..."}, {"id": 103, "duration_s": 0.8, "emotion": "stern_warning", "text": "கந்தசாமி!"}, {"id": 104, "duration_s": 4.49, "emotion": "serious", "text": "அப்புறம் சேகர் மாமா பைப்... ஒரு மணி நேரத்துல ஐம்பது வாளி!"}, {"id": 105, "duration_s": 3.28, "emotion": "embarrassed", "text": "டென்ஷன்... கொஞ்சம் கொஞ்சமா வருது."}, {"id": 106, "duration_s": 3.44, "emotion": "calm", "text": "மாமி, லைன் ரிப்பேர் பண்ணிண்டிருக்கோம். சாயந்தரம் ஜலம் வந்துடும்."}, {"id": 107, "duration_s": 2.55, "emotion": "embarrassed", "text": "சாயந்தரமா? மூணு நாள் இல்லையா?"}, {"id": 108, "duration_s": 2.37, "emotion": "sarcastic", "text": "மூணு நாளா? யாரு சொன்னேள்?"}, {"id": 109, "duration_s": 4.49, "emotion": "guilty", "text": "அப்ப தண்ணி நிக்கல... நாமளே கொட்டி வீணாக்கிட்டோம்!"}, {"id": 110, "duration_s": 3.3, "emotion": "serious", "text": "பதினாலு குழாய், ஒரு பைப், ஒரு பாத்டப்..."}, {"id": 111, "duration_s": 1.68, "emotion": "mischievous", "text": "அப்புறம் ஒரு சோப்பு அப்பா!"}, {"id": 112, "duration_s": 1.92, "emotion": "determined", "text": "போதும்! இனி நாம பாத்துக்கலாம்."}, {"id": 113, "duration_s": 0.74, "emotion": "determined", "text": "பத்து நொடி."}, {"id": 114, "duration_s": 2.99, "emotion": "proud", "text": "ஒன்பது நொடி! ஊரே பாக்குது!"}, {"id": 115, "duration_s": 1.91, "emotion": "proud", "text": "இது எனக்கு இடது கை வேலை!"}, {"id": 116, "duration_s": 3.07, "emotion": "relieved", "text": "ஆஹா... குளிச்சுட்டேன்! கடைசியா!"}, {"id": 117, "duration_s": 1.81, "emotion": "excited", "text": "கேட்டியா? முருகேசன் குளிச்சுட்டார்!"}, {"id": 118, "duration_s": 4.68, "emotion": "happy", "text": "ஒரு வாளி, ஒரு துணி... கார் பளபளப்பு!"}, {"id": 119, "duration_s": 2.46, "emotion": "laughing", "text": "<laugh> எருமையும்! ஆனா வாளில!"}, {"id": 120, "duration_s": 3.7, "emotion": "proud", "text": "ஒழுகுற தண்ணியும் என்னோடது! ஒரு சொட்டு வீணாகாது!"}, {"id": 121, "duration_s": 2.98, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது... குழாயை சரிபண்ணு."}, {"id": 122, "duration_s": 2.88, "emotion": "surprised", "text": "அறிவு அண்ணா... முதல் தடவை சரி!"}, {"id": 123, "duration_s": 3.47, "emotion": "sad", "text": "இனிப்பு குழாய்... ரிடையர் ஆயிடுச்சு."}, {"id": 124, "duration_s": 2.18, "emotion": "happy", "text": "கூரை தண்ணி, நேரா டிரம்முக்கு!"}, {"id": 125, "duration_s": 2.63, "emotion": "loving", "text": "இனி மழைக்கு கண்ணு படாது."}, {"id": 126, "duration_s": 2.74, "emotion": "excited", "text": "லைவ்-ல இருக்கோம்! ஹேஷ்டேக் சொட்டு சேமி!"}, {"id": 127, "duration_s": 3.64, "emotion": "happy", "text": "அன்னிக்கு பதினாலு குழாய் சரியாச்சு... ஒரு அப்பா குளிச்சார்."}, {"id": 128, "duration_s": 2.46, "emotion": "calm", "text": "சாயந்தரம் ஆச்சு... குழாய்ல தண்ணி வந்துச்சு."}, {"id": 129, "duration_s": 2.82, "emotion": "proud", "text": "இன்னிலேர்ந்து முருகேசன் ஒரு வாளில குளிப்பான்!"}, {"id": 130, "duration_s": 0.72, "emotion": "stern_warning", "text": "பாதி."}, {"id": 131, "duration_s": 2.06, "emotion": "calm", "text": "சிறு துளி பெரு வெள்ளம்..."}, {"id": 132, "duration_s": 2.15, "emotion": "serious", "text": "...துளித் துளியா வறளவும் செய்யும்."}, {"id": 133, "duration_s": 5.62, "emotion": "serious", "text": "ஒழுகுற குழாயை இன்னிக்கே பண்ணு... நாளைக்கில்ல."}, {"id": 134, "duration_s": 3.01, "emotion": "calm", "text": "வானத்துத் தண்ணி... டிரம்முல."}, {"id": 135, "duration_s": 1.22, "emotion": "determined", "text": "கார் வாளில தான்!"}, {"id": 136, "duration_s": 1.5, "emotion": "determined", "text": "பைப் திறந்து விடமாட்டோம்!"}, {"id": 137, "duration_s": 2.14, "emotion": "proud", "text": "மழைத் தண்ணி... கூரைல!"}, {"id": 138, "duration_s": 1.4, "emotion": "excited", "text": "மழை!"}, {"id": 139, "duration_s": 2.62, "emotion": "excited", "text": "ஃப்ரீ ஷவர்! சாமி, ஆன் பண்ணுங்க!"}]