[{"id": 1, "duration_s": 5.64, "emotion": "calm", "text": "ಮೇ ತಿಂಗಳ ಬಿಸಿಲು. ಬೆಳಗ್ಗೆ ಏಳು ಗಂಟೆ. ಎಲ್ಲಾ ಸರಿಯಾಗೇ ಇತ್ತು..."}, {"id": 2, "duration_s": 4.3, "emotion": "happy", "text": "ತಣ್ಣೀರು ತಣ್ಣೀರು... ಬಿಸಿ ಬಿಸಿ ನಾನು! ಲಾ ಲಾ ಲಾ!"}, {"id": 3, "duration_s": 1.85, "emotion": "curious", "text": "ಅರೆ? ಮಳೆ ನಿಂತೋಯ್ತಾ?"}, {"id": 4, "duration_s": 4.9, "emotion": "comic_panic", "text": "ನೀರು... ನೀರು! ಕಣ್ಣಲ್ಲಿ ಸೋಪು! ಕಾವೇರಿಈಈ!"}, {"id": 5, "duration_s": 3.76, "emotion": "surprised", "text": "ಅತ್ತೆ, ಇಲ್ಲೂ ನೀರಿಲ್ಲ! ಬರೀ ಗಾಳಿ!"}, {"id": 6, "duration_s": 4.74, "emotion": "serious", "text": "ನಲ್ಲಿಗೆ ಹುಷಾರಿಲ್ಲ. ಜ್ವರ ಅಲ್ಲ, ಬಾಯಾರಿಕೆ."}, {"id": 7, "duration_s": 2.72, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ನಲ್ಲಿಗೆ ಕೆಮ್ಮು!"}, {"id": 8, "duration_s": 2.78, "emotion": "angry", "text": "ಒಂದೇ ಹನಿ? ತಿಂಗಳ ಬಿಲ್ ಕಟ್ಟಿದ್ದೀನಿ!"}, {"id": 9, "duration_s": 3.28, "emotion": "worried", "text": "ದೃಷ್ಟಿ ಆಯ್ತು! ನಲ್ಲಿಗೇ ದೃಷ್ಟಿ ಆಯ್ತು!"}, {"id": 10, "duration_s": 2.5, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ... ನಲ್ಲಿ ಮಲಗಿದೆ."}, {"id": 11, "duration_s": 2.67, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ಇಡೀ ಕಾಲೋನಿ ಒಣಗಿದೆ!"}, {"id": 12, "duration_s": 3.2, "emotion": "shouting", "text": "ಯಾರ್ರೀ ನೀರು ನಿಲ್ಸಿದ್ದು? ನಂಗೆ ಯಾರ ಭಯ ಇಲ್ಲ!"}, {"id": 13, "duration_s": 4.13, "emotion": "mischievous", "text": "ಆಮೇಲೆ... ಇಡೀ ಕಾಲೋನಿಗೆ ನೀರು ಬಂದ್!"}, {"id": 14, "duration_s": 1.99, "emotion": "shouting", "text": "ಟ್ಯಾಂಕರ್ ಬಂತು! ಟ್ಯಾಂಕರ್ ಬಂತು!"}, {"id": 15, "duration_s": 2.78, "emotion": "determined", "text": "ದಾರಿ ಬಿಡಿ! ಸೋಪಿನ ಮನುಷ್ಯ ಬರ್ತಿದ್ದಾನೆ!"}, {"id": 16, "duration_s": 3.98, "emotion": "proud", "text": "ನನ್ ಬಕೆಟ್! ಇಂಪೋರ್ಟೆಡ್! ಒಂದ್ ರೂಪಾಯಿ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 17, "duration_s": 1.94, "emotion": "happy", "text": "ಹೊರಡಿ! ಡ್ರಮ್ ತುಂಬಿಸ್ಕೊಂಡು ಬರೋಣ!"}, {"id": 18, "duration_s": 2.92, "emotion": "sarcastic", "text": "ಒಂದು ಮೀಟರ್. ದಾಖಲೆ."}, {"id": 19, "duration_s": 2.32, "emotion": "shouting", "text": "ಮನೆಗೆ ಎರಡು ಬಕೆಟ್! ತಳ್ಳಬೇಡಿ!"}, {"id": 20, "duration_s": 2.39, "emotion": "determined", "text": "ಸಾಕು! ಈಗ ನಾನು ನೋಡ್ತೀನಿ."}, {"id": 21, "duration_s": 1.76, "emotion": "surprised", "text": "ದಾಸಪ್ಪ, ಇದು ಬಕೆಟ್?"}, {"id": 22, "duration_s": 1.63, "emotion": "mischievous", "text": "ಬಕೆಟ್ಟಿನ ದೊಡ್ಡಣ್ಣ!"}, {"id": 23, "duration_s": 3.76, "emotion": "stern_warning", "text": "ದುಡ್ಡು ದಾಸಪ್ಪ! ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ತಿದೆ!"}, {"id": 24, "duration_s": 3.5, "emotion": "sad", "text": "ಹಸಿವಾಗಿದೆ... ಬಾಯಾರಿಕೆ!"}, {"id": 25, "duration_s": 3.83, "emotion": "calm", "text": "ಮುಗೀತು! ಮುಂದಿನ ಟ್ಯಾಂಕರ್... ಮಧ್ಯಾಹ್ನ ಉಂಟು"}, {"id": 26, "duration_s": 2.26, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಟ್ಯಾಂಕರ್ ಮೂರು ದಿನಕ್ಕೆ!"}, {"id": 27, "duration_s": 4.34, "emotion": "excited", "text": "ಹಲೋ ಶಿವಣ್ಣ, ಕೇಳಿದ್ರಾ? ಹಲೋ ವೆಂಕಣ್ಣ, ಕೇಳಿದ್ರಾ?"}, {"id": 28, "duration_s": 1.62, "emotion": "serious", "text": "ಪಾರಿವಾಳಣ್ಣ... ಕೇಳಿದ್ರಾ?"}, {"id": 29, "duration_s": 5.13, "emotion": "panicked", "text": "ಮೂರು ದಿನ? ಅಯ್ಯೋ ರಾಮ... ಮೂರು ಗಂಟೇಲಿ ಎಲ್ಲಾ ಖಾಲಿ!"}, {"id": 30, "duration_s": 3.54, "emotion": "comic_panic", "text": "ಮೂರು ಗಂಟೆ? ಇಲ್ಲ... ಮೂರು ನಿಮಿಷ! ಓಡಿ!"}, {"id": 31, "duration_s": 3.75, "emotion": "mischievous", "text": "ಮಧ್ಯಾಹ್ನದ ಟ್ಯಾಂಕರ್, ಮೂರು ನಿಮಿಷಕ್ಕೆ ಮೂರು ದಿನ ಆಯ್ತು!"}, {"id": 32, "duration_s": 3.436, "emotion": "mischievous", "text": "ಬಾಟಲ್ ಇಪ್ಪತ್ತು! ಬೇಗ ಬೇಗ, ರೇಟ್ ಏರ್ತಿದೆ!"}, {"id": 33, "duration_s": 4.51, "emotion": "mischievous", "text": "ನಲವತ್ತು! ರೇಟು ಹವಾಮಾನ ಇದ್ದಂಗೆ, ಬದಲಾಗ್ತಾನೇ ಇರುತ್ತೆ."}, {"id": 34, "duration_s": 5.27, "emotion": "proud", "text": "ಹನ್ನೆರಡು ಬಾಟಲ್! ಒಂದು ಸ್ನಾನಕ್ಕೆ... ಹನ್ನೊಂದು ಮತ್ತೆ ಸ್ನಾನಕ್ಕೆ!"}, {"id": 35, "duration_s": 1.62, "emotion": "curious", "text": "ಒಂದು ಬಾಟಲ್ ಎಷ್ಟು?"}, {"id": 36, "duration_s": 1.08, "emotion": "proud", "text": "ನೂರು!"}, {"id": 37, "duration_s": 2.792, "emotion": "calm", "text": "ಹಾಗಾದ್ರೆ ಬೇಡ. ಗಾಳಿ ಫ್ರೀ."}, {"id": 38, "duration_s": 3.38, "emotion": "mischievous", "text": "ಟೆನ್ಶನ್ ಬೇಡ! ಎಲ್ಲಾ ಬಾಟಲ್ ನಂಗೆ ಕೊಡಿ, ಡಬಲ್ ರೇಟಿಗೆ ಮಾರ್ತೀನಿ!"}, {"id": 39, "duration_s": 1.59, "emotion": "sarcastic", "text": "ನಾನೇ ಟ್ರಿಪಲ್ಲಿಗೆ ಮಾರ್ತೀನಿ."}, {"id": 40, "duration_s": 1.932, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪಾ!"}, {"id": 41, "duration_s": 1.84, "emotion": "embarrassed", "text": "ಇಪ್ಪತ್ತೇ ಇತ್ತು, ಇಪ್ಪತ್ತು!"}, {"id": 42, "duration_s": 3.0, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ನೀರು, ಚಿನ್ನಕ್ಕಿಂತ ದುಬಾರಿ!"}, {"id": 43, "duration_s": 3.13, "emotion": "proud", "text": "ಹನ್ನೆರಡು ಬಾಟಲ್ ನೀರು! ಇವತ್ತು ರಾಜನ ಹಾಗೆ ಸ್ನಾನ!"}, {"id": 44, "duration_s": 2.61, "emotion": "stern_warning", "text": "ರಾಜ ಅಲ್ಲ, ಪ್ರಜೆ ತರ. ಒಂದೇ ಚೊಂಬು."}, {"id": 45, "duration_s": 3.07, "emotion": "pleading", "text": "ಅರ್ಧ ಚೊಂಬಾ? ಇಷ್ಟೊಂದು ಸೋಪಿಗೆ?"}, {"id": 46, "duration_s": 3.84, "emotion": "proud", "text": "ನಮ್ ಕಾಲದಲ್ಲಿ ಅರ್ಧ ಚೊಂಬಲ್ಲಿ ದಿಬ್ಬಣ ಸ್ನಾನ!"}, {"id": 47, "duration_s": 4.35, "emotion": "proud", "text": "ಸರಿ! ನಂಗೆ ಯಾರ ಭಯ ಇಲ್ಲ! ಅರ್ಧ ಚೊಂಬು, ಬನ್ನಿ!"}, {"id": 48, "duration_s": 2.59, "emotion": "determined", "text": "ನಿಲ್ಲಿ! ಬೀಳೋ ನೀರು ತುಳಸಿಗೆ."}, {"id": 49, "duration_s": 2.16, "emotion": "surprised", "text": "ಅಪ್ಪಾ, ಸೋಪು ನೀರೆಲ್ಲ ಕುಡೀತು!"}, {"id": 50, "duration_s": 3.2, "emotion": "stern_warning", "text": "ಎರಡನೇ ಚೊಂಬಾ? ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ತಿದೆ!"}, {"id": 51, "duration_s": 0.9, "emotion": "shocked", "text": "ಹ... ಹಲ್ಲಿ!"}, {"id": 52, "duration_s": 2.92, "emotion": "embarrassed", "text": "ನಂಗೆ ಭಯ ಇಲ್ಲ... ಅದರ ಬಾಯಾರಿಕೆ ಭಯ!"}, {"id": 53, "duration_s": 3.15, "emotion": "worried", "text": "ಅತ್ತೆ, ರಾತ್ರಿ ಟ್ಯಾಂಕ್ ತುಂಬಾ ತುಂಬಿತ್ತು."}, {"id": 54, "duration_s": 1.725, "emotion": "curious", "text": "ಮತ್ತೆ ಬೆಳಗ್ಗೆ ಎಲ್ಲಿ ಹೋಯ್ತು?"}, {"id": 55, "duration_s": 3.12, "emotion": "excited", "text": "ಒಂದ್ ಐಡಿಯಾ ಇದೆ! ನೀರಿನ ಡಿಟೆಕ್ಟಿವ್!"}, {"id": 56, "duration_s": 1.772, "emotion": "excited", "text": "ಡಿಟೆಕ್ಟಿವ್ಸ್, ರೆಡಿ?"}, {"id": 57, "duration_s": 2.38, "emotion": "stern_warning", "text": "ಸುಮ್ನಿರಿ! ಡಿಟೆಕ್ಟಿವ್ಸ್ ಮಾತಾಡಲ್ಲ."}, {"id": 58, "duration_s": 4.47, "emotion": "serious", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ನೀರನ್ನ ಹಿಂಬಾಲಿಸಿ... ಕಳ್ಳ ಸಿಗ್ತಾನೆ!"}, {"id": 59, "duration_s": 0.8, "emotion": "serious", "text": "ಒಂದು!"}, {"id": 60, "duration_s": 0.65, "emotion": "serious", "text": "ಎರ್ಡ್!"}, {"id": 61, "duration_s": 2.42, "emotion": "happy", "text": "ಈ ತೊಟ್ಟಿಕ್ಕೋ ನಲ್ಲಿ... ಭಾರೀ ಸಿಹಿ!"}, {"id": 62, "duration_s": 3.25, "emotion": "shocked", "text": "ಹದಿನಾಲ್ಕು ನಲ್ಲಿ ತೊಟ್ಟಿಕ್ತಿವೆ! ಹದಿನಾಲ್ಕು!"}, {"id": 63, "duration_s": 3.06, "emotion": "mischievous", "text": "ಈ ನೀರಿನ ನದಿ... ಎಲ್ಲಿಗೆ ಹೋಗ್ತಿದೆ?"}, {"id": 64, "duration_s": 4.64, "emotion": "proud", "text": "ಸೀನ ಕಾರ್ ವಾಶ್! ಕಾರು, ಸ್ಕೂಟರ್, ಎಮ್ಮೆ... ಎಲ್ಲಾ ತೊಳೆಯುತ್ತೆ!"}, {"id": 65, "duration_s": 1.84, "emotion": "angry", "text": "ಸುಮ್ನಿರು! ಪೈಪ್ ಬಂದ್ ಮಾಡು!"}, {"id": 66, "duration_s": 4.28, "emotion": "mischievous", "text": "ಬಂದ್? ಇದು ಬಿಸಿನೆಸ್! ನೀರು ಫ್ರೀ, ಲಾಭ ಪೂರ್ತಿ!"}, {"id": 67, "duration_s": 3.58, "emotion": "serious", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಈ ಪೈಪ್ ಬೆಳಗ್ಗೆ ಐದರಿಂದ ಓಡ್ತಿದೆ."}, {"id": 68, "duration_s": 1.57, "emotion": "shocked", "text": "ಅದಕ್ಕೇ ನಮ್ ಟ್ಯಾಂಕ್ ಖಾಲಿ!"}, {"id": 69, "duration_s": 3.62, "emotion": "calm", "text": "ಟೆನ್ಶನ್ ಬೇಡ! ನೀರು ನಂದಲ್ಲ, ಕಾಲೋನಿದು!"}, {"id": 70, "duration_s": 1.52, "emotion": "angry", "text": "ಅದಕ್ಕೇ ತಾನೇ ಟೆನ್ಶನ್!"}, {"id": 71, "duration_s": 3.58, "emotion": "shouting", "text": "ತನಿಖೆ ಆಗ್ಲಿ! ಯಾರು?"}, {"id": 72, "duration_s": 3.35, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ... ಗಾಳಿ ಜೊತೆ ನೀರು, ಮಳೆ ಸಮ!"}, {"id": 73, "duration_s": 1.76, "emotion": "stern_warning", "text": "ಸುಮ್ನಿರು! ನೋಡೋಣ."}, {"id": 74, "duration_s": 3.15, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ಕಾಲೋನಿಯ ಮೊದಲ ಮಳೆ!"}, {"id": 75, "duration_s": 4.82, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ... ಮಳೆ ವಿಜ್ಞಾನಿಗಳ ಮೇಲೆ ಮಾತ್ರ ಬೀಳುತ್ತೆ."}, {"id": 76, "duration_s": 6.387, "emotion": "sad", "text": "ಗ್ನಾನಿ ಸ್ನಾನ ಮಾಡ್ಬಿಟ್ಟ? ನಾನಿನ್ನೂ ಸೋಪಲ್ಲೇ ಇದೀನಿ!"}, {"id": 77, "duration_s": 3.22, "emotion": "laughing", "text": "<laugh> ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ತಿದೆ... ಗ್ನಾನಿ ಸ್ನಾನ!"}, {"id": 78, "duration_s": 3.644, "emotion": "sarcastic", "text": "ಇನ್ನೊಂದು ಬಕೆಟ್ ಹೋಯ್ತು. ಹದಿನೈದನೇ ನಲ್ಲಿ!"}, {"id": 79, "duration_s": 2.83, "emotion": "embarrassed", "text": "ಅದು... ಸ್ವಲ್ಪ ಕ್ಯಾಲಿಬ್ರೇಶನ್ ಬಾಕಿ ಇದೆ."}, {"id": 80, "duration_s": 1.56, "emotion": "panicked", "text": "ಕೇಳಿದ್ರಾ? ಕೊನೇ ಟ್ಯಾಂಕರ್!"}, {"id": 81, "duration_s": 4.15, "emotion": "excited", "text": "ಶುರುವಾಯ್ತು... ಕಾಲೋನಿಯ ಅತಿ ದೊಡ್ಡ ಬಕೆಟ್ ರೇಸ್!"}, {"id": 82, "duration_s": 1.69, "emotion": "determined", "text": "ಈ ಸಲ ಬಕೆಟ್ ನಮ್ದೇ!"}, {"id": 83, "duration_s": 0.89, "emotion": "excited", "text": "ಹೊರಡೋಣ!"}, {"id": 84, "duration_s": 1.98, "emotion": "sad", "text": "ಅಯ್ಯೋ... ಇವತ್ತೂನಾ?"}, {"id": 85, "duration_s": 2.19, "emotion": "curious", "text": "ಯಾರಾದ್ರೂ ಹೇಳ್ತೀರಾ... ನಾನೆಲ್ಲಿ?"}, {"id": 86, "duration_s": 1.11, "emotion": "angry", "text": "ನನ್ ಬಕೆಟ್ಟಿಂದ ಇಳೀರಿ!"}, {"id": 87, "duration_s": 4.47, "emotion": "sarcastic", "text": "ಇದು ಬಕೆಟ್ ಅಲ್ಲ... ದೊಡ್ಡಣ್ಣ!"}, {"id": 88, "duration_s": 11.92, "emotion": "shouting", "text": "ತನಿಖೆ ಆಗುತ್ತೆ! ನಿಲ್ಲಿ! ಇಲ್ಲ, ಹೋಗಿ! ಇಲ್ಲ, ನಿಲ್ಲಿ!"}, {"id": 89, "duration_s": 1.62, "emotion": "excited", "text": "ಲೈವ್! ಬಕೆಟ್ ಜಾಮ್, ನೂರು ಮೀಟರ್ ಉದ್ದ!"}, {"id": 90, "duration_s": 1.34, "emotion": "angry", "text": "ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ತಿದೆ... ಯಾರೂ ಕದಲ್ತಿಲ್ಲ!"}, {"id": 91, "duration_s": 2.21, "emotion": "excited", "text": "ಪಾರಿವಾಳಣ್ಣ, ಕೇಳಿದ್ರಾ...? ಅರೆ!"}, {"id": 92, "duration_s": 1.24, "emotion": "shouting", "text": "ಸುಮ್ನಿರಿ!!!"}, {"id": 93, "duration_s": 4.01, "emotion": "serious", "text": "ನೀರಿಗಾಗಿ ಜಗಳ... ನಲ್ಲಿಗಳು ಇನ್ನೂ ತೊಟ್ಟಿಕ್ತಿವೆ!"}, {"id": 94, "duration_s": 2.07, "emotion": "determined", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಲೆಕ್ಕ ನೋಡಿ!"}, {"id": 95, "duration_s": 3.75, "emotion": "stern_warning", "text": "ಶಾಂತಿ! ಇವತ್ತಿನ ಕ್ಲಾಸ್... ನೀರು!"}, {"id": 96, "duration_s": 3.93, "emotion": "serious", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಒಂದು ನಲ್ಲಿ, ಪ್ರತಿ ಸೆಕೆಂಡಿಗೆ ಒಂದು ಹನಿ."}, {"id": 97, "duration_s": 1.71, "emotion": "excited", "text": "ಹನಿ? ಜೇನು ಎಲ್ಲಿ?"}, {"id": 98, "duration_s": 2.14, "emotion": "sarcastic", "text": "ಜೇನಲ್ಲ, ನೀರ ಹನಿ!"}, {"id": 99, "duration_s": 6.04, "emotion": "proud", "text": "ಒಂದು ನಲ್ಲಿ, ಒಂದು ತಿಂಗಳು... ಅರವತ್ತು ಬಕೆಟ್!"}, {"id": 100, "duration_s": 2.34, "emotion": "shocked", "text": "<gasp> ಅರ್ವತ್ತಾ? ಅಯ್ಯೋ!"}, {"id": 101, "duration_s": 4.6, "emotion": "shocked", "text": "ಹದ್ನಾಲ್ಕು ಅರ್ವತ್ತು... ಎಂಟ್ನೂರ ನಲವತ್ತು ಬಕೆಟ್!"}, {"id": 102, "duration_s": 2.46, "emotion": "mischievous", "text": "ಅಷ್ಟು ಬಾಟಲ್ ಮಾರಿದ್ರೆ..."}, {"id": 103, "duration_s": 1.4, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪಾ!"}, {"id": 104, "duration_s": 6.6, "emotion": "serious", "text": "ಮತ್ತೆ ಸೀನ ಮಾಮನ ಪೈಪ್... ಒಂದು ಗಂಟೇಲಿ ಐವತ್ತು ಬಕೆಟ್!"}, {"id": 105, "duration_s": 2.49, "emotion": "embarrassed", "text": "ಟೆನ್ಶನ್... ಸ್ವಲ್ಪ ಸ್ವಲ್ಪ ಆಗ್ತಿದೆ."}, {"id": 106, "duration_s": 4.75, "emotion": "calm", "text": "ಮೇಡಂ, ಲೈನ್ ರಿಪೇರಿ ಐತ್ರಿ. ಸಂಜೀ ತನಕ ನೀರು ಬರ್ತೈತಿ."}, {"id": 107, "duration_s": 2.42, "emotion": "embarrassed", "text": "ಸಂಜೆ ತನಕ? ಮೂರು ದಿನ ಅಲ್ವಾ?"}, {"id": 108, "duration_s": 1.41, "emotion": "sarcastic", "text": "ಮೂರ್ ದಿನಾ ಯಾರ್ ಅಂದ್ರೀ?"}, {"id": 109, "duration_s": 5.814, "emotion": "guilty", "text": "ಅಂದ್ರೆ ನೀರು ನಿಂತಿಲ್ಲ... ನಾವೇ ಹರಿಸಿಬಿಟ್ವಿ!"}, {"id": 110, "duration_s": 2.98, "emotion": "serious", "text": "ಹದಿನಾಲ್ಕು ನಲ್ಲಿ, ಒಂದು ಪೈಪ್, ಒಂದು ಬಾತ್‌ಟಬ್..."}, {"id": 111, "duration_s": 2.24, "emotion": "mischievous", "text": "ಮತ್ತೆ ಸೋಪಿನ ಅಪ್ಪ ಒಬ್ರು!"}, {"id": 112, "duration_s": 1.93, "emotion": "determined", "text": "ಸಾಕು! ಈಗ ನಾವೆಲ್ಲಾ ನೋಡ್ತೀವಿ."}, {"id": 113, "duration_s": 0.96, "emotion": "determined", "text": "ಹತ್ತು ಸೆಕೆಂಡ್."}, {"id": 114, "duration_s": 2.84, "emotion": "proud", "text": "ಒಂಬತ್ತು ಸೆಕೆಂಡ್! ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ತಿದೆ!"}, {"id": 115, "duration_s": 2.21, "emotion": "proud", "text": "ಇದು ನನ್ ಎಡಗೈ ಆಟ ಕಣ್ರೀ!"}, {"id": 116, "duration_s": 3.25, "emotion": "relieved", "text": "ಆಹಾ... ಸ್ನಾನ ಆಯ್ತು! ಕೊನೆಗೂ!"}, {"id": 117, "duration_s": 2.5, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಶಿವಣ್ಣ ಸ್ನಾನ ಮಾಡಿದ್ರು!"}, {"id": 118, "duration_s": 4.024, "emotion": "happy", "text": "ಒಂದು ಬಕೆಟ್, ಒಂದು ಬಟ್ಟೆ... ಕಾರ್ ಥಳಥಳ!"}, {"id": 119, "duration_s": 2.44, "emotion": "laughing", "text": "<laugh> ಎಮ್ಮೆಯೂ! ಬಕೆಟ್ನಲ್ಲಿ!"}, {"id": 120, "duration_s": 3.66, "emotion": "proud", "text": "ತೊಟ್ಟಿಕ್ಕಿದ ನೀರೂ ನಂದೇ! ಒಂದ್ ಹನಿ ವ್ಯರ್ಥ ಇಲ್ಲ!"}, {"id": 121, "duration_s": 3.47, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ... ತೊಟ್ಟಿಕ್ಕೋ ನಲ್ಲಿ ರಿಪೇರಿ ಮಾಡಿ."}, {"id": 122, "duration_s": 3.19, "emotion": "surprised", "text": "ಗ್ನಾನಿ ಅಣ್ಣ... ಮೊದಲ ಸಲ ಸರಿ!"}, {"id": 123, "duration_s": 2.86, "emotion": "sad", "text": "ಸಿಹಿ ನಲ್ಲಿ... ನಿವೃತ್ತಿ ಆಯ್ತು."}, {"id": 124, "duration_s": 2.54, "emotion": "happy", "text": "ಮಾಳಿಗೆ ನೀರು, ಸೀದಾ ಡ್ರಮ್ಮಿಗೆ!"}, {"id": 125, "duration_s": 2.27, "emotion": "loving", "text": "ಇನ್ಮೇಲೆ ಮಳೆಗೆ ದೃಷ್ಟಿ ಆಗಲ್ಲ."}, {"id": 126, "duration_s": 2.48, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಿದೆ! ಹ್ಯಾಷ್‌ಟ್ಯಾಗ್ ಹನಿ ಉಳಿಸಿ!"}, {"id": 127, "duration_s": 6.77, "emotion": "happy", "text": "ಆ ದಿನ ಹದಿನಾಲ್ಕು ನಲ್ಲಿ ರಿಪೇರಿ... ಒಬ್ಬ ಅಪ್ಪ ಸ್ನಾನ."}, {"id": 128, "duration_s": 2.12, "emotion": "calm", "text": "ಸಂಜೆ ಆಯ್ತು... ನಲ್ಲಿಗಳಲ್ಲಿ ಮತ್ತೆ ನೀರು ಬಂತು."}, {"id": 129, "duration_s": 2.93, "emotion": "proud", "text": "ಇವತ್ತಿಂದ ಶಿವಣ್ಣ... ಒಂದು ಬಕೆಟ್ಟಲ್ಲಿ ಸ್ನಾನ!"}, {"id": 130, "duration_s": 0.82, "emotion": "stern_warning", "text": "ಅರ್ಧ."}, {"id": 131, "duration_s": 2.59, "emotion": "calm", "text": "ಹನಿ ಹನಿ ಗೂಡಿದರೆ ಹಳ್ಳ..."}, {"id": 132, "duration_s": 3.0, "emotion": "serious", "text": "...ಹನಿ ಹನಿಯಿಂದ್ಲೇ ಬತ್ತೂ ಹೋಗುತ್ತೆ."}, {"id": 133, "duration_s": 4.955, "emotion": "serious", "text": "ತೊಟ್ಟಿಕ್ಕೋ ನಲ್ಲಿ ಇವತ್ತೇ ರಿಪೇರಿ ಮಾಡಿ... ನಾಳೆ ಅಲ್ಲ."}, {"id": 134, "duration_s": 2.53, "emotion": "calm", "text": "ಆಕಾಶದ ನೀರು... ಡ್ರಮ್ಮಿಗೆ."}, {"id": 135, "duration_s": 1.26, "emotion": "determined", "text": "ಕಾರು ಬಕೆಟ್ಟಲ್ಲಿ!"}, {"id": 136, "duration_s": 1.26, "emotion": "determined", "text": "ಪೈಪ್ ಓಪನ್ ಇಲ್ಲ!"}, {"id": 137, "duration_s": 2.52, "emotion": "proud", "text": "ಮತ್ತೆ ಮಳೆ ನೀರು... ಮಾಳಿಗೇಲಿ!"}, {"id": 138, "duration_s": 1.69, "emotion": "excited", "text": "ಮಳೆ! ಮಳೆ!"}, {"id": 139, "duration_s": 3.19, "emotion": "excited", "text": "ಫ್ರೀ ಶಾವರ್! ದೇವ್ರೇ, ಚಾಲೂ ಮಾಡು!"}]