[{"id": 1, "duration_s": 3.31, "emotion": "mischievous", "text": "தீபாவளி இரவு... காலனியே ஜொலிக்குது..."}, {"id": 2, "duration_s": 3.87, "emotion": "sarcastic", "text": "...எல்லாரும் ஒரே க்யூல, ஒரே டான்ஸ்!"}, {"id": 3, "duration_s": 2.54, "emotion": "comic_panic", "text": "கேட்டியா? என் வயித்துல பட்டாசு வெடிக்குது!"}, {"id": 4, "duration_s": 3.85, "emotion": "worried", "text": "கண்ணு பட்டுடுச்சு! பாத்ரூமுக்கே கண்ணு பட்டுடுச்சு!"}, {"id": 5, "duration_s": 4.77, "emotion": "determined", "text": "வயிறு வலிக்குது... ஆனா பசிக்குதே!"}, {"id": 6, "duration_s": 1.94, "emotion": "comic_panic", "text": "உள்ள யாரு? சீக்கிரம்!"}, {"id": 7, "duration_s": 1.42, "emotion": "calm", "text": "டென்ஷன் ஆகாதீங்க!"}, {"id": 8, "duration_s": 3.32, "emotion": "calm", "text": "இதெல்லாம் ஆரம்பிச்சது... மூணு நாள் முன்னாடி."}, {"id": 9, "duration_s": 2.59, "emotion": "mischievous", "text": "ஓவரா மின்னுன ஒரு ஸ்வீட்டால!"}, {"id": 10, "duration_s": 3.21, "emotion": "happy", "text": "தீபாவளி வாரம். காலனியே அலங்காரம்!"}, {"id": 11, "duration_s": 3.61, "emotion": "proud", "text": "மெகா சேல்! முந்திரி கட்லி பாதி விலை!"}, {"id": 12, "duration_s": 3.14, "emotion": "excited", "text": "மின்னுற ஸ்வீட்! பசிக்குதே!"}, {"id": 13, "duration_s": 5.06, "emotion": "mischievous", "text": "கந்தசாமி! இருநூறு டப்பா, பாதி விலை, நிஜ வெள்ளி!"}, {"id": 14, "duration_s": 2.37, "emotion": "excited", "text": "மலிவு மாலு, மலை லாபம்!"}, {"id": 15, "duration_s": 3.14, "emotion": "stern_warning", "text": "கந்தசாமி! பாதி விலைல வெள்ளியா?"}, {"id": 16, "duration_s": 2.66, "emotion": "proud", "text": "ராஜாத்தி, இது தீபாவளி அதிர்ஷ்டம்மா!"}, {"id": 17, "duration_s": 0.78, "emotion": "excited", "text": "ஒரு ஐடியா!"}, {"id": 18, "duration_s": 3.84, "emotion": "excited", "text": "பட்டம்மா! காமாட்சி தட்டை விட பெரிசு, பாதிக்கு!"}, {"id": 19, "duration_s": 5.29, "emotion": "mischievous", "text": "இந்த தடவை என் தட்டு... காலனியே வாயப் பொளக்கும்!"}, {"id": 20, "duration_s": 4.62, "emotion": "serious", "text": "அத்தை, பாதி விலைல முந்திரி கட்லியா? ஏதோ இடிக்குதே."}, {"id": 21, "duration_s": 2.77, "emotion": "proud", "text": "இடிக்கல, இது சிக்கனம்!"}, {"id": 22, "duration_s": 2.71, "emotion": "mischievous", "text": "அப்புறம் தொடங்குச்சு... தட்டுப் போர்!"}, {"id": 23, "duration_s": 2.4, "emotion": "proud", "text": "அஞ்சு டப்பா! பெரிசு பெரிசா!"}, {"id": 24, "duration_s": 1.77, "emotion": "proud", "text": "ஒரு ரூபா கூட கம்மி இல்ல!"}, {"id": 25, "duration_s": 2.73, "emotion": "shocked", "text": "கேட்டியா? பட்டம்மா அஞ்சு டப்பா வாங்குனா!"}, {"id": 26, "duration_s": 3.15, "emotion": "proud", "text": "ஆறு டப்பா, கந்தசாமி! ஆறு!"}, {"id": 27, "duration_s": 1.0, "emotion": "determined", "text": "ஏழு!"}, {"id": 28, "duration_s": 2.59, "emotion": "excited", "text": "டென்ஷன் வேணாம்! சேகரோட பிரீமியம் ஹேம்பர்!"}, {"id": 29, "duration_s": 2.45, "emotion": "mischievous", "text": "டபுள் ரேட், மாமி... டபுள் மரியாதை!"}, {"id": 30, "duration_s": 3.24, "emotion": "worried", "text": "இவ்ளோ ஸ்வீட்டா! கண்ணு பட்டுடும்!"}, {"id": 31, "duration_s": 1.78, "emotion": "proud", "text": "காலனியே பாக்கும்!"}, {"id": 32, "duration_s": 3.61, "emotion": "proud", "text": "நான் யாருக்கும் பயப்பட மாட்டேன்! காமாட்சி மாமிக்கும் கூட!"}, {"id": 33, "duration_s": 3.18, "emotion": "curious", "text": "பாதி விலைல வெள்ளியா? டவுட்டு!"}, {"id": 34, "duration_s": 3.527, "emotion": "sarcastic", "text": "பெரிசுகளை யார் திருத்த?"}, {"id": 35, "duration_s": 4.6, "emotion": "giggly", "text": "ஸ்கோர்? பன்னிரண்டு, பன்னிரண்டு டப்பா. போட்டி சமம்!"}, {"id": 36, "duration_s": 4.81, "emotion": "stern_warning", "text": "பொண்டா, நீதான் காவல். ஒரு துண்டு கூட கூடாது!"}, {"id": 37, "duration_s": 1.66, "emotion": "determined", "text": "ஒரு துண்டும் இல்ல!"}, {"id": 38, "duration_s": 1.98, "emotion": "proud", "text": "என் கோலம்தான் பெருசு."}, {"id": 39, "duration_s": 2.24, "emotion": "sarcastic", "text": "என் கோலத்துல கலர் ஜாஸ்தி."}, {"id": 40, "duration_s": 3.88, "emotion": "serious", "text": "விசாரணை நடக்கும்! ஸ்வீட் பாதுகாப்பு!"}, {"id": 41, "duration_s": 2.947, "emotion": "excited", "text": "ஸ்வீட்டா...?"}, {"id": 42, "duration_s": 1.32, "emotion": "happy", "text": "முடிஞ்சது."}, {"id": 43, "duration_s": 2.15, "emotion": "shocked", "text": "பொண்டா! தட்டுங்கல்லாம் எங்கடா?"}, {"id": 44, "duration_s": 3.59, "emotion": "guilty", "text": "அது... கண்ணு பட்டுடுச்சு!"}, {"id": 45, "duration_s": 1.79, "emotion": "excited", "text": "பாத்தியா! நான் சொன்னேனே!"}, {"id": 46, "duration_s": 1.49, "emotion": "excited", "text": "ஹேம்பர் வாங்கிக்கோங்க! ஊருக்கே!"}, {"id": 47, "duration_s": 2.89, "emotion": "serious", "text": "இப்போ கந்தசாமி ஸ்வீட்... ஒவ்வொரு வீட்டுலயும்."}, {"id": 48, "duration_s": 2.02, "emotion": "excited", "text": "ஹாய் கைஸ்! லைவ்-ல இருக்கோம்!"}, {"id": 49, "duration_s": 2.99, "emotion": "sarcastic", "text": "இவ்ளோ பச்சை... இலைகள்ல கூட இருக்காது."}, {"id": 50, "duration_s": 2.68, "emotion": "excited", "text": "ஸ்வீட் முக்பாங்! இன்னிக்கு பர்பி... நியான் கிரீன்!"}, {"id": 51, "duration_s": 4.91, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது... எவ்ளோ கலர், அவ்ளோ வைட்டமின்!"}, {"id": 52, "duration_s": 1.84, "emotion": "happy", "text": "கேட்டீங்களா கைஸ்? ஹெல்தி!"}, {"id": 53, "duration_s": 3.13, "emotion": "serious", "text": "பச்சை நாக்கா? சயின்ஸ் சொல்லுது... இது பசுமை!"}, {"id": 54, "duration_s": 3.9, "emotion": "shocked", "text": "கைஸ், நாக்கு நீலமாயிடுச்சு! புது ஃபில்டரா?"}, {"id": 55, "duration_s": 3.387, "emotion": "embarrassed", "text": "சயின்ஸ் சொல்லுது... இது வயித்து வலி!"}, {"id": 56, "duration_s": 2.88, "emotion": "proud", "text": "ரெண்டு லட்சம் வியூஸ்! நீல பர்பி சாப்பிடுங்க!"}, {"id": 57, "duration_s": 3.91, "emotion": "happy", "text": "தீபாவளி சாயங்காலம். பட்டம்மாவோட ஸ்வீட் பார்ட்டி!"}, {"id": 58, "duration_s": 3.79, "emotion": "proud", "text": "வாங்க வாங்க! காலனியே பாக்கும்... சாப்பிடும்!"}, {"id": 59, "duration_s": 4.082, "emotion": "sarcastic", "text": "பட்டம்மா, உங்க கட்லி ஏன் கண்ணைக் கூசுது?"}, {"id": 60, "duration_s": 3.02, "emotion": "proud", "text": "நிஜ வெள்ளி! பாதி விலையில!"}, {"id": 61, "duration_s": 1.2, "emotion": "proud", "text": "என்னதும்!"}, {"id": 62, "duration_s": 3.2, "emotion": "curious", "text": "வாத்தியார் வேலு, இந்த ஸ்வீட் சுத்தமா?"}, {"id": 63, "duration_s": 2.96, "emotion": "happy", "text": "சத்தமா? ஆமா ஆமா, ரொம்ப நல்லா இருக்கு!"}, {"id": 64, "duration_s": 2.34, "emotion": "shocked", "text": "சத்தம் இல்ல வாத்தியார் வேலு... ஸ்வீட்!"}, {"id": 65, "duration_s": 2.93, "emotion": "excited", "text": "வெடி சூப்பர், பர்பி சூப்பர்! அடடா!"}, {"id": 66, "duration_s": 3.26, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது... மின்னுனா ஃப்ரெஷ்!"}, {"id": 67, "duration_s": 2.27, "emotion": "proud", "text": "நான் எந்த ஸ்வீட்டுக்கும் பயப்படமாட்டேன்!"}, {"id": 68, "duration_s": 3.16, "emotion": "happy", "text": "இடி இடிக்குதா? தீபாவளிக்கு மழையா!"}, {"id": 69, "duration_s": 2.12, "emotion": "comic_panic", "text": "கேட்டியா? என் வயிறும் ஏதோ சொல்லுது!"}, {"id": 70, "duration_s": 4.15, "emotion": "giggly", "text": "அப்புறம்... காலனி வயிறு மொத்தமும் ஒண்ணா பேசுச்சு."}, {"id": 71, "duration_s": 3.56, "emotion": "sarcastic", "text": "பதினாலு பேர். ஒரே பாத்ரூம்."}, {"id": 72, "duration_s": 3.32, "emotion": "comic_panic", "text": "நான் யாருக்கும் பயப்படமாட்டேன்... சீக்கிரம்!"}, {"id": 73, "duration_s": 1.71, "emotion": "stern_warning", "text": "கந்தசாமி! லைன்ல!"}, {"id": 74, "duration_s": 2.58, "emotion": "pleading", "text": "முன்ன போக... ரெண்டு ரூபா?"}, {"id": 75, "duration_s": 4.12, "emotion": "sarcastic", "text": "காமாட்சி, உன் வயிறு என் வயித்தை விட சத்தம் ஜாஸ்தி."}, {"id": 76, "duration_s": 1.9, "emotion": "comic_panic", "text": "லைவ்-ல இருக்கோம்... பாத்ரூம் க்யூல இருந்து!"}, {"id": 77, "duration_s": 1.97, "emotion": "determined", "text": "போதும்! இப்போ நான் பாக்கறேன்."}, {"id": 78, "duration_s": 3.65, "emotion": "serious", "text": "ஒரு லிட்டர் ஆறின தண்ணி, ஆறு ஸ்பூன் சர்க்கரை..."}, {"id": 79, "duration_s": 2.42, "emotion": "serious", "text": "...அரை ஸ்பூன் உப்பு. மெதுவா குடிங்க."}, {"id": 80, "duration_s": 3.78, "emotion": "worried", "text": "ரெண்டு எலுமிச்சை பத்தல... மூணாவது!"}, {"id": 81, "duration_s": 1.94, "emotion": "calm", "text": "ரெண்டே நிமிஷம்... டென்ஷன் வேணாம்!"}, {"id": 82, "duration_s": 4.58, "emotion": "crying", "text": "சேகர், உன் ரெண்டு நிமிஷம்... சீரியலை விட நீளம்!"}, {"id": 83, "duration_s": 2.39, "emotion": "guilty", "text": "கடைசி... சத்தியமா."}, {"id": 84, "duration_s": 2.41, "emotion": "determined", "text": "மருந்துக்கடை! போலாம் ரைட்!"}, {"id": 85, "duration_s": 2.47, "emotion": "tired", "text": "விசாரணை... நடந்தே!"}, {"id": 86, "duration_s": 3.07, "emotion": "curious", "text": "எல்லாருக்கும் வலி... நாம மூணு பேர் ஏன் ஓகே?"}, {"id": 87, "duration_s": 2.84, "emotion": "proud", "text": "ஏன்னா செல்வி ஆன்ட்டி வீட்டு லட்டு சாப்பிட்டோம்!"}, {"id": 88, "duration_s": 3.89, "emotion": "determined", "text": "இதோ ஆதாரம். நாளைக்கு காலைல... சயின்ஸ் டெஸ்ட்!"}, {"id": 89, "duration_s": 3.02, "emotion": "sarcastic", "text": "பட்டாசு கம்மி... வயிறு ஜாஸ்தி வெடிச்சது!"}, {"id": 90, "duration_s": 2.8, "emotion": "curious", "text": "மறுநாள் காலை. ரவியோட லேப்."}, {"id": 91, "duration_s": 3.31, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது... மின்னுனா ஃப்ரெஷ்!"}, {"id": 92, "duration_s": 1.41, "emotion": "angry", "text": "என் ஸ்வீட் நிஜம்!"}, {"id": 93, "duration_s": 1.55, "emotion": "angry", "text": "என்னது ஜாஸ்தி நிஜம்!"}, {"id": 94, "duration_s": 2.49, "emotion": "shouting", "text": "சைலன்ஸ்! ரவி பேசறான்!"}, {"id": 95, "duration_s": 1.8, "emotion": "proud", "text": "சொல்லவா? ஸ்கூல் டெஸ்ட்தான்."}, {"id": 96, "duration_s": 2.78, "emotion": "stern_warning", "text": "அயோடின் காயத்துக்கு... சாப்பிட இல்ல!"}, {"id": 97, "duration_s": 3.95, "emotion": "serious", "text": "நீலக்கருப்பு ஸ்டார்ச். மைதா கலந்திருக்காங்க!"}, {"id": 98, "duration_s": 3.54, "emotion": "serious", "text": "நிஜ கோவால ஸ்டார்ச் இல்ல... நிறம் பழுப்பாவே இருக்கும்."}, {"id": 99, "duration_s": 2.653, "emotion": "serious", "text": "நிஜ வெள்ளி வர்க்கம்... தேச்சா பொடியாயிடும்."}, {"id": 100, "duration_s": 3.3, "emotion": "stern_warning", "text": "இது ஒட்டிக்கிச்சு, மின்னிக்கிட்டே இருக்கு... போலி பேப்பர்!"}, {"id": 101, "duration_s": 1.09, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது..."}, {"id": 102, "duration_s": 1.22, "emotion": "stern_warning", "text": "அமைதி!"}, {"id": 103, "duration_s": 2.79, "emotion": "serious", "text": "இவ்ளோ பளீர் கலரா? ஆபத்து மணி."}, {"id": 104, "duration_s": 1.92, "emotion": "stern_warning", "text": "டெஸ்ட் ஸ்வீட்... சாப்பிடக்கூடாது!"}, {"id": 105, "duration_s": 3.3, "emotion": "proud", "text": "சபாஷ் ரவி! டெஸ்ட் துண்டுகள் குப்பைத் தொட்டிக்கு."}, {"id": 106, "duration_s": 3.78, "emotion": "embarrassed", "text": "நான்... சத்தம்னு நெனச்சு சாப்பிட்டுட்டேன்!"}, {"id": 107, "duration_s": 3.27, "emotion": "serious", "text": "தெரிஞ்ச கடை, டப்பாவுல தேதி, லைசென்ஸ்."}, {"id": 108, "duration_s": 3.29, "emotion": "guilty", "text": "நான் காமாட்சியோட தட்டை தான் பாத்தேன்."}, {"id": 109, "duration_s": 1.98, "emotion": "determined", "text": "வாங்க! கந்தசாமி கடைக்கு!"}, {"id": 110, "duration_s": 2.94, "emotion": "mischievous", "text": "காலனியே கிளம்புச்சு... கந்தசாமி கடைக்கு!"}, {"id": 111, "duration_s": 3.47, "emotion": "comic_panic", "text": "ஹலோ! உன் நிஜ வெள்ளி... போலியா இருக்கே!"}, {"id": 112, "duration_s": 2.79, "emotion": "mischievous", "text": "யார் கந்தசாமி? ராங் நம்பர் ஆச்சே!"}, {"id": 113, "duration_s": 3.58, "emotion": "sad", "text": "என்னையும் ஏமாத்திட்டாங்க... மலிவு ஆசைல."}, {"id": 114, "duration_s": 5.46, "emotion": "stern_warning", "text": "கந்தசாமி! எல்லா டப்பாவும் திரும்ப. எல்லா ரூபாயும் திரும்ப."}, {"id": 115, "duration_s": 3.45, "emotion": "pleading", "text": "ராஜாத்தி... கொஞ்சம் கம்மியா?"}, {"id": 116, "duration_s": 1.52, "emotion": "angry", "text": "ஒரு ரூபா கம்மி இல்ல!"}, {"id": 117, "duration_s": 3.11, "emotion": "crying", "text": "டாட்டா... என் செல்லக் காசுகளே."}, {"id": 118, "duration_s": 1.49, "emotion": "mischievous", "text": "டென்ஷன் வேணாம்... நான் எஸ்கேப்!"}, {"id": 119, "duration_s": 1.72, "emotion": "sarcastic", "text": "டபுள் ரேட் வாங்கின... டபுளா திருப்பு."}, {"id": 120, "duration_s": 4.98, "emotion": "sad", "text": "மெகா சேல்... மெகா ஃபெயில்."}, {"id": 121, "duration_s": 3.83, "emotion": "happy", "text": "இந்த தடவை ஸ்வீட்... வீட்டுலயே!"}, {"id": 122, "duration_s": 4.48, "emotion": "happy", "text": "கடலை மாவு, நெய், சர்க்கரை... வேற இல்ல!"}, {"id": 123, "duration_s": 3.27, "emotion": "loving", "text": "பட்டம்மா, என் தேங்காய் பர்பி... வீட்டுல செஞ்சது."}, {"id": 124, "duration_s": 2.52, "emotion": "happy", "text": "இந்த தடவை தட்டு ஒண்ணு... ரெண்டு பேருக்கும்!"}, {"id": 125, "duration_s": 2.25, "emotion": "giggly", "text": "கேட்டியா? நாங்க ஃப்ரெண்ட்ஸ் ஆயிட்டோம்!"}, {"id": 126, "duration_s": 3.12, "emotion": "excited", "text": "ஒரு ஐடியா இருக்கு! ராட்சச லட்டு!"}, {"id": 127, "duration_s": 1.81, "emotion": "sarcastic", "text": "உஷ்! உருண்டை பண்ணு!"}, {"id": 128, "duration_s": 3.02, "emotion": "giggly", "text": "பொண்டா, இன்னிக்கு முதல் நீ... டேஸ்டர்!"}, {"id": 129, "duration_s": 3.7, "emotion": "excited", "text": "இந்த வேலை... எனக்காகவே பொறந்தது!"}, {"id": 130, "duration_s": 1.8, "emotion": "proud", "text": "குவாலிட்டி செக்... நடந்துட்டிருக்கு."}, {"id": 131, "duration_s": 3.67, "emotion": "happy", "text": "அப்புறம் வந்துச்சு... சுத்தமான, இனிப்பான தீபாவளி!"}, {"id": 132, "duration_s": 3.0, "emotion": "proud", "text": "காலனியே பாக்கும்... ஒரே தட்டு!"}, {"id": 133, "duration_s": 0.87, "emotion": "embarrassed", "text": "இந்த தடவை... ஃப்ரீ!"}, {"id": 134, "duration_s": 4.62, "emotion": "worried", "text": "கந்தசாமி, இலவசமா? வாங்க... டாக்டர்கிட்ட போலாம்!"}, {"id": 135, "duration_s": 3.28, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது... வீட்டு ஸ்வீட் தான் பெஸ்ட்!"}, {"id": 136, "duration_s": 3.95, "emotion": "proud", "text": "இந்த தடவை சரியா கேட்டுச்சு... ஸ்வீட் சுத்தம்!"}, {"id": 137, "duration_s": 1.75, "emotion": "curious", "text": "தாத்தா! இன்னிக்கு பாடம்?"}, {"id": 138, "duration_s": 3.98, "emotion": "calm", "text": "மலிவு பாத்து இல்ல... சுத்தம் பாத்து வாங்குங்க."}, {"id": 139, "duration_s": 1.82, "emotion": "happy", "text": "ஹேப்பி தீபாவளி!"}]