[{"id": 1, "duration_s": 9.982, "emotion": "mischievous", "text": "ৰাতি দুইটা... গোটেই চুবুৰী টোপনিত।"}, {"id": 2, "duration_s": 3.56, "emotion": "mischievous", "text": "এজন বাদে।"}, {"id": 3, "duration_s": 6.44, "emotion": "angry", "text": "মোৰ কাণত বিমানবন্দৰ?"}, {"id": 4, "duration_s": 1.56, "emotion": "proud", "text": "মই কাকো নডৰোঁ!"}, {"id": 5, "duration_s": 3.11, "emotion": "giggly", "text": "দহ তালি... বিশ তালি... ত্ৰিশ তালি..."}, {"id": 6, "duration_s": 2.49, "emotion": "sarcastic", "text": "তালি কিয়? বৰযাত্ৰী আহিছে নেকি?"}, {"id": 7, "duration_s": 3.89, "emotion": "scared_whisper", "text": "চল্লিশতম... শেষৰটো।"}, {"id": 8, "duration_s": 0.63, "emotion": "giggly", "text": "চল্লিশ তালি। মহ: শূন্য। ৰমেশ: চল্লিশ।"}, {"id": 9, "duration_s": 7.17, "emotion": "determined", "text": "আঁতৰ! মোৰ চেণ্ডেলে ভুল নকৰে!"}, {"id": 10, "duration_s": 2.62, "emotion": "embarrassed", "text": "ভুল নহ'ল... মোকেই লাগিল!"}, {"id": 11, "duration_s": 2.82, "emotion": "proud", "text": "দেখিলি? নিশানা ঠিক!"}, {"id": 12, "duration_s": 2.76, "emotion": "mischievous", "text": "আৰু এইটো তো... মাত্ৰ আৰম্ভণি।"}, {"id": 13, "duration_s": 3.43, "emotion": "giggly", "text": "আৰু ৰাতিপুৱালৈ... গোটেই চুবুৰী চুলকি আছিল।"}, {"id": 14, "duration_s": 2.8, "emotion": "excited", "text": "শুনিছেনে? ৰাতি মহৰ সেনা আহিছিল!"}, {"id": 15, "duration_s": 2.63, "emotion": "mischievous", "text": "হৰি বৰুৱাই নিজকে চল্লিশ চৰ মাৰিলে!"}, {"id": 16, "duration_s": 3.02, "emotion": "embarrassed", "text": "মহ নহয়... হাতী আছিল!"}, {"id": 17, "duration_s": 2.27, "emotion": "sarcastic", "text": "হাতী নহয়, মাৰ চেণ্ডেল আছিল।"}, {"id": 18, "duration_s": 2.83, "emotion": "serious", "text": "নজৰ লাগিল! মহৰ নজৰ!"}, {"id": 19, "duration_s": 2.65, "emotion": "shocked", "text": "হায়! জলকীয়াও খালে!"}, {"id": 20, "duration_s": 3.51, "emotion": "stern_warning", "text": "সমুচা? ৰ'ব! তদন্ত হ'ব!"}, {"id": 21, "duration_s": 2.7, "emotion": "happy", "text": "তদন্ত শেষ। ভোক লাগে!"}, {"id": 22, "duration_s": 3.51, "emotion": "proud", "text": "বিজ্ঞানে কয়, মহ লেতেৰা নলাতহে ওপজে!"}, {"id": 23, "duration_s": 0.89, "emotion": "curious", "text": "মই কওঁনে?"}, {"id": 24, "duration_s": 2.38, "emotion": "proud", "text": "ল'ৰা মনে মনে! বিজ্ঞানে কৈছে।"}, {"id": 25, "duration_s": 3.44, "emotion": "proud", "text": "আমাৰ চুবুৰী চাফ, মহ বাহিৰৰ পৰা আহে!"}, {"id": 26, "duration_s": 3.83, "emotion": "excited", "text": "মহ-প্ৰুফ ধূপ! এটা জ্বলালেই মহ নাইকিয়া!"}, {"id": 27, "duration_s": 2.53, "emotion": "determined", "text": "চল্লিশ দিয়ক! এটা তালিত এটা!"}, {"id": 28, "duration_s": 2.35, "emotion": "stern_warning", "text": "দহ টকাত এটা। এক টকাও কম নহয়!"}, {"id": 29, "duration_s": 3.03, "emotion": "angry", "text": "ধনৰাম! এইবোৰ যোৱা বছৰৰ ধূপ!"}, {"id": 30, "duration_s": 2.91, "emotion": "embarrassed", "text": "পুৰণি পূজা... নতুন মহ।"}, {"id": 31, "duration_s": 4.18, "emotion": "giggly", "text": "সন্ধিয়ালৈ চুবুৰীত মেঘ নামিল। মহ নাযালে।"}, {"id": 32, "duration_s": 2.5, "emotion": "excited", "text": "লাইভ চলিছে! চুবুৰীত মেঘ নামিছে!"}, {"id": 33, "duration_s": 1.73, "emotion": "determined", "text": "ধনৰাম, নলৰিবা!"}, {"id": 34, "duration_s": 3.9, "emotion": "tired", "text": "ধোঁৱা গ'ল... মহ নগ'ল।"}, {"id": 35, "duration_s": 2.96, "emotion": "serious", "text": "দুদিন পাছত। ধনৰামৰ ঘৰত।"}, {"id": 36, "duration_s": 2.14, "emotion": "loving", "text": "উঠ বোপাই। তোৰ প্ৰিয় পিঠা।"}, {"id": 37, "duration_s": 1.14, "emotion": "shocked", "text": "পিঠাই... পিঠা নাখাওঁ কলে?!"}, {"id": 38, "duration_s": 2.41, "emotion": "tired", "text": "আই... ভোক... নাই।"}, {"id": 39, "duration_s": 3.98, "emotion": "worried", "text": "জ্বৰ আছে! ধনৰাম, ডাক্তৰ!"}, {"id": 40, "duration_s": 1.07, "emotion": "worried", "text": "ফীছ... কথা নাই! কথা নাই!"}, {"id": 41, "duration_s": 2.12, "emotion": "calm", "text": "জ্বৰ হ'লে ৰাতিপুৱা ক্লিনিক আহক।"}, {"id": 42, "duration_s": 3.14, "emotion": "serious", "text": "ডেঙ্গুৰ পৰীক্ষা কৰাবই লাগিব। ভয় নাখাবা।"}, {"id": 43, "duration_s": 2.25, "emotion": "serious", "text": "ঘৰৰ চাৰিফালে পানী জমি আছে নি?"}, {"id": 44, "duration_s": 1.66, "emotion": "proud", "text": "আমাৰ ঘৰ চাফ!"}, {"id": 45, "duration_s": 3.15, "emotion": "serious", "text": "ডেঙ্গুৰ মহ চাফ জমা পানীতেই জন্মে, হসা কথা।"}, {"id": 46, "duration_s": 0.62, "emotion": "happy", "text": "বলা, যাওঁ!"}, {"id": 47, "duration_s": 3.27, "emotion": "giggly", "text": "...আৰু পালোগৈয়ো।"}, {"id": 48, "duration_s": 2.43, "emotion": "relieved", "text": "ডেঙ্গু নহ'ল। অলপ জ্বৰহে।"}, {"id": 49, "duration_s": 1.76, "emotion": "pleading", "text": "তেন্তে... পিঠা?"}, {"id": 50, "duration_s": 4.776, "emotion": "stern_warning", "text": "ভাল হোৱাৰ পাছত। মাত্ৰ এটা।"}, {"id": 51, "duration_s": 1.1, "emotion": "shocked", "text": "এটা?!"}, {"id": 52, "duration_s": 3.67, "emotion": "excited", "text": "বুদ্ধি এটা আছে! আমি হ'ম..."}, {"id": 53, "duration_s": 0.71, "emotion": "excited", "text": "...মহ গোয়েন্দা!"}, {"id": 54, "duration_s": 1.22, "emotion": "proud", "text": "মই কওঁনে? এইবাৰ সঁচাকৈ?"}, {"id": 55, "duration_s": 1.21, "emotion": "stern_warning", "text": "কোৱা! বেগাই!"}, {"id": 56, "duration_s": 3.969, "emotion": "serious", "text": "ডেঙ্গুৰ মহে বেছিভাগ দিনতে কামোৰে।"}, {"id": 57, "duration_s": 3.69, "emotion": "serious", "text": "লেতেৰা নলাত নহয়, চাফ জমা পানীত কণী পাৰে।"}, {"id": 58, "duration_s": 3.75, "emotion": "shocked", "text": "মানে পণ্ডিত পবিত্ৰ দাৰ বিজ্ঞান... উলটা!"}, {"id": 59, "duration_s": 3.2, "emotion": "serious", "text": "পানীত সৰু সৰু পোক দেখিলে, সেয়া লাৰ্ভা।"}, {"id": 60, "duration_s": 1.93, "emotion": "serious", "text": "এসপ্তাহত, লাৰ্ভাৰ পৰা মহ!"}, {"id": 61, "duration_s": 2.34, "emotion": "determined", "text": "গোয়েন্দা! মোৰ প্ৰতিশোধ ল'বা!"}, {"id": 62, "duration_s": 3.26, "emotion": "determined", "text": "প্ৰতিটো বাচন! প্ৰতিটো টব! প্ৰতিটো টায়াৰ!"}, {"id": 63, "duration_s": 2.34, "emotion": "proud", "text": "গোয়েন্দা? ডাঙৰে চম্ভালিব!"}, {"id": 64, "duration_s": 0.34, "emotion": "angry", "text": "চুপ!"}, {"id": 65, "duration_s": 3.16, "emotion": "excited", "text": "আৰু আৰম্ভ হ'ল... মহ গোয়েন্দাগিৰি!"}, {"id": 66, "duration_s": 1.75, "emotion": "excited", "text": "পাইছোঁ! কুলাৰত লাৰ্ভা!"}, {"id": 67, "duration_s": 3.58, "emotion": "proud", "text": "মোৰ কুলাৰ? এইবোৰ তো খালী... ভাড়াতীয়া।"}, {"id": 68, "duration_s": 2.8, "emotion": "scared_whisper", "text": "মই... কাকো... নডৰোঁ।"}, {"id": 69, "duration_s": 2.44, "emotion": "panicked", "text": "ৰূপা! এইটোৱে ভাড়া বিচাৰিছে!"}, {"id": 70, "duration_s": 2.54, "emotion": "stern_warning", "text": "জোনাকী আইতা, টবৰ প্লেটতো!"}, {"id": 71, "duration_s": 2.44, "emotion": "proud", "text": "মোৰ ফুলবোৰক নিতো পূজা কৰোঁ!"}, {"id": 72, "duration_s": 2.53, "emotion": "sarcastic", "text": "পূজাও, পানীও... মহও।"}, {"id": 73, "duration_s": 3.08, "emotion": "determined", "text": "যথেষ্ট! এতিয়া মই চাওঁ।"}, {"id": 74, "duration_s": 3.75, "emotion": "proud", "text": "সপ্তাহে খালী কৰা, শুকুৱা। দহ ছেকেণ্ড।"}, {"id": 75, "duration_s": 3.19, "emotion": "embarrassed", "text": "মইও... সহায় কৰি আছিলোঁ।"}, {"id": 76, "duration_s": 3.42, "emotion": "mischievous", "text": "আৰু ছাদত... ধনুৰ ব্যৱসায়।"}, {"id": 77, "duration_s": 0.87, "emotion": "excited", "text": "চিন্তা নকৰিবা!"}, {"id": 78, "duration_s": 4.18, "emotion": "proud", "text": "এয়া মোৰ টায়াৰ ব্যৱসায়! বিশ টায়াৰ, অহা বছৰ বিশ লাখ!"}, {"id": 79, "duration_s": 3.43, "emotion": "serious", "text": "এটা টায়াৰত... শতকৈ অধিক লাৰ্ভা।"}, {"id": 80, "duration_s": 1.42, "emotion": "shocked", "text": "আৰু বিশটা টায়াৰত?"}, {"id": 81, "duration_s": 1.7, "emotion": "shocked", "text": "গোটেই মহৰ চুবুৰী!"}, {"id": 82, "duration_s": 1.18, "emotion": "mischievous", "text": "ইহঁতৰ ভাড়া ল'ম?"}, {"id": 83, "duration_s": 3.06, "emotion": "proud", "text": "মোৰ আচাৰক ৰ'দ! অন্ততঃ মই..."}, {"id": 84, "duration_s": 2.06, "emotion": "mischievous", "text": "আইতা... তোমাৰ ঢাকনিতো।"}, {"id": 85, "duration_s": 2.34, "emotion": "shocked", "text": "আই অ'! গোটেই চুবুৰীয়ে দেখিব!"}, {"id": 86, "duration_s": 2.03, "emotion": "angry", "text": "এই সকলো তোৰ টায়াৰৰ দোষ!"}, {"id": 87, "duration_s": 0.799, "emotion": "panicked", "text": "জাৰতো!"}, {"id": 88, "duration_s": 2.21, "emotion": "embarrassed", "text": "নিশানা... আকৌ ঠিক।"}, {"id": 89, "duration_s": 2.83, "emotion": "determined", "text": "টায়াৰ উলটা, পানী বাহিৰ, ব্যৱসায় ভিতৰ!"}, {"id": 90, "duration_s": 2.73, "emotion": "excited", "text": "শুনিছেনে? বৰুৱাৰ ছাদত বিশ লাখ!"}, {"id": 91, "duration_s": 2.81, "emotion": "panicked", "text": "বিশ লাখ... মহ! ডেঙ্গু আহিল!"}, {"id": 92, "duration_s": 2.86, "emotion": "serious", "text": "নজৰ লাগিল! প্ৰতিটো দুৱাৰত নেমু!"}, {"id": 93, "duration_s": 3.04, "emotion": "mischievous", "text": "মহৰ জাল! আজি ৰেট দুগুণ!"}, {"id": 94, "duration_s": 3.83, "emotion": "giggly", "text": "তাৰ পাছত... চুবুৰীত ভূতৰ বৰযাত্ৰী ওলাল।"}, {"id": 95, "duration_s": 2.45, "emotion": "shouting", "text": "প্ৰতিটো মহৰ তদন্ত হ'ব!"}, {"id": 96, "duration_s": 0.35, "emotion": "angry", "text": "চুপ!"}, {"id": 97, "duration_s": 3.62, "emotion": "serious", "text": "ধোঁৱা, নেমু, ৰেকেটেৰে নহয়। জমা পানী পেলোৱা!"}, {"id": 98, "duration_s": 1.19, "emotion": "excited", "text": "বুদ্ধি এটা আছে!"}, {"id": 99, "duration_s": 2.94, "emotion": "excited", "text": "চাফাই ৰেচ! বেছি পানী যিয়ে পায়!"}, {"id": 100, "duration_s": 2.46, "emotion": "determined", "text": "ৰেচ? বৰুৱাই কেতিয়াও নাহাৰে!"}, {"id": 101, "duration_s": 2.9, "emotion": "excited", "text": "চুবুৰীৰ প্ৰথম... চাফাই ৰেচ!"}, {"id": 102, "duration_s": 2.79, "emotion": "serious", "text": "নিয়ম শুনা! যিয়ে আটাইতকৈ বেছি..."}, {"id": 103, "duration_s": 1.28, "emotion": "serious", "text": "লাৰ্ভা, চাৰ! লাৰ্ভা!"}, {"id": 104, "duration_s": 1.88, "emotion": "shocked", "text": "লাভাৰ? এই চুবুৰীত?"}, {"id": 105, "duration_s": 2.85, "emotion": "scared_whisper", "text": "কাৰ? ক'ত? এই বয়সত?"}, {"id": 106, "duration_s": 1.17, "emotion": "sarcastic", "text": "মহৰ পোৱালী, চাৰ!"}, {"id": 107, "duration_s": 2.5, "emotion": "embarrassed", "text": "অ... ঠিক আছে। আৰম্ভ!"}, {"id": 108, "duration_s": 2.21, "emotion": "tired", "text": "ফুলহাতা... পুৰা ঘাম!"}, {"id": 109, "duration_s": 1.927, "emotion": "giggly", "text": "কিন্তু মহ পিছলি গ'ল!"}, {"id": 110, "duration_s": 1.89, "emotion": "determined", "text": "আইতা, তোমাৰ বাটিটোও!"}, {"id": 111, "duration_s": 2.73, "emotion": "embarrassed", "text": "নজৰ... পানীত লাগিছিল।"}, {"id": 112, "duration_s": 1.79, "emotion": "happy", "text": "অ', ওপৰতো পুখুৰী!"}, {"id": 113, "duration_s": 5.63, "emotion": "shouting", "text": "বৰষুণ? সমুচা? তদন্ত হ'ব!"}, {"id": 114, "duration_s": 2.44, "emotion": "mischievous", "text": "ধনৰাম, বিনামূলীয়া ভাড়াতীয়া!"}, {"id": 115, "duration_s": 4.61, "emotion": "sad", "text": "মোৰ দোকানত বিনামূলীয়াকৈ কোনেও নাথাকে!"}, {"id": 116, "duration_s": 3.22, "emotion": "proud", "text": "বিজ্ঞানে কয়... এইটো লৰচৰ নকৰে।"}, {"id": 117, "duration_s": 0.6, "emotion": "calm", "text": "আঁতৰা।"}, {"id": 118, "duration_s": 3.16, "emotion": "embarrassed", "text": "বিজ্ঞানে কয়... ল'ৰাৰ কথা শুনা।"}, {"id": 119, "duration_s": 2.61, "emotion": "excited", "text": "লাইভ চলিছে! হেশটেগ মহ-মুক্ত!"}, {"id": 120, "duration_s": 3.0, "emotion": "proud", "text": "এঘণ্টাত, চুবুৰীত এটোপালো জমা পানী নাই।"}, {"id": 121, "duration_s": 2.33, "emotion": "excited", "text": "দহ হাজাৰ ভিউ! চুবুৰী ভাইৰেল!"}, {"id": 122, "duration_s": 2.01, "emotion": "excited", "text": "শুনিছেনে? এইবাৰ ভাল খবৰ!"}, {"id": 123, "duration_s": 3.31, "emotion": "proud", "text": "ৰীলত আটাইতকৈ আগত মই! চুবুৰীয়ে দেখিব!"}, {"id": 124, "duration_s": 3.35, "emotion": "proud", "text": "ডেঙ্গু-মুক্ত চুবুৰী। আৰু লাভাৰ-মুক্তও।"}, {"id": 125, "duration_s": 2.57, "emotion": "sarcastic", "text": "লাৰ্ভা, চাৰ... লাৰ্ভা।"}, {"id": 126, "duration_s": 2.61, "emotion": "happy", "text": "চুবুৰীয়ে মহক জিনিলে... পানীৰ লগত যুঁজি।"}, {"id": 127, "duration_s": 2.39, "emotion": "stern_warning", "text": "ডাক্তৰে কৈছিল। মাত্ৰ এটা।"}, {"id": 128, "duration_s": 2.98, "emotion": "loving", "text": "এটাই যেতিয়া... লাহে লাহে খাম।"}, {"id": 129, "duration_s": 2.12, "emotion": "tired", "text": "পিঠা, বিশ মিনিট হ'ল!"}, {"id": 130, "duration_s": 3.85, "emotion": "happy", "text": "ভাল হ'লো! আৰু এতিয়া... ভোক লাগিছে!"}, {"id": 131, "duration_s": 2.64, "emotion": "proud", "text": "মই কৈছিলোঁ নহয়, মই কাকো নডৰোঁ।"}, {"id": 132, "duration_s": 1.9, "emotion": "mischievous", "text": "ভিন্ন্ন্ন..."}, {"id": 133, "duration_s": 1.39, "emotion": "calm", "text": "শুনা, গোয়েন্দা।"}, {"id": 134, "duration_s": 3.15, "emotion": "serious", "text": "মহৰ লগত যুঁজিবা? পানীৰ লগত যুঁজা।"}, {"id": 135, "duration_s": 4.68, "emotion": "serious", "text": "সপ্তাহত এবাৰ, প্ৰতিটো পাত্ৰ খালী, টেংকী ঢাকনি।"}, {"id": 136, "duration_s": 3.56, "emotion": "loving", "text": "ফুলহাতা কাপোৰ। আৰু জ্বৰ হ'লে, পোনে পোনে ডাক্তৰ।"}, {"id": 137, "duration_s": 0.95, "emotion": "excited", "text": "কেছ বন্ধ!"}, {"id": 138, "duration_s": 15.4, "emotion": "mischievous", "text": "চুবুৰী শুধৰালে... কিন্তু হৰিৰ তালি?"}, {"id": 139, "duration_s": 0.82, "emotion": "scared_whisper", "text": "একচল্লিশ..."}]