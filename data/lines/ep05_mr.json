[{"id": 1, "duration_s": 3.91, "emotion": "excited", "text": "वस्तीतली सगळ्यात मोठी झुंज... रस्सीखेच!"}, {"id": 2, "duration_s": 4.09, "emotion": "proud", "text": "सात दिवसांची पावडर! मी कुणाला घाबरत नाही!"}, {"id": 3, "duration_s": 2.1, "emotion": "calm", "text": "शेठजी, चहा गरम ठेवा."}, {"id": 4, "duration_s": 1.83, "emotion": "excited", "text": "लाइव्ह सुरू आहे! स्लो मोशन!"}, {"id": 5, "duration_s": 1.18, "emotion": "mischievous", "text": "हे सुरू झालं... एका डब्यातून."}, {"id": 6, "duration_s": 5.27, "emotion": "happy", "text": "सात दिवस आधी. वस्तीचा क्रीडा सप्ताह."}, {"id": 7, "duration_s": 5.29, "emotion": "excited", "text": "या रविवारी रस्सीखेच! जोशी कुटुंब विरुद्ध शेठ कुटुंब!"}, {"id": 8, "duration_s": 3.41, "emotion": "proud", "text": "जोशी जिंकणार! मी कुणाला घाबरत नाही!"}, {"id": 9, "duration_s": 6.42, "emotion": "sarcastic", "text": "हिशोब केला. जोशी जिंकण्याची शक्यता... शून्य."}, {"id": 10, "duration_s": 2.29, "emotion": "sarcastic", "text": "कुणाला घाबरत नाही, गणपत?"}, {"id": 11, "duration_s": 4.158, "emotion": "comic_panic", "text": "कुणालाच नाही! पाल... नसतेच मुळी!"}, {"id": 12, "duration_s": 2.63, "emotion": "stern_warning", "text": "गप्प! काका पुन्हा उडी मारतील."}, {"id": 13, "duration_s": 1.51, "emotion": "happy", "text": "चला, निघू या!"}, {"id": 14, "duration_s": 1.74, "emotion": "calm", "text": "हटा भाऊ, मी बघते."}, {"id": 15, "duration_s": 2.41, "emotion": "shocked", "text": "वहिनी, ट्रॅक्टरही ओढाल तुम्ही!"}, {"id": 16, "duration_s": 1.07, "emotion": "excited", "text": "टेन्शन घेऊ नका, भाऊ!"}, {"id": 17, "duration_s": 4.22, "emotion": "worried", "text": "टेन्शन? तिनं रिक्षा ओढली, सोन्या!"}, {"id": 18, "duration_s": 4.09, "emotion": "proud", "text": "माझा पोरगा जिंकणार! अख्खी वस्ती बघेल!"}, {"id": 19, "duration_s": 3.09, "emotion": "mischievous", "text": "ऐका! गणपतराव पालीकडून हरले!"}, {"id": 20, "duration_s": 3.29, "emotion": "sad", "text": "चिप्स कुठे? पोटात कावळे!"}, {"id": 21, "duration_s": 3.51, "emotion": "excited", "text": "सुलतान पावर पाव