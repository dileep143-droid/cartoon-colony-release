[{"id": 1, "duration_s": 3.41, "emotion": "mischievous", "text": "ദീപാവലി രാത്രി... കോളനി മുഴുവൻ വെട്ടിത്തിളങ്ങുന്നു..."}, {"id": 2, "duration_s": 3.01, "emotion": "sarcastic", "text": "...പക്ഷേ നിൽക്കുന്നതോ, ഒറ്റ വരിയിൽ!"}, {"id": 3, "duration_s": 2.81, "emotion": "comic_panic", "text": "കേട്ടോ? എന്റെ വയറ്റിൽ പടക്കം പൊട്ടുന്നേ!"}, {"id": 4, "duration_s": 2.98, "emotion": "worried", "text": "കണ്ണു പെട്ടു! ബാത്ത്റൂമിന് കണ്ണു പെട്ടു!"}, {"id": 5, "duration_s": 3.92, "emotion": "determined", "text": "വയറു വേദനിക്കുന്നു... പക്ഷേ വിശപ്പുമുണ്ട്!"}, {"id": 6, "duration_s": 0.95, "emotion": "comic_panic", "text": "അകത്താരാ? വേഗം!"}, {"id": 7, "duration_s": 1.01, "emotion": "calm", "text": "ടെൻഷൻ വേണ്ട!"}, {"id": 8, "duration_s": 2.99, "emotion": "calm", "text": "ഇതിന്റെ തുടക്കം... മൂന്നു ദിവസം മുമ്പ്."}, {"id": 9, "duration_s": 2.93, "emotion": "mischievous", "text": "ഒരു പളപളാ മിന്നുന്ന മധുരത്തിൽ നിന്ന്."}, {"id": 10, "duration_s": 2.89, "emotion": "happy", "text": "ദീപാവലി ആഴ്ച. കോളനി ഒരുങ്ങുന്നു."}, {"id": 11, "duration_s": 4.64, "emotion": "proud", "text": "മെഗാ സെയിൽ! കാജു കട്‌ലി പകുതി വില!"}, {"id": 12, "duration_s": 4.37, "emotion": "excited", "text": "മിന്നുന്ന മധുരം! വിശക്കുന്നേ!"}, {"id": 13, "duration_s": 4.27, "emotion": "mischievous", "text": "കുട്ടപ്പണ്ണാ, ഇരുനൂറ് പെട്ടി, പാതിവെല, നല്ല വെള്ളി!"}, {"id": 14, "duration_s": 2.17, "emotion": "excited", "text": "വില കുറവ്, ലാഭം കൂടുതൽ!"}, {"id": 15, "duration_s": 2.14, "emotion": "stern_warning", "text": "കുട്ടപ്പേട്ടാ! പാതിവിലയ്ക്ക് വെള്ളിയോ?"}, {"id": 16, "duration_s": 2.84, "emotion": "proud", "text": "കല്യാണീ, ഇത് ദീപാവലി ഭാഗ്യമാ!"}, {"id": 17, "duration_s": 0.92, "emotion": "excited", "text": "ഒരു ഐഡിയ!"}, {"id": 18, "duration_s": 3.52, "emotion": "excited", "text": "അമ്മച്ചീ! കുഞ്ഞമ്മേക്കാൾ വല്യ തളിക, പാതിവില!"}, {"id": 19, "duration_s": 3.32, "emotion": "mischievous", "text": "ഇത്തവണ എന്റെ തളിക... കോളനി മുഴുവൻ കാണും!"}, {"id": 20, "duration_s": 4.05, "emotion": "serious", "text": "അമ്മേ, പകുതി വിലയ്ക്ക് കാജു കട്‌ലിയോ? എന്തോ പന്തികേടുണ്ട്."}, {"id": 21, "duration_s": 3.01, "emotion": "proud", "text": "പന്തികേടല്ല മോളേ, ലാഭമാ!"}, {"id": 22, "duration_s": 2.32, "emotion": "mischievous", "text": "അങ്ങനെ തുടങ്ങി... തളികപ്പോര്!"}, {"id": 23, "duration_s": 2.84, "emotion": "proud", "text": "അഞ്ചു പെട്ടി! ഏറ്റവും വലുത്!"}, {"id": 24, "duration_s": 1.35, "emotion": "proud", "text": "ഒറ്റ രൂപ കുറയില്ല!"}, {"id": 25, "duration_s": 2.39, "emotion": "shocked", "text": "കേട്ടോ? അമ്മിണി അഞ്ചു പെട്ടി വാങ്ങി!"}, {"id": 26, "duration_s": 2.56, "emotion": "proud", "text": "ആറു പെട്ടി, കുട്ടപ്പേട്ടാ! ആറ്!"}, {"id": 27, "duration_s": 0.85, "emotion": "determined", "text": "ഏഴ്!"}, {"id": 28, "duration_s": 2.45, "emotion": "excited", "text": "ടെൻഷൻ വേണ്ട! ഷിബുവിന്റെ പ്രീമിയം ഹാമ്പർ!"}, {"id": 29, "duration_s": 2.71, "emotion": "mischievous", "text": "ഇരട്ടി വില, ചേച്ചീ... ഇരട്ടി ഗമ!"}, {"id": 30, "duration_s": 2.63, "emotion": "worried", "text": "ഇത്രയും മധുരം! കണ്ണു പെടും!"}, {"id": 31, "duration_s": 1.94, "emotion": "proud", "text": "കോളനി മൊത്തം കാണട്ടെ!"}, {"id": 32, "duration_s": 2.21, "emotion": "proud", "text": "എനിക്കാരെയും പേടിയില്ല! കുഞ്ഞമ്മയെയും!"}, {"id": 33, "duration_s": 3.7, "emotion": "curious", "text": "പകുതി വിലയ്ക്ക് വെള്ളിയോ? എനിക്ക് സംശയമുണ്ട്."}, {"id": 34, "duration_s": 2.28, "emotion": "sarcastic", "text": "വല്യവരെ ആര് പഠിപ്പിക്കാൻ!"}, {"id": 35, "duration_s": 4.07, "emotion": "giggly", "text": "സ്കോർ? പന്ത്രണ്ട്-പന്ത്രണ്ട് പെട്ടി. യുദ്ധം സമനില!"}, {"id": 36, "duration_s": 4.66, "emotion": "stern_warning", "text": "ഉണ്ണീ, നീയാണ് കാവൽക്കാരൻ. ഒരു തരി പോലും തൊടരുത്!"}, {"id": 37, "duration_s": 2.45, "emotion": "determined", "text": "ഒരു തരി പോലുമില്ല!"}, {"id": 38, "duration_s": 1.85, "emotion": "proud", "text": "എന്റെ പൂക്കളം വലുത്."}, {"id": 39, "duration_s": 2.19, "emotion": "sarcastic", "text": "എന്റെ പൂക്കളത്തിൽ നിറം കൂടുതൽ."}, {"id": 40, "duration_s": 2.77, "emotion": "serious", "text": "അന്വേഷണമുണ്ട്! മധുരസുരക്ഷ!"}, {"id": 41, "duration_s": 0.8, "emotion": "excited", "text": "മധുരമോ?"}, {"id": 42, "duration_s": 1.76, "emotion": "happy", "text": "കേസ് തീർന്നു."}, {"id": 43, "duration_s": 2.33, "emotion": "shocked", "text": "ഉണ്ണീ! തളികകളെവിടെ?"}, {"id": 44, "duration_s": 2.38, "emotion": "guilty", "text": "അത്... കണ്ണു പെട്ടു!"}, {"id": 45, "duration_s": 2.44, "emotion": "excited", "text": "കണ്ടോ! ഞാൻ പറഞ്ഞില്ലേ!"}, {"id": 46, "duration_s": 1.95, "emotion": "excited", "text": "ഹാമ്പർ വാങ്ങൂ! നാടിനു മുഴുവൻ!"}, {"id": 47, "duration_s": 4.09, "emotion": "serious", "text": "ഇപ്പോൾ കുട്ടപ്പന്റെ മധുരം... എല്ലാ വീട്ടിലുമെത്തി."}, {"id": 48, "duration_s": 1.47, "emotion": "excited", "text": "ഹായ് ഗയ്സ്! ലൈവിലാണ്!"}, {"id": 49, "duration_s": 2.28, "emotion": "sarcastic", "text": "ഇത്ര പച്ച... ഇലയ്ക്കു പോലുമില്ല."}, {"id": 50, "duration_s": 3.71, "emotion": "excited", "text": "മധുരം മുക്ബാങ്! ഇന്നത്തെ ബർഫി... നിയോൺ ഗ്രീൻ!"}, {"id": 51, "duration_s": 3.84, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... നിറം കൂടുതൽ, വിറ്റാമിൻ കൂടുതൽ!"}, {"id": 52, "duration_s": 1.91, "emotion": "happy", "text": "കേട്ടോ ഗയ്സ്? ഹെൽത്തിയാ!"}, {"id": 53, "duration_s": 3.787, "emotion": "serious", "text": "പച്ച നാക്ക്? സയൻസ് പറയുന്നു... ഇത് പച്ചപ്പാ."}, {"id": 54, "duration_s": 3.44, "emotion": "shocked", "text": "ഗയ്സ്, നാക്ക് നീലയായി! പുതിയ ഫിൽറ്റർ?"}, {"id": 55, "duration_s": 2.71, "emotion": "embarrassed", "text": "സയൻസ് പറയുന്നു... ഇത് വേദനയാ."}, {"id": 56, "duration_s": 3.55, "emotion": "proud", "text": "രണ്ടു ലക്ഷം വ്യൂസ്! എല്ലാവരും നീല ബർഫി തിന്നൂ!"}, {"id": 57, "duration_s": 2.97, "emotion": "happy", "text": "ദീപാവലി സന്ധ്യ. അമ്മിണിയമ്മച്ചീടെ പാർട്ടി!"}, {"id": 58, "duration_s": 3.57, "emotion": "proud", "text": "വരൂ, വരൂ! കോളനി മുഴുവൻ കാണും... കഴിക്കുകയും ചെയ്യും!"}, {"id": 59, "duration_s": 2.34, "emotion": "sarcastic", "text": "അമ്മിണീ, നിങ്ങടെ കട്‌ലിക്ക് ഇത്ര തിളക്കം എന്താ?"}, {"id": 60, "duration_s": 2.6, "emotion": "proud", "text": "ഒറിജിനൽ വെള്ളിയാ! പകുതി വിലയ്ക്ക്!"}, {"id": 61, "duration_s": 0.6, "emotion": "proud", "text": "എന്റേതും!"}, {"id": 62, "duration_s": 3.392, "emotion": "curious", "text": "മാഷേ, ഈ മധുരം ശുദ്ധമാണോ?"}, {"id": 63, "duration_s": 3.63, "emotion": "happy", "text": "തത്ത പച്ചയാണോ? ആഹാ, അതെ, വളരെ ഭംഗി!"}, {"id": 64, "duration_s": 3.481, "emotion": "shocked", "text": "തത്തയല്ല മാഷേ... മധുരം!"}, {"id": 65, "duration_s": 4.699, "emotion": "excited", "text": "തത്തയും പച്ച, ബർഫിയും പച്ച! കൊള്ളാം!"}, {"id": 66, "duration_s": 3.72, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... തിളക്കമെന്നാൽ ഫ്രഷ്!"}, {"id": 67, "duration_s": 2.32, "emotion": "proud", "text": "എനിക്ക് ഒരു മധുരത്തെയും പേടിയില്ല!"}, {"id": 68, "duration_s": 3.66, "emotion": "happy", "text": "മേഘം ഗർജ്ജിക്കുന്നോ? ദീപാവലിക്ക് മഴ!"}, {"id": 69, "duration_s": 2.75, "emotion": "comic_panic", "text": "കേട്ടോ? എന്റെ വയറും എന്തോ പറയുന്നു!"}, {"id": 70, "duration_s": 3.03, "emotion": "giggly", "text": "പിന്നെ... കോളനി മുഴുവൻ വയറ് ഒരുമിച്ചു സംസാരിച്ചു."}, {"id": 71, "duration_s": 3.27, "emotion": "sarcastic", "text": "പതിനാല് പേർ. ഒരു ബാത്ത്റൂം."}, {"id": 72, "duration_s": 1.65, "emotion": "comic_panic", "text": "എനിക്കാരെയും പേടിയില്ല... പക്ഷേ വേഗം!"}, {"id": 73, "duration_s": 1.83, "emotion": "stern_warning", "text": "കുട്ടപ്പേട്ടാ! ക്യൂവിൽ നിൽക്ക്!"}, {"id": 74, "duration_s": 2.98, "emotion": "pleading", "text": "മുന്നിൽ കേറാൻ... രണ്ടു രൂപ തരാം?"}, {"id": 75, "duration_s": 3.66, "emotion": "sarcastic", "text": "കുഞ്ഞമ്മേ, നിന്റെ വയറ് എന്റേതിനേക്കാൾ വായാടി!"}, {"id": 76, "duration_s": 2.16, "emotion": "comic_panic", "text": "ലൈവാണ്... ബാത്ത്റൂം വരിയിൽ നിന്ന്!"}, {"id": 77, "duration_s": 1.71, "emotion": "determined", "text": "മതി! ഇനി ഞാൻ നോക്കാം."}, {"id": 78, "duration_s": 3.58, "emotion": "serious", "text": "ഒരു ലിറ്റർ തിളപ്പിച്ചാറിയ വെള്ളം, ആറു സ്പൂൺ പഞ്ചസാര..."}, {"id": 79, "duration_s": 2.54, "emotion": "serious", "text": "...അര സ്പൂൺ ഉപ്പ്. പയ്യെപ്പയ്യെ കുടിക്ക്."}, {"id": 80, "duration_s": 2.73, "emotion": "worried", "text": "രണ്ടു നാരങ്ങ പോരാ... ദാ മൂന്നാമത്തേത്!"}, {"id": 81, "duration_s": 2.64, "emotion": "calm", "text": "രണ്ടു മിനിറ്റ്... ടെൻഷൻ വേണ്ട!"}, {"id": 82, "duration_s": 3.29, "emotion": "crying", "text": "ഷിബൂ, നിന്റെ രണ്ടു മിനിറ്റ്... സീരിയലിനേക്കാൾ നീളം!"}, {"id": 83, "duration_s": 2.31, "emotion": "guilty", "text": "അവസാനത്തേത്... സത്യം."}, {"id": 84, "duration_s": 2.14, "emotion": "determined", "text": "മരുന്നുകട! വാ, പോകാം!"}, {"id": 85, "duration_s": 2.55, "emotion": "tired", "text": "അന്വേഷണം ഉണ്ട്... നടന്ന്."}, {"id": 86, "duration_s": 3.21, "emotion": "curious", "text": "എല്ലാർക്കും വയറുവേദന... നമ്മള് മൂന്നും ഓക്കേ?"}, {"id": 87, "duration_s": 3.21, "emotion": "proud", "text": "കാരണം ശോഭാന്റിയുടെ വീട്ടിലെ ലഡു തിന്നു!"}, {"id": 88, "duration_s": 3.69, "emotion": "determined", "text": "ഇതാ തെളിവ്. നാളെ രാവിലെ... സയൻസ് ടെസ്റ്റ്!"}, {"id": 89, "duration_s": 3.46, "emotion": "sarcastic", "text": "പടക്കം പൊട്ടിയത് കുറവ്... വയറ് പൊട്ടിയത് കൂടുതൽ."}, {"id": 90, "duration_s": 2.43, "emotion": "curious", "text": "പിറ്റേന്ന് രാവിലെ. അപ്പുവിന്റെ ലാബ്."}, {"id": 91, "duration_s": 2.88, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... തിളക്കമെന്നാൽ ഫ്രഷ്!"}, {"id": 92, "duration_s": 1.39, "emotion": "angry", "text": "എന്റേത് ഒറിജിനലാ!"}, {"id": 93, "duration_s": 1.07, "emotion": "angry", "text": "എന്റേത് കൂടുതൽ!"}, {"id": 94, "duration_s": 1.63, "emotion": "shouting", "text": "മിണ്ടാതിരിക്ക്! അപ്പു പറയും!"}, {"id": 95, "duration_s": 2.0, "emotion": "proud", "text": "ഞാൻ പറയട്ടെ? സ്കൂൾ ടെസ്റ്റ്."}, {"id": 96, "duration_s": 2.33, "emotion": "stern_warning", "text": "അയഡിൻ മുറിവിന്, തിന്നാനല്ല!"}, {"id": 97, "duration_s": 3.48, "emotion": "serious", "text": "നീലക്കറുപ്പ് അന്നജം! മൈദ ചേർത്തിട്ടുണ്ട്!"}, {"id": 98, "duration_s": 3.52, "emotion": "serious", "text": "ശരിക്കുള്ള കോവയിൽ അന്നജമില്ല, തവിട്ടുനിറം തന്നെ."}, {"id": 99, "duration_s": 3.71, "emotion": "serious", "text": "ശരിക്കുള്ള വെള്ളിപ്പാളി... ഉരസിയാൽ പൊടിയാകും."}, {"id": 100, "duration_s": 3.35, "emotion": "stern_warning", "text": "ഒട്ടിപ്പിടിച്ചു, തിളങ്ങി... വ്യാജ ഫോയിൽ!"}, {"id": 101, "duration_s": 1.96, "emotion": "proud", "text": "സയൻസ് പറയുന്നു..."}, {"id": 102, "duration_s": 0.71, "emotion": "stern_warning", "text": "മിണ്ടരുത്!"}, {"id": 103, "duration_s": 2.87, "emotion": "serious", "text": "ഇത്ര കടുത്ത നിറമോ? അപകടമണി!"}, {"id": 104, "duration_s": 2.79, "emotion": "stern_warning", "text": "ടെസ്റ്റിന്റെ മധുരം... തിന്നരുത്!"}, {"id": 105, "duration_s": 3.32, "emotion": "proud", "text": "സൂപ്പർ അപ്പൂ! ടെസ്റ്റ് കഷണങ്ങൾ ചവറ്റുകുട്ടയിൽ."}, {"id": 106, "duration_s": 2.94, "emotion": "embarrassed", "text": "ഞാനോ... തത്തയെന്നോർത്ത് തിന്നോണ്ടിരുന്നു."}, {"id": 107, "duration_s": 4.386, "emotion": "serious", "text": "അറിയുന്ന കട, പെട്ടിയിൽ തീയതിയും ലൈസൻസും."}, {"id": 108, "duration_s": 5.64, "emotion": "guilty", "text": "ഞാനോ... കുഞ്ഞമ്മയെക്കാൾ വലിയ തളിക മാത്രം നോക്കി."}, {"id": 109, "duration_s": 1.11, "emotion": "determined", "text": "വാ! കുട്ടപ്പന്റെ കടയിലേക്ക്!"}, {"id": 110, "duration_s": 3.271, "emotion": "mischievous", "text": "കോളനി മൊത്തം... കുട്ടപ്പന്റെ കടയിലേക്ക്!"}, {"id": 111, "duration_s": 3.52, "emotion": "comic_panic", "text": "ഹലോ! നിങ്ങടെ ഒറിജിനൽ വെള്ളി... വ്യാജനായിരുന്നു!"}, {"id": 112, "duration_s": 1.95, "emotion": "mischievous", "text": "ആരാ കുട്ടപ്പൻ? റോങ് നമ്പർ!"}, {"id": 113, "duration_s": 4.29, "emotion": "sad", "text": "എന്നെയും പറ്റിച്ചു... ആർത്തി കൂടിപ്പോയി."}, {"id": 114, "duration_s": 4.69, "emotion": "stern_warning", "text": "കുട്ടപ്പേട്ടാ! ഓരോ പെട്ടിയും തിരിച്ച്. ഓരോ രൂപയും തിരിച്ച്."}, {"id": 115, "duration_s": 1.77, "emotion": "pleading", "text": "കല്യാണീ... കുറച്ചാലോ?"}, {"id": 116, "duration_s": 1.48, "emotion": "angry", "text": "ഒറ്റ രൂപ കുറയില്ല!"}, {"id": 117, "duration_s": 3.22, "emotion": "crying", "text": "വിട... എന്റെ പൊന്നു നാണയങ്ങളേ."}, {"id": 118, "duration_s": 1.63, "emotion": "mischievous", "text": "ടെൻഷൻ വേണ്ട... ഞാൻ പോയി!"}, {"id": 119, "duration_s": 2.0, "emotion": "sarcastic", "text": "ഇരട്ടി വാങ്ങി... ഇരട്ടി തിരിച്ചു താ!"}, {"id": 120, "duration_s": 3.33, "emotion": "sad", "text": "മെഗാ സെയിൽ... മെഗാ ഫെയിൽ."}, {"id": 121, "duration_s": 2.58, "emotion": "happy", "text": "ഇത്തവണ മധുരം... വീട്ടിൽ ഉണ്ടാക്കും!"}, {"id": 122, "duration_s": 3.65, "emotion": "happy", "text": "കടലമാവ്, നെയ്യ്, പഞ്ചസാര... അത്രേയുള്ളൂ!"}, {"id": 123, "duration_s": 3.13, "emotion": "loving", "text": "അമ്മിണീ, എന്റെ തേങ്ങാ ബർഫി... വീട്ടിലുണ്ടാക്കിയത്."}, {"id": 124, "duration_s": 3.84, "emotion": "happy", "text": "ഇത്തവണ തളിക ഒന്ന്... രണ്ടുപേർക്കും!"}, {"id": 125, "duration_s": 1.59, "emotion": "giggly", "text": "കേട്ടോ? ഞങ്ങൾ കൂട്ടായി!"}, {"id": 126, "duration_s": 2.35, "emotion": "excited", "text": "ഒരു ഐഡിയ! ഏറ്റവും വലിയ ലഡു!"}, {"id": 127, "duration_s": 1.79, "emotion": "sarcastic", "text": "മിണ്ടാതെ! ഉരുട്ടിയെടുക്ക്."}, {"id": 128, "duration_s": 2.91, "emotion": "giggly", "text": "ഉണ്ണീ, ഇന്നു മുതൽ നീ... ടേസ്റ്റർ!"}, {"id": 129, "duration_s": 2.28, "emotion": "excited", "text": "ഈ ജോലി... എനിക്കായി ജനിച്ചത്!"}, {"id": 130, "duration_s": 1.98, "emotion": "proud", "text": "ക്വാളിറ്റി ചെക്ക്... നടക്കുന്നു."}, {"id": 131, "duration_s": 3.35, "emotion": "happy", "text": "പിന്നെ വന്നു... ശുദ്ധമായ, മധുര ദീപാവലി!"}, {"id": 132, "duration_s": 5.63, "emotion": "proud", "text": "കോളനി മുഴുവൻ കാണട്ടെ... ഒറ്റ തളിക!"}, {"id": 133, "duration_s": 0.7, "emotion": "embarrassed", "text": "ഇത്തവണ... ഫ്രീ!"}, {"id": 134, "duration_s": 4.16, "emotion": "worried", "text": "കുട്ടപ്പേട്ടാ, ഫ്രീയോ? വാ, ഡോക്ടറുടെ അടുത്തേക്ക്!"}, {"id": 135, "duration_s": 3.05, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... വീട്ടിലുണ്ടാക്കിയതാണ് ബെസ്റ്റ്!"}, {"id": 136, "duration_s": 4.46, "emotion": "proud", "text": "ഇത്തവണ ശരിക്കും കേട്ടു... മധുരം ശുദ്ധം!"}, {"id": 137, "duration_s": 1.9, "emotion": "curious", "text": "അപ്പൂപ്പാ! ഇന്നത്തെ പാഠം?"}, {"id": 138, "duration_s": 3.87, "emotion": "calm", "text": "മിന്നുന്നതെല്ലാം പൊന്നല്ല... ശുദ്ധി നോക്കി വാങ്ങൂ."}, {"id": 139, "duration_s": 1.65, "emotion": "happy", "text": "ഹാപ്പി ദീപാവലി!"}]