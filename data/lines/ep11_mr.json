[{"id": 1, "duration_s": 4.23, "emotion": "embarrassed", "text": "हो, हा मीच! विचार करताय, हे कसं झालं?"}, {"id": 2, "duration_s": 4.85, "emotion": "mischievous", "text": "सकाळपासून सुरू करू. वस्तीत आली... एक नवी बाइक."}, {"id": 3, "duration_s": 4.93, "emotion": "proud", "text": "नवी बाइक! पूर्ण ऐंशी हजाराची... एक रुपयाही कमी नाही!"}, {"id": 4, "duration_s": 2.97, "emotion": "mischievous", "text": "माझ्या बाबांची बाइक! तुझ्या बाबांकडे काय?"}, {"id": 5, "duration_s": 2.49, "emotion": "proud", "text": "माझ्या बाबांकडे... मिशी आहे!"}, {"id": 6, "duration_s": 3.64, "emotion": "sarcastic", "text": "मिशी माझ्याही बाबांना आहे... वर बाइकसुद्धा!"}, {"id": 7, "duration_s": 2.66, "emotion": "shocked", "text": "मिशी?! अब्रूचा सवाल आहे हा!"}, {"id": 8, "duration_s": 2.65, "emotion": "proud", "text": "संध्याकाळी गल्लीत माझी गाडी धावणार!"}, {"id": 9, "duration_s": 3.08, "emotion": "excited", "text": "ऐकलंत का? गणपत गाडी आणतोय... विमानाएवढी!"}, {"id": 10, "duration_s": 2.75, "emotion": "sarcastic", "text": "गाडी आली... पण ढकलत!"}, {"id": 11, "duration_s": 2.4, "emotion": "tired", "text": "आली... माझी वाघीण."}, {"id": 12, "duration_s": 3.57, "emotion": "sarcastic", "text": "ही चालते का, धक्का द्यावा लागतो?"}, {"id": 13, "duration_s": 5.02, "emotion": "proud", "text": "विंटेज आहे! विंटेज म्हणजे... जुनी पण मौल्यवान!"}, {"id": 14, "duration_s": 4.129, "emotion": "comic_panic", "text": "मी... कोणाला घाबरत नाही!"}, {"id": 15, "duration_s": 2.63, "emotion": "laughing", "text": "हा! स्कूटी पंधरा हजारी, धूर फुकट!"}, {"id": 16, "duration_s": 1.22, "emotion": "stern_warning", "text": "धनाजी!"}, {"id": 17, "duration_s": 1.66, "emotion": "excited", "text": "चाल्ली! बाबा, चाल्ली!"}, {"id": 18, "duration_s": 3.18, "emotion": "serious", "text": "दृष्ट लागली तर? लिंबू-मिरची हवीच!"}, {"id": 19, "duration_s": 4.26, "emotion": "proud", "text": "सगळी वस्ती बघेल! माझ्या लेकाची गाडी!"}, {"id": 20, "duration_s": 3.88, "emotion": "proud", "text": "आज केस असे बसलेत... की बाइकही लाजेल."}, {"id": 21, "duration_s": 1.09, "emotion": "stern_warning", "text": "हेल्मेट घाला."}, {"id": 22, "duration_s": 2.25, "emotion": "pleading", "text": "हेल्मेटने केस बिघडतात, सुनंदा! कधीच नाही!"}, {"id": 23, "duration_s": 2.06, "emotion": "determined", "text": "बास! आता मी बघते."}, {"id": 24, "duration_s": 2.88, "emotion": "comic_panic", "text": "मी कोणाला घाबरत नाही... फक्त पालीला!"}, {"id": 25, "duration_s": 2.61, "emotion": "sarcastic", "text": "पाल गेली. आता केसही जातील."}, {"id": 26, "duration_s": 1.96, "emotion": "giggly", "text": "बाबा, हेल्मेट उलटं आहे!"}, {"id": 27, "duration_s": 2.21, "emotion": "proud", "text": "माहितीये! हे मागच्यांसाठी आहे!"}, {"id": 28, "duration_s": 2.99, "emotion": "excited", "text": "लाईव्ह चालू आहे! बाबांचं उलटं हेल्मेट!"}, {"id": 29, "duration_s": 2.49, "emotion": "sad", "text": "माझे केस... शहीद झाले."}, {"id": 30, "duration_s": 1.02, "emotion": "stern_warning", "text": "पट्टाही बांधा."}, {"id": 31, "duration_s": 0.6, "emotion": "mischievous", "text": "उद्या!"}, {"id": 32, "duration_s": 1.87, "emotion": "excited", "text": "टेन्शन नको! आज मी शिकवतो."}, {"id": 33, "duration_s": 2.24, "emotion": "proud", "text": "स्कूटीला क्लच नसतो, फक्त रेस द्या!"}, {"id": 34, "duration_s": 1.83, "emotion": "sarcastic", "text": "दादा, आधी चालू तर करा!"}, {"id": 35, "duration_s": 1.47, "emotion": "excited", "text": "बघा! मी उडतोय!"}, {"id": 36, "duration_s": 2.39, "emotion": "proud", "text": "हीरो! दहा किलोमीटर झाले!"}, {"id": 37, "duration_s": 1.24, "emotion": "proud", "text": "न हलता!"}, {"id": 38, "duration_s": 1.7, "emotion": "shouting", "text": "रेस द्या! पुढे! पुढे!"}, {"id": 39, "duration_s": 2.49, "emotion": "comic_panic", "text": "पुढे कसा? गाडी मागे जातेय!"}, {"id": 40, "duration_s": 2.98, "emotion": "comic_panic", "text": "ब्रेक! ब्रेक! हातातला ब्रेक!"}, {"id": 41, "duration_s": 3.69, "emotion": "embarrassed", "text": "मी ठीक आहे. गाडीही ठीक आहे."}, {"id": 42, "duration_s": 2.88, "emotion": "serious", "text": "दृष्ट लागली! सांगितलं होतं ना?"}, {"id": 43, "duration_s": 1.98, "emotion": "sad", "text": "लिंबाने ब्रेक लागत नाहीत, आजी."}, {"id": 44, "duration_s": 2.97, "emotion": "angry", "text": "सोन्या! आधी स्वतः शिक!"}, {"id": 45, "duration_s": 3.04, "emotion": "embarrassed", "text": "टेन्शन नको... नेम पक्का आहे त्यांचा."}, {"id": 46, "duration_s": 2.83, "emotion": "mischievous", "text": "एक आयडिया! बाबांपेक्षा आम्ही बरं चालवू."}, {"id": 47, "duration_s": 2.62, "emotion": "excited", "text": "मी मागे बसणार... खाऊसकट."}, {"id": 48, "duration_s": 1.47, "emotion": "stern_warning", "text": "गप्प! हात काढ!"}, {"id": 49, "duration_s": 1.96, "emotion": "serious", "text": "मुलं गाडी चालवत नाहीत. कळलं?"}, {"id": 50, "duration_s": 3.64, "emotion": "serious", "text": "मी सांगू? अठराआधी गाडी चालवणं गुन्हा आहे."}, {"id": 51, "duration_s": 4.91, "emotion": "serious", "text": "पाय जमिनीला पोचत नाहीत. ब्रेक कसा लावणार?"}, {"id": 52, "duration_s": 0.96, "emotion": "proud", "text": "चावी जप्त!"}, {"id": 53, "duration_s": 1.3, "emotion": "excited", "text": "आणखी एक आयडिया! बाबांना आपणच शिकवू!"}, {"id": 54, "duration_s": 3.91, "emotion": "tired", "text": "मी कोणाला घाबरत नाही... घुर्र..."}, {"id": 55, "duration_s": 4.56, "emotion": "proud", "text": "बघा वस्ती! गणपत जोशी... ऑन द रोड!"}, {"id": 56, "duration_s": 2.83, "emotion": "proud", "text": "धनाजी शेठ? स्कूटी वाऱ्याशी बोलतेय!"}, {"id": 57, "duration_s": 3.76, "emotion": "sarcastic", "text": "वाऱ्याशी नाही, माझ्याशी बोलतोयस. लक्ष दे!"}, {"id": 58, "duration_s": 3.16, "emotion": "happy", "text": "नमस्ते कमल काकू! हो धनाजी, बोला!"}, {"id": 59, "duration_s": 5.22, "emotion": "sarcastic", "text": "एका हातात फोन, दुसऱ्यात नमस्कार... गाडी कुणाच्या हातात?"}, {"id": 60, "duration_s": 2.66, "emotion": "comic_panic", "text": "गणपत! समोर बघ! समोर!"}, {"id": 61, "duration_s": 6.347, "emotion": "curious", "text": "समोर? धनाजी, तुम्ही फोनमध्ये!"}, {"id": 62, "duration_s": 3.9, "emotion": "embarrassed", "text": "मी ठीक आहे! गाडीही ठीक आहे! डबे...?"}, {"id": 63, "duration_s": 3.65, "emotion": "crying", "text": "माझे डबे! माझं शोकेस!"}, {"id": 64, "duration_s": 1.97, "emotion": "shocked", "text": "रिकामा! हाही!"}, {"id": 65, "duration_s": 3.96, "emotion": "sad", "text": "सगळे रिकामे! एकही मिठाई नाही!"}, {"id": 66, "duration_s": 3.38, "emotion": "stern_warning", "text": "धनाजी! डबे खाली?"}, {"id": 67, "duration_s": 2.94, "emotion": "embarrassed", "text": "दाखवायला आहेत! भरले डबे महाग!"}, {"id": 68, "duration_s": 2.61, "emotion": "proud", "text": "बघितलं? हेल्मेटवर फक्त डबा पडला."}, {"id": 69, "duration_s": 3.61, "emotion": "serious", "text": "समजा, हेल्मेट नसतं तर?"}, {"id": 70, "duration_s": 0.751, "emotion": "happy", "text": "तर केस वाचले!"}, {"id": 71, "duration_s": 3.75, "emotion": "sarcastic", "text": "एवढ्या गोंधळातही... हवालदार झोपाजी घोरत होते."}, {"id": 72, "duration_s": 5.608, "emotion": "shouting", "text": "समोसा? म्हणजे... चौकशी होणार!"}, {"id": 73, "duration_s": 4.41, "emotion": "stern_warning", "text": "पट्टा उघडा, हातात फोन... लायसन्स दाखवा!"}, {"id": 74, "duration_s": 1.61, "emotion": "sarcastic", "text": "हे रेशन कार्ड आहे."}, {"id": 75, "duration_s": 3.13, "emotion": "curious", "text": "हे जिम कार्ड आहे. तुम्ही जिमला जाता?"}, {"id": 76, "duration_s": 5.09, "emotion": "embarrassed", "text": "कार्डच जातं."}, {"id": 77, "duration_s": 3.345, "emotion": "shocked", "text": "हे... कुणा पोराचं प्रगतीपुस्तक आहे!"}, {"id": 78, "duration_s": 2.28, "emotion": "embarrassed", "text": "बाबा! ते माझं आहे!"}, {"id": 79, "duration_s": 3.62, "emotion": "serious", "text": "लायसन्सशिवाय, फोनवर बोलणं... चलान!"}, {"id": 80, "duration_s": 6.21, "emotion": "pleading", "text": "झोपाजी... गरमागरम समोसा? चलानऐवजी?"}, {"id": 81, "duration_s": 4.75, "emotion": "stern_warning", "text": "लाच? तीही बटाट्याची? अजिबात नाही!"}, {"id": 82, "duration_s": 1.32, "emotion": "embarrassed", "text": "भूक लागलीय!"}, {"id": 83, "duration_s": 3.99, "emotion": "serious", "text": "आधी आरटीओला जा. लर्नर लायसन्स काढा."}, {"id": 84, "duration_s": 2.29, "emotion": "sarcastic", "text": "दंड तुमच्या पॉकेटमनीतून कापणार."}, {"id": 85, "duration_s": 4.23, "emotion": "shocked", "text": "माझा पॉकेटमनी? मी बाबा ना!"}, {"id": 86, "duration_s": 2.75, "emotion": "determined", "text": "बाबा, उद्यापासून... वस्ती ड्रायव्हिंग स्कूल!"}, {"id": 87, "duration_s": 3.22, "emotion": "excited", "text": "आठवड्यानंतर... पोरांनी उघडलं ड्रायव्हिंग स्कूल!"}, {"id": 88, "duration_s": 3.11, "emotion": "excited", "text": "वस्ती ड्रायव्हिंग स्कूल! आज सगळ्यांची परीक्षा!"}, {"id": 89, "duration_s": 5.53, "emotion": "serious", "text": "मी सांगू? चार नियम: हेल्मेट, दोन्ही हात, फोन नाही, लायसन्स."}, {"id": 90, "duration_s": 2.66, "emotion": "proud", "text": "आणि मुलं? फक्त टाळ्या वाजवतील!"}, {"id": 91, "duration_s": 4.46, "emotion": "proud", "text": "आरटीओचं लर्नर लायसन्स! आता मी अर्धा ड्रायव्हर!"}, {"id": 92, "duration_s": 2.93, "emotion": "proud", "text": "सायन्स म्हणतं, हेल्मेटने डोकं गरम होतं."}, {"id": 93, "duration_s": 3.37, "emotion": "serious", "text": "सायन्स हेही म्हणतं: हेल्मेटने डोकं वाचतं."}, {"id": 94, "duration_s": 1.14, "emotion": "embarrassed", "text": "...हो, तेही."}, {"id": 95, "duration_s": 3.42, "emotion": "serious", "text": "मोहन गुरुजी, पहिला नियम: ब्रेक!"}, {"id": 96, "duration_s": 2.13, "emotion": "happy", "text": "ब्रेक? हो हो, लंच ब्रेक!"}, {"id": 97, "duration_s": 1.13, "emotion": "shouting", "text": "इंडिकेटर!"}, {"id": 98, "duration_s": 2.51, "emotion": "proud", "text": "इंडिया गेट? दिल्लीत आहे, बाळा!"}, {"id": 99, "duration_s": 0.86, "emotion": "shouting", "text": "लायसन्स!"}, {"id": 100, "duration_s": 2.51, "emotion": "stern_warning", "text": "सायलेन्स? हो! सगळे गप्प!"}, {"id": 101, "duration_s": 1.2, "emotion": "happy", "text": "चला, जाऊया!"}, {"id": 102, "duration_s": 1.67, "emotion": "serious", "text": "हिलाही दृष्ट लागली!"}, {"id": 103, "duration_s": 2.97, "emotion": "curious", "text": "पहिला उमेदवार... रिक्षा?"}, {"id": 104, "duration_s": 3.0, "emotion": "excited", "text": "लाईव्ह चालू आहे! वस्तीची महा-परीक्षा!"}, {"id": 105, "duration_s": 2.81, "emotion": "proud", "text": "टेन्शन नको! हीरोला हेल्मेट नको!"}, {"id": 106, "duration_s": 1.72, "emotion": "stern_warning", "text": "हेल्मेट नाही? बाहेर!"}, {"id": 107, "duration_s": 7.15, "emotion": "serious", "text": "एक, दोन, तीन... थांब, पुन्हा... एक..."}, {"id": 108, "duration_s": 3.38, "emotion": "angry", "text": "धनाजी! परीक्षा आहे, हिशेब नाही!"}, {"id": 109, "duration_s": 2.58, "emotion": "stern_warning", "text": "माझे डबे आहेत! एकही कमी नाही!"}, {"id": 110, "duration_s": 2.12, "emotion": "serious", "text": "वेळ संपली! पुढचा!"}, {"id": 111, "duration_s": 1.93, "emotion": "excited", "text": "ऐकलंत का? मी परीक्षा देतेय..."}, {"id": 112, "duration_s": 0.73, "emotion": "stern_warning", "text": "फोन!"}, {"id": 113, "duration_s": 1.12, "emotion": "embarrassed", "text": "...नंतर सांगते."}, {"id": 114, "duration_s": 3.03, "emotion": "shocked", "text": "आई! तुम्ही? स्कूटीवर?"}, {"id": 115, "duration_s": 2.42, "emotion": "proud", "text": "एकोणीसशे ऐंशीचं लायसन्स, बाळा!"}, {"id": 116, "duration_s": 1.42, "emotion": "determined", "text": "सगळी वस्ती बघेल!"}, {"id": 117, "duration_s": 2.27, "emotion": "proud", "text": "यांनाही स्कूटी मीच शिकवली होती!"}, {"id": 118, "duration_s": 1.04, "emotion": "excited", "text": "फर्स्ट क्लास! शंभर!"}, {"id": 119, "duration_s": 2.86, "emotion": "proud", "text": "मी कोणाला घाबरत नाही!"}, {"id": 120, "duration_s": 2.38, "emotion": "giggly", "text": "बाबा... पुन्हा उलटं!"}, {"id": 121, "duration_s": 1.96, "emotion": "mischievous", "text": "आता बघतो..."}, {"id": 122, "duration_s": 2.6, "emotion": "determined", "text": "गाडी चालवताना... फोन नाही!"}, {"id": 123, "duration_s": 0.72, "emotion": "tender", "text": "आधी तुम्ही."}, {"id": 124, "duration_s": 0.77, "emotion": "excited", "text": "पास!"}, {"id": 125, "duration_s": 2.82, "emotion": "serious", "text": "पण खरं लायसन्स आरटीओ देईल, मी नाही."}, {"id": 126, "duration_s": 2.85, "emotion": "excited", "text": "गणपत पास! गणपत पास!"}, {"id": 127, "duration_s": 3.03, "emotion": "excited", "text": "माझ्या बाबांकडे आता... मिशीही, लायसन्सही!"}, {"id": 128, "duration_s": 1.92, "emotion": "happy", "text": "धनाजी! टाळ्या!"}, {"id": 129, "duration_s": 3.27, "emotion": "excited", "text": "'बाबांची पहिली राइड'! दहा लाख व्ह्यूज!"}, {"id": 130, "duration_s": 3.88, "emotion": "comic_panic", "text": "माझे केस! दहा लाख लोकांनी पाहिले?!"}, {"id": 131, "duration_s": 1.97, "emotion": "laughing", "text": "हा हा! आता कंगव्यालाही हेल्मेट हवं!"}, {"id": 132, "duration_s": 3.46, "emotion": "calm", "text": "गणपत... एक गोष्ट लक्षात ठेव."}, {"id": 133, "duration_s": 3.88, "emotion": "serious", "text": "हेल्मेट डोक्यासाठी आहे, केसांसाठी नाही."}, {"id": 134, "duration_s": 4.83, "emotion": "calm", "text": "पट्टा बांधा, दोन्ही हात हँडलवर, फोन खिशात."}, {"id": 135, "duration_s": 5.8, "emotion": "tender", "text": "आणि मुलं? गाडी अठरानंतर, लायसन्ससह."}, {"id": 136, "duration_s": 4.77, "emotion": "proud", "text": "तोपर्यंत... टाळ्या!"}, {"id": 137, "duration_s": 2.7, "emotion": "happy", "text": "समजलं, बाबा! आधी डोकं, मग केस."}, {"id": 138, "duration_s": 1.39, "emotion": "excited", "text": "स्माईल, बाबा!"}, {"id": 139, "duration_s": 4.08, "emotion": "shocked", "text": "माझी वाघीण...?"}, {"id": 140, "duration_s": 0.91, "emotion": "sad", "text": "बेचाळीस... पुन्हा मोजू?"}]