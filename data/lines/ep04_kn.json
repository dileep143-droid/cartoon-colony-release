[{"id": 1, "duration_s": 4.62, "emotion": "calm", "text": "ರವಿವಾರ ಸಂಜೆ. ಶಿವಣ್ಣನ ಮನೇಲಿ ಸತ್ಯನಾರಾಯಣ ಪೂಜೆ."}, {"id": 2, "duration_s": 2.75, "emotion": "excited", "text": "ಬನಾನಾ ಕಿಂಗ್‌ಡಮ್ ರೀ! ಊ ಊ ಆ ಆ!"}, {"id": 3, "duration_s": 1.44, "emotion": "excited", "text": "ತೊಂಬತ್ತೊಂಬತ್ತೇ ರೂಪಾಯಿ!"}, {"id": 4, "duration_s": 1.23, "emotion": "shocked", "text": "ಮತ್ತೆ ಕಟ್ ಆಯ್ತಾ?!"}, {"id": 5, "duration_s": 2.57, "emotion": "embarrassed", "text": "ಊ ಊ ಆ ಆ?"}, {"id": 6, "duration_s": 3.31, "emotion": "mischievous", "text": "ಇದೆಲ್ಲಾ ಶುರುವಾಗಿದ್ದು... ಮೂರು ದಿನದ ಮುಂಚೆ."}, {"id": 7, "duration_s": 2.37, "emotion": "mischievous", "text": "ಒಂದು ಬಾಳೆಹಣ್ಣಿನ ಗೇಮಿಂದ."}, {"id": 8, "duration_s": 3.28, "emotion": "angry", "text": "ಪುಟ್ಟಾ! ಈ ಫೋನು 'ಗುಡ್ ಮಾರ್ನಿಂಗ್' ಕಳಿಸ್ತಾನೇ ಇಲ್ಲ!"}, {"id": 9, "duration_s": 1.89, "emotion": "proud", "text": "ಆಯ್ತು. ಹದಿನಾಲ್ಕು ಗ್ರೂಪಿಗೆ ಕಳಿಸ್ದೆ."}, {"id": 10, "duration_s": 1.83, "emotion": "proud", "text": "ಇಡೀ ಬಡಾವಣೆ ನೋಡಲಿ!"}, {"id": 11, "duration_s": 1.91, "emotion": "excited", "text": "ಅಜ್ಜಿ! ಅದ್ರಲ್ಲಿ ಮಂಗನ ಆಟ ಇದೆ!"}, {"id": 12, "duration_s": 3.04, "emotion": "tired", "text": "ಐದು ನಿಮಿಷ ಆಡಿ. ನಾನ್ ಸ್ವಲ್ಪ ಕಣ್ಣು ಮುಚ್ಚಿ..."}, {"id": 13, "duration_s": 2.98, "emotion": "excited", "text": "ಬನಾನಾ ಕಿಂಗ್‌ಡಮ್‌ಗೆ ಬರ್ರಿ ಬರ್ರಿ!"}, {"id": 14, "duration_s": 6.09, "emotion": "excited", "text": "ಹಣ್ಣು ಖಲಾಸ್! ಬರೇ ತೊಂಬತ್ತೊಂಬತ್ತು ರೂಪಾಯಿಗೆ ಶಂಭರ್ ಹಣ್ಣು!"}, {"id": 15, "duration_s": 0.93, "emotion": "curious", "text": "ತೊಂಭತ್ತೊಂಬತ್ತು ರೂಪಾಯಿನಾ? ಅಸಲೀದಾ?"}, {"id": 16, "duration_s": 2.5, "emotion": "mischievous", "text": "ಗುಗ್ಗು! ಆಟದ್ ದುಡ್ಡು ನಕಲಿ ಇರುತ್ತೆ."}, {"id": 17, "duration_s": 1.55, "emotion": "mischievous", "text": "ನನ್ಗೊಂದು ಐಡಿಯಾ ಬಂತು!"}, {"id": 18, "duration_s": 4.27, "emotion": "excited", "text": "ಶಬ್ದ ಕೇಳಿಸಿತಾ? ನಮ್ಗೆ ದುಡ್ಡು ಸಿಗ್ತಿದೆ!"}, {"id": 19, "duration_s": 2.07, "emotion": "laughing", "text": "ಇನ್ನೊಂದು! <laugh> ಇನ್ನೊಂದು!"}, {"id": 20, "duration_s": 4.14, "emotion": "happy", "text": "ಇಡೀ ಬಡಾವಣೆ... ನೋಡ್ತಾರೆ..."}, {"id": 21, "duration_s": 4.19, "emotion": "excited", "text": "ಶಾಬಾಶ್! ನೀವೇ ನೋಡ್ರಿ ಬನಾನಾ ಕಿಂಗ್‌ಡಮ್ ರಾಜ!"}, {"id": 22, "duration_s": 4.0, "emotion": "calm", "text": "ಅದೇ ದಿನ ಬೆಳಗ್ಗೆ. ಜಗುಲಿ ಮೇಲೆ ಶಿವಣ್ಣನ ಆರಾಮ."}, {"id": 23, "duration_s": 4.68, "emotion": "proud", "text": "ನನ್ ಬ್ಯಾಂಕ್ ಅಕೌಂಟು... ಕಲ್ಲಿನ ಕೋಟೆ ಕಣೋ, ಸೀನಾ!"}, {"id": 24, "duration_s": 2.174, "emotion": "sarcastic", "text": "ಕೋಟೇಲಿ ಏನಾದ್ರೂ ಇದ್ಯಾ?"}, {"id": 25, "duration_s": 3.63, "emotion": "neutral", "text": "ತೊಂಬತ್ತೊಂಬತ್ತು ಕಟ್? ಇರ್ಲಿ, ಚಹಾ ಖರ್ಚು."}, {"id": 26, "duration_s": 2.11, "emotion": "shocked", "text": "ನಾನ್ನೂರ ತೊಂಭತ್ತೊಂಬತ್ತಾ?!"}, {"id": 27, "duration_s": 2.43, "emotion": "curious", "text": "ಅಣ್ಣಾ, ಕೋಟೇಲಿ ತೂತು ಬಿದ್ದಿದೆ."}, {"id": 28, "duration_s": 3.96, "emotion": "panicked", "text": "ಒಂಬೈನೂರ ತೊಂಬತ್ತೊಂಬತ್ತು! ಕಳ್ಳಲ್ಲ, ಡಾಕು!"}, {"id": 29, "duration_s": 2.34, "emotion": "excited", "text": "ಟೆನ್ಶನ್ ಬಿಡು! ಫೋನನ್ನೇ ಮಾರ್ಬಿಡು!"}, {"id": 30, "duration_s": 3.28, "emotion": "determined", "text": "ನಾನ್ ಯಾರಿಗೂ ಹೆದ್ರಲ್ಲ! ಆ ಕಳ್ಳನ್ನ ನಾನು..."}, {"id": 31, "duration_s": 0.94, "emotion": "comic_panic", "text": "ಹ... ಹಲ್ಲಿ!"}, {"id": 32, "duration_s": 3.56, "emotion": "sarcastic", "text": "ಯಾರಿಗೂ ಹೆದ್ರಲ್ವಾ? ಹಲ್ಲಿಗೂ ಹೆದ್ರಲ್ವಾ?"}, {"id": 33, "duration_s": 2.11, "emotion": "embarrassed", "text": "ಅದು... ಕಳ್ಳನ ಗೂಢಚಾರಿ! ಸೀಕ್ರೆಟ್!"}, {"id": 34, "duration_s": 2.03, "emotion": "calm", "text": "ಸಾಕು! ಇವಾಗ ನಾನ್ ನೋಡ್ತೀ—"}, {"id": 35, "duration_s": 1.73, "emotion": "shouting", "text": "ಬೇಡ! ಇದು ಪೊಲೀಸ್ ಕೇಸು!"}, {"id": 36, "duration_s": 5.595, "emotion": "scared_whisper", "text": "ಹಲೋ, ಠಾಣೆನಾ? ನನ್ ಅಕೌಂಟು... ಲೂಟಿ ಆಗ್ತಿದೆ!"}, {"id": 37, "duration_s": 5.48, "emotion": "serious", "text": "ಜಾಂಚ್ ಆಗ್ಲೇಬೇಕು! ಪೂರ್ತಿ ಜಾಂಚ್!"}, {"id": 38, "duration_s": 5.786, "emotion": "panicked", "text": "ಸಾರ್, ಕಳ್ಳ ಕಾಣ್ಸಲ್ಲ... ದುಡ್ಡು ಮಾತ್ರ ಕಟ್ ಮಾಡ್ತಾನೆ!"}, {"id": 39, "duration_s": 2.33, "emotion": "curious", "text": "ಹ್ಞೂಂ... ಸುಳಿವಿನ ಘಮ."}, {"id": 40, "duration_s": 8.51, "emotion": "serious", "text": "ಕಳ್ಳ ಯಾವಾಗ ಬರ್ತಾನೆ? ಏನ್ ಹಾಕ್ಕೊಂಡಿರ್ತಾನೆ? ಚಟ್ನಿ ಎಲ್ಲಿ?"}, {"id": 41, "duration_s": 3.14, "emotion": "embarrassed", "text": "ಹಸಿವಾಗ್ತಿದೆ!"}, {"id": 42, "duration_s": 3.66, "emotion": "serious", "text": "ಬರಿ... ಕಳ್ಳ... ಹಸಿದ."}, {"id": 43, "duration_s": 2.03, "emotion": "curious", "text": "ಹಸಿದಿದ್ದಾನಾ? ಹೆಂಗೆ ಗೊತ್ತು?"}, {"id": 44, "duration_s": 3.42, "emotion": "proud", "text": "ಬೋಂಡಾ ಖಾಲಿಯಾಯ್ತಲ್ಲ!"}, {"id": 45, "duration_s": 1.25, "emotion": "pleading", "text": "ಸಾರ್? ಸಾರ್! ಕಳ್ಳ!"}, {"id": 46, "duration_s": 3.334, "emotion": "sarcastic", "text": "ಇನ್ನೊಂದು ಬೋಂಡಾ ಬೇಕಾ?"}, {"id": 47, "duration_s": 1.31, "emotion": "excited", "text": "ಜಾಂಚ್ ಆಗ್ಲಿ!"}, {"id": 48, "duration_s": 5.609, "emotion": "serious", "text": "ಠಾಣೆಗೆ ಹೋಗಿ ರಿಪೋರ್ಟ್ ತಿಂತೀನಿ. ಅಂದ್ರೆ... ಬರೀತೀನಿ."}, {"id": 49, "duration_s": 3.6, "emotion": "sad", "text": "<sigh> ಕಳ್ಳನಿಗೂ ಹಸಿವು... ಕಾನ್‌ಸ್ಟೆಬಲ್‌ಗೂ ಹಸಿವು."}, {"id": 50, "duration_s": 4.68, "emotion": "mischievous", "text": "ಒಂದೇ ಗಂಟೇಲಿ... ಬಡಾವಣೆ ಪೂರ್ತಿ ಸುದ್ದಿ ಹಬ್ಬಿತು."}, {"id": 51, "duration_s": 2.35, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಶಿವಣ್ಣನ ಫೋನಲ್ಲಿ ಕಳ್ಳ!"}, {"id": 52, "duration_s": 2.59, "emotion": "scared_whisper", "text": "ಕೇಳಿದ್ರಾ? ಕಳ್ಳ ಕಾಣ್ಸಲ್ವಂತೆ!"}, {"id": 53, "duration_s": 2.306, "emotion": "shocked", "text": "ಕೇಳಿದ್ರಾ? ಕಳ್ಳ ಮಂಗನಂತೆ!"}, {"id": 54, "duration_s": 1.48, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ..."}, {"id": 55, "duration_s": 2.37, "emotion": "serious", "text": "ಕಳ್ಳ... ಲೆಫ್ಟ್ ಹ್ಯಾಂಡೆಡ್ ಇರಬೇಕು!"}, {"id": 56, "duration_s": 1.01, "emotion": "curious", "text": "ಹೆಂಗೆ ಗೊತ್ತು?"}, {"id": 57, "duration_s": 2.47, "emotion": "proud", "text": "ದುಡ್ಡು ಯಾವಾಗ್ಲೂ ಎಡಗೈಯಿಂದ್ಲೇ ಹೋಗೋದು!"}, {"id": 58, "duration_s": 0.97, "emotion": "stern_warning", "text": "ಸೇಟ್ರೇ!"}, {"id": 59, "duration_s": 5.08, "emotion": "serious", "text": "ನನ್ ಎಡಗೈ ಲೆಕ್ಕಕ್ಕೆ ಮಾತ್ರ. ಒಂದ್ ರೂಪಾಯಿನೂ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 60, "duration_s": 4.34, "emotion": "serious", "text": "ದೃಷ್ಟಿ ಬಿದ್ದು ಹೋಯ್ತು! ಎಲ್ಲಾ ಫೋನಿಗೂ ನಿಂಬೆಹಣ್ಣು ಕಟ್ಟಿ!"}, {"id": 61, "duration_s": 2.45, "emotion": "excited", "text": "ಲೈವ್ ನಡೀತಾ ಇದೆ! ಬಡಾವಣೇಲಿ ಕಳ್ಳ!"}, {"id": 62, "duration_s": 1.69, "emotion": "determined", "text": "ನಡೀರಿ, ಹೋಗೋಣ! ಕಳ್ಳನ್ನ ಹಿಡಿಯೋಕೆ!"}, {"id": 63, "duration_s": 2.41, "emotion": "embarrassed", "text": "<sigh> ಕಳ್ಳನ್ನ ನಡ್ಕೊಂಡೇ ಹಿಡಿಯೋಣ."}, {"id": 64, "duration_s": 2.24, "emotion": "comic_panic", "text": "ಹತ್ತೊಂಬೈನೂರ ತೊಂಬತ್ತೊಂಬತ್ತು! ಈಗ್ಲೇ!"}, {"id": 65, "duration_s": 2.04, "emotion": "shocked", "text": "ಕಳ್ಳ ನಮ್ ಮಧ್ಯೆನೇ ಇದ್ದಾನೆ!"}, {"id": 66, "duration_s": 1.92, "emotion": "shouting", "text": "ನೀನು! ಇಲ್ಲ, ನೀನು!"}, {"id": 67, "duration_s": 0.81, "emotion": "shouting", "text": "ಗಪ್ ಚುಪ್!"}, {"id": 68, "duration_s": 2.82, "emotion": "curious", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಕಳ್ಳ ಮನೇಲಿರೋರೇ..."}, {"id": 69, "duration_s": 1.17, "emotion": "shouting", "text": "ಬೇಡ!"}, {"id": 70, "duration_s": 2.54, "emotion": "sarcastic", "text": "ಮಕ್ಕಳಿಗೆ ಸೈನ್ಸ್ ಅರ್ಥ ಆಗಲ್ಲ!"}, {"id": 71, "duration_s": 3.47, "emotion": "scared_whisper", "text": "ರಾತ್ರಿ ಎರಡು ಗಂಟೆ. ಇಡೀ ಬಡಾವಣೆ ಮಲಗಿದೆ..."}, {"id": 72, "duration_s": 1.5, "emotion": "mischievous", "text": "...ಬಹುತೇಕ ಎಲ್ಲರೂ."}, {"id": 73, "duration_s": 3.09, "emotion": "scared_whisper", "text": "ಇನ್ನೊಂದೇ ಲೆವೆಲ್... ಆಮೇಲೆ ಮಲಗ್ತೀನಿ."}, {"id": 74, "duration_s": 2.92, "emotion": "scared_whisper", "text": "ಶ್ಶ್ಶ್! ಮಂಗಂಗೆ ಹಸಿವಾಗಿದೆ."}, {"id": 75, "duration_s": 2.06, "emotion": "scared_whisper", "text": "ಕಳ್ಳ... ಮನೆ ಒಳಗೇ ಇದ್ದಾನೆ!"}, {"id": 76, "duration_s": 1.94, "emotion": "scared_whisper", "text": "ನಾನ್ ಯಾರಿಗೂ ಹೆದ್ರಲ್ಲ... ಯಾರಿಗೂ..."}, {"id": 77, "duration_s": 1.35, "emotion": "scared_whisper", "text": "ಯಾರಲ್ಲಿ? ಕೈ ಮೇಲೆ!"}, {"id": 78, "duration_s": 1.81, "emotion": "angry", "text": "ರಾತ್ರಿ ಹೊತ್ತು ಟಾರ್ಚಾ?!"}, {"id": 79, "duration_s": 2.89, "emotion": "embarrassed", "text": "ಅಮ್ಮಾ... ನೀವೇನಾದ್ರೂ ಕಳ್ಳನ್ನ ನೋಡಿದ್ರಾ?"}, {"id": 80, "duration_s": 5.19, "emotion": "tired", "text": "ಕಳ್ಳನಾ? <short pause> ಇಲ್ಲಿ ನಾನೊಬ್ಳೇ."}, {"id": 81, "duration_s": 1.29, "emotion": "relieved", "text": "ಹೂಂ... ನೀವು ಮಲಗಿದ್ದೀರಲ್ವಾ."}, {"id": 82, "duration_s": 4.39, "emotion": "serious", "text": "ಬಡಾವಣೇಲಿ ಕಳ್ಳ ಓಡಾಡ್ತಿದ್ದಾನೆ. ಒಂದ್ ರೂಪಾಯಿನೂ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 83, "duration_s": 1.069, "emotion": "excited", "text": "ಟೆನ್ಶನ್ ಬಿಡಿ!"}, {"id": 84, "duration_s": 3.5, "emotion": "mischievous", "text": "ಗೇಮ್ ಹ್ಯಾಕ್! ಅನ್‌ಲಿಮಿಟೆಡ್ ಬಾಳೆಹಣ್ಣು! ಬರೇ ಇನ್ನೂರು ರೂಪಾಯಿಗೆ!"}, {"id": 85, "duration_s": 1.89, "emotion": "curious", "text": "ಇನ್ನೂರಿಲ್ಲ... ಎರಡು ಸಮೋಸಾ."}, {"id": 86, "duration_s": 4.14, "emotion": "happy", "text": "ನಡೆಯುತ್ತೆ! ಡೀಲ್ ಪಕ್ಕಾ!"}, {"id": 87, "duration_s": 2.96, "emotion": "shocked", "text": "ಅಯ್ಯೋ! ಪೇಮೆಂಟನ್ನೇ ತಿಂದ್ಬುಟ್ಟ!"}, {"id": 88, "duration_s": 3.54, "emotion": "stern_warning", "text": "ಗೇಮ್ ಹ್ಯಾಕಾ? ಅಸಲಿ ಹ್ಯಾಕ್ ನಾನ್ ತೋರ್ಸ್ಲಾ?"}, {"id": 89, "duration_s": 2.79, "emotion": "pleading", "text": "ಅತ್ತಿಗೆ... ಇದು ಸಮಾಜ ಸೇವೆ ಕಣ್ರೀ!"}, {"id": 90, "duration_s": 3.37, "emotion": "excited", "text": "ಇನ್ನೂರಾ? ಅದ್ರಲ್ಲಿ ನಂಗೆ ಹತ್ತು ಪರ್ಸೆಂಟ್!"}, {"id": 91, "duration_s": 0.94, "emotion": "stern_warning", "text": "ಸೇಟ್ರೇ!"}, {"id": 92, "duration_s": 1.87, "emotion": "happy", "text": "ಹ್ಯಾಕ್ ಮಜಾವಾಗಿತ್ತು."}, {"id": 93, "duration_s": 5.32, "emotion": "calm", "text": "ಮೂರು ದಿನದ ನಂತರ. ಅದೇ ಪೂಜೆ... ಎಲ್ಲಿಂದ ಶುರುವಾಗಿತ್ತೋ."}, {"id": 94, "duration_s": 4.43, "emotion": "scared_whisper", "text": "ಇವತ್ತು ಯಾವ್ ಖರ್ಚೂ ಇಲ್ಲ. ಇವತ್ತು ಪೂಜೆ ಇದೆ."}, {"id": 95, "duration_s": 3.46, "emotion": "scared_whisper", "text": "ಲೈವ್ ನಡೀತಾ ಇದೆ! ಶಿವಣ್ಣನ ಪೂಜೆ, ಎಕ್ಸ್‌ಕ್ಲೂಸಿವ್!"}, {"id": 96, "duration_s": 3.34, "emotion": "serious", "text": "ಆಮೇಲೆ ಲೀಲಾವತಿ... ಪ್ರಸಾದ ತಿನ್ಲಿಲ್ಲ."}, {"id": 97, "duration_s": 2.29, "emotion": "curious", "text": "ಇದು ಯಾವ ಅಧ್ಯಾಯಪ್ಪಾ?"}, {"id": 98, "duration_s": 3.15, "emotion": "excited", "text": "ಹೊಸ ಭಜನೆ! ಬಾಳೆಹಣ್ಣು ಭಜನೆ!"}, {"id": 99, "duration_s": 1.17, "emotion": "shocked", "text": "ದೃಷ್ಟಿ ಬಿದ್ದು ಹೋಯ್ತು!"}, {"id": 100, "duration_s": 2.11, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಅಜ್ಜಿ ಡಿಸ್ಕೋ ಭಜನೆ!"}, {"id": 101, "duration_s": 3.09, "emotion": "excited", "text": "ಥ್ಯಾಂಕ್ಸ್! ತೊಂಬತ್ತೊಂಬತ್ತೇ ರೂಪಾಯಿ!"}, {"id": 102, "duration_s": 1.37, "emotion": "shocked", "text": "ಮತ್ತೆ ಕಟ್ ಆಯ್ತಾ?!"}, {"id": 103, "duration_s": 1.86, "emotion": "embarrassed", "text": "ಊ ಊ ಆ ಆ?"}, {"id": 104, "duration_s": 1.33, "emotion": "shouting", "text": "ಜಾಂಚ್ ಆಗ್ಲಿ!"}, {"id": 105, "duration_s": 0.92, "emotion": "shocked", "text": "ಅಜ್ಜಿನಾ?!"}, {"id": 106, "duration_s": 0.88, "emotion": "curious", "text": "ನಾನ್ ಹೇಳ್ಲಾ?"}, {"id": 107, "duration_s": 1.47, "emotion": "shouting", "text": "ಹೇಳು!"}, {"id": 108, "duration_s": 3.06, "emotion": "serious", "text": "ತೊಂಬತ್ತೊಂಬತ್ತು... ಒಂಬೈನೂರ ತೊಂಬತ್ತೊಂಬತ್ತು..."}, {"id": 109, "duration_s": 4.19, "emotion": "serious", "text": "ಎಲ್ಲಾ ಇದೇ ಫೋನಿಂದ. ಪೇಮೆಂಟ್ ಶಿವಣ್ಣ ಮಾವನ ಕಾರ್ಡಿಂದ."}, {"id": 110, "duration_s": 2.74, "emotion": "shocked", "text": "ನನ್ ಕಾರ್ಡಾ? ಅಮ್ಮನ ಫೋನಲ್ಲಾ?"}, {"id": 111, "duration_s": 4.72, "emotion": "sarcastic", "text": "ನೀನೇ ಹಾಕಿದ್ದು! ಕರೆಂಟ್ ಬಿಲ್ ಕಟ್ಟೋಕೆ!"}, {"id": 112, "duration_s": 2.079, "emotion": "sad", "text": "<sigh> ತೆಗೆಯೋಕೆ ಮರೆತು ಹೋಯ್ತು."}, {"id": 113, "duration_s": 3.86, "emotion": "guilty", "text": "ಅಪ್ಪಾ... ಆ ಮೊದಲನೇ ತೊಂಭತ್ತೊಂಬತ್ತು... ನಾನೇ ಮಾಡಿದ್ದು."}, {"id": 114, "duration_s": 4.64, "emotion": "guilty", "text": "ಮತ್ತೆ ನಾಲ್ನೂರ ತೊಂಭತ್ತೊಂಬತ್ತು... ನಾವಿಬ್ರೂ ಸೇರಿ."}, {"id": 115, "duration_s": 1.85, "emotion": "guilty", "text": "ಆಟದ್ ದುಡ್ಡು ನಕಲಿ ಅನ್ಕೊಂಡ್ವಿ."}, {"id": 116, "duration_s": 3.29, "emotion": "serious", "text": "ದುಡ್ಡು ಅಸಲಿ, ಆದ್ರೆ ಬಾಳೆಹಣ್ಣು ನಕಲಿ."}, {"id": 117, "duration_s": 3.5, "emotion": "guilty", "text": "ರಾತ್ರಿ ಎರಡಕ್ಕೆ ಪೇಮೆಂಟ್... ನಂದೇ."}, {"id": 118, "duration_s": 1.76, "emotion": "shocked", "text": "ರಾತ್ರಿ ಎರಡಕ್ಕಾ?!"}, {"id": 119, "duration_s": 1.84, "emotion": "pleading", "text": "ಮಂಗಂಗೆ ಹಸಿವು!"}, {"id": 120, "duration_s": 3.63, "emotion": "proud", "text": "ನೋಡಿದ್ರಾ! ಹೇಳಿದ್ದೆ, ಕಳ್ಳ ಹಸಿದಿದ್ದ!"}, {"id": 121, "duration_s": 2.74, "emotion": "proud", "text": "ಅಜ್ಜಿ ಲೆಫ್ಟ್ ಹ್ಯಾಂಡೆಡ್! ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ!"}, {"id": 122, "duration_s": 2.46, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಕಳ್ಳ ಅಜ್ಜಿನೇ ಅಂತೆ!"}, {"id": 123, "duration_s": 3.49, "emotion": "proud", "text": "ಇನ್ಮೇಲೆ ನಾನ್ ನೋಡ್ಕೋತೀನಿ! ನಾನ್ ಯಾರಿಗೂ—"}, {"id": 124, "duration_s": 1.93, "emotion": "determined", "text": "ಸಾಕು! ಇನ್ಮೇಲೆ ನಾನ್ ನೋಡ್ತೀನಿ."}, {"id": 125, "duration_s": 2.16, "emotion": "serious", "text": "ಒಂದು - ಪ್ರತಿ ಪೇಮೆಂಟಿಗೂ ಪಿನ್."}, {"id": 126, "duration_s": 2.15, "emotion": "serious", "text": "ಎರಡು - ತಿಂಗಳ ಮಿತಿ."}, {"id": 127, "duration_s": 4.35, "emotion": "serious", "text": "ಮೂರು - ಕಾರ್ಡ್ ಡಿಲೀಟ್, ಆಟೋ-ಪೇ ಬಂದ್."}, {"id": 128, "duration_s": 2.78, "emotion": "shocked", "text": "ಅಷ್ಟೇನಾ? ಹತ್ತೇ ಸೆಕೆಂಡಲ್ಲಿ?"}, {"id": 129, "duration_s": 1.47, "emotion": "pleading", "text": "ಮತ್ತೆ... ನಮ್ ಗೇಮು?"}, {"id": 130, "duration_s": 3.01, "emotion": "calm", "text": "ದಿನಾ ಅರ್ಧ ಗಂಟೆ. ಆಮೇಲೆ ಆಚೆ ಕ್ರಿಕೆಟ್!"}, {"id": 131, "duration_s": 1.88, "emotion": "excited", "text": "ಕ್ರಿಕೆಟ್ ಆದ್ಮೇಲೆ ಸಮೋಸಾನಾ?"}, {"id": 132, "duration_s": 1.512, "emotion": "worried", "text": "ಹೋದ ದುಡ್ಡು?"}, {"id": 133, "duration_s": 3.63, "emotion": "calm", "text": "ಕಂಪನಿಗೆ ಕಂಪ್ಲೇಂಟ್ ಮಾಡೋಣ. ಮುಂದಕ್ಕೆ... ಪಿನ್ ಹಾಕಿ!"}, {"id": 134, "duration_s": 6.01, "emotion": "calm", "text": "ಮಕ್ಕಳಿಗೆ ಫೋನ್‌ಗಿಂತ ಹೆಚ್ಚಾಗಿ... ನಮ್ ಪ್ರೀತಿ ಬೇಕು."}, {"id": 135, "duration_s": 4.68, "emotion": "serious", "text": "ಫೋನಲ್ಲಿ ಪಿನ್ನು... ಮಕ್ಕಳ ಜೊತೆ ಟೈಮು."}, {"id": 136, "duration_s": 2.87, "emotion": "laughing", "text": "ಅಜ್ಜಿಯ ಫೋನಿಗೆ ಮಾತ್ರ ಡಬಲ್ ಪಿನ್ನು!"}, {"id": 137, "duration_s": 2.76, "emotion": "proud", "text": "ನಾನ್ ಯಾರಿಗೂ ಹೆದ್ರಲ್ಲ! ಹಾಕ್ರೋ ಬಾಲು!"}, {"id": 138, "duration_s": 3.763, "emotion": "mischievous", "text": "ಲೆಫ್ಟ್ ಹ್ಯಾಂಡೆಡ್ ಆಟ. ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ!"}, {"id": 139, "duration_s": 3.79, "emotion": "sad", "text": "<sigh> ಥೇಟ್ ಚಪ್ಪಲಿ ಏಟು ತರಾನೇ."}, {"id": 140, "duration_s": 1.97, "emotion": "laughing", "text": "ಅಜ್ಜಿ ಗುರಿ ಎಂದೂ ತಪ್ಪಲ್ಲ!"}]