[{"id": 1, "duration_s": 3.64, "emotion": "embarrassed", "text": "ஆமா, நான்தான். எப்படின்னு யோசிக்கிறீங்களா?"}, {"id": 2, "duration_s": 4.45, "emotion": "mischievous", "text": "காலையிலிருந்து ஆரம்பிக்கலாம். காலனிக்கு வந்தது... புது பைக்!"}, {"id": 3, "duration_s": 4.29, "emotion": "proud", "text": "புது பைக்! எண்பதாயிரம்... ஒரு ரூபா கூட கம்மி இல்ல!"}, {"id": 4, "duration_s": 2.8, "emotion": "mischievous", "text": "எங்கப்பா பைக்! உங்கப்பாகிட்ட என்ன இருக்கு?"}, {"id": 5, "duration_s": 2.47, "emotion": "proud", "text": "எங்கப்பாகிட்ட... மீசை இருக்கு!"}, {"id": 6, "duration_s": 4.04, "emotion": "sarcastic", "text": "மீசை எங்கப்பாகிட்டயும் இருக்கு... பைக்கோட!"}, {"id": 7, "duration_s": 2.49, "emotion": "shocked", "text": "மீசையா?! இது மானப் பிரச்சனை!"}, {"id": 8, "duration_s": 2.29, "emotion": "proud", "text": "சாயந்திரத்துக்குள்ள என் வண்டி ஓடும்!"}, {"id": 9, "duration_s": 3.087, "emotion": "excited", "text": "கேட்டியா? முருகேசன் கப்பல் மாதிரி வண்டி வாங்குறாராம்!"}, {"id": 10, "duration_s": 4.21, "emotion": "sarcastic", "text": "சாயங்காலம் வண்டி வந்துச்சு... ஓடி இல்ல, தள்ளி!"}, {"id": 11, "duration_s": 2.7, "emotion": "tired", "text": "வந்துட்டா... என் சிங்கப்பெண்."}, {"id": 12, "duration_s": 4.1, "emotion": "sarcastic", "text": "இது ஓடுமா, இல்ல இதுக்கும் தள்ளணுமா?"}, {"id": 13, "duration_s": 4.34, "emotion": "proud", "text": "இது விண்டேஜ்! விண்டேஜ்னா... பழசு, ஆனா பொக்கிஷம்!"}, {"id": 14, "duration_s": 2.76, "emotion": "comic_panic", "text": "நான்... யாருக்கும் பயப்பட மாட்டேன்!"}, {"id": 15, "duration_s": 4.36, "emotion": "laughing", "text": "ஹா ஹா! ஸ்கூட்டி பதினஞ்சாயிரம், புகை இலவசம்!"}, {"id": 16, "duration_s": 0.62, "emotion": "stern_warning", "text": "ஏங்க!"}, {"id": 17, "duration_s": 2.1, "emotion": "excited", "text": "ஓடுது! அப்பா!"}, {"id": 18, "duration_s": 2.58, "emotion": "serious", "text": "கண்ணு பட்டா? எலுமிச்சை-மிளகாய் கட்டணும்!"}, {"id": 19, "duration_s": 2.8, "emotion": "proud", "text": "காலனியே பார்க்கட்டும்! என் புள்ள வண்டி!"}, {"id": 20, "duration_s": 2.76, "emotion": "proud", "text": "இன்னிக்கு முடி செட்டு... பைக்கே வெட்கப்படும்."}, {"id": 21, "duration_s": 1.323, "emotion": "stern_warning", "text": "ஹெல்மெட் போடுங்க."}, {"id": 22, "duration_s": 2.86, "emotion": "pleading", "text": "ஹெல்மெட்டால முடி கலையும் செல்வி! மாட்டேன்!"}, {"id": 23, "duration_s": 2.2, "emotion": "determined", "text": "போதும்! இனி நான் பாத்துக்கறேன்."}, {"id": 24, "duration_s": 2.49, "emotion": "comic_panic", "text": "நான் யாருக்கும் பயப்படமாட்டேன்... பல்லிய தவிர!"}, {"id": 25, "duration_s": 2.75, "emotion": "sarcastic", "text": "பல்லி போச்சு. இனி முடியும் போகும்."}, {"id": 26, "duration_s": 3.11, "emotion": "giggly", "text": "அப்பா, ஹெல்மெட் தலைகீழ்!"}, {"id": 27, "duration_s": 1.9, "emotion": "proud", "text": "தெரியும்! பின்னாடி இருக்கறவங்களுக்கு!"}, {"id": 28, "duration_s": 2.35, "emotion": "excited", "text": "Live-la இருக்கோம்! அப்பா ஹெல்மெட் தலைகீழ்!"}, {"id": 29, "duration_s": 2.14, "emotion": "sad", "text": "என் முடி... வீர மரணம்!"}, {"id": 30, "duration_s": 1.21, "emotion": "stern_warning", "text": "பட்டையும் கட்டுங்க."}, {"id": 31, "duration_s": 0.64, "emotion": "mischievous", "text": "நாளைக்கு."}, {"id": 32, "duration_s": 1.45, "emotion": "excited", "text": "டென்ஷன் வேணாம்! நான் சொல்லித்தரேன்!"}, {"id": 33, "duration_s": 2.11, "emotion": "proud", "text": "ஸ்கூட்டில கிளட்ச் இல்ல, முறுக்குங்க!"}, {"id": 34, "duration_s": 1.74, "emotion": "sarcastic", "text": "அண்ணே, முதல்ல ஸ்டார்ட் பண்ணுங்க!"}, {"id": 35, "duration_s": 1.69, "emotion": "excited", "text": "பாருங்க! நான் பறக்கறேன்!"}, {"id": 36, "duration_s": 1.73, "emotion": "proud", "text": "ஹீரோ! பத்து கிலோமீட்டர் ஆச்சு!"}, {"id": 37, "duration_s": 1.52, "emotion": "proud", "text": "நகராமலே!"}, {"id": 38, "duration_s": 1.36, "emotion": "shouting", "text": "முறுக்குங்க! முன்னாடி!"}, {"id": 39, "duration_s": 2.47, "emotion": "comic_panic", "text": "முன்னாடி எப்படி? வண்டி பின்னாடி போகுதே!"}, {"id": 40, "duration_s": 1.3, "emotion": "comic_panic", "text": "பிரேக்! பிரேக்! கை பிரேக்!"}, {"id": 41, "duration_s": 1.93, "emotion": "embarrassed", "text": "நான் நல்லாருக்கேன். வண்டியும்தான்."}, {"id": 42, "duration_s": 3.55, "emotion": "serious", "text": "கண்ணு பட்டுடுச்சு! நான் சொன்னேன்ல?"}, {"id": 43, "duration_s": 1.8, "emotion": "sad", "text": "<sigh> எலுமிச்சை பிரேக் ஆகாது ஆயா."}, {"id": 44, "duration_s": 2.09, "emotion": "angry", "text": "சேகர்! முதல்ல நீ கத்துக்கோடா!"}, {"id": 45, "duration_s": 1.78, "emotion": "embarrassed", "text": "டென்ஷன் வேணாம்... அவங்க குறி தப்பாது."}, {"id": 46, "duration_s": 2.7, "emotion": "mischievous", "text": "ஒரு idea இருக்கு! அப்பாவை விட நல்லா ஓட்டுவோம்!"}, {"id": 47, "duration_s": 2.9, "emotion": "excited", "text": "நான் பின்னாடி உட்காருவேன்... தின்பண்டத்தோட!"}, {"id": 48, "duration_s": 1.81, "emotion": "stern_warning", "text": "சும்மா இரு! கைய எடு!"}, {"id": 49, "duration_s": 3.78, "emotion": "serious", "text": "குழந்தைங்க வண்டி ஓட்டக் கூடாது. எப்பவும். புரியுதா?"}, {"id": 50, "duration_s": 3.39, "emotion": "serious", "text": "நான் சொல்லவா? பதினெட்டு வயசுக்கு முன்ன வண்டி ஓட்டுறது தப்பு."}, {"id": 51, "duration_s": 2.53, "emotion": "serious", "text": "கால் தரை எட்டாது. பிரேக் எப்படி போடுவீங்க?"}, {"id": 52, "duration_s": 1.33, "emotion": "proud", "text": "சாவி ஜப்தி!"}, {"id": 53, "duration_s": 3.98, "emotion": "excited", "text": "இன்னொரு idea இருக்கு! அப்பாவுக்கு நாம சொல்லித் தரலாம்!"}, {"id": 54, "duration_s": 2.56, "emotion": "tired", "text": "நான் யாருக்கும் பயப்படமாட்டேன்... குர்ர்..."}, {"id": 55, "duration_s": 5.28, "emotion": "proud", "text": "பாருங்க காலனி! முருகேசன்... ஆன் தி ரோடு!"}, {"id": 56, "duration_s": 3.8, "emotion": "proud", "text": "ஹலோ கந்தசாமி? ஸ்கூட்டி காத்தோட பேசுது!"}, {"id": 57, "duration_s": 4.15, "emotion": "sarcastic", "text": "காத்தோட இல்ல, என்னோட பேசுற. கவனி!"}, {"id": 58, "duration_s": 4.32, "emotion": "happy", "text": "வணக்கம் காமாட்சி மாமி! சொல்லுங்க கந்தசாமி!"}, {"id": 59, "duration_s": 4.83, "emotion": "sarcastic", "text": "ஒரு கையில் போன், இன்னொண்ணுல வணக்கம்... வண்டி யார் கையில்?"}, {"id": 60, "duration_s": 3.05, "emotion": "comic_panic", "text": "முருகேசா! முன்னாடி பாரு! முன்னாடி!"}, {"id": 61, "duration_s": 3.15, "emotion": "curious", "text": "முன்னாடியா? கந்தசாமி, நீங்க போன்லயே!"}, {"id": 62, "duration_s": 5.83, "emotion": "embarrassed", "text": "நான் நல்லா இருக்கேன்! வண்டியும்! டப்பாக்கள்...?"}, {"id": 63, "duration_s": 4.0, "emotion": "crying", "text": "என் டப்பாக்கள்! என் ஷோகேஸ்!"}, {"id": 64, "duration_s": 3.4, "emotion": "shocked", "text": "காலி! இதுவும் காலி!"}, {"id": 65, "duration_s": 3.39, "emotion": "sad", "text": "எல்லாமே காலி! ஒரு இனிப்பும் இல்ல!"}, {"id": 66, "duration_s": 1.67, "emotion": "stern_warning", "text": "ஏங்க! டப்பா காலியா?"}, {"id": 67, "duration_s": 3.16, "emotion": "embarrassed", "text": "காட்டத்தான் இதெல்லாம்! நிரப்பினா செலவாகும்!"}, {"id": 68, "duration_s": 3.23, "emotion": "proud", "text": "பார்த்தியா? ஹெல்மெட் மேல டப்பா தானே விழுந்துச்சு."}, {"id": 69, "duration_s": 1.43, "emotion": "serious", "text": "ஹெல்மெட் இல்லன்னா?"}, {"id": 70, "duration_s": 1.431, "emotion": "happy", "text": "முடி தப்பிச்சிருக்கும்!"}, {"id": 71, "duration_s": 6.96, "emotion": "sarcastic", "text": "இவ்ளோ களேபரத்துலயும்... கான்ஸ்டபிள் தூங்கு சாமி தூங்கிட்டிருந்தார்."}, {"id": 72, "duration_s": 3.99, "emotion": "shouting", "text": "சமோசா? அப்போ... விசாரணை!"}, {"id": 73, "duration_s": 6.97, "emotion": "stern_warning", "text": "பட்டை திறந்து, கையில போன்... லைசென்ஸ் காட்டு!"}, {"id": 74, "duration_s": 4.25, "emotion": "sarcastic", "text": "இது ரேஷன் கார்டு."}, {"id": 75, "duration_s": 5.34, "emotion": "curious", "text": "இது ஜிம் கார்டு. ஜிம்முக்கு போவியா?"}, {"id": 76, "duration_s": 3.771, "emotion": "embarrassed", "text": "கார்டு போகும்."}, {"id": 77, "duration_s": 4.16, "emotion": "shocked", "text": "இது... ஏதோ பையனோட ரிப்போர்ட் கார்டு!"}, {"id": 78, "duration_s": 2.94, "emotion": "embarrassed", "text": "அப்பா! என்னோடது!"}, {"id": 79, "duration_s": 6.77, "emotion": "serious", "text": "லைசென்ஸ் இல்ல, போன்ல பேச்சு... அபராதம்!"}, {"id": 80, "duration_s": 3.77, "emotion": "pleading", "text": "கான்ஸ்டபிள் சார்... சூடா சமோசா? அபராதத்துக்கு பதிலா?"}, {"id": 81, "duration_s": 4.691, "emotion": "stern_warning", "text": "லஞ்சமா? உருளைக்கிழங்கா? முடியாது!"}, {"id": 82, "duration_s": 0.91, "emotion": "embarrassed", "text": "பசிக்குது!"}, {"id": 83, "duration_s": 3.55, "emotion": "serious", "text": "முதல்ல ஆர்டிஓ போ. லைசென்ஸ் வாங்கு."}, {"id": 84, "duration_s": 2.08, "emotion": "sarcastic", "text": "அபராதம் உங்க பாக்கெட் மணியில கழியும்."}, {"id": 85, "duration_s": 2.58, "emotion": "shocked", "text": "என் பாக்கெட் மணியா? நான் அப்பா!"}, {"id": 86, "duration_s": 3.21, "emotion": "determined", "text": "அப்பா, நாளைலேருந்து... காலனி டிரைவிங் ஸ்கூல்!"}, {"id": 87, "duration_s": 3.5, "emotion": "excited", "text": "ஒரு வாரம் கழிச்சு... குழந்தைங்க ஆரம்பிச்ச டிரைவிங் ஸ்கூல்!"}, {"id": 88, "duration_s": 2.89, "emotion": "excited", "text": "காலனி டிரைவிங் ஸ்கூல்! இன்னிக்கு எல்லாருக்கும் டெஸ்ட்!"}, {"id": 89, "duration_s": 6.95, "emotion": "serious", "text": "நான் சொல்லவா? நாலு விதி: ஹெல்மெட், ரெண்டு கை, போன் கூடாது, லைசென்ஸ்."}, {"id": 90, "duration_s": 2.48, "emotion": "proud", "text": "குழந்தைங்க? கை தட்டுவோம், அவ்ளோதான்!"}, {"id": 91, "duration_s": 3.78, "emotion": "proud", "text": "ஆர்டிஓல லர்னர் லைசென்ஸ்! இப்ப நான் அரை டிரைவர்!"}, {"id": 92, "duration_s": 3.09, "emotion": "proud", "text": "அறிவியல் சொல்லுது, ஹெல்மெட்டால மூளை சூடாகும்!"}, {"id": 93, "duration_s": 4.1, "emotion": "serious", "text": "அறிவியல் இதையும் சொல்லுது: ஹெல்மெட் தலையைக் காக்கும்."}, {"id": 94, "duration_s": 2.13, "emotion": "embarrassed", "text": "...அதுவும்."}, {"id": 95, "duration_s": 3.07, "emotion": "serious", "text": "வாத்தியார் வேலு சார், முதல் விதி: பிரேக்!"}, {"id": 96, "duration_s": 3.49, "emotion": "happy", "text": "பிரேக்? ஆமா ஆமா, லஞ்ச் பிரேக்!"}, {"id": 97, "duration_s": 1.21, "emotion": "shouting", "text": "இண்டிகேட்டர்!"}, {"id": 98, "duration_s": 3.4, "emotion": "proud", "text": "இந்தியா கேட்டா? டெல்லில இருக்கு தம்பி!"}, {"id": 99, "duration_s": 1.13, "emotion": "shouting", "text": "லைசென்ஸ்!"}, {"id": 100, "duration_s": 3.26, "emotion": "stern_warning", "text": "சைலன்ஸா? ஆமா! அமைதி!"}, {"id": 101, "duration_s": 1.36, "emotion": "happy", "text": "வாங்க, போகலாம்!"}, {"id": 102, "duration_s": 1.66, "emotion": "serious", "text": "இதுக்கும் கண்ணு பட்டுடுச்சு!"}, {"id": 103, "duration_s": 2.17, "emotion": "curious", "text": "முதல் போட்டியாளர்... ஆட்டோ?"}, {"id": 104, "duration_s": 2.34, "emotion": "excited", "text": "Live-la இருக்கோம்! காலனி மகா டெஸ்ட்!"}, {"id": 105, "duration_s": 2.12, "emotion": "proud", "text": "டென்ஷன் வேணாம்! ஹீரோவுக்கு ஹெல்மெட் வேணாம்!"}, {"id": 106, "duration_s": 2.26, "emotion": "stern_warning", "text": "ஹெல்மெட் இல்லையா? வெளியே!"}, {"id": 107, "duration_s": 6.38, "emotion": "serious", "text": "ஒண்ணு, ரெண்டு, மூணு... மறுபடி... ஒண்ணு..."}, {"id": 108, "duration_s": 3.01, "emotion": "angry", "text": "ஏங்க! இது டெஸ்ட், கணக்கு இல்ல!"}, {"id": 109, "duration_s": 3.55, "emotion": "stern_warning", "text": "என் டப்பாக்கள்! ஒண்ணு கூட கம்மி இல்ல!"}, {"id": 110, "duration_s": 2.14, "emotion": "serious", "text": "நேரம் முடிஞ்சு! அடுத்து!"}, {"id": 111, "duration_s": 1.82, "emotion": "excited", "text": "கேட்டியா? நான் டெஸ்ட் குடுக்கறேன்..."}, {"id": 112, "duration_s": 0.65, "emotion": "stern_warning", "text": "போன்!"}, {"id": 113, "duration_s": 0.93, "emotion": "embarrassed", "text": "...அப்புறம் சொல்றேன்."}, {"id": 114, "duration_s": 2.59, "emotion": "shocked", "text": "அம்மா! நீங்களா? ஸ்கூட்டில?"}, {"id": 115, "duration_s": 2.78, "emotion": "proud", "text": "எண்பதுல வாங்கின லைசென்ஸ்டா, ராசா!"}, {"id": 116, "duration_s": 1.42, "emotion": "determined", "text": "காலனியே பார்க்கட்டும்!"}, {"id": 117, "duration_s": 2.44, "emotion": "proud", "text": "இவருக்கும் ஸ்கூட்டி நான்தான் சொல்லிக் கொடுத்தேன்!"}, {"id": 118, "duration_s": 2.48, "emotion": "excited", "text": "பர்ஸ்ட் கிளாஸ்! நூத்துக்கு நூறு!"}, {"id": 119, "duration_s": 3.97, "emotion": "proud", "text": "நான் யாருக்கும் பயப்படமாட்டேன்!"}, {"id": 120, "duration_s": 1.59, "emotion": "giggly", "text": "அப்பா... திரும்ப உல்டா!"}, {"id": 121, "duration_s": 1.05, "emotion": "mischievous", "text": "இப்ப பாக்கறேன்..."}, {"id": 122, "duration_s": 2.34, "emotion": "determined", "text": "வண்டி ஓட்டும்போது... போன் கூடாது!"}, {"id": 123, "duration_s": 0.98, "emotion": "tender", "text": "முதல்ல நீங்க."}, {"id": 124, "duration_s": 0.65, "emotion": "excited", "text": "பாஸ்!"}, {"id": 125, "duration_s": 2.89, "emotion": "serious", "text": "ஆனா உண்மையான லைசென்ஸ் ஆர்டிஓ தருவார், நான் இல்ல."}, {"id": 126, "duration_s": 4.27, "emotion": "excited", "text": "முருகேசன் பாஸ்! முருகேசன் பாஸ்!"}, {"id": 127, "duration_s": 4.41, "emotion": "excited", "text": "எங்கப்பாகிட்ட இப்ப... மீசையும் இருக்கு, லைசென்ஸும் இருக்கு!"}, {"id": 128, "duration_s": 1.74, "emotion": "happy", "text": "ஏங்க! கை தட்டுங்க!"}, {"id": 129, "duration_s": 3.83, "emotion": "excited", "text": "'அப்பாவின் முதல் ரைடு'! பத்து லட்சம் வியூஸ்!"}, {"id": 130, "duration_s": 3.38, "emotion": "comic_panic", "text": "என் முடி! பத்து லட்சம் பேர் பாத்துட்டாங்களா?!"}, {"id": 131, "duration_s": 2.36, "emotion": "laughing", "text": "ஹா ஹா! இனி சீப்புக்கும் ஹெல்மெட் வேணும்!"}, {"id": 132, "duration_s": 2.7, "emotion": "calm", "text": "முருகேசா... ஒண்ணு ஞாபகம் வெச்சுக்கோ."}, {"id": 133, "duration_s": 2.55, "emotion": "serious", "text": "ஹெல்மெட் தலைக்கு, முடிக்கு இல்ல."}, {"id": 134, "duration_s": 4.03, "emotion": "calm", "text": "பட்டை கட்டு, ரெண்டு கை ஹேண்டில்ல, போன் பாக்கெட்ல."}, {"id": 135, "duration_s": 6.02, "emotion": "tender", "text": "குழந்தைங்க? வண்டி பதினெட்டுக்கு மேல, லைசென்ஸோட."}, {"id": 136, "duration_s": 2.16, "emotion": "proud", "text": "அதுவரை... கை தட்டு!"}, {"id": 137, "duration_s": 5.38, "emotion": "happy", "text": "புரிஞ்சுது தாத்தா! தலை முதல்ல, முடி அப்புறம்!"}, {"id": 138, "duration_s": 1.65, "emotion": "excited", "text": "ஸ்மைல், அப்பா!"}, {"id": 139, "duration_s": 1.47, "emotion": "shocked", "text": "என் சிங்கப்பெண்...?"}, {"id": 140, "duration_s": 3.2, "emotion": "sad", "text": "நாப்பத்திரெண்டு... திரும்பவா?"}]