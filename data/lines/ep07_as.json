[{"id": 1, "duration_s": 3.79, "emotion": "mischievous", "text": "দীপাৱলীৰ ৰাতি। গোটেই পাড়াই এটাকে চাই আছে..."}, {"id": 2, "duration_s": 2.6, "emotion": "excited", "text": "ধনুৰ... সুপাৰ বোম!"}, {"id": 3, "duration_s": 2.52, "emotion": "proud", "text": "টেনশ্যন নলবা! জোনতকৈও বেছি শব্দ!"}, {"id": 4, "duration_s": 3.13, "emotion": "excited", "text": "লাইভ চলি আছে! দীপাৱলী স্পেচিয়েল!"}, {"id": 5, "duration_s": 1.44, "emotion": "stern_warning", "text": "চুপ! সকলো ৰেখাৰ পিছত!"}, {"id": 6, "duration_s": 0.88, "emotion": "scared_whisper", "text": "হৈ গ'ল নেকি?"}, {"id": 7, "duration_s": 3.8, "emotion": "mischievous", "text": "ৰ'বা ৰ'বা! এইবোৰ আৰম্ভ হৈছিল... আজি পুৱা।"}, {"id": 8, "duration_s": 2.99, "emotion": "happy", "text": "দীপাৱলীৰ পুৱা। পাড়াটো জিলমিলাই আছিল..."}, {"id": 9, "duration_s": 1.84, "emotion": "sarcastic", "text": "...আৰু ধনু টোপনিত।"}, {"id": 10, "duration_s": 4.15, "emotion": "excited", "text": "সুপাৰ বোম! জোনতকৈ বেশি আওয়াজ! আজিহে!"}, {"id": 11, "duration_s": 1.13, "emotion": "excited", "text": "জোনতকৈও বেছি?!"}, {"id": 12, "duration_s": 2.55, "emotion": "curious", "text": "ককাইদেউ... জোনৰ শব্দ কিমান হয়?"}, {"id": 13, "duration_s": 0.99, "emotion": "serious", "text": "...ইয়াতকৈ কম!"}, {"id": 14, "duration_s": 2.86, "emotion": "loving", "text": "মোৰ সুপাৰ বোম... মোৰ সোণ।"}, {"id": 15, "duration_s": 3.3, "emotion": "serious", "text": "মই কওঁনে? বাকচটোত কোনো নামেই নাই!"}, {"id": 16, "duration_s": 3.14, "emotion": "serious", "text": "কোম্পানী নাই, ঠিকনা নাই! গাড়ীৱালাও পলাল!"}, {"id": 17, "duration_s": 2.01, "emotion": "proud", "text": "টেনশ্যন নাই! ধনু আছোঁ!"}, {"id": 18, "duration_s": 1.05, "emotion": "happy", "text": "বলা বলা, যাওঁ!"}, {"id": 19, "duration_s": 2.32, "emotion": "comic_panic", "text": "বাচিলোঁ! মোৰ বোম বাচিল!"}, {"id": 20, "duration_s": 2.75, "emotion": "embarrassed", "text": "অ' ধনু, সেয়া মোৰ অটোৰ হাঁচি আছিল!"}, {"id": 21, "duration_s": 1.0, "emotion": "excited", "text": "এটা বুদ্ধি আছে!"}, {"id": 22, "duration_s": 3.31, "emotion": "determined", "text": "আজি ৰাতি... শিশুৰ সুৰক্ষা বাহিনী!"}, {"id": 23, "duration_s": 2.35, "emotion": "excited", "text": "শুনিছা? ধনুৱে বোম আনিছে!"}, {"id": 24, "duration_s": 3.3, "emotion": "sarcastic", "text": "আৰু দহ ছেকেণ্ডত... গোটেই পাড়াই গম পালে।"}, {"id": 25, "duration_s": 3.02, "emotion": "excited", "text": "চাওক! সুপাৰ বোম! জোনতকৈ বেছি শব্দ!"}, {"id": 26, "duration_s": 5.04, "emotion": "proud", "text": "মৃদুলাৰ আতচবাজী ইয়াৰ আগত ফুচ্! গোটেই পাড়াই চাব!"}, {"id": 27, "duration_s": 0.78, "emotion": "angry", "text": "ধনু!"}, {"id": 28, "duration_s": 18.83, "emotion": "embarrassed", "text": "ইচ্! এই নিশানা কেতিয়াও ভুল নহয়..."}, {"id": 29, "duration_s": 2.99, "emotion": "stern_warning", "text": "দীপৰ কাষত বাৰুদ? বুদ্ধি ঘাঁহ খাবলৈ গ'ল নেকি?"}, {"id": 30, "duration_s": 29.17, "emotion": "calm", "text": "ব্যস! এতিয়া মই চাওঁ।"}, {"id": 31, "duration_s": 2.23, "emotion": "stern_warning", "text": "আতচবাজী জুইৰ আঁতৰত, ঠাণ্ডা ঠাইত।"}, {"id": 32, "duration_s": 3.8, "emotion": "proud", "text": "আজি প্ৰথম ফুলজাৰি মই জ্বলাম! মই কাকো নাডৰো!"}, {"id": 33, "duration_s": 2.44, "emotion": "sarcastic", "text": "যোৱাবাৰ অনাৰ দেখি আলমাৰীত কোন সোমাইছিল?"}, {"id": 34, "duration_s": 2.64, "emotion": "embarrassed", "text": "আলমাৰী চাফা কৰিছিলোঁ... ভিতৰৰ পৰা।"}, {"id": 35, "duration_s": 2.1, "emotion": "proud", "text": "চেণ্ডেল ঘূৰাই দে। নিশানা তৈয়াৰ।"}, {"id": 36, "duration_s": 3.46, "emotion": "shouting", "text": "নীৰৱ বাজী! ধোঁৱা নাই, শব্দ নাই, ভয় নাই!"}, {"id": 37, "duration_s": 2.85, "emotion": "proud", "text": "এশ টকা বাকচ! এটকাও কম নহয়!"}, {"id": 38, "duration_s": 3.22, "emotion": "curious", "text": "ধনৰাম দা, নীৰৱ আতচবাজী জ্বলে কেনেকৈ?"}, {"id": 39, "duration_s": 4.38, "emotion": "mischievous", "text": "ইমান নিমাতে... যে গমকে নাপায়!"}, {"id": 40, "duration_s": 3.49, "emotion": "proud", "text": "বিজ্ঞানে কয়... শব্দ পোনে মগজুলৈ আহে!"}, {"id": 41, "duration_s": 1.34, "emotion": "excited", "text": "হয়... শুনা পাইছোঁ!"}, {"id": 42, "duration_s": 2.01, "emotion": "sad", "text": "ইয়াত তো খাবলৈও একো নাই!"}, {"id": 43, "duration_s": 0.91, "emotion": "happy", "text": "ভোক লাগিছে!"}, {"id": 44, "duration_s": 2.34, "emotion": "shocked", "text": "শুনিছা? ধনৰামে খালী বাকচ বেচিছে!"}, {"id": 45, "duration_s": 0.8, "emotion": "stern_warning", "text": "ধনৰাম!"}, {"id": 46, "duration_s": 4.81, "emotion": "embarrassed", "text": "মনি... এয়া প্ৰদূষণ-মুক্ত পেকেজিং!"}, {"id": 47, "duration_s": 3.3, "emotion": "sad", "text": "<sigh> নীৰৱ আতচবাজী... নীৰৱ গ্ৰাহক।"}, {"id": 48, "duration_s": 2.05, "emotion": "serious", "text": "আতচবাজীকো চকু লাগে, বোপা!"}, {"id": 49, "duration_s": 2.01, "emotion": "worried", "text": "আইতা, নেমু ফাটিলে?"}, {"id": 50, "duration_s": 2.0, "emotion": "serious", "text": "তেন্তে টেঙা ধামাকা হ'ব।"}, {"id": 51, "duration_s": 2.79, "emotion": "sarcastic", "text": "কনষ্টেবল তোপনৰামে পাড়া পহৰা দি আছিল..."}, {"id": 52, "duration_s": 1.67, "emotion": "happy", "text": "হৰ্নটোকো চকু লাগিল!"}, {"id": 53, "duration_s": 2.71, "emotion": "pleading", "text": "মাত্ৰ এটা... কেৱল তদন্তৰ বাবে।"}, {"id": 54, "duration_s": 2.563, "emotion": "stern_warning", "text": "তদন্ত হ'ব!"}, {"id": 55, "duration_s": 1.611, "emotion": "sad", "text": "<sigh> তদন্তইও মিঠাই খালে।"}, {"id": 56, "duration_s": 3.03, "emotion": "proud", "text": "মই কাকো নাডৰো! কেৱল জুই, ফিৰিঙতি, শব্দক!"}, {"id": 57, "duration_s": 1.85, "emotion": "loving", "text": "তেন্তে এটা নেমু তোমাৰ বাবেও।"}, {"id": 58, "duration_s": 2.73, "emotion": "excited", "text": "সন্ধিয়া... ল'ৰা-ছোৱালীয়ে দায়িত্ব ল'লে।"}, {"id": 59, "duration_s": 3.32, "emotion": "determined", "text": "এয়া সুৰক্ষা ৰেখা! ইয়াৰ সিপাৰে কোনো নাযায়!"}, {"id": 60, "duration_s": 4.23, "emotion": "serious", "text": "মই কওঁনে? পানীৰ বাল্টি, বালিৰ বাল্টি, আৰু দূৰত্ব!"}, {"id": 61, "duration_s": 1.95, "emotion": "excited", "text": "ফুচকা? ক'ত আছে ফুচকা?"}, {"id": 62, "duration_s": 1.64, "emotion": "excited", "text": "ফুচকা?! ক'ত?!"}, {"id": 63, "duration_s": 2.34, "emotion": "sarcastic", "text": "পানীৰ বাল্টি, চাৰ! আৰু বালি!"}, {"id": 64, "duration_s": 2.39, "emotion": "curious", "text": "বালি? ফুচকাৰ ৰেট কিমান?"}, {"id": 65, "duration_s": 2.8, "emotion": "embarrassed", "text": "দৰকাৰৰ সময়তে ইয়াৰ ছুটি!"}, {"id": 66, "duration_s": 2.59, "emotion": "shouting", "text": "সকলো ডাঙৰ ইফালে! নিয়ম শুনা!"}, {"id": 67, "duration_s": 3.09, "emotion": "stern_warning", "text": "হাতত ফুলজাৰি মাত্ৰ! বোম কেতিয়াও নহয়!"}, {"id": 68, "duration_s": 2.72, "emotion": "stern_warning", "text": "ৰেচমী কাপোৰ দীপৰ আঁতৰত! সূতী পিন্ধা!"}, {"id": 69, "duration_s": 2.5, "emotion": "comic_panic", "text": "পাঁচ মিনিট! আহিছোঁ!"}, {"id": 70, "duration_s": 0.78, "emotion": "shouting", "text": "চুপ! ঘূৰি আহা!"}, {"id": 71, "duration_s": 2.86, "emotion": "embarrassed", "text": "মই তো... ৰেখা পৰীক্ষা কৰি আছিলোঁ।"}, {"id": 72, "duration_s": 3.71, "emotion": "sarcastic", "text": "ৰাতি হ'ল... আৰু নায়ক সূতী কুৰ্তাৰে ঘূৰিল।"}, {"id": 73, "duration_s": 2.17, "emotion": "proud", "text": "মই কাকো নাডৰো! জ্বলোৱা!"}, {"id": 74, "duration_s": 3.47, "emotion": "stern_warning", "text": "হাত পোনে! মুখৰ আঁতৰত! বাল্টি ওচৰত!"}, {"id": 75, "duration_s": 1.053, "emotion": "comic_panic", "text": "ফি... ফিৰিঙতি!"}, {"id": 76, "duration_s": 0.36, "emotion": "comic_panic", "text": "আআআআআ!"}, {"id": 77, "duration_s": 2.91, "emotion": "comic_panic", "text": "এইটো নুমায় কিয়?!"}, {"id": 78, "duration_s": 2.72, "emotion": "excited", "text": "শুনিছা নেকি? হৰিয়ে মেৰাথন দৌৰি আছে!"}, {"id": 79, "duration_s": 2.06, "emotion": "sarcastic", "text": "ফুলজাৰি তো দুমিনিট আগতে নুমাইছিল।"}, {"id": 80, "duration_s": 1.22, "emotion": "tired", "text": "...কোৱা নাছিলা কিয়?"}, {"id": 81, "duration_s": 3.82, "emotion": "giggly", "text": "দেউতা, ফুলজাৰি ঠিয় হৈ জ্বলায়, দৌৰি নহয়!"}, {"id": 82, "duration_s": 3.2, "emotion": "serious", "text": "আৰু জ্বলা তাঁৰ পোনে পানীত। ভৰিত নহয়।"}, {"id": 83, "duration_s": 2.85, "emotion": "giggly", "text": "প্ৰথম ফুলজাৰি... আৰু প্ৰথম মেৰাথন!"}, {"id": 84, "duration_s": 2.04, "emotion": "mischievous", "text": "নতুন প্ৰেংক! চকলেটৰ বোম!"}, {"id": 85, "duration_s": 3.58, "emotion": "curious", "text": "বোমৰ পৰা... চকলেটৰ গোন্ধ?"}, {"id": 86, "duration_s": 1.5, "emotion": "shouting", "text": "বু... বু... বুম!"}, {"id": 87, "duration_s": 1.48, "emotion": "panicked", "text": "পিঠা ফাটিল!"}, {"id": 88, "duration_s": 0.76, "emotion": "shouting", "text": "পিঠা!!"}, {"id": 89, "duration_s": 3.03, "emotion": "giggly", "text": "ভিতৰত চকলেট আছিল! ভোক লাগিছিল!"}, {"id": 90, "duration_s": 2.71, "emotion": "excited", "text": "শুনিছা নেকি? পিঠা... আকৌ ভোকাতুৰ!"}, {"id": 91, "duration_s": 3.05, "emotion": "stern_warning", "text": "বোমৰ ঠাট্টা নহয়, বাইদেউ! সকলো ভয় খালে।"}, {"id": 92, "duration_s": 1.65, "emotion": "embarrassed", "text": "ছৰি... ৰিল ডিলিট।"}, {"id": 93, "duration_s": 2.83, "emotion": "mischievous", "text": "আৰু এতিয়া... ঘূৰি যাওঁ, য'ত কাহিনী ৰৈছিল।"}, {"id": 94, "duration_s": 3.39, "emotion": "stern_warning", "text": "দীঘল ধূপকাঠি! হাত পোনে! জ্বলাই পিছুৱা!"}, {"id": 95, "duration_s": 2.37, "emotion": "comic_panic", "text": "জ্বলিল! পলা... মানে, পিছুৱা!"}, {"id": 96, "duration_s": 1.93, "emotion": "proud", "text": "ৰ'বা... এইটো ভাবি আছে।"}, {"id": 97, "duration_s": 2.68, "emotion": "serious", "text": "বিজ্ঞানে কয়... এইটো টোপনি গ'ল।"}, {"id": 98, "duration_s": 3.63, "emotion": "shouting", "text": "ৰ'বা! ফুচ্ হোৱা বোমৰ ওচৰলৈ কোনেও নাযায়!"}, {"id": 99, "duration_s": 3.54, "emotion": "serious", "text": "মই কওঁ? পোন্ধৰ মিনিট ৰ'বা, পানী ঢালা।"}, {"id": 100, "duration_s": 3.02, "emotion": "sarcastic", "text": "পোন্ধৰ মিনিট? মোৰ সুঁতা চলি আছে!"}, {"id": 101, "duration_s": 1.69, "emotion": "embarrassed", "text": "...জোনতকৈও বেছি।"}, {"id": 102, "duration_s": 2.73, "emotion": "sarcastic", "text": "লাইভ চলি আছে... দুৰ্ভাগ্যবশত।"}, {"id": 103, "duration_s": 0.75, "emotion": "angry", "text": "ধনু..."}, {"id": 104, "duration_s": 1.06, "emotion": "shouting", "text": "তদন্ত হ'ব!"}, {"id": 105, "duration_s": 2.29, "emotion": "embarrassed", "text": "হৰ্নৰ কাৰণে! সঁচাকৈ!"}, {"id": 106, "duration_s": 2.51, "emotion": "curious", "text": "কি হ'ল? মিঠাই বাটি আছে নেকি?"}, {"id": 107, "duration_s": 2.58, "emotion": "tender", "text": "অ' ভুলু... তইও ভয় খালি?"}, {"id": 108, "duration_s": 10.86, "emotion": "worried", "text": "জন্তুৰ কাণ আমাতকৈ বহুত তীক্ষ্ণ।"}, {"id": 109, "duration_s": 2.97, "emotion": "serious", "text": "আমাক যি বোম লাগে, সিহঁতক ধুমুহা লাগে।"}, {"id": 110, "duration_s": 27.67, "emotion": "tender", "text": "শ্শ্শ... ভুলুৰ বাবে শান্ত কোণ!"}, {"id": 111, "duration_s": 13.58, "emotion": "calm", "text": "বোমৰ পৰা আঁতৰত... এটা সৰু শান্ত কোণ।"}, {"id": 112, "duration_s": 2.62, "emotion": "happy", "text": "মোৰো কাণ বুঢ়া। মইও ইয়াতে!"}, {"id": 113, "duration_s": 2.33, "emotion": "tender", "text": "আহ ভুলু, ইয়াত কোনো ধামাকা নাই।"}, {"id": 114, "duration_s": 12.24, "emotion": "serious", "text": "বেচেৰাক চকু লাগিছিল!"}, {"id": 115, "duration_s": 2.24, "emotion": "proud", "text": "শাবাশ, মোৰ সুৰক্ষা বাহিনী।"}, {"id": 116, "duration_s": 2.45, "emotion": "mischievous", "text": "আৰু... সুপাৰ বোমৰ পোষ্টমৰ্টেম।"}, {"id": 117, "duration_s": 3.67, "emotion": "serious", "text": "তদন্ত হ'ব! ...স্তৰে স্তৰে।"}, {"id": 118, "duration_s": 4.17, "emotion": "sad", "text": "ইমান ডাঙৰ বাকচ... ভিতৰত ইমানেই?"}, {"id": 119, "duration_s": 2.27, "emotion": "serious", "text": "নামবিহীন বোম বিপজ্জনকো হ'ব পাৰে।"}, {"id": 120, "duration_s": 3.9, "emotion": "loving", "text": "কাকা, লাইচেন্স দোকানৰ পৰা লবা। ভেনৰ নহয়।"}, {"id": 121, "duration_s": 2.74, "emotion": "guilty", "text": "ঠিকেই কৈছা। এইবাৰ আগতে সুধিম।"}, {"id": 122, "duration_s": 2.4, "emotion": "giggly", "text": "টেনশ্যন লম... অলপ।"}, {"id": 123, "duration_s": 2.25, "emotion": "stern_warning", "text": "ধনৰাম! খালী বাকচ?"}, {"id": 124, "duration_s": 3.45, "emotion": "guilty", "text": "ঠিক আছে! সকলোকে... ফ্ৰী মিঠাই!"}, {"id": 125, "duration_s": 3.03, "emotion": "crying", "text": "বিনামূলীয়া... কবলৈও কষ্ট হয়।"}, {"id": 126, "duration_s": 2.03, "emotion": "serious", "text": "তদন্ত শেষ।"}, {"id": 127, "duration_s": 1.56, "emotion": "happy", "text": "সমানে ভাগ হ'ল!"}, {"id": 128, "duration_s": 4.02, "emotion": "calm", "text": "সেই ৰাতি পাড়াত ধোঁৱা কম আছিল... আৰু পোহৰ বেছি।"}, {"id": 129, "duration_s": 3.46, "emotion": "loving", "text": "এই দীপবোৰ নিমাতে জ্বলে... আৰু গোটেই ৰাতি।"}, {"id": 130, "duration_s": 2.65, "emotion": "giggly", "text": "আৰু ইহঁতৰ বাবে হুইছিলো নালাগে!"}, {"id": 131, "duration_s": 3.17, "emotion": "excited", "text": "নতুন ৰিল... 'নীৰৱ দীপাৱলী'! লাইভ চলি আছে!"}, {"id": 132, "duration_s": 2.29, "emotion": "excited", "text": "শুনিছা নেকি? পৰীৰ ৰিল ভাইৰেল!"}, {"id": 133, "duration_s": 4.5, "emotion": "proud", "text": "দেখিলা? গোটেই পাড়াই দেখিলে! গোটেই দেশেও!"}, {"id": 134, "duration_s": 3.03, "emotion": "giggly", "text": "আৰু ৰিলত আপোনাৰ চেণ্ডেলো আছে!"}, {"id": 135, "duration_s": 3.06, "emotion": "proud", "text": "বিজ্ঞানে কয়... দীপেই সবাতকৈ নিৰাপদ বাজী।"}, {"id": 136, "duration_s": 3.07, "emotion": "shocked", "text": "পবিত্ৰই ঠিক কলে?! ঠিকে শুনিছোঁ?"}, {"id": 137, "duration_s": 5.6, "emotion": "serious", "text": "বোম হাতত নহয়, বাল্টি ওচৰত, শিশু ডাঙৰৰ লগত।"}, {"id": 138, "duration_s": 3.83, "emotion": "loving", "text": "আৰু জন্তু-বুঢ়াৰ বাবে এটা শান্ত কোণ।"}, {"id": 139, "duration_s": 3.32, "emotion": "calm", "text": "পোহৰ মনত থাকক... ধামাকা হাতত নহয়।"}, {"id": 140, "duration_s": 5.8, "emotion": "excited", "text": "শুভ সেফ দীপাৱলী!"}]