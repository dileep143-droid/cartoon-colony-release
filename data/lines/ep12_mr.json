[{"id": 1, "duration_s": 4.69, "emotion": "mischievous", "text": "सकाळचे सात... अख्ख्या कॉलनीचे फोन खणखणले!"}, {"id": 2, "duration_s": 3.19, "emotion": "angry", "text": "धनाजी शेठनं लोन घेतं शे! वसुली व्हई!"}, {"id": 3, "duration_s": 1.73, "emotion": "excited", "text": "शेठची गॉसिप... मला? <gasp>"}, {"id": 4, "duration_s": 2.04, "emotion": "scared_whisper", "text": "मी घरात नाही... मी तांदूळ आहे."}, {"id": 5, "duration_s": 0.98, "emotion": "stern_warning", "text": "शेठजी!"}, {"id": 6, "duration_s": 2.33, "emotion": "mischievous", "text": "हे सगळं सुरू झालं एक दिवस आधी... फक्त दोन मिनिटांत."}, {"id": 7, "duration_s": 9.12, "emotion": "serious", "text": "अठ्ठ्याण्णव, नव्व्याण्णव... पुन्हा मोजा. एक रुपयाही कमी नाही!"}, {"id": 8, "duration_s": 4.25, "emotion": "worried", "text": "दुकान छोटं, पोट मोठं! दुकान वाढवावंच!"}, {"id": 9, "duration_s": 4.12, "emotion": "mischievous", "text": "मोठी दुकान? मी आत्ता पोटात जागा करतोय."}, {"id": 10, "duration_s": 3.44, "emotion": "excited", "text": "दोन मिनिटमा लोन! कागद नही!"}, {"id": 11, "duration_s": 4.24, "emotion": "excited", "text": "दोन मिनिटांत? तेवढ्यात माझा चहाही गार होत नाही!"}, {"id": 12, "duration_s": 3.599, "emotion": "curious", "text": "शेठजी, लोन म्हणजे काय?"}, {"id": 13, "duration_s": 4.17, "emotion": "proud", "text": "लोन म्हणजे... दुसऱ्याचा पैसा, माझं दुकान!"}, {"id": 14, "duration_s": 2.22, "emotion": "calm", "text": "फक्त कॉन्टॅक्ट्सनी परवानगी द्या."}, {"id": 15, "duration_s": 3.58, "emotion": "happy", "text": "फक्त कॉन्टॅक्ट्स? घ्या ना! फुकटात!"}, {"id": 16, "duration_s": 3.43, "emotion": "calm", "text": "अन् फोटो गॅलरी बी."}, {"id": 17, "duration_s": 3.71, "emotion": "giggly", "text": "फोटोपण घ्या! माझ्यासारखा हँडसम कोण?"}, {"id": 18, "duration_s": 3.76, "emotion": "calm", "text": "अन् या अटी... नक्की वाचा."}, {"id": 19, "duration_s": 2.88, "emotion": "serious", "text": "मी सांगू? अटी वाचायलाच हव्यात, शेठजी!"}, {"id": 20, "duration_s": 4.28, "emotion": "sarcastic", "text": "वाचायला वेळ लागेल. आणि वेळ म्हणजे पैसा!"}, {"id": 21, "duration_s": 3.25, "emotion": "excited", "text": "अभिनंदन! लोन मंजूर शे!"}, {"id": 22, "duration_s": 3.93, "emotion": "shocked", "text": "वीस हजार मागितले... तेरा हजार आले?"}, {"id": 23, "duration_s": 2.43, "emotion": "happy", "text": "सात हजार प्रोसेसिंग फी शे, शेठजी!"}, {"id": 24, "duration_s": 4.3, "emotion": "worried", "text": "आणि सात दिवसांत परत द्यायचे... तीस हजार!"}, {"id": 25, "duration_s": 4.08, "emotion": "proud", "text": "सात दिवसांत तर दुकान डबल!"}, {"id": 26, "duration_s": 4.79, "emotion": "proud", "text": "आजपासून धनाजी शेठ... लोनवाले शेठ!"}, {"id": 27, "duration_s": 3.14, "emotion": "happy", "text": "लॉन? वा! गवत कुठे लावणार, शेठजी?"}, {"id": 28, "duration_s": 4.62, "emotion": "sarcastic", "text": "गवत नव्हे, गुरुजी! लोन! पैसा!"}, {"id": 29, "duration_s": 3.29, "emotion": "tired", "text": "शेठजी, फ्रीज मोठा का दार लहान बे?"}, {"id": 30, "duration_s": 2.93, "emotion": "serious", "text": "शेठजी, एवढे पैसे आले कुठून?"}, {"id": 31, "duration_s": 3.49, "emotion": "happy", "text": "देवानं दिले... दोन मिनिटांत."}, {"id": 32, "duration_s": 3.2, "emotion": "excited", "text": "दोन मिनिटांत पैसा? हे तर माझं स्वप्न आहे!"}, {"id": 33, "duration_s": 3.05, "emotion": "excited", "text": "लाइव्ह सुरू आहे! शेठजींचा नवा फ्रीज!"}, {"id": 34, "duration_s": 4.83, "emotion": "mischievous", "text": "त्या रात्री... व्याज जागं राहिलं. आणि शेठजीही."}, {"id": 35, "duration_s": 3.13, "emotion": "worried", "text": "बारा वाजले... एकवीस हजार!"}, {"id": 36, "duration_s": 3.08, "emotion": "panicked", "text": "एक वाजला... बावीस हजार!"}, {"id": 37, "duration_s": 2.59, "emotion": "comic_panic", "text": "हे व्याज आहे का लाइट मीटर?"}, {"id": 38, "duration_s": 3.02, "emotion": "scared_whisper", "text": "लखन! व्याज दर तासाला वाढतंय!"}, {"id": 39, "duration_s": 3.68, "emotion": "proud", "text": "सायन्स सांगतं... व्याजसुद्धा रात्री झोपतं."}, {"id": 40, "duration_s": 2.73, "emotion": "crying", "text": "व्याज झोपत नाही, हरीश... मी झोपत नाही!"}, {"id": 41, "duration_s": 2.5, "emotion": "tired", "text": "शेठजी... हिशोब उद्या."}, {"id": 42, "duration_s": 2.75, "emotion": "mischievous", "text": "ॲपनं शेठच्या प्रत्येक नंबरला फोन लावला."}, {"id": 43, "duration_s": 1.8, "emotion": "proud", "text": "कोण आहे? मी कुणाला भीत नाही!"}, {"id": 44, "duration_s": 3.44, "emotion": "shouting", "text": "शेठना पैसा भरा, नही तं सर्वायले फोटो धाडूत!"}, {"id": 45, "duration_s": 2.7, "emotion": "sarcastic", "text": "फोन आहे हो, पाल नव्हे!"}, {"id": 46, "duration_s": 5.72, "emotion": "angry", "text": "सगळ्यांना फोन, मला नाही? शेठनं माझा नंबरच ठेवला नाही?"}, {"id": 47, "duration_s": 6.71, "emotion": "proud", "text": "आला! हॅलो? हो, मीच... अख्खी कॉलनी बघेल!"}, {"id": 48, "duration_s": 1.81, "emotion": "worried", "text": "फोनला दृष्ट लागली!"}, {"id": 49, "duration_s": 4.32, "emotion": "shouting", "text": "चौकशी! ...कुणाची?"}, {"id": 50, "duration_s": 5.77, "emotion": "tired", "text": "फोनही वाजला, रिक्षाही बंद. चला..."}, {"id": 51, "duration_s": 0.73, "emotion": "stern_warning", "text": "गप्प!"}, {"id": 52, "duration_s": 2.31, "emotion": "excited", "text": "तीस वर्षं शेठची खबरबात नव्हती!"}, {"id": 53, "duration_s": 2.31, "emotion": "mischievous", "text": "ऐका! शेठनं लोन घेतलं!"}, {"id": 54, "duration_s": 2.65, "emotion": "sarcastic", "text": "माहितीय. मलाही फोन आला होता."}, {"id": 55, "duration_s": 2.02, "emotion": "excited", "text": "ऐकलं? शेठनं—"}, {"id": 56, "duration_s": 2.73, "emotion": "calm", "text": "माहितीय. लिंबूही बांधला."}, {"id": 57, "duration_s": 1.921, "emotion": "pleading", "text": "ऐकलं...?"}, {"id": 58, "duration_s": 3.12, "emotion": "giggly", "text": "माहितीय काकू! अख्ख्या कॉलनीला माहितीय!"}, {"id": 59, "duration_s": 2.4, "emotion": "mischievous", "text": "लोनवाले? शेठनं आणखी काय घेतलं?"}, {"id": 60, "duration_s": 1.61, "emotion": "surprised", "text": "काकू, तुम्ही वसुली करशात का?"}, {"id": 61, "duration_s": 2.773, "emotion": "giggly", "text": "नाही रे बाळा, मी फक्त खबर घेणार."}, {"id": 62, "duration_s": 2.37, "emotion": "angry", "text": "शेठजी! अख्खी कॉलनी काय म्हणतेय?!"}, {"id": 63, "duration_s": 1.63, "emotion": "serious", "text": "शेठजी कुठाय?"}, {"id": 64, "duration_s": 0.9, "emotion": "giggly", "text": "तांदळात."}, {"id": 65, "duration_s": 3.129, "emotion": "scared_whisper", "text": "शालू... मी पोत्यात नाही."}, {"id": 66, "duration_s": 2.61, "emotion": "guilty", "text": "फक्त दोन मिनिटांचं लोन होतं, शालू."}, {"id": 67, "duration_s": 4.39, "emotion": "sarcastic", "text": "दोन मिनिटांचं लोन... आणि अख्ख्या कॉलनीला फोन?"}, {"id": 68, "duration_s": 4.904, "emotion": "pleading", "text": "माझा फोटो घेतला! सगळ्यांना पाठवतील!"}, {"id": 69, "duration_s": 2.55, "emotion": "laughing", "text": "हा तर बाबांचा जिलबीवाला फोटो आहे!"}, {"id": 70, "duration_s": 1.94, "emotion": "determined", "text": "आता हिशोब मी करणार."}, {"id": 71, "duration_s": 3.11, "emotion": "excited", "text": "टेन्शन नको, शेठजी! माझ्याकडे दुसरं ॲप आहे!"}, {"id": 72, "duration_s": 1.84, "emotion": "proud", "text": "लोन फेडायला... नवं लोन!"}, {"id": 73, "duration_s": 2.13, "emotion": "excited", "text": "खरंच? किती मिनिटांत?"}, {"id": 74, "duration_s": 2.07, "emotion": "comic_panic", "text": "...मी तर गंमत करत होतो."}, {"id": 75, "duration_s": 3.49, "emotion": "angry", "text": "उधारीवर उधारी? थांब, सोन्या!"}, {"id": 76, "duration_s": 2.63, "emotion": "embarrassed", "text": "आजीचा नेम... कधी चुकत नाही."}, {"id": 77, "duration_s": 2.12, "emotion": "determined", "text": "बास! आता मी बघते."}, {"id": 78, "duration_s": 2.97, "emotion": "serious", "text": "आधी पुरावा. प्रत्येक धमकीचा स्क्रीनशॉट."}, {"id": 79, "duration_s": 3.3, "emotion": "calm", "text": "मग कॉन्टॅक्ट्स आणि फोटोची परवानगी... बंद."}, {"id": 80, "duration_s": 1.13, "emotion": "shocked", "text": "पण फुकट दिली होती!"}, {"id": 81, "duration_s": 0.7, "emotion": "shouting", "text": "गप्प!"}, {"id": 82, "duration_s": 2.52, "emotion": "excited", "text": "मला आयडिया सुचली! खऱ्या बँकेत जाऊ!"}, {"id": 83, "duration_s": 3.51, "emotion": "proud", "text": "मी सांगू? एकोणीस तीसवर सायबर तक्रार!"}, {"id": 84, "duration_s": 3.09, "emotion": "worried", "text": "बँक? तिथे बसायचीसुद्धा फी लागेल!"}, {"id": 85, "duration_s": 0.7, "emotion": "stern_warning", "text": "चला!"}, {"id": 86, "duration_s": 1.93, "emotion": "happy", "text": "चला, निघू या!"}, {"id": 87, "duration_s": 3.47, "emotion": "sarcastic", "text": "शेठजी, जरा पोट सरका... व्याजासकट!"}, {"id": 88, "duration_s": 3.5, "emotion": "tired", "text": "<sigh> महत्त्वाच्या कामालाच बंद पडते ही!"}, {"id": 89, "duration_s": 2.03, "emotion": "stern_warning", "text": "जोर लावा! मी मोजतेय."}, {"id": 90, "duration_s": 3.05, "emotion": "scared_whisper", "text": "आधी सांगा... बसायची फी नाही ना?"}, {"id": 91, "duration_s": 4.02, "emotion": "calm", "text": "मॅडम, ॲप रोज व्याज वाढवतं आणि सगळ्यांना धमकावतं."}, {"id": 92, "duration_s": 4.64, "emotion": "serious", "text": "मी सांगू? कुठल्याही ॲपला कॉन्टॅक्ट्स-फोटो कधीच नाही."}, {"id": 93, "duration_s": 3.07, "emotion": "serious", "text": "कर्ज फक्त बँक वा आरबीआय-मान्य संस्था."}, {"id": 94, "duration_s": 3.36, "emotion": "guilty", "text": "माझं ॲप... नोंदणीकृत होतं?"}, {"id": 95, "duration_s": 5.21, "emotion": "proud", "text": "धमकी? एकोणीस तीसला फोन, वा सायबर पोर्टल!"}, {"id": 96, "duration_s": 2.85, "emotion": "calm", "text": "सायबर क्राइम हेल्पलाईन. सांगा, काय झालं शे?"}, {"id": 97, "duration_s": 3.87, "emotion": "serious", "text": "लोन ॲप धमकावतंय. स्क्रीनशॉट सगळे आमच्याकडे आहेत."}, {"id": 98, "duration_s": 3.95, "emotion": "calm", "text": "बरं केलं. तक्रार नोंदली शे, नंबर मेसेजवर येई."}, {"id": 99, "duration_s": 1.93, "emotion": "worried", "text": "आणि... काही फी?"}, {"id": 100, "duration_s": 0.89, "emotion": "calm", "text": "कोणतीच फी नही."}, {"id": 101, "duration_s": 3.69, "emotion": "happy", "text": "दुकानासाठी योग्य लोन, योग्य कागदपत्रांसह."}, {"id": 102, "duration_s": 4.51, "emotion": "happy", "text": "मॅडम, तुमचा सल्ला... एक रुपयाही कमी नाही!"}, {"id": 103, "duration_s": 3.12, "emotion": "calm", "text": "संध्याकाळी शेठजींनी सत्यनारायणाची पूजा ठेवली."}, {"id": 104, "duration_s": 3.81, "emotion": "pleading", "text": "देवा, आज एकही फोन वाजू देऊ नको."}, {"id": 105, "duration_s": 3.46, "emotion": "serious", "text": "कथेचा पहिला अध्याय... लक्षपूर्वक ऐका."}, {"id": 106, "duration_s": 2.41, "emotion": "scared_whisper", "text": "आले... वसुलीवाले!"}, {"id": 107, "duration_s": 3.91, "emotion": "excited", "text": "प्लॅन? तीन... दोन... एक!"}, {"id": 108, "duration_s": 1.83, "emotion": "calm", "text": "शेठजी पूजा करताहेत!"}, {"id": 109, "duration_s": 1.96, "emotion": "angry", "text": "पूजा? पैसा कधी देता?!"}, {"id": 110, "duration_s": 4.65, "emotion": "proud", "text": "एकोणीस तीसवर तक्रार झाली! अख्खी कॉलनी साक्षीदार!"}, {"id": 111, "duration_s": 2.67, "emotion": "proud", "text": "आणि मी... कुणाला भीत नाही!"}, {"id": 112, "duration_s": 2.8, "emotion": "sarcastic", "text": "धमकीला भ्याले नाहीत... पालीला भ्याले."}, {"id": 113, "duration_s": 3.9, "emotion": "mischievous", "text": "बाळा, तुझं नाव काय? उद्या अख्ख्या कॉलनीला कळेल."}, {"id": 114, "duration_s": 2.48, "emotion": "serious", "text": "सगळ्या फोनना दृष्ट लागली!"}, {"id": 115, "duration_s": 4.68, "emotion": "excited", "text": "प्रसाद? ...चौकशी होणार!"}, {"id": 116, "duration_s": 3.97, "emotion": "guilty", "text": "भूक लागलीय! देव माफ करेल."}, {"id": 117, "duration_s": 3.1, "emotion": "excited", "text": "लाइव्ह सुरू आहे! जगातली पहिली अँटी-लोन आरती!"}, {"id": 118, "duration_s": 0.82, "emotion": "shouting", "text": "गप्प!"}, {"id": 119, "duration_s": 2.94, "emotion": "calm", "text": "तर... कथेचा पहिला अध्याय."}, {"id": 120, "duration_s": 2.9, "emotion": "loving", "text": "शेठजी, आता तुम्ही एकटे नाही."}, {"id": 121, "duration_s": 4.28, "emotion": "tender", "text": "अख्खी कॉलनी... आणि कुठलीही फी नाही."}, {"id": 122, "duration_s": 3.85, "emotion": "calm", "text": "दुसऱ्या सकाळी... कॉलनीत फोन वाजलाच नाही."}, {"id": 123, "duration_s": 6.999, "emotion": "proud", "text": "चौकशी झाली! सायबर सेलनं तक्रार नोंदवली."}, {"id": 124, "duration_s": 5.0, "emotion": "serious", "text": "ॲपची रिपोर्ट झाली. धमकीवाले फोन बंद."}, {"id": 125, "duration_s": 2.33, "emotion": "excited", "text": "मग... तीस हजार द्यायचे नाही?"}, {"id": 126, "duration_s": 3.82, "emotion": "serious", "text": "धमकीचं व्याज नाही. जेवढे मिळाले, तेवढे द्या."}, {"id": 127, "duration_s": 5.18, "emotion": "sad", "text": "तेरा हजार... पूर्ण. एक रुपयाही कमी नाही..."}, {"id": 128, "duration_s": 5.05, "emotion": "determined", "text": "कॉन्टॅक्ट्स माझे, फोटो माझे. कुठल्या ॲपचे नाहीत!"}, {"id": 129, "duration_s": 3.82, "emotion": "proud", "text": "सायन्स सांगतं, ॲप डिलीट तर लोनही डिलीट!"}, {"id": 130, "duration_s": 5.18, "emotion": "serious", "text": "मी सांगू? खरं कर्ज फेडायचं. धमकी सहन करायची नाही."}, {"id": 131, "duration_s": 5.88, "emotion": "proud", "text": "दुकान वाढणार... बँकेतून, योग्य कागदपत्रांसह!"}, {"id": 132, "duration_s": 5.16, "emotion": "guilty", "text": "आजोबा, मिनिटाचं लोन... दोन दिवस रडलो!"}, {"id": 133, "duration_s": 3.4, "emotion": "calm", "text": "घाईचा पैसा... खूप वेळ रडवतो."}, {"id": 134, "duration_s": 6.4, "emotion": "serious", "text": "कर्ज फक्त बँक वा आरबीआय-मान्य संस्थेकडून. अटी वाचून."}, {"id": 135, "duration_s": 8.22, "emotion": "stern_warning", "text": "ॲपला फोटो-कॉन्टॅक्ट नको. धमकी? एकोणीस तीस!"}, {"id": 136, "duration_s": 4.06, "emotion": "happy", "text": "आणि 'टाइम इज मनी' नाही... 'वाचणं इज मनी'!"}, {"id": 137, "duration_s": 3.92, "emotion": "happy", "text": "एक शब्दही सोडणार नाही... पूर्ण वाचीन!"}, {"id": 138, "duration_s": 1.48, "emotion": "excited", "text": "दोन मिनिटमा लोन!"}, {"id": 139, "duration_s": 2.24, "emotion": "happy", "text": "कॉलनीच्या गोष्टी... पुन्हा भेटू!"}]