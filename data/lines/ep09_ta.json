[{"id": 1, "duration_s": 2.79, "emotion": "excited", "text": "மழைக்காலம்... காலனியே போர்!"}, {"id": 2, "duration_s": 3.57, "emotion": "excited", "text": "மழை செல்ஃபி! இனி லட்சம் லைக்ஸ்!"}, {"id": 3, "duration_s": 3.31, "emotion": "sad", "text": "ஜீரோ லைக்ஸா? அம்மாவும் போடல!"}, {"id": 4, "duration_s": 2.95, "emotion": "proud", "text": "ஃபுட் ஃபோட்டோ! சமோசா எப்பவும் வைரல்!"}, {"id": 5, "duration_s": 1.75, "emotion": "embarrassed", "text": "பசிச்சுது! ஹி ஹி!"}, {"id": 6, "duration_s": 2.52, "emotion": "excited", "text": "கேப்டன் முதலை! செம வேகம்!"}, {"id": 7, "duration_s": 2.63, "emotion": "shocked", "text": "ஐயோ! என் கேப்டன் முதலை!"}, {"id": 8, "duration_s": 2.0, "emotion": "stern_warning", "text": "சாக்கடை பக்கம் போகாதே!"}, {"id": 9, "duration_s": 1.93, "emotion": "mischievous", "text": "டென்ஷன் வேணாம்! ஐடியா!"}, {"id": 10, "duration_s": 4.4, "emotion": "mischievous", "text": "கொஞ்சம் பெருசு... இன்னும்... போதும்!"}, {"id": 11, "duration_s": 3.37, "emotion": "excited", "text": "பத்து நிமிஷம், பத்தாயிரம் லைக்ஸ்! நான் ஸ்டார்!"}, {"id": 12, "duration_s": 2.17, "emotion": "proud", "text": "நிஜ முதலை யாருக்கு வேணும்?"}, {"id": 13, "duration_s": 2.19, "emotion": "scared_whisper", "text": "கேட்டியா? சாக்கடையில முதலையாம்!"}, {"id": 14, "duration_s": 2.67, "emotion": "proud", "text": "நாப்பது குரூப்! ஒரே மூச்சு! ரெக்கார்டு!"}, {"id": 15, "duration_s": 2.92, "emotion": "serious", "text": "பத்தே செகண்ட்... காலனியே அலறுச்சு."}, {"id": 16, "duration_s": 1.82, "emotion": "excited", "text": "ஆமா அதே! ரெண்டு பேருக்கும் சொல்றேன்!"}, {"id": 17, "duration_s": 1.66, "emotion": "panicked", "text": "வாத்தியார் வேலு! முதலை!"}, {"id": 18, "duration_s": 3.0, "emotion": "calm", "text": "கொசுவா? கொசுவலை போடுங்க!"}, {"id": 19, "duration_s": 2.29, "emotion": "shocked", "text": "மு... முதலையா? என் வேட்டி!"}, {"id": 20, "duration_s": 4.46, "emotion": "serious", "text": "கண்ணு பட்டுடுச்சு! முதலைக்கும் எலுமிச்சை மிளகா!"}, {"id": 21, "duration_s": 3.54, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது, மழையில முதலை செருப்புதான் திங்கும்!"}, {"id": 22, "duration_s": 3.44, "emotion": "panicked", "text": "கதவு க்ளோஸ்! ஜன்னல் க்ளோஸ்! பாத்ரூம் ஓட்டையும் க்ளோஸ்!"}, {"id": 23, "duration_s": 1.9, "emotion": "excited", "text": "ஒரு ஐடியா இருக்கு! முதலை பாக்கலாம்!"}, {"id": 24, "duration_s": 1.96, "emotion": "stern_warning", "text": "ஐடியாவ பையில வை. ஹோம்வொர்க் எடு."}, {"id": 25, "duration_s": 2.72, "emotion": "proud", "text": "பயம் வேணாம்! நான் யாருக்கும் பயப்படமாட்டேன்!"}, {"id": 26, "duration_s": 3.04, "emotion": "determined", "text": "முதலை வந்தா... நேரா பெவிலியன்தான்!"}, {"id": 27, "duration_s": 1.91, "emotion": "comic_panic", "text": "மு... மு... முதலைக்குட்டி!"}, {"id": 28, "duration_s": 1.69, "emotion": "determined", "text": "போதும்! நான் பாத்துக்கறேன்."}, {"id": 29, "duration_s": 3.37, "emotion": "scared_whisper", "text": "செல்வி... போச்சா? நிஜமா?"}, {"id": 30, "duration_s": 4.34, "emotion": "proud", "text": "என் பிள்ளை சிங்கம்! காலனியே பாக்கும்!"}, {"id": 31, "duration_s": 2.45, "emotion": "determined", "text": "இன்னைக்கு ராத்திரி... நான் கேட்ல காவல்!"}, {"id": 32, "duration_s": 3.32, "emotion": "guilty", "text": "அது... வந்து... அந்த ஃபோட்டோ..."}, {"id": 33, "duration_s": 2.07, "emotion": "angry", "text": "சீ! அபசகுனம் பேசாதே!"}, {"id": 34, "duration_s": 2.95, "emotion": "giggly", "text": "அப்பா... ஒரு தவளைக்கா?"}, {"id": 35, "duration_s": 4.33, "emotion": "scared_whisper", "text": "நடுராத்திரி... முருகேசன் வீட்டு கேட்ல... காவல்."}, {"id": 36, "duration_s": 3.74, "emotion": "tired", "text": "எனக்கு பயமே இல்ல... தூக்கத்தத் தவிர!"}, {"id": 37, "duration_s": 3.464, "emotion": "comic_panic", "text": "ய... யாரு? முன்னாடி வா!"}, {"id": 38, "duration_s": 2.1, "emotion": "relieved", "text": "<sigh> பூனையாரா! பயந்துட்டேன்."}, {"id": 39, "duration_s": 1.61, "emotion": "comic_panic", "text": "மு... மு... முதலை!"}, {"id": 40, "duration_s": 2.88, "emotion": "curious", "text": "முருகேசா, நடுராத்திரி கேட்ல ஏன் தொங்கற?"}, {"id": 41, "duration_s": 4.27, "emotion": "embarrassed", "text": "யோகா வாத்தியாரே! இதுக்கு பேரு... கேட்-ஆசனம்!"}, {"id": 42, "duration_s": 2.7, "emotion": "excited", "text": "கேட்டியா? முருகேசன் கேட்ல தொங்குறார்!"}, {"id": 43, "duration_s": 3.87, "emotion": "excited", "text": "முதலை-ப்ரூஃப் கம்பூட்! கடிச்சா பல்லு உடையும்!"}, {"id": 44, "duration_s": 3.26, "emotion": "proud", "text": "நேத்து நூறு. இன்னைக்கு முந்நூறு!"}, {"id": 45, "duration_s": 4.14, "emotion": "sarcastic", "text": "கந்தசாமி, முதலையவிட உங்க பல்லு பெருசு!"}, {"id": 46, "duration_s": 1.84, "emotion": "proud", "text": "ஒரு ரூபா கூட கம்மி இல்ல!"}, {"id": 47, "duration_s": 2.48, "emotion": "proud", "text": "இவ ஒண்ணா? எனக்கு ரெண்டு!"}, {"id": 48, "duration_s": 0.87, "emotion": "angry", "text": "எனக்கு மூணு!"}, {"id": 49, "duration_s": 2.55, "emotion": "proud", "text": "எனக்கு நாலு! காலனியே பாக்கட்டும்!"}, {"id": 50, "duration_s": 2.68, "emotion": "happy", "text": "போலாம்! வெறுங்கால்தான் சீப்பு!"}, {"id": 51, "duration_s": 2.0, "emotion": "calm", "text": "முதலாளி! இன்னும் வரவா?"}, {"id": 52, "duration_s": 6.08, "emotion": "happy", "text": "ஒண்ணு, ரெண்டு, மூணு... திரும்ப... ஒண்ணு, ரெண்டு..."}, {"id": 53, "duration_s": 2.97, "emotion": "excited", "text": "பூட்ல பிஸ்கட்! என்ன ஆஃபர்!"}, {"id": 54, "duration_s": 2.12, "emotion": "angry", "text": "பிஸ்கட் தனி! இருபது ரூபா!"}, {"id": 55, "duration_s": 3.25, "emotion": "guilty", "text": "எல்லாரும் கேளுங்க... அந்த முதலை உண்மையில..."}, {"id": 56, "duration_s": 1.97, "emotion": "shouting", "text": "அடுத்து! லைன்ல வாங்க!"}, {"id": 57, "duration_s": 2.51, "emotion": "serious", "text": "மதியம் ரெண்டு... முதலை வேட்டை, லைவ்!"}, {"id": 58, "duration_s": 3.01, "emotion": "excited", "text": "ஹாய் ஃப்ரெண்ட்ஸ்! லைவ்-ல இருக்கோம்! க்ரோக் ஹன்ட்!"}, {"id": 59, "duration_s": 2.6, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது, முதலை விசிலுக்கு வரும்."}, {"id": 60, "duration_s": 2.91, "emotion": "pleading", "text": "கந்தசாமி, நீங்க முன்ன போங்க. நீங்க பெரியவர்."}, {"id": 61, "duration_s": 2.64, "emotion": "angry", "text": "நானா? என் பூட் முந்நூறு ரூபா!"}, {"id": 62, "duration_s": 1.97, "emotion": "pleading", "text": "எல்லாரும் கேளுங்க! அந்த முதலை நிஜம் இல்ல..."}, {"id": 63, "duration_s": 1.839, "emotion": "shocked", "text": "அ... அ... அது அசையுது!"}, {"id": 64, "duration_s": 1.03, "emotion": "panicked", "text": "முதலை!!!"}, {"id": 65, "duration_s": 1.63, "emotion": "sad", "text": "...இல்ல."}, {"id": 66, "duration_s": 1.86, "emotion": "surprised", "text": "அட! அது என் செருப்பு!"}, {"id": 67, "duration_s": 2.91, "emotion": "proud", "text": "பாத்தீங்களா? சயின்ஸ்! முதலை துப்பிடுச்சு!"}, {"id": 68, "duration_s": 1.83, "emotion": "pleading", "text": "ராஜி! இழு!"}, {"id": 69, "duration_s": 2.89, "emotion": "excited", "text": "கேட்டியா? முதலை செருப்பைத் துப்பிடுச்சு!"}, {"id": 70, "duration_s": 2.35, "emotion": "excited", "text": "வியூஸ் டபுள்! செருப்பும் வைரல்!"}, {"id": 71, "duration_s": 3.41, "emotion": "guilty", "text": "<sigh> என் ஃபோட்டோ... செருப்பவிட பெருசா போச்சு."}, {"id": 72, "duration_s": 2.04, "emotion": "shouting", "text": "தூங்குசாமி சார்! முதலை!"}, {"id": 73, "duration_s": 1.26, "emotion": "sarcastic", "text": "பக்கோடா, சார்!"}, {"id": 74, "duration_s": 3.36, "emotion": "surprised", "text": "ஆ? எங்க? விசாரணை!"}, {"id": 75, "duration_s": 6.57, "emotion": "determined", "text": "முதலையோ, அதோட அப்பனோ... விசாரணை நடக்கும்!"}, {"id": 76, "duration_s": 1.77, "emotion": "scared_whisper", "text": "ஷ்ஷ்... சட்டம் வருது."}, {"id": 77, "duration_s": 4.17, "emotion": "comic_panic", "text": "மு... முதலை... குட்டி... பச்சை..."}, {"id": 78, "duration_s": 0.63, "emotion": "worried", "text": "கண்ணு!"}, {"id": 79, "duration_s": 1.64, "emotion": "sarcastic", "text": "தண்ணி? பக்கோடா?"}, {"id": 80, "duration_s": 4.159, "emotion": "tired", "text": "விசாரணை... தொடரும்..."}, {"id": 81, "duration_s": 2.3, "emotion": "sad", "text": "முதலை போச்சே..."}, {"id": 82, "duration_s": 1.95, "emotion": "excited", "text": "ஒரு ஐடியா இருக்கு! பயப்படாம விசாரிப்போம்!"}, {"id": 83, "duration_s": 1.66, "emotion": "serious", "text": "நான் சொல்லவா? வனத்துறைய கூப்பிடு!"}, {"id": 84, "duration_s": 0.72, "emotion": "stern_warning", "text": "அமைதி!"}, {"id": 85, "duration_s": 5.04, "emotion": "serious", "text": "ஹலோ, வனத்துறையா? சாக்கடையில முதலை... இருக்கலாம்."}, {"id": 86, "duration_s": 1.56, "emotion": "determined", "text": "நான் திண்பண்டம் பாக்கறேன்."}, {"id": 87, "duration_s": 3.0, "emotion": "excited", "text": "பிரேக்கிங் நியூஸுங்க! சாக்கடையில முதலை!"}, {"id": 88, "duration_s": 3.83, "emotion": "proud", "text": "நம்ம சாக்கடை டிவில! காலனியே பாக்கும்!"}, {"id": 89, "duration_s": 1.31, "emotion": "comic_panic", "text": "டென்ஷன் வேணாம்... வேணாம்... டென்ஷன்!"}, {"id": 90, "duration_s": 3.57, "emotion": "sarcastic", "text": "காலனி முழுக்க மொட்டை மாடில. தெருவுல எருமை மட்டும்."}, {"id": 91, "duration_s": 1.7, "emotion": "happy", "text": "இதோ! வனத்துறை வந்தாச்சு!"}, {"id": 92, "duration_s": 2.41, "emotion": "tired", "text": "ஒவ்வொரு தடவையும்! முக்கியமான நேரத்துல!"}, {"id": 93, "duration_s": 2.88, "emotion": "happy", "text": "சபாஷ்! நீதான் உண்மையான மெக்கானிக்!"}, {"id": 94, "duration_s": 2.37, "emotion": "serious", "text": "முதலை எங்கிட்டு இருக்கு? காட்டுங்கய்யா."}, {"id": 95, "duration_s": 0.65, "emotion": "panicked", "text": "அங்க!!!"}, {"id": 96, "duration_s": 2.07, "emotion": "scared_whisper", "text": "காலனியே மூச்சப் புடிச்சுது..."}, {"id": 97, "duration_s": 3.65, "emotion": "scared_whisper", "text": "நான் யாருக்கும் பயப்பட மாட்டேன்... யாருக்கும்..."}, {"id": 98, "duration_s": 3.35, "emotion": "sarcastic", "text": "இது முதலையா? ரப்பர் பொம்மைய்யா இது!"}, {"id": 99, "duration_s": 2.78, "emotion": "shocked", "text": "இவ்வளவுதானா? என் கம்பூட் என்னாகும்?"}, {"id": 100, "duration_s": 2.04, "emotion": "loving", "text": "என் கேப்டன் முதலை! கிடைச்சுட்டான்!"}, {"id": 101, "duration_s": 1.5, "emotion": "curious", "text": "ஆனா ஃபோட்டோவுல பெருசு!"}, {"id": 102, "duration_s": 3.14, "emotion": "proud", "text": "நான் சொல்லவா? இந்த ஃபோட்டோவுல மூணு தப்பு!"}, {"id": 103, "duration_s": 1.62, "emotion": "excited", "text": "ஃபேக்ட்-செக், லைவ்-ல இருக்கோம்!"}, {"id": 104, "duration_s": 2.92, "emotion": "serious", "text": "ஒண்ணு: பூனை நிழல்... முதலை நிழல் இல்ல!"}, {"id": 105, "duration_s": 4.39, "emotion": "serious", "text": "ரெண்டு: முதலை பெருசு! சாக்கடைல நுழையுமா?"}, {"id": 106, "duration_s": 3.46, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது, முதலை மூச்சடக்கி ஒல்லியாகும்!"}, {"id": 107, "duration_s": 0.45, "emotion": "stern_warning", "text": "ஷ்!"}, {"id": 108, "duration_s": 3.2, "emotion": "excited", "text": "மூணு: வால்ல போண்டாவோட பல்லு!"}, {"id": 109, "duration_s": 2.52, "emotion": "embarrassed", "text": "அது... பசிச்சுது."}, {"id": 110, "duration_s": 3.17, "emotion": "sarcastic", "text": "முதலைக் கண்ணீர் கேட்டிருக்கேன்... முதலை ஃபோட்டோ இப்பதான்!"}, {"id": 111, "duration_s": 1.96, "emotion": "serious", "text": "இந்த ஃபோட்டோ யார் எடுத்தது?"}, {"id": 112, "duration_s": 3.01, "emotion": "guilty", "text": "ஆமா... நான்தான். லைக்ஸுக்காக மட்டும்."}, {"id": 113, "duration_s": 1.16, "emotion": "angry", "text": "லைக்ஸா?!"}, {"id": 114, "duration_s": 2.18, "emotion": "embarrassed", "text": "பட்டம்மா குறி... எப்பவும் தப்பாது."}, {"id": 115, "duration_s": 4.9, "emotion": "guilty", "text": "நானும்... பாக்காம நாப்பது குரூப்புக்கு அனுப்பிட்டேன்."}, {"id": 116, "duration_s": 1.28, "emotion": "sad", "text": "என் முந்நூறு ரூபா பூட்... இனி யார் வாங்குவா?"}, {"id": 117, "duration_s": 1.17, "emotion": "stern_warning", "text": "முதலாளி!"}, {"id": 118, "duration_s": 3.68, "emotion": "embarrassed", "text": "சரி சரி... நூறு ரூபா. பழைய விலை."}, {"id": 119, "duration_s": 2.91, "emotion": "tired", "text": "நான் ராத்திரி முழுக்க கேட்-ஆசனம் பண்ணேனே!"}, {"id": 120, "duration_s": 4.04, "emotion": "determined", "text": "போதும்! நான் பாத்துக்கறேன். சாக்கடைய பிரபலமாக்கினவன்..."}, {"id": 121, "duration_s": 1.44, "emotion": "stern_warning", "text": "...அவனே க்ளீன் பண்ணு!"}, {"id": 122, "duration_s": 2.2, "emotion": "tired", "text": "டென்ஷன் வேணாம்... டென்ஷன் ஜாஸ்தி."}, {"id": 123, "duration_s": 2.79, "emotion": "excited", "text": "லைவ்-ல இருக்கோம்! சாக்கடை க்ளீனிங், எபிசோட் ஒண்ணு!"}, {"id": 124, "duration_s": 2.13, "emotion": "serious", "text": "திருத்தமும் அனுப்புவேன்... முதல்ல செக்!"}, {"id": 125, "duration_s": 3.16, "emotion": "curious", "text": "இதுல பிஸ்கட் இருக்கா?"}, {"id": 126, "duration_s": 4.535, "emotion": "excited", "text": "என் செருப்பு! பாத்தீங்களா? சயின்ஸ்!"}, {"id": 127, "duration_s": 4.7, "emotion": "serious", "text": "விசாரணை... முடிஞ்சுது. கேஸ் குளோஸ்."}, {"id": 128, "duration_s": 5.01, "emotion": "calm", "text": "சாயங்காலம், மழை நின்னுச்சு... சாக்கடை பளிச்சுன்னு மின்னுச்சு."}, {"id": 129, "duration_s": 5.12, "emotion": "calm", "text": "ஒரு போலி ஃபோட்டோ... காலனியே மொட்டை மாடில."}, {"id": 130, "duration_s": 1.97, "emotion": "guilty", "text": "தாத்தா, சும்மா ஜோக்கு..."}, {"id": 131, "duration_s": 4.47, "emotion": "serious", "text": "ஜோக் உன்னோடது. பயம் காலனி முழுக்க."}, {"id": 132, "duration_s": 1.86, "emotion": "curious", "text": "உண்மைய எப்படி தெரிஞ்சுக்கறது தாத்தா?"}, {"id": 133, "duration_s": 6.23, "emotion": "serious", "text": "நான் சொல்லவா? யார் அனுப்பினாங்க, நிழல், அளவு - முதல்ல செக் பண்ணுங்க."}, {"id": 134, "duration_s": 2.85, "emotion": "stern_warning", "text": "சந்தேகம்னா அனுப்பாதீங்க! பொய்யை ரிப்போர்ட் பண்ணுங்க!"}, {"id": 135, "duration_s": 2.34, "emotion": "serious", "text": "ஃபார்வர்டுக்கு முன்னாடி யோசிங்க..."}, {"id": 136, "duration_s": 3.04, "emotion": "tender", "text": "...இல்லன்னா ஒருநாள் உண்மையும் பொய்யாத் தெரியும்."}, {"id": 137, "duration_s": 3.7, "emotion": "relieved", "text": "அப்பாடா! இனி முதலை கிதலை எதுவுமில்ல."}, {"id": 138, "duration_s": 1.55, "emotion": "excited", "text": "அப்பா! சாக்கடையில ஏதோ இருக்கு!"}, {"id": 139, "duration_s": 3.28, "emotion": "sarcastic", "text": "ஆமா ஆமா... முதலை. போதும்டா."}, {"id": 140, "duration_s": 1.2, "emotion": "comic_panic", "text": "நான் யாருக்கும் பயப்பட மாட்டேன்!"}]