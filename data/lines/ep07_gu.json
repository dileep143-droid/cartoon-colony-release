[{"id": 1, "duration_s": 5.68, "emotion": "mischievous", "text": "દિવાળીની રાત. આખી સોસાયટી એક જ વસ્તુ જોઈ રહી છે..."}, {"id": 2, "duration_s": 3.31, "emotion": "excited", "text": "લાલાનો... સુપર બોમ્બ!"}, {"id": 3, "duration_s": 3.12, "emotion": "proud", "text": "ટેન્શન ના લો! ચાંદ કરતાં મોટો અવાજ!"}, {"id": 4, "duration_s": 3.25, "emotion": "excited", "text": "લાઈવ ચાલે છે! દિવાળી સ્પેશિયલ!"}, {"id": 5, "duration_s": 2.34, "emotion": "stern_warning", "text": "ચૂપ! બધા લાઈન પાછળ!"}, {"id": 6, "duration_s": 1.17, "emotion": "scared_whisper", "text": "બસ... પત્યું?"}, {"id": 7, "duration_s": 4.18, "emotion": "mischievous", "text": "ઊભા રહો! આ બધું શરૂ થ્યું'તું... આજે સવારે."}, {"id": 8, "duration_s": 3.84, "emotion": "happy", "text": "દિવાળીની સવાર. સોસાયટી ઝગમગતી હતી..."}, {"id": 9, "duration_s": 3.16, "emotion": "sarcastic", "text": "...અને લાલો ઘોરતો હતો."}, {"id": 10, "duration_s": 3.42, "emotion": "excited", "text": "સુપર બોમ્બ! ચાંદથી જાજો અવાજ! બસ આજના દી!"}, {"id": 11, "duration_s": 1.28, "emotion": "excited", "text": "ચાંદ કરતાં વધારે?!"}, {"id": 12, "duration_s": 2.56, "emotion": "curious", "text": "ભાઈ... ચાંદનો અવાજ કેટલો હોય?"}, {"id": 13, "duration_s": 1.0, "emotion": "serious", "text": "ઈનાથી ઓસો!"}, {"id": 14, "duration_s": 3.08, "emotion": "loving", "text": "મારો સુપર બોમ્બ... મારો બકુડો."}, {"id": 15, "duration_s": 2.41, "emotion": "serious", "text": "હું કહું? આ ડબ્બા પર કોઈ નામ નથી!"}, {"id": 16, "duration_s": 2.85, "emotion": "serious", "text": "કંપની નહીં, પત્તો નહીં! ગાડીવાળો ભાગ્યો!"}, {"id": 17, "duration_s": 2.23, "emotion": "proud", "text": "ટેન્શન ના લો! લાલો છે ને!"}, {"id": 18, "duration_s": 1.32, "emotion": "happy", "text": "ચાલો, નીકળીએ!"}, {"id": 19, "duration_s": 2.03, "emotion": "comic_panic", "text": "બચી ગયો! મારો બોમ્બ બચી ગયો!"}, {"id": 20, "duration_s": 3.41, "emotion": "embarrassed", "text": "અરે લાલા, એ તો મારી રિક્ષાની છીંક હતી!"}, {"id": 21, "duration_s": 0.84, "emotion": "excited", "text": "એક આઈડિયા છે!"}, {"id": 22, "duration_s": 2.77, "emotion": "determined", "text": "આજ રાત... બાળકોની સેફ્ટી સ્ક્વોડ!"}, {"id": 23, "duration_s": 2.25, "emotion": "excited", "text": "સાંભળ્યું કે? લાલો બોમ્બ લાવ્યો છે!"}, {"id": 24, "duration_s": 3.63, "emotion": "sarcastic", "text": "દસ સેકન્ડમાં... આખી સોસાયટીને ખબર પડી."}, {"id": 25, "duration_s": 3.01, "emotion": "excited", "text": "જુઓ! સુપર બોમ્બ! ચાંદથી વધુ અવાજ!"}, {"id": 26, "duration_s": 4.73, "emotion": "proud", "text": "મંજુલા માસીના ફટાકડા ફૂસ! આખી સોસાયટી જોશે!"}, {"id": 27, "duration_s": 1.02, "emotion": "angry", "text": "લાલા!"}, {"id": 28, "duration_s": 2.59, "emotion": "embarrassed", "text": "ઓ માડી! આ નિશાન કદી નથી ચૂકતું..."}, {"id": 29, "duration_s": 3.9, "emotion": "stern_warning", "text": "દીવા પાસે દારૂગોળો? અક્કલ ઘાસ ચરવા ગઈ છે?"}, {"id": 30, "duration_s": 1.86, "emotion": "calm", "text": "બસ! હવે હું જોઉં છું."}, {"id": 31, "duration_s": 3.11, "emotion": "stern_warning", "text": "ફટાકડા આગથી દૂર, ઠંડી જગ્યાએ."}, {"id": 32, "duration_s": 4.1, "emotion": "proud", "text": "આજે પહેલી ફૂલઝર હું સળગાવીશ! હું કોઈથી નથી ડરતો!"}, {"id": 33, "duration_s": 4.517, "emotion": "sarcastic", "text": "ગયા વરસે અનાર જોઈને કબાટમાં કોણ સંતાયું'તું?"}, {"id": 34, "duration_s": 2.99, "emotion": "embarrassed", "text": "એ તો... કબાટ સાફ કરતો'તો. અંદરથી."}, {"id": 35, "duration_s": 2.94, "emotion": "proud", "text": "ચંપલ પાછું. નિશાન તૈયાર."}, {"id": 36, "duration_s": 5.58, "emotion": "shouting", "text": "સાયલન્ટ ફટાકડા! ના ધુમાડો, ના અવાજ, ના બીક!"}, {"id": 37, "duration_s": 3.72, "emotion": "proud", "text": "સો રૂપિયાનો ડબ્બો! એક રૂપિયો પણ ઓછો નહીં!"}, {"id": 38, "duration_s": 2.92, "emotion": "curious", "text": "શેઠ, સાયલન્ટ ફટાકડો સળગે કેમ?"}, {"id": 39, "duration_s": 3.88, "emotion": "mischievous", "text": "એટલો ચુપચાપ... કે ખબર જ ના પડે!"}, {"id": 40, "duration_s": 3.76, "emotion": "proud", "text": "સાયન્સ કહે છે... અવાજ સીધો મગજમાં આવે!"}, {"id": 41, "duration_s": 1.21, "emotion": "excited", "text": "હા... સંભળાય છે!"}, {"id": 42, "duration_s": 4.43, "emotion": "sad", "text": "આમાં તો ખાવાનું પણ કંઈ નથી!"}, {"id": 43, "duration_s": 1.208, "emotion": "happy", "text": "ભૂખ લાગી છે!"}, {"id": 44, "duration_s": 2.75, "emotion": "shocked", "text": "સાંભળ્યું કે? શેઠ ખાલી ડબ્બા વેચે છે!"}, {"id": 45, "duration_s": 0.91, "emotion": "stern_warning", "text": "ચીમન શેઠ!"}, {"id": 46, "duration_s": 4.48, "emotion": "embarrassed", "text": "હંસા... આ પ્રદૂષણમુક્ત પેકિંગ છે!"}, {"id": 47, "duration_s": 3.22, "emotion": "sad", "text": "<sigh> મૂંગા ફટાકડા... મૂંગા ગ્રાહક."}, {"id": 48, "duration_s": 2.44, "emotion": "serious", "text": "ફટાકડાને પણ નજર લાગે, બેટા!"}, {"id": 49, "duration_s": 1.85, "emotion": "worried", "text": "બા, લીંબુ ફાટે તો?"}, {"id": 50, "duration_s": 1.85, "emotion": "serious", "text": "તો ખાટો ધડાકો થશે."}, {"id": 51, "duration_s": 2.63, "emotion": "sarcastic", "text": "હવાલદાર ઊંઘલાલ રખેવાળી કરતા હતા..."}, {"id": 52, "duration_s": 1.98, "emotion": "happy", "text": "હોર્નને પણ નજર લાગી ગઈ!"}, {"id": 53, "duration_s": 4.568, "emotion": "pleading", "text": "બસ એક... ખાલી તપાસ માટે."}, {"id": 54, "duration_s": 5.38, "emotion": "stern_warning", "text": "તપાસ થશે!"}, {"id": 55, "duration_s": 5.77, "emotion": "sad", "text": "<sigh> તપાસ મીઠાઈ ખાઈ ગઈ."}, {"id": 56, "duration_s": 6.14, "emotion": "proud", "text": "હું કોઈથી નથી ડરતો! બસ આગ, તણખા ને અવાજથી."}, {"id": 57, "duration_s": 3.19, "emotion": "loving", "text": "તો એક લીંબુ તારા માટે પણ."}, {"id": 58, "duration_s": 3.28, "emotion": "excited", "text": "સાંજે... બાળકોએ કમાન સંભાળી."}, {"id": 59, "duration_s": 2.56, "emotion": "determined", "text": "આ સેફ્ટી લાઈન! આની આગળ કોઈ નહીં!"}, {"id": 60, "duration_s": 3.92, "emotion": "serious", "text": "હું કહું? પાણીની ડોલ, રેતીની ડોલ, ને અંતર!"}, {"id": 61, "duration_s": 2.04, "emotion": "excited", "text": "પાણીપૂરી? ક્યાં છે પાણીપૂરી?"}, {"id": 62, "duration_s": 1.84, "emotion": "excited", "text": "પાણીપૂરી?! ક્યાં?!"}, {"id": 63, "duration_s": 3.41, "emotion": "sarcastic", "text": "પાણીની ડોલ, ગુરુજી! ને રેતી!"}, {"id": 64, "duration_s": 2.54, "emotion": "curious", "text": "રેટ? પાણીપૂરીનો રેટ કેટલો?"}, {"id": 65, "duration_s": 2.16, "emotion": "embarrassed", "text": "દર અગત્યના ટાણે આની રજા!"}, {"id": 66, "duration_s": 3.83, "emotion": "shouting", "text": "બધા મોટા અહીં! નિયમ સાંભળો!"}, {"id": 67, "duration_s": 3.2, "emotion": "stern_warning", "text": "હાથમાં ખાલી ફૂલઝર! બીજું ફટાકડું કદી નહીં!"}, {"id": 68, "duration_s": 3.98, "emotion": "stern_warning", "text": "રેશમી કપડાં દીવાથી દૂર! સુતરાઉ પહેરો!"}, {"id": 69, "duration_s": 2.11, "emotion": "comic_panic", "text": "પાંચ મિનિટ! હમણાં આવ્યો!"}, {"id": 70, "duration_s": 1.12, "emotion": "shouting", "text": "ચૂપ! પાછો!"}, {"id": 71, "duration_s": 2.73, "emotion": "embarrassed", "text": "હું તો... લાઈન ચેક કરતો'તો."}, {"id": 72, "duration_s": 3.99, "emotion": "sarcastic", "text": "રાત પડી... હીરો સુતરાઉ ઝભ્ભે આવ્યો."}, {"id": 73, "duration_s": 2.05, "emotion": "proud", "text": "હું કોઈથી નથી ડરતો! સળગાવો!"}, {"id": 74, "duration_s": 3.26, "emotion": "stern_warning", "text": "હાથ સીધો! મોઢાથી દૂર! ડોલ પાસે!"}, {"id": 75, "duration_s": 0.98, "emotion": "comic_panic", "text": "તણ... તણખા!"}, {"id": 76, "duration_s": 1.17, "emotion": "comic_panic", "text": "આઆઆઆઆ!"}, {"id": 77, "duration_s": 0.81, "emotion": "comic_panic", "text": "કેમ ઓલવાય નહીં?!"}, {"id": 78, "duration_s": 2.8, "emotion": "excited", "text": "સાંભળ્યું કે? જયેશ મેરેથોન દોડે છે!"}, {"id": 79, "duration_s": 2.2, "emotion": "sarcastic", "text": "ફૂલઝર તો બે મિનિટ પહેલાં ઓલવાઈ ગઈ'તી."}, {"id": 80, "duration_s": 2.12, "emotion": "tired", "text": "...તો કહ્યું કેમ નહીં?"}, {"id": 81, "duration_s": 4.2, "emotion": "giggly", "text": "પપ્પા, ફૂલઝર ઊભા રહીને સળગાવાય, દોડીને નહીં!"}, {"id": 82, "duration_s": 4.62, "emotion": "serious", "text": "ને બળેલો તાર સીધો પાણીમાં. પગમાં નહીં."}, {"id": 83, "duration_s": 4.2, "emotion": "giggly", "text": "પહેલી ફૂલઝર... ને પહેલી મેરેથોન!"}, {"id": 84, "duration_s": 2.3, "emotion": "mischievous", "text": "નવી પ્રૅન્ક! ચોકલેટ બોમ્બ!"}, {"id": 85, "duration_s": 3.4, "emotion": "curious", "text": "બોમ્બમાંથી... ચોકલેટની સુગંધ?"}, {"id": 86, "duration_s": 2.54, "emotion": "shouting", "text": "બૂ... બૂ... બૂમ!"}, {"id": 87, "duration_s": 1.84, "emotion": "panicked", "text": "ધોકળું ફાટી ગયું!"}, {"id": 88, "duration_s": 1.25, "emotion": "shouting", "text": "ધોકળું!!"}, {"id": 89, "duration_s": 3.4, "emotion": "giggly", "text": "અંદર ચોકલેટ હતી! ભૂખ લાગી'તી!"}, {"id": 90, "duration_s": 2.87, "emotion": "excited", "text": "સાંભળ્યું કે? ધોકળું... પાછું ભૂખ્યું છે!"}, {"id": 91, "duration_s": 2.55, "emotion": "stern_warning", "text": "ફટાકડાની મજાક ના હોય, દીદી! બધા ડરી ગયા."}, {"id": 92, "duration_s": 2.26, "emotion": "embarrassed", "text": "સોરી... રીલ ડિલીટ."}, {"id": 93, "duration_s": 4.23, "emotion": "mischievous", "text": "ને હવે... પાછા ત્યાં જ, જ્યાં વાર્તા અટકી'તી."}, {"id": 94, "duration_s": 4.75, "emotion": "stern_warning", "text": "લાંબી અગરબત્તી! હાથ સીધો! સળગાવો ને પાછળ!"}, {"id": 95, "duration_s": 3.99, "emotion": "comic_panic", "text": "સળગ્યો! ભાગો... એટલે કે, પાછળ હટો!"}, {"id": 96, "duration_s": 1.95, "emotion": "proud", "text": "ઊભા રહો... એ વિચારે છે."}, {"id": 97, "duration_s": 3.14, "emotion": "serious", "text": "સાયન્સ કહે છે... એ સૂઈ ગયો છે."}, {"id": 98, "duration_s": 3.09, "emotion": "shouting", "text": "ઊભા રહો! ફૂસ ફટાકડા પાસે કોઈ નહીં જાય!"}, {"id": 99, "duration_s": 3.89, "emotion": "serious", "text": "હું કહું? પંદર મિનિટ રોકાઓ, પછી પાણી નાખો."}, {"id": 100, "duration_s": 3.813, "emotion": "sarcastic", "text": "પંદર મિનિટ? મારું વ્યાજ ચાલે છે, ભાઈ!"}, {"id": 101, "duration_s": 2.14, "emotion": "embarrassed", "text": "...ચાંદથી પણ વધારે."}, {"id": 102, "duration_s": 2.19, "emotion": "sarcastic", "text": "લાઈવ ચાલે છે... કમનસીબે."}, {"id": 103, "duration_s": 0.8, "emotion": "angry", "text": "લાલા..."}, {"id": 104, "duration_s": 2.07, "emotion": "shouting", "text": "તપાસ થશે!"}, {"id": 105, "duration_s": 5.465, "emotion": "embarrassed", "text": "હોર્નના લીધે! સાચ્ચે!"}, {"id": 106, "duration_s": 2.06, "emotion": "curious", "text": "શું થયું? મીઠાઈ વહેંચાય છે?"}, {"id": 107, "duration_s": 3.21, "emotion": "tender", "text": "અરે મોતી... તું પણ ડરી ગયો?"}, {"id": 108, "duration_s": 3.02, "emotion": "worried", "text": "પ્રાણીઓના કાન આપણાથી બહુ તેજ હોય."}, {"id": 109, "duration_s": 3.94, "emotion": "serious", "text": "આપણને ફટાકડો લાગે, એમને વાવાઝોડું લાગે."}, {"id": 110, "duration_s": 3.24, "emotion": "tender", "text": "શ્શ્શ... મોતી માટે શાંત ખૂણો!"}, {"id": 111, "duration_s": 3.14, "emotion": "calm", "text": "ધમાકાથી દૂર... એક નાનો શાંત ખૂણો."}, {"id": 112, "duration_s": 3.17, "emotion": "happy", "text": "મારા કાન ઘરડા છે. હું અહીં!"}, {"id": 113, "duration_s": 2.03, "emotion": "tender", "text": "આવ મોતી, અહીં ધડાકો નહીં!"}, {"id": 114, "duration_s": 1.92, "emotion": "serious", "text": "બિચારાને નજર લાગી'તી!"}, {"id": 115, "duration_s": 2.95, "emotion": "proud", "text": "શાબાશ, મારી સેફ્ટી સ્ક્વોડ."}, {"id": 116, "duration_s": 4.03, "emotion": "mischievous", "text": "ને પછી... સુપર બોમ્બનું પોસ્ટમોર્ટમ."}, {"id": 117, "duration_s": 3.83, "emotion": "serious", "text": "તપાસ થશે! ...પડ પર પડ."}, {"id": 118, "duration_s": 3.85, "emotion": "sad", "text": "આટલો મોટો ડબ્બો... અંદર બસ આટલું?"}, {"id": 119, "duration_s": 2.47, "emotion": "serious", "text": "નામ વગરનો ફટાકડો ખતરનાક પણ હોય."}, {"id": 120, "duration_s": 3.18, "emotion": "loving", "text": "કાકા, લાઇસન્સવાળી દુકાનેથી લેજો. વેનથી નહીં."}, {"id": 121, "duration_s": 2.78, "emotion": "guilty", "text": "સાચી વાત. આવતી વખતે પહેલાં પૂછીશ."}, {"id": 122, "duration_s": 1.41, "emotion": "giggly", "text": "ટેન્શન લો... થોડુંક."}, {"id": 123, "duration_s": 2.58, "emotion": "stern_warning", "text": "ચીમન શેઠ! ખાલી ડબ્બા?"}, {"id": 124, "duration_s": 3.73, "emotion": "guilty", "text": "ઠીક છે! બધાને... મફત મીઠાઈ!"}, {"id": 125, "duration_s": 2.78, "emotion": "crying", "text": "મફત... બોલતાં પણ જીવ બળે!"}, {"id": 126, "duration_s": 2.245, "emotion": "serious", "text": "તપાસ પૂરી થઈ."}, {"id": 127, "duration_s": 1.2, "emotion": "happy", "text": "બરાબર વહેંચ્યું!"}, {"id": 128, "duration_s": 4.25, "emotion": "calm", "text": "એ રાતે સોસાયટીમાં ધુમાડો ઓછો હતો... ને રોશની વધારે."}, {"id": 129, "duration_s": 3.05, "emotion": "loving", "text": "આ દીવા ચુપચાપ બળે... ને આખી રાત."}, {"id": 130, "duration_s": 2.05, "emotion": "giggly", "text": "ને આમના માટે સીટી પણ નથી જોઈતી!"}, {"id": 131, "duration_s": 3.02, "emotion": "excited", "text": "નવી રીલ... 'સાયલન્ટ દિવાળી'! લાઈવ ચાલે છે!"}, {"id": 132, "duration_s": 2.02, "emotion": "excited", "text": "સાંભળ્યું કે? ખુશીની રીલ વાયરલ!"}, {"id": 133, "duration_s": 3.78, "emotion": "proud", "text": "જોયું? આખી સોસાયટીએ જોયું! આખા દેશે પણ!"}, {"id": 134, "duration_s": 2.82, "emotion": "giggly", "text": "ને રીલમાં તમારું ચંપલ પણ છે!"}, {"id": 135, "duration_s": 3.61, "emotion": "proud", "text": "સાયન્સ કહે છે... દીવો સૌથી સેફ ફટાકડો છે."}, {"id": 136, "duration_s": 4.356, "emotion": "shocked", "text": "હોશિયાર હર્ષ સાચું બોલ્યો?! મેં સાંભળ્યું?"}, {"id": 137, "duration_s": 5.59, "emotion": "serious", "text": "ફટાકડો હાથમાં નહીં, ડોલ પાસે, બાળકો મોટા સાથે."}, {"id": 138, "duration_s": 4.2, "emotion": "loving", "text": "ને પ્રાણીઓ-વડીલો માટે એક શાંત ખૂણો."}, {"id": 139, "duration_s": 3.62, "emotion": "calm", "text": "અજવાળું દિલમાં હોય... ધડાકો હાથમાં નહીં."}, {"id": 140, "duration_s": 1.39, "emotion": "excited", "text": "હેપી સેફ દિવાળી!"}]