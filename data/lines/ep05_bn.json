[{"id": 1, "duration_s": 3.12, "emotion": "excited", "text": "পাড়ার সেরা লড়াই... দড়ি টানাটানি!"}, {"id": 2, "duration_s": 3.3, "emotion": "proud", "text": "সাত দিনের পাউডার! কাউকে ডরাই না!"}, {"id": 3, "duration_s": 2.11, "emotion": "calm", "text": "হারেনদা, চা-টা গরম রেখো।"}, {"id": 4, "duration_s": 2.1, "emotion": "excited", "text": "লাইভ চলছে! স্লো মোশন!"}, {"id": 5, "duration_s": 3.63, "emotion": "mischievous", "text": "এই সবের শুরু... একটা কৌটো থেকে।"}, {"id": 6, "duration_s": 2.75, "emotion": "happy", "text": "সাত দিন আগে। পাড়ার স্পোর্টস উইক।"}, {"id": 7, "duration_s": 5.12, "emotion": "excited", "text": "এই রবিবার দড়িটানা! ঘোষ বনাম হিসেবি পরিবার!"}, {"id": 8, "duration_s": 3.28, "emotion": "proud", "text": "ঘোষরাই জিতবে! কাউকে ডরাই না!"}, {"id": 9, "duration_s": 4.97, "emotion": "sarcastic", "text": "হিসেব কষলাম। ঘোষদের জেতার চান্স... গোল্লা!"}, {"id": 10, "duration_s": 2.04, "emotion": "sarcastic", "text": "কাউকে ডরান না, হারুবাবু?"}, {"id": 11, "duration_s": 3.49, "emotion": "comic_panic", "text": "কাউকে না! টিকটিকি তো... কেউ না!"}, {"id": 12, "duration_s": 2.18, "emotion": "stern_warning", "text": "চুপ! কাকু আবার লাফ দেবে!"}, {"id": 13, "duration_s": 1.84, "emotion": "happy", "text": "চলো, চলি তাহলে!"}, {"id": 14, "duration_s": 2.78, "emotion": "calm", "text": "সরো দাদা, দেখছি।"}, {"id": 15, "duration_s": 2.01, "emotion": "shocked", "text": "বউদি, ট্র্যাক্টরও টানতে পারবেন!"}, {"id": 16, "duration_s": 0.86, "emotion": "excited", "text": "টেনশন নিও না, দাদা!"}, {"id": 17, "duration_s": 2.89, "emotion": "worried", "text": "টেনশন? অটো টেনে নিয়ে গেল, ভম্বল!"}, {"id": 18, "duration_s": 3.8, "emotion": "proud", "text": "আমার ছেলেই জিতবে! পাড়াসুদ্ধ দেখবে!"}, {"id": 19, "duration_s": 3.25, "emotion": "mischievous", "text": "শুনেছ গো? হারুবাবু টিকটিকির কাছে হারল!"}, {"id": 20, "duration_s": 2.47, "emotion": "sad", "text": "চিপস কই গেল? খিদে পেয়েছে!"}, {"id": 21, "duration_s": 3.25, "emotion": "excited", "text": "সুলতান পাউডার! সাত দিনেই বডি, কইলাম!"}, {"id": 22, "duration_s": 3.28, "emotion": "excited", "text": "মাত্র নশো নিরানব্বই! এক্সপ্রেস ডেলিভারি!"}, {"id": 23, "duration_s": 1.83, "emotion": "excited", "text": "একটা আইডিয়া আছে! বাবার জন্য!"}, {"id": 24, "duration_s": 3.73, "emotion": "excited", "text": "বাবা! সাত দিনে বডি! রবিবারও সাত দিন পরেই!"}, {"id": 25, "duration_s": 2.47, "emotion": "excited", "text": "সুলতান... বডি... সাত দিন!"}, {"id": 26, "duration_s": 2.14, "emotion": "sarcastic", "text": "সাত দিনে তো কাঁচা আমও পাকে না!"}, {"id": 27, "duration_s": 2.43, "emotion": "proud", "text": "এ তো বিজ্ঞান, মিতালি! অর্ডার!"}, {"id": 28, "duration_s": 4.22, "emotion": "proud", "text": "আমার ছেলে সুলতান হবে! পাড়াসুদ্ধ দেখবে!"}, {"id": 29, "duration_s": 3.71, "emotion": "curious", "text": "পাউডারটা মিষ্টি হবে? আমারও চাই।"}, {"id": 30, "duration_s": 3.58, "emotion": "excited", "text": "সুলতান পাউডার, বাহে! এক্সপ্রেস!"}, {"id": 31, "duration_s": 2.61, "emotion": "loving", "text": "এল আমার সুলতান!"}, {"id": 32, "duration_s": 4.95, "emotion": "mischievous", "text": "শুনেছ গো? হারুবাবু কৌটোয় বডি আনিয়েছে!"}, {"id": 33, "duration_s": 2.45, "emotion": "determined", "text": "আহ! গায়ে জোর আসছে!"}, {"id": 34, "duration_s": 2.08, "emotion": "curious", "text": "বাবা... মাসল কই লুকোলো?"}, {"id": 35, "duration_s": 2.18, "emotion": "excited", "text": "ওই যে! একটা লোম দাঁড়াল!"}, {"id": 36, "duration_s": 3.29, "emotion": "shocked", "text": "শুনেছ গো? হারুবাবুর বোতাম-বৃষ্টি হচ্ছে!"}, {"id": 37, "duration_s": 2.5, "emotion": "embarrassed", "text": "বডি বাড়ছে, খোকার মা!"}, {"id": 38, "duration_s": 1.05, "emotion": "shocked", "text": "আধ ইঞ্চি..."}, {"id": 39, "duration_s": 0.71, "emotion": "shocked", "text": "...কমেছে!"}, {"id": 40, "duration_s": 1.54, "emotion": "proud", "text": "ভেতর থেকে বাড়ছে!"}, {"id": 41, "duration_s": 1.82, "emotion": "happy", "text": "শুঁকলেও গায়ে জোর আসে!"}, {"id": 42, "duration_s": 1.74, "emotion": "worried", "text": "হারু, নাকে দিও না!"}, {"id": 43, "duration_s": 2.06, "emotion": "comic_panic", "text": "আ... আ... আ..."}, {"id": 44, "duration_s": 2.79, "emotion": "proud", "text": "দেখলে? পাউডার বাইরে থেকেও কাজ করে!"}, {"id": 45, "duration_s": 1.67, "emotion": "determined", "text": "অনেক হল! আমি দেখছি।"}, {"id": 46, "duration_s": 3.85, "emotion": "shocked", "text": "ওমা! আমার সুলতান বরফের পুতুল হল!"}, {"id": 47, "duration_s": 2.36, "emotion": "serious", "text": "থামো! বিজ্ঞান বলছে..."}, {"id": 48, "duration_s": 1.46, "emotion": "proud", "text": "এটা একশো ভাগ চক!"}, {"id": 49, "duration_s": 6.12, "emotion": "laughing", "text": "<laugh> জ্ঞানী গোপুর বিজ্ঞান? তাহলে পাক্কা ভুল!"}, {"id": 50, "duration_s": 3.33, "emotion": "giggly", "text": "গোপু বলেছিল, মেঘ হয় সিলিন্ডারে!"}, {"id": 51, "duration_s": 3.61, "emotion": "giggly", "text": "আর মুরগি দুধ দেয়!"}, {"id": 52, "duration_s": 2.72, "emotion": "laughing", "text": "আর চাঁদে নাকি চায়ের দোকান!"}, {"id": 53, "duration_s": 1.66, "emotion": "pleading", "text": "কিন্তু এবার সত্যি!"}, {"id": 54, "duration_s": 1.71, "emotion": "serious", "text": "নজর না লাগুক সুলতানের!"}, {"id": 55, "duration_s": 2.41, "emotion": "proud", "text": "সুলতান রবিবার দেখা দেবে!"}, {"id": 56, "duration_s": 3.52, "emotion": "sad", "text": "দেখো... লেখেও তো। কেউ দেখে না।"}, {"id": 57, "duration_s": 2.83, "emotion": "excited", "text": "টেনশন নেই! এ তো সোনার খনি!"}, {"id": 58, "duration_s": 2.43, "emotion": "mischievous", "text": "একশোয় কেনো, দুশোয় বেচো!"}, {"id": 59, "duration_s": 3.7, "emotion": "mischievous", "text": "হারেনদা, ডিলারশিপ! পঞ্চাশ কৌটো!"}, {"id": 60, "duration_s": 4.66, "emotion": "curious", "text": "পঞ্চাশ সুলতান? হিসেব কষি।"}, {"id": 61, "duration_s": 4.26, "emotion": "serious", "text": "পাঁচ হাজার। দুবার গুনলাম... তিনবারও।"}, {"id": 62, "duration_s": 1.72, "emotion": "pleading", "text": "এক টাকাও কম নয়!"}, {"id": 63, "duration_s": 0.85, "emotion": "stern_warning", "text": "হারেনদা!"}, {"id": 64, "duration_s": 4.53, "emotion": "embarrassed", "text": "ভবানী, এটা ব্যবসা! ডবল মুনাফা!"}, {"id": 65, "duration_s": 2.34, "emotion": "sarcastic", "text": "নাকি ডবল লস?"}, {"id": 66, "duration_s": 3.04, "emotion": "proud", "text": "পঞ্চাশ কৌটো! পুরো পাড়া সুলতান হবে!"}, {"id": 67, "duration_s": 3.44, "emotion": "happy", "text": "আমি তো কলা খাইনি!"}, {"id": 68, "duration_s": 2.55, "emotion": "surprised", "text": "এ তো মিষ্টি না... চক!"}, {"id": 69, "duration_s": 1.58, "emotion": "shouting", "text": "চুপ! ব্যবসা!"}, {"id": 70, "duration_s": 3.19, "emotion": "mischievous", "text": "ট্রেনিং উইক। কোচ... ভম্বল।"}, {"id": 71, "duration_s": 3.35, "emotion": "proud", "text": "কোচ ভম্বল! তোমরা দৌড়োও, আমি গুনি।"}, {"id": 72, "duration_s": 2.1, "emotion": "proud", "text": "দৌড়োব কেন? পাউডার তো আছে!"}, {"id": 73, "duration_s": 2.06, "emotion": "determined", "text": "আজ গাছ উপড়ে ছাড়ব!"}, {"id": 74, "duration_s": 2.48, "emotion": "worried", "text": "তিন পা! জুতো ক্ষয়ে গেলে?"}, {"id": 75, "duration_s": 1.73, "emotion": "proud", "text": "এটাই আমার ট্রেনিং!"}, {"id": 76, "duration_s": 1.42, "emotion": "calm", "text": "আমার ট্রেনিং লাগে না।"}, {"id": 77, "duration_s": 2.62, "emotion": "tired", "text": "বাবা, কোন পাউডার খান?"}, {"id": 78, "duration_s": 1.3, "emotion": "calm", "text": "রুটি।"}, {"id": 79, "duration_s": 0.87, "emotion": "stern_warning", "text": "রুটি খাও!"}, {"id": 80, "duration_s": 1.52, "emotion": "proud", "text": "সুলতান রুটি খায় না!"}, {"id": 81, "duration_s": 2.67, "emotion": "curious", "text": "ছ দিন হলো। মাসল?"}, {"id": 82, "duration_s": 2.43, "emotion": "sarcastic", "text": "চুপ! ভেতর থেকে বাড়ছে।"}, {"id": 83, "duration_s": 1.26, "emotion": "determined", "text": "আমার বাবা সুলতান!"}, {"id": 84, "duration_s": 3.99, "emotion": "excited", "text": "রবিবার। পাড়ার মহালড়াই!"}, {"id": 85, "duration_s": 3.69, "emotion": "serious", "text": "তদন্ত হবে! সিঙাড়ার।"}, {"id": 86, "duration_s": 4.39, "emotion": "excited", "text": "লাইভ চলছে! মহালড়াই!"}, {"id": 87, "duration_s": 0.62, "emotion": "proud", "text": "আজ সুলতানের দিন!"}, {"id": 88, "duration_s": 3.93, "emotion": "mischievous", "text": "জিতলে পাউডার বিকোবে, হারলেও!"}, {"id": 89, "duration_s": 2.04, "emotion": "calm", "text": "হারেনদা, পেছন থেকে ধরো।"}, {"id": 90, "duration_s": 3.08, "emotion": "sarcastic", "text": "ধরলাম। খাটুনির বিল আলাদা।"}, {"id": 91, "duration_s": 3.3, "emotion": "excited", "text": "পাড়াসুদ্ধ দেখবে! ঘোষ জিন্দাবাদ!"}, {"id": 92, "duration_s": 3.4, "emotion": "serious", "text": "নজর না লাগুক! এবার দড়ি পবিত্র।"}, {"id": 93, "duration_s": 3.06, "emotion": "shouting", "text": "তৈরি... টানো!"}, {"id": 94, "duration_s": 4.0, "emotion": "determined", "text": "পুরো... জোর... লাগাও!"}, {"id": 95, "duration_s": 2.04, "emotion": "curious", "text": "হারেনদা, শুরু কখন?"}, {"id": 96, "duration_s": 2.51, "emotion": "comic_panic", "text": "টেনশন নিও না... আহ... টেনশন নাও!"}, {"id": 97, "duration_s": 3.603, "emotion": "tired", "text": "হারেনদা, চা ঠান্ডা হচ্ছে।"}, {"id": 98, "duration_s": 1.22, "emotion": "laughing", "text": "স্লো মোশনে আবার!"}, {"id": 99, "duration_s": 2.92, "emotion": "embarrassed", "text": "আমি... কাউকে ডরাই না।"}, {"id": 100, "duration_s": 2.43, "emotion": "curious", "text": "বাবা, পাউডার ভেতর থেকে বাড়ছিল?"}, {"id": 101, "duration_s": 2.2, "emotion": "shocked", "text": "হায় হায়! নজর লেগে গেল!"}, {"id": 102, "duration_s": 2.56, "emotion": "embarrassed", "text": "এ মা! পাড়াসুদ্ধ দেখে ফেলল!"}, {"id": 103, "duration_s": 4.41, "emotion": "excited", "text": "জিতেছি! এবার পাউডারের দাম ডবল!"}, {"id": 104, "duration_s": 1.69, "emotion": "happy", "text": "জেতার মিষ্টিমুখ!"}, {"id": 105, "duration_s": 6.84, "emotion": "tired", "text": "হিসেবি পরিবার জিতল! তদন্ত... শেষ..."}, {"id": 106, "duration_s": 2.85, "emotion": "excited", "text": "দশ লক্ষ ভিউ! সুলতান ভাইরাল!"}, {"id": 107, "duration_s": 2.12, "emotion": "excited", "text": "শুনেছ গো? আমেরিকাও দেখছে!"}, {"id": 108, "duration_s": 2.034, "emotion": "sad", "text": "এবার আমাকে কেউ দেখবে না।"}, {"id": 109, "duration_s": 1.86, "emotion": "curious", "text": "বাবা? ভেতরে আছ?"}, {"id": 110, "duration_s": 0.74, "emotion": "sad", "text": "না।"}, {"id": 111, "duration_s": 1.68, "emotion": "sarcastic", "text": "রুটি বালতিতে দেব?"}, {"id": 112, "duration_s": 1.66, "emotion": "determined", "text": "রুটি না... পাউডার!"}, {"id": 113, "duration_s": 0.67, "emotion": "proud", "text": "আমি বলি?"}, {"id": 114, "duration_s": 4.38, "emotion": "serious", "text": "কোম্পানির ঠিকানা? নেই। লাইসেন্স? নেই।"}, {"id": 115, "duration_s": 2.44, "emotion": "sarcastic", "text": "আর সব রিভিউ... একই লোকের!"}, {"id": 116, "duration_s": 2.28, "emotion": "angry", "text": "মানে... পুরোটাই ধাপ্পা!"}, {"id": 117, "duration_s": 4.27, "emotion": "guilty", "text": "আইডিয়া আমার... বাবাকে বলতেই হবে।"}, {"id": 118, "duration_s": 5.28, "emotion": "sad", "text": "পঞ্চাশ কৌটো। খদ্দের... গোল্লা।"}, {"id": 119, "duration_s": 1.41, "emotion": "happy", "text": "টেনশন নেই, হারেনদা!"}, {"id": 120, "duration_s": 1.78, "emotion": "angry", "text": "টেনশন তুমিই দিলে!"}, {"id": 121, "duration_s": 4.03, "emotion": "proud", "text": "বাচ্চারা প্রমাণ করল! বিজ্ঞান বলে... চক!"}, {"id": 122, "duration_s": 2.53, "emotion": "tired", "text": "হ্যাঁ গোপু, তুমি ঠিক।"}, {"id": 123, "duration_s": 3.07, "emotion": "shocked", "text": "আমি... ঠিক? প্রথমবার?"}, {"id": 124, "duration_s": 4.13, "emotion": "happy", "text": "বাহ, দারুণ চক! ব্ল্যাকবোর্ডের জন্য সব নেব।"}, {"id": 125, "duration_s": 1.01, "emotion": "pleading", "text": "কত দেবেন?"}, {"id": 126, "duration_s": 2.76, "emotion": "loving", "text": "আশীর্বাদ।"}, {"id": 127, "duration_s": 1.74, "emotion": "determined", "text": "ভুয়ো বিজ্ঞাপন... রিপোর্ট! আর ব্লক!"}, {"id": 128, "duration_s": 2.38, "emotion": "embarrassed", "text": "নশো নিরানব্বই... চকে।"}, {"id": 129, "duration_s": 3.84, "emotion": "calm", "text": "হারু, যে কৌটো সাত দিনে বডি দেয়..."}, {"id": 130, "duration_s": 3.95, "emotion": "sarcastic", "text": "...সে সাত দিনেই পকেট ফাঁকা করে।"}, {"id": 131, "duration_s": 5.39, "emotion": "serious", "text": "বডি কৌটোয় হয় না, হয় রুটি আর দৌড়ে।"}, {"id": 132, "duration_s": 2.91, "emotion": "determined", "text": "আর ঠিকানা, লাইসেন্স, আসল রিভিউ দেখো!"}, {"id": 133, "duration_s": 4.61, "emotion": "happy", "text": "সুলতান... রুটি খায়!"}, {"id": 134, "duration_s": 1.01, "emotion": "tired", "text": "বাবা... একটু আস্তে!"}, {"id": 135, "duration_s": 1.98, "emotion": "happy", "text": "চলো, চলি... হেঁটে!"}, {"id": 136, "duration_s": 2.08, "emotion": "happy", "text": "হারেনদা, জলদি!"}, {"id": 137, "duration_s": 2.99, "emotion": "happy", "text": "দৌড়নো ফ্রি! সবচেয়ে ভালো অফার!"}, {"id": 138, "duration_s": 3.31, "emotion": "excited", "text": "টেনশন নেই! সুলতান হেয়ার অয়েল! সাত দিনে চুল!"}, {"id": 139, "duration_s": 2.46, "emotion": "embarrassed", "text": "টেনশন... নিলাম।"}, {"id": 140, "duration_s": 1.77, "emotion": "excited", "text": "বাবা! আসল মাসল!"}]