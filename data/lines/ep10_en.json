[{"id": 1, "duration_s": 16.37, "emotion": "mischievous", "text": "Two in the morning... the whole colony was fast asleep."}, {"id": 2, "duration_s": 1.3, "emotion": "mischievous", "text": "Except one."}, {"id": 3, "duration_s": 1.2, "emotion": "angry", "text": "Airport in my ear?"}, {"id": 4, "duration_s": 1.38, "emotion": "proud", "text": "I fear nobody!"}, {"id": 5, "duration_s": 4.66, "emotion": "giggly", "text": "Ten claps... twenty claps... thirty claps..."}, {"id": 6, "duration_s": 1.99, "emotion": "sarcastic", "text": "Why clap? Is a wedding band coming?"}, {"id": 7, "duration_s": 2.03, "emotion": "scared_whisper", "text": "Fortieth... and final."}, {"id": 8, "duration_s": 4.04, "emotion": "giggly", "text": "Forty claps. Mosquito: zero. Ramesh: forty."}, {"id": 9, "duration_s": 2.78, "emotion": "determined", "text": "Move! My chappal never misses!"}, {"id": 10, "duration_s": 2.23, "emotion": "embarrassed", "text": "It didn't miss... it hit me!"}, {"id": 11, "duration_s": 2.44, "emotion": "proud", "text": "See? Perfect aim."}, {"id": 12, "duration_s": 3.78, "emotion": "mischievous", "text": "And this was... only the beginning."}, {"id": 13, "duration_s": 4.43, "emotion": "giggly", "text": "By morning... the whole colony was scratching."}, {"id": 14, "duration_s": 3.49, "emotion": "excited", "text": "Did you hear? A mosquito army attacked last night!"}, {"id": 15, "duration_s": 2.99, "emotion": "mischievous", "text": "And Sharma ji slapped himself forty times!"}, {"id": 16, "duration_s": 2.66, "emotion": "embarrassed", "text": "That was no mosquito... it was an elephant!"}, {"id": 17, "duration_s": 3.47, "emotion": "sarcastic", "text": "Not an elephant. Mummy's chappal."}, {"id": 18, "duration_s": 3.44, "emotion": "serious", "text": "Evil eye! Mosquito evil eye!"}, {"id": 19, "duration_s": 6.307, "emotion": "shocked", "text": "Baap re! He ate the chilli too!"}, {"id": 20, "duration_s": 2.83, "emotion": "stern_warning", "text": "Samosa? Stop! Inquiry will be!"}, {"id": 21, "duration_s": 2.93, "emotion": "happy", "text": "Inquiry over. I was hungry!"}, {"id": 22, "duration_s": 4.04, "emotion": "proud", "text": "Science says, mosquitoes breed only in dirty drains!"}, {"id": 23, "duration_s": 1.15, "emotion": "curious", "text": "Can I tell?"}, {"id": 24, "duration_s": 2.26, "emotion": "proud", "text": "Quiet, child! Science is speaking."}, {"id": 25, "duration_s": 3.19, "emotion": "proud", "text": "Our colony is clean, mosquitoes come from outside!"}, {"id": 26, "duration_s": 4.15, "emotion": "excited", "text": "Mosquito-proof agarbatti! Light one, mosquito gone!"}, {"id": 27, "duration_s": 2.31, "emotion": "determined", "text": "Give forty! One for every clap."}, {"id": 28, "duration_s": 2.83, "emotion": "stern_warning", "text": "Ten each. Not one rupee less!"}, {"id": 29, "duration_s": 3.72, "emotion": "angry", "text": "Seth ji! These are last year's puja ones!"}, {"id": 30, "duration_s": 3.91, "emotion": "embarrassed", "text": "Old puja... new mosquito."}, {"id": 31, "duration_s": 6.38, "emotion": "giggly", "text": "By evening, clouds came to the colony. Mosquitoes didn't leave."}, {"id": 32, "duration_s": 2.56, "emotion": "excited", "text": "We're live! Clouds in the colony!"}, {"id": 33, "duration_s": 2.25, "emotion": "determined", "text": "Seth ji, don't move."}, {"id": 34, "duration_s": 4.31, "emotion": "tired", "text": "Smoke gone... mosquito not gone."}, {"id": 35, "duration_s": 3.24, "emotion": "serious", "text": "Two days later. At Seth ji's house."}, {"id": 36, "duration_s": 3.08, "emotion": "loving", "text": "Wake up, beta. Your favourite laddoos."}, {"id": 37, "duration_s": 3.29, "emotion": "shocked", "text": "Laddu said no... to laddoo?!"}, {"id": 38, "duration_s": 4.09, "emotion": "tired", "text": "Mummy... not... hungry."}, {"id": 39, "duration_s": 2.67, "emotion": "worried", "text": "Fever! Seth ji, doctor!"}, {"id": 40, "duration_s": 2.88, "emotion": "worried", "text": "Fees... never mind! Never mind!"}, {"id": 41, "duration_s": 3.37, "emotion": "calm", "text": "Fever means, bring him to clinic in the morning itself."}, {"id": 42, "duration_s": 3.07, "emotion": "serious", "text": "Dengue test is must. No tension, okay?"}, {"id": 43, "duration_s": 2.17, "emotion": "serious", "text": "And stagnant water around the house?"}, {"id": 44, "duration_s": 1.34, "emotion": "proud", "text": "Our house is clean!"}, {"id": 45, "duration_s": 3.14, "emotion": "serious", "text": "Dengue mosquito breeds in clean, stagnant water only."}, {"id": 46, "duration_s": 1.29, "emotion": "happy", "text": "Let's go, let's go, let's go!"}, {"id": 47, "duration_s": 3.26, "emotion": "giggly", "text": "...and we have arrived."}, {"id": 48, "duration_s": 5.26, "emotion": "relieved", "text": "Not dengue. Just mild fever."}, {"id": 49, "duration_s": 1.12, "emotion": "pleading", "text": "So... laddoo?"}, {"id": 50, "duration_s": 2.52, "emotion": "stern_warning", "text": "After you recover. Only one."}, {"id": 51, "duration_s": 0.7, "emotion": "shocked", "text": "One?!"}, {"id": 52, "duration_s": 2.46, "emotion": "excited", "text": "I have an idea! We will become..."}, {"id": 53, "duration_s": 1.49, "emotion": "excited", "text": "...mosquito detectives!"}, {"id": 54, "duration_s": 2.77, "emotion": "proud", "text": "Can I tell? Seriously this time?"}, {"id": 55, "duration_s": 1.76, "emotion": "stern_warning", "text": "Speak! Quick!"}, {"id": 56, "duration_s": 2.94, "emotion": "serious", "text": "Dengue mosquito mostly bites in the daytime."}, {"id": 57, "duration_s": 4.51, "emotion": "serious", "text": "Not dirty drains, it lays eggs in clean, standing water."}, {"id": 58, "duration_s": 3.47, "emotion": "shocked", "text": "So Lakhan bhaiya's science is... upside down!"}, {"id": 59, "duration_s": 3.58, "emotion": "serious", "text": "Tiny wriggly worms in water? That's larvae."}, {"id": 60, "duration_s": 9.08, "emotion": "serious", "text": "In one week, larvae become mosquitoes!"}, {"id": 61, "duration_s": 2.58, "emotion": "determined", "text": "Detectives! Take my revenge!"}, {"id": 62, "duration_s": 2.79, "emotion": "determined", "text": "Every bucket! Every flowerpot! Every tyre!"}, {"id": 63, "duration_s": 2.41, "emotion": "proud", "text": "Detective work? Grown-ups will handle it!"}, {"id": 64, "duration_s": 0.65, "emotion": "angry", "text": "Quiet!"}, {"id": 65, "duration_s": 3.15, "emotion": "excited", "text": "And so began... Mosquito Detectives!"}, {"id": 66, "duration_s": 1.99, "emotion": "excited", "text": "Found it! Larvae in the cooler!"}, {"id": 67, "duration_s": 2.89, "emotion": "proud", "text": "My cooler? They're just... tenants."}, {"id": 68, "duration_s": 1.59, "emotion": "scared_whisper", "text": "I... fear... nobody."}, {"id": 69, "duration_s": 1.97, "emotion": "panicked", "text": "Pooja! He's asking for rent!"}, {"id": 70, "duration_s": 3.03, "emotion": "stern_warning", "text": "Dadi, even in the flowerpot saucer!"}, {"id": 71, "duration_s": 3.27, "emotion": "proud", "text": "My plants get puja every single day!"}, {"id": 72, "duration_s": 4.04, "emotion": "sarcastic", "text": "Puja, water... mosquitoes too."}, {"id": 73, "duration_s": 1.82, "emotion": "determined", "text": "Enough! I'll handle it now."}, {"id": 74, "duration_s": 3.3, "emotion": "proud", "text": "Every week, empty, dry. Ten seconds."}, {"id": 75, "duration_s": 2.66, "emotion": "embarrassed", "text": "I was... also helping."}, {"id": 76, "duration_s": 2.84, "emotion": "mischievous", "text": "And on the roof... Tinku's business."}, {"id": 77, "duration_s": 1.64, "emotion": "excited", "text": "Don't take tension!"}, {"id": 78, "duration_s": 4.39, "emotion": "proud", "text": "My tyre business! Twenty tyres, next year twenty lakh!"}, {"id": 79, "duration_s": 3.6, "emotion": "serious", "text": "One tyre... over a hundred larvae."}, {"id": 80, "duration_s": 1.42, "emotion": "shocked", "text": "And twenty tyres?"}, {"id": 81, "duration_s": 2.69, "emotion": "shocked", "text": "A whole mosquito colony!"}, {"id": 82, "duration_s": 2.72, "emotion": "mischievous", "text": "So... should I charge them rent?"}, {"id": 83, "duration_s": 3.59, "emotion": "proud", "text": "Sunshine for my pickle! At least I..."}, {"id": 84, "duration_s": 2.02, "emotion": "mischievous", "text": "Dadi... your lid also."}, {"id": 85, "duration_s": 4.68, "emotion": "shocked", "text": "Oh my God! The whole colony will see!"}, {"id": 86, "duration_s": 1.62, "emotion": "angry", "text": "All because of your tyres!"}, {"id": 87, "duration_s": 0.97, "emotion": "panicked", "text": "Jars too!"}, {"id": 88, "duration_s": 1.82, "emotion": "embarrassed", "text": "Aim... perfect again."}, {"id": 89, "duration_s": 3.6, "emotion": "determined", "text": "Tyres upside down, water out, business in!"}, {"id": 90, "duration_s": 2.81, "emotion": "excited", "text": "Did you hear? Twenty lakh on Sharma's roof!"}, {"id": 91, "duration_s": 3.87, "emotion": "panicked", "text": "Twenty lakh... mosquitoes! Dengue has come!"}, {"id": 92, "duration_s": 3.61, "emotion": "serious", "text": "Evil eye! Lemons on every door!"}, {"id": 93, "duration_s": 4.16, "emotion": "mischievous", "text": "Mosquito nets! Today's rate, double!"}, {"id": 94, "duration_s": 6.34, "emotion": "giggly", "text": "And then... the colony held a ghost baraat."}, {"id": 95, "duration_s": 2.69, "emotion": "shouting", "text": "Inquiry for every mosquito!"}, {"id": 96, "duration_s": 0.96, "emotion": "angry", "text": "Quiet!"}, {"id": 97, "duration_s": 5.61, "emotion": "serious", "text": "Not smoke, lemons, rackets. Throw out standing water!"}, {"id": 98, "duration_s": 1.03, "emotion": "excited", "text": "I have an idea!"}, {"id": 99, "duration_s": 2.64, "emotion": "excited", "text": "Cleanliness race! Who finds the most water!"}, {"id": 100, "duration_s": 3.1, "emotion": "determined", "text": "Race? Sharmas never lose!"}, {"id": 101, "duration_s": 2.64, "emotion": "excited", "text": "The colony's first... Cleanliness Race!"}, {"id": 102, "duration_s": 2.67, "emotion": "serious", "text": "Listen to the rules! Whoever gets most..."}, {"id": 103, "duration_s": 1.71, "emotion": "serious", "text": "Larvae, Masterji! Larvae!"}, {"id": 104, "duration_s": 2.08, "emotion": "shocked", "text": "Lovers? In this colony?"}, {"id": 105, "duration_s": 2.34, "emotion": "scared_whisper", "text": "Whose? Where? At this age?"}, {"id": 106, "duration_s": 1.91, "emotion": "sarcastic", "text": "Baby mosquitoes, Masterji!"}, {"id": 107, "duration_s": 2.1, "emotion": "embarrassed", "text": "Oh... then fine. Start!"}, {"id": 108, "duration_s": 2.2, "emotion": "tired", "text": "Full sleeves... full sweat!"}, {"id": 109, "duration_s": 2.69, "emotion": "giggly", "text": "But the mosquito slipped!"}, {"id": 110, "duration_s": 1.85, "emotion": "determined", "text": "Nani, your bowl too!"}, {"id": 111, "duration_s": 2.94, "emotion": "embarrassed", "text": "Evil eye... was on the water."}, {"id": 112, "duration_s": 2.77, "emotion": "happy", "text": "Arey, a pond on the roof too!"}, {"id": 113, "duration_s": 5.58, "emotion": "shouting", "text": "Rain? Samosa? There will be an inquiry!"}, {"id": 114, "duration_s": 2.29, "emotion": "mischievous", "text": "Seth ji, free tenants!"}, {"id": 115, "duration_s": 2.57, "emotion": "sad", "text": "Nobody stays free in my shop!"}, {"id": 116, "duration_s": 2.5, "emotion": "proud", "text": "Science says... this won't move."}, {"id": 117, "duration_s": 0.7, "emotion": "calm", "text": "Move."}, {"id": 118, "duration_s": 2.83, "emotion": "embarrassed", "text": "Science says... listen to the kids."}, {"id": 119, "duration_s": 3.36, "emotion": "excited", "text": "We're live! Hashtag mosquito-free!"}, {"id": 120, "duration_s": 4.19, "emotion": "proud", "text": "In one hour, not one drop of standing water in the colony."}, {"id": 121, "duration_s": 3.13, "emotion": "excited", "text": "Ten thousand views! Colony gone viral!"}, {"id": 122, "duration_s": 2.18, "emotion": "excited", "text": "Did you hear? Good news this time!"}, {"id": 123, "duration_s": 4.49, "emotion": "proud", "text": "And I'm in front in the reel! Whole colony will see!"}, {"id": 124, "duration_s": 3.78, "emotion": "proud", "text": "Dengue-free colony. And lover-free also."}, {"id": 125, "duration_s": 2.4, "emotion": "sarcastic", "text": "Larvae, Masterji... larvae."}, {"id": 126, "duration_s": 3.16, "emotion": "happy", "text": "The colony beat the mosquito... by fighting water."}, {"id": 127, "duration_s": 2.23, "emotion": "stern_warning", "text": "Doctor said. Only one."}, {"id": 128, "duration_s": 2.99, "emotion": "loving", "text": "Only one... so I'll eat slowly."}, {"id": 129, "duration_s": 1.92, "emotion": "tired", "text": "Laddu, twenty minutes gone!"}, {"id": 130, "duration_s": 3.6, "emotion": "happy", "text": "I'm all better! And now... I'm hungry!"}, {"id": 131, "duration_s": 3.73, "emotion": "proud", "text": "Didn't I say, I fear nobody!"}, {"id": 132, "duration_s": 0.72, "emotion": "mischievous", "text": "Bzzzzz..."}, {"id": 133, "duration_s": 1.68, "emotion": "calm", "text": "Listen, detectives."}, {"id": 134, "duration_s": 2.86, "emotion": "serious", "text": "To fight mosquitoes... fight the water."}, {"id": 135, "duration_s": 4.25, "emotion": "serious", "text": "Once a week, empty every container, cover the tank."}, {"id": 136, "duration_s": 4.78, "emotion": "loving", "text": "Full-sleeve clothes. And with fever, straight to the doctor."}, {"id": 137, "duration_s": 1.0, "emotion": "excited", "text": "Case closed!"}, {"id": 138, "duration_s": 3.02, "emotion": "mischievous", "text": "Colony improved... but Ramesh's clapping?"}, {"id": 139, "duration_s": 1.12, "emotion": "scared_whisper", "text": "Forty-first..."}]