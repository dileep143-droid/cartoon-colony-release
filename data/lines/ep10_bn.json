[{"id": 1, "duration_s": 4.3, "emotion": "mischievous", "text": "রাত দুটো। গোটা পাড়া ঘুমে কাদা।"}, {"id": 2, "duration_s": 1.12, "emotion": "mischievous", "text": "একজন ছাড়া।"}, {"id": 3, "duration_s": 1.37, "emotion": "angry", "text": "আমার কানে এয়ারপোর্ট?"}, {"id": 4, "duration_s": 1.47, "emotion": "proud", "text": "আমি কাউকে ডরাই না!"}, {"id": 5, "duration_s": 4.66, "emotion": "giggly", "text": "দশ তালি... কুড়ি তালি... তিরিশ তালি..."}, {"id": 6, "duration_s": 2.17, "emotion": "sarcastic", "text": "তালি কেন? বরযাত্রী এসেছে?"}, {"id": 7, "duration_s": 2.61, "emotion": "scared_whisper", "text": "চল্লিশতম... আর শেষটা।"}, {"id": 8, "duration_s": 7.07, "emotion": "giggly", "text": "চল্লিশ তালি। মশা: শূন্য। হারু: চল্লিশ। খেলা শেষ!"}, {"id": 9, "duration_s": 2.67, "emotion": "determined", "text": "সর! আমার চটি ফসকায় না!"}, {"id": 10, "duration_s": 2.81, "emotion": "embarrassed", "text": "ফসকায়নি... সোজা আমার কপালে!"}, {"id": 11, "duration_s": 2.19, "emotion": "proud", "text": "দেখলি? টিপ পাকা!"}, {"id": 12, "duration_s": 3.0, "emotion": "mischievous", "text": "আর এ তো... সবে শুরু।"}, {"id": 13, "duration_s": 5.96, "emotion": "giggly", "text": "ভোর হতেই... গোটা পাড়া চুলকে নাচছে।"}, {"id": 14, "duration_s": 3.22, "emotion": "excited", "text": "শুনেছ? রাতে মশার ফৌজ এসেছিল!"}, {"id": 15, "duration_s": 3.99, "emotion": "mischievous", "text": "আর হারুবাবু নিজের গালে চল্লিশ চড় মেরেছে!"}, {"id": 16, "duration_s": 2.5, "emotion": "embarrassed", "text": "ও মশা না... হাতি ছিল!"}, {"id": 17, "duration_s": 2.29, "emotion": "sarcastic", "text": "হাতি না, ঠাকুমার চটি!"}, {"id": 18, "duration_s": 2.96, "emotion": "serious", "text": "নজর লেগেছে! মশার নজর!"}, {"id": 19, "duration_s": 2.49, "emotion": "shocked", "text": "ওমা! লঙ্কাটাও সাবাড়!"}, {"id": 20, "duration_s": 4.27, "emotion": "stern_warning", "text": "সিঙাড়া? থামো! তদন্ত!"}, {"id": 21, "duration_s": 1.69, "emotion": "happy", "text": "তদন্ত শেষ। খিদে পেল!"}, {"id": 22, "duration_s": 3.5, "emotion": "proud", "text": "বিজ্ঞান বলে, মশা শুধু নোংরা নর্দমায় জন্মায়!"}, {"id": 23, "duration_s": 1.04, "emotion": "curious", "text": "আমি বলব?"}, {"id": 24, "duration_s": 1.84, "emotion": "proud", "text": "বাচ্চারা চুপ! বিজ্ঞান বলছে।"}, {"id": 25, "duration_s": 2.74, "emotion": "proud", "text": "আমাদের পাড়া সাফ, মশা বাইরে থেকে আসে!"}, {"id": 26, "duration_s": 3.65, "emotion": "excited", "text": "মশা-প্রুফ ধূপ! একটা জ্বালাও, মশা হাওয়া!"}, {"id": 27, "duration_s": 2.2, "emotion": "determined", "text": "চল্লিশটা দাও! এক তালিতে একটা!"}, {"id": 28, "duration_s": 2.62, "emotion": "stern_warning", "text": "দশ টাকায় একটা। এক টাকাও কম নয়!"}, {"id": 29, "duration_s": 2.93, "emotion": "angry", "text": "হারেনবাবু! এ তো গত বছরের পুজোর ধূপ!"}, {"id": 30, "duration_s": 3.63, "emotion": "embarrassed", "text": "পুরনো পুজো, নতুন মশা... ইশ!"}, {"id": 31, "duration_s": 4.42, "emotion": "giggly", "text": "সন্ধেয় পাড়ায় মেঘ নামল। মশা নড়ল না।"}, {"id": 32, "duration_s": 2.11, "emotion": "excited", "text": "লাইভ চলছে! পাড়ায় মেঘ নেমেছে!"}, {"id": 33, "duration_s": 3.615, "emotion": "determined", "text": "হারেনবাবু, নড়বে না!"}, {"id": 34, "duration_s": 3.5, "emotion": "tired", "text": "ধোঁয়া গেল... মশা গেল না।"}, {"id": 35, "duration_s": 2.69, "emotion": "serious", "text": "দুদিন পর। হারেনের বাড়ি।"}, {"id": 36, "duration_s": 2.5, "emotion": "loving", "text": "ওঠ বাবা। তোর প্রিয় নাড়ু।"}, {"id": 37, "duration_s": 3.18, "emotion": "shocked", "text": "রসো... নাড়ুকে না বলল?!"}, {"id": 38, "duration_s": 4.0, "emotion": "tired", "text": "মা... খিদে... পায়নি।"}, {"id": 39, "duration_s": 2.47, "emotion": "worried", "text": "জ্বর! ওগো, ডাক্তার!"}, {"id": 40, "duration_s": 2.24, "emotion": "worried", "text": "ফি-র... কথা থাক! থাক!"}, {"id": 41, "duration_s": 1.76, "emotion": "calm", "text": "জ্বর হইলে ক্লিনিকে আইসো বাহে।"}, {"id": 42, "duration_s": 2.09, "emotion": "serious", "text": "ডেঙ্গুর পরীক্ষা লাগবে। ডরাইয়েন না।"}, {"id": 43, "duration_s": 4.217, "emotion": "serious", "text": "আর বাড়ির ধারে জমা পানি আছে নি?"}, {"id": 44, "duration_s": 1.73, "emotion": "proud", "text": "আমাদের বাড়ি সাফ!"}, {"id": 45, "duration_s": 3.3, "emotion": "serious", "text": "ডেঙ্গুর মশা সাফ জমা পানিতেই জন্মায় বাহে।"}, {"id": 46, "duration_s": 2.93, "emotion": "happy", "text": "চলো, রওনা দিই!"}, {"id": 47, "duration_s": 1.13, "emotion": "giggly", "text": "...পৌঁছেও গেলাম।"}, {"id": 48, "duration_s": 2.63, "emotion": "relieved", "text": "ডেঙ্গু হয়নি। সামান্য জ্বর।"}, {"id": 49, "duration_s": 2.56, "emotion": "pleading", "text": "তো... নাড়ু?"}, {"id": 50, "duration_s": 2.52, "emotion": "stern_warning", "text": "সেরে উঠলে। শুধু একটা।"}, {"id": 51, "duration_s": 0.81, "emotion": "shocked", "text": "একটা?!"}, {"id": 52, "duration_s": 2.33, "emotion": "excited", "text": "বুদ্ধি পেয়েছি! আমরা হব..."}, {"id": 53, "duration_s": 1.71, "emotion": "excited", "text": "...মশা-গোয়েন্দা!"}, {"id": 54, "duration_s": 2.18, "emotion": "proud", "text": "আমি বলব? এবার সত্যিই?"}, {"id": 55, "duration_s": 1.28, "emotion": "stern_warning", "text": "বলো! জলদি!"}, {"id": 56, "duration_s": 3.12, "emotion": "serious", "text": "ডেঙ্গুর মশা বেশিরভাগ দিনে কামড়ায়।"}, {"id": 57, "duration_s": 3.32, "emotion": "serious", "text": "নোংরা নর্দমায় না, সাফ জমা জলে ডিম পাড়ে।"}, {"id": 58, "duration_s": 2.27, "emotion": "shocked", "text": "মানে গোপুদার বিজ্ঞান... উল্টো!"}, {"id": 59, "duration_s": 2.78, "emotion": "serious", "text": "জলে ছোট ছোট পোকা দেখলে, সেটাই লার্ভা।"}, {"id": 60, "duration_s": 1.83, "emotion": "serious", "text": "এক সপ্তাহে লার্ভা থেকে মশা!"}, {"id": 61, "duration_s": 2.31, "emotion": "determined", "text": "গোয়েন্দারা! প্রতিশোধ নিও!"}, {"id": 62, "duration_s": 3.91, "emotion": "determined", "text": "প্রতিটা হাঁড়ি! প্রতিটা টব! প্রতিটা টায়ার!"}, {"id": 63, "duration_s": 3.4, "emotion": "proud", "text": "গোয়েন্দাগিরি? বড়রা সামলাবে!"}, {"id": 64, "duration_s": 0.59, "emotion": "angry", "text": "চুপ!"}, {"id": 65, "duration_s": 3.88, "emotion": "excited", "text": "আর শুরু হল... মশা-গোয়েন্দাগিরি!"}, {"id": 66, "duration_s": 2.36, "emotion": "excited", "text": "পেয়েছি! কুলারে লার্ভা!"}, {"id": 67, "duration_s": 3.17, "emotion": "proud", "text": "আমার কুলার? ওরা তো... ভাড়াটে।"}, {"id": 68, "duration_s": 2.34, "emotion": "scared_whisper", "text": "আমি... কাউকে... ডরাই না।"}, {"id": 69, "duration_s": 1.88, "emotion": "panicked", "text": "মিতালি! ও ভাড়া চাইছে!"}, {"id": 70, "duration_s": 2.12, "emotion": "stern_warning", "text": "ঠাকুমা, টবের পাতেও!"}, {"id": 71, "duration_s": 1.89, "emotion": "proud", "text": "আমার টবের রোজ পুজো হয়!"}, {"id": 72, "duration_s": 2.99, "emotion": "sarcastic", "text": "পুজোও, জলও... মশাও।"}, {"id": 73, "duration_s": 1.82, "emotion": "determined", "text": "অনেক হল! আমি দেখছি।"}, {"id": 74, "duration_s": 4.05, "emotion": "proud", "text": "প্রতি সপ্তাহে খালি করো, শুকোও। দশ সেকেন্ড।"}, {"id": 75, "duration_s": 2.49, "emotion": "embarrassed", "text": "ভয়? আমি সাহায্য করছিলাম!"}, {"id": 76, "duration_s": 2.66, "emotion": "mischievous", "text": "আর ছাদে... ভোম্বলের ব্যবসা।"}, {"id": 77, "duration_s": 0.75, "emotion": "excited", "text": "চিন্তা নেই!"}, {"id": 78, "duration_s": 4.57, "emotion": "proud", "text": "এই আমার টায়ার ব্যবসা! কুড়িটা টায়ার, সামনের বছর কুড়ি লাখ!"}, {"id": 79, "duration_s": 2.87, "emotion": "serious", "text": "একটা টায়ারে... একশোর বেশি লার্ভা।"}, {"id": 80, "duration_s": 1.21, "emotion": "shocked", "text": "আর কুড়িটায়?"}, {"id": 81, "duration_s": 2.34, "emotion": "shocked", "text": "গোটা মশার পাড়া!"}, {"id": 82, "duration_s": 1.46, "emotion": "mischievous", "text": "তো... ওদের ভাড়া নিই?"}, {"id": 83, "duration_s": 4.63, "emotion": "proud", "text": "আমার আচারে রোদ! অন্তত আমি তো..."}, {"id": 84, "duration_s": 2.19, "emotion": "mischievous", "text": "ঠাকুমা... আপনার ঢাকনাতেও।"}, {"id": 85, "duration_s": 2.3, "emotion": "shocked", "text": "এ মা! পাড়াসুদ্ধ দেখবে!"}, {"id": 86, "duration_s": 2.0, "emotion": "angry", "text": "সব তোর টায়ারের জন্য!"}, {"id": 87, "duration_s": 0.89, "emotion": "panicked", "text": "বয়ামও!"}, {"id": 88, "duration_s": 1.62, "emotion": "embarrassed", "text": "টিপ... আবার অব্যর্থ।"}, {"id": 89, "duration_s": 3.24, "emotion": "determined", "text": "টায়ার উল্টো, জল বাইরে, ব্যবসা ভেতরে!"}, {"id": 90, "duration_s": 2.76, "emotion": "excited", "text": "শুনেছ? হারুবাবুর ছাদে কুড়ি লাখ!"}, {"id": 91, "duration_s": 2.73, "emotion": "panicked", "text": "কুড়ি লাখ... মশা! ডেঙ্গু এসে গেল!"}, {"id": 92, "duration_s": 3.4, "emotion": "serious", "text": "নজর লেগেছে! দোরে দোরে লেবু-লঙ্কা!"}, {"id": 93, "duration_s": 3.93, "emotion": "mischievous", "text": "মশারি! আজ রেট দ্বিগুণ!"}, {"id": 94, "duration_s": 4.24, "emotion": "giggly", "text": "আর তারপর... পাড়ায় ভূতের বরযাত্রী বেরোল।"}, {"id": 95, "duration_s": 4.29, "emotion": "shouting", "text": "প্রতিটা মশার তদন্ত হবে!"}, {"id": 96, "duration_s": 0.77, "emotion": "angry", "text": "চুপ!"}, {"id": 97, "duration_s": 5.16, "emotion": "serious", "text": "ধোঁয়া, লেবু, ব্যাটে নয়। জমা জল ফেলো!"}, {"id": 98, "duration_s": 1.35, "emotion": "excited", "text": "বুদ্ধি পেয়েছি!"}, {"id": 99, "duration_s": 2.9, "emotion": "excited", "text": "সাফাই রেস! যে সবচেয়ে বেশি জল খুঁজবে!"}, {"id": 100, "duration_s": 2.26, "emotion": "determined", "text": "রেস? হারু কখনও হারে না!"}, {"id": 101, "duration_s": 2.42, "emotion": "excited", "text": "পাড়ার প্রথম... সাফাই রেস!"}, {"id": 102, "duration_s": 3.28, "emotion": "serious", "text": "নিয়ম শোনো! যে সবচেয়ে বেশি..."}, {"id": 103, "duration_s": 1.5, "emotion": "serious", "text": "লার্ভা, স্যার! লার্ভা!"}, {"id": 104, "duration_s": 1.91, "emotion": "shocked", "text": "লাভার? এই পাড়ায়?"}, {"id": 105, "duration_s": 1.87, "emotion": "scared_whisper", "text": "কার? কোথায়? এই বয়সে?"}, {"id": 106, "duration_s": 2.04, "emotion": "sarcastic", "text": "মশার বাচ্চা, মাস্টারমশাই!"}, {"id": 107, "duration_s": 2.46, "emotion": "embarrassed", "text": "ও... তাহলে ঠিক আছে। শুরু!"}, {"id": 108, "duration_s": 3.31, "emotion": "tired", "text": "পুরো হাতা... পুরো ঘাম!"}, {"id": 109, "duration_s": 0.81, "emotion": "giggly", "text": "তবু মশা পিছলে গেল!"}, {"id": 110, "duration_s": 4.01, "emotion": "determined", "text": "দিদিমা, আপনার বাটিও!"}, {"id": 111, "duration_s": 5.29, "emotion": "embarrassed", "text": "নজর... জলেরই লেগেছিল।"}, {"id": 112, "duration_s": 1.36, "emotion": "happy", "text": "আরে, ছাদে পুকুর!"}, {"id": 113, "duration_s": 4.9, "emotion": "shouting", "text": "বৃষ্টি? সিঙাড়া? তদন্ত হবে!"}, {"id": 114, "duration_s": 2.74, "emotion": "mischievous", "text": "হারেনবাবু, বিনি পয়সার ভাড়াটে!"}, {"id": 115, "duration_s": 3.38, "emotion": "sad", "text": "আমার দোকানে বিনি পয়সায় কেউ থাকে না!"}, {"id": 116, "duration_s": 2.73, "emotion": "proud", "text": "বিজ্ঞান বলে... এটা নড়বে না।"}, {"id": 117, "duration_s": 0.6, "emotion": "calm", "text": "সর।"}, {"id": 118, "duration_s": 2.66, "emotion": "embarrassed", "text": "বিজ্ঞান বলে... বাচ্চাদের কথা শোনো।"}, {"id": 119, "duration_s": 2.6, "emotion": "excited", "text": "লাইভ চলছে! হ্যাশট্যাগ মশা-মুক্ত!"}, {"id": 120, "duration_s": 3.19, "emotion": "proud", "text": "এক ঘণ্টায়, পাড়ায় এক ফোঁটা জমা জল নেই।"}, {"id": 121, "duration_s": 2.88, "emotion": "excited", "text": "দশ হাজার ভিউ! পাড়া ভাইরাল!"}, {"id": 122, "duration_s": 2.24, "emotion": "excited", "text": "শুনেছ? এবার ভালো খবর!"}, {"id": 123, "duration_s": 3.65, "emotion": "proud", "text": "আর রিলে সবার আগে আমি! পাড়াসুদ্ধ দেখবে!"}, {"id": 124, "duration_s": 3.2, "emotion": "proud", "text": "ডেঙ্গু-মুক্ত পাড়া। আর লাভার-মুক্তও।"}, {"id": 125, "duration_s": 1.94, "emotion": "sarcastic", "text": "লার্ভা, স্যার... লার্ভা।"}, {"id": 126, "duration_s": 2.98, "emotion": "happy", "text": "পাড়া মশাকে হারাল... জলের সঙ্গে লড়ে।"}, {"id": 127, "duration_s": 3.12, "emotion": "stern_warning", "text": "ডাক্তার বলেছিল। শুধু একটা।"}, {"id": 128, "duration_s": 4.417, "emotion": "loving", "text": "একটাই যখন... আস্তে আস্তে খাব।"}, {"id": 129, "duration_s": 1.43, "emotion": "tired", "text": "রসো, কুড়ি মিনিট হয়ে গেল!"}, {"id": 130, "duration_s": 4.32, "emotion": "happy", "text": "সেরে গেছি! আর এবার... খিদে পেয়েছে!"}, {"id": 131, "duration_s": 2.64, "emotion": "proud", "text": "বলেছিলাম না, আমি কাউকে ডরাই না।"}, {"id": 132, "duration_s": 1.78, "emotion": "mischievous", "text": "ভোঁন..."}, {"id": 133, "duration_s": 2.24, "emotion": "calm", "text": "শোনো, গোয়েন্দারা।"}, {"id": 134, "duration_s": 3.55, "emotion": "serious", "text": "মশা তাড়াবে? জলের সঙ্গে লড়ো।"}, {"id": 135, "duration_s": 4.08, "emotion": "serious", "text": "সপ্তাহে একবার, সব পাত্র খালি, ট্যাঙ্ক ঢাকা।"}, {"id": 136, "duration_s": 7.322, "emotion": "loving", "text": "full-হাতা জামা। আর জ্বর হলে, সোজা ডাক্তার।"}, {"id": 137, "duration_s": 1.35, "emotion": "excited", "text": "কেস বন্ধ!"}, {"id": 138, "duration_s": 4.45, "emotion": "mischievous", "text": "পাড়া শুধরোল... কিন্তু হারুর তালি?"}, {"id": 139, "duration_s": 0.91, "emotion": "scared_whisper", "text": "একচল্লিশ..."}]