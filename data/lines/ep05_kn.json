[{"id": 1, "duration_s": 3.47, "emotion": "excited", "text": "ಕಾಲೋನಿಯ ಮಹಾ ಪಂದ್ಯ... ಹಗ್ಗ ಜಗ್ಗಾಟ!"}, {"id": 2, "duration_s": 2.94, "emotion": "proud", "text": "ಏಳು ದಿನದ ಪೌಡರ್! ನಂಗ್ಯಾರ ಭಯ ಇಲ್ಲ!"}, {"id": 3, "duration_s": 2.08, "emotion": "calm", "text": "ದಾಸಪ್ಪ, ಚಹಾ ಬಿಸಿ ಇಡಿ."}, {"id": 4, "duration_s": 2.41, "emotion": "excited", "text": "ಲೈವ್ ಇದೆ! ಸ್ಲೋ ಮೋಷನ್‌ನಲ್ಲಿ!"}, {"id": 5, "duration_s": 3.68, "emotion": "mischievous", "text": "ಇದೆಲ್ಲ ಶುರುವಾಗಿದ್ದು... ಒಂದು ಡಬ್ಬದಿಂದ."}, {"id": 6, "duration_s": 3.74, "emotion": "happy", "text": "ಏಳು ದಿನ ಹಿಂದೆ. ಕಾಲೋನಿ ಕ್ರೀಡಾ ವಾರ."}, {"id": 7, "duration_s": 7.04, "emotion": "excited", "text": "ಭಾನುವಾರ ಹಗ್ಗ ಜಗ್ಗಾಟ! ಶಿವಣ್ಣ ತಂಡ ವರ್ಸಸ್ ದಾಸಪ್ಪ ತಂಡ!"}, {"id": 8, "duration_s": 5.195, "emotion": "proud", "text": "ಈ ಸಲ ಕಪ್ ನಮ್ದೇ! ನಂಗ್ಯಾರ ಭಯ ಇಲ್ಲ!"}, {"id": 9, "duration_s": 5.24, "emotion": "sarcastic", "text": "ಲೆಕ್ಕ ಹಾಕ್ದೆ. ಶಿವಣ್ಣ ಗೆಲ್ಲೋ ಚಾನ್ಸ್... ಸೊನ್ನೆ."}, {"id": 10, "duration_s": 2.13, "emotion": "sarcastic", "text": "ಯಾರಿಗೂ ಭಯ ಇಲ್ವಾ, ಶಿವಣ್ಣ?"}, {"id": 11, "duration_s": 3.5, "emotion": "comic_panic", "text": "ಯಾರಿಗೂ ಇಲ್ಲ! ಹಲ್ಲಿ... ಇರಲ್ಲ ತಾನೆ?"}, {"id": 12, "duration_s": 2.71, "emotion": "stern_warning", "text": "ಸುಮ್ನಿರಿ! ಅಂಕಲ್ ಮತ್ತೆ ಹಾರ್ತಾರೆ!"}, {"id": 13, "duration_s": 1.07, "emotion": "happy", "text": "ಹೊರಡೋಣ, ಬನ್ನಿ!"}, {"id": 14, "duration_s": 1.89, "emotion": "calm", "text": "ಸರೀರಿ, ನಾನ್ ನೋಡ್ತೀನಿ."}, {"id": 15, "duration_s": 2.43, "emotion": "shocked", "text": "ಅತ್ತಿಗೆ, ನೀವು ಟ್ರ್ಯಾಕ್ಟರೇ ಎಳೀತೀರಿ!"}, {"id": 16, "duration_s": 1.08, "emotion": "excited", "text": "ಟೆನ್ಷನ್ ಬೇಡ, ಅಣ್ಣ!"}, {"id": 17, "duration_s": 3.42, "emotion": "worried", "text": "ಟೆನ್ಷನ್? ಅವ್ಳು ಆಟೋ ಎಳೆದ್ಬಿಟ್ಲು, ಸೀನ!"}, {"id": 18, "duration_s": 3.88, "emotion": "proud", "text": "ನನ್ ಮಗ ಗೆಲ್ತಾನೆ! ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ!"}, {"id": 19, "duration_s": 3.52, "emotion": "mischievous", "text": "ಕೇಳಿದ್ರಾ? ಶಿವಣ್ಣ ಹಲ್ಲಿಗೆ ಸೋತ್ರಂತೆ!"}, {"id": 20, "duration_s": 3.18, "emotion": "sad", "text": "ಚಿಪ್ಸ್ ಎಲ್ಲಿ ಹೋಯ್ತು? ಹಸಿವಾಗ್ತಿದೆ!"}, {"id": 21, "duration_s": 3.74, "emotion": "excited", "text": "ಸುಲ್ತಾನ್ ಪವರ್ ಪೌಡರ್! ಏಳೇ ದಿನಕ್ಕೆ ಬಾಡಿ ಉಂಟು!"}, {"id": 22, "duration_s": 1.81, "emotion": "excited", "text": "ಬರೀ ಒಂಬೈನೂರ ತೊಂಬತ್ತೊಂಬತ್ತು!"}, {"id": 23, "duration_s": 1.61, "emotion": "excited", "text": "ನಂಗೊಂದ್ ಐಡಿಯಾ! ಅಪ್ಪನಿಗಾಗಿ!"}, {"id": 24, "duration_s": 3.07, "emotion": "excited", "text": "ಅಪ್ಪಾ! ಏಳು ದಿನಕ್ಕೆ ಬಾಡಿ! ಭಾನುವಾರಕ್ಕೂ ಏಳೇ!"}, {"id": 25, "duration_s": 2.81, "emotion": "excited", "text": "ಸುಲ್ತಾನ್... ಬಾಡಿ... ಏಳು ದಿನ!"}, {"id": 26, "duration_s": 2.63, "emotion": "sarcastic", "text": "ಏಳು ದಿನಕ್ಕೆ ಉಪ್ಪಿನಕಾಯಿನೂ ಆಗಲ್ಲ!"}, {"id": 27, "duration_s": 2.87, "emotion": "proud", "text": "ಇದು ಸೈನ್ಸ್, ಕಾವೇರಿ! ಆರ್ಡರ್!"}, {"id": 28, "duration_s": 4.11, "emotion": "proud", "text": "ನನ್ ಮಗ ಸುಲ್ತಾನ್ ಆಗ್ತಾನೆ! ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ!"}, {"id": 29, "duration_s": 3.62, "emotion": "curious", "text": "ಪೌಡರ್ ಸಿಹಿ ಇರುತ್ತಾ? ನಂಗೂ ಬೇಕು."}, {"id": 30, "duration_s": 2.74, "emotion": "excited", "text": "ಸುಲ್ತಾನ್ ಪವರ್ ಪೌಡರ್! ಜಲ್ದಿ ಡೆಲಿವರಿ!"}, {"id": 31, "duration_s": 2.25, "emotion": "loving", "text": "ಬಂದ್ಯಾ ನನ್ ಸುಲ್ತಾನ!"}, {"id": 32, "duration_s": 2.67, "emotion": "mischievous", "text": "ಕೇಳಿದ್ರಾ? ಡಬ್ಬದಲ್ಲಿ ಬಾಡಿ ತರಿಸಿದ್ರು!"}, {"id": 33, "duration_s": 2.78, "emotion": "determined", "text": "ಆಹಾ! ಶಕ್ತಿ ಬರ್ತಿದೆ!"}, {"id": 34, "duration_s": 2.38, "emotion": "curious", "text": "ಅಪ್ಪಾ... ಮಸಲ್ ಎಲ್ಲಿ ಅಡಗಿದೆ?"}, {"id": 35, "duration_s": 2.59, "emotion": "excited", "text": "ಬಂತು! ಒಂದು ಕೂದಲು ನಿಂತ್ತು!"}, {"id": 36, "duration_s": 2.65, "emotion": "shocked", "text": "ಕೇಳಿದ್ರಾ? ಶಿವಣ್ಣನ ಗುಂಡಿ ಉದುರ್ತಿವೆ!"}, {"id": 37, "duration_s": 1.58, "emotion": "embarrassed", "text": "ಬಾಡಿ ಬೆಳೀತಿದೆ, ಆಂಟಿ!"}, {"id": 38, "duration_s": 1.2, "emotion": "shocked", "text": "ಅರ್ಧ ಇಂಚು..."}, {"id": 39, "duration_s": 0.5, "emotion": "shocked", "text": "...ಕಮ್ಮಿ!"}, {"id": 40, "duration_s": 2.72, "emotion": "proud", "text": "ಒಳಗಡೆ ಬೆಳೀತಿದೆ!"}, {"id": 41, "duration_s": 2.19, "emotion": "happy", "text": "ಮೂಸಿದ್ರೂ ಶಕ್ತಿ ಬರುತ್ತೆ!"}, {"id": 42, "duration_s": 1.93, "emotion": "worried", "text": "ಶಿವಣ್ಣ, ಮೂಗಿಗೆ ಹಾಕ್ಬೇಡಿ!"}, {"id": 43, "duration_s": 2.6, "emotion": "comic_panic", "text": "ಆ... ಆ... ಆಕ್ಷೀ!"}, {"id": 44, "duration_s": 2.74, "emotion": "proud", "text": "ನೋಡಿ? ಪೌಡರ್ ಹೊರಗಿಂದಲೂ ಕೆಲ್ಸ ಮಾಡುತ್ತೆ!"}, {"id": 45, "duration_s": 1.73, "emotion": "determined", "text": "ಸಾಕು! ಇನ್ನು ನಾನ್ ನೋಡ್ತೀನಿ."}, {"id": 46, "duration_s": 3.09, "emotion": "shocked", "text": "ಅಯ್ಯಯ್ಯೋ! ನನ್ ಸುಲ್ತಾನ ಹಿಮದ ಗೊಂಬೆ ಆದ್ನಲ್ಲಾ!"}, {"id": 47, "duration_s": 2.6, "emotion": "serious", "text": "ನಿಲ್ಲಿ! ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ..."}, {"id": 48, "duration_s": 2.993, "emotion": "proud", "text": "ಇದು ನೂರಕ್ಕೆ ನೂರು ಸುಣ್ಣ!"}, {"id": 49, "duration_s": 3.85, "emotion": "laughing", "text": "<laugh> ಗ್ಞಾನಿ ಸೈನ್ಸಾ? ಹಾಗಿದ್ರೆ ಪಕ್ಕಾ ತಪ್ಪು!"}, {"id": 50, "duration_s": 3.11, "emotion": "giggly", "text": "ಗ್ಞಾನಿ ಹೇಳಿದ್ದ, ಮೋಡ ಸಿಲಿಂಡರ್‌ನಿಂದ ಆಗುತ್ತೆ ಅಂತ!"}, {"id": 51, "duration_s": 1.99, "emotion": "giggly", "text": "ಕೋಳಿ ಹಾಲು ಕೊಡುತ್ತೆ ಅಂತ!"}, {"id": 52, "duration_s": 2.24, "emotion": "laughing", "text": "ಚಂದ್ರನ ಮೇಲೆ ಚಹಾ ಅಂಗಡಿ ಇದೆ ಅಂತ!"}, {"id": 53, "duration_s": 1.75, "emotion": "pleading", "text": "ಆದ್ರೆ ಈ ಸಲ ನಿಜ!"}, {"id": 54, "duration_s": 2.4, "emotion": "serious", "text": "ನನ್ ಸುಲ್ತಾನಿಗೆ ದೃಷ್ಟಿ ಆಗದಿರ್ಲಿ!"}, {"id": 55, "duration_s": 1.67, "emotion": "proud", "text": "ಭಾನುವಾರ ಸುಲ್ತಾನ್ ಕಾಣ್ತಾನೆ!"}, {"id": 56, "duration_s": 4.15, "emotion": "sad", "text": "ನೋಡಿ... ಬರೀತಾನೂ ಇದೆ. ಯಾರೂ ನೋಡ್ತಿಲ್ಲ."}, {"id": 57, "duration_s": 2.47, "emotion": "excited", "text": "ಟೆನ್ಷನ್ ಬೇಡ! ಇದು ಚಿನ್ನದ ಗಣಿ!"}, {"id": 58, "duration_s": 1.65, "emotion": "mischievous", "text": "ನೂರ್ಗೆ ಕೊಂಡು ಇನ್ನೂರ್ಗೆ!"}, {"id": 59, "duration_s": 3.22, "emotion": "mischievous", "text": "ದಾಸಪ್ಪ, ಡೀಲರ್‌ಶಿಪ್! ಐವತ್ತು ಡಬ್ಬ!"}, {"id": 60, "duration_s": 1.71, "emotion": "curious", "text": "ಐವತ್ತು ಸುಲ್ತಾನ? ಲೆಕ್ಕ ಹಾಕ್ತೀನಿ."}, {"id": 61, "duration_s": 3.36, "emotion": "serious", "text": "ಐದ್ಸಾವಿರ. ಎರಡು ಸಲ ಎಣಿಸ್ದೆ... ಮೂರ್ನೇ ಸಲಾನೂ."}, {"id": 62, "duration_s": 1.61, "emotion": "pleading", "text": "ಒಂದ್ ರೂಪಾಯಿ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 63, "duration_s": 1.3, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪ!"}, {"id": 64, "duration_s": 3.34, "emotion": "embarrassed", "text": "ಭಾಗ್ಯ, ಇದು ಬಿಸಿನೆಸ್! ಡಬಲ್ ಲಾಭ!"}, {"id": 65, "duration_s": 1.5, "emotion": "sarcastic", "text": "ಇಲ್ಲಾ ಡಬಲ್ ನಷ್ಟ?"}, {"id": 66, "duration_s": 3.39, "emotion": "proud", "text": "ಐವತ್ತು ಡಬ್ಬ! ಇಡೀ ಕಾಲೋನಿ ಸುಲ್ತಾನ್!"}, {"id": 67, "duration_s": 2.87, "emotion": "happy", "text": "ನಾನೇನೂ ತಿಂದಿಲ್ಲ."}, {"id": 68, "duration_s": 2.49, "emotion": "surprised", "text": "ಇದು ಸಿಹಿ ಅಲ್ಲ... ಸುಣ್ಣ!"}, {"id": 69, "duration_s": 1.77, "emotion": "shouting", "text": "ಸುಮ್ನಿರು! ಬಿಸಿನೆಸ್!"}, {"id": 70, "duration_s": 3.49, "emotion": "mischievous", "text": "ತರಬೇತಿ ವಾರ. ಕೋಚ್... ಸೀನ."}, {"id": 71, "duration_s": 2.37, "emotion": "proud", "text": "ಕೋಚ್ ಸೀನ! ನೀವ್ ಓಡಿ, ನಾನ್ ಎಣಿಸ್ತೀನಿ."}, {"id": 72, "duration_s": 2.1, "emotion": "proud", "text": "ಓಡೋದ್ಯಾಕೆ? ಪೌಡರ್ ಇದ್ಯಲ್ಲಾ!"}, {"id": 73, "duration_s": 2.42, "emotion": "determined", "text": "ಇವತ್ತು ಮರ ಕಿತ್ತು ಹಾಕ್ತೀನಿ!"}, {"id": 74, "duration_s": 2.48, "emotion": "worried", "text": "ಮೂರು ಹೆಜ್ಜೆ! ಶೂ ಸವೆದ್ರೆ?"}, {"id": 75, "duration_s": 1.51, "emotion": "proud", "text": "ಇದು ನನ್ ತರಬೇತಿ!"}, {"id": 76, "duration_s": 1.34, "emotion": "calm", "text": "ನಂಗೆ ತರಬೇತಿ ಬೇಡ."}, {"id": 77, "duration_s": 1.81, "emotion": "tired", "text": "ಅಪ್ಪಾಜಿ, ಯಾವ ಪೌಡರ್ ತಿಂತೀರ?"}, {"id": 78, "duration_s": 0.79, "emotion": "calm", "text": "ರೊಟ್ಟಿ."}, {"id": 79, "duration_s": 0.9, "emotion": "stern_warning", "text": "ರೊಟ್ಟಿ ತಿನ್ನಿ!"}, {"id": 80, "duration_s": 1.91, "emotion": "proud", "text": "ಸುಲ್ತಾನ್ ರೊಟ್ಟಿ ತಿನ್ನಲ್ಲ!"}, {"id": 81, "duration_s": 1.82, "emotion": "curious", "text": "ಆರು ದಿನ ಆಯ್ತು. ಮಸಲ್?"}, {"id": 82, "duration_s": 2.31, "emotion": "sarcastic", "text": "ಸುಮ್ನಿರು! ಒಳಗೆ ಬೆಳೀತಿದೆ."}, {"id": 83, "duration_s": 1.19, "emotion": "determined", "text": "ನನ್ ಅಪ್ಪ ಸುಲ್ತಾನ್!"}, {"id": 84, "duration_s": 3.13, "emotion": "excited", "text": "ಭಾನುವಾರ. ಕಾಲೋನಿಯ ಮಹಾ ಪಂದ್ಯ!"}, {"id": 85, "duration_s": 2.72, "emotion": "serious", "text": "ತನಿಖೆ! ಸಮೋಸಾದ್ದು!"}, {"id": 86, "duration_s": 1.98, "emotion": "excited", "text": "ಲೈವ್ ಇದೆ! ಮಹಾ ಪಂದ್ಯ!"}, {"id": 87, "duration_s": 3.92, "emotion": "proud", "text": "ಇವತ್ತು ಸುಲ್ತಾನ್ ದಿನ!"}, {"id": 88, "duration_s": 2.63, "emotion": "mischievous", "text": "ಗೆದ್ರೆ ಪೌಡರ್ ಮಾರಾಟ, ಸೋತ್ರೂ ಮಾರಾಟ!"}, {"id": 89, "duration_s": 2.31, "emotion": "calm", "text": "ದಾಸಪ್ಪ, ಹಿಂದೆ ಹಿಡ್ಕೊಳ್ಳಿ."}, {"id": 90, "duration_s": 2.24, "emotion": "sarcastic", "text": "ಹಿಡ್ದೆ. ದುಡಿಮೆ ಬಿಲ್ ಬೇರೆ."}, {"id": 91, "duration_s": 3.22, "emotion": "excited", "text": "ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ! ಶಿವಣ್ಣ ತಂಡಕ್ಕೆ ಜೈ!"}, {"id": 92, "duration_s": 8.47, "emotion": "serious", "text": "ದೃಷ್ಟಿ ಆಗದಿರ್ಲಿ! ಹಗ್ಗ ಈಗ ಪವಿತ್ರ."}, {"id": 93, "duration_s": 3.3, "emotion": "shouting", "text": "ತಯಾರ್... ಎಳೀರಿ!"}, {"id": 94, "duration_s": 4.895, "emotion": "determined", "text": "ಪೂರ್ತಿ... ಜೋರು... ಹಾಕಿ!"}, {"id": 95, "duration_s": 2.31, "emotion": "curious", "text": "ದಾಸಪ್ಪ, ಶುರು ಯಾವಾಗ?"}, {"id": 96, "duration_s": 2.98, "emotion": "comic_panic", "text": "ಟೆನ್ಷನ್ ಬೇಡ... ಅಯ್ಯೋ... ಟೆನ್ಷನ್ ಮಾಡ್ಕೊಳ್ಳಿ!"}, {"id": 97, "duration_s": 2.19, "emotion": "tired", "text": "ದಾಸಪ್ಪ, ಚಹಾ ತಣ್ಣಗಾಗ್ತಿದೆ."}, {"id": 98, "duration_s": 2.15, "emotion": "laughing", "text": "ಸ್ಲೋ ಮೋಷನ್‌ನಲ್ಲಿ ಮತ್ತೊಮ್ಮೆ!"}, {"id": 99, "duration_s": 2.9, "emotion": "embarrassed", "text": "ನಂಗ್ಯಾರ ಭಯ... ಇಲ್ಲ."}, {"id": 100, "duration_s": 2.3, "emotion": "curious", "text": "ಅಪ್ಪಾ, ಪೌಡರ್ ಒಳಗೆ ಬೆಳೀತಿತ್ತಾ?"}, {"id": 101, "duration_s": 3.621, "emotion": "shocked", "text": "ಅಯ್ಯೋ ರಾಮ! ದೃಷ್ಟಿ ಆಯ್ತು!"}, {"id": 102, "duration_s": 3.2, "emotion": "embarrassed", "text": "ಅಯ್ಯೋ! ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಬಿಡ್ತು!"}, {"id": 103, "duration_s": 3.27, "emotion": "excited", "text": "ಗೆದ್ವಿ! ಈಗ ಪೌಡರ್ ಬೆಲೆ ಡಬಲ್!"}, {"id": 104, "duration_s": 2.12, "emotion": "happy", "text": "ಗೆಲುವಿನ ಸಿಹಿ!"}, {"id": 105, "duration_s": 4.86, "emotion": "tired", "text": "ದಾಸಪ್ಪ ತಂಡ ಗೆದ್ದಿತು! ವಿಚಾರಣೆ... ಮುಗಿದಿದೆ..."}, {"id": 106, "duration_s": 3.3, "emotion": "excited", "text": "ಹತ್ತು ಲಕ್ಷ ವ್ಯೂಸ್! ಸುಲ್ತಾನ್ ವೈರಲ್!"}, {"id": 107, "duration_s": 2.24, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ? ಅಮೆರಿಕದವರೂ ನೋಡ್ತಿದ್ದಾರೆ!"}, {"id": 108, "duration_s": 2.1, "emotion": "sad", "text": "ಇನ್ನು ನನ್ನ ಯಾರೂ ನೋಡಲ್ಲ."}, {"id": 109, "duration_s": 1.74, "emotion": "curious", "text": "ಅಪ್ಪಾ? ಒಳಗಿದ್ದೀಯಾ?"}, {"id": 110, "duration_s": 0.46, "emotion": "sad", "text": "ಇಲ್ಲ."}, {"id": 111, "duration_s": 1.25, "emotion": "sarcastic", "text": "ಊಟ ಬಕೆಟ್‌ಗೆ ಕಳಿಸ್ಲಾ?"}, {"id": 112, "duration_s": 1.63, "emotion": "determined", "text": "ರೊಟ್ಟಿ ಬೇಡ... ಪೌಡರ್!"}, {"id": 113, "duration_s": 0.78, "emotion": "proud", "text": "ನಾನ್ ಹೇಳ್ಲಾ?"}, {"id": 114, "duration_s": 4.62, "emotion": "serious", "text": "ಕಂಪನಿ ವಿಳಾಸ? ಇಲ್ಲ. ಲೈಸೆನ್ಸ್? ಇಲ್ಲ."}, {"id": 115, "duration_s": 2.72, "emotion": "sarcastic", "text": "ಎಲ್ಲಾ ರಿವ್ಯೂ... ಒಬ್ಬನೇ ಮನುಷ್ಯನದ್ದು!"}, {"id": 116, "duration_s": 1.91, "emotion": "angry", "text": "ಅಂದ್ರೆ... ಎಲ್ಲಾ ಮೋಸ!"}, {"id": 117, "duration_s": 3.2, "emotion": "guilty", "text": "ಐಡಿಯಾ ನಂದೇ... ಅಪ್ಪಂಗೆ ಹೇಳ್ಲೇಬೇಕು."}, {"id": 118, "duration_s": 5.06, "emotion": "sad", "text": "ಐವತ್ತು ಡಬ್ಬ. ಗ್ರಾಹಕರು... ಸೊನ್ನೆ."}, {"id": 119, "duration_s": 1.71, "emotion": "happy", "text": "ಟೆನ್ಷನ್ ಬೇಡ, ದಾಸಪ್ಪ!"}, {"id": 120, "duration_s": 1.7, "emotion": "angry", "text": "ಟೆನ್ಷನ್ ಕೊಟ್ಟಿದ್ದೇ ನೀನು!"}, {"id": 121, "duration_s": 3.91, "emotion": "proud", "text": "ಮಕ್ಕಳು ಸಾಬೀತು ಮಾಡಿದ್ರು! ಸೈನ್ಸ್... ಸುಣ್ಣ!"}, {"id": 122, "duration_s": 2.4, "emotion": "tired", "text": "ಹೌದು ಗ್ಞಾನಿ, ನೀನೇ ಸರಿ."}, {"id": 123, "duration_s": 3.98, "emotion": "shocked", "text": "ನಾನು... ಸರಿ? ಮೊದಲ ಸಲ?"}, {"id": 124, "duration_s": 3.62, "emotion": "happy", "text": "ಒಳ್ಳೇ ಸೀಮೆಸುಣ್ಣ! ಬ್ಲ್ಯಾಕ್‌ಬೋರ್ಡಿಗೆ ಎಲ್ಲಾ ತಗೊಂಡು ಹೋಗ್ತೀನಿ."}, {"id": 125, "duration_s": 1.75, "emotion": "pleading", "text": "ಎಷ್ಟು ಕೊಡ್ತೀರಿ?"}, {"id": 126, "duration_s": 0.96, "emotion": "loving", "text": "ಆಶೀರ್ವಾದ."}, {"id": 127, "duration_s": 3.48, "emotion": "determined", "text": "ನಕಲಿ ಜಾಹೀರಾತು... ರಿಪೋರ್ಟ್! ಬ್ಲಾಕ್!"}, {"id": 128, "duration_s": 2.28, "emotion": "embarrassed", "text": "ಸಾವ್ರಕ್ಕೊಂದ್ಕಮ್ಮಿ... ಸುಣ್ಣಕ್ಕೆ."}, {"id": 129, "duration_s": 4.8, "emotion": "calm", "text": "ಶಿವಣ್ಣ, ಏಳೇ ದಿನಕ್ಕೆ ಬಾಡಿ ಕೊಡೋ ಡಬ್ಬ..."}, {"id": 130, "duration_s": 2.49, "emotion": "sarcastic", "text": "...ಏಳೇ ದಿನಕ್ಕೆ ಜೇಬು ಖಾಲಿ ಮಾಡುತ್ತೆ."}, {"id": 131, "duration_s": 5.73, "emotion": "serious", "text": "ಕೈ ಕೆಸರಾದ್ರೆ ಬಾಯಿ ಮೊಸರು! ಬಾಡಿ ರೊಟ್ಟಿ, ಓಟದಿಂದ."}, {"id": 132, "duration_s": 4.09, "emotion": "determined", "text": "ವಿಳಾಸ, ಲೈಸೆನ್ಸ್, ನಿಜವಾದ ರಿವ್ಯೂ ನೋಡಿ!"}, {"id": 133, "duration_s": 1.78, "emotion": "happy", "text": "ಸುಲ್ತಾನ್... ರೊಟ್ಟಿ ತಿಂತಾನೆ!"}, {"id": 134, "duration_s": 2.241, "emotion": "tired", "text": "ಅಪ್ಪಾಜಿ... ಸ್ವಲ್ಪ ಮೆಲ್ಲಗೆ!"}, {"id": 135, "duration_s": 1.65, "emotion": "happy", "text": "ಹೊರಡೋಣ... ನಡೆದು!"}, {"id": 136, "duration_s": 1.48, "emotion": "happy", "text": "ದಾಸಪ್ಪ, ಬೇಗ!"}, {"id": 137, "duration_s": 2.89, "emotion": "happy", "text": "ಓಟ ಫ್ರೀ! ಬೆಸ್ಟ್ ಸ್ಕೀಮ್!"}, {"id": 138, "duration_s": 3.22, "emotion": "excited", "text": "ಟೆನ್ಷನ್ ಬೇಡ! ಸುಲ್ತಾನ್ ಹೇರ್ ಆಯಿಲ್! ಏಳು ದಿನಕ್ಕೆ ಕೂದಲು!"}, {"id": 139, "duration_s": 1.81, "emotion": "embarrassed", "text": "ಟೆನ್ಷನ್... ತಗೊಂಡೆ."}, {"id": 140, "duration_s": 2.05, "emotion": "excited", "text": "ಅಪ್ಪಾ! ನಿಜವಾದ ಮಸಲ್!"}]