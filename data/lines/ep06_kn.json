[{"id": 1, "duration_s": 5.21, "emotion": "calm", "text": "ಇದು ನಮ್ ಕಾಲೋನಿ. ಶಾಂತ, ಸುಂದರ, ಸುರಕ್ಷಿತ..."}, {"id": 2, "duration_s": 3.03, "emotion": "excited", "text": "ಮತ್ತೆ ಇವರೇ... ಕಾಲೋನಿಯ ಹೊಸ ರಾಜ!"}, {"id": 3, "duration_s": 3.01, "emotion": "proud", "text": "ರಾಜ? ಈ ಕಾಲೋನಿ ರಾಜ ನಾನು!"}, {"id": 4, "duration_s": 0.69, "emotion": "sarcastic", "text": "ತಪ್ಪು ಉತ್ತರ."}, {"id": 5, "duration_s": 3.62, "emotion": "proud", "text": "ರಾಣಿ ನಾನು! ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ!"}, {"id": 6, "duration_s": 1.0, "emotion": "sarcastic", "text": "ಮತ್ತೆ ತಪ್ಪು."}, {"id": 7, "duration_s": 3.54, "emotion": "proud", "text": "ರಾಣಿ ಗೀಣಿ ಬಿಡಿ. ಫಾಲೋವರ್ಸ್ ನಂದೇ ಜಾಸ್ತಿ!"}, {"id": 8, "duration_s": 4.16, "emotion": "mischievous", "text": "ಮೂರೂ ತಪ್ಪು. ಇದೆಲ್ಲ ಶುರುವಾಗಿದ್ದು ನಿನ್ನೆ ಸಂಜೆ..."}, {"id": 9, "duration_s": 1.73, "emotion": "mischievous", "text": "...ಒಂದೇ ಬಾಳೆಯಿಂದ."}, {"id": 10, "duration_s": 3.67, "emotion": "calm", "text": "ಆ ಸಂಜೆ ಕಾಲೋನಿಗೆ ಒಂದೇ ಮಂಗ ಬಂತು."}, {"id": 11, "duration_s": 3.04, "emotion": "excited", "text": "ಅರೆ! ಮಂಗ ಬಂತು! ಭಾರೀ ಶುಭ!"}, {"id": 12, "duration_s": 3.49, "emotion": "loving", "text": "ತಗೋ ಕಂದ, ಬಾಳೆಹಣ್ಣು ತಿನ್ನು. ದೃಷ್ಟಿ ಆಗಲ್ಲ."}, {"id": 13, "duration_s": 3.24, "emotion": "excited", "text": "ಮಂಗ! ನಿಜವಾದ ಮಂಗ! ನಮ್ ಕಾಲೋನಿಲಿ!"}, {"id": 14, "duration_s": 3.84, "emotion": "excited", "text": "ನಂಗೊಂದು ಐಡಿಯಾ! ಸಾಕೋಣ! ಹೆಸರು... ಮಂಗಣ್ಣ!"}, {"id": 15, "duration_s": 4.79, "emotion": "worried", "text": "ಸಾಕ್ತೀರಾ? ಏನ್ ತಿನ್ಸ್ತೀರ? ನನ್ ಚಿಪ್ಸ್ ಅಲ್ಲ!"}, {"id": 16, "duration_s": 3.55, "emotion": "serious", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಮಂಗ ಕಾಡು ಪ್ರಾಣಿ, ಸಾಕು ಪ್ರಾಣಿ ಅಲ್ಲ."}, {"id": 17, "duration_s": 3.18, "emotion": "stern_warning", "text": "ಸುಮ್ನಿರು! ಮಂಗಣ್ಣ ನಮ್ ಫ್ರೆಂಡ್."}, {"id": 18, "duration_s": 2.43, "emotion": "sarcastic", "text": "ಸರಿ. ನಾನ್ ಬರ್ಕೊಳ್ತಿದೀನಿ."}, {"id": 19, "duration_s": 3.03, "emotion": "happy", "text": "ದಿನಾ ತಿನ್ಸೋಣ. ಲಕ್ಕಿ ಮಂಗ!"}, {"id": 20, "duration_s": 3.62, "emotion": "mischievous", "text": "ಮಂಗಣ್ಣ ತಿಂದ... ಮನೆಗೆ ಫೋನ್ ಮಾಡ್ಬಿಟ್ಟ."}, {"id": 21, "duration_s": 2.36, "emotion": "mischievous", "text": "ಇಡೀ ಮನೆತನಕ್ಕೆ."}, {"id": 22, "duration_s": 3.26, "emotion": "calm", "text": "ಶುಭ... ಶುಭ... ಭಾರೀ ಶುಭ..."}, {"id": 23, "duration_s": 4.48, "emotion": "mischievous", "text": "ಮರುದಿನ ಬೆಳಗ್ಗೆ... ಒಂದು ಮಂಗ, ಇಪ್ಪತ್ತು ಮಂಗ!"}, {"id": 24, "duration_s": 3.91, "emotion": "excited", "text": "ಇಷ್ಟೊಂದು? ಅಬ್ಬಾ! ಇಷ್ಟೊಂದು ಅದೃಷ್ಟ!"}, {"id": 25, "duration_s": 4.11, "emotion": "proud", "text": "ವಿಜ್ಞಾನ ಹೇಳುತ್ತೆ, ಮಂಗಗಳಿಗೆ ಮನುಷ್ಯರಂದ್ರೆ ಭಯ."}, {"id": 26, "duration_s": 3.09, "emotion": "serious", "text": "ನೋಡಿ ಸ್ವಾಮಿ, ವಿಜ್ಞಾನ ಹೇಳುತ್ತೆ, ಹೆದರ್ಬೇಡಿ."}, {"id": 27, "duration_s": 4.19, "emotion": "loving", "text": "ನೀವು ತುಂಬಾ ಎತ್ತರ, ತುಂಬಾ ಸಪೂರ. ಏನಾದ್ರೂ ತಿನ್ನಿ!"}, {"id": 28, "duration_s": 3.77, "emotion": "happy", "text": "ಹಸಿವಾಗಿದೆ! ಆಲೂ ಪರೋಟ, ಪೂರ್ತಿ ನಾಲ್ಕು!"}, {"id": 29, "duration_s": 4.81, "emotion": "shocked", "text": "ನನಗಿಂತ ಫಾಸ್ಟ್? ನನಗಿಂತ?! ಇದು ಅವಮಾನ!"}, {"id": 30, "duration_s": 4.61, "emotion": "stern_warning", "text": "ಅಗಿದು ತಿನ್ನು! ಮೂವತ್ತೆರಡು ಸಲ! ಶಿಷ್ಟಾಚಾರ ಅಂತ..."}, {"id": 31, "duration_s": 4.78, "emotion": "laughing", "text": "ಹ ಹ ಹ! ನಗ್ಬೇಡ ಬೊಂಡ... ಅಯ್ಯೋ! ನನ್ ಸಾಕ್ಸ್!"}, {"id": 32, "duration_s": 4.11, "emotion": "worried", "text": "ನಿನ್ನೆ ಒಂದು. ಇವತ್ತು ಇಪ್ಪತ್ತೇಳು. ನಾಳೆ ಎಷ್ಟು?"}, {"id": 33, "duration_s": 2.42, "emotion": "happy", "text": "ಇಪ್ಪತ್ತೇಳು ಪಟ್ಟು ಶುಭ!"}, {"id": 34, "duration_s": 3.25, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ ಸುದ್ದಿ? ಕಾಲೋನಿಗೆ ಮಂಗ ಬಂದಿವೆ!"}, {"id": 35, "duration_s": 3.08, "emotion": "excited", "text": "ಗ್ನಾನಿ ಕನ್ನಡಕ ಹೋಯ್ತು, ಬೊಂಡನ ಡಬ್ಬಿ ಹೋಯ್ತು..."}, {"id": 36, "duration_s": 2.66, "emotion": "proud", "text": "...ಆದ್ರೆ ನಂದು? ನಂದೇನೂ ಹೋಗಲ್ಲ!"}, {"id": 37, "duration_s": 3.464, "emotion": "shocked", "text": "ಅಯ್ಯೋ! ನನ್ ಫೋನ್!"}, {"id": 38, "duration_s": 2.58, "emotion": "laughing", "text": "ಆಂಟಿ, ಅವ್ನು ನಿಮಗಿಂತ ಚೆನ್ನಾಗಿ ಗಾಸಿಪ್ ಮಾಡ್ತಾನೆ!"}, {"id": 39, "duration_s": 2.4, "emotion": "angry", "text": "ನಗ್ಬೇಡಿ! ಅದ್ರಲ್ಲಿ ನನ್ ಮುನ್ನೂರು ಗ್ರೂಪ್ ಇದೆ!"}, {"id": 40, "duration_s": 1.69, "emotion": "determined", "text": "ನಡಿ, ಹೋಗೋಣ! ಫೋನ್ ವಾಪಸ್ ತರೋಣ!"}, {"id": 41, "duration_s": 4.61, "emotion": "tired", "text": "ಅಯ್ಯೋ... ಅರ್ಜೆಂಟ್ ಇದ್ದಾಗ್ಲೇ... ಪ್ರತಿ ಸಲ!"}, {"id": 42, "duration_s": 7.7, "emotion": "serious", "text": "ಒಂದು, ಎರಡು, ಮೂರು... ಒಂದ್ ಬಾಳೆಹಣ್ಣೂ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 43, "duration_s": 5.46, "emotion": "shocked", "text": "ಎಣಿಸು... ಒಂದು... ಎರಡು... ಮಾಯ!"}, {"id": 44, "duration_s": 2.1, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪ! ನಮ್ ಅಕ್ಕಿ!"}, {"id": 45, "duration_s": 3.739, "emotion": "stern_warning", "text": "ಕೈ ಹಾಕಿ ತೋರ್ಸು ನೋಡೋಣ!"}, {"id": 46, "duration_s": 3.13, "emotion": "relieved", "text": "ಮಂಗಕ್ಕೂ ಇವಳಂದ್ರೆ ಭಯ. ನಾನೊಬ್ನೇ ಅಲ್ಲ!"}, {"id": 47, "duration_s": 3.15, "emotion": "excited", "text": "ಹಲೋ ಫ್ರೆಂಡ್ಸ್! ಲೈವ್ ನಡೀತಿದೆ! ಮಂಗ ಸ್ಪೆಷಲ್!"}, {"id": 48, "duration_s": 2.94, "emotion": "happy", "text": "ನೋಡಿ, ನನ್ ಫ್ಯಾನ್ಸ್! ಹಾಯ್ ಮಂಕಿ!"}, {"id": 49, "duration_s": 2.71, "emotion": "comic_panic", "text": "ನನ್ ಲೈವ್! ನನ್ ರಿಂಗ್ ಲೈಟ್! ನನ್ ಕರಿಯರ್!"}, {"id": 50, "duration_s": 2.9, "emotion": "angry", "text": "ಮಂಗನ ಲೈವ್‌ಗೆ... ಹತ್ತು ಲಕ್ಷ ಜನ!"}, {"id": 51, "duration_s": 6.366, "emotion": "sarcastic", "text": "ಆ ಬೆಳಗ್ಗೆ ಕಾಲೋನಿಯ ದೊಡ್ಡ ಇನ್‌ಫ್ಲುಯೆನ್ಸರ್... ಮಂಗ."}, {"id": 52, "duration_s": 1.47, "emotion": "embarrassed", "text": "...ನಾನೂ ಫಾಲೋ ಮಾಡ್ದೆ."}, {"id": 53, "duration_s": 3.42, "emotion": "mischievous", "text": "ಮಧ್ಯಾಹ್ನಕ್ಕೆ ಕಾಲೋನಿಯ ತುರ್ತು ಮೀಟಿಂಗ್ ಶುರು."}, {"id": 54, "duration_s": 2.66, "emotion": "stern_warning", "text": "ಶಾಂತಿ! ಒಬ್ಬೊಬ್ರಾಗಿ! ಕೈ ಎತ್ತಿ!"}, {"id": 55, "duration_s": 2.36, "emotion": "sarcastic", "text": "ನೀವು ಈ ಕಾಲೋನಿ ಸದಸ್ಯರಲ್ಲ!"}, {"id": 56, "duration_s": 2.96, "emotion": "proud", "text": "ನಾನ್ಯಾರಿಗೂ ಹೆದರಲ್ಲ! ಮಂಗ ನಾನ್ ಹಿಡೀತೀನಿ!"}, {"id": 57, "duration_s": 3.126, "emotion": "sarcastic", "text": "ಹಲ್ಲಿಗೆ ಹೆದರ್ತೀರ, ಮಂಗ ಹಿಡೀತೀರ?"}, {"id": 58, "duration_s": 3.19, "emotion": "embarrassed", "text": "ನಾನು... ಕಂಬ ಗಟ್ಟಿ ಇದ್ಯಾ ಅಂತ ಚೆಕ್ ಮಾಡ್ತಿದ್ದೆ."}, {"id": 59, "duration_s": 3.78, "emotion": "serious", "text": "ದೃಷ್ಟಿ ಆಯ್ತು! ಪ್ರತಿ ಮನೆಗೂ ನಿಂಬೆ-ಮೆಣಸು!"}, {"id": 60, "duration_s": 3.18, "emotion": "proud", "text": "ನನ್ ಲಡ್ಡುಗಳನ್ನ ಯಾರಾದ್ರೂ ಮುಟ್ಟಿ ನೋಡ್ಲಿ!"}, {"id": 61, "duration_s": 2.82, "emotion": "scared_whisper", "text": "ಕೇಳ್ದೆ, ಮಂಗ ಸಿಹಿ ವಾಸನೆ ಹಿಡೀತವಂತೆ..."}, {"id": 62, "duration_s": 2.95, "emotion": "serious", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ಮಂಗ ಯಾಕ್ ಬರ್ತಿವೆ ಅಂದ್ರೆ..."}, {"id": 63, "duration_s": 2.506, "emotion": "serious", "text": "ಮಕ್ಕಳು ಮಧ್ಯ ಮಾತಾಡ್ಬೇಡಿ! ದೊಡ್ಡವರ ಮೀಟಿಂಗ್!"}, {"id": 64, "duration_s": 1.87, "emotion": "stern_warning", "text": "ಸುಮ್ನಿರಿ! ಅಣ್ಣ ಹೇಳ್ತಾನೆ..."}, {"id": 65, "duration_s": 2.977, "emotion": "excited", "text": "ಟೆನ್ಶನ್ ಬೇಡ! ಪ್ಲಾನ್ ರೆಡಿ!"}, {"id": 66, "duration_s": 4.04, "emotion": "sad", "text": "ಹ್ಞೂಂ... ದೊಡ್ಡವರ ಮೀಟಿಂಗ್. ಮಕ್ಕಳ ಮಾತು... ನಾಳೆ."}, {"id": 67, "duration_s": 5.34, "emotion": "proud", "text": "ನೋಡಿ ವಿಜ್ಞಾನ! ಹಣ್ಣು ಒಳಗೆ, ಮಂಗ ಒಳಗೆ, ಢಮಾರ್!"}, {"id": 68, "duration_s": 2.66, "emotion": "worried", "text": "ಅಪ್ಪಾ, ಮಂಗ ಮರದ ಮೇಲಿದೆ..."}, {"id": 69, "duration_s": 2.68, "emotion": "determined", "text": "ಬಾಳೆಹಣ್ಣು ಸ್ವಲ್ಪ ನೇರ ಮಾಡ್ತೀನಿ..."}, {"id": 70, "duration_s": 2.49, "emotion": "comic_panic", "text": "ನಾನ್ಯಾರಿಗೂ ಹೆದರಲ್ಲ... ಹೊರಗೆ ತೆಗೀರಿ!"}, {"id": 71, "duration_s": 3.0, "emotion": "worried", "text": "ಅಂಕಲ್ ಸರಿನಾ? ಹಣ್ಣು ಸರಿನಾ?"}, {"id": 72, "duration_s": 2.49, "emotion": "determined", "text": "ಸಾಕು! ಈಗ ನಾನ್ ನೋಡ್ಕೊಳ್ತೀನಿ."}, {"id": 73, "duration_s": 3.61, "emotion": "proud", "text": "ನಾನೇ ಬೇಕಂತ ಬಿಟ್ಟೆ. ಪಾಪ ಅನ್ನಿಸ್ತು."}, {"id": 74, "duration_s": 2.2, "emotion": "proud", "text": "ಟೆನ್ಶನ್ ಬೇಡ! ಲಂಗೂರ್ ಬಂದ!"}, {"id": 75, "duration_s": 4.42, "emotion": "curious", "text": "ಚಿಕ್ಕಪ್ಪ, ನೀವು... ದೊಡ್ಡ ಮಂಗ ಥರ ಕಾಣ್ತಿದ್ದೀರ."}, {"id": 76, "duration_s": 3.53, "emotion": "proud", "text": "ಅದೇ ಪ್ಲಾನ್! ಮಂಗ ಲಂಗೂರ್‌ಗೆ ಹೆದರ್ತವೆ!"}, {"id": 77, "duration_s": 2.01, "emotion": "shouting", "text": "ಹೂ-ಹೂ-ಹಾ-ಹಾ! ಓಡಿ ಎಲ್ರೂ!"}, {"id": 78, "duration_s": 1.68, "emotion": "surprised", "text": "ಅರೆ? ಇವು ಬಾಗ್ತಿವೆ?"}, {"id": 79, "duration_s": 3.9, "emotion": "proud", "text": "ನಾನೇ ಇವುಗಳ ರಾಜ! ಸೀನ ಮಹಾರಾಜ!"}, {"id": 80, "duration_s": 2.29, "emotion": "giggly", "text": "ಹ ಹ! ಕಚಗುಳಿ! ನನ್ಗೆ ಹೇನಿಲ್ಲ!"}, {"id": 81, "duration_s": 3.05, "emotion": "excited", "text": "ಕೇಳಿದ್ರಾ ಸುದ್ದಿ? ಸೀನ ಮಂಗಗಳ ನಾಯಕ ಆದ!"}, {"id": 82, "duration_s": 2.51, "emotion": "stern_warning", "text": "ಹೊರಗೆ! ನಿನ್ನ ಇಡೀ ಸೇನೆ ಜೊತೆ!"}, {"id": 83, "duration_s": 2.52, "emotion": "tired", "text": "ಅಬ್ಬಾ... ಟೆನ್ಶನ್... ಸ್ವಲ್ಪ ಇದೆ."}, {"id": 84, "duration_s": 3.95, "emotion": "stern_warning", "text": "ತನಿಖೆ ಆಗುತ್ತೆ! ಇಡೀ ಕಾಲೋನಿಗೆ!"}, {"id": 85, "duration_s": 2.45, "emotion": "sarcastic", "text": "ತನಿಖೆ ಶುರು. ಎರಡು ನಿಮ್ಷಕ್ಕೆ..."}, {"id": 86, "duration_s": 5.93, "emotion": "excited", "text": "ಸಮೋಸ? ತನಿಖೆ!"}, {"id": 87, "duration_s": 3.018, "emotion": "shocked", "text": "ಜೈ ಹಿಂದ್! ಅರೆ... ನನ್ ಟೋಪಿ!"}, {"id": 88, "duration_s": 4.37, "emotion": "comic_panic", "text": "ಹೆಡ್ ಆಫೀಸ್! ಮಂಗ ನನ್ ಟೋಪಿ ಅರೆಸ್ಟ್ ಮಾಡ್ಬಿಟ್ವು!"}, {"id": 89, "duration_s": 4.09, "emotion": "tender", "text": "ಅಂಕಲ್, ಅರ್ಧ ಸಮೋಸ. ಬರೀ ಅರ್ಧ."}, {"id": 90, "duration_s": 5.39, "emotion": "proud", "text": "ನನ್ ಕಡ್ಲೆಹಿಟ್ಟಿನ ಲಡ್ಡು! ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ಲಿ!"}, {"id": 91, "duration_s": 0.93, "emotion": "shocked", "text": "ಅಯ್ಯೋ! ನನ್ ಲಡ್ಡು!"}, {"id": 92, "duration_s": 1.76, "emotion": "determined", "text": "ಇವತ್ತು ನೀ ಉಳಿಯಲ್ಲ."}, {"id": 93, "duration_s": 4.603, "emotion": "excited", "text": "ಶುರುವಾಯ್ತು... ಕಾಲೋನಿ ಇತಿಹಾಸದ ಅತಿ ದೊಡ್ಡ ಓಟ!"}, {"id": 94, "duration_s": 3.392, "emotion": "excited", "text": "ಗೌರಮ್ಮ! ಗೌರಮ್ಮ!"}, {"id": 95, "duration_s": 1.03, "emotion": "excited", "text": "ಗೌರಮ್ಮ ವರ್ಸಸ್ ಮಂಗ! ಲೈವ್ ನಡೀತಿದೆ!"}, {"id": 96, "duration_s": 1.28, "emotion": "excited", "text": "ಭೇಷ್ ಗೌರಮ್ಮ!"}, {"id": 97, "duration_s": 2.83, "emotion": "shocked", "text": "ನಲವತ್ತು ಲಡ್ಡು... ನಾನೂರು ರೂಪಾಯಿ ಮಾಲು!"}, {"id": 98, "duration_s": 2.1, "emotion": "shocked", "text": "ಅಮ್ಮನ ಗುರಿ... ತಪ್ಪಿತಾ?"}, {"id": 99, "duration_s": 3.41, "emotion": "sad", "text": "ಮೊದಲ ಸಲ... ಜೀವನದಲ್ಲಿ ಮೊದಲ ಸಲ!"}, {"id": 100, "duration_s": 4.04, "emotion": "sarcastic", "text": "ಇಡೀ ಕಾಲೋನಿ ನೋಡ್ತು... ಗೌರಮ್ಮನ ಗುರಿ ತಪ್ಪೋದನ್ನ."}, {"id": 101, "duration_s": 3.46, "emotion": "stern_warning", "text": "ಸುಮ್ನಿರಿ! ಎಲ್ರೂ ಸುಮ್ನಿರಿ! ಈಗ ಅಣ್ಣ ಮಾತಾಡ್ತಾನೆ!"}, {"id": 102, "duration_s": 2.27, "emotion": "determined", "text": "ನಾನ್ ಹೇಳ್ಲಾ? ನನ್ ಜೊತೆ ಬನ್ನಿ."}, {"id": 103, "duration_s": 4.82, "emotion": "sarcastic", "text": "ಕಾಲೋನಿ ಹಿಂದೆ... ಮಂಗಗಳ ಫ್ರೀ ಹೋಟೆಲ್."}, {"id": 104, "duration_s": 1.11, "emotion": "angry", "text": "ಛೀ! ಈ ಕಸ ಯಾರದ್ದು?"}, {"id": 105, "duration_s": 1.85, "emotion": "embarrassed", "text": "...ಯಾರದ್ದೂ ಆಗಿರಬಹುದು."}, {"id": 106, "duration_s": 4.57, "emotion": "serious", "text": "ತೆರೆದ ಕಸ, ಜೊತೆಗೆ ದಿನಾ ಬಾಳೆಹಣ್ಣು... ಫ್ರೀ ಊಟ!"}, {"id": 107, "duration_s": 3.17, "emotion": "calm", "text": "ಫ್ರೀ ಊಟ ಇರೋ ಕಡೆ ಮಂಗ. ಸಿಂಪಲ್ ಲೆಕ್ಕ."}, {"id": 108, "duration_s": 3.46, "emotion": "proud", "text": "ವಿಜ್ಞಾನ ಹೇಳುತ್ತೆ, ಮಂಗಗಳಿಗೆ ನಮ್ಮೇಲೆ ಪ್ರೀತಿ!"}, {"id": 109, "duration_s": 4.18, "emotion": "sarcastic", "text": "ಅವಕ್ಕೆ ಊಟದ ಮೇಲೆ ಪ್ರೀತಿ. ನಿಮಗೆ ಕಸದ ಡಬ್ಬದ ಮೇಲೆ."}, {"id": 110, "duration_s": 3.88, "emotion": "serious", "text": "ತಿನ್ನಿಸಿದ್ರೆ ಭಯ ಹೋಗುತ್ತೆ. ಆಮೇಲೆ ಕಸಿದುಕೊಳ್ಳೋದು."}, {"id": 111, "duration_s": 3.97, "emotion": "serious", "text": "ನಮ್ ಚಿಪ್ಸ್-ಸಿಹಿ ತಿಂದು ಮಂಗಗಳಿಗೆ ಹುಷಾರೂ ತಪ್ಪುತ್ತೆ."}, {"id": 112, "duration_s": 3.555, "emotion": "guilty", "text": "ನಾನು... ಶುಭಕ್ಕೆ ಒಂದೇ ಬಾಳೆಹಣ್ಣು ಕೊಟ್ಟಿದ್ದೆ."}, {"id": 113, "duration_s": 2.93, "emotion": "guilty", "text": "ದಿನಾ ತಿನ್ಸೋ ಐಡಿಯಾ... ನಂದೇ."}, {"id": 114, "duration_s": 2.44, "emotion": "guilty", "text": "ನಾನು ಬರೀ... ಒಂದು ಚಿಪ್ಸ್."}, {"id": 115, "duration_s": 1.78, "emotion": "determined", "text": "ಸಾಕು! ನಾನ್ ನೋಡ್ತೀನಿ."}, {"id": 116, "duration_s": 0.89, "emotion": "shouting", "text": "ಪೊರಕೆ ತಾ!"}, {"id": 117, "duration_s": 4.6, "emotion": "tired", "text": "ಒಂದು ಪೊರಕೆ, ಎರಡು ಪೊರಕೆ... ಫ್ರೀ ಕೆಲಸ!"}, {"id": 118, "duration_s": 2.54, "emotion": "mischievous", "text": "ಇನ್ಮೇಲೆ ಬಾಳೆಹಣ್ಣು ನಂದೇ."}, {"id": 119, "duration_s": 5.18, "emotion": "calm", "text": "ಹಲೋ, ಅರಣ್ಯ ಇಲಾಖೆ? ಕಾಲೋನಿಲಿ ಮಂಗ ಇವೆ. ದಯವಿಟ್ಟು ಬನ್ನಿ."}, {"id": 120, "duration_s": 4.01, "emotion": "calm", "text": "ಫಿಕರ್ ಮಾಡ್ಬ್ಯಾಡ್ರಿ. ಟೀಮ್ ಆರಾಮಾಗಿ, ಸುರಕ್ಷಿತ ಕರಕೊಂಡು ಹೋಗ್ತೈತಿ."}, {"id": 121, "duration_s": 4.41, "emotion": "calm", "text": "ಹೊಡೀಬ್ಯಾಡ್ರಿ, ಹೆದರಿಸ್ಬ್ಯಾಡ್ರಿ, ತಿನ್ಸಬ್ಯಾಡ್ರಿ. ಪ್ರೀತಿಲೇ ಮಾತ್ರ."}, {"id": 122, "duration_s": 4.26, "emotion": "surprised", "text": "ಇವತ್ತು ಮೊದಲ ಸಲ... ರಾಜು ಆಟೋ ನಿಲ್ಲಲಿಲ್ಲ."}, {"id": 123, "duration_s": 1.9, "emotion": "happy", "text": "ಬಂದ್ವಿ ನೋಡು! ಈಗ ನೀ ಮಲಗು."}, {"id": 124, "duration_s": 2.62, "emotion": "proud", "text": "ಟೆನ್ಶನ್ ಬೇಡ! ಇವು ನನ್ ಮಾತು ಕೇಳ್ತವೆ!"}, {"id": 125, "duration_s": 4.07, "emotion": "happy", "text": "ಕೇಳಿದ್ರಾ ಸುದ್ದಿ? ಹ ಹ! ಮಂಗ ಫೋನ್ ವಾಪಸ್ ಕೊಟ್ಟಿತು!"}, {"id": 126, "duration_s": 4.77, "emotion": "proud", "text": "ವಿಚಾರಣೆ... ಮುಗೀತು!"}, {"id": 127, "duration_s": 3.93, "emotion": "embarrassed", "text": "ಓಹೋ... ನೀವು ಕಂಬ ಅಲ್ವಾ. ಕ್ಷಮಿಸಿ."}, {"id": 128, "duration_s": 2.89, "emotion": "excited", "text": "ಕೊಲ್ಯಾಬ್! ಪಲ್ಲವಿ ಅಂಡ್ ಮಂಕಿ!"}, {"id": 129, "duration_s": 2.7, "emotion": "stern_warning", "text": "ಮುಂದಿನ ಸಲ... ಗುರಿ ತಪ್ಪಲ್ಲ."}, {"id": 130, "duration_s": 2.7, "emotion": "tender", "text": "ಬಾಲ ಇಟ್ಕೋ... ನೆನಪಿಗೆ."}, {"id": 131, "duration_s": 3.74, "emotion": "tender", "text": "ಮಂಗಗಳು ಹೋದವು ತಮ್ಮ ಮನೆಗೆ... ಕಾಡಿಗೆ."}, {"id": 132, "duration_s": 3.65, "emotion": "curious", "text": "ಆದ್ರೆ ಅಜ್ಜ, ಮಂಗಕ್ಕೆ ಬಾಳೆಹಣ್ಣು ಕೊಡೋದು ಶುಭ ಅಲ್ವಾ?"}, {"id": 133, "duration_s": 3.03, "emotion": "calm", "text": "ಪ್ರಾಣಿಗೆ ತಿಂಡಿ ಕೊಡೋದು ಪ್ರೀತಿ ಅಲ್ಲ..."}, {"id": 134, "duration_s": 2.13, "emotion": "tender", "text": "...ಕಾಡನ್ನ ಕಾಡಾಗಿರಲು ಬಿಡಿ."}, {"id": 135, "duration_s": 3.67, "emotion": "serious", "text": "ಕಸ ಮುಚ್ಚಿಡಿ. ಮಂಗ ಕಂಡ್ರೆ ಅರಣ್ಯ ಇಲಾಖೆಗೆ ಫೋನ್."}, {"id": 136, "duration_s": 5.427, "emotion": "stern_warning", "text": "ಕೀಟಲೆನೂ ಮಾಡ್ಬೇಡಿ! ಗೊತ್ತಾಯ್ತಾ? ಸುಮ್ನಿರಿ!"}, {"id": 137, "duration_s": 2.62, "emotion": "giggly", "text": "ಶುಭ ಬಾಳೆಹಣ್ಣು... ನಂದೇ!"}, {"id": 138, "duration_s": 3.15, "emotion": "determined", "text": "ಈಗ ಪ್ರಾಕ್ಟೀಸ್! ಗುರಿ ವಾಪಸ್ ತರ್ಬೇಕು!"}, {"id": 139, "duration_s": 0.53, "emotion": "tired", "text": "ಅಮ್ಮಾ!"}, {"id": 140, "duration_s": 1.69, "emotion": "proud", "text": "ಗುರಿ ವಾಪಸ್!"}]