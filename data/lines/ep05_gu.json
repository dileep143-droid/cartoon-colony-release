[{"id": 1, "duration_s": 3.21, "emotion": "excited", "text": "સોસાયટીનો મહામુકાબલો... રસ્સાખેંચ!"}, {"id": 2, "duration_s": 3.36, "emotion": "proud", "text": "સાત દિવસનો પાઉડર! હું કોઈથી ના ડરું!"}, {"id": 3, "duration_s": 2.39, "emotion": "calm", "text": "ચીમન શેઠ, ચા ગરમ રાખજો."}, {"id": 4, "duration_s": 2.11, "emotion": "excited", "text": "લાઇવ ચાલે છે! સ્લો મોશન!"}, {"id": 5, "duration_s": 2.93, "emotion": "mischievous", "text": "આ બધું શરૂ થયું... એક ડબ્બાથી."}, {"id": 6, "duration_s": 3.49, "emotion": "happy", "text": "સાત દિવસ પહેલાં. સોસાયટીનું સ્પોર્ટ્સ વીક."}, {"id": 7, "duration_s": 4.04, "emotion": "excited", "text": "આ રવિવારે રસ્સાખેંચ! મહેતા પરિવાર સામે શેઠ પરિવાર!"}, {"id": 8, "duration_s": 2.73, "emotion": "proud", "text": "મહેતા જીતશે! હું કોઈથી ના ડરું!"}, {"id": 9, "duration_s": 6.07, "emotion": "sarcastic", "text": "હિસાબ માંડ્યો. મહેતાના જીતવાનો ચાન્સ... મીંડું!"}, {"id": 10, "duration_s": 1.69, "emotion": "sarcastic", "text": "કોઈથી નથી ડરતા, જયેશ?"}, {"id": 11, "duration_s": 4.0, "emotion": "comic_panic", "text": "કોઈથી નહીં! ગરોળી... છે જ નહીં!"}, {"id": 12, "duration_s": 2.25, "emotion": "stern_warning", "text": "ચૂપ! કાકા પાછા કૂદશે!"}, {"id": 13, "duration_s": 1.13, "emotion": "happy", "text": "ચાલો, જઈએ!"}, {"id": 14, "duration_s": 3.14, "emotion": "calm", "text": "ખસો, હું જોઉં."}, {"id": 15, "duration_s": 1.98, "emotion": "shocked", "text": "ભાભી, તમે તો ટ્રેક્ટર પણ ખેંચી લો!"}, {"id": 16, "duration_s": 1.14, "emotion": "excited", "text": "ટેન્શન ના લો, ભાઈ!"}, {"id": 17, "duration_s": 3.07, "emotion": "worried", "text": "ટેન્શન? એણે રિક્ષા ખેંચી લીધી, લાલા!"}, {"id": 18, "duration_s": 3.94, "emotion": "proud", "text": "મારો દીકરો જીતશે! આખી સોસાયટી જોશે!"}, {"id": 19, "duration_s": 3.91, "emotion": "mischievous", "text": "સાંભળ્યું કે? જયેશભાઈ ગરોળીથી હારી ગયા!"}, {"id": 20, "duration_s": 3.31, "emotion": "sad", "text": "ચિપ્સ ક્યાં ગઈ? ભૂખ લાગી છે!"}, {"id": 21, "duration_s": 3.79, "emotion": "excited", "text": "સુલતાન પાવર પાઉડર! સાત દાડામાં બોડી!"}, {"id": 22, "duration_s": 2.55, "emotion": "excited", "text": "ખાલી નવસો નવ્વાણું! ઝટ ડિલિવરી!"}, {"id": 23, "duration_s": 2.19, "emotion": "excited", "text": "એક આઇડિયા છે! પપ્પા માટે!"}, {"id": 24, "duration_s": 3.35, "emotion": "excited", "text": "પપ્પા! સાત દિવસે બોડી! રવિવાર પણ સાતે!"}, {"id": 25, "duration_s": 4.11, "emotion": "excited", "text": "સુલતાન... બોડી... સાત દિવસ!"}, {"id": 26, "duration_s": 2.92, "emotion": "sarcastic", "text": "સાત દિવસમાં તો આંબા ય ના પાકે!"}, {"id": 27, "duration_s": 2.48, "emotion": "proud", "text": "આ સાયન્સ છે, હેતલ! ઓર્ડર!"}, {"id": 28, "duration_s": 4.33, "emotion": "proud", "text": "મારો દીકરો સુલતાન બનશે! આખી સોસાયટી જોશે!"}, {"id": 29, "duration_s": 2.9, "emotion": "curious", "text": "પાઉડર ગળ્યો હશે? મને પણ જોઈએ."}, {"id": 30, "duration_s": 2.74, "emotion": "excited", "text": "સુલતાન પાવર પાઉડર! ઝટ ડિલિવરી, બાપુ!"}, {"id": 31, "duration_s": 1.99, "emotion": "loving", "text": "આવ્યો મારો સુલતાન!"}, {"id": 32, "duration_s": 4.28, "emotion": "mischievous", "text": "સાંભળ્યું કે? જયેશે ડબ્બામાં બોડી મંગાવી!"}, {"id": 33, "duration_s": 1.19, "emotion": "determined", "text": "આહ! તાકાત આવે છે!"}, {"id": 34, "duration_s": 2.2, "emotion": "curious", "text": "પપ્પા... મસલ ક્યાં છુપાયો?"}, {"id": 35, "duration_s": 2.43, "emotion": "excited", "text": "આવ્યો! એક વાળ ઊભો થયો!"}, {"id": 36, "duration_s": 2.62, "emotion": "shocked", "text": "સાંભળ્યું કે? મહેતાના બટન વરસે છે!"}, {"id": 37, "duration_s": 1.71, "emotion": "embarrassed", "text": "બોડી વધે છે, માસી!"}, {"id": 38, "duration_s": 1.14, "emotion": "shocked", "text": "અડધો ઇંચ..."}, {"id": 39, "duration_s": 0.62, "emotion": "shocked", "text": "...ઘટ્યો!"}, {"id": 40, "duration_s": 1.47, "emotion": "proud", "text": "અંદરથી વધે છે!"}, {"id": 41, "duration_s": 1.42, "emotion": "happy", "text": "સૂંઘવાથી પણ તાકાત આવે!"}, {"id": 42, "duration_s": 3.14, "emotion": "worried", "text": "જયેશ, નાકમાં ના નાખો!"}, {"id": 43, "duration_s": 0.637, "emotion": "comic_panic", "text": "આ... આ... આ..."}, {"id": 44, "duration_s": 2.11, "emotion": "proud", "text": "જોયું? પાઉડર બહારથી પણ કામ કરે!"}, {"id": 45, "duration_s": 1.82, "emotion": "determined", "text": "બસ! હવે હું જોઉં છું."}, {"id": 46, "duration_s": 4.01, "emotion": "shocked", "text": "હાય! મારો સુલતાન બરફનું પૂતળું!"}, {"id": 47, "duration_s": 2.06, "emotion": "serious", "text": "ઊભા રહો! સાયન્સ કહે છે..."}, {"id": 48, "duration_s": 4.33, "emotion": "proud", "text": "આ સો ટકા ચૉક છે!"}, {"id": 49, "duration_s": 5.293, "emotion": "laughing", "text": "<laugh> હોશિયાર હર્ષનું સાયન્સ? પાક્કું ખોટું!"}, {"id": 50, "duration_s": 6.21, "emotion": "giggly", "text": "હર્ષે કહ્યું હતું, વાદળ સિલિન્ડરથી બને!"}, {"id": 51, "duration_s": 2.35, "emotion": "giggly", "text": "અને મરઘી દૂધ આપે!"}, {"id": 52, "duration_s": 1.91, "emotion": "laughing", "text": "અને ચંદ્ર પર ચાની લારી છે!"}, {"id": 53, "duration_s": 1.23, "emotion": "pleading", "text": "પણ આ વખતે સાચે!"}, {"id": 54, "duration_s": 2.06, "emotion": "serious", "text": "મારા સુલતાનને નજર ના લાગે!"}, {"id": 55, "duration_s": 2.29, "emotion": "proud", "text": "સુલતાન રવિવારે દેખાશે!"}, {"id": 56, "duration_s": 3.7, "emotion": "sad", "text": "જુઓ... લખે પણ છે. કોઈ જોતું જ નથી."}, {"id": 57, "duration_s": 2.7, "emotion": "excited", "text": "ટેન્શન ના લો! આ તો સોનાની ખાણ છે!"}, {"id": 58, "duration_s": 1.96, "emotion": "mischievous", "text": "સોમાં લો, બસોમાં વેચો!"}, {"id": 59, "duration_s": 2.18, "emotion": "mischievous", "text": "ચીમન શેઠ, ડીલરશીપ! પચાસ ડબ્બા!"}, {"id": 60, "duration_s": 4.39, "emotion": "curious", "text": "પચાસ સુલતાન? હિસાબ માંડું છું."}, {"id": 61, "duration_s": 4.69, "emotion": "serious", "text": "પાંચ હજાર. બે વાર ગણ્યા... ત્રીજી વાર પણ."}, {"id": 62, "duration_s": 1.45, "emotion": "pleading", "text": "એક રૂપિયો ઓછો નહીં!"}, {"id": 63, "duration_s": 1.14, "emotion": "stern_warning", "text": "ચીમન શેઠ!"}, {"id": 64, "duration_s": 4.21, "emotion": "embarrassed", "text": "હંસા, આ બિઝનેસ છે! બમણો નફો!"}, {"id": 65, "duration_s": 1.23, "emotion": "sarcastic", "text": "કે બમણી ખોટ?"}, {"id": 66, "duration_s": 3.17, "emotion": "proud", "text": "પચાસ ડબ્બા! આખી સોસાયટી સુલતાન બનશે!"}, {"id": 67, "duration_s": 3.14, "emotion": "happy", "text": "મેં કંઈ નથી ખાધું."}, {"id": 68, "duration_s": 2.72, "emotion": "surprised", "text": "આ ગળ્યું નથી... ચૉક છે!"}, {"id": 69, "duration_s": 1.5, "emotion": "shouting", "text": "ચૂપ! બિઝનેસ છે!"}, {"id": 70, "duration_s": 2.86, "emotion": "mischievous", "text": "ટ્રેનિંગ વીક. કોચ છે... લાલો."}, {"id": 71, "duration_s": 2.8, "emotion": "proud", "text": "કોચ લાલો! તમે દોડો, હું ગણું છું."}, {"id": 72, "duration_s": 2.1, "emotion": "proud", "text": "દોડવું શું કામ? પાઉડર છે ને!"}, {"id": 73, "duration_s": 2.33, "emotion": "determined", "text": "આજે તો ઝાડ ઉખાડીને જ રહીશ!"}, {"id": 74, "duration_s": 3.17, "emotion": "worried", "text": "ત્રણ ડગલાં! ચંપલ ઘસાઈ ગયાં તો?"}, {"id": 75, "duration_s": 1.47, "emotion": "proud", "text": "આ મારી ટ્રેનિંગ છે!"}, {"id": 76, "duration_s": 2.12, "emotion": "calm", "text": "મારે ટ્રેનિંગની જરૂર નથી."}, {"id": 77, "duration_s": 2.32, "emotion": "tired", "text": "બાપુજી, કયો પાઉડર લો છો?"}, {"id": 78, "duration_s": 0.87, "emotion": "calm", "text": "રોટલી."}, {"id": 79, "duration_s": 0.92, "emotion": "stern_warning", "text": "રોટલી ખા!"}, {"id": 80, "duration_s": 1.91, "emotion": "proud", "text": "સુલતાન રોટલી ના ખાય!"}, {"id": 81, "duration_s": 2.71, "emotion": "curious", "text": "છ દિવસ થયા. મસલ?"}, {"id": 82, "duration_s": 2.25, "emotion": "sarcastic", "text": "ચૂપ! અંદરથી વધે છે."}, {"id": 83, "duration_s": 1.71, "emotion": "determined", "text": "મારા પપ્પા સુલતાન છે!"}, {"id": 84, "duration_s": 3.06, "emotion": "excited", "text": "રવિવાર. સોસાયટીનો મહામુકાબલો!"}, {"id": 85, "duration_s": 1.32, "emotion": "serious", "text": "તપાસ થશે! સમોસાની."}, {"id": 86, "duration_s": 3.69, "emotion": "excited", "text": "લાઇવ ચાલે છે! મહામુકાબલો!"}, {"id": 87, "duration_s": 1.95, "emotion": "proud", "text": "આજે સુલતાનનો દિવસ છે!"}, {"id": 88, "duration_s": 4.94, "emotion": "mischievous", "text": "જીતીએ તો પાઉડર વેચાશે, હારીએ તોય!"}, {"id": 89, "duration_s": 2.09, "emotion": "calm", "text": "શેઠ, પાછળથી પકડજો."}, {"id": 90, "duration_s": 2.31, "emotion": "sarcastic", "text": "પકડ્યું. મહેનતનું બિલ અલગ."}, {"id": 91, "duration_s": 3.62, "emotion": "excited", "text": "આખી સોસાયટી જોશે! મહેતા ઝિંદાબાદ!"}, {"id": 92, "duration_s": 4.32, "emotion": "serious", "text": "નજર ના લાગે! હવે દોરડું પવિત્ર છે."}, {"id": 93, "duration_s": 3.47, "emotion": "shouting", "text": "તૈયાર... ખેંચો!"}, {"id": 94, "duration_s": 4.72, "emotion": "determined", "text": "પૂરું... જોર... લગાવો!"}, {"id": 95, "duration_s": 3.08, "emotion": "curious", "text": "શેઠ, શરૂ ક્યારે થશે?"}, {"id": 96, "duration_s": 2.31, "emotion": "comic_panic", "text": "ટેન્શન ના લો... આહ... ટેન્શન લો!"}, {"id": 97, "duration_s": 4.27, "emotion": "tired", "text": "શેઠ, ચા ઠંડી થાય છે."}, {"id": 98, "duration_s": 1.79, "emotion": "laughing", "text": "સ્લો મોશનમાં ફરી!"}, {"id": 99, "duration_s": 4.2, "emotion": "embarrassed", "text": "હું... કોઈથી... ના ડરું."}, {"id": 100, "duration_s": 2.21, "emotion": "curious", "text": "પપ્પા, પાઉડર અંદરથી વધતો હતો?"}, {"id": 101, "duration_s": 2.47, "emotion": "shocked", "text": "અરે બાપ રે! નજર લાગી!"}, {"id": 102, "duration_s": 2.86, "emotion": "embarrassed", "text": "હાય! આખી સોસાયટીએ જોયું!"}, {"id": 103, "duration_s": 3.4, "emotion": "excited", "text": "જીતી ગયા! હવે પાઉડરના ભાવ બમણા!"}, {"id": 104, "duration_s": 1.97, "emotion": "happy", "text": "જીતનું ગળ્યું!"}, {"id": 105, "duration_s": 6.937, "emotion": "tired", "text": "શેઠ પરિવાર જીત્યો! તપાસ... પૂરી... થઈ..."}, {"id": 106, "duration_s": 3.14, "emotion": "excited", "text": "દસ લાખ વ્યૂઝ! સુલતાન વાયરલ!"}, {"id": 107, "duration_s": 3.346, "emotion": "excited", "text": "સાંભળ્યું કે? અમેરિકાવાળા પણ જુએ છે!"}, {"id": 108, "duration_s": 1.46, "emotion": "sad", "text": "હવે મને કોઈ નહીં જુએ."}, {"id": 109, "duration_s": 1.6, "emotion": "curious", "text": "પપ્પા? અંદર છો?"}, {"id": 110, "duration_s": 0.58, "emotion": "sad", "text": "ના."}, {"id": 111, "duration_s": 1.29, "emotion": "sarcastic", "text": "જમવાનું ડોલમાં આપું?"}, {"id": 112, "duration_s": 1.85, "emotion": "determined", "text": "રોટલી નહીં... પાઉડર!"}, {"id": 113, "duration_s": 0.57, "emotion": "proud", "text": "હું કહું?"}, {"id": 114, "duration_s": 4.16, "emotion": "serious", "text": "કંપનીનું સરનામું? નહીં. લાઇસન્સ? નહીં."}, {"id": 115, "duration_s": 2.86, "emotion": "sarcastic", "text": "અને બધા રિવ્યૂ... એક જ માણસના!"}, {"id": 116, "duration_s": 1.58, "emotion": "angry", "text": "એટલે... બધી ઠગાઈ!"}, {"id": 117, "duration_s": 3.42, "emotion": "guilty", "text": "આઇડિયા મારો હતો... પપ્પાને કહેવું પડશે."}, {"id": 118, "duration_s": 4.651, "emotion": "sad", "text": "પચાસ ડબ્બા. ગ્રાહક... શૂન્ય."}, {"id": 119, "duration_s": 1.26, "emotion": "happy", "text": "ટેન્શન ના લો, શેઠ!"}, {"id": 120, "duration_s": 1.66, "emotion": "angry", "text": "ટેન્શન તો તેં જ આપ્યું!"}, {"id": 121, "duration_s": 3.81, "emotion": "proud", "text": "બચ્ચાંએ સાબિત કર્યું! સાયન્સ કહે... ચૉક!"}, {"id": 122, "duration_s": 3.24, "emotion": "tired", "text": "હા હોશિયાર હર્ષ, તું સાચો."}, {"id": 123, "duration_s": 2.69, "emotion": "shocked", "text": "હું... સાચો? પહેલી વાર?"}, {"id": 124, "duration_s": 3.01, "emotion": "happy", "text": "સરસ ચૉક! બ્લેકબોર્ડ માટે બધો લઈ જઈશ."}, {"id": 125, "duration_s": 1.15, "emotion": "pleading", "text": "કેટલા આપશો?"}, {"id": 126, "duration_s": 1.26, "emotion": "loving", "text": "આશીર્વાદ."}, {"id": 127, "duration_s": 3.67, "emotion": "determined", "text": "નકલી જાહેરાત... રિપોર્ટ! અને બ્લોક!"}, {"id": 128, "duration_s": 3.53, "emotion": "embarrassed", "text": "નવસો નવ્વાણું... ચૉકમાં."}, {"id": 129, "duration_s": 5.226, "emotion": "calm", "text": "જયેશ, જે ડબ્બો સાત દિવસમાં બોડી આપે..."}, {"id": 130, "duration_s": 3.16, "emotion": "sarcastic", "text": "...એ સાત દિવસમાં ખિસ્સું ખાલી કરે."}, {"id": 131, "duration_s": 4.16, "emotion": "serious", "text": "બોડી ડબ્બાથી નહીં, રોટલી ને દોડથી બને."}, {"id": 132, "duration_s": 5.17, "emotion": "determined", "text": "અને સરનામું, લાઇસન્સ, સાચા રિવ્યૂ જુઓ!"}, {"id": 133, "duration_s": 2.58, "emotion": "happy", "text": "સુલતાન... રોટલી ખાય!"}, {"id": 134, "duration_s": 2.26, "emotion": "tired", "text": "બાપુજી... જરા ધીમે!"}, {"id": 135, "duration_s": 1.82, "emotion": "happy", "text": "ચાલો, ચાલીને!"}, {"id": 136, "duration_s": 1.86, "emotion": "happy", "text": "શેઠ, ઝટ!"}, {"id": 137, "duration_s": 3.03, "emotion": "happy", "text": "દોડવું મફત! સૌથી સારી સ્કીમ!"}, {"id": 138, "duration_s": 3.83, "emotion": "excited", "text": "ટેન્શન ના લો! સુલતાન હેર ઓઇલ! સાત દિવસમાં વાળ!"}, {"id": 139, "duration_s": 2.12, "emotion": "embarrassed", "text": "ટેન્શન... લીધું."}, {"id": 140, "duration_s": 1.66, "emotion": "excited", "text": "પપ્પા! સાચો મસલ!"}]