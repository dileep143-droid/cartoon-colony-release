[{"id": 1, "duration_s": 3.3, "emotion": "mischievous", "text": "दिवाळीची रात्र... अख्खी कॉलनी झगमगतेय..."}, {"id": 2, "duration_s": 3.14, "emotion": "sarcastic", "text": "...आणि अख्खी कॉलनी एकाच रांगेत उभी!"}, {"id": 3, "duration_s": 2.9, "emotion": "comic_panic", "text": "ऐकलंत का? माझ्या पोटात फटाके फुटतायत!"}, {"id": 4, "duration_s": 5.385, "emotion": "worried", "text": "दृष्ट लागली! बाथरूमलाच दृष्ट लागली!"}, {"id": 5, "duration_s": 3.116, "emotion": "determined", "text": "पोट दुखतंय... पण भूकही लागलीये!"}, {"id": 6, "duration_s": 1.4, "emotion": "comic_panic", "text": "आत कोण आहे? लवकर करा!"}, {"id": 7, "duration_s": 1.15, "emotion": "calm", "text": "टेन्शन घेऊ नका!"}, {"id": 8, "duration_s": 3.88, "emotion": "calm", "text": "हे सगळं सुरू झालं होतं... तीन दिवस आधी."}, {"id": 9, "duration_s": 2.41, "emotion": "mischievous", "text": "एका अति चकचकीत मिठाईपासून."}, {"id": 10, "duration_s": 3.35, "emotion": "happy", "text": "दिवाळीचा आठवडा. अख्खी कॉलनी सजतेय."}, {"id": 11, "duration_s": 3.15, "emotion": "proud", "text": "मेगा सेल! काजू कतली निम्म्या भावात!"}, {"id": 12, "duration_s": 4.04, "emotion": "excited", "text": "चमचमीत मिठाई! भूक लागलीये!"}, {"id": 13, "duration_s": 4.83, "emotion": "mischievous", "text": "धनाजी शेठ, दोनशे डबा, निम्मा भाव, खरी चांदी शे!"}, {"id": 14, "duration_s": 2.67, "emotion": "excited", "text": "स्वस्त माल, जाडजूड नफा!"}, {"id": 15, "duration_s": 3.43, "emotion": "stern_warning", "text": "धनाजी शेठ! निम्म्या भावात खरी चांदी?"}, {"id": 16, "duration_s": 2.68, "emotion": "proud", "text": "शालू, ही दिवाळीची बरकत आहे!"}, {"id": 17, "duration_s": 0.9, "emotion": "excited", "text": "एक आयडिया!"}, {"id": 18, "duration_s": 3.73, "emotion": "excited", "text": "आजी! कमलकाकूंहून मोठं ताट... निम्म्यात!"}, {"id": 19, "duration_s": 3.62, "emotion": "mischievous", "text": "यंदा माझं ताट... अख्खी कॉलनी पाहील!"}, {"id": 20, "duration_s": 3.77, "emotion": "serious", "text": "सासूबाई, निम्म्या भावात कतली? काहीतरी गडबड!"}, {"id": 21, "duration_s": 2.66, "emotion": "proud", "text": "गडबड नाही, बचत आहे!"}, {"id": 22, "duration_s": 3.61, "emotion": "mischievous", "text": "आणि मग सुरू झालं... ताटांचं युद्ध!"}, {"id": 23, "duration_s": 2.87, "emotion": "proud", "text": "पाच डबे! सगळ्यात मोठे!"}, {"id": 24, "duration_s": 1.64, "emotion": "proud", "text": "रुपयाही कमी नाही!"}, {"id": 25, "duration_s": 2.95, "emotion": "shocked", "text": "ऐकलंत का? सखूनं पाच डबे घेतले!"}, {"id": 26, "duration_s": 1.53, "emotion": "proud", "text": "सहा डबे, शेठ! सहा!"}, {"id": 27, "duration_s": 0.63, "emotion": "determined", "text": "सात!"}, {"id": 28, "duration_s": 2.75, "emotion": "excited", "text": "टेन्शन नको! सोन्याचं प्रीमियम हॅम्पर!"}, {"id": 29, "duration_s": 2.39, "emotion": "mischievous", "text": "दुप्पट भाव, काकू... दुप्पट मान!"}, {"id": 30, "duration_s": 3.29, "emotion": "worried", "text": "एवढी मिठाई! दृष्ट लागेल!"}, {"id": 31, "duration_s": 1.93, "emotion": "proud", "text": "अख्खी कॉलनी पाहील!"}, {"id": 32, "duration_s": 2.9, "emotion": "proud", "text": "मी कोणाला भीत नाही! कमल काकूंनाही नाही!"}, {"id": 33, "duration_s": 3.32, "emotion": "curious", "text": "निम्म्या भावात चांदी? मला शंका!"}, {"id": 34, "duration_s": 6.54, "emotion": "sarcastic", "text": "मोठ्यांना कोण सांगणार?"}, {"id": 35, "duration_s": 0.58, "emotion": "giggly", "text": "स्कोअर? बारा-बारा डबे. सामना बरोबरीत!"}, {"id": 36, "duration_s": 2.81, "emotion": "stern_warning", "text": "पेढा, तू पहारेकरी. एक तुकडाही नको!"}, {"id": 37, "duration_s": 1.34, "emotion": "determined", "text": "एक तुकडाही नाही!"}, {"id": 38, "duration_s": 2.57, "emotion": "proud", "text": "माझी रांगोळी मोठी आहे."}, {"id": 39, "duration_s": 2.65, "emotion": "sarcastic", "text": "माझ्या रांगोळीत रंग जास्त आहेत."}, {"id": 40, "duration_s": 5.61, "emotion": "serious", "text": "चौकशी होणार! मिठाईच्या सुरक्षेची!"}, {"id": 41, "duration_s": 0.65, "emotion": "excited", "text": "मिठाई?"}, {"id": 42, "duration_s": 1.813, "emotion": "happy", "text": "चौकशी पूर्ण."}, {"id": 43, "duration_s": 2.4, "emotion": "shocked", "text": "पेढा! ताटं कुठे गेली?"}, {"id": 44, "duration_s": 2.33, "emotion": "guilty", "text": "ते... दृष्ट लागली!"}, {"id": 45, "duration_s": 1.98, "emotion": "excited", "text": "बघ! मी म्हटलं ना!"}, {"id": 46, "duration_s": 2.18, "emotion": "excited", "text": "हॅम्पर घ्या! अख्ख्या कॉलनीसाठी!"}, {"id": 47, "duration_s": 3.67, "emotion": "serious", "text": "आता शेठची मिठाई... घरोघरी पोहोचली होती."}, {"id": 48, "duration_s": 1.66, "emotion": "excited", "text": "हाय गाइज! आपण लाईव्ह आहोत!"}, {"id": 49, "duration_s": 3.25, "emotion": "sarcastic", "text": "इतकी हिरवी तर... पानंसुद्धा नसतात."}, {"id": 50, "duration_s": 3.31, "emotion": "excited", "text": "मिठाई मुकबँग! आजची बर्फी... निऑन ग्रीन!"}, {"id": 51, "duration_s": 3.95, "emotion": "proud", "text": "सायन्स सांगतं... जितका रंग, तितकी व्हिटॅमिन्स!"}, {"id": 52, "duration_s": 1.653, "emotion": "happy", "text": "ऐका गाइज! हेल्दी आहे!"}, {"id": 53, "duration_s": 3.71, "emotion": "serious", "text": "हिरवी जीभ? सायन्स सांगतं... ही हिरवळ आहे."}, {"id": 54, "duration_s": 2.86, "emotion": "shocked", "text": "गाइज, जीभ निळी झाली! नवीन फिल्टर?"}, {"id": 55, "duration_s": 3.37, "emotion": "embarrassed", "text": "सायन्स सांगतं... हे दुखणं आहे."}, {"id": 56, "duration_s": 3.49, "emotion": "proud", "text": "दोन लाख व्ह्यूज! सगळे निळी बर्फी खा!"}, {"id": 57, "duration_s": 3.79, "emotion": "happy", "text": "दिवाळीची संध्याकाळ. सखू आजींची मिठाई पार्टी!"}, {"id": 58, "duration_s": 3.92, "emotion": "proud", "text": "या, या! अख्खी कॉलनी पाहील... आणि खाईल!"}, {"id": 59, "duration_s": 2.72, "emotion": "sarcastic", "text": "सखूबाई, तुमची कतली एवढी चमकते कशी?"}, {"id": 60, "duration_s": 2.41, "emotion": "proud", "text": "खरी चांदी आहे! निम्म्या भावाची!"}, {"id": 61, "duration_s": 0.77, "emotion": "proud", "text": "माझीही!"}, {"id": 62, "duration_s": 2.41, "emotion": "curious", "text": "गुरुजी, ही मिठाई खरी आहे का?"}, {"id": 63, "duration_s": 3.37, "emotion": "happy", "text": "मैना हिरवी आहे? हो हो, फार सुंदर!"}, {"id": 64, "duration_s": 2.75, "emotion": "shocked", "text": "मैना नाही, गुरुजी... मिठाई!"}, {"id": 65, "duration_s": 3.1, "emotion": "excited", "text": "मैना हिरवी, बर्फीही हिरवी! वाह!"}, {"id": 66, "duration_s": 3.07, "emotion": "proud", "text": "सायन्स सांगतं... चमक म्हणजे ताजेपणा!"}, {"id": 67, "duration_s": 1.95, "emotion": "proud", "text": "मी मिठाईला घाबरत नाही!"}, {"id": 68, "duration_s": 3.3, "emotion": "happy", "text": "ढग गडगडतायत? दिवाळीत पाऊस!"}, {"id": 69, "duration_s": 2.33, "emotion": "comic_panic", "text": "ऐकलं का? माझं पोटही बोलतंय!"}, {"id": 70, "duration_s": 3.8, "emotion": "giggly", "text": "आणि मग... अख्ख्या कॉलनीचं पोट एकदम बोललं."}, {"id": 71, "duration_s": 2.87, "emotion": "sarcastic", "text": "चौदा माणसं. एक बाथरूम."}, {"id": 72, "duration_s": 2.68, "emotion": "comic_panic", "text": "मी कुणाला घाबरत नाही... पण लवकर!"}, {"id": 73, "duration_s": 2.17, "emotion": "stern_warning", "text": "धनाजी शेठ! रांगेत!"}, {"id": 74, "duration_s": 2.51, "emotion": "pleading", "text": "पुढे जायला... दोन रुपये देऊ?"}, {"id": 75, "duration_s": 4.55, "emotion": "sarcastic", "text": "कमले, तुझं पोट माझ्यापेक्षा जास्त बडबडतं."}, {"id": 76, "duration_s": 2.7, "emotion": "comic_panic", "text": "लाईव्ह सुरूये... बाथरूमच्या रांगेतून!"}, {"id": 77, "duration_s": 1.76, "emotion": "determined", "text": "बस्स! आता मी बघते."}, {"id": 78, "duration_s": 3.95, "emotion": "serious", "text": "एक लिटर उकळून गार पाणी, सहा चमचे साखर..."}, {"id": 79, "duration_s": 2.68, "emotion": "serious", "text": "...अर्धा चमचा मीठ. घोट घोट प्या."}, {"id": 80, "duration_s": 2.64, "emotion": "worried", "text": "दोन लिंबं कमी पडली... हे तिसरं!"}, {"id": 81, "duration_s": 4.16, "emotion": "calm", "text": "फक्त दोन मिनिटं... टेन्शन नको!"}, {"id": 82, "duration_s": 3.39, "emotion": "crying", "text": "सोन्या, तुझी दोन मिनिटं... दिवाळीपेक्षा लांब!"}, {"id": 83, "duration_s": 2.9, "emotion": "guilty", "text": "शेवटचा... नक्की."}, {"id": 84, "duration_s": 4.73, "emotion": "determined", "text": "औषधाचं दुकान! चला, निघू!"}, {"id": 85, "duration_s": 4.38, "emotion": "tired", "text": "चौकशी होणार... पायी."}, {"id": 86, "duration_s": 3.11, "emotion": "curious", "text": "सगळ्यांचं पोट बिघडलं... आम्ही तिघे का ठीक?"}, {"id": 87, "duration_s": 3.1, "emotion": "proud", "text": "कारण आम्ही सुनंदा काकूंच्या घरचे लाडू खाल्ले!"}, {"id": 88, "duration_s": 4.07, "emotion": "determined", "text": "आणि हा पुरावा. उद्या सकाळी... सायन्स टेस्ट!"}, {"id": 89, "duration_s": 3.53, "emotion": "sarcastic", "text": "त्या रात्री फटाके कमी फुटले... पोटं जास्त."}, {"id": 90, "duration_s": 2.43, "emotion": "curious", "text": "दुसरी सकाळ. सोनूची लॅब."}, {"id": 91, "duration_s": 2.99, "emotion": "proud", "text": "सायन्स सांगतं... चमक म्हणजे ताजं!"}, {"id": 92, "duration_s": 2.48, "emotion": "angry", "text": "माझी मिठाई खरी होती!"}, {"id": 93, "duration_s": 1.19, "emotion": "angry", "text": "माझी जास्त खरी होती!"}, {"id": 94, "duration_s": 1.64, "emotion": "shouting", "text": "गप्प! सोनू बोलतोय!"}, {"id": 95, "duration_s": 2.19, "emotion": "proud", "text": "मी सांगू? शाळेतला टेस्ट."}, {"id": 96, "duration_s": 3.29, "emotion": "stern_warning", "text": "आयोडीन जखमेचं औषध! खायचं नाही!"}, {"id": 97, "duration_s": 4.04, "emotion": "serious", "text": "निळा-काळा म्हणजे स्टार्च. मैदा किंवा आरारूट मिसळलं!"}, {"id": 98, "duration_s": 3.65, "emotion": "serious", "text": "खऱ्या खव्यात स्टार्च नसतो... रंग तपकिरीच राहतो."}, {"id": 99, "duration_s": 3.43, "emotion": "serious", "text": "खऱ्या चांदीचा वर्ख... चोळला तर पावडर होतो."}, {"id": 100, "duration_s": 4.26, "emotion": "stern_warning", "text": "हा चिकटला, चमकतच राहिला... बनावट पन्नी!"}, {"id": 101, "duration_s": 1.49, "emotion": "proud", "text": "सायन्स सांगतं..."}, {"id": 102, "duration_s": 0.71, "emotion": "stern_warning", "text": "गप्प!"}, {"id": 103, "duration_s": 3.26, "emotion": "serious", "text": "आणि इतका भडक रंग? धोक्याची घंटा."}, {"id": 104, "duration_s": 2.77, "emotion": "stern_warning", "text": "टेस्टची मिठाई... खायला मनाई!"}, {"id": 105, "duration_s": 3.82, "emotion": "proud", "text": "शाब्बास सोनू! टेस्टचे तुकडे कचराकुंडीत."}, {"id": 106, "duration_s": 3.24, "emotion": "embarrassed", "text": "आणि मी... मैना समजून खात राहिलो."}, {"id": 107, "duration_s": 3.22, "emotion": "serious", "text": "ओळखीचं दुकान, डब्यावर तारीख आणि परवाना."}, {"id": 108, "duration_s": 3.93, "emotion": "guilty", "text": "आणि मी... फक्त कमलपेक्षा मोठं ताट बघत होते."}, {"id": 109, "duration_s": 2.86, "emotion": "determined", "text": "चला! शेठचं दुकान!"}, {"id": 110, "duration_s": 3.23, "emotion": "mischievous", "text": "अख्खी कॉलनी निघाली... शेठकडे!"}, {"id": 111, "duration_s": 3.14, "emotion": "comic_panic", "text": "हॅलो! तुझी खरी चांदी... खोटी निघाली!"}, {"id": 112, "duration_s": 2.37, "emotion": "mischievous", "text": "कोण शेठ? रॉंग नंबर शे!"}, {"id": 113, "duration_s": 3.36, "emotion": "sad", "text": "मलाही फसवलं... स्वस्ताच्या नादात."}, {"id": 114, "duration_s": 4.44, "emotion": "stern_warning", "text": "धनाजी शेठ! प्रत्येक डबा परत. रुपया परत."}, {"id": 115, "duration_s": 2.46, "emotion": "pleading", "text": "शालू... थोडं कमी?"}, {"id": 116, "duration_s": 1.88, "emotion": "angry", "text": "रुपयाही कमी नाही!"}, {"id": 117, "duration_s": 3.8, "emotion": "crying", "text": "अलविदा... माझ्या लाडक्या नाण्यांनो."}, {"id": 118, "duration_s": 1.44, "emotion": "mischievous", "text": "टेन्शन नको... मी निघालो."}, {"id": 119, "duration_s": 2.83, "emotion": "sarcastic", "text": "दुप्पट घेतले... दुप्पट परत करा."}, {"id": 120, "duration_s": 3.21, "emotion": "sad", "text": "मेगा सेल... मेगा फेल."}, {"id": 121, "duration_s": 2.67, "emotion": "happy", "text": "यंदा मिठाई... घरीच बनणार!"}, {"id": 122, "duration_s": 3.87, "emotion": "happy", "text": "बेसन, तूप, साखर... बस्स! आणखी नाही."}, {"id": 123, "duration_s": 3.43, "emotion": "loving", "text": "सखूबाई, माझी नारळाची बर्फी... घरची."}, {"id": 124, "duration_s": 2.76, "emotion": "happy", "text": "यंदा ताट एक... आणि दोघींचं!"}, {"id": 125, "duration_s": 1.9, "emotion": "giggly", "text": "ऐकलंत का? आमची मैत्री झाली!"}, {"id": 126, "duration_s": 2.35, "emotion": "excited", "text": "एक आयडिया! सगळ्यात मोठा लाडू!"}, {"id": 127, "duration_s": 1.73, "emotion": "sarcastic", "text": "गप्प! गोल कर."}, {"id": 128, "duration_s": 2.99, "emotion": "giggly", "text": "पेढा, आजपासून तू... टेस्टर!"}, {"id": 129, "duration_s": 2.74, "emotion": "excited", "text": "ही नोकरी... माझ्यासाठीच बनलीये!"}, {"id": 130, "duration_s": 1.97, "emotion": "proud", "text": "क्वालिटी चेक... चालू आहे."}, {"id": 131, "duration_s": 4.49, "emotion": "happy", "text": "आणि मग आली... खरीखुरी, स्वच्छ, गोड दिवाळी!"}, {"id": 132, "duration_s": 3.57, "emotion": "proud", "text": "अख्खी कॉलनी पाहील... एकच ताट!"}, {"id": 133, "duration_s": 2.8, "emotion": "embarrassed", "text": "यंदा... फुकट!"}, {"id": 134, "duration_s": 4.26, "emotion": "worried", "text": "शेठ, फुकट? चला, निघू... डॉक्टरकडे!"}, {"id": 135, "duration_s": 3.64, "emotion": "proud", "text": "सायन्स सांगतं... घरचं, सर्वात भारी!"}, {"id": 136, "duration_s": 3.51, "emotion": "proud", "text": "यंदा नीट ऐकलं... मिठाई खरी आहे!"}, {"id": 137, "duration_s": 2.02, "emotion": "curious", "text": "आजोबा! आजचा धडा?"}, {"id": 138, "duration_s": 4.48, "emotion": "calm", "text": "स्वस्त बघून नाही... शुद्ध बघून घ्या."}, {"id": 139, "duration_s": 1.82, "emotion": "happy", "text": "हॅपी दिवाळी!"}]