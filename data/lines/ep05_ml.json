[{"id": 1, "duration_s": 3.92, "emotion": "excited", "text": "കോളനിയിലെ ഏറ്റവും വലിയ പോരാട്ടം... വടംവലി!"}, {"id": 2, "duration_s": 3.98, "emotion": "proud", "text": "ഏഴു ദിവസത്തെ പൊടി! ഞാൻ ആരെയും പേടിക്കില്ല!"}, {"id": 3, "duration_s": 2.41, "emotion": "calm", "text": "ചേട്ടാ, ചായ ചൂടാക്കി വെച്ചോ."}, {"id": 4, "duration_s": 2.31, "emotion": "excited", "text": "ലൈവാണ്! സ്ലോ മോഷനിൽ!"}, {"id": 5, "duration_s": 3.78, "emotion": "mischievous", "text": "ഇതെല്ലാം തുടങ്ങിയത്... ഒരു ഡബ്ബയിൽ നിന്ന്."}, {"id": 6, "duration_s": 3.7, "emotion": "happy", "text": "ഏഴു ദിവസം മുൻപ്. കോളനി സ്പോർട്സ് വീക്ക്."}, {"id": 7, "duration_s": 3.84, "emotion": "excited", "text": "ഞായറാഴ്ച വടംവലി! സുരേഷ് ടീമും കുട്ടപ്പൻ ടീമും!"}, {"id": 8, "duration_s": 3.51, "emotion": "proud", "text": "ജയിക്കും! ഞാൻ ആരെയും പേടിക്കില്ല!"}, {"id": 9, "duration_s": 4.85, "emotion": "sarcastic", "text": "കണക്കുകൂട്ടി. സുരേഷ് ജയിക്കാൻ ചാൻസ്... പൂജ്യം."}, {"id": 10, "duration_s": 1.68, "emotion": "sarcastic", "text": "ആരെയും പേടിയില്ലേ?"}, {"id": 11, "duration_s": 1.02, "emotion": "comic_panic", "text": "ആരെയുമില്ല! പല്ലി... ഇല്ലല്ലോ അല്ലേ?"}, {"id": 12, "duration_s": 1.29, "emotion": "stern_warning", "text": "മിണ്ടരുത്! അങ്കിൾ ഇനീം ചാടും!"}, {"id": 13, "duration_s": 0.93, "emotion": "happy", "text": "വാ, പോവാം!"}, {"id": 14, "duration_s": 2.06, "emotion": "calm", "text": "മാറ്, ഞാൻ നോക്കാം."}, {"id": 15, "duration_s": 1.89, "emotion": "shocked", "text": "ചേച്ചീ, ട്രാക്ടറും വലിക്കും!"}, {"id": 16, "duration_s": 1.06, "emotion": "excited", "text": "ടെൻഷൻ വേണ്ട ചേട്ടാ!"}, {"id": 17, "duration_s": 2.41, "emotion": "worried", "text": "ടെൻഷനോ? ഓട്ടോ വലിച്ചു, ഷിബൂ!"}, {"id": 18, "duration_s": 3.905, "emotion": "proud", "text": "എന്റെ മോൻ ജയിക്കും! നാട്ടുകാരൊക്കെ കാണും!"}, {"id": 19, "duration_s": 3.12, "emotion": "mischievous", "text": "അറിഞ്ഞോ? സുരേഷ് പല്ലിയോട് തോറ്റെന്ന്!"}, {"id": 20, "duration_s": 3.26, "emotion": "sad", "text": "ചിപ്സ് എവിടെപ്പോയി? വിശക്കുന്നേ!"}, {"id": 21, "duration_s": 3.15, "emotion": "excited", "text": "സുൽത്താൻ പവർ പൗഡർ! ഏഴു ദിവസം, ബോഡി ഒണ്ട്!"}, {"id": 22, "duration_s": 2.04, "emotion": "excited", "text": "വെറും തൊള്ളായിരത്തി തൊണ്ണൂറ്റൊമ്പത്!"}, {"id": 23, "duration_s": 2.69, "emotion": "excited", "text": "ഒരു ഐഡിയ ഉണ്ട്! അച്ഛന് വേണ്ടി!"}, {"id": 24, "duration_s": 3.23, "emotion": "excited", "text": "അച്ഛാ! ഏഴു ദിവസം ബോഡി! ഞായറും ഏഴു ദിവസം!"}, {"id": 25, "duration_s": 2.89, "emotion": "excited", "text": "സുൽത്താൻ... ബോഡി... ഏഴു ദിനം!"}, {"id": 26, "duration_s": 2.04, "emotion": "sarcastic", "text": "ഏഴു ദിവസത്തിൽ അച്ചാറും ആവില്ല!"}, {"id": 27, "duration_s": 2.57, "emotion": "proud", "text": "ഇത് സയൻസാ, ശോഭേ! ഓർഡർ!"}, {"id": 28, "duration_s": 3.48, "emotion": "proud", "text": "എന്റെ മോൻ സുൽത്താനാകും! നാട്ടുകാരൊക്കെ കാണും!"}, {"id": 29, "duration_s": 3.14, "emotion": "curious", "text": "പൊടി മധുരമുണ്ടോ? എനിക്കും വേണം."}, {"id": 30, "duration_s": 1.96, "emotion": "excited", "text": "സുൽത്താൻ പൗഡർ! ബേഗം ഡെലിവറി!"}, {"id": 31, "duration_s": 1.49, "emotion": "loving", "text": "എന്റെ സുൽത്താൻ വന്നു!"}, {"id": 32, "duration_s": 2.68, "emotion": "mischievous", "text": "അറിഞ്ഞോ? സുരേഷ് ബോഡി പെട്ടിയിൽ വരുത്തി!"}, {"id": 33, "duration_s": 1.66, "emotion": "determined", "text": "ആഹ്! ശക്തി കയറുന്നു!"}, {"id": 34, "duration_s": 2.28, "emotion": "curious", "text": "അച്ഛാ... മസിൽ എവിടെ ഒളിച്ചു?"}, {"id": 35, "duration_s": 4.61, "emotion": "excited", "text": "വന്നേ! ഒരു രോമം എണീറ്റേ!"}, {"id": 36, "duration_s": 2.62, "emotion": "shocked", "text": "അറിഞ്ഞോ? ബട്ടൺ മഴ പെയ്യുന്നൂ!"}, {"id": 37, "duration_s": 3.33, "emotion": "embarrassed", "text": "ബോഡി വളരുവാ കുഞ്ഞമ്മേ!"}, {"id": 38, "duration_s": 1.47, "emotion": "shocked", "text": "അര ഇഞ്ച്..."}, {"id": 39, "duration_s": 0.78, "emotion": "shocked", "text": "...കുറഞ്ഞു!"}, {"id": 40, "duration_s": 1.38, "emotion": "proud", "text": "ഉള്ളിൽ നിന്നാ വളരുന്നേ!"}, {"id": 41, "duration_s": 1.63, "emotion": "happy", "text": "മണത്താലും ശക്തി കിട്ടും!"}, {"id": 42, "duration_s": 2.22, "emotion": "worried", "text": "സുരേഷേ, മൂക്കിൽ കയറ്റല്ലേ!"}, {"id": 43, "duration_s": 1.05, "emotion": "comic_panic", "text": "ആ... ആ... ആ..."}, {"id": 44, "duration_s": 2.93, "emotion": "proud", "text": "കണ്ടോ? പൊടി പുറത്തൂടെയും പണിയെടുക്കും!"}, {"id": 45, "duration_s": 1.45, "emotion": "determined", "text": "മതി! ഞാൻ നോക്കാം."}, {"id": 46, "duration_s": 3.59, "emotion": "shocked", "text": "അയ്യോ! എന്റെ സുൽത്താൻ മഞ്ഞുപ്രതിമയായേ!"}, {"id": 47, "duration_s": 2.11, "emotion": "serious", "text": "നിൽക്ക്! സയൻസ് പറയുന്നു..."}, {"id": 48, "duration_s": 3.897, "emotion": "proud", "text": "ഇത് നൂറു ശതമാനം ചോക്കാണ്!"}, {"id": 49, "duration_s": 3.02, "emotion": "laughing", "text": "<laugh> പ്രകാശിന്റെ സയൻസോ? എങ്കിൽ തെറ്റുറപ്പ്!"}, {"id": 50, "duration_s": 4.71, "emotion": "giggly", "text": "മേഘം സിലിണ്ടറിൽ ഉണ്ടാകുമെന്ന് പ്രകാശ് പറഞ്ഞു!"}, {"id": 51, "duration_s": 2.04, "emotion": "giggly", "text": "കോഴി പാൽ തരുമെന്നും!"}, {"id": 52, "duration_s": 2.37, "emotion": "laughing", "text": "ചന്ദ്രനിൽ ചായക്കടയുണ്ടെന്നും!"}, {"id": 53, "duration_s": 1.21, "emotion": "pleading", "text": "പക്ഷേ ഇത്തവണ സത്യമാ!"}, {"id": 54, "duration_s": 2.71, "emotion": "serious", "text": "സുൽത്താന് കണ്ണ് തട്ടല്ലേ!"}, {"id": 55, "duration_s": 1.97, "emotion": "proud", "text": "സുൽത്താൻ ഞായറാഴ്ച കാണാം!"}, {"id": 56, "duration_s": 2.81, "emotion": "sad", "text": "നോക്ക്... എഴുതുകേം ചെയ്യും. ആരും നോക്കില്ല."}, {"id": 57, "duration_s": 2.15, "emotion": "excited", "text": "ടെൻഷൻ വേണ്ട! ഇത് പൊന്നിൻ ഖനി!"}, {"id": 58, "duration_s": 2.03, "emotion": "mischievous", "text": "നൂറിന് വാങ്ങ്, ഇരുന്നൂറിന് വിൽക്ക്!"}, {"id": 59, "duration_s": 2.38, "emotion": "mischievous", "text": "ചേട്ടാ, ഡീലർഷിപ്പ്! അൻപത് പെട്ടി!"}, {"id": 60, "duration_s": 2.38, "emotion": "curious", "text": "അൻപത് സുൽത്താൻ? കണക്ക് കൂട്ടട്ടെ."}, {"id": 61, "duration_s": 3.89, "emotion": "serious", "text": "അയ്യായിരം. രണ്ടു വട്ടം എണ്ണി... മൂന്നാമതും."}, {"id": 62, "duration_s": 1.41, "emotion": "pleading", "text": "ഒരു രൂപ കുറയില്ല!"}, {"id": 63, "duration_s": 0.94, "emotion": "stern_warning", "text": "കുട്ടപ്പേട്ടാ!"}, {"id": 64, "duration_s": 3.12, "emotion": "embarrassed", "text": "കല്യാണീ, ഇത് ബിസിനസാ! ഇരട്ടി ലാഭം!"}, {"id": 65, "duration_s": 1.26, "emotion": "sarcastic", "text": "അതോ ഡബിൾ നഷ്ടം?"}, {"id": 66, "duration_s": 2.96, "emotion": "proud", "text": "അൻപത് പെട്ടി! നാടാകെ സുൽത്താൻ!"}, {"id": 67, "duration_s": 2.93, "emotion": "happy", "text": "ഞാനൊന്നും തിന്നില്ലാ."}, {"id": 68, "duration_s": 2.13, "emotion": "surprised", "text": "ഇത് മധുരമല്ല... ചോക്കാ!"}, {"id": 69, "duration_s": 1.67, "emotion": "shouting", "text": "മിണ്ടരുത്! ബിസിനസാ!"}, {"id": 70, "duration_s": 2.67, "emotion": "mischievous", "text": "ട്രെയിനിങ് വീക്ക്. കോച്ച്... ഷിബു."}, {"id": 71, "duration_s": 2.04, "emotion": "proud", "text": "കോച്ച് ഷിബു! ഓട്, ഞാൻ എണ്ണാം."}, {"id": 72, "duration_s": 1.82, "emotion": "proud", "text": "ഓടണോ? പൊടി ഇല്ലേ!"}, {"id": 73, "duration_s": 2.16, "emotion": "determined", "text": "ഇന്ന് മരം പിഴുതെടുത്തിട്ടേ ഉള്ളൂ!"}, {"id": 74, "duration_s": 2.57, "emotion": "worried", "text": "മൂന്ന് ചുവട്! ചെരിപ്പ് തേഞ്ഞുപോയാലോ?"}, {"id": 75, "duration_s": 1.85, "emotion": "proud", "text": "ഇതാണ് എന്റെ ട്രെയിനിങ്!"}, {"id": 76, "duration_s": 1.38, "emotion": "calm", "text": "എനിക്ക് ട്രെയിനിങ് വേണ്ട."}, {"id": 77, "duration_s": 2.39, "emotion": "tired", "text": "അച്ഛാ, ഏത് പൊടിയാ?"}, {"id": 78, "duration_s": 1.32, "emotion": "calm", "text": "ചപ്പാത്തി."}, {"id": 79, "duration_s": 0.99, "emotion": "stern_warning", "text": "ചപ്പാത്തി തിന്ന്!"}, {"id": 80, "duration_s": 2.42, "emotion": "proud", "text": "സുൽത്താൻ ചപ്പാത്തി തിന്നില്ല!"}, {"id": 81, "duration_s": 2.2, "emotion": "curious", "text": "ആറു ദിവസായി. മസിൽ?"}, {"id": 82, "duration_s": 2.41, "emotion": "sarcastic", "text": "മിണ്ടാതിരി! ഉള്ളിൽ വളരുവാ."}, {"id": 83, "duration_s": 1.8, "emotion": "determined", "text": "എന്റച്ഛൻ സുൽത്താനാ!"}, {"id": 84, "duration_s": 3.65, "emotion": "excited", "text": "ഞായറാഴ്ച. കോളനിയുടെ മഹാപോരാട്ടം!"}, {"id": 85, "duration_s": 3.38, "emotion": "serious", "text": "അന്വേഷണം! സമോസയ്ക്ക്!"}, {"id": 86, "duration_s": 2.01, "emotion": "excited", "text": "ലൈവാണ്! മഹാപോരാട്ടം!"}, {"id": 87, "duration_s": 1.46, "emotion": "proud", "text": "ഇന്ന് സുൽത്താന്റെ ദിവസം!"}, {"id": 88, "duration_s": 2.93, "emotion": "mischievous", "text": "ജയിച്ചാൽ പൊടി വിൽക്കാം, തോറ്റാലും!"}, {"id": 89, "duration_s": 2.0, "emotion": "calm", "text": "കുട്ടപ്പേട്ടാ, പിന്നിൽ പിടിച്ചോ."}, {"id": 90, "duration_s": 2.07, "emotion": "sarcastic", "text": "പിടിച്ചു. കൂലി വേറെ."}, {"id": 91, "duration_s": 3.1, "emotion": "excited", "text": "നാട്ടുകാർ കാണട്ടെ! സുരേഷ് സിന്ദാബാദ്!"}, {"id": 92, "duration_s": 3.83, "emotion": "serious", "text": "കണ്ണ് തട്ടല്ലേ! ഇനി വടം പവിത്രം."}, {"id": 93, "duration_s": 3.03, "emotion": "shouting", "text": "തയ്യാർ... വലിക്ക്!"}, {"id": 94, "duration_s": 3.52, "emotion": "determined", "text": "മുഴുവൻ... ശക്തി... താ!"}, {"id": 95, "duration_s": 2.65, "emotion": "curious", "text": "കുട്ടപ്പേട്ടാ, എപ്പോ തുടങ്ങും?"}, {"id": 96, "duration_s": 2.3, "emotion": "comic_panic", "text": "ടെൻഷൻ വേണ്ട... ആഹ്... ടെൻഷൻ വേണം!"}, {"id": 97, "duration_s": 2.07, "emotion": "tired", "text": "ചേട്ടാ, ചായ തണുക്കുന്നു."}, {"id": 98, "duration_s": 1.81, "emotion": "laughing", "text": "സ്ലോ മോഷനിൽ ഒന്നൂടെ!"}, {"id": 99, "duration_s": 3.65, "emotion": "embarrassed", "text": "ഞാൻ... ആരെയും പേടിക്കില്ല."}, {"id": 100, "duration_s": 2.51, "emotion": "curious", "text": "അച്ഛാ, പൊടി ഉള്ളിൽ വളർന്നതാണോ?"}, {"id": 101, "duration_s": 1.907, "emotion": "shocked", "text": "അയ്യോ! കണ്ണ് തട്ടി!"}, {"id": 102, "duration_s": 2.559, "emotion": "embarrassed", "text": "അയ്യോ! നാട്ടുകാരൊക്കെ കണ്ടല്ലോ!"}, {"id": 103, "duration_s": 3.91, "emotion": "excited", "text": "ജയിച്ചേ! ഇനി പൊടിക്ക് ഇരട്ടി വില!"}, {"id": 104, "duration_s": 5.28, "emotion": "happy", "text": "ജയത്തിന്റെ മധുരം!"}, {"id": 105, "duration_s": 6.47, "emotion": "tired", "text": "കുട്ടപ്പൻ ടീം ജയിച്ചു! അന്വേഷണം... തീർന്നു..."}, {"id": 106, "duration_s": 2.88, "emotion": "excited", "text": "പത്തു ലക്ഷം വ്യൂസ്! സുൽത്താൻ വൈറൽ!"}, {"id": 107, "duration_s": 1.44, "emotion": "excited", "text": "അറിഞ്ഞോ? അമേരിക്കക്കാരും കാണുന്നു!"}, {"id": 108, "duration_s": 2.27, "emotion": "sad", "text": "ഇനി എന്നെ ആരും കാണില്ല."}, {"id": 109, "duration_s": 1.63, "emotion": "curious", "text": "അച്ഛാ? അകത്തുണ്ടോ?"}, {"id": 110, "duration_s": 0.51, "emotion": "sad", "text": "ഇല്ല."}, {"id": 111, "duration_s": 1.61, "emotion": "sarcastic", "text": "ഊണ് ബക്കറ്റിൽ വിളമ്പണോ?"}, {"id": 112, "duration_s": 1.83, "emotion": "determined", "text": "ചപ്പാത്തി വേണ്ട... പൊടി!"}, {"id": 113, "duration_s": 0.72, "emotion": "proud", "text": "ഞാൻ പറയാം?"}, {"id": 114, "duration_s": 3.44, "emotion": "serious", "text": "കമ്പനി വിലാസം? ഇല്ല. ലൈസൻസ്? ഇല്ല."}, {"id": 115, "duration_s": 2.29, "emotion": "sarcastic", "text": "റിവ്യൂ എല്ലാം... ഒരാളുടെ തന്നെ!"}, {"id": 116, "duration_s": 1.78, "emotion": "angry", "text": "അപ്പോ... എല്ലാം ചതി!"}, {"id": 117, "duration_s": 5.457, "emotion": "guilty", "text": "ഐഡിയ എന്റേതാ... അച്ഛനോട് പറയണം."}, {"id": 118, "duration_s": 2.41, "emotion": "sad", "text": "അൻപത് പെട്ടി. കസ്റ്റമർ... പൂജ്യം."}, {"id": 119, "duration_s": 1.7, "emotion": "happy", "text": "ടെൻഷൻ വേണ്ടാ, ചേട്ടാ!"}, {"id": 120, "duration_s": 1.56, "emotion": "angry", "text": "ടെൻഷൻ തന്നത് നീയാ!"}, {"id": 121, "duration_s": 2.82, "emotion": "proud", "text": "കുട്ടികൾ തെളിയിച്ചു! സയൻസ്... ചോക്ക്!"}, {"id": 122, "duration_s": 2.49, "emotion": "tired", "text": "ശരിയാ പ്രകാശേ, നീ ശരി."}, {"id": 123, "duration_s": 3.24, "emotion": "shocked", "text": "ഞാൻ... ശരി? ആദ്യമായി?"}, {"id": 124, "duration_s": 3.34, "emotion": "happy", "text": "നല്ല ചോക്ക്! ബ്ലാക്ക്ബോർഡിന് എല്ലാം കൊണ്ടുപോകും."}, {"id": 125, "duration_s": 0.81, "emotion": "pleading", "text": "എത്ര തരും?"}, {"id": 126, "duration_s": 0.68, "emotion": "loving", "text": "അനുഗ്രഹം."}, {"id": 127, "duration_s": 3.21, "emotion": "determined", "text": "വ്യാജ പരസ്യം... റിപ്പോർട്ട്! പിന്നെ ബ്ലോക്ക്!"}, {"id": 128, "duration_s": 2.08, "emotion": "embarrassed", "text": "ഒമ്പതൊമ്പതൊമ്പത്... ചോക്കിൽ!"}, {"id": 129, "duration_s": 3.16, "emotion": "calm", "text": "സുരേഷേ, ഏഴു ദിനം ബോഡി തരും ഡബ്ബ..."}, {"id": 130, "duration_s": 2.17, "emotion": "sarcastic", "text": "...ഏഴു ദിവസം കൊണ്ട് കീശ കാലിയാക്കും."}, {"id": 131, "duration_s": 3.44, "emotion": "serious", "text": "ബോഡി പെട്ടിയിലല്ല, ചപ്പാത്തിയിലും ഓട്ടത്തിലുമാ."}, {"id": 132, "duration_s": 3.44, "emotion": "determined", "text": "പിന്നെ വിലാസം, ലൈസൻസ്, ശരിക്കുള്ള റിവ്യൂ നോക്കണം!"}, {"id": 133, "duration_s": 2.2, "emotion": "happy", "text": "സുൽത്താൻ... ചപ്പാത്തി തിന്നും!"}, {"id": 134, "duration_s": 2.48, "emotion": "tired", "text": "അച്ഛാ... പയ്യെ... പയ്യെ!"}, {"id": 135, "duration_s": 1.24, "emotion": "happy", "text": "പോകാം... നടന്ന്!"}, {"id": 136, "duration_s": 1.41, "emotion": "happy", "text": "വേഗം വാ!"}, {"id": 137, "duration_s": 3.02, "emotion": "happy", "text": "ഓട്ടം ഫ്രീയാ! ഏറ്റവും നല്ല സ്കീം!"}, {"id": 138, "duration_s": 3.06, "emotion": "excited", "text": "ടെൻഷൻ വേണ്ട! ഹെയർ ഓയിൽ! ഏഴു ദിവസം, മുടി!"}, {"id": 139, "duration_s": 1.78, "emotion": "embarrassed", "text": "ടെൻഷൻ... അടിച്ചു."}, {"id": 140, "duration_s": 1.59, "emotion": "excited", "text": "അച്ഛാ! ശരിക്കുള്ള മസിൽ!"}]