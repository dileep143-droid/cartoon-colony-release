[{"id": 1, "duration_s": 4.34, "emotion": "calm", "text": "ही आमची कॉलनी. शांत, सुंदर, सुरक्षित..."}, {"id": 2, "duration_s": 3.23, "emotion": "excited", "text": "आणि हे... कॉलनीचे नवे राजे!"}, {"id": 3, "duration_s": 3.0, "emotion": "proud", "text": "राजा? या कॉलनीचा राजा मी आहे!"}, {"id": 4, "duration_s": 3.07, "emotion": "sarcastic", "text": "चुकीचं उत्तर."}, {"id": 5, "duration_s": 2.02, "emotion": "proud", "text": "राणी मी आहे! सगळी कॉलनी बघेल!"}, {"id": 6, "duration_s": 0.96, "emotion": "sarcastic", "text": "पुन्हा चुकलं."}, {"id": 7, "duration_s": 2.86, "emotion": "proud", "text": "राणी-बिणी सोडा. फॉलोअर्स माझे जास्त!"}, {"id": 8, "duration_s": 3.3, "emotion": "mischievous", "text": "तिघंही चुकले. सुरुवात झाली काल संध्याकाळी..."}, {"id": 9, "duration_s": 2.916, "emotion": "mischievous", "text": "...फक्त एका केळ्यामुळे."}, {"id": 10, "duration_s": 2.94, "emotion": "calm", "text": "त्या संध्याकाळी कॉलनीत एकच माकड आलं."}, {"id": 11, "duration_s": 4.19, "emotion": "excited", "text": "अरे! माकड आलंय! फार शुभ असतं!"}, {"id": 12, "duration_s": 3.83, "emotion": "loving", "text": "घे रे बाळा, केळं खा. नजर लागणार नाही."}, {"id": 13, "duration_s": 3.34, "emotion": "excited", "text": "माकड! खरंखुरं माकड! आपल्या कॉलनीत!"}, {"id": 14, "duration_s": 4.35, "emotion": "excited", "text": "एक भन्नाट कल्पना! याला पाळूया! नाव... मंगळ!"}, {"id": 15, "duration_s": 3.95, "emotion": "worried", "text": "पाळणार? खायला काय? माझे चिप्स नाही!"}, {"id": 16, "duration_s": 2.54, "emotion": "serious", "text": "मी सांगू? माकड रानटी प्राणी आहे, पाळीव नाही."}, {"id": 17, "duration_s": 3.52, "emotion": "stern_warning", "text": "गप्प! मंगळ आपला मित्र आहे."}, {"id": 18, "duration_s": 4.08, "emotion": "sarcastic", "text": "बरं. मी लिहून ठेवतोय."}, {"id": 19, "duration_s": 3.35, "emotion": "happy", "text": "रोज खाऊ घालू. भाग्यवान माकड!"}, {"id": 20, "duration_s": 3.46, "emotion": "mischievous", "text": "मंगळनं खाल्लं... आणि घरी फोन केला."}, {"id": 21, "duration_s": 2.02, "emotion": "mischievous", "text": "अख्ख्या खानदानाला."}, {"id": 22, "duration_s": 2.66, "emotion": "calm", "text": "शुभ... शुभ... खूप शुभ..."}, {"id": 23, "duration_s": 3.11, "emotion": "mischievous", "text": "दुसऱ्या दिवशी... एकाची झाली वीस माकडं!"}, {"id": 24, "duration_s": 3.19, "emotion": "excited", "text": "एवढी सगळी? <gasp> एवढं नशीब!"}, {"id": 25, "duration_s": 2.7, "emotion": "proud", "text": "विज्ञान सांगतं, माकडं माणसाला घाबरतात."}, {"id": 26, "duration_s": 3.15, "emotion": "serious", "text": "हे बघा भाऊ, विज्ञान सांगतं, घाबरू नका."}, {"id": 27, "duration_s": 3.85, "emotion": "loving", "text": "तुम्ही खूप उंच आहात... आणि बारीक. काहीतरी खा!"}, {"id": 28, "duration_s": 3.6, "emotion": "happy", "text": "पोटात कावळे! बटाटा पराठे, चार!"}, {"id": 29, "duration_s": 5.27, "emotion": "shocked", "text": "माझ्यापेक्षा जलद? माझ्यापेक्षा?! ही तर बेअब्रू!"}, {"id": 30, "duration_s": 8.765, "emotion": "stern_warning", "text": "चावून खा! बत्तीस वेळा! शिष्टाचार नावाची गोष्ट..."}, {"id": 31, "duration_s": 3.69, "emotion": "laughing", "text": "<laugh> हसू नको पेढा... अरे! माझा मोजा!"}, {"id": 32, "duration_s": 4.57, "emotion": "worried", "text": "काल एक होतं. आज सत्तावीस. उद्या किती असतील?"}, {"id": 33, "duration_s": 1.89, "emotion": "happy", "text": "सत्तावीस पट शुभ!"}, {"id": 34, "duration_s": 2.38, "emotion": "excited", "text": "ऐकलंत का? कॉलनीत माकडं आली!"}, {"id": 35, "duration_s": 3.48, "emotion": "excited", "text": "हुशार हरीशचा चष्मा गेला, पेढाचा डबा गेला..."}, {"id": 36, "duration_s": 3.66, "emotion": "proud", "text": "...पण माझं? माझं काही जाणार नाही!"}, {"id": 37, "duration_s": 1.02, "emotion": "shocked", "text": "<gasp> माझा फोन!"}, {"id": 38, "duration_s": 2.95, "emotion": "laughing", "text": "काकू, तो तुमच्यापेक्षा भारी गॉसिप करतो!"}, {"id": 39, "duration_s": 2.74, "emotion": "angry", "text": "हसू नका! त्यात माझे तीनशे ग्रुप आहेत!"}, {"id": 40, "duration_s": 3.47, "emotion": "determined", "text": "चला, निघूया! फोन परत आणूया!"}, {"id": 41, "duration_s": 2.43, "emotion": "tired", "text": "<sigh> प्रत्येक महत्त्वाच्या वेळी... दर वेळी!"}, {"id": 42, "duration_s": 5.17, "emotion": "serious", "text": "एक, दोन, तीन... एक केळंसुद्धा कमी नाही!"}, {"id": 43, "duration_s": 3.8, "emotion": "shocked", "text": "पुन्हा मोजा... एक... दोन... <gasp> गायब!"}, {"id": 44, "duration_s": 2.44, "emotion": "stern_warning", "text": "धनाजी शेठ! आमचा तांदूळ!"}, {"id": 45, "duration_s": 1.1, "emotion": "stern_warning", "text": "हात लावून दाखव!"}, {"id": 46, "duration_s": 4.7, "emotion": "relieved", "text": "माकडसुद्धा हिला घाबरतं. मी एकटा नाही!"}, {"id": 47, "duration_s": 2.77, "emotion": "excited", "text": "हॅलो मित्रांनो! लाईव्ह सुरू आहे! माकड स्पेशल!"}, {"id": 48, "duration_s": 3.06, "emotion": "happy", "text": "बघा, माझे फॅन! हाय माकड!"}, {"id": 49, "duration_s": 2.55, "emotion": "comic_panic", "text": "माझं लाईव्ह! माझी रिंग लाईट! माझं करिअर!"}, {"id": 50, "duration_s": 4.65, "emotion": "angry", "text": "माकडाच्या लाईव्हवर... दहा लाख लोक!"}, {"id": 51, "duration_s": 4.76, "emotion": "sarcastic", "text": "त्या सकाळी कॉलनीचं सगळ्यात मोठं इन्फ्लुएन्सर... माकड होतं."}, {"id": 52, "duration_s": 2.68, "emotion": "embarrassed", "text": "...मीसुद्धा फॉलो केलं."}, {"id": 53, "duration_s": 3.01, "emotion": "mischievous", "text": "दुपारपर्यंत कॉलनीची तातडीची मीटिंग भरली."}, {"id": 54, "duration_s": 4.1, "emotion": "stern_warning", "text": "शांतता! एकेक करून! हात वर करा!"}, {"id": 55, "duration_s": 2.26, "emotion": "sarcastic", "text": "तुम्ही कॉलनीचे सभासद नाही!"}, {"id": 56, "duration_s": 4.27, "emotion": "proud", "text": "मी कुणाला घाबरत नाही! माकड मी पकडणार!"}, {"id": 57, "duration_s": 2.36, "emotion": "sarcastic", "text": "पालीला घाबरता, आणि माकड पकडणार?"}, {"id": 58, "duration_s": 3.58, "emotion": "embarrassed", "text": "मी... खांब किती मजबूत ते तपासत होतो."}, {"id": 59, "duration_s": 4.05, "emotion": "serious", "text": "नजर लागलीय! प्रत्येक घरावर लिंबू-मिरची!"}, {"id": 60, "duration_s": 2.95, "emotion": "proud", "text": "माझ्या लाडवांना कुणी हात लावून दाखवा!"}, {"id": 61, "duration_s": 3.1, "emotion": "scared_whisper", "text": "ऐकलंय, माकडांना मिठाईचा वास येतो..."}, {"id": 62, "duration_s": 3.07, "emotion": "serious", "text": "मी सांगू? माकडं यासाठी येतायत कारण..."}, {"id": 63, "duration_s": 4.49, "emotion": "serious", "text": "मुलांनी बोलू नका! मोठ्यांची मीटिंग!"}, {"id": 64, "duration_s": 0.75, "emotion": "stern_warning", "text": "गप्प! दादाचं ऐका..."}, {"id": 65, "duration_s": 2.75, "emotion": "excited", "text": "टेन्शन नको! माझ्याकडे प्लॅन आहे!"}, {"id": 66, "duration_s": 3.76, "emotion": "sad", "text": "<sigh> मोठ्यांची मीटिंग. मुलांचं बोलणं... उद्या."}, {"id": 67, "duration_s": 7.22, "emotion": "proud", "text": "बघा, विज्ञान! केळं आत, माकड आत, धप्प!"}, {"id": 68, "duration_s": 3.48, "emotion": "worried", "text": "बाबा, माकड तर वर झाडावर आहे..."}, {"id": 69, "duration_s": 2.52, "emotion": "determined", "text": "फक्त केळं जरा सरळ करतो..."}, {"id": 70, "duration_s": 3.58, "emotion": "comic_panic", "text": "मी कुणाला घाबरत नाही... <short pause> बाहेर काढा!"}, {"id": 71, "duration_s": 2.71, "emotion": "worried", "text": "काका ठीक आहेत? <short pause> केळं ठीक आहे?"}, {"id": 72, "duration_s": 1.93, "emotion": "determined", "text": "बास! आता मी बघते."}, {"id": 73, "duration_s": 2.52, "emotion": "proud", "text": "मी त्याला मुद्दाम सोडलं. दया आली."}, {"id": 74, "duration_s": 2.08, "emotion": "proud", "text": "टेन्शन नको! लंगूर आला!"}, {"id": 75, "duration_s": 4.14, "emotion": "curious", "text": "काका, तुम्ही तर... मोठ्ठं माकड दिसताय."}, {"id": 76, "duration_s": 2.67, "emotion": "proud", "text": "तेच तर! माकडं लंगूरला घाबरतात!"}, {"id": 77, "duration_s": 2.07, "emotion": "shouting", "text": "हू-हू-हा-हा! पळा सगळे!"}, {"id": 78, "duration_s": 2.7, "emotion": "surprised", "text": "अरेच्चा? हे तर... वाकले?"}, {"id": 79, "duration_s": 5.662, "emotion": "proud", "text": "मी यांचा राजा आहे! सोन्या महाराज!"}, {"id": 80, "duration_s": 1.98, "emotion": "giggly", "text": "<laugh> गुदगुल्या! अरे, उवा नाहीत!"}, {"id": 81, "duration_s": 2.63, "emotion": "excited", "text": "ऐकलंत का? सोन्या माकडांचा सरदार झाला!"}, {"id": 82, "duration_s": 3.92, "emotion": "stern_warning", "text": "बाहेर! आपल्या सगळ्या सेनेसह!"}, {"id": 83, "duration_s": 2.39, "emotion": "tired", "text": "<sigh> टेन्शन... थोडंसं आहे."}, {"id": 84, "duration_s": 5.46, "emotion": "stern_warning", "text": "चौकशी होणार! अख्ख्या कॉलनीची चौकशी!"}, {"id": 85, "duration_s": 3.46, "emotion": "sarcastic", "text": "चौकशी सुरू झाली. दोन मिनिटांनी..."}, {"id": 86, "duration_s": 4.3, "emotion": "excited", "text": "समोसा? <short pause> चौकशी!"}, {"id": 87, "duration_s": 2.87, "emotion": "shocked", "text": "जय हिंद! <gasp> अरे... माझी टोपी!"}, {"id": 88, "duration_s": 3.22, "emotion": "comic_panic", "text": "हेड ऑफिस! माकडांनी माझी टोपी अटक केली!"}, {"id": 89, "duration_s": 3.68, "emotion": "tender", "text": "काका, अर्धा समोसा. फक्त अर्धा."}, {"id": 90, "duration_s": 6.42, "emotion": "proud", "text": "माझे बेसनाचे लाडू! सगळी कॉलनी बघेल!"}, {"id": 91, "duration_s": 1.34, "emotion": "shocked", "text": "<gasp> माझे लाडू!"}, {"id": 92, "duration_s": 2.4, "emotion": "determined", "text": "आज तुझी खैर नाही."}, {"id": 93, "duration_s": 4.53, "emotion": "excited", "text": "आणि सुरू झाली... कॉलनीच्या इतिहासातली सगळ्यात मोठी शर्यत!"}, {"id": 94, "duration_s": 1.39, "emotion": "excited", "text": "सखू आजी! आजी!"}, {"id": 95, "duration_s": 2.9, "emotion": "excited", "text": "सखू आजी वि. माकड! लाईव्ह!"}, {"id": 96, "duration_s": 2.01, "emotion": "excited", "text": "शाब्बास सखू आजी!"}, {"id": 97, "duration_s": 3.66, "emotion": "shocked", "text": "चाळीस लाडू... चारशे रुपयांचा माल!"}, {"id": 98, "duration_s": 2.84, "emotion": "shocked", "text": "आईचा नेम... चुकला?"}, {"id": 99, "duration_s": 3.38, "emotion": "sad", "text": "पहिल्यांदा... आयुष्यात पहिल्यांदा!"}, {"id": 100, "duration_s": 3.84, "emotion": "sarcastic", "text": "सगळ्या कॉलनीने पाहिलं... सखू आजीचा नेम चुकताना."}, {"id": 101, "duration_s": 3.82, "emotion": "stern_warning", "text": "गप्प! सगळे गप्प! आता दादा बोलणार!"}, {"id": 102, "duration_s": 2.77, "emotion": "determined", "text": "मी सांगू? <short pause> चला माझ्यासोबत."}, {"id": 103, "duration_s": 3.86, "emotion": "sarcastic", "text": "कॉलनीच्या मागे... माकडांचं फुकट हॉटेल."}, {"id": 104, "duration_s": 2.15, "emotion": "angry", "text": "शी! हा कचरा कुणाचा?"}, {"id": 105, "duration_s": 1.43, "emotion": "embarrassed", "text": "...कुणाचाही असू शकतो."}, {"id": 106, "duration_s": 3.39, "emotion": "serious", "text": "उघडा कचरा, वर रोज केळी... फुकट जेवण!"}, {"id": 107, "duration_s": 3.89, "emotion": "calm", "text": "जिथे फुकट जेवण, तिथे माकडं. सरळ हिशोब."}, {"id": 108, "duration_s": 3.28, "emotion": "proud", "text": "विज्ञान सांगतं, माकडं आपल्यावर प्रेम करतात!"}, {"id": 109, "duration_s": 3.22, "emotion": "sarcastic", "text": "ती जेवणावर प्रेम करतात. तुम्ही कचराकुंडीवर."}, {"id": 110, "duration_s": 4.63, "emotion": "serious", "text": "खाऊ घातलं, की माणसाची भीती संपते. मग हिसकावणं."}, {"id": 111, "duration_s": 2.91, "emotion": "serious", "text": "आणि आपल्या चिप्स-मिठाईने माकडं आजारीही पडतात."}, {"id": 112, "duration_s": 4.59, "emotion": "guilty", "text": "मी तर... शुभासाठी एक केळं दिलं होतं."}, {"id": 113, "duration_s": 2.82, "emotion": "guilty", "text": "रोज खाऊ घालायची कल्पना... माझी होती."}, {"id": 114, "duration_s": 2.72, "emotion": "guilty", "text": "मी तर फक्त... एक चिप."}, {"id": 115, "duration_s": 1.85, "emotion": "determined", "text": "बास! आता बघते मी."}, {"id": 116, "duration_s": 1.22, "emotion": "shouting", "text": "शेठ! झाडू!"}, {"id": 117, "duration_s": 4.24, "emotion": "tired", "text": "एक झाडू, दोन झाडू... फुकटात काम!"}, {"id": 118, "duration_s": 2.44, "emotion": "mischievous", "text": "आता केळं फक्त मी खाणार."}, {"id": 119, "duration_s": 4.61, "emotion": "calm", "text": "हॅलो, वन विभाग? कॉलनीत माकडं आहेत. कृपया या."}, {"id": 120, "duration_s": 3.81, "emotion": "calm", "text": "घाबरू नका. टीम आरामत, सुरक्षित नीन जाई."}, {"id": 121, "duration_s": 4.4, "emotion": "calm", "text": "मारानं नही, घाबरावानं नही, खाऊ नही. मायानं!"}, {"id": 122, "duration_s": 5.93, "emotion": "surprised", "text": "आज पहिल्यांदा... राजूची रिक्षा बंद पडली नाही."}, {"id": 123, "duration_s": 1.59, "emotion": "happy", "text": "चला, पोचलो! आता तू झोप."}, {"id": 124, "duration_s": 2.12, "emotion": "proud", "text": "टेन्शन नको! हे माझं ऐकतात!"}, {"id": 125, "duration_s": 4.768, "emotion": "happy", "text": "ऐकलंत? <laugh> माकडानं फोन परत केला!"}, {"id": 126, "duration_s": 3.77, "emotion": "proud", "text": "चौकशी... पूर्ण झाली!"}, {"id": 127, "duration_s": 2.12, "emotion": "embarrassed", "text": "ओह... तुम्ही दिव्याचा खांब! सॉरी."}, {"id": 128, "duration_s": 2.48, "emotion": "excited", "text": "कोलॅब! रिंकू अँड माकड!"}, {"id": 129, "duration_s": 2.94, "emotion": "stern_warning", "text": "पुढच्या वेळी... नेम चुकणार नाही."}, {"id": 130, "duration_s": 2.14, "emotion": "tender", "text": "शेपूट ठेव... आठवणीसाठी."}, {"id": 131, "duration_s": 3.22, "emotion": "tender", "text": "माकडं गेली आपल्या घरी... जंगलात."}, {"id": 132, "duration_s": 4.63, "emotion": "curious", "text": "पण आजोबा, माकडाला केळं देणं शुभ असतं ना?"}, {"id": 133, "duration_s": 2.96, "emotion": "calm", "text": "प्राण्याला खायला देणं प्रेम नव्हे..."}, {"id": 134, "duration_s": 1.82, "emotion": "tender", "text": "...जंगलाला जंगल राहू द्या."}, {"id": 135, "duration_s": 4.61, "emotion": "serious", "text": "कचरा झाकून ठेवा. माकड दिसलं, तर वन विभागाला फोन."}, {"id": 136, "duration_s": 3.58, "emotion": "stern_warning", "text": "आणि चिडवायचं नाही! समजलं? गप्प!"}, {"id": 137, "duration_s": 3.89, "emotion": "giggly", "text": "तर हे शुभ केळं... माझं!"}, {"id": 138, "duration_s": 3.57, "emotion": "determined", "text": "आता सराव! नेम परत मिळवायचा!"}, {"id": 139, "duration_s": 0.82, "emotion": "tired", "text": "आई!"}, {"id": 140, "duration_s": 1.66, "emotion": "proud", "text": "नेम परत!"}]