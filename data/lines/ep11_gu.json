[{"id": 1, "duration_s": 4.15, "emotion": "embarrassed", "text": "હા, આ હું જ છું. વિચારો છો, આ કેમ થયું?"}, {"id": 2, "duration_s": 3.87, "emotion": "mischievous", "text": "સવારથી શરૂ કરીએ. સોસાયટીમાં આવી... નવી બાઇક."}, {"id": 3, "duration_s": 4.81, "emotion": "proud", "text": "નવી બાઇક! એંસી હજારની... એક રૂપિયો ઓછો નહીં!"}, {"id": 4, "duration_s": 2.72, "emotion": "mischievous", "text": "મારા પપ્પાની બાઇક! તારા પપ્પા પાસે શું છે?"}, {"id": 5, "duration_s": 2.82, "emotion": "proud", "text": "મારા પપ્પા પાસે... મૂછ છે!"}, {"id": 6, "duration_s": 3.98, "emotion": "sarcastic", "text": "મૂછ તો મારા પપ્પાને પણ છે... બાઇક સાથે!"}, {"id": 7, "duration_s": 2.46, "emotion": "shocked", "text": "મૂછ?! આ તો મારી આબરૂનો સવાલ છે!"}, {"id": 8, "duration_s": 3.61, "emotion": "proud", "text": "સાંજે શેરીમાં મારી ગાડી દોડશે!"}, {"id": 9, "duration_s": 2.94, "emotion": "excited", "text": "સાંભળ્યું કે? જયેશ ગાડી લાવે છે... જહાજ જેવડી!"}, {"id": 10, "duration_s": 5.763, "emotion": "sarcastic", "text": "સાંજે ગાડી આવી... પણ ધક્કે ધક્કે!"}, {"id": 11, "duration_s": 1.48, "emotion": "tired", "text": "આવી ગઈ... મારી સિંહણ."}, {"id": 12, "duration_s": 3.48, "emotion": "sarcastic", "text": "આ ચાલે છે, કે આને પણ ધક્કો મારવો પડે?"}, {"id": 13, "duration_s": 3.59, "emotion": "proud", "text": "વિન્ટેજ છે! વિન્ટેજ એટલે... જૂનું એટલું સોનું!"}, {"id": 14, "duration_s": 3.85, "emotion": "comic_panic", "text": "હું... કોનાથી ના ડરું!"}, {"id": 15, "duration_s": 2.8, "emotion": "laughing", "text": "હા! સ્કૂટી પંદર હજારની, ધુમાડો ફ્રી!"}, {"id": 16, "duration_s": 0.99, "emotion": "stern_warning", "text": "શેઠ!"}, {"id": 17, "duration_s": 1.43, "emotion": "excited", "text": "ચાલી! પપ્પા, ચાલી!"}, {"id": 18, "duration_s": 3.21, "emotion": "serious", "text": "નજર લાગી ગઈ તો? લીંબુ-મરચું જોઈએ જ!"}, {"id": 19, "duration_s": 3.86, "emotion": "proud", "text": "આખી સોસાયટી જોશે! મારા દીકરાની ગાડી!"}, {"id": 20, "duration_s": 3.21, "emotion": "proud", "text": "આજે વાળ એવા સેટ છે... કે બાઇક પણ શરમાય."}, {"id": 21, "duration_s": 0.77, "emotion": "stern_warning", "text": "હેલ્મેટ પહેરો."}, {"id": 22, "duration_s": 2.56, "emotion": "pleading", "text": "હેલ્મેટથી વાળ બગડે, હેતલ! કદી નહીં!"}, {"id": 23, "duration_s": 1.53, "emotion": "determined", "text": "બસ! હવે હું જોઉં છું."}, {"id": 24, "duration_s": 1.781, "emotion": "comic_panic", "text": "હું કોનાથી ના ડરું... બસ ગરોળીથી!"}, {"id": 25, "duration_s": 4.4, "emotion": "sarcastic", "text": "ગરોળી ગઈ. હવે વાળ પણ જશે."}, {"id": 26, "duration_s": 3.05, "emotion": "giggly", "text": "પપ્પા, હેલ્મેટ ઊંધું છે!"}, {"id": 27, "duration_s": 2.17, "emotion": "proud", "text": "ખબર છે! આ પાછળવાળા માટે છે!"}, {"id": 28, "duration_s": 2.81, "emotion": "excited", "text": "લાઇવ ચાલુ છે! પપ્પાનું ઊંધું હેલ્મેટ!"}, {"id": 29, "duration_s": 2.79, "emotion": "sad", "text": "મારા વાળ... શહીદ થઈ ગયા."}, {"id": 30, "duration_s": 1.02, "emotion": "stern_warning", "text": "પટ્ટો પણ બાંધો."}, {"id": 31, "duration_s": 0.73, "emotion": "mischievous", "text": "કાલથી."}, {"id": 32, "duration_s": 2.2, "emotion": "excited", "text": "ચિંતા ના કરો! આજે હું શીખવાડીશ."}, {"id": 33, "duration_s": 2.47, "emotion": "proud", "text": "સ્કૂટીમાં ક્લચ નથી, બસ રેસ આપો!"}, {"id": 34, "duration_s": 1.59, "emotion": "sarcastic", "text": "ભાઈ, પહેલાં ચાલુ તો કરો!"}, {"id": 35, "duration_s": 1.86, "emotion": "excited", "text": "જુઓ! હું ઊડું છું!"}, {"id": 36, "duration_s": 2.25, "emotion": "proud", "text": "હીરો! દસ કિલોમીટર થઈ ગયા!"}, {"id": 37, "duration_s": 0.89, "emotion": "proud", "text": "હલ્યા વગર!"}, {"id": 38, "duration_s": 1.9, "emotion": "shouting", "text": "રેસ આપો! આગળ!"}, {"id": 39, "duration_s": 2.77, "emotion": "comic_panic", "text": "આગળ કેમ? ગાડી પાછળ જાય છે!"}, {"id": 40, "duration_s": 4.606, "emotion": "comic_panic", "text": "બ્રેક! બ્રેક! હાથવાળી બ્રેક!"}, {"id": 41, "duration_s": 1.82, "emotion": "embarrassed", "text": "હું ઠીક છું. ગાડી પણ ઠીક છે."}, {"id": 42, "duration_s": 2.82, "emotion": "serious", "text": "નજર લાગી ગઈ! મેં કહ્યું હતું ને?"}, {"id": 43, "duration_s": 3.36, "emotion": "sad", "text": "હાય હાય! લીંબુથી બ્રેક ના લાગે, બા."}, {"id": 44, "duration_s": 2.33, "emotion": "angry", "text": "લાલા! પહેલાં જાતે શીખ!"}, {"id": 45, "duration_s": 2.34, "emotion": "embarrassed", "text": "ચિંતા ના કરો... નિશાન પાક્કું છે એમનું."}, {"id": 46, "duration_s": 3.24, "emotion": "mischievous", "text": "એક આઇડિયા છે! પપ્પા કરતાં સારી તો અમે ચલાવીશું."}, {"id": 47, "duration_s": 2.57, "emotion": "excited", "text": "હું પાછળ બેસીશ... નાસ્તા સાથે."}, {"id": 48, "duration_s": 1.46, "emotion": "stern_warning", "text": "ચૂપ! હાથ હટાવ!"}, {"id": 49, "duration_s": 3.17, "emotion": "serious", "text": "બાળકો ગાડી નથી ચલાવતા. કદી નહીં. સમજ્યા?"}, {"id": 50, "duration_s": 4.33, "emotion": "serious", "text": "હું કહું? અઢાર વર્ષ પહેલાં ગાડી ચલાવવી મના છે."}, {"id": 51, "duration_s": 3.07, "emotion": "serious", "text": "પગ જમીન સુધી નથી પહોંચતા. બ્રેક કેમ મારશો?"}, {"id": 52, "duration_s": 1.27, "emotion": "proud", "text": "ચાવી જપ્ત!"}, {"id": 53, "duration_s": 2.76, "emotion": "excited", "text": "એક બીજો આઇડિયા છે! પપ્પાને અમે શીખવીશું!"}, {"id": 54, "duration_s": 3.39, "emotion": "tired", "text": "હું કોનાથી ના ડરું... ઝઝઝ..."}, {"id": 55, "duration_s": 4.48, "emotion": "proud", "text": "જુઓ સોસાયટી! જયેશ શાહ... ઓન ધ રોડ!"}, {"id": 56, "duration_s": 2.84, "emotion": "proud", "text": "હા શેઠ? સ્કૂટી હવા સાથે વાતો કરે છે!"}, {"id": 57, "duration_s": 2.72, "emotion": "sarcastic", "text": "હવા સાથે નહીં, મારી સાથે! ધ્યાન આપો!"}, {"id": 58, "duration_s": 2.56, "emotion": "happy", "text": "નમસ્તે મંજુલા માસી! હા શેઠ, બોલો!"}, {"id": 59, "duration_s": 4.18, "emotion": "sarcastic", "text": "એક હાથમાં ફોન, બીજામાં નમસ્તે... ગાડી કોના હાથમાં?"}, {"id": 60, "duration_s": 2.45, "emotion": "comic_panic", "text": "જયેશ! સામે જો! સામે!"}, {"id": 61, "duration_s": 2.76, "emotion": "curious", "text": "સામે? શેઠ, તમે તો ફોનમાં છો!"}, {"id": 62, "duration_s": 3.21, "emotion": "embarrassed", "text": "હું ઠીક છું! ગાડી પણ ઠીક છે! ડબ્બા...?"}, {"id": 63, "duration_s": 3.12, "emotion": "crying", "text": "મારા ડબ્બા! મારો શોકેસ!"}, {"id": 64, "duration_s": 2.77, "emotion": "shocked", "text": "ખાલી! આ પણ ખાલી!"}, {"id": 65, "duration_s": 3.13, "emotion": "sad", "text": "બધા ખાલી! એકેય મીઠાઈ નથી!"}, {"id": 66, "duration_s": 4.174, "emotion": "stern_warning", "text": "શેઠ! ડબ્બા ખાલી?"}, {"id": 67, "duration_s": 2.96, "emotion": "embarrassed", "text": "દેખાડા માટે છે! ભરેલા ડબ્બા મોંઘા પડે!"}, {"id": 68, "duration_s": 2.48, "emotion": "proud", "text": "જોયું? હેલ્મેટ પર બસ ડબ્બો પડ્યો."}, {"id": 69, "duration_s": 2.15, "emotion": "serious", "text": "વિચારો, હેલ્મેટ ના હોત તો?"}, {"id": 70, "duration_s": 1.08, "emotion": "happy", "text": "તો વાળ બચી જાત!"}, {"id": 71, "duration_s": 3.44, "emotion": "sarcastic", "text": "આટલા હંગામામાં પણ... હવાલદાર ઊંઘલાલ ઊંઘતા હતા."}, {"id": 72, "duration_s": 5.03, "emotion": "shouting", "text": "સમોસા? એટલે... તપાસ થશે!"}, {"id": 73, "duration_s": 5.9, "emotion": "stern_warning", "text": "પટ્ટો ખુલ્લો, હાથમાં ફોન... લાઇસન્સ બતાવ!"}, {"id": 74, "duration_s": 2.59, "emotion": "sarcastic", "text": "આ રેશન કાર્ડ છે."}, {"id": 75, "duration_s": 4.13, "emotion": "curious", "text": "આ જિમ કાર્ડ છે. તમે જિમ જાવ છો?"}, {"id": 76, "duration_s": 5.749, "emotion": "embarrassed", "text": "કાર્ડ જાય છે."}, {"id": 77, "duration_s": 2.59, "emotion": "shocked", "text": "આ... કોઈ છોકરાનું રિપોર્ટ કાર્ડ છે!"}, {"id": 78, "duration_s": 5.222, "emotion": "embarrassed", "text": "પપ્પા! એ મારું છે!"}, {"id": 79, "duration_s": 5.7, "emotion": "serious", "text": "લાઇસન્સ વગર, ફોન પર વાત... ચલણ ફાટશે!"}, {"id": 80, "duration_s": 3.86, "emotion": "pleading", "text": "હવાલદાર સાહેબ... ગરમાગરમ સમોસા? ચલણની જગ્યાએ?"}, {"id": 81, "duration_s": 4.4, "emotion": "stern_warning", "text": "લાંચ? એ પણ બટાકાની? બિલકુલ નહીં!"}, {"id": 82, "duration_s": 1.57, "emotion": "embarrassed", "text": "ભૂખ લાગી છે!"}, {"id": 83, "duration_s": 3.95, "emotion": "serious", "text": "પહેલાં આરટીઓ જાવ. લર્નર લાઇસન્સ કઢાવો."}, {"id": 84, "duration_s": 2.25, "emotion": "sarcastic", "text": "દંડ તમારા પોકેટ મનીમાંથી કપાશે."}, {"id": 85, "duration_s": 3.002, "emotion": "shocked", "text": "મારું પોકેટ મની? હું તો પપ્પા છું!"}, {"id": 86, "duration_s": 2.94, "emotion": "determined", "text": "પપ્પા, કાલથી... સોસાયટી ડ્રાઇવિંગ સ્કૂલ!"}, {"id": 87, "duration_s": 3.18, "emotion": "excited", "text": "અઠવાડિયા પછી... બાળકોની ડ્રાઇવિંગ સ્કૂલ!"}, {"id": 88, "duration_s": 4.28, "emotion": "excited", "text": "સોસાયટી ડ્રાઇવિંગ સ્કૂલ! આજે બધાની ટેસ્ટ થશે!"}, {"id": 89, "duration_s": 4.57, "emotion": "serious", "text": "હું કહું? ચાર નિયમ: હેલ્મેટ, બંને હાથ, ફોન નહીં, લાઇસન્સ."}, {"id": 90, "duration_s": 3.39, "emotion": "proud", "text": "અને બાળકો? ફક્ત તાળી પાડશે!"}, {"id": 91, "duration_s": 4.45, "emotion": "proud", "text": "આરટીઓથી લર્નર લાઇસન્સ! હવે હું અડધો ડ્રાઇવર છું!"}, {"id": 92, "duration_s": 3.12, "emotion": "proud", "text": "સાયન્સ કહે છે, હેલ્મેટથી મગજ ગરમ થાય."}, {"id": 93, "duration_s": 3.33, "emotion": "serious", "text": "સાયન્સ એ પણ કહે છે: હેલ્મેટથી માથું બચે."}, {"id": 94, "duration_s": 1.29, "emotion": "embarrassed", "text": "...હા, એ પણ."}, {"id": 95, "duration_s": 2.5, "emotion": "serious", "text": "મોહન ગુરુજી, પહેલો નિયમ: બ્રેક!"}, {"id": 96, "duration_s": 2.82, "emotion": "happy", "text": "બ્રેક? હા હા, લંચ બ્રેક!"}, {"id": 97, "duration_s": 1.14, "emotion": "shouting", "text": "ઇન્ડિકેટર!"}, {"id": 98, "duration_s": 2.62, "emotion": "proud", "text": "ઇન્ડિયા ગેટ? દિલ્હીમાં છે, બેટા!"}, {"id": 99, "duration_s": 1.0, "emotion": "shouting", "text": "લાઇસન્સ!"}, {"id": 100, "duration_s": 2.53, "emotion": "stern_warning", "text": "સાઇલન્સ? હા! બધા ચૂપ!"}, {"id": 101, "duration_s": 1.25, "emotion": "happy", "text": "ચાલો, જઈએ!"}, {"id": 102, "duration_s": 1.78, "emotion": "serious", "text": "આને પણ નજર લાગી ગઈ!"}, {"id": 103, "duration_s": 2.26, "emotion": "curious", "text": "પહેલો ઉમેદવાર... રિક્ષા?"}, {"id": 104, "duration_s": 3.04, "emotion": "excited", "text": "લાઇવ ચાલુ છે! સોસાયટીની મહા-ટેસ્ટ!"}, {"id": 105, "duration_s": 2.58, "emotion": "proud", "text": "ચિંતા ના કરો! હીરોને હેલ્મેટ ના જોઈએ!"}, {"id": 106, "duration_s": 3.98, "emotion": "stern_warning", "text": "હેલ્મેટ નહીં? બહાર!"}, {"id": 107, "duration_s": 7.28, "emotion": "serious", "text": "એક, બે, ત્રણ... ઊભા રહો, ફરી... એક..."}, {"id": 108, "duration_s": 1.63, "emotion": "angry", "text": "શેઠ! ટેસ્ટ છે, હિસાબ નહીં!"}, {"id": 109, "duration_s": 2.93, "emotion": "stern_warning", "text": "મારા ડબ્બા છે! એકેય ઓછો નહીં!"}, {"id": 110, "duration_s": 2.05, "emotion": "serious", "text": "સમય પૂરો! આગળનો!"}, {"id": 111, "duration_s": 2.58, "emotion": "excited", "text": "સાંભળ્યું કે? હું ટેસ્ટ આપું છું..."}, {"id": 112, "duration_s": 1.01, "emotion": "stern_warning", "text": "ફોન!"}, {"id": 113, "duration_s": 0.88, "emotion": "embarrassed", "text": "...પછી સંભળાવું છું."}, {"id": 114, "duration_s": 1.8, "emotion": "shocked", "text": "મમ્મી! તમે? સ્કૂટી પર?"}, {"id": 115, "duration_s": 2.39, "emotion": "proud", "text": "ઓગણીસો એંસીનું લાઇસન્સ, બેટા!"}, {"id": 116, "duration_s": 1.67, "emotion": "determined", "text": "આખી સોસાયટી જોશે!"}, {"id": 117, "duration_s": 3.53, "emotion": "proud", "text": "એમને પણ સ્કૂટી મેં જ શીખવી હતી!"}, {"id": 118, "duration_s": 2.13, "emotion": "excited", "text": "ફર્સ્ટ ક્લાસ! સો માંથી સો!"}, {"id": 119, "duration_s": 1.13, "emotion": "proud", "text": "હું કોનાથી ના ડરું!"}, {"id": 120, "duration_s": 1.73, "emotion": "giggly", "text": "પપ્પા... ફરી ઊંધું!"}, {"id": 121, "duration_s": 1.2, "emotion": "mischievous", "text": "હવે જોઉં છું..."}, {"id": 122, "duration_s": 2.98, "emotion": "determined", "text": "ગાડી ચલાવતી વખતે... ફોન નહીં!"}, {"id": 123, "duration_s": 0.94, "emotion": "tender", "text": "પહેલાં તમે."}, {"id": 124, "duration_s": 0.76, "emotion": "excited", "text": "પાસ!"}, {"id": 125, "duration_s": 3.45, "emotion": "serious", "text": "પણ અસલી લાઇસન્સ આરટીઓ આપશે, હું નહીં."}, {"id": 126, "duration_s": 2.91, "emotion": "excited", "text": "જયેશ પાસ! જયેશ પાસ!"}, {"id": 127, "duration_s": 3.55, "emotion": "excited", "text": "મારા પપ્પા પાસે હવે... મૂછ પણ, લાઇસન્સ પણ!"}, {"id": 128, "duration_s": 1.62, "emotion": "happy", "text": "શેઠ! તાળી!"}, {"id": 129, "duration_s": 3.28, "emotion": "excited", "text": "'પપ્પાની પહેલી રાઇડ'! દસ લાખ વ્યુઝ!"}, {"id": 130, "duration_s": 2.18, "emotion": "comic_panic", "text": "મારા વાળ! દસ લાખ લોકોએ જોયા?!"}, {"id": 131, "duration_s": 2.81, "emotion": "laughing", "text": "હા હા! હવે કાંસકીને હેલ્મેટ જોઈએ!"}, {"id": 132, "duration_s": 2.92, "emotion": "calm", "text": "જયેશ... એક વાત યાદ રાખજે."}, {"id": 133, "duration_s": 3.82, "emotion": "serious", "text": "હેલ્મેટ માથા માટે છે, વાળ માટે નહીં."}, {"id": 134, "duration_s": 4.6, "emotion": "calm", "text": "પટ્ટો બાંધો, બંને હાથ હેન્ડલ પર, ફોન ખિસ્સામાં."}, {"id": 135, "duration_s": 5.85, "emotion": "tender", "text": "અને બાળકો? ગાડી અઢારે, લાઇસન્સ સાથે."}, {"id": 136, "duration_s": 1.48, "emotion": "proud", "text": "ત્યાં સુધી... તાળી!"}, {"id": 137, "duration_s": 3.86, "emotion": "happy", "text": "સમજી ગયો, બાપુજી! માથું પહેલાં, વાળ પછી."}, {"id": 138, "duration_s": 2.08, "emotion": "excited", "text": "સ્માઇલ, પપ્પા!"}, {"id": 139, "duration_s": 0.99, "emotion": "shocked", "text": "મારી સિંહણ...?"}, {"id": 140, "duration_s": 4.24, "emotion": "sad", "text": "બેતાળીસ... ફરી ગણું?"}]