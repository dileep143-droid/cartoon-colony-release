[{"id": 1, "duration_s": 11.45, "emotion": "calm", "text": "দেওবৰৰ সন্ধিয়া। শইকীয়াৰ ঘৰত সত্যনাৰায়ণৰ পূজা।"}, {"id": 2, "duration_s": 4.12, "emotion": "excited", "text": "বনানা কিংডম! উ উ আ আ!"}, {"id": 3, "duration_s": 4.92, "emotion": "excited", "text": "খালি নিৰানব্বৈ টকা!"}, {"id": 4, "duration_s": 1.03, "emotion": "shocked", "text": "আকৌ কটা গ'ল?!"}, {"id": 5, "duration_s": 2.67, "emotion": "embarrassed", "text": "উ উ আ আ?"}, {"id": 6, "duration_s": 3.6, "emotion": "mischievous", "text": "এইবোৰ আৰম্ভ হৈছিল... তিনিদিন আগতে।"}, {"id": 7, "duration_s": 1.65, "emotion": "mischievous", "text": "কলৰ গেম এটাৰ পৰা।"}, {"id": 8, "duration_s": 4.551, "emotion": "angry", "text": "বুবু! এই ফোনে 'গুড মৰ্নিং' পঠিয়াবই নোখোজে!"}, {"id": 9, "duration_s": 2.24, "emotion": "proud", "text": "হ'ল। চৈধ্যটা গ্ৰুপত পঠিয়ালোঁ।"}, {"id": 10, "duration_s": 2.11, "emotion": "proud", "text": "গোটেই পাড়াই দেখিব!"}, {"id": 11, "duration_s": 2.25, "emotion": "excited", "text": "আইতা! ইয়াত বান্দৰৰ গেম আছে!"}, {"id": 12, "duration_s": 3.6, "emotion": "tired", "text": "পাঁচ মিনিট খেলা। মই খালি চকু মুদি..."}, {"id": 13, "duration_s": 2.22, "emotion": "excited", "text": "বনানা কিংডমলৈ স্বাগতম!"}, {"id": 14, "duration_s": 3.0, "emotion": "excited", "text": "কল শেষ! নিৰানব্বৈ টকাত এশটা কল!"}, {"id": 15, "duration_s": 2.66, "emotion": "curious", "text": "নিৰানব্বৈ টকা? সঁচাকৈয়ে?"}, {"id": 16, "duration_s": 2.208, "emotion": "mischievous", "text": "বোকা ল'ৰা! গেমৰ টকা নকলী!"}, {"id": 17, "duration_s": 1.315, "emotion": "mischievous", "text": "এটা বুদ্ধি আছে!"}, {"id": 18, "duration_s": 2.69, "emotion": "excited", "text": "শব্দ শুনিছ? আমি টকা পাইছোঁ!"}, {"id": 19, "duration_s": 2.2, "emotion": "laughing", "text": "আৰু এটা! হাহা! আৰু!"}, {"id": 20, "duration_s": 2.63, "emotion": "happy", "text": "গোটেই পাড়াই... দেখিব..."}, {"id": 21, "duration_s": 3.13, "emotion": "excited", "text": "সাবাস! তুমি কলৰ ৰাজ্যৰ ৰজা!"}, {"id": 22, "duration_s": 3.53, "emotion": "calm", "text": "সেই পুৱাতে। বাৰাণ্ডাত হৰিৰ আৰাম।"}, {"id": 23, "duration_s": 3.217, "emotion": "proud", "text": "মোৰ বেংক একাউণ্ট লোহাৰ চিন্দুক, ধনু!"}, {"id": 24, "duration_s": 1.36, "emotion": "sarcastic", "text": "চিন্দুকত কিবা আছে নে?"}, {"id": 25, "duration_s": 5.08, "emotion": "neutral", "text": "নিৰানব্বৈ কটা? যাওক... চাহৰ খৰচ।"}, {"id": 26, "duration_s": 4.17, "emotion": "shocked", "text": "চাৰিশ নিৰানব্বৈ?!"}, {"id": 27, "duration_s": 1.499, "emotion": "curious", "text": "দা, চিন্দুকত ফুটা!"}, {"id": 28, "duration_s": 1.5, "emotion": "panicked", "text": "নশ নিৰানব্বৈ! চোৰ নহয়, ডকাইত!"}, {"id": 29, "duration_s": 2.37, "emotion": "excited", "text": "চিন্তা নকৰিবা! ফোনটোকে বেচি দিয়া!"}, {"id": 30, "duration_s": 4.4, "emotion": "determined", "text": "মই কাকো নডৰোঁ! সেই চোৰটোক মই..."}, {"id": 31, "duration_s": 0.81, "emotion": "comic_panic", "text": "টি... টিকটিকি!"}, {"id": 32, "duration_s": 2.62, "emotion": "sarcastic", "text": "কাকো নডৰা? টিকটিকিকো নহয়?"}, {"id": 33, "duration_s": 2.58, "emotion": "embarrassed", "text": "সেইটো... চোৰৰ গুপ্তচৰ আছিল!"}, {"id": 34, "duration_s": 1.65, "emotion": "calm", "text": "বহু হ'ল! মই চাওঁ—"}, {"id": 35, "duration_s": 1.84, "emotion": "shouting", "text": "নালাগে! এয়া পুলিচ কেছ!"}, {"id": 36, "duration_s": 4.14, "emotion": "scared_whisper", "text": "হেল্ল', থানা? মোৰ একাউণ্ট... লুটি আছে!"}, {"id": 37, "duration_s": 2.66, "emotion": "serious", "text": "তদন্ত হ'ব! পূৰা তদন্ত!"}, {"id": 38, "duration_s": 3.03, "emotion": "panicked", "text": "চাহাব, চোৰ দেখাই নাযায়... টকাহে কাটে!"}, {"id": 39, "duration_s": 3.49, "emotion": "curious", "text": "হুম্... সূত্ৰৰ গোন্ধ।"}, {"id": 40, "duration_s": 3.83, "emotion": "serious", "text": "চোৰ কেতিয়া আহে? কি পিন্ধে? চাটনি ক'ত?"}, {"id": 41, "duration_s": 2.16, "emotion": "embarrassed", "text": "ভোক লাগিছে!"}, {"id": 42, "duration_s": 4.095, "emotion": "serious", "text": "লিখা... চোৰ... ভোকাতুৰ।"}, {"id": 43, "duration_s": 2.17, "emotion": "curious", "text": "ভোকাতুৰ? কেনেকৈ গম?"}, {"id": 44, "duration_s": 1.85, "emotion": "proud", "text": "পকৌৰা শেষ হ'ল নহয়!"}, {"id": 45, "duration_s": 2.67, "emotion": "pleading", "text": "চাহাব? চাহাব! চোৰ!"}, {"id": 46, "duration_s": 1.03, "emotion": "sarcastic", "text": "আৰু এটা পকৌৰা?"}, {"id": 47, "duration_s": 1.4, "emotion": "excited", "text": "তদন্ত হ'ব!"}, {"id": 48, "duration_s": 5.856, "emotion": "serious", "text": "থানাত গৈ ৰিপোৰ্ট খাম। মানে... লিখিম।"}, {"id": 49, "duration_s": 3.1, "emotion": "sad", "text": "উফ্... চোৰো ভোকাতুৰ... পুলিচো ভোকাতুৰ।"}, {"id": 50, "duration_s": 3.03, "emotion": "mischievous", "text": "এঘণ্টাতে... খবৰ গোটেই পাড়াত।"}, {"id": 51, "duration_s": 3.19, "emotion": "excited", "text": "শুনিছা নে? শইকীয়াৰ ফোনত চোৰ!"}, {"id": 52, "duration_s": 2.88, "emotion": "scared_whisper", "text": "শুনিছা নে? চোৰ অদৃশ্য!"}, {"id": 53, "duration_s": 2.61, "emotion": "shocked", "text": "শুনিছা নে? চোৰ বান্দৰ!"}, {"id": 54, "duration_s": 1.24, "emotion": "proud", "text": "বিজ্ঞানে কয়..."}, {"id": 55, "duration_s": 1.7, "emotion": "serious", "text": "চোৰ... বাওঁহাতী!"}, {"id": 56, "duration_s": 0.83, "emotion": "curious", "text": "কেনেকৈ?"}, {"id": 57, "duration_s": 2.41, "emotion": "proud", "text": "ধন সদায় বাওঁহাতেৰে যায়!"}, {"id": 58, "duration_s": 0.88, "emotion": "stern_warning", "text": "ধনৰাম!"}, {"id": 59, "duration_s": 3.73, "emotion": "serious", "text": "মোৰ বাওঁহাতে খালি গণে। এটকাও কম নহয়!"}, {"id": 60, "duration_s": 2.99, "emotion": "serious", "text": "নজৰ লাগিল! সকলো ফোনত নেমু-জলকীয়া!"}, {"id": 61, "duration_s": 1.71, "emotion": "excited", "text": "লাইভ চলিছে! পাড়াত চোৰ!"}, {"id": 62, "duration_s": 1.65, "emotion": "determined", "text": "বলা, যাওঁ! চোৰ ধৰিবলৈ!"}, {"id": 63, "duration_s": 2.48, "emotion": "embarrassed", "text": "উফ্... চোৰ খোজকাঢ়িয়েই ধৰিম।"}, {"id": 64, "duration_s": 2.04, "emotion": "comic_panic", "text": "হাজাৰ নশ নব্বৈ ন! ইয়াতে!"}, {"id": 65, "duration_s": 1.19, "emotion": "shocked", "text": "চোৰ আমাৰে মাজত!"}, {"id": 66, "duration_s": 1.42, "emotion": "shouting", "text": "তুমি! নহয়, তুমি!"}, {"id": 67, "duration_s": 1.46, "emotion": "shouting", "text": "চুপ!"}, {"id": 68, "duration_s": 1.052, "emotion": "curious", "text": "মই কওঁ? চোৰ হয়তো ঘৰৰেই..."}, {"id": 69, "duration_s": 17.46, "emotion": "shouting", "text": "নালাগে!"}, {"id": 70, "duration_s": 16.06, "emotion": "sarcastic", "text": "ল'ৰা-ছোৱালীয়ে বিজ্ঞান নুবুজে!"}, {"id": 71, "duration_s": 3.56, "emotion": "scared_whisper", "text": "ৰাতি দুই বজা। গোটেই পাড়া শুই আছে..."}, {"id": 72, "duration_s": 10.92, "emotion": "mischievous", "text": "...প্ৰায় গোটেই।"}, {"id": 73, "duration_s": 2.42, "emotion": "scared_whisper", "text": "আৰু এটা লেভেল... তাৰ পাছত শুম।"}, {"id": 74, "duration_s": 1.75, "emotion": "scared_whisper", "text": "চুপ! বান্দৰ ভোকাতুৰ।"}, {"id": 75, "duration_s": 12.53, "emotion": "scared_whisper", "text": "চোৰ... ঘৰৰ ভিতৰত!"}, {"id": 76, "duration_s": 1.55, "emotion": "scared_whisper", "text": "মই কাকো নডৰোঁ... মই কাকো..."}, {"id": 77, "duration_s": 1.5, "emotion": "scared_whisper", "text": "কোন? হাত ওপৰলৈ!"}, {"id": 78, "duration_s": 2.82, "emotion": "angry", "text": "ৰাতি টৰ্চ?!"}, {"id": 79, "duration_s": 1.13, "emotion": "embarrassed", "text": "আই... আপুনি চোৰ দেখিছে?"}, {"id": 80, "duration_s": 2.62, "emotion": "tired", "text": "চোৰ? ইয়াত মইহে আছোঁ।"}, {"id": 81, "duration_s": 1.98, "emotion": "relieved", "text": "হয়... আপুনি শুইছে।"}, {"id": 82, "duration_s": 4.15, "emotion": "serious", "text": "পাড়াত চোৰ ঘূৰি আছে। এটকাও কম নহয়!"}, {"id": 83, "duration_s": 0.91, "emotion": "excited", "text": "চিন্তা নালাগে!"}, {"id": 84, "duration_s": 3.86, "emotion": "mischievous", "text": "গেম হেক! আনলিমিটেড কল! মাত্ৰ দুশ টকাত!"}, {"id": 85, "duration_s": 3.07, "emotion": "curious", "text": "দুশ নাই... দুটা সমূচা আছে।"}, {"id": 86, "duration_s": 0.63, "emotion": "happy", "text": "চলিব! ডিল পাকা!"}, {"id": 87, "duration_s": 11.97, "emotion": "shocked", "text": "অ'! পেমেণ্টকে খালে!"}, {"id": 88, "duration_s": 3.049, "emotion": "stern_warning", "text": "গেম হেক? মই দেখুৱাওঁ আচল হেক?"}, {"id": 89, "duration_s": 2.568, "emotion": "pleading", "text": "বৌ... এয়া তো সমাজ সেৱা আছিল!"}, {"id": 90, "duration_s": 2.73, "emotion": "excited", "text": "দুশ? তাত মোৰ দহ শতাংশ!"}, {"id": 91, "duration_s": 0.93, "emotion": "stern_warning", "text": "ধনৰাম!"}, {"id": 92, "duration_s": 1.29, "emotion": "happy", "text": "হেক ভাল আছিল।"}, {"id": 93, "duration_s": 4.44, "emotion": "calm", "text": "তিনিদিন পাছত। সেই পূজা... য'ৰ পৰা আৰম্ভ কৰিছিলোঁ।"}, {"id": 94, "duration_s": 2.68, "emotion": "scared_whisper", "text": "আজি কোনো খৰচ নহয়। আজি পূজা।"}, {"id": 95, "duration_s": 4.3, "emotion": "scared_whisper", "text": "লাইভ চলিছে! শইকীয়াৰ পূজা, এক্সক্লুছিভ!"}, {"id": 96, "duration_s": 1.49, "emotion": "serious", "text": "আৰু তাৰ পাছত লীলাৱতীয়ে... প্ৰসাদ নাখালে।"}, {"id": 97, "duration_s": 1.302, "emotion": "curious", "text": "এইটো কোন অধ্যায়?"}, {"id": 98, "duration_s": 1.37, "emotion": "excited", "text": "এইটো... নতুন ভজন! কল ভজন!"}, {"id": 99, "duration_s": 1.1, "emotion": "shocked", "text": "নজৰ লাগিল!"}, {"id": 100, "duration_s": 0.723, "emotion": "excited", "text": "শুনিছা? আইতাৰ ডিস্কো ভজন!"}, {"id": 101, "duration_s": 0.44, "emotion": "excited", "text": "ধন্যবাদ! নিৰানব্বৈ টকা!"}, {"id": 102, "duration_s": 0.73, "emotion": "shocked", "text": "আকৌ কটা গ'ল?!"}, {"id": 103, "duration_s": 0.43, "emotion": "embarrassed", "text": "উ উ আ আ?"}, {"id": 104, "duration_s": 0.31, "emotion": "shouting", "text": "তদন্ত হ'ব!"}, {"id": 105, "duration_s": 0.55, "emotion": "shocked", "text": "আইতা?!"}, {"id": 106, "duration_s": 1.71, "emotion": "curious", "text": "মই কওঁ?"}, {"id": 107, "duration_s": 1.305, "emotion": "shouting", "text": "কোৱা!"}, {"id": 108, "duration_s": 0.628, "emotion": "serious", "text": "নিৰানব্বৈ... চাৰিশ নিৰানব্বৈ... নৱশ নিৰানব্বৈ..."}, {"id": 109, "duration_s": 5.63, "emotion": "serious", "text": "সকলো এই ফোনৰ পৰা। পেমেণ্ট হৰি খুড়াৰ কাৰ্ডৰ।"}, {"id": 110, "duration_s": 2.09, "emotion": "shocked", "text": "মোৰ কাৰ্ড? আইৰ ফোনত?"}, {"id": 111, "duration_s": 2.68, "emotion": "sarcastic", "text": "তইয়েই দিছিলি! বিজুলী বিল ভৰিবলৈ!"}, {"id": 112, "duration_s": 2.54, "emotion": "sad", "text": "উফ্... সেয়াও পাহৰিলোঁ।"}, {"id": 113, "duration_s": 3.77, "emotion": "guilty", "text": "দেউতা... আগৰ নিৰানব্বৈ... মই টিপিছিলোঁ।"}, {"id": 114, "duration_s": 3.18, "emotion": "guilty", "text": "আৰু চাৰিশ নিৰানব্বৈ... দুয়ো মিলি।"}, {"id": 115, "duration_s": 3.104, "emotion": "guilty", "text": "ভাবিছিলোঁ গেমৰ টকা নকলী।"}, {"id": 116, "duration_s": 3.267, "emotion": "serious", "text": "টকা আচল আছিল। কলহে নকলী।"}, {"id": 117, "duration_s": 3.44, "emotion": "guilty", "text": "আৰু ৰাতি দুইজনৰবোৰ... মই।"}, {"id": 118, "duration_s": 1.36, "emotion": "shocked", "text": "ৰাতি দুইজনত?!"}, {"id": 119, "duration_s": 1.59, "emotion": "pleading", "text": "বান্দৰ ভোকাতুৰ!"}, {"id": 120, "duration_s": 3.07, "emotion": "proud", "text": "দেখিলা! মই কৈছিলোঁ, চোৰ ভোকাতুৰ!"}, {"id": 121, "duration_s": 2.65, "emotion": "proud", "text": "আৰু আইতা বাওঁহাতী! বিজ্ঞানে কয়!"}, {"id": 122, "duration_s": 2.25, "emotion": "excited", "text": "শুনিছা নে? চোৰ... আইতা ওলাল!"}, {"id": 123, "duration_s": 2.94, "emotion": "proud", "text": "মই চম্ভালোঁ! মই কাকো—"}, {"id": 124, "duration_s": 0.77, "emotion": "determined", "text": "বহু হ'ল! মই চাওঁ।"}, {"id": 125, "duration_s": 1.86, "emotion": "serious", "text": "এক - প্ৰতি পেমেণ্টত পিন।"}, {"id": 126, "duration_s": 1.46, "emotion": "serious", "text": "দুই - মাহৰ সীমা।"}, {"id": 127, "duration_s": 2.23, "emotion": "serious", "text": "তিনি - কাৰ্ড আতৰোৱা, অটো-পে বন্ধ।"}, {"id": 128, "duration_s": 2.06, "emotion": "shocked", "text": "ইমানেই? দহ ছেকেণ্ড?"}, {"id": 129, "duration_s": 1.26, "emotion": "pleading", "text": "আৰু... আমাৰ গেম?"}, {"id": 130, "duration_s": 2.34, "emotion": "calm", "text": "দিনে ত্ৰিশ মিনিট। পাছত ক্ৰিকেট!"}, {"id": 131, "duration_s": 1.31, "emotion": "excited", "text": "ক্ৰিকেটৰ পাছত সমূচা?"}, {"id": 132, "duration_s": 1.43, "emotion": "worried", "text": "আৰু যি টকা গ'ল?"}, {"id": 133, "duration_s": 3.6, "emotion": "calm", "text": "কোম্পানীক অভিযোগ পঠাম। আৰু আগলৈ... পিন!"}, {"id": 134, "duration_s": 4.36, "emotion": "calm", "text": "ল'ৰা-ছোৱালীক ফোনতকৈ... আমাৰ সংগ লাগে।"}, {"id": 135, "duration_s": 3.1, "emotion": "serious", "text": "ফোনত পিন... ল'ৰা-ছোৱালীৰ সময়।"}, {"id": 136, "duration_s": 5.02, "emotion": "laughing", "text": "আৰু আইতাৰ ফোনত ডবল পিন!"}, {"id": 137, "duration_s": 2.9, "emotion": "proud", "text": "মই কাকো নডৰোঁ! বল দিয়া!"}, {"id": 138, "duration_s": 4.032, "emotion": "mischievous", "text": "বাওঁহাতী। বিজ্ঞানে কয়।"}, {"id": 139, "duration_s": 3.204, "emotion": "sad", "text": "উফ্... ঠিক জোতাৰ নিচিনা।"}, {"id": 140, "duration_s": 2.04, "emotion": "laughing", "text": "আইতাৰ নিশানা অব্যৰ্থ!"}]