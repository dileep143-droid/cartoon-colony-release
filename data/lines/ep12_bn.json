[{"id": 1, "duration_s": 4.64, "emotion": "mischievous", "text": "সকাল সাতটা... পুরো পাড়ার ফোন একসঙ্গে বেজে উঠল।"}, {"id": 2, "duration_s": 4.01, "emotion": "angry", "text": "হিসেবি হারেন লোন নিসে! আদায় হইবে!"}, {"id": 3, "duration_s": 3.75, "emotion": "excited", "text": "হারেনের খবর... আমায়? ওমা!"}, {"id": 4, "duration_s": 1.61, "emotion": "scared_whisper", "text": "আমি বাড়ি নেই... আমি চাল!"}, {"id": 5, "duration_s": 1.08, "emotion": "stern_warning", "text": "হারেন!"}, {"id": 6, "duration_s": 4.046, "emotion": "mischievous", "text": "সব শুরু আগের দিন... মাত্র দু'মিনিটে।"}, {"id": 7, "duration_s": 4.8, "emotion": "serious", "text": "আটানব্বই, নিরানব্বই... আবার গোনো। এক পয়সাও কম নয়!"}, {"id": 8, "duration_s": 4.88, "emotion": "worried", "text": "দোকান ছোট, ভুঁড়ি বড়! দোকান বাড়াতে হবে!"}, {"id": 9, "duration_s": 3.7, "emotion": "mischievous", "text": "বড় দোকান? আমি এখন থেকেই জায়গা করছি!"}, {"id": 10, "duration_s": 2.27, "emotion": "excited", "text": "দুই মিনিটে লোন! কাগজ লাগবো না!"}, {"id": 11, "duration_s": 3.2, "emotion": "excited", "text": "দু'মিনিট? চা ঠান্ডা হইতেও তো বেশি লাগে!"}, {"id": 12, "duration_s": 2.35, "emotion": "curious", "text": "হারেনকাকু, লোন মানে কী?"}, {"id": 13, "duration_s": 4.31, "emotion": "proud", "text": "লোন মানে... অন্যের টাকা, আমার দোকান!"}, {"id": 14, "duration_s": 1.91, "emotion": "calm", "text": "খালি কন্টাক্টসের অনুমতি দ্যান।"}, {"id": 15, "duration_s": 3.26, "emotion": "happy", "text": "কন্টাক্টস? নাও! বিনিপয়সায়!"}, {"id": 16, "duration_s": 1.18, "emotion": "calm", "text": "আর ফটো গ্যালারি।"}, {"id": 17, "duration_s": 3.13, "emotion": "giggly", "text": "ছবিও নাও! আমার মতো হ্যান্ডসাম কে?"}, {"id": 18, "duration_s": 1.72, "emotion": "calm", "text": "শর্তগুলান পইড়া লইয়েন।"}, {"id": 19, "duration_s": 2.81, "emotion": "serious", "text": "আমি বলি? শর্ত পড়তে হয়, হারেনকাকু!"}, {"id": 20, "duration_s": 3.77, "emotion": "sarcastic", "text": "পড়তে সময় লাগবে। আর সময়ই তো টাকা!"}, {"id": 21, "duration_s": 2.34, "emotion": "excited", "text": "অভিনন্দন! লোন মঞ্জুর!"}, {"id": 22, "duration_s": 3.82, "emotion": "shocked", "text": "কুড়ি হাজার চাইলাম... তেরো হাজার এল?"}, {"id": 23, "duration_s": 1.99, "emotion": "happy", "text": "সাত হাজার প্রসেসিং ফি, কর্তা!"}, {"id": 24, "duration_s": 3.928, "emotion": "worried", "text": "আর সাত দিনে ফেরত... ত্রিশ হাজার!"}, {"id": 25, "duration_s": 3.37, "emotion": "proud", "text": "সাত দিনে তো দোকান ডবল!"}, {"id": 26, "duration_s": 3.32, "emotion": "proud", "text": "আজ থেকে হারেন... লোনওয়ালা হারেন!"}, {"id": 27, "duration_s": 4.24, "emotion": "happy", "text": "লন? বাহ! ঘাস কোথায় লাগাবে, হারেন?"}, {"id": 28, "duration_s": 4.43, "emotion": "sarcastic", "text": "ঘাস না, মাস্টারমশাই! লোন! টাকা!"}, {"id": 29, "duration_s": 3.1, "emotion": "tired", "text": "হারেনবাবু, ফ্রিজ বড় নাকি দুয়ার ছোট বাহে?"}, {"id": 30, "duration_s": 6.046, "emotion": "serious", "text": "হারেন, এত টাকা কোথা থেকে এল?"}, {"id": 31, "duration_s": 3.07, "emotion": "happy", "text": "ভগবান দিয়েছেন... দু'মিনিটে।"}, {"id": 32, "duration_s": 2.49, "emotion": "excited", "text": "দু'মিনিটে টাকা? এ তো আমার স্বপ্ন!"}, {"id": 33, "duration_s": 3.31, "emotion": "excited", "text": "লাইভ চলছে! হারেনকাকুর নতুন ফ্রিজ!"}, {"id": 34, "duration_s": 3.95, "emotion": "mischievous", "text": "সেই রাতে... সুদ জেগে রইল। হারেনও।"}, {"id": 35, "duration_s": 2.85, "emotion": "worried", "text": "রাত বারোটা... একুশ হাজার!"}, {"id": 36, "duration_s": 2.18, "emotion": "panicked", "text": "একটা... বাইশ হাজার!"}, {"id": 37, "duration_s": 2.33, "emotion": "comic_panic", "text": "এটা সুদ, না বিদ্যুতের মিটার?"}, {"id": 38, "duration_s": 3.79, "emotion": "scared_whisper", "text": "গোপু! সুদ ঘণ্টায় ঘণ্টায় বাড়ছে!"}, {"id": 39, "duration_s": 2.64, "emotion": "proud", "text": "বিজ্ঞান বলে... সুদও রাতে ঘুমোয়।"}, {"id": 40, "duration_s": 3.34, "emotion": "crying", "text": "সুদ ঘুমোয় না, গোপু... আমি ঘুমোই না!"}, {"id": 41, "duration_s": 2.485, "emotion": "tired", "text": "হারেন... হিসেব কাল।"}, {"id": 42, "duration_s": 4.05, "emotion": "mischievous", "text": "অ্যাপ হারেনের সব কন্টাক্টে ফোন লাগাল।"}, {"id": 43, "duration_s": 1.11, "emotion": "proud", "text": "কে রে? আমি কাউকে ডরাই না!"}, {"id": 44, "duration_s": 3.14, "emotion": "shouting", "text": "হারেনের টাকা দ্যান, নাইলে সগাকে ছবি পাঠামু!"}, {"id": 45, "duration_s": 1.8, "emotion": "sarcastic", "text": "ফোন গো, টিকটিকি নয়!"}, {"id": 46, "duration_s": 3.07, "emotion": "angry", "text": "সবার ফোন এল, আমার না? হারেন আমার নম্বর রাখেনি?"}, {"id": 47, "duration_s": 6.19, "emotion": "proud", "text": "এসেছে! হ্যালো? হ্যাঁ, আমিই... সারা পাড়া দেখবে!"}, {"id": 48, "duration_s": 1.54, "emotion": "worried", "text": "ফোনে নজর লেগেছে!"}, {"id": 49, "duration_s": 4.323, "emotion": "shouting", "text": "তদন্ত হবে! ...কার?"}, {"id": 50, "duration_s": 4.23, "emotion": "tired", "text": "ফোনও বাজল, অটোও থামল। চলো..."}, {"id": 51, "duration_s": 0.49, "emotion": "stern_warning", "text": "চোপ!"}, {"id": 52, "duration_s": 2.45, "emotion": "excited", "text": "ত্রিশ বছর হারেনের কোনও খবর পাইনি!"}, {"id": 53, "duration_s": 2.68, "emotion": "mischievous", "text": "শুনেছ গো? হারেন লোন নিয়েছে!"}, {"id": 54, "duration_s": 2.67, "emotion": "sarcastic", "text": "জানি। আমারও ফোন এসেছিল।"}, {"id": 55, "duration_s": 1.56, "emotion": "excited", "text": "শুনেছ গো? হারেন—"}, {"id": 56, "duration_s": 2.97, "emotion": "calm", "text": "জানি। লেবুও বেঁধে দিয়েছি।"}, {"id": 57, "duration_s": 1.98, "emotion": "pleading", "text": "শুনেছ...?"}, {"id": 58, "duration_s": 2.58, "emotion": "giggly", "text": "জানি মাসিমা! সারা পাড়া জানে!"}, {"id": 59, "duration_s": 2.91, "emotion": "mischievous", "text": "হ্যালো, লোনওয়ালা? হারেন আর কী কী নিয়েছে?"}, {"id": 60, "duration_s": 2.07, "emotion": "surprised", "text": "মাসিমা, আপনি আদায় খরবেন?"}, {"id": 61, "duration_s": 2.16, "emotion": "giggly", "text": "না বাবা, শুধু খবর নেব।"}, {"id": 62, "duration_s": 2.16, "emotion": "angry", "text": "হারেন! সারা পাড়া কী বলছে?!"}, {"id": 63, "duration_s": 1.76, "emotion": "serious", "text": "হারেন কোথায়?"}, {"id": 64, "duration_s": 1.61, "emotion": "giggly", "text": "চালের বস্তায়।"}, {"id": 65, "duration_s": 2.43, "emotion": "scared_whisper", "text": "ভবানী... আমি বস্তায় নেই।"}, {"id": 66, "duration_s": 2.39, "emotion": "guilty", "text": "মাত্র দু'মিনিটের লোন ছিল, ভবানী।"}, {"id": 67, "duration_s": 3.56, "emotion": "sarcastic", "text": "দু'মিনিটের লোন... আর পুরো পাড়ায় ফোন?"}, {"id": 68, "duration_s": 3.55, "emotion": "pleading", "text": "ওরা আমার ছবি নিয়েছে। সবাইকে পাঠাবে!"}, {"id": 69, "duration_s": 3.0, "emotion": "laughing", "text": "এ তো বাবার জিলিপি-খাওয়া ছবি!"}, {"id": 70, "duration_s": 1.92, "emotion": "determined", "text": "এবার হিসেব আমি করব।"}, {"id": 71, "duration_s": 2.26, "emotion": "excited", "text": "চিন্তা নেই! আমার কাছে আরেক অ্যাপ!"}, {"id": 72, "duration_s": 2.18, "emotion": "proud", "text": "লোন শোধ করতে... নতুন লোন!"}, {"id": 73, "duration_s": 2.11, "emotion": "excited", "text": "সত্যি? কত মিনিটে?"}, {"id": 74, "duration_s": 1.29, "emotion": "comic_panic", "text": "...আমি তো মজা করছিলাম।"}, {"id": 75, "duration_s": 3.69, "emotion": "angry", "text": "ধারের ওপর ধার? দাঁড়া, ভোম্বল!"}, {"id": 76, "duration_s": 3.54, "emotion": "embarrassed", "text": "ঠাকুমার টিপ... কখনও ফসকায় না।"}, {"id": 77, "duration_s": 1.99, "emotion": "determined", "text": "অনেক হয়েছে! আমি দেখছি।"}, {"id": 78, "duration_s": 2.86, "emotion": "serious", "text": "আগে প্রমাণ। প্রতিটা হুমকির স্ক্রিনশট।"}, {"id": 79, "duration_s": 3.1, "emotion": "calm", "text": "তারপর কন্টাক্টস, ছবির অনুমতি... বন্ধ।"}, {"id": 80, "duration_s": 1.86, "emotion": "shocked", "text": "কিন্তু বিনিপয়সায় দিলাম!"}, {"id": 81, "duration_s": 0.4, "emotion": "shouting", "text": "চোপ!"}, {"id": 82, "duration_s": 2.41, "emotion": "excited", "text": "একটা বুদ্ধি আছে! আসল ব্যাংকে চলো!"}, {"id": 83, "duration_s": 3.43, "emotion": "proud", "text": "আমি বলি? এক-নয়-তিন-শূন্যে সাইবার নালিশ!"}, {"id": 84, "duration_s": 2.93, "emotion": "worried", "text": "ব্যাংক? সেখানে বসারও ফি লাগবে!"}, {"id": 85, "duration_s": 1.542, "emotion": "stern_warning", "text": "চলো!"}, {"id": 86, "duration_s": 1.08, "emotion": "happy", "text": "চলো, যাই!"}, {"id": 87, "duration_s": 5.23, "emotion": "sarcastic", "text": "হারেন, ভুঁড়িটা একটু সরাও... সুদসমেত।"}, {"id": 88, "duration_s": 1.91, "emotion": "tired", "text": "উফ! জরুরি কাজেই অটো থামে।"}, {"id": 89, "duration_s": 2.05, "emotion": "stern_warning", "text": "জোর লাগাও! আমি গুনছি।"}, {"id": 90, "duration_s": 2.92, "emotion": "scared_whisper", "text": "আগে বলে দিন... বসার ফি নেই তো?"}, {"id": 91, "duration_s": 4.48, "emotion": "calm", "text": "ম্যাডাম, অ্যাপ রোজ সুদ বাড়ায় আর সবাইকে হুমকি দেয়।"}, {"id": 92, "duration_s": 4.16, "emotion": "serious", "text": "আমি বলি? অ্যাপকে কন্টাক্টস-ছবি কক্ষনো নয়।"}, {"id": 93, "duration_s": 3.42, "emotion": "serious", "text": "ধার শুধু ব্যাংক, বা আরবিআই-নথিভুক্ত সংস্থা।"}, {"id": 94, "duration_s": 3.23, "emotion": "guilty", "text": "আর আমার অ্যাপ... নথিভুক্ত ছিল?"}, {"id": 95, "duration_s": 6.55, "emotion": "proud", "text": "হুমকিতে ফোন এক-নয়-তিন-শূন্য, সাইবারক্রাইম ডট গভ ডট ইন।"}, {"id": 96, "duration_s": 3.6, "emotion": "calm", "text": "সাইবার ক্রাইম হেল্পলাইন। কন বাহে, কী হইসে?"}, {"id": 97, "duration_s": 3.36, "emotion": "serious", "text": "লোন অ্যাপ হুমকি দিচ্ছে। সব স্ক্রিনশট আমাদের কাছে।"}, {"id": 98, "duration_s": 4.23, "emotion": "calm", "text": "ভালো খরসেন। অভিযোগ নথিভুক্ত, নম্বর মেসেজে আসিবে।"}, {"id": 99, "duration_s": 1.92, "emotion": "worried", "text": "আর... কোনও ফি?"}, {"id": 100, "duration_s": 0.86, "emotion": "calm", "text": "কোনো ফি নাই।"}, {"id": 101, "duration_s": 6.828, "emotion": "happy", "text": "দোকানের জন্য ঠিক লোন, ঠিক কাগজে।"}, {"id": 102, "duration_s": 1.67, "emotion": "happy", "text": "ম্যাডাম, আপনার পরামর্শ... এক পয়সাও কম নয়!"}, {"id": 103, "duration_s": 3.38, "emotion": "calm", "text": "সন্ধ্যায় হারেন সত্যনারায়ণের পুজো বসালেন।"}, {"id": 104, "duration_s": 3.22, "emotion": "pleading", "text": "হে ভগবান, আজ যেন ফোন না বাজে।"}, {"id": 105, "duration_s": 5.19, "emotion": "serious", "text": "কথার প্রথম অধ্যায়... মন দিয়ে শুনুন।"}, {"id": 106, "duration_s": 2.21, "emotion": "scared_whisper", "text": "এল রে... আদায়ওলারা!"}, {"id": 107, "duration_s": 3.17, "emotion": "excited", "text": "প্ল্যান মনে আছে? তিন... দুই... এক!"}, {"id": 108, "duration_s": 1.84, "emotion": "calm", "text": "হারেন পুজো করছেন!"}, {"id": 109, "duration_s": 2.21, "emotion": "angry", "text": "পুজো? টাকা কবে দিবেন?!"}, {"id": 110, "duration_s": 4.77, "emotion": "proud", "text": "এক-নয়-তিন-শূন্যে অভিযোগ হয়েছে। পুরো পাড়া সাক্ষী!"}, {"id": 111, "duration_s": 2.93, "emotion": "proud", "text": "আর আমি... কাউকে ডরাই না!"}, {"id": 112, "duration_s": 4.34, "emotion": "sarcastic", "text": "হুমকিকে ডরাওনি... টিকটিকিকে ডরালে।"}, {"id": 113, "duration_s": 2.73, "emotion": "mischievous", "text": "বাবা, নাম কী তোমার? কাল পুরো পাড়া জানবে।"}, {"id": 114, "duration_s": 2.06, "emotion": "serious", "text": "সব ফোনে নজর লেগেছে!"}, {"id": 115, "duration_s": 4.06, "emotion": "excited", "text": "প্রসাদ? ...তদন্ত হবে!"}, {"id": 116, "duration_s": 5.07, "emotion": "guilty", "text": "খিদে পেয়েছে! ঠাকুর ক্ষমা করবেন।"}, {"id": 117, "duration_s": 3.32, "emotion": "excited", "text": "লাইভ চলছে! বিশ্বের প্রথম অ্যান্টি-লোন আরতি!"}, {"id": 118, "duration_s": 0.62, "emotion": "shouting", "text": "চোপ!"}, {"id": 119, "duration_s": 2.79, "emotion": "calm", "text": "তো... কথার প্রথম অধ্যায়।"}, {"id": 120, "duration_s": 2.17, "emotion": "loving", "text": "হারেন, এবার তুমি একা নও।"}, {"id": 121, "duration_s": 2.61, "emotion": "tender", "text": "পুরো পাড়া... আর কোনও ফি নেই।"}, {"id": 122, "duration_s": 3.71, "emotion": "calm", "text": "পরদিন সকালে... পাড়ায় একটাও ফোন বাজল না।"}, {"id": 123, "duration_s": 4.71, "emotion": "proud", "text": "তদন্ত শেষ! সাইবার সেল অভিযোগ নিয়েছে।"}, {"id": 124, "duration_s": 5.2, "emotion": "serious", "text": "অ্যাপ রিপোর্ট হয়ে গেছে। হুমকির ফোন বন্ধ।"}, {"id": 125, "duration_s": 2.64, "emotion": "excited", "text": "তা... ত্রিশ হাজার দিতে হবে না?"}, {"id": 126, "duration_s": 3.9, "emotion": "serious", "text": "হুমকির সুদ নয়। যা পেয়েছ, তাই ফেরত দাও।"}, {"id": 127, "duration_s": 4.91, "emotion": "sad", "text": "তেরো হাজার... পুরো। এক পয়সাও কম নয়..."}, {"id": 128, "duration_s": 3.67, "emotion": "determined", "text": "কন্টাক্টস, ছবি আমার। অ্যাপের নয়!"}, {"id": 129, "duration_s": 3.43, "emotion": "proud", "text": "বিজ্ঞান বলে, অ্যাপ ডিলিট তো লোনও ডিলিট!"}, {"id": 130, "duration_s": 3.91, "emotion": "serious", "text": "আমি বলি? আসল ধার শোধ দেব। হুমকি সইব না।"}, {"id": 131, "duration_s": 4.62, "emotion": "proud", "text": "আর দোকান বাড়বে... ব্যাংক থেকে, ঠিক কাগজে!"}, {"id": 132, "duration_s": 4.385, "emotion": "guilty", "text": "দাদু, দু'মিনিটের লোন... দু'দিন কাঁদিয়ে গেল।"}, {"id": 133, "duration_s": 3.15, "emotion": "calm", "text": "তাড়াহুড়োর টাকা... অনেকক্ষণ কাঁদায়।"}, {"id": 134, "duration_s": 5.9, "emotion": "serious", "text": "ধার শুধু ব্যাংক বা আরবিআই-নথিভুক্ত জায়গা থেকে। শর্ত পড়ে।"}, {"id": 135, "duration_s": 8.04, "emotion": "stern_warning", "text": "অ্যাপকে কন্টাক্টস-ছবি নয়। হুমকিতে এক-নয়-তিন-শূন্য।"}, {"id": 136, "duration_s": 2.64, "emotion": "happy", "text": "আর 'সময়ই টাকা' নয়... 'পড়াই টাকা'!"}, {"id": 137, "duration_s": 2.67, "emotion": "happy", "text": "একটা শব্দও বাদ নয়... পুরোটা পড়ব!"}, {"id": 138, "duration_s": 1.44, "emotion": "excited", "text": "দুই মিনিটে লোন!"}, {"id": 139, "duration_s": 2.88, "emotion": "happy", "text": "পাড়ার গল্প... আবার দেখা হবে!"}]