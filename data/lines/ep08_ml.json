[{"id": 1, "duration_s": 6.01, "emotion": "calm", "text": "മേയ് മാസത്തിലെ ചൂട്. രാവിലെ ഏഴ് മണി. എല്ലാം ശാന്തം..."}, {"id": 2, "duration_s": 6.61, "emotion": "happy", "text": "തണുത്ത തണുത്ത വെള്ളം... ചൂടോടെ ഞാൻ! ലാ ലാ ലാ!"}, {"id": 3, "duration_s": 1.75, "emotion": "curious", "text": "അയ്യോ? മഴ നിന്നോ?"}, {"id": 4, "duration_s": 2.59, "emotion": "comic_panic", "text": "വെള്ളം! കണ്ണിൽ സോപ്പ്! ശോഭേ!"}, {"id": 5, "duration_s": 3.12, "emotion": "surprised", "text": "അമ്മേ, ഇവിടെയും വെള്ളമില്ല! വെറും കാറ്റ്!"}, {"id": 6, "duration_s": 3.2, "emotion": "serious", "text": "പൈപ്പിന് സുഖമില്ല. പനിയല്ല, ദാഹമാ."}, {"id": 7, "duration_s": 1.75, "emotion": "excited", "text": "കേട്ടോ? എന്റെ പൈപ്പും ചുമയ്ക്കുന്നു!"}, {"id": 8, "duration_s": 2.89, "emotion": "angry", "text": "ഒരു തുള്ളിയോ? ഒരു മാസത്തെ ബിൽ അടച്ചതാ!"}, {"id": 9, "duration_s": 3.2, "emotion": "worried", "text": "കണ്ണ് തട്ടി! പൈപ്പിന് കണ്ണ് തട്ടി!"}, {"id": 10, "duration_s": 3.21, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... ടാപ്പ് ഉറക്കമാ."}, {"id": 11, "duration_s": 2.13, "emotion": "excited", "text": "ലൈവ് ആണ്! കോളനി മുഴുവൻ വരണ്ടു!"}, {"id": 12, "duration_s": 3.22, "emotion": "shouting", "text": "ആരാ വെള്ളം നിർത്തിയത്? എനിക്ക് ആരെയും പേടിയില്ല!"}, {"id": 13, "duration_s": 2.92, "emotion": "mischievous", "text": "അങ്ങനെ കോളനിയിലെ വെള്ളം മുടങ്ങി!"}, {"id": 14, "duration_s": 1.77, "emotion": "shouting", "text": "ടാങ്കർ വന്നേ! ടാങ്കർ വന്നേ!"}, {"id": 15, "duration_s": 2.29, "emotion": "determined", "text": "വഴി മാറ്! സോപ്പുള്ള മനുഷ്യൻ വരുന്നു!"}, {"id": 16, "duration_s": 3.47, "emotion": "proud", "text": "എന്റെ ബക്കറ്റ്! ഇറക്കുമതി! ഒരു തുള്ളി കുറയില്ല!"}, {"id": 17, "duration_s": 2.76, "emotion": "happy", "text": "വാ, പോകാം! ഡ്രം നിറച്ചു വരാം!"}, {"id": 18, "duration_s": 1.82, "emotion": "sarcastic", "text": "ഒരു മീറ്റർ. റെക്കോർഡാ!"}, {"id": 19, "duration_s": 2.82, "emotion": "shouting", "text": "ഒരു വീടിന് രണ്ട്! തള്ളല്ലേ മക്കളേ!"}, {"id": 20, "duration_s": 1.51, "emotion": "determined", "text": "മതി! ഇനി ഞാൻ നോക്കിക്കോളാം."}, {"id": 21, "duration_s": 4.01, "emotion": "surprised", "text": "കുട്ടപ്പണ്ണാ, ഇത് ബക്കറ്റാ?"}, {"id": 22, "duration_s": 1.62, "emotion": "mischievous", "text": "ബക്കറ്റിന്റെ വല്യേട്ടൻ!"}, {"id": 23, "duration_s": 3.99, "emotion": "stern_warning", "text": "കാശു കുട്ടപ്പാ! നാട്ടുകാർ കാണുന്നുണ്ട്!"}, {"id": 24, "duration_s": 2.69, "emotion": "sad", "text": "വിശക്കുന്നു... ദാഹവും."}, {"id": 25, "duration_s": 3.01, "emotion": "calm", "text": "തീർന്ന്! അടുത്ത ടാങ്കർ ഉച്ചയ്ക്ക് ഒണ്ട്."}, {"id": 26, "duration_s": 2.7, "emotion": "excited", "text": "കേട്ടോ? ടാങ്കർ... മൂന്ന് ദിവസം കഴിഞ്ഞ്!"}, {"id": 27, "duration_s": 3.62, "emotion": "excited", "text": "ഹലോ ഗോപിയേട്ടാ, കേട്ടോ? ഹലോ ബാബുവേട്ടാ, കേട്ടോ?"}, {"id": 28, "duration_s": 1.21, "emotion": "serious", "text": "പ്രാവേ... കേട്ടോ?"}, {"id": 29, "duration_s": 4.38, "emotion": "panicked", "text": "മൂന്ന് ദിവസമോ? എന്റമ്മോ... മൂന്ന് മണിക്കൂറിൽ എല്ലാം തീരും!"}, {"id": 30, "duration_s": 3.39, "emotion": "comic_panic", "text": "മൂന്ന് മണിക്കൂറോ? അല്ല... മൂന്ന് മിനിറ്റ്! ഓടിക്കോ!"}, {"id": 31, "duration_s": 3.87, "emotion": "mischievous", "text": "ഉച്ചയ്ക്കത്തെ ടാങ്കർ, മൂന്ന് മിനിറ്റിൽ മൂന്ന് ദിവസമായി."}, {"id": 32, "duration_s": 3.17, "emotion": "mischievous", "text": "കുപ്പി ഇരുപത് രൂപ! വേഗം, വില കൂടാൻ പോകുന്നു!"}, {"id": 33, "duration_s": 4.65, "emotion": "mischievous", "text": "നാൽപ്പത്! വില കാലാവസ്ഥ പോലെയാ, ഇടയ്ക്കിടെ മാറും!"}, {"id": 34, "duration_s": 5.58, "emotion": "proud", "text": "പന്ത്രണ്ട് കുപ്പി! ഒന്ന് കുളിക്കാൻ... പതിനൊന്ന് വീണ്ടും കുളിക്കാൻ!"}, {"id": 35, "duration_s": 3.184, "emotion": "curious", "text": "ഒരു കുപ്പിക്ക് എത്രയാ?"}, {"id": 36, "duration_s": 0.84, "emotion": "proud", "text": "നൂറ്!"}, {"id": 37, "duration_s": 2.49, "emotion": "calm", "text": "എന്നാൽ വേണ്ട. കാറ്റിന് കാശില്ലല്ലോ."}, {"id": 38, "duration_s": 3.11, "emotion": "mischievous", "text": "ടെൻഷനടിക്കണ്ട! കുപ്പിയെല്ലാം എനിക്ക് താ, ഇരട്ടി വിലയ്ക്ക് വിൽക്കാം!"}, {"id": 39, "duration_s": 3.42, "emotion": "sarcastic", "text": "ഞാൻ തന്നെ മൂന്നിരട്ടിക്കാ!"}, {"id": 40, "duration_s": 2.189, "emotion": "stern_warning", "text": "കുട്ടപ്പാ!"}, {"id": 41, "duration_s": 3.26, "emotion": "embarrassed", "text": "ഇരുപത്... ഇരുപതാ!"}, {"id": 42, "duration_s": 2.22, "emotion": "excited", "text": "ലൈവ് ആണ്! വെള്ളത്തിന് പൊന്നിനേക്കാൾ വില!"}, {"id": 43, "duration_s": 4.01, "emotion": "proud", "text": "പന്ത്രണ്ട് കുപ്പി വെള്ളം! ഇന്ന് രാജാവിനെപ്പോലെ കുളിക്കും!"}, {"id": 44, "duration_s": 2.91, "emotion": "stern_warning", "text": "രാജാവല്ല, പ്രജയെപ്പോലെ. ഒരു മഗ്ഗ്."}, {"id": 45, "duration_s": 2.41, "emotion": "pleading", "text": "പകുതി മഗ്ഗോ? ഇത്രയും സോപ്പിന്?"}, {"id": 46, "duration_s": 2.99, "emotion": "proud", "text": "ഞങ്ങടെ കാലത്ത് അരമഗ്ഗിൽ കല്യാണ പാർട്ടി കുളിക്കും!"}, {"id": 47, "duration_s": 3.23, "emotion": "proud", "text": "ശരി! ആരെയും പേടിയില്ല! അരമഗ്ഗ്, വാ!"}, {"id": 48, "duration_s": 2.51, "emotion": "determined", "text": "നിൽക്ക്! വീഴുന്ന വെള്ളം തുളസിക്ക്."}, {"id": 49, "duration_s": 1.73, "emotion": "surprised", "text": "അച്ഛാ, സോപ്പ് വെള്ളം കുടിച്ചു!"}, {"id": 50, "duration_s": 3.25, "emotion": "stern_warning", "text": "രണ്ടാം മഗ്ഗോ? നാട്ടുകാർ മുഴുവൻ കാണും!"}, {"id": 51, "duration_s": 0.8, "emotion": "shocked", "text": "പ... പല്ലി!"}, {"id": 52, "duration_s": 2.29, "emotion": "embarrassed", "text": "പേടിയല്ല... അതിന്റെ ദാഹം കണ്ടിട്ടാ!"}, {"id": 53, "duration_s": 2.59, "emotion": "worried", "text": "അമ്മേ, രാത്രി ടാങ്ക് നിറഞ്ഞിരുന്നല്ലോ."}, {"id": 54, "duration_s": 1.13, "emotion": "curious", "text": "എങ്ങോട്ടു പോയി?"}, {"id": 55, "duration_s": 2.33, "emotion": "excited", "text": "ഒരു ഐഡിയ ഉണ്ട്! വാട്ടർ ഡിറ്റക്ടീവ്!"}, {"id": 56, "duration_s": 1.48, "emotion": "excited", "text": "ഡിറ്റക്ടീവ്സ്, റെഡി?"}, {"id": 57, "duration_s": 2.5, "emotion": "stern_warning", "text": "മിണ്ടരുത്! ഡിറ്റക്ടീവുകൾ മിണ്ടില്ല."}, {"id": 58, "duration_s": 2.59, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? വെള്ളത്തെ പിന്തുടരൂ... കള്ളനെ കിട്ടും!"}, {"id": 59, "duration_s": 0.85, "emotion": "serious", "text": "ഒന്ന്!"}, {"id": 60, "duration_s": 3.818, "emotion": "serious", "text": "രണ്ട്!"}, {"id": 61, "duration_s": 3.5, "emotion": "happy", "text": "ഈ ചോരുന്ന ടാപ്പ്... ഏറ്റവും മധുരം!"}, {"id": 62, "duration_s": 2.35, "emotion": "shocked", "text": "പതിനാല് പൈപ്പ് ചോരുന്നു! പതിനാല്!"}, {"id": 63, "duration_s": 3.51, "emotion": "mischievous", "text": "ഈ വെള്ളപ്പുഴ... എങ്ങോട്ടാ ഒഴുകുന്നത്?"}, {"id": 64, "duration_s": 3.95, "emotion": "proud", "text": "ഷിബു കാർ വാഷ്! കാർ, സ്കൂട്ടർ, എരുമ... എല്ലാം കഴുകും!"}, {"id": 65, "duration_s": 1.9, "emotion": "angry", "text": "മിണ്ടരുത്! പൈപ്പ് അടയ്ക്ക്!"}, {"id": 66, "duration_s": 3.68, "emotion": "mischievous", "text": "അടയ്ക്കാനോ? ഇത് ബിസിനസാ! വെള്ളം ഫ്രീ, ലാഭം മുഴുവൻ!"}, {"id": 67, "duration_s": 3.01, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? ഈ പൈപ്പ് അഞ്ച് മണി മുതൽ ഓടുന്നു."}, {"id": 68, "duration_s": 1.55, "emotion": "shocked", "text": "അതുകൊണ്ട് ടാങ്ക് കാലി!"}, {"id": 69, "duration_s": 3.33, "emotion": "calm", "text": "ടെൻഷനടിക്കണ്ട! വെള്ളം എന്റേതല്ല, നാടിന്റേതാ!"}, {"id": 70, "duration_s": 1.76, "emotion": "angry", "text": "അതുകൊണ്ടല്ലേ ടെൻഷൻ!"}, {"id": 71, "duration_s": 2.66, "emotion": "shouting", "text": "അന്വേഷിക്കും! ആരാത്?"}, {"id": 72, "duration_s": 5.19, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... കാറ്റ് ഒപ്പം വെള്ളം, തുല്യം മഴ!"}, {"id": 73, "duration_s": 0.54, "emotion": "stern_warning", "text": "ശ്ശ്! നോക്കാം."}, {"id": 74, "duration_s": 2.73, "emotion": "excited", "text": "ലൈവ് ആണ്! കോളനിയിലെ ആദ്യ മഴ!"}, {"id": 75, "duration_s": 4.34, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... മഴ ശാസ്ത്രജ്ഞർക്ക് മാത്രം."}, {"id": 76, "duration_s": 5.507, "emotion": "sad", "text": "പണ്ഡിറ്റ് പ്രകാശ് കുളിച്ചോ? ഞാൻ ഇപ്പോഴും സോപ്പിൽ!"}, {"id": 77, "duration_s": 3.11, "emotion": "laughing", "text": "<laugh> നാട്ടുകാർ കാണുന്നുണ്ട്... പ്രകാശിന്റെ കുളി!"}, {"id": 78, "duration_s": 4.789, "emotion": "sarcastic", "text": "ഒരു ബക്കറ്റ് കൂടി പോയി. പതിനഞ്ചാമത്തെ പൈപ്പ്!"}, {"id": 79, "duration_s": 2.24, "emotion": "embarrassed", "text": "ഇത്തിരി കാലിബ്രേഷൻ കൂടി ബാക്കി."}, {"id": 80, "duration_s": 1.809, "emotion": "panicked", "text": "കേട്ടോ? അവസാന ടാങ്കർ!"}, {"id": 81, "duration_s": 4.29, "emotion": "excited", "text": "അങ്ങനെ തുടങ്ങി... കോളനിയിലെ ഏറ്റവും വലിയ ബക്കറ്റ് ഓട്ടം!"}, {"id": 82, "duration_s": 1.25, "emotion": "determined", "text": "ആദ്യ ബക്കറ്റ് എന്റേത്!"}, {"id": 83, "duration_s": 1.25, "emotion": "excited", "text": "വാ, പോകാം!"}, {"id": 84, "duration_s": 1.68, "emotion": "sad", "text": "അയ്യോ... ഇന്നും?"}, {"id": 85, "duration_s": 2.23, "emotion": "curious", "text": "ആരേലും പറയോ... ഞാനെവിടെ?"}, {"id": 86, "duration_s": 1.1, "emotion": "angry", "text": "ബക്കറ്റിൽ നിന്നിറങ്ങ്!"}, {"id": 87, "duration_s": 1.82, "emotion": "sarcastic", "text": "ബക്കറ്റല്ല... വല്യേട്ടനാ!"}, {"id": 88, "duration_s": 4.85, "emotion": "shouting", "text": "അന്വേഷണം ഉണ്ടാകും! നിൽക്ക്! അല്ല, പോ! അല്ല, നിൽക്ക്!"}, {"id": 89, "duration_s": 2.43, "emotion": "excited", "text": "ലൈവ്! ബക്കറ്റ് ബ്ലോക്ക്, നൂറ് മീറ്റർ നീളം!"}, {"id": 90, "duration_s": 2.82, "emotion": "angry", "text": "നാട്ടുകാർ കാണുന്നുണ്ട്... ആരും അനങ്ങുന്നില്ലല്ലോ!"}, {"id": 91, "duration_s": 1.87, "emotion": "excited", "text": "പ്രാവേ, കേട്ടോ...? അയ്യോ!"}, {"id": 92, "duration_s": 0.85, "emotion": "shouting", "text": "മിണ്ടല്ലേ!!!"}, {"id": 93, "duration_s": 3.58, "emotion": "serious", "text": "വെള്ളത്തിനായി വഴക്ക്... പൈപ്പുകൾ ഇപ്പോഴും ചോരുന്നു!"}, {"id": 94, "duration_s": 1.96, "emotion": "determined", "text": "ഞാൻ പറയട്ടെ? കണക്ക് നോക്ക്!"}, {"id": 95, "duration_s": 3.1, "emotion": "stern_warning", "text": "ശാന്തം! ഇന്നത്തെ ക്ലാസ്... വെള്ളം!"}, {"id": 96, "duration_s": 3.59, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? ഒരു പൈപ്പ്, സെക്കൻഡിൽ ഒരു തുള്ളി."}, {"id": 97, "duration_s": 1.55, "emotion": "excited", "text": "ഉള്ളിവട? എവിടെ?"}, {"id": 98, "duration_s": 1.56, "emotion": "sarcastic", "text": "വടയല്ല, തുള്ളി!"}, {"id": 99, "duration_s": 4.88, "emotion": "proud", "text": "ഒരു പൈപ്പ്, ഒരു മാസം... അറുപത് ബക്കറ്റ്!"}, {"id": 100, "duration_s": 2.77, "emotion": "shocked", "text": "<gasp> അറുപതോ? എന്റമ്മോ!"}, {"id": 101, "duration_s": 5.29, "emotion": "shocked", "text": "പതിനാല് ഗുണം അറുപത്... എണ്ണൂറ്റി നാൽപത് ബക്കറ്റ്!"}, {"id": 102, "duration_s": 1.95, "emotion": "mischievous", "text": "ഇത്രയും കുപ്പി വിറ്റിരുന്നെങ്കിൽ..."}, {"id": 103, "duration_s": 0.84, "emotion": "stern_warning", "text": "കുട്ടപ്പാ!"}, {"id": 104, "duration_s": 4.48, "emotion": "serious", "text": "ഷിബു മാമന്റെ പൈപ്പ്... മണിക്കൂറിൽ അമ്പത് ബക്കറ്റ്!"}, {"id": 105, "duration_s": 3.3, "emotion": "embarrassed", "text": "ടെൻഷൻ... ഇത്തിരി ഇത്തിരി ഉണ്ട്."}, {"id": 106, "duration_s": 2.56, "emotion": "calm", "text": "മാഡം, ലൈനിൽ പണിയാ ട്ടാ. വൈന്നേരം വെള്ളം വരും."}, {"id": 107, "duration_s": 2.13, "emotion": "embarrassed", "text": "വൈകീട്ടോ? മൂന്ന് ദിവസമല്ലേ?"}, {"id": 108, "duration_s": 2.21, "emotion": "sarcastic", "text": "മൂന്നാ? ആര് പറഞ്ഞൂട്ടാ?"}, {"id": 109, "duration_s": 3.13, "emotion": "guilty", "text": "അപ്പോ വെള്ളം നിന്നതല്ല... നമ്മൾ തന്നെ ഒഴുക്കിക്കളഞ്ഞതാ!"}, {"id": 110, "duration_s": 3.14, "emotion": "serious", "text": "പതിനാല് പൈപ്പ്, ഒരു ഹോസ്, ഒരു ബാത്ത്ടബ്..."}, {"id": 111, "duration_s": 1.13, "emotion": "mischievous", "text": "പിന്നെ ഒരു സോപ്പച്ഛൻ!"}, {"id": 112, "duration_s": 1.94, "emotion": "determined", "text": "മതി! ഇനി എല്ലാവരും ശ്രദ്ധിക്കും."}, {"id": 113, "duration_s": 0.96, "emotion": "determined", "text": "പത്ത് സെക്കൻഡ്."}, {"id": 114, "duration_s": 2.52, "emotion": "proud", "text": "ഒമ്പത് സെക്കൻഡ്! നാടു കാണട്ടെ!"}, {"id": 115, "duration_s": 4.06, "emotion": "proud", "text": "ഇതൊക്കെ എനിക്ക് പുഷ്പം പോലെയാ!"}, {"id": 116, "duration_s": 1.82, "emotion": "relieved", "text": "ആഹാ... കുളിച്ചു! ഒടുവിൽ കുളിച്ചു!"}, {"id": 117, "duration_s": 1.94, "emotion": "excited", "text": "കേട്ടോ? സുരേഷേട്ടൻ കുളിച്ചു!"}, {"id": 118, "duration_s": 3.74, "emotion": "happy", "text": "ഒരു ബക്കറ്റ്, ഒരു തുണി... കാർ വെട്ടിത്തിളങ്ങി!"}, {"id": 119, "duration_s": 1.33, "emotion": "laughing", "text": "<laugh> എരുമയും! ബക്കറ്റീന്ന്!"}, {"id": 120, "duration_s": 5.77, "emotion": "proud", "text": "ചോർന്ന വെള്ളവും എന്റേത്! ഒരു തുള്ളി പാഴാക്കില്ല!"}, {"id": 121, "duration_s": 3.36, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... ടാപ്പ് നന്നാക്കൂ."}, {"id": 122, "duration_s": 2.93, "emotion": "surprised", "text": "പ്രകാശേട്ടാ... ആദ്യമായി ശരി!"}, {"id": 123, "duration_s": 2.44, "emotion": "sad", "text": "മധുര ടാപ്പ്... റിട്ടയർ ചെയ്തു."}, {"id": 124, "duration_s": 2.33, "emotion": "happy", "text": "മഴവെള്ളം, നേരെ ഡ്രമ്മിൽ!"}, {"id": 125, "duration_s": 2.55, "emotion": "loving", "text": "ഇനി മഴയ്ക്ക് കണ്ണ് തട്ടില്ല."}, {"id": 126, "duration_s": 2.96, "emotion": "excited", "text": "ലൈവ് ആണ്! ഹാഷ്ടാഗ് തുള്ളി രക്ഷിക്കൂ!"}, {"id": 127, "duration_s": 3.72, "emotion": "happy", "text": "അന്ന് പതിനാല് പൈപ്പ് നന്നായി... ഒരച്ഛൻ കുളിച്ചു."}, {"id": 128, "duration_s": 3.29, "emotion": "calm", "text": "വൈകുന്നേരമായി... പൈപ്പുകളിൽ വീണ്ടും വെള്ളം വന്നു."}, {"id": 129, "duration_s": 3.2, "emotion": "proud", "text": "ഇന്നു മുതൽ സുരേഷ് ഒരു ബക്കറ്റിൽ കുളിക്കും!"}, {"id": 130, "duration_s": 0.65, "emotion": "stern_warning", "text": "പകുതി!"}, {"id": 131, "duration_s": 2.14, "emotion": "calm", "text": "പലതുള്ളി പെരുവെള്ളം..."}, {"id": 132, "duration_s": 2.89, "emotion": "serious", "text": "...പല തുള്ളി പോയാൽ വരൾച്ചയും."}, {"id": 133, "duration_s": 5.158, "emotion": "serious", "text": "ചോരുന്ന ടാപ്പ് ഇന്ന് നന്നാക്കണം... നാളെയല്ല."}, {"id": 134, "duration_s": 2.87, "emotion": "calm", "text": "ആകാശത്തെ വെള്ളം... ഡ്രമ്മിൽ."}, {"id": 135, "duration_s": 0.96, "emotion": "determined", "text": "കാർ ബക്കറ്റിൽ!"}, {"id": 136, "duration_s": 1.08, "emotion": "determined", "text": "പൈപ്പ് തുറന്നിടില്ല!"}, {"id": 137, "duration_s": 2.32, "emotion": "proud", "text": "മഴവെള്ളം... ടെറസ്സിൽ നിന്ന് ഡ്രമ്മിൽ!"}, {"id": 138, "duration_s": 1.637, "emotion": "excited", "text": "ഹായ്, മഴ!"}, {"id": 139, "duration_s": 3.7, "emotion": "excited", "text": "ഫ്രീ ഷവർ! ഈശ്വരാ, മഴ പെയ്യിക്ക്!"}]