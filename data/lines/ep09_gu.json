[{"id": 1, "duration_s": 3.877, "emotion": "excited", "text": "વરસાદની મોસમ... ને આખી સોસાયટી બોર!"}, {"id": 2, "duration_s": 2.58, "emotion": "excited", "text": "વરસાદી સેલ્ફી! હવે લાખો લાઇક્સ આવશે!"}, {"id": 3, "duration_s": 2.37, "emotion": "sad", "text": "ઝીરો લાઇક્સ? મમ્મીએ પણ નહીં!"}, {"id": 4, "duration_s": 2.42, "emotion": "proud", "text": "ફૂડ ફોટો! સમોસા તો વાયરલ જ!"}, {"id": 5, "duration_s": 1.55, "emotion": "embarrassed", "text": "ભૂખ લાગી હતી!"}, {"id": 6, "duration_s": 2.44, "emotion": "excited", "text": "કૅપ્ટન મગરની નાવ! સૌથી ફાસ્ટ!"}, {"id": 7, "duration_s": 3.15, "emotion": "shocked", "text": "અરે! મારો કૅપ્ટન મગર!"}, {"id": 8, "duration_s": 1.69, "emotion": "stern_warning", "text": "ચૂપ! ગટર પાસે નહીં!"}, {"id": 9, "duration_s": 1.67, "emotion": "mischievous", "text": "ટેન્શન નહીં! આઈડિયા!"}, {"id": 10, "duration_s": 2.58, "emotion": "mischievous", "text": "થોડો મોટો... થોડો વધુ... બસ!"}, {"id": 11, "duration_s": 3.6, "emotion": "excited", "text": "દસ મિનિટ, દસ હજાર લાઇક્સ! હું સ્ટાર છું!"}, {"id": 12, "duration_s": 1.48, "emotion": "proud", "text": "અસલી મગરની જરૂર કોને છે?"}, {"id": 13, "duration_s": 2.16, "emotion": "scared_whisper", "text": "સાંભળ્યું કે? ગટરમાં મગર!"}, {"id": 14, "duration_s": 2.5, "emotion": "proud", "text": "ચાલીસ ગ્રુપ! એક શ્વાસે! મારો રેકોર્ડ!"}, {"id": 15, "duration_s": 2.99, "emotion": "serious", "text": "દસ સેકન્ડમાં... આખી સોસાયટીને ખબર!"}, {"id": 16, "duration_s": 1.97, "emotion": "excited", "text": "હા, એ જ! બંનેને કહું છું!"}, {"id": 17, "duration_s": 3.05, "emotion": "panicked", "text": "ગુરુજી! મગરમચ્છ!"}, {"id": 18, "duration_s": 2.46, "emotion": "calm", "text": "મચ્છર? તો મચ્છરદાની લગાવો!"}, {"id": 19, "duration_s": 3.86, "emotion": "shocked", "text": "મગર... મચ્છ? મારું ધોતિયું!"}, {"id": 20, "duration_s": 3.63, "emotion": "serious", "text": "નજર લાગી ગઈ! મગરને પણ લીંબુ-મરચું!"}, {"id": 21, "duration_s": 4.29, "emotion": "proud", "text": "સાયન્સ કહે છે, મગર વરસાદમાં ફક્ત ચંપલ ખાય!"}, {"id": 22, "duration_s": 3.56, "emotion": "panicked", "text": "બારણું બંધ! બારી બંધ! બાથરૂમની ગટર પણ બંધ!"}, {"id": 23, "duration_s": 1.73, "emotion": "excited", "text": "આઈડિયા! ચાલો મગર જોવા!"}, {"id": 24, "duration_s": 2.46, "emotion": "stern_warning", "text": "આઈડિયા ખિસ્સામાં રાખ. લેસન કાઢ."}, {"id": 25, "duration_s": 3.49, "emotion": "proud", "text": "ડરો મા! હું કોઈથી ના ડરું!"}, {"id": 26, "duration_s": 3.38, "emotion": "determined", "text": "મગર આવ્યો તો... સીધો પેવેલિયન મોકલીશ!"}, {"id": 27, "duration_s": 1.61, "emotion": "comic_panic", "text": "મ... મ... મગરનું બચ્ચું!"}, {"id": 28, "duration_s": 1.55, "emotion": "determined", "text": "બસ! હવે હું જોઉં છું."}, {"id": 29, "duration_s": 3.3, "emotion": "scared_whisper", "text": "હેતલ... ગયો? પાકું ગયો?"}, {"id": 30, "duration_s": 3.67, "emotion": "proud", "text": "મારો દીકરો સિંહ છે! આખી સોસાયટી જોશે!"}, {"id": 31, "duration_s": 3.13, "emotion": "determined", "text": "આજ રાત્રે... હું ગેટ પર પહેરો ભરીશ!"}, {"id": 32, "duration_s": 1.9, "emotion": "guilty", "text": "એ... ખરેખર... એ ફોટો તો..."}, {"id": 33, "duration_s": 1.97, "emotion": "angry", "text": "ચૂપ! અપશુકન ના બોલ!"}, {"id": 34, "duration_s": 2.35, "emotion": "giggly", "text": "પપ્પા... એક દેડકાથી?"}, {"id": 35, "duration_s": 4.07, "emotion": "scared_whisper", "text": "રાતના બાર વાગ્યે... પટેલ ગેટ પર... પહેરો."}, {"id": 36, "duration_s": 4.28, "emotion": "tired", "text": "હું કોઈથી ના ડરું... સિવાય ઊંઘ!"}, {"id": 37, "duration_s": 0.67, "emotion": "comic_panic", "text": "કો... કોણ છે? સામે આવો!"}, {"id": 38, "duration_s": 3.88, "emotion": "relieved", "text": "<sigh> બિલાડી માસી! ડરાવ્યો!"}, {"id": 39, "duration_s": 1.19, "emotion": "comic_panic", "text": "મ... મ... મગર!"}, {"id": 40, "duration_s": 3.69, "emotion": "curious", "text": "જયેશ બેટા, અડધી રાતે ગેટ પર કેમ લટકે છે?"}, {"id": 41, "duration_s": 3.23, "emotion": "embarrassed", "text": "યોગા, ગુરુજી! આને કહેવાય... ગેટ-આસન!"}, {"id": 42, "duration_s": 1.91, "emotion": "excited", "text": "સાંભળ્યું? જયેશ ગેટ પર લટક્યો!"}, {"id": 43, "duration_s": 3.48, "emotion": "excited", "text": "મગર-પ્રૂફ ગમબૂટ! કરડે તો દાંત તૂટે!"}, {"id": 44, "duration_s": 2.74, "emotion": "proud", "text": "કાલ સુધી સો ના. આજે ત્રણસો!"}, {"id": 45, "duration_s": 2.88, "emotion": "sarcastic", "text": "શેઠ, મગર કરતાં દાંત તો તમારા મોટા!"}, {"id": 46, "duration_s": 1.6, "emotion": "proud", "text": "એક રૂપિયો પણ ઓછો નહીં!"}, {"id": 47, "duration_s": 3.14, "emotion": "proud", "text": "એણે એક? મને બે!"}, {"id": 48, "duration_s": 1.01, "emotion": "angry", "text": "તો મને ત્રણ!"}, {"id": 49, "duration_s": 3.49, "emotion": "proud", "text": "મને ચાર! આખી સોસાયટી જોશે!"}, {"id": 50, "duration_s": 4.08, "emotion": "happy", "text": "ચાલ, નીકળીએ! ઉઘાડા પગ સૌથી સસ્તા!"}, {"id": 51, "duration_s": 0.94, "emotion": "calm", "text": "શેઠ! બીજો માલ લાવું?"}, {"id": 52, "duration_s": 6.12, "emotion": "happy", "text": "એક, બે, ત્રણ... ફરીથી... એક, બે..."}, {"id": 53, "duration_s": 3.48, "emotion": "excited", "text": "બૂટમાં બિસ્કિટ! શું ઓફર છે!"}, {"id": 54, "duration_s": 2.39, "emotion": "angry", "text": "બિસ્કિટ અલગથી! વીસ રૂપિયા!"}, {"id": 55, "duration_s": 2.86, "emotion": "guilty", "text": "સાંભળો બધા... એ મગર ખરેખર..."}, {"id": 56, "duration_s": 2.08, "emotion": "shouting", "text": "નેક્સ્ટ! લાઇનમાં આવો!"}, {"id": 57, "duration_s": 7.55, "emotion": "serious", "text": "બપોરના બે વાગ્યે... મગરની શોધ, લાઇવ!"}, {"id": 58, "duration_s": 1.38, "emotion": "excited", "text": "હેલો ફ્રેન્ડ્સ! લાઇવ ચાલુ છે! ક્રોક હન્ટ!"}, {"id": 59, "duration_s": 1.54, "emotion": "proud", "text": "સાયન્સ કહે છે, મગર સીટીથી આવે."}, {"id": 60, "duration_s": 3.51, "emotion": "pleading", "text": "શેઠ, તમે આગળ રહો. તમે... મોટા છો."}, {"id": 61, "duration_s": 2.23, "emotion": "angry", "text": "હું? મારા બૂટ ત્રણસોના છે!"}, {"id": 62, "duration_s": 1.73, "emotion": "pleading", "text": "બધા સાંભળો! એ મગર અસલી નથી..."}, {"id": 63, "duration_s": 1.36, "emotion": "shocked", "text": "એ... એ... હલે છે!"}, {"id": 64, "duration_s": 1.08, "emotion": "panicked", "text": "મગર!!!"}, {"id": 65, "duration_s": 1.04, "emotion": "sad", "text": "...નથી."}, {"id": 66, "duration_s": 1.74, "emotion": "surprised", "text": "અરે! એ તો મારું ચંપલ છે!"}, {"id": 67, "duration_s": 3.12, "emotion": "proud", "text": "જોયું? સાયન્સ! મગરે ઓકી દીધું!"}, {"id": 68, "duration_s": 1.49, "emotion": "pleading", "text": "હંસા! ખેંચો!"}, {"id": 69, "duration_s": 1.96, "emotion": "excited", "text": "સાંભળ્યું? મગરે ચંપલ ઓક્યું!"}, {"id": 70, "duration_s": 3.41, "emotion": "excited", "text": "વ્યૂઝ ડબલ! ચંપલ પણ વાયરલ!"}, {"id": 71, "duration_s": 3.643, "emotion": "guilty", "text": "<sigh> મારો ફોટો... હવે ચંપલથી પણ ફેમસ."}, {"id": 72, "duration_s": 2.1, "emotion": "shouting", "text": "હવાલદાર ઊંઘલાલ! મગર!"}, {"id": 73, "duration_s": 2.43, "emotion": "sarcastic", "text": "ભજિયાં, ઊંઘલાલ!"}, {"id": 74, "duration_s": 1.7, "emotion": "surprised", "text": "હેં? ક્યાં? તપાસ થશે!"}, {"id": 75, "duration_s": 5.62, "emotion": "determined", "text": "મગર હોય કે એનો બાપ... તપાસ થશે!"}, {"id": 76, "duration_s": 4.26, "emotion": "scared_whisper", "text": "શ્શ... કાયદો આવે છે!"}, {"id": 77, "duration_s": 3.78, "emotion": "comic_panic", "text": "મ... મગર... નાનો... લીલો..."}, {"id": 78, "duration_s": 0.69, "emotion": "worried", "text": "નજર!"}, {"id": 79, "duration_s": 3.718, "emotion": "sarcastic", "text": "પાણી? ભજિયું?"}, {"id": 80, "duration_s": 3.557, "emotion": "tired", "text": "તપાસ... ચાલુ રહેશે..."}, {"id": 81, "duration_s": 3.54, "emotion": "sad", "text": "મારો કૅપ્ટન પણ ગયો... ગટરમાં."}, {"id": 82, "duration_s": 2.78, "emotion": "excited", "text": "આઈડિયા! ડરીશું નહીં, તપાસ કરીશું!"}, {"id": 83, "duration_s": 2.32, "emotion": "serious", "text": "હું કહું? ફોરેસ્ટવાળા એક્સપર્ટ બોલાવો!"}, {"id": 84, "duration_s": 0.505, "emotion": "stern_warning", "text": "ચૂપ!"}, {"id": 85, "duration_s": 4.13, "emotion": "serious", "text": "હેલો, ફોરેસ્ટ વિભાગ? ગટરમાં મગર... કદાચ."}, {"id": 86, "duration_s": 1.65, "emotion": "determined", "text": "હું નાસ્તો સંભાળીશ."}, {"id": 87, "duration_s": 3.14, "emotion": "excited", "text": "બ્રેકિંગ ન્યૂઝ! કોલોનીની ગટરમાં મગર સે!"}, {"id": 88, "duration_s": 3.74, "emotion": "proud", "text": "આપણી ગટર ટીવી પર! આખી સોસાયટી જોશે!"}, {"id": 89, "duration_s": 2.69, "emotion": "comic_panic", "text": "ટેન્શન ના લો... ટેન્શન ના લો... ટેન્શન!"}, {"id": 90, "duration_s": 4.82, "emotion": "sarcastic", "text": "આખી સોસાયટી અગાસી પર. રસ્તા પર ફક્ત ભેંસ."}, {"id": 91, "duration_s": 1.47, "emotion": "happy", "text": "ચાલ ચાલ! સાહેબ આવી ગયા!"}, {"id": 92, "duration_s": 4.34, "emotion": "tired", "text": "દર વખતે! સૌથી જરૂરી ટાઈમે!"}, {"id": 93, "duration_s": 2.89, "emotion": "happy", "text": "વાહ ભાઈ વાહ! તું જ અસલી મિકેનિક!"}, {"id": 94, "duration_s": 2.03, "emotion": "serious", "text": "મગર ક્યાં સે? મને દેખાડો."}, {"id": 95, "duration_s": 0.75, "emotion": "panicked", "text": "ત્યાં!!!"}, {"id": 96, "duration_s": 2.55, "emotion": "scared_whisper", "text": "આખી સોસાયટીએ શ્વાસ રોકી લીધો..."}, {"id": 97, "duration_s": 2.04, "emotion": "scared_whisper", "text": "હું કોઈથી ના ડરું... હું કોઈથી..."}, {"id": 98, "duration_s": 2.68, "emotion": "sarcastic", "text": "આ મગર? ઈ તો રબરનો સે!"}, {"id": 99, "duration_s": 2.86, "emotion": "shocked", "text": "આટલો નાનો? મારા ગમબૂટનું શું થશે?"}, {"id": 100, "duration_s": 2.75, "emotion": "loving", "text": "મારો કૅપ્ટન મગર! મળી ગયો!"}, {"id": 101, "duration_s": 1.95, "emotion": "curious", "text": "પણ ફોટામાં તો એ મોટો હતો!"}, {"id": 102, "duration_s": 2.86, "emotion": "proud", "text": "હું કહું? આ ફોટામાં ત્રણ ગરબડ છે."}, {"id": 103, "duration_s": 1.75, "emotion": "excited", "text": "ફેક્ટ-ચેક, લાઇવ ચાલુ છે!"}, {"id": 104, "duration_s": 3.28, "emotion": "serious", "text": "એક: બિલાડીનો પડછાયો છે... મગરનો નહીં!"}, {"id": 105, "duration_s": 4.88, "emotion": "serious", "text": "બે: મગર ગટર કરતાં મોટો! ઘૂસશે કેમ?"}, {"id": 106, "duration_s": 4.0, "emotion": "proud", "text": "સાયન્સ કહે છે, મગર શ્વાસ રોકીને પાતળો થાય!"}, {"id": 107, "duration_s": 0.48, "emotion": "stern_warning", "text": "ચૂપ!"}, {"id": 108, "duration_s": 3.43, "emotion": "excited", "text": "અને ત્રણ: પૂંછડી પર ધોકલુના દાંત!"}, {"id": 109, "duration_s": 1.91, "emotion": "embarrassed", "text": "એ... ભૂખ લાગી હતી."}, {"id": 110, "duration_s": 4.24, "emotion": "sarcastic", "text": "મગરના આંસુ સાંભળ્યા'તા... મગરનો ફોટો પહેલી વાર!"}, {"id": 111, "duration_s": 1.56, "emotion": "serious", "text": "આ ફોટો કોણે પાડ્યો હતો?"}, {"id": 112, "duration_s": 3.75, "emotion": "guilty", "text": "હા... મેં બનાવ્યો હતો. ફક્ત લાઇક્સ માટે."}, {"id": 113, "duration_s": 1.11, "emotion": "angry", "text": "લાઇક્સ?!"}, {"id": 114, "duration_s": 2.56, "emotion": "embarrassed", "text": "કાંતા બાનું નિશાન... કદી ન ચૂકે."}, {"id": 115, "duration_s": 3.29, "emotion": "guilty", "text": "અને મેં... ચાલીસ ગ્રુપમાં જોયા વગર મોકલ્યો."}, {"id": 116, "duration_s": 3.51, "emotion": "sad", "text": "મારા ત્રણસોના બૂટ... હવે કોણ લેશે?"}, {"id": 117, "duration_s": 0.61, "emotion": "stern_warning", "text": "શેઠ!"}, {"id": 118, "duration_s": 3.84, "emotion": "embarrassed", "text": "સારું સારું... સો રૂપિયા. જૂનો ભાવ."}, {"id": 119, "duration_s": 2.95, "emotion": "tired", "text": "અને મેં આખી રાત ગેટ-આસન કર્યું!"}, {"id": 120, "duration_s": 3.3, "emotion": "determined", "text": "બસ! હવે હું જોઉં છું. જેણે ગટર ફેમસ કરી..."}, {"id": 121, "duration_s": 1.02, "emotion": "stern_warning", "text": "...એ જ સાફ કરશે!"}, {"id": 122, "duration_s": 2.69, "emotion": "tired", "text": "ટેન્શન ના લો... ટેન્શન ઘણું છે."}, {"id": 123, "duration_s": 3.06, "emotion": "excited", "text": "લાઇવ ચાલુ છે! ગટર સફાઈ, એપિસોડ વન!"}, {"id": 124, "duration_s": 2.51, "emotion": "serious", "text": "સુધારો ચાલીસ ગ્રુપમાં... પણ પહેલાં ચેક!"}, {"id": 125, "duration_s": 2.24, "emotion": "curious", "text": "આમાં બિસ્કિટ છે?"}, {"id": 126, "duration_s": 5.681, "emotion": "excited", "text": "મારું ચંપલ! જોયું? સાયન્સ!"}, {"id": 127, "duration_s": 5.14, "emotion": "serious", "text": "તપાસ... પૂરી થઈ. કેસ બંધ."}, {"id": 128, "duration_s": 5.19, "emotion": "calm", "text": "સાંજ પડી, વરસાદ થંભ્યો... ને ગટર ચમકી ઊઠી."}, {"id": 129, "duration_s": 4.57, "emotion": "calm", "text": "એક નકલી ફોટો... ને આખી સોસાયટી અગાસી પર."}, {"id": 130, "duration_s": 2.26, "emotion": "guilty", "text": "દાદા, બસ મજાક હતી..."}, {"id": 131, "duration_s": 5.79, "emotion": "serious", "text": "મજાક તારી હતી. ડર આખી સોસાયટીનો."}, {"id": 132, "duration_s": 2.07, "emotion": "curious", "text": "તો સાચું કેમ જાણવું, દાદા?"}, {"id": 133, "duration_s": 5.37, "emotion": "serious", "text": "હું કહું? કોણે મોકલ્યું, પડછાયો, માપ - પહેલાં તપાસો."}, {"id": 134, "duration_s": 3.23, "emotion": "stern_warning", "text": "શંકા હોય તો ન મોકલો! ને ખોટાની રિપોર્ટ કરો!"}, {"id": 135, "duration_s": 3.18, "emotion": "serious", "text": "ફોરવર્ડ પહેલાં વિચારો..."}, {"id": 136, "duration_s": 4.09, "emotion": "tender", "text": "...નહીં તો એક દિવસ સાચું પણ ખોટું લાગશે."}, {"id": 137, "duration_s": 3.65, "emotion": "relieved", "text": "હાશ! હવે કોઈ મગર-બગર નહીં."}, {"id": 138, "duration_s": 3.97, "emotion": "excited", "text": "પપ્પા! ગટરમાં સાચે કંઈક છે!"}, {"id": 139, "duration_s": 0.98, "emotion": "sarcastic", "text": "હા હા... મગર. બહુ થયું."}, {"id": 140, "duration_s": 2.02, "emotion": "comic_panic", "text": "હું કોઈથી ના ડરું!"}]