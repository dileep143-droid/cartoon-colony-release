[{"id": 1, "duration_s": 4.82, "emotion": "calm", "text": "ਐਤਵਾਰ ਦੀ ਸ਼ਾਮ। ਸੰਧੂ ਜੀ ਦੇ ਘਰ ਸੱਤਿਆਨਰਾਇਣ ਦੀ ਕਥਾ।"}, {"id": 2, "duration_s": 2.3, "emotion": "excited", "text": "ਕੇਲਾ ਕਿੰਗਡਮ! ਊ ਊ ਆ ਆ!"}, {"id": 3, "duration_s": 1.74, "emotion": "excited", "text": "ਸਿਰਫ਼ ਨੜਿੰਨਵੇਂ ਰੁਪਏ!"}, {"id": 4, "duration_s": 0.93, "emotion": "shocked", "text": "ਫੇਰ ਕੱਟੇ?!"}, {"id": 5, "duration_s": 2.56, "emotion": "embarrassed", "text": "ਊ ਊ ਆ ਆ?"}, {"id": 6, "duration_s": 3.3, "emotion": "mischievous", "text": "ਇਹ ਸਭ ਸ਼ੁਰੂ ਹੋਇਆ... ਤਿੰਨ ਦਿਨ ਪਹਿਲਾਂ।"}, {"id": 7, "duration_s": 2.06, "emotion": "mischievous", "text": "ਇੱਕ ਕੇਲਿਆਂ ਵਾਲੀ ਗੇਮ ਤੋਂ।"}, {"id": 8, "duration_s": 3.97, "emotion": "angry", "text": "ਕਾਕਾ! ਇਹ ਫ਼ੋਨ 'ਗੁੱਡ ਮੌਰਨਿੰਗ' ਨਹੀਂ ਭੇਜਦਾ!"}, {"id": 9, "duration_s": 2.47, "emotion": "proud", "text": "ਹੋ ਗਿਆ। ਚੌਦਾਂ ਗਰੁੱਪਾਂ 'ਚ ਭੇਜ ਦਿੱਤਾ।"}, {"id": 10, "duration_s": 1.98, "emotion": "proud", "text": "ਸਾਰਾ ਮੁਹੱਲਾ ਦੇਖੂਗਾ!"}, {"id": 11, "duration_s": 2.35, "emotion": "excited", "text": "ਪ੍ਰੀਤੋ ਬੇਬੇ! ਇਹਦੇ 'ਚ ਬਾਂਦਰ ਗੇਮ ਏ!"}, {"id": 12, "duration_s": 3.99, "emotion": "tired", "text": "ਪੰਜ ਮਿੰਟ ਖੇਡ ਲਓ। ਮੈਂ ਬੱਸ ਅੱਖ ਮੀਚ ਕੇ..."}, {"id": 13, "duration_s": 2.35, "emotion": "excited", "text": "ਕੇਲਾ ਕਿੰਗਡਮ 'ਚ ਜੀ ਆਇਆਂ ਨੂੰ!"}, {"id": 14, "duration_s": 3.0, "emotion": "excited", "text": "ਕੇਲੇ ਮੁੱਕ ਗਏ! ਨੜਿੰਨਵੇਂ ਰੁਪਏ 'ਚ ਸੌ ਕੇਲੇ!"}, {"id": 15, "duration_s": 2.78, "emotion": "curious", "text": "ਨੜਿੰਨਵੇਂ ਰੁਪਏ? ਸੱਚੀਂ ਵਾਲੇ?"}, {"id": 16, "duration_s": 2.2, "emotion": "mischievous", "text": "ਕਮਲਾ! ਗੇਮ ਦੇ ਪੈਸੇ ਨਕਲੀ ਹੁੰਦੇ ਨੇ।"}, {"id": 17, "duration_s": 1.38, "emotion": "mischievous", "text": "ਇੱਕ ਆਈਡੀਆ ਆ!"}, {"id": 18, "duration_s": 4.03, "emotion": "excited", "text": "ਆਵਾਜ਼ ਸੁਣੀ? ਸਾਨੂੰ ਪੈਸੇ ਮਿਲਦੇ ਪਏ ਨੇ!"}, {"id": 19, "duration_s": 2.49, "emotion": "laughing", "text": "ਇੱਕ ਹੋਰ! <laugh> ਇੱਕ ਹੋਰ!"}, {"id": 20, "duration_s": 2.69, "emotion": "happy", "text": "ਸਾਰਾ ਮੁਹੱਲਾ... ਦੇਖੂਗਾ..."}, {"id": 21, "duration_s": 3.57, "emotion": "excited", "text": "ਸ਼ਾਵਾ! ਤੁਸੀਂ ਓ ਕੇਲਾ ਕਿੰਗਡਮ ਦੇ ਰਾਜੇ!"}, {"id": 22, "duration_s": 3.51, "emotion": "calm", "text": "ਉਸੇ ਸਵੇਰ। ਵਰਾਂਡੇ 'ਚ ਬਿੱਲਾ ਜੀ ਦਾ ਆਰਾਮ।"}, {"id": 23, "duration_s": 5.32, "emotion": "proud", "text": "ਮੇਰਾ ਬੈਂਕ ਅਕਾਊਂਟ... ਲੋਹੇ ਦੀ ਤਿਜੋਰੀ ਆ, ਗੋਗੀ!"}, {"id": 24, "duration_s": 1.39, "emotion": "sarcastic", "text": "ਤਿਜੋਰੀ 'ਚ ਕੁਝ ਹੈ ਵੀ?"}, {"id": 25, "duration_s": 2.94, "emotion": "neutral", "text": "ਨੜਿੰਨਵੇਂ ਕੱਟੇ? ਚਲੋ... ਚਾਹ ਦਾ ਖ਼ਰਚਾ।"}, {"id": 26, "duration_s": 1.42, "emotion": "shocked", "text": "ਚਾਰ ਸੌ ਨੜਿੰਨਵੇਂ?!"}, {"id": 27, "duration_s": 1.65, "emotion": "curious", "text": "ਵੀਰੇ, ਤਿਜੋਰੀ 'ਚ ਮੋਰੀ ਆ।"}, {"id": 28, "duration_s": 3.1, "emotion": "panicked", "text": "ਨੌਂ ਸੌ ਨੜਿੰਨਵੇਂ! ਇਹ ਚੋਰ ਨਹੀਂ... ਡਾਕੂ ਆ!"}, {"id": 29, "duration_s": 3.05, "emotion": "excited", "text": "ਫ਼ਿਕਰ ਨੌਟ! ਫ਼ੋਨ ਈ ਵੇਚ ਦਿਓ!"}, {"id": 30, "duration_s": 2.59, "emotion": "determined", "text": "ਮੈਂ ਨਹੀਂ ਡਰਦਾ! ਉਸ ਚੋਰ ਨੂੰ ਮੈਂ..."}, {"id": 31, "duration_s": 0.79, "emotion": "comic_panic", "text": "ਕਿਰ... ਕਿਰਲੀ!"}, {"id": 32, "duration_s": 2.51, "emotion": "sarcastic", "text": "ਕਿਸੇ ਤੋਂ ਨਹੀਂ ਡਰਦੇ? ਕਿਰਲੀ ਤੋਂ ਵੀ ਨਹੀਂ?"}, {"id": 33, "duration_s": 2.74, "emotion": "embarrassed", "text": "ਉਹ... ਚੋਰ ਦੀ ਜਾਸੂਸ ਸੀ! ਖ਼ੁਫ਼ੀਆ!"}, {"id": 34, "duration_s": 1.92, "emotion": "calm", "text": "ਬੱਸ! ਹੁਣ ਮੈਂ ਦੇਖਦੀ—"}, {"id": 35, "duration_s": 1.91, "emotion": "shouting", "text": "ਨਹੀਂ! ਇਹ ਪੁਲਿਸ ਕੇਸ ਆ!"}, {"id": 36, "duration_s": 4.37, "emotion": "scared_whisper", "text": "ਹੈਲੋ, ਥਾਣਾ? ਮੇਰਾ ਅਕਾਊਂਟ... ਲੁੱਟਿਆ ਜਾ ਰਿਹਾ!"}, {"id": 37, "duration_s": 3.77, "emotion": "serious", "text": "ਪੜਤਾਲ ਹੋਊ! ਪੂਰੀ ਪੜਤਾਲ ਹੋਊ!"}, {"id": 38, "duration_s": 5.27, "emotion": "panicked", "text": "ਸਾਹਬ, ਚੋਰ ਦਿਸਦਾ ਨਹੀਂ... ਬੱਸ ਪੈਸੇ ਕੱਟਦਾ ਆ!"}, {"id": 39, "duration_s": 2.05, "emotion": "curious", "text": "ਹੂੰ... ਸੁਰਾਗ ਦੀ ਖ਼ੁਸ਼ਬੋ।"}, {"id": 40, "duration_s": 7.26, "emotion": "serious", "text": "ਚੋਰ ਕਦੋਂ ਆਉਂਦਾ? ਕੀ ਪਾਉਂਦਾ? ਚਟਣੀ ਕਿੱਥੇ ਆ?"}, {"id": 41, "duration_s": 1.32, "emotion": "embarrassed", "text": "ਭੁੱਖ ਲੱਗੀ ਸੀ!"}, {"id": 42, "duration_s": 5.92, "emotion": "serious", "text": "ਲਿਖੋ... ਚੋਰ... ਭੁੱਖਾ ਏ।"}, {"id": 43, "duration_s": 1.31, "emotion": "curious", "text": "ਭੁੱਖਾ? ਇਹ ਕਿਵੇਂ ਪਤਾ ਲੱਗਾ?"}, {"id": 44, "duration_s": 1.77, "emotion": "proud", "text": "ਪਕੌੜੇ ਮੁੱਕ ਗਏ ਨਾ!"}, {"id": 45, "duration_s": 2.4, "emotion": "pleading", "text": "ਸਾਹਬ? ਸਾਹਬ! ਚੋਰ!"}, {"id": 46, "duration_s": 1.01, "emotion": "sarcastic", "text": "ਇੱਕ ਪਕੌੜਾ ਹੋਰ?"}, {"id": 47, "duration_s": 2.33, "emotion": "excited", "text": "ਪੜਤਾਲ ਹੋਊ!"}, {"id": 48, "duration_s": 4.92, "emotion": "serious", "text": "ਥਾਣੇ ਜਾ ਕੇ ਰਿਪੋਰਟ ਖਾਵਾਂਗਾ। ਮਤਲਬ... ਲਿਖਾਂਗਾ।"}, {"id": 49, "duration_s": 4.4, "emotion": "sad", "text": "<sigh> ਚੋਰ ਵੀ ਭੁੱਖਾ... ਨੀਂਦ ਸਿੰਘ ਵੀ ਭੁੱਖਾ।"}, {"id": 50, "duration_s": 4.63, "emotion": "mischievous", "text": "ਇੱਕ ਘੰਟੇ 'ਚ... ਖ਼ਬਰ ਸਾਰੇ ਮੁਹੱਲੇ 'ਚ।"}, {"id": 51, "duration_s": 3.28, "emotion": "excited", "text": "ਸੁਣਿਆ ਈ? ਸੰਧੂ ਜੀ ਦੇ ਫ਼ੋਨ 'ਚ ਚੋਰ!"}, {"id": 52, "duration_s": 2.55, "emotion": "scared_whisper", "text": "ਸੁਣਿਆ? ਚੋਰ ਅਣਦਿਸਦਾ!"}, {"id": 53, "duration_s": 2.22, "emotion": "shocked", "text": "ਸੁਣਿਆ ਈ? ਚੋਰ ਬਾਂਦਰ ਆ!"}, {"id": 54, "duration_s": 1.29, "emotion": "proud", "text": "ਸਾਇੰਸ ਕਹਿੰਦੀ ਏ..."}, {"id": 55, "duration_s": 1.94, "emotion": "serious", "text": "ਚੋਰ... ਖੱਬੇ ਹੱਥ ਵਾਲਾ ਏ!"}, {"id": 56, "duration_s": 0.64, "emotion": "curious", "text": "ਕਿਵੇਂ ਪਤਾ?"}, {"id": 57, "duration_s": 2.02, "emotion": "proud", "text": "ਪੈਸਾ ਤਾਂ ਖੱਬੇ ਹੱਥੋਂ ਈ ਜਾਂਦਾ!"}, {"id": 58, "duration_s": 1.44, "emotion": "stern_warning", "text": "ਪੈਸਾ ਰਾਮ!"}, {"id": 59, "duration_s": 3.79, "emotion": "serious", "text": "ਮੇਰਾ ਖੱਬਾ ਹੱਥ ਸਿਰਫ਼ ਗਿਣਦਾ। ਇੱਕ ਰੁਪਈਆ ਘੱਟ ਨਹੀਂ!"}, {"id": 60, "duration_s": 3.96, "emotion": "serious", "text": "ਨਜ਼ਰ ਲੱਗ ਗਈ! ਹਰ ਫ਼ੋਨ ਨੂੰ ਨਿੰਬੂ-ਮਿਰਚਾਂ!"}, {"id": 61, "duration_s": 2.05, "emotion": "excited", "text": "ਅਸੀਂ ਲਾਈਵ ਆਂ! ਮੁਹੱਲੇ 'ਚ ਚੋਰ!"}, {"id": 62, "duration_s": 3.62, "emotion": "determined", "text": "ਚੱਲੋ ਚੱਲੋ! ਚੋਰ ਫੜਨ ਚੱਲੀਏ!"}, {"id": 63, "duration_s": 1.22, "emotion": "embarrassed", "text": "<sigh> ਚੋਰ ਪੈਦਲ ਈ ਫੜਾਂਗੇ।"}, {"id": 64, "duration_s": 3.02, "emotion": "comic_panic", "text": "ਉੱਨੀ ਸੌ ਨੜਿੰਨਵੇਂ! ਹੁਣੇ! ਇੱਥੇ ਈ!"}, {"id": 65, "duration_s": 1.75, "emotion": "shocked", "text": "ਚੋਰ ਸਾਡੇ ਵਿੱਚ ਏ!"}, {"id": 66, "duration_s": 2.09, "emotion": "shouting", "text": "ਤੂੰ! ਨਹੀਂ, ਤੂੰ!"}, {"id": 67, "duration_s": 0.58, "emotion": "shouting", "text": "ਚੁੱਪ!"}, {"id": 68, "duration_s": 3.12, "emotion": "curious", "text": "ਮੈਂ ਦੱਸਾਂ? ਚੋਰ ਸ਼ਾਇਦ ਘਰ ਦਾ ਈ..."}, {"id": 69, "duration_s": 1.5, "emotion": "shouting", "text": "ਨਹੀਂ!"}, {"id": 70, "duration_s": 1.5, "emotion": "sarcastic", "text": "ਬੱਚੇ ਸਾਇੰਸ ਕੀ ਜਾਣਨ!"}, {"id": 71, "duration_s": 3.54, "emotion": "scared_whisper", "text": "ਰਾਤ ਦੇ ਦੋ ਵਜੇ। ਸਾਰਾ ਮੁਹੱਲਾ ਸੁੱਤਾ ਪਿਆ..."}, {"id": 72, "duration_s": 1.1, "emotion": "mischievous", "text": "...ਲਗਭਗ ਸਾਰਾ।"}, {"id": 73, "duration_s": 2.87, "emotion": "scared_whisper", "text": "ਬੱਸ ਇੱਕ ਲੈਵਲ ਹੋਰ... ਫੇਰ ਸੌਂ ਜਾਊਂਗੀ।"}, {"id": 74, "duration_s": 0.87, "emotion": "scared_whisper", "text": "ਸ਼ਸ਼ਸ਼! ਬਾਂਦਰ ਭੁੱਖਾ ਏ।"}, {"id": 75, "duration_s": 3.98, "emotion": "scared_whisper", "text": "ਚੋਰ... ਘਰ ਦੇ ਅੰਦਰ ਏ!"}, {"id": 76, "duration_s": 1.76, "emotion": "scared_whisper", "text": "ਮੈਂ ਨਹੀਂ ਡਰਦਾ... ਮੈਂ ਨਹੀਂ..."}, {"id": 77, "duration_s": 3.272, "emotion": "scared_whisper", "text": "ਕੌਣ ਏ? ਹੱਥ ਉੱਪਰ!"}, {"id": 78, "duration_s": 0.73, "emotion": "angry", "text": "ਰਾਤ ਨੂੰ ਟਾਰਚ?!"}, {"id": 79, "duration_s": 2.87, "emotion": "embarrassed", "text": "ਬੇਬੇ... ਤੁਸੀਂ ਕੋਈ ਚੋਰ ਦੇਖਿਆ?"}, {"id": 80, "duration_s": 4.08, "emotion": "tired", "text": "ਚੋਰ? <short pause> ਇੱਥੇ ਤਾਂ ਮੈਂ ਈ ਆਂ।"}, {"id": 81, "duration_s": 2.64, "emotion": "relieved", "text": "ਹਾਂ... ਤੁਸੀਂ ਤਾਂ ਸੁੱਤੇ ਪਏ ਓ।"}, {"id": 82, "duration_s": 3.88, "emotion": "serious", "text": "ਮੁਹੱਲੇ 'ਚ ਚੋਰ ਘੁੰਮਦਾ ਏ। ਇੱਕ ਰੁਪਈਆ ਘੱਟ ਨਹੀਂ!"}, {"id": 83, "duration_s": 1.04, "emotion": "excited", "text": "ਫ਼ਿਕਰ ਨੌਟ!"}, {"id": 84, "duration_s": 4.11, "emotion": "mischievous", "text": "ਗੇਮ ਹੈਕ! ਅਣਲਿਮਟਿਡ ਕੇਲੇ! ਸਿਰਫ਼ ਦੋ ਸੌ 'ਚ!"}, {"id": 85, "duration_s": 3.01, "emotion": "curious", "text": "ਦੋ ਸੌ ਨਹੀਂ ਆ... ਦੋ ਸਮੋਸੇ ਆ।"}, {"id": 86, "duration_s": 1.67, "emotion": "happy", "text": "ਚੱਲੂ! ਡੀਲ ਪੱਕੀ!"}, {"id": 87, "duration_s": 1.56, "emotion": "shocked", "text": "ਓਏ! ਪੇਮੈਂਟ ਈ ਖਾ ਗਿਆ!"}, {"id": 88, "duration_s": 3.8, "emotion": "stern_warning", "text": "ਗੇਮ ਹੈਕ? ਦਿਖਾਵਾਂ ਅਸਲੀ ਹੈਕ?"}, {"id": 89, "duration_s": 2.76, "emotion": "pleading", "text": "ਭਾਬੀ... ਇਹ ਤਾਂ ਸਮਾਜ ਸੇਵਾ ਸੀ!"}, {"id": 90, "duration_s": 2.8, "emotion": "excited", "text": "ਦੋ ਸੌ? ਉਹਦੇ 'ਚ ਮੇਰਾ ਦਸ ਪਰਸੈਂਟ!"}, {"id": 91, "duration_s": 0.78, "emotion": "stern_warning", "text": "ਪੈਸਾ ਰਾਮ!"}, {"id": 92, "duration_s": 1.96, "emotion": "happy", "text": "ਹੈਕ ਵਧੀਆ ਸੀ।"}, {"id": 93, "duration_s": 4.04, "emotion": "calm", "text": "ਤਿੰਨ ਦਿਨ ਬਾਅਦ। ਓਹੀ ਕਥਾ... ਜਿੱਥੋਂ ਅਸੀਂ ਸ਼ੁਰੂ ਕੀਤੀ ਸੀ।"}, {"id": 94, "duration_s": 2.53, "emotion": "scared_whisper", "text": "ਅੱਜ ਕੋਈ ਖ਼ਰਚਾ ਨਹੀਂ ਹੋਣਾ। ਅੱਜ ਕਥਾ ਆ।"}, {"id": 95, "duration_s": 2.76, "emotion": "scared_whisper", "text": "ਅਸੀਂ ਲਾਈਵ ਆਂ! ਸੰਧੂ ਕਥਾ, ਐਕਸਕਲੂਸਿਵ!"}, {"id": 96, "duration_s": 4.38, "emotion": "serious", "text": "ਤੇ ਫੇਰ ਲੀਲਾਵਤੀ ਨੇ... ਪ੍ਰਸ਼ਾਦ ਨਹੀਂ ਖਾਧਾ।"}, {"id": 97, "duration_s": 2.77, "emotion": "curious", "text": "ਇਹ ਕਿਹੜਾ ਅਧਿਆਇ?"}, {"id": 98, "duration_s": 2.97, "emotion": "excited", "text": "ਇਹ... ਨਵਾਂ ਭਜਨ ਆ! ਕੇਲਾ ਭਜਨ!"}, {"id": 99, "duration_s": 1.18, "emotion": "shocked", "text": "ਨਜ਼ਰ ਲੱਗ ਗਈ!"}, {"id": 100, "duration_s": 2.43, "emotion": "excited", "text": "ਸੁਣਿਆ? ਪ੍ਰੀਤੋ ਦਾ ਡਿਸਕੋ ਭਜਨ!"}, {"id": 101, "duration_s": 2.42, "emotion": "excited", "text": "ਸ਼ੁਕਰੀਆ ਬਾਈ! ਨੜਿੰਨਵੇਂ ਰੁਪਏ!"}, {"id": 102, "duration_s": 0.92, "emotion": "shocked", "text": "ਫੇਰ ਕੱਟੇ?!"}, {"id": 103, "duration_s": 1.47, "emotion": "embarrassed", "text": "ਊ ਊ ਆ ਆ?"}, {"id": 104, "duration_s": 1.41, "emotion": "shouting", "text": "ਪੜਤਾਲ ਹੋਊ!"}, {"id": 105, "duration_s": 0.75, "emotion": "shocked", "text": "ਪ੍ਰੀਤੋ?!"}, {"id": 106, "duration_s": 0.77, "emotion": "curious", "text": "ਮੈਂ ਦੱਸਾਂ?"}, {"id": 107, "duration_s": 0.89, "emotion": "shouting", "text": "ਦੱਸ!"}, {"id": 108, "duration_s": 4.09, "emotion": "serious", "text": "ਨੜਿੰਨਵੇਂ... ਚਾਰ ਸੌ ਨੜਿੰਨਵੇਂ... ਨੌਂ ਸੌ ਨੜਿੰਨਵੇਂ..."}, {"id": 109, "duration_s": 4.39, "emotion": "serious", "text": "ਸਭ ਇਸੇ ਫ਼ੋਨ ਤੋਂ। ਪੇਮੈਂਟ ਬਿੱਲਾ ਚਾਚਾ ਦੇ ਕਾਰਡ ਤੋਂ।"}, {"id": 110, "duration_s": 2.74, "emotion": "shocked", "text": "ਮੇਰਾ ਕਾਰਡ? ਪ੍ਰੀਤੋ ਦੇ ਫ਼ੋਨ 'ਚ?"}, {"id": 111, "duration_s": 4.525, "emotion": "sarcastic", "text": "ਤੂੰ ਈ ਪਾਇਆ ਸੀ! ਬਿਜਲੀ ਦਾ ਬਿੱਲ ਭਰਨ!"}, {"id": 112, "duration_s": 2.72, "emotion": "sad", "text": "<sigh> ਤੇ ਹਟਾਉਣਾ ਭੁੱਲ ਗਿਆ।"}, {"id": 113, "duration_s": 2.34, "emotion": "guilty", "text": "ਡੈਡੀ... ਪਹਿਲੇ ਨੜਿੰਨਵੇਂ... ਮੈਂ ਦੱਬੇ।"}, {"id": 114, "duration_s": 3.34, "emotion": "guilty", "text": "ਤੇ ਚਾਰ ਸੌ ਨੜਿੰਨਵੇਂ... ਅਸੀਂ ਦੋਹਾਂ ਨੇ।"}, {"id": 115, "duration_s": 2.81, "emotion": "guilty", "text": "ਸਾਨੂੰ ਲੱਗਿਆ ਗੇਮ ਦੇ ਪੈਸੇ ਨਕਲੀ ਨੇ।"}, {"id": 116, "duration_s": 2.94, "emotion": "serious", "text": "ਪੈਸੇ ਅਸਲੀ ਸਨ। ਬੱਸ ਕੇਲੇ ਨਕਲੀ ਸਨ।"}, {"id": 117, "duration_s": 4.253, "emotion": "guilty", "text": "ਤੇ ਰਾਤ ਦੋ ਵਜੇ ਵਾਲੇ... ਮੈਂ ਕੀਤੇ।"}, {"id": 118, "duration_s": 1.62, "emotion": "shocked", "text": "ਰਾਤ ਨੂੰ ਦੋ ਵਜੇ?!"}, {"id": 119, "duration_s": 1.63, "emotion": "pleading", "text": "ਬਾਂਦਰ ਭੁੱਖਾ ਸੀ!"}, {"id": 120, "duration_s": 4.07, "emotion": "proud", "text": "ਦੇਖਿਆ! ਮੈਂ ਕਿਹਾ ਸੀ, ਚੋਰ ਭੁੱਖਾ ਏ!"}, {"id": 121, "duration_s": 2.87, "emotion": "proud", "text": "ਪ੍ਰੀਤੋ ਬੇਬੇ ਖੱਬਚੂ ਆ! ਸਾਇੰਸ ਕਹਿੰਦੀ ਏ!"}, {"id": 122, "duration_s": 2.65, "emotion": "excited", "text": "ਸੁਣਿਆ? ਚੋਰ... ਪ੍ਰੀਤੋ ਨਿਕਲੀ!"}, {"id": 123, "duration_s": 2.31, "emotion": "proud", "text": "ਹੁਣ ਮੈਂ ਸਾਂਭਦਾਂ! ਮੈਂ ਨਹੀਂ ਡ—"}, {"id": 124, "duration_s": 1.81, "emotion": "determined", "text": "ਬੱਸ! ਹੁਣ ਮੈਂ ਦੇਖਦੀ ਆਂ।"}, {"id": 125, "duration_s": 2.16, "emotion": "serious", "text": "ਇੱਕ - ਹਰ ਪੇਮੈਂਟ 'ਤੇ ਪਿੰਨ।"}, {"id": 126, "duration_s": 1.91, "emotion": "serious", "text": "ਦੋ - ਮਹੀਨੇ ਦੀ ਲਿਮਿਟ।"}, {"id": 127, "duration_s": 3.02, "emotion": "serious", "text": "ਤਿੰਨ - ਕਾਰਡ ਹਟਾਓ, ਆਟੋ-ਪੇ ਬੰਦ।"}, {"id": 128, "duration_s": 0.78, "emotion": "shocked", "text": "ਬੱਸ? ਦਸ ਸਕਿੰਟ 'ਚ?"}, {"id": 129, "duration_s": 3.04, "emotion": "pleading", "text": "ਤੇ... ਸਾਡੀ ਗੇਮ?"}, {"id": 130, "duration_s": 2.8, "emotion": "calm", "text": "ਰੋਜ਼ ਤੀਹ ਮਿੰਟ। ਫੇਰ ਬਾਹਰ ਕ੍ਰਿਕਟ!"}, {"id": 131, "duration_s": 1.5, "emotion": "excited", "text": "ਕ੍ਰਿਕਟ ਤੋਂ ਬਾਅਦ ਸਮੋਸੇ?"}, {"id": 132, "duration_s": 1.62, "emotion": "worried", "text": "ਤੇ ਜਿਹੜੇ ਪੈਸੇ ਗਏ?"}, {"id": 133, "duration_s": 4.33, "emotion": "calm", "text": "ਕੰਪਨੀ ਨੂੰ ਸ਼ਿਕਾਇਤ ਭੇਜਾਂਗੇ। ਤੇ ਅੱਗੋਂ... ਪਿੰਨ!"}, {"id": 134, "duration_s": 4.11, "emotion": "calm", "text": "ਬੱਚਿਆਂ ਨੂੰ ਫ਼ੋਨ ਨਾਲੋਂ ਵੱਧ... ਸਾਡਾ ਸਾਥ ਚਾਹੀਦਾ।"}, {"id": 135, "duration_s": 6.062, "emotion": "serious", "text": "ਫ਼ੋਨ 'ਚ ਪਿੰਨ... ਬੱਚਿਆਂ ਨਾਲ ਟਾਈਮ।"}, {"id": 136, "duration_s": 4.77, "emotion": "laughing", "text": "ਤੇ ਪ੍ਰੀਤੋ ਬੇਬੇ ਦੇ ਫ਼ੋਨ 'ਚ ਡਬਲ ਪਿੰਨ!"}, {"id": 137, "duration_s": 2.06, "emotion": "proud", "text": "ਮੈਂ ਨਹੀਂ ਡਰਦਾ! ਸੁੱਟੋ ਬਾਲ!"}, {"id": 138, "duration_s": 3.82, "emotion": "mischievous", "text": "ਖੱਬਚੂ। ਸਾਇੰਸ ਕਹਿੰਦੀ ਏ।"}, {"id": 139, "duration_s": 1.22, "emotion": "sad", "text": "<sigh> ਬਿਲਕੁਲ ਚੱਪਲ ਵਾਂਗੂੰ।"}, {"id": 140, "duration_s": 1.87, "emotion": "laughing", "text": "ਪ੍ਰੀਤੋ ਬੇਬੇ ਨਹੀਂ ਖੁੰਝਦੀ!"}]