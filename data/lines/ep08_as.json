[{"id": 1, "duration_s": 5.53, "emotion": "calm", "text": "মে'ৰ গৰম। ৰাতিপুৱা সাত বজা। সকলো এদম ঠিকেই আছিল..."}, {"id": 2, "duration_s": 5.48, "emotion": "happy", "text": "চেঁচা চেঁচা পানী... গৰম গৰম মই! লা-লা-লা!"}, {"id": 3, "duration_s": 2.09, "emotion": "curious", "text": "অ'? বৰষুণ বন্ধ হ'ল নেকি?"}, {"id": 4, "duration_s": 3.45, "emotion": "comic_panic", "text": "পানী... পানী! চকুত চাবোন! ৰূপাআআ!"}, {"id": 5, "duration_s": 3.19, "emotion": "surprised", "text": "আই, ইয়াতো পানী নাই! খালি বতাহ!"}, {"id": 6, "duration_s": 3.38, "emotion": "serious", "text": "কলটো বেমাৰী। জ্বৰ নহয়, পিয়াহ!"}, {"id": 7, "duration_s": 2.08, "emotion": "excited", "text": "শুনিছে? মোৰ কলটোও কাহিছে!"}, {"id": 8, "duration_s": 3.39, "emotion": "angry", "text": "এটা টোপাল? গোটেই মাহৰ বিল দিছোঁ!"}, {"id": 9, "duration_s": 3.44, "emotion": "worried", "text": "নজৰ লাগিল! কলটোলৈ নজৰ লাগিল!"}, {"id": 10, "duration_s": 2.57, "emotion": "proud", "text": "বিজ্ঞানে কয়... কলটো শুই আছে।"}, {"id": 11, "duration_s": 3.08, "emotion": "excited", "text": "লাইভ চলিছে! গোটেই পাড়া শুকান!"}, {"id": 12, "duration_s": 2.81, "emotion": "shouting", "text": "কোনে পানী বন্ধ কৰিলে? মই কাকো নাডৰোঁ!"}, {"id": 13, "duration_s": 3.77, "emotion": "mischievous", "text": "আৰু তেতিয়াই... গোটেই পাড়াৰ পানী বন্ধ!"}, {"id": 14, "duration_s": 2.42, "emotion": "shouting", "text": "টেংকাৰ আহিল! টেংকাৰ আহিল!"}, {"id": 15, "duration_s": 2.26, "emotion": "determined", "text": "বাট এৰা! চাবোনৱালা আহিছে!"}, {"id": 16, "duration_s": 5.14, "emotion": "proud", "text": "মোৰ টাব! ইম্প'ৰ্টেড! এটকাও কম নহয়!"}, {"id": 17, "duration_s": 2.66, "emotion": "happy", "text": "বলা বলা! ড্ৰাম ভৰাই আনিম!"}, {"id": 18, "duration_s": 1.93, "emotion": "sarcastic", "text": "এক মিটাৰ। ৰেকৰ্ড!"}, {"id": 19, "duration_s": 3.43, "emotion": "shouting", "text": "এক ঘৰ, দুটা বালতি! ঠেলা নিদিবা!"}, {"id": 20, "duration_s": 2.52, "emotion": "determined", "text": "ব্যস! এতিয়া মই চাওঁ।"}, {"id": 21, "duration_s": 2.1, "emotion": "surprised", "text": "ধনৰাম, বালতি নে?"}, {"id": 22, "duration_s": 1.66, "emotion": "mischievous", "text": "বালতিৰ ককাই!"}, {"id": 23, "duration_s": 2.82, "emotion": "stern_warning", "text": "ধনৰাম! গোটেই পাড়াই চাই আছে!"}, {"id": 24, "duration_s": 3.48, "emotion": "sad", "text": "ভোক লাগিছে... পিয়াহো লাগিছে।"}, {"id": 25, "duration_s": 3.5, "emotion": "calm", "text": "শেষ! আন টেংকাৰ... দুপৰত।"}, {"id": 26, "duration_s": 2.92, "emotion": "excited", "text": "শুনিছেনে? টেংকাৰ... তিনিদিনৰ পিছত!"}, {"id": 27, "duration_s": 2.63, "emotion": "excited", "text": "হেল' শইকীয়া, শুনিছে? হেল' বৰুৱা, শুনিছে?"}, {"id": 28, "duration_s": 1.24, "emotion": "serious", "text": "পাৰ দা... শুনিছে?"}, {"id": 29, "duration_s": 4.65, "emotion": "panicked", "text": "তিনি দিন? হায় হায়... তিনি ঘণ্টাতে সকলো শেষ!"}, {"id": 30, "duration_s": 3.53, "emotion": "comic_panic", "text": "তিনি ঘণ্টা? নহয়... তিনি মিনিট! লৰা!"}, {"id": 31, "duration_s": 3.22, "emotion": "mischievous", "text": "দুপৰীয়াৰ টেংকাৰ, তিনি মিনিটতে তিনি দিন হ'ল।"}, {"id": 32, "duration_s": 3.88, "emotion": "mischievous", "text": "বটল কুৰি টকা! সোনকালে, দাম বাঢ়িব!"}, {"id": 33, "duration_s": 4.98, "emotion": "mischievous", "text": "চল্লিশ! দাম বতৰৰ দৰে, সলনি হৈয়ে থাকে।"}, {"id": 34, "duration_s": 5.36, "emotion": "proud", "text": "বাৰটা বটল! এটা গা ধুবলৈ... এঘাৰটা আকৌ গা ধুবলৈ!"}, {"id": 35, "duration_s": 1.13, "emotion": "curious", "text": "এটা বটলৰ কিমান?"}, {"id": 36, "duration_s": 0.94, "emotion": "proud", "text": "এশ!"}, {"id": 37, "duration_s": 2.41, "emotion": "calm", "text": "তেন্তে থাকক। বতাহ বিনামূলীয়া।"}, {"id": 38, "duration_s": 2.69, "emotion": "mischievous", "text": "টেনচন নলবা! বটল মোক দিয়া, মই দুগুণত বেচিম!"}, {"id": 39, "duration_s": 2.39, "emotion": "sarcastic", "text": "মই নিজেই তিনিগুণত বেচিছোঁ।"}, {"id": 40, "duration_s": 2.63, "emotion": "stern_warning", "text": "ধনৰাম!"}, {"id": 41, "duration_s": 1.85, "emotion": "embarrassed", "text": "কুৰি... কুৰিয়েই, কুৰি!"}, {"id": 42, "duration_s": 3.1, "emotion": "excited", "text": "লাইভ চলিছে! পানী, সোণতকৈও দামী!"}, {"id": 43, "duration_s": 4.29, "emotion": "proud", "text": "বাৰ বটলৰ পানী! আজি ৰজাৰ দৰে গা ধুম!"}, {"id": 44, "duration_s": 3.23, "emotion": "stern_warning", "text": "ৰজা নহয়, প্ৰজাৰ দৰে। এটা মগ।"}, {"id": 45, "duration_s": 2.89, "emotion": "pleading", "text": "আধা মগ? ইমান চাবোনৰ বাবে?"}, {"id": 46, "duration_s": 3.32, "emotion": "proud", "text": "আমাৰ দিনত আধা মগত বৰযাত্ৰী গা ধুইছিল!"}, {"id": 47, "duration_s": 3.71, "emotion": "proud", "text": "ঠিক আছে! মই কাকো নাডৰোঁ! আধা মগ, চলা!"}, {"id": 48, "duration_s": 3.04, "emotion": "determined", "text": "ৰ'বা! যিটো পানী পৰিব, সেয়া তুলসীলৈ।"}, {"id": 49, "duration_s": 2.14, "emotion": "surprised", "text": "দেউতা, চাবোনে সব পানী খালে!"}, {"id": 50, "duration_s": 3.921, "emotion": "stern_warning", "text": "দ্বিতীয় মগ? গোটেই পাড়াই চাব!"}, {"id": 51, "duration_s": 0.61, "emotion": "shocked", "text": "ছি... টিকটিকি!"}, {"id": 52, "duration_s": 4.532, "emotion": "embarrassed", "text": "মই ভয় কৰা নাই... ইয়াৰ পিয়াহক ভয়!"}, {"id": 53, "duration_s": 1.57, "emotion": "worried", "text": "আই, ৰাতি টেংকিটো ভৰ্তি আছিল।"}, {"id": 54, "duration_s": 2.61, "emotion": "curious", "text": "ৰাতিপুৱা ক'লৈ গ'ল?"}, {"id": 55, "duration_s": 2.18, "emotion": "excited", "text": "এটা বুদ্ধি আছে! পানীৰ গোয়েন্দা!"}, {"id": 56, "duration_s": 2.12, "emotion": "excited", "text": "গোয়েন্দা দল, সাজু?"}, {"id": 57, "duration_s": 2.21, "emotion": "stern_warning", "text": "চুপ! গোয়েন্দাই কথা নকয়।"}, {"id": 58, "duration_s": 3.39, "emotion": "serious", "text": "কওঁনে? পানীৰ পিছ লোৱা... চোৰ ওলাব!"}, {"id": 59, "duration_s": 0.5, "emotion": "serious", "text": "এক!"}, {"id": 60, "duration_s": 0.63, "emotion": "serious", "text": "দুই!"}, {"id": 61, "duration_s": 3.48, "emotion": "happy", "text": "এই টোপ টোপ কলটো... আটাইতকৈ মিঠা!"}, {"id": 62, "duration_s": 2.99, "emotion": "shocked", "text": "চৌদ্দটা কল টোপাইছে! চৌদ্দটা!"}, {"id": 63, "duration_s": 3.47, "emotion": "mischievous", "text": "আৰু এই পানীৰ নৈ... যায় ক'লৈ?"}, {"id": 64, "duration_s": 5.46, "emotion": "proud", "text": "ধনু কাৰ ৱাশ! গাড়ী, স্কুটাৰ, মহ... সকলো ধোৱা হ'ব!"}, {"id": 65, "duration_s": 2.01, "emotion": "angry", "text": "চুপ! পাইপ বন্ধ কৰ!"}, {"id": 66, "duration_s": 5.13, "emotion": "mischievous", "text": "বন্ধ? এইটো ব্যৱসায়! পানী ফ্ৰী, লাভ পুৰা!"}, {"id": 67, "duration_s": 3.99, "emotion": "serious", "text": "মই কওঁনে? এই পাইপ ৰাতিপুৱা পাঁচ বজাৰ পৰা চলিছে।"}, {"id": 68, "duration_s": 2.26, "emotion": "shocked", "text": "সেইকাৰণেই আমাৰ টেংকি খালী!"}, {"id": 69, "duration_s": 3.979, "emotion": "calm", "text": "টেনচন নলবা! পানী মোৰ নহয়, পাড়াৰ!"}, {"id": 70, "duration_s": 1.23, "emotion": "angry", "text": "সেইবাবেই টেনচন!"}, {"id": 71, "duration_s": 2.05, "emotion": "shouting", "text": "তদন্ত হ'ব! কোন?"}, {"id": 72, "duration_s": 5.49, "emotion": "proud", "text": "বিজ্ঞানে কয়... বতাহ আৰু পানী, সমান বৰষুণ!"}, {"id": 73, "duration_s": 0.57, "emotion": "stern_warning", "text": "চুপ! চাওঁ।"}, {"id": 74, "duration_s": 3.51, "emotion": "excited", "text": "লাইভ চলিছে! পাড়াৰ প্ৰথম বৰষুণ!"}, {"id": 75, "duration_s": 4.11, "emotion": "proud", "text": "বিজ্ঞানে কয়... বৰষুণ খালী বিজ্ঞানীৰ ওপৰতহে পৰে।"}, {"id": 76, "duration_s": 4.22, "emotion": "sad", "text": "পণ্ডিত পবিত্ৰ গা ধুলে? মই চাবোনতে!"}, {"id": 77, "duration_s": 2.11, "emotion": "laughing", "text": "<laugh> পাড়াই চাব... পণ্ডিত পবিত্ৰৰ স্নান!"}, {"id": 78, "duration_s": 5.779, "emotion": "sarcastic", "text": "আৰু এটা বালতি গ'ল। পোন্ধৰটা কল!"}, {"id": 79, "duration_s": 1.7, "emotion": "embarrassed", "text": "এইটো... অলপ কেলিব্ৰেচন বাকী।"}, {"id": 80, "duration_s": 1.77, "emotion": "panicked", "text": "শুনিছেনে? শেষ টেংকাৰ!"}, {"id": 81, "duration_s": 3.38, "emotion": "excited", "text": "আৰম্ভ হ'ল... পাড়াৰ আটাইতকৈ ডাঙৰ বালতি-দৌৰ!"}, {"id": 82, "duration_s": 2.27, "emotion": "determined", "text": "এইবাৰ প্ৰথম বালতি মোৰ!"}, {"id": 83, "duration_s": 0.68, "emotion": "excited", "text": "বলা বলা!"}, {"id": 84, "duration_s": 2.1, "emotion": "sad", "text": "অ'... আজিও?"}, {"id": 85, "duration_s": 2.15, "emotion": "curious", "text": "কোনোবাই কব... মই ক'ত?"}, {"id": 86, "duration_s": 0.82, "emotion": "angry", "text": "মোৰ বালতি এৰা!"}, {"id": 87, "duration_s": 1.48, "emotion": "sarcastic", "text": "ই বালতি নহয়... ককাই!"}, {"id": 88, "duration_s": 4.02, "emotion": "shouting", "text": "তদন্ত হ'ব! ৰ'ব! নহয়, চলক! নহয়, ৰ'ব!"}, {"id": 89, "duration_s": 2.3, "emotion": "excited", "text": "লাইভ! বালতি জাম, এশ মিটাৰ!"}, {"id": 90, "duration_s": 3.25, "emotion": "angry", "text": "গোটেই পাড়াই চাই আছে... আৰু কোনোৱে লৰচৰ নকৰে!"}, {"id": 91, "duration_s": 3.98, "emotion": "excited", "text": "পাৰ দা, শুনিছা...? ইস্!"}, {"id": 92, "duration_s": 1.45, "emotion": "shouting", "text": "চুপ!!!"}, {"id": 93, "duration_s": 1.69, "emotion": "serious", "text": "পানীৰ কাৰণে ঠেলাঠেলি... আৰু কল এতিয়াও টোপাই আছে!"}, {"id": 94, "duration_s": 1.81, "emotion": "determined", "text": "মই কওঁনে? হিচাপ চোৱা!"}, {"id": 95, "duration_s": 2.88, "emotion": "stern_warning", "text": "শান্তি! আজিৰ ক্লাছ... পানী!"}, {"id": 96, "duration_s": 4.0, "emotion": "serious", "text": "মই কওঁনে? এটা টোপা কল, প্ৰতি ছেকেণ্ডত এটা টোপাল।"}, {"id": 97, "duration_s": 1.71, "emotion": "excited", "text": "বুন্দী? ক'ত আছে বুন্দী?"}, {"id": 98, "duration_s": 1.7, "emotion": "sarcastic", "text": "বুন্দী নহয়, টোপা!"}, {"id": 99, "duration_s": 3.09, "emotion": "proud", "text": "এটা কল, এমাহ... ষাঠিটা বালতি!"}, {"id": 100, "duration_s": 0.5, "emotion": "shocked", "text": "<gasp> ষাঠি? হায় হায়!"}, {"id": 101, "duration_s": 4.45, "emotion": "shocked", "text": "চৌদ্দ গুণ ষাঠি... আঠ শ চল্লিশ বালতি!"}, {"id": 102, "duration_s": 1.98, "emotion": "mischievous", "text": "ইমান বটল বেচিলে হ'লে..."}, {"id": 103, "duration_s": 0.83, "emotion": "stern_warning", "text": "ধনৰাম!"}, {"id": 104, "duration_s": 4.22, "emotion": "serious", "text": "আৰু ধনু খুড়াৰ পাইপ... এঘণ্টাত পঞ্চাশ বালতি!"}, {"id": 105, "duration_s": 2.47, "emotion": "embarrassed", "text": "টেনচন... অলপ অলপ হৈছে।"}, {"id": 106, "duration_s": 3.33, "emotion": "calm", "text": "মেডাম, লাইন মেৰামতি হইছে। সাঁঝত পানী আহিবে।"}, {"id": 107, "duration_s": 2.45, "emotion": "embarrassed", "text": "সাঁজলৈ? তিনি দিন নহয়নে?"}, {"id": 108, "duration_s": 2.69, "emotion": "sarcastic", "text": "তিনি দিন কুনে কলাক?"}, {"id": 109, "duration_s": 3.73, "emotion": "guilty", "text": "মানে পানী বন্ধ হোৱা নাছিল... আমি নিজেই বোৱাই দিলোঁ!"}, {"id": 110, "duration_s": 3.48, "emotion": "serious", "text": "চৌদ্দটা কল, এটা পাইপ, এটা বাথটাব..."}, {"id": 111, "duration_s": 2.64, "emotion": "mischievous", "text": "আৰু এজন চাবোনৱালা দেউতা!"}, {"id": 112, "duration_s": 2.27, "emotion": "determined", "text": "ব্যস! আমি সকলোৱে চাম।"}, {"id": 113, "duration_s": 1.42, "emotion": "determined", "text": "দহ ছেকেণ্ড।"}, {"id": 114, "duration_s": 2.99, "emotion": "proud", "text": "ন ছেকেণ্ড! গোটেই পাড়াই চাব!"}, {"id": 115, "duration_s": 1.77, "emotion": "proud", "text": "এইটো মোৰ বাঁও হাতৰ খেল!"}, {"id": 116, "duration_s": 2.64, "emotion": "relieved", "text": "আঃ... গা ধুলোঁ! শেষত!"}, {"id": 117, "duration_s": 2.17, "emotion": "excited", "text": "শুনিছেনে? হৰি গা ধুলে!"}, {"id": 118, "duration_s": 4.88, "emotion": "happy", "text": "এটা বালতি, এখন কাপোৰ... গাড়ী জিলিকিল!"}, {"id": 119, "duration_s": 2.0, "emotion": "laughing", "text": "<laugh> মহো! কিন্তু বালতিৰে!"}, {"id": 120, "duration_s": 3.82, "emotion": "proud", "text": "টোপাল পানীও মোৰ! এটোপালো অপচয় নহয়!"}, {"id": 121, "duration_s": 2.63, "emotion": "proud", "text": "বিজ্ঞানে কয়... টোপাল কল ঠিক কৰা।"}, {"id": 122, "duration_s": 2.41, "emotion": "surprised", "text": "পণ্ডিত পবিত্ৰ দা... প্ৰথমবাৰ ঠিক!"}, {"id": 123, "duration_s": 3.02, "emotion": "sad", "text": "মিঠা কল... অৱসৰ ল'লে।"}, {"id": 124, "duration_s": 2.2, "emotion": "happy", "text": "চালৰ পানী, পোনে ড্ৰামত!"}, {"id": 125, "duration_s": 2.48, "emotion": "loving", "text": "এতিয়া বৰষুণলৈ নজৰ নালাগিব।"}, {"id": 126, "duration_s": 0.77, "emotion": "excited", "text": "লাইভ চলিছে! হেছটেগ টোপাল বচাওক!"}, {"id": 127, "duration_s": 4.62, "emotion": "happy", "text": "সেইদিনা চৌদ্দটা কল ঠিক হ'ল... আৰু এজন দেউতা গা ধুলে।"}, {"id": 128, "duration_s": 3.86, "emotion": "calm", "text": "সন্ধিয়া হ'ল... আৰু কলত পুনৰ পানী আহিল।"}, {"id": 129, "duration_s": 4.19, "emotion": "proud", "text": "আজিৰ পৰা হৰি বৰা... এটা বালতিত গা ধোৱা!"}, {"id": 130, "duration_s": 0.52, "emotion": "stern_warning", "text": "আধা।"}, {"id": 131, "duration_s": 2.05, "emotion": "calm", "text": "টোপাল টোপালে সাগৰ হয়..."}, {"id": 132, "duration_s": 2.07, "emotion": "serious", "text": "...আৰু টোপাল টোপালে শুকায়ো।"}, {"id": 133, "duration_s": 5.37, "emotion": "serious", "text": "টোপাল কল আজিয়ে ঠিক কৰা... কাইলৈ নহয়।"}, {"id": 134, "duration_s": 7.75, "emotion": "calm", "text": "আৰু আকাশৰ পানী... ড্ৰামত।"}, {"id": 135, "duration_s": 1.36, "emotion": "determined", "text": "গাড়ী বালতিৰে!"}, {"id": 136, "duration_s": 1.29, "emotion": "determined", "text": "পাইপ খোলা নহয়!"}, {"id": 137, "duration_s": 1.94, "emotion": "proud", "text": "আৰু বৰষুণৰ পানী... চালত!"}, {"id": 138, "duration_s": 0.84, "emotion": "excited", "text": "বৰষুণ!"}, {"id": 139, "duration_s": 2.78, "emotion": "excited", "text": "ফ্ৰী শ্ববাৰ! ভগোৱান, চলাই দিয়া!"}]