[{"id": 1, "duration_s": 3.45, "emotion": "excited", "text": "కాలనీలో అతిపెద్ద పోటీ... తాడు లాగుడు!"}, {"id": 2, "duration_s": 4.01, "emotion": "proud", "text": "ఏడు రోజుల పౌడర్! నేను ఎవ్వరికీ భయపడను!"}, {"id": 3, "duration_s": 2.25, "emotion": "calm", "text": "పైసా సుబ్బయ్యా, టీ వేడిగా!"}, {"id": 4, "duration_s": 1.84, "emotion": "excited", "text": "లైవ్‌లో ఉన్నాం! స్లో మోషన్!"}, {"id": 5, "duration_s": 4.03, "emotion": "mischievous", "text": "ఇదంతా మొదలైంది... ఒక డబ్బాతో."}, {"id": 6, "duration_s": 1.37, "emotion": "happy", "text": "ఏడు రోజుల ముందు. కాలనీ స్పోర్ట్స్ వీక్."}, {"id": 7, "duration_s": 6.43, "emotion": "excited", "text": "ఈ ఆదివారం తాడాట! రమణ కుటుంబం వర్సెస్ సుబ్బయ్య కుటుంబం!"}, {"id": 8, "duration_s": 2.85, "emotion": "proud", "text": "మనదే గెలుపు! ఎవరికీ బెదరను!"}, {"id": 9, "duration_s": 4.58, "emotion": "sarcastic", "text": "లెక్క వేశా. రమణ గెలిచే ఛాన్స్... సున్నా."}, {"id": 10, "duration_s": 2.0, "emotion": "sarcastic", "text": "ఎవరికీ భయపడరా రమణా?"}, {"id": 11, "duration_s": 2.67, "emotion": "comic_panic", "text": "ఎవరికీ లేదు! బల్లి... లేదు కదా!"}, {"id": 12, "duration_s": 2.06, "emotion": "stern_warning", "text": "ష్! అంకుల్ మళ్ళీ దూకేస్తారు."}, {"id": 13, "duration_s": 1.05, "emotion": "happy", "text": "పదండి, వెళ్దాం!"}, {"id": 14, "duration_s": 1.77, "emotion": "calm", "text": "తప్పుకో అన్నా, నేను చూస్తా."}, {"id": 15, "duration_s": 2.77, "emotion": "shocked", "text": "వదినా, మీరు ట్రాక్టర్ కూడా లాగేస్తారు!"}, {"id": 16, "duration_s": 0.83, "emotion": "excited", "text": "టెన్షన్ వద్దు అన్నయ్యా!"}, {"id": 17, "duration_s": 3.72, "emotion": "worried", "text": "టెన్షనా? ఆటో లాగేసింది బుజ్జీ!"}, {"id": 18, "duration_s": 3.43, "emotion": "proud", "text": "నా కొడుకే గెలుస్తాడు! కాలనీ అంతా చూస్తుంది!"}, {"id": 19, "duration_s": 3.02, "emotion": "mischievous", "text": "విన్నారా? రమణగారు బల్లికి ఓడారు!"}, {"id": 20, "duration_s": 2.95, "emotion": "sad", "text": "చిప్స్ ఏవి? ఆకలేస్తోంది!"}, {"id": 21, "duration_s": 4.55, "emotion": "excited", "text": "సుల్తాన్ పవర్ పౌడర్! ఏడు రోజుల్లో బాడీ, బేగి కొనండి!"}, {"id": 22, "duration_s": 2.06, "emotion": "excited", "text": "తొమ్మిదొందల తొంభైతొమ్మిదే! బేగి డెలివరీ!"}, {"id": 23, "duration_s": 2.97, "emotion": "excited", "text": "ఒక ఐడియా ఉంది! నాన్న కోసం!"}, {"id": 24, "duration_s": 4.45, "emotion": "excited", "text": "నాన్నా! ఏడు రోజుల్లో బాడీ! ఆదివారమూ ఏడు రోజుల్లోనే!"}, {"id": 25, "duration_s": 3.21, "emotion": "excited", "text": "సుల్తాన్... బాడీ... ఏడు రోజులు!"}, {"id": 26, "duration_s": 2.4, "emotion": "sarcastic", "text": "ఏడు రోజుల్లో ఆవకాయ కూడా ఊరదు!"}, {"id": 27, "duration_s": 2.54, "emotion": "proud", "text": "ఇది సైన్స్ లక్ష్మీ! ఆర్డర్!"}, {"id": 28, "duration_s": 3.42, "emotion": "proud", "text": "నా కొడుకు సుల్తాన్ అవుతాడు! కాలనీ అంతా చూస్తుంది!"}, {"id": 29, "duration_s": 3.51, "emotion": "curious", "text": "పౌడర్ తియ్యగా ఉంటుందా? నాకూ కావాలి."}, {"id": 30, "duration_s": 2.81, "emotion": "excited", "text": "సుల్తాన్ పవర్ పౌడర్ అండీ! ఎక్స్‌ప్రెస్ డెలివరీ!"}, {"id": 31, "duration_s": 1.65, "emotion": "loving", "text": "వచ్చేశాడు నా సుల్తాన్!"}, {"id": 32, "duration_s": 5.59, "emotion": "mischievous", "text": "వినా్నవా? రమణగారు డబ్బాలో బాడీ తెప్పించారు!"}, {"id": 33, "duration_s": 1.37, "emotion": "determined", "text": "ఆహ్! బలం వస్తోంది!"}, {"id": 34, "duration_s": 1.97, "emotion": "curious", "text": "నాన్నా... కండ ఎక్కడ?"}, {"id": 35, "duration_s": 2.83, "emotion": "excited", "text": "వచ్చింది! ఒక్క వెంట్రుక లేచింది!"}, {"id": 36, "duration_s": 2.35, "emotion": "shocked", "text": "వినా్నవా? బటన్ల వాన కురుస్తోంది!"}, {"id": 37, "duration_s": 1.44, "emotion": "embarrassed", "text": "బాడీ పెరుగుతోంది ఆంటీ!"}, {"id": 38, "duration_s": 1.2, "emotion": "shocked", "text": "అర అంగుళం..."}, {"id": 39, "duration_s": 0.84, "emotion": "shocked", "text": "...తగ్గింది!"}, {"id": 40, "duration_s": 2.178, "emotion": "proud", "text": "లోపల పెరుగుతోంది!"}, {"id": 41, "duration_s": 2.53, "emotion": "happy", "text": "వాసన చూస్తే కూడా బలం వస్తుంది!"}, {"id": 42, "duration_s": 1.93, "emotion": "worried", "text": "రమణా, ముక్కులో పెట్టకు!"}, {"id": 43, "duration_s": 1.2, "emotion": "comic_panic", "text": "ఆ... ఆ... ఆ..."}, {"id": 44, "duration_s": 3.18, "emotion": "proud", "text": "చూశావా? పౌడర్ బయట నుంచి కూడా పనిచేస్తుంది!"}, {"id": 45, "duration_s": 1.92, "emotion": "determined", "text": "చాలు! ఇక నేను చూస్తా."}, {"id": 46, "duration_s": 2.96, "emotion": "shocked", "text": "అయ్యో! నా సుల్తాన్ మంచు బొమ్మ అయిపోయాడు!"}, {"id": 47, "duration_s": 2.23, "emotion": "serious", "text": "ఆగండి! సైన్స్ చెబుతోంది..."}, {"id": 48, "duration_s": 1.72, "emotion": "proud", "text": "ఇది వందశాతం సుద్ద!"}, {"id": 49, "duration_s": 3.33, "emotion": "laughing", "text": "<laugh> జ్ఞానం సైన్సా? అయితే తప్పే!"}, {"id": 50, "duration_s": 5.19, "emotion": "giggly", "text": "మేఘాలు సిలిండర్ నుంచి వస్తాయన్నాడు జ్ఞానం!"}, {"id": 51, "duration_s": 3.496, "emotion": "giggly", "text": "కోడి పాలిస్తుందన్నాడు కూడా!"}, {"id": 52, "duration_s": 3.36, "emotion": "laughing", "text": "చంద్రుడి మీద టీ కొట్టుందన్నాడు కూడా!"}, {"id": 53, "duration_s": 1.34, "emotion": "pleading", "text": "కానీ ఈసారి నిజంగా!"}, {"id": 54, "duration_s": 2.57, "emotion": "serious", "text": "దిష్టి తగలొద్దు నా సుల్తాన్‌కి!"}, {"id": 55, "duration_s": 2.33, "emotion": "proud", "text": "సుల్తాన్ ఆదివారం కనిపిస్తాడు!"}, {"id": 56, "duration_s": 2.72, "emotion": "sad", "text": "చూడండి... రాస్తుంది కూడా. ఎవరూ చూడరు."}, {"id": 57, "duration_s": 2.09, "emotion": "excited", "text": "టెన్షన్ వద్దు! ఇది బంగారు గని!"}, {"id": 58, "duration_s": 1.86, "emotion": "mischievous", "text": "వందకు కొను, డబుల్కు!"}, {"id": 59, "duration_s": 2.64, "emotion": "mischievous", "text": "పైసా సుబ్బయ్యా, డీలర్‌షిప్! యాభై డబ్బాలు!"}, {"id": 60, "duration_s": 2.95, "emotion": "curious", "text": "యాభై సుల్తాన్లా? లెక్క వేస్తా."}, {"id": 61, "duration_s": 4.61, "emotion": "serious", "text": "ఐదు వేలు. రెండుసార్లు లెక్క... మూడోసారి కూడా."}, {"id": 62, "duration_s": 2.2, "emotion": "pleading", "text": "ఒక రూపాయి కూడా తక్కువ కాదు!"}, {"id": 63, "duration_s": 0.92, "emotion": "stern_warning", "text": "సుబ్బయ్యా!"}, {"id": 64, "duration_s": 3.98, "emotion": "embarrassed", "text": "రంగమ్మా, ఇది బిజినెస్! డబుల్ లాభం!"}, {"id": 65, "duration_s": 2.14, "emotion": "sarcastic", "text": "లేక డబుల్ నష్టం?"}, {"id": 66, "duration_s": 3.22, "emotion": "proud", "text": "యాభై డబ్బాలు! కాలనీ అంతా సుల్తాన్లే!"}, {"id": 67, "duration_s": 2.41, "emotion": "happy", "text": "నేనేం తినలేదు."}, {"id": 68, "duration_s": 2.51, "emotion": "surprised", "text": "ఇది తీపి కాదు... సుద్ద!"}, {"id": 69, "duration_s": 1.52, "emotion": "shouting", "text": "ష్! బిజినెస్!"}, {"id": 70, "duration_s": 3.18, "emotion": "mischievous", "text": "ట్రైనింగ్ వీక్. కోచ్... బుజ్జి."}, {"id": 71, "duration_s": 2.31, "emotion": "proud", "text": "కోచ్ బుజ్జి! పరిగెత్తు, నేను లెక్కిస్తా."}, {"id": 72, "duration_s": 1.87, "emotion": "proud", "text": "పరుగెందుకు? పౌడరుందిగా!"}, {"id": 73, "duration_s": 2.24, "emotion": "determined", "text": "ఈరోజు చెట్టునే పెకిలిస్తా!"}, {"id": 74, "duration_s": 2.85, "emotion": "worried", "text": "మూడడుగులు! చెప్పులు అరిగిపోతే?"}, {"id": 75, "duration_s": 1.66, "emotion": "proud", "text": "ఇదే నా ట్రైనింగ్!"}, {"id": 76, "duration_s": 1.62, "emotion": "calm", "text": "నాకు ట్రైనింగ్ అక్కర్లేదు."}, {"id": 77, "duration_s": 2.17, "emotion": "tired", "text": "నాన్నా, ఏ పౌడర్ వాడతారు?"}, {"id": 78, "duration_s": 0.86, "emotion": "calm", "text": "రొట్టె."}, {"id": 79, "duration_s": 0.82, "emotion": "stern_warning", "text": "రొట్టె తిను!"}, {"id": 80, "duration_s": 1.72, "emotion": "proud", "text": "సుల్తాన్లు రొట్టె తినరు!"}, {"id": 81, "duration_s": 3.45, "emotion": "curious", "text": "ఆరు రోజులైంది. కండ?"}, {"id": 82, "duration_s": 1.12, "emotion": "sarcastic", "text": "ష్! లోపల పెరుగుతోంది."}, {"id": 83, "duration_s": 1.32, "emotion": "determined", "text": "మా నాన్న సుల్తాన్!"}, {"id": 84, "duration_s": 2.67, "emotion": "excited", "text": "ఆదివారం. కాలనీ మహా పోటీ!"}, {"id": 85, "duration_s": 3.52, "emotion": "serious", "text": "ఎంక్వైరీ! సమోసాపై!"}, {"id": 86, "duration_s": 2.07, "emotion": "excited", "text": "లైవ్‌లో ఉన్నాం! మహా పోటీ!"}, {"id": 87, "duration_s": 1.67, "emotion": "proud", "text": "ఈరోజు సుల్తాన్ రోజు!"}, {"id": 88, "duration_s": 2.91, "emotion": "mischievous", "text": "గెలిస్తే పౌడర్ అమ్ముడు, ఓడినా అంతే!"}, {"id": 89, "duration_s": 2.02, "emotion": "calm", "text": "పైసా సుబ్బయ్యా, వెనక పట్టు."}, {"id": 90, "duration_s": 2.49, "emotion": "sarcastic", "text": "పట్టా. కష్టానికి బిల్లు వేరు."}, {"id": 91, "duration_s": 3.5, "emotion": "excited", "text": "కాలనీ అంతా చూస్తుంది! రమణ టీమ్ జిందాబాద్!"}, {"id": 92, "duration_s": 3.5, "emotion": "serious", "text": "దిష్టి తగలొద్దు! ఇక తాడు పవిత్రం."}, {"id": 93, "duration_s": 2.7, "emotion": "shouting", "text": "రెడీ... లాగండి!"}, {"id": 94, "duration_s": 2.72, "emotion": "determined", "text": "పూర్తి... బలం... పెట్టండి!"}, {"id": 95, "duration_s": 2.29, "emotion": "curious", "text": "పైసా సుబ్బయ్యా, మొదలెప్పుడు?"}, {"id": 96, "duration_s": 1.85, "emotion": "comic_panic", "text": "టెన్షన్ వద్దు... ఆహ్... టెన్షన్ పడండి!"}, {"id": 97, "duration_s": 2.08, "emotion": "tired", "text": "పైసా సుబ్బయ్యా, టీ చల్లారుతోంది."}, {"id": 98, "duration_s": 1.71, "emotion": "laughing", "text": "స్లో మోషన్‌లో మళ్ళీ!"}, {"id": 99, "duration_s": 2.56, "emotion": "embarrassed", "text": "నేనెవరికీ... బెదరను."}, {"id": 100, "duration_s": 2.66, "emotion": "curious", "text": "నాన్నా, పౌడర్ లోపల పెరిగిందా?"}, {"id": 101, "duration_s": 2.36, "emotion": "shocked", "text": "అయ్యో రామా! దిష్టి తగిలింది!"}, {"id": 102, "duration_s": 3.27, "emotion": "embarrassed", "text": "అయ్యో! కాలనీ అంతా చూసేసింది!"}, {"id": 103, "duration_s": 3.78, "emotion": "excited", "text": "గెలిచాం! ఇక పౌడర్ ధర డబుల్!"}, {"id": 104, "duration_s": 1.95, "emotion": "happy", "text": "గెలుపు మిఠాయి!"}, {"id": 105, "duration_s": 5.19, "emotion": "tired", "text": "సుబ్బయ్యలే గెలిచారు! ఎంక్వైరీ... పూర్తి..."}, {"id": 106, "duration_s": 2.45, "emotion": "excited", "text": "పది లక్షల వ్యూస్! సుల్తాన్ వైరల్!"}, {"id": 107, "duration_s": 1.93, "emotion": "excited", "text": "వినా్నవా? అమెరికా వాళ్ళు కూడా చూస్తున్నారు!"}, {"id": 108, "duration_s": 1.775, "emotion": "sad", "text": "ఇక నన్నెవరూ చూడరు."}, {"id": 109, "duration_s": 1.94, "emotion": "curious", "text": "నాన్నా? లోపలేనా?"}, {"id": 110, "duration_s": 1.006, "emotion": "sad", "text": "లేను."}, {"id": 111, "duration_s": 2.3, "emotion": "sarcastic", "text": "భోజనం బకెట్లో పంపనా?"}, {"id": 112, "duration_s": 2.458, "emotion": "determined", "text": "రొట్టె వద్దు... పౌడర్!"}, {"id": 113, "duration_s": 0.97, "emotion": "proud", "text": "నేను చెప్పనా?"}, {"id": 114, "duration_s": 4.6, "emotion": "serious", "text": "కంపెనీ చిరునామా? లేదు. లైసెన్స్? లేదు."}, {"id": 115, "duration_s": 2.56, "emotion": "sarcastic", "text": "రివ్యూలన్నీ... ఒకే మనిషివి!"}, {"id": 116, "duration_s": 2.29, "emotion": "angry", "text": "అంటే... అంతా మోసం!"}, {"id": 117, "duration_s": 3.2, "emotion": "guilty", "text": "ఐడియా నాదే... నాన్నకు చెప్పాలి."}, {"id": 118, "duration_s": 4.14, "emotion": "sad", "text": "యాభై డబ్బాలు. కస్టమర్లు... సున్నా."}, {"id": 119, "duration_s": 2.01, "emotion": "happy", "text": "పైసా సుబ్బయ్యా, టెన్షన్ వద్దు!"}, {"id": 120, "duration_s": 1.42, "emotion": "angry", "text": "టెన్షన్ ఇచ్చిందే నువ్వు!"}, {"id": 121, "duration_s": 3.85, "emotion": "proud", "text": "పిల్లలు నిరూపించారు! సైన్స్ చెబుతోంది... సుద్ద!"}, {"id": 122, "duration_s": 2.8, "emotion": "tired", "text": "అవును జ్ఞానం, నువ్వే కరెక్ట్."}, {"id": 123, "duration_s": 2.46, "emotion": "shocked", "text": "నేను... సరి? తొలిసారి?"}, {"id": 124, "duration_s": 3.36, "emotion": "happy", "text": "మంచి సుద్ద! బ్లాక్‌బోర్డ్ కోసం అన్నీ తీసుకెళ్తా."}, {"id": 125, "duration_s": 2.25, "emotion": "pleading", "text": "ఎంత ఇస్తారు?"}, {"id": 126, "duration_s": 1.14, "emotion": "loving", "text": "ఆశీర్వాదం."}, {"id": 127, "duration_s": 3.94, "emotion": "determined", "text": "నకిలీ ప్రకటన... రిపోర్ట్! బ్లాక్!"}, {"id": 128, "duration_s": 1.82, "emotion": "embarrassed", "text": "తొమ్మిది తొమ్మిది తొమ్మిది..."}, {"id": 129, "duration_s": 5.36, "emotion": "calm", "text": "రమణా, ఏడు రోజుల్లో బాడీ ఇచ్చే డబ్బా..."}, {"id": 130, "duration_s": 4.16, "emotion": "sarcastic", "text": "...ఏడు రోజుల్లో జేబు ఖాళీ చేస్తుంది."}, {"id": 131, "duration_s": 5.7, "emotion": "serious", "text": "బాడీ డబ్బాతో రాదు, రొట్టె, పరుగుతో వస్తుంది."}, {"id": 132, "duration_s": 2.85, "emotion": "determined", "text": "చిరునామా, లైసెన్స్, అసలు రివ్యూలు చూడండి!"}, {"id": 133, "duration_s": 2.74, "emotion": "happy", "text": "సుల్తాన్లు... రొట్టె తింటారు!"}, {"id": 134, "duration_s": 2.34, "emotion": "tired", "text": "నాన్నా... కొంచెం నెమ్మదిగా!"}, {"id": 135, "duration_s": 2.11, "emotion": "happy", "text": "పదండి, పోదాం... నడిచే!"}, {"id": 136, "duration_s": 0.771, "emotion": "happy", "text": "తొందరగా!"}, {"id": 137, "duration_s": 2.2, "emotion": "happy", "text": "పరుగు ఉచితం! బెస్ట్ స్కీమ్!"}, {"id": 138, "duration_s": 3.62, "emotion": "excited", "text": "టెన్షన్ వద్దు! సుల్తాన్ హెయిర్ ఆయిల్! ఏడు రోజుల్లో జుట్టు!"}, {"id": 139, "duration_s": 2.56, "emotion": "embarrassed", "text": "టెన్షన్... తీసుకున్నా."}, {"id": 140, "duration_s": 2.37, "emotion": "excited", "text": "నాన్నా! అసలైన కండ!"}]