[{"id": 1, "duration_s": 3.86, "emotion": "mischievous", "text": "ഇതാണ് നമ്മുടെ കോളനി, ഇതിലെ ഏറ്റവും വലിയ ടാങ്ക്."}, {"id": 2, "duration_s": 1.95, "emotion": "mischievous", "text": "ഈ ടാങ്കിൽ ഒരു ഭൂതമുണ്ട്! ഊഊഊ!"}, {"id": 3, "duration_s": 3.4, "emotion": "curious", "text": "ഭൂതമില്ല. ഞാൻ പറയട്ടെ?"}, {"id": 4, "duration_s": 0.68, "emotion": "stern_warning", "text": "മിണ്ടരുത്!"}, {"id": 5, "duration_s": 3.72, "emotion": "mischievous", "text": "എന്റെ നിധി... ഇവിടെ ആരും തപ്പില്ല."}, {"id": 6, "duration_s": 1.94, "emotion": "sarcastic", "text": "നിന്റെ ഭൂതത്തിന് ടോർച്ച് പേടി!"}, {"id": 7, "duration_s": 3.02, "emotion": "mischievous", "text": "ഭൂതം ഉള്ളതാ! ഇന്ന് രാത്രി കാണാം!"}, {"id": 8, "duration_s": 2.36, "emotion": "calm", "text": "കുട്ടികളേ! ഭക്ഷണം റെഡി!"}, {"id": 9, "duration_s": 2.03, "emotion": "giggly", "text": "ഉണ്ണി എപ്പഴേ എത്തി!"}, {"id": 10, "duration_s": 3.97, "emotion": "scared_whisper", "text": "പിന്നെ... രാത്രി കൃത്യം പന്ത്രണ്ടു മണിക്ക്..."}, {"id": 11, "duration_s": 1.67, "emotion": "scared_whisper", "text": "ഭ... ഭ... ഭൂതം!"}, {"id": 12, "duration_s": 1.47, "emotion": "panicked", "text": "ടാങ്കിന് കണ്ണ് തട്ടി!"}, {"id": 13, "duration_s": 3.052, "emotion": "scared_whisper", "text": "കുഞ്ഞമ്മേ! എണീക്ക്! ഭൂതം!"}, {"id": 14, "duration_s": 2.94, "emotion": "comic_panic", "text": "നാരങ്ങ! മുളക്! നാരങ്ങ!"}, {"id": 15, "duration_s": 2.59, "emotion": "excited", "text": "ഭൂതമോ? ആഹാ! ശരിക്കും?"}, {"id": 16, "duration_s": 1.76, "emotion": "excited", "text": "കേട്ടോ? ടാങ്കിൽ ഭൂതം!"}, {"id": 17, "duration_s": 3.47, "emotion": "mischievous", "text": "പത്തു സെക്കൻഡിൽ... കോളനി മൊത്തം അറിഞ്ഞു."}, {"id": 18, "duration_s": 2.69, "emotion": "excited", "text": "ഹായ് ഫ്രണ്ട്സ്! ലൈവ് പോകുന്നു!"}, {"id": 19, "duration_s": 3.18, "emotion": "excited", "text": "ഭൂതം ലൈവ്! രണ്ടു ലക്ഷം വ്യൂസ്!"}, {"id": 20, "duration_s": 2.08, "emotion": "scared_whisper", "text": "ഭൂതമേ, ഒരു സെൽഫി പ്ലീസ്?"}, {"id": 21, "duration_s": 3.53, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... ഭൂതം വരുന്നത് വൈഫൈ വഴി!"}, {"id": 22, "duration_s": 1.77, "emotion": "proud", "text": "വൈഫൈ ഓഫ്. ഭൂതം ഔട്ട്."}, {"id": 23, "duration_s": 2.47, "emotion": "serious", "text": "ശ്രുതി തെറ്റി. പത്തിൽ നാല്."}, {"id": 24, "duration_s": 2.43, "emotion": "happy", "text": "ആ! ഇപ്പോ ഏഴ്!"}, {"id": 25, "duration_s": 1.4, "emotion": "proud", "text": "ഭൂതം പ്രേതം ഒന്നുമില്ല!"}, {"id": 26, "duration_s": 2.05, "emotion": "proud", "text": "എനിക്കാരെയും പേടിയില്ല!"}, {"id": 27, "duration_s": 3.14, "emotion": "sarcastic", "text": "ഇന്നലെ പല്ലി കണ്ട് അലമാരമേൽ കയറിയതാര്?"}, {"id": 28, "duration_s": 2.71, "emotion": "embarrassed", "text": "അത്... അലമാരയിലെ പൊടി നോക്കിയതാ."}, {"id": 29, "duration_s": 3.287, "emotion": "proud", "text": "പോ മോനേ! നാട്ടുകാർ മൊത്തം കാണട്ടെ!"}, {"id": 30, "duration_s": 3.73, "emotion": "scared_whisper", "text": "ഭൂതമേ... ഞാൻ വെറുതെ... നടക്കാനിറങ്ങിയതാ."}, {"id": 31, "duration_s": 2.14, "emotion": "sarcastic", "text": "വന്നോ? നടത്തം കഴിഞ്ഞോ?"}, {"id": 32, "duration_s": 3.14, "emotion": "scared_whisper", "text": "ആ... നല്ല... കാറ്റാ."}, {"id": 33, "duration_s": 2.34, "emotion": "guilty", "text": "ഞാൻ വെറുതേ... തമാശയ്ക്ക് ചെയ്തതാ."}, {"id": 34, "duration_s": 3.09, "emotion": "mischievous", "text": "ടെൻഷൻ വേണ്ട! ഭൂതമുണ്ടെങ്കിൽ ബിസിനസുണ്ട്!"}, {"id": 35, "duration_s": 4.78, "emotion": "mischievous", "text": "പിറ്റേന്ന് രാവിലെ... കോളനി പേടിച്ചു. കാശു കുട്ടപ്പൻ ഹാപ്പി."}, {"id": 36, "duration_s": 2.14, "emotion": "comic_panic", "text": "ഭൂതവെള്ളമോ? അയ്യോ, വേണ്ട!"}, {"id": 37, "duration_s": 2.19, "emotion": "sarcastic", "text": "പിന്നെ ചായ എന്തിലുണ്ടാക്കും?"}, {"id": 38, "duration_s": 2.99, "emotion": "proud", "text": "ഒരു ബക്കറ്റ്, രണ്ടു രൂപ! വരിയിൽ!"}, {"id": 39, "duration_s": 1.65, "emotion": "serious", "text": "നായയ്ക്കും രണ്ടു രൂപ."}, {"id": 40, "duration_s": 1.92, "emotion": "proud", "text": "ഒരു രൂപ കുറയില്ല!"}, {"id": 41, "duration_s": 4.892, "emotion": "stern_warning", "text": "കാശു കുട്ടപ്പാ! വീട്ടുകാരോടും കാശോ?"}, {"id": 42, "duration_s": 2.89, "emotion": "embarrassed", "text": "വീട്ടുകാർക്ക്... പകുതി വില."}, {"id": 43, "duration_s": 2.44, "emotion": "comic_panic", "text": "ഉണ്ണീ! നാൽപ്പത് ബക്കറ്റായി!"}, {"id": 44, "duration_s": 1.24, "emotion": "happy", "text": "ദാഹവും ഉണ്ടായി."}, {"id": 45, "duration_s": 2.02, "emotion": "happy", "text": "വാ, പോകാം! വെള്ളം കൊണ്ടുവരാൻ!"}, {"id": 46, "duration_s": 1.48, "emotion": "sad", "text": "ഇന്നും ഇല്ലേ, റാണീ?"}, {"id": 47, "duration_s": 2.54, "emotion": "excited", "text": "കേട്ടോ? ഭൂതം രാത്രി എന്റെ പേര് വിളിച്ചു!"}, {"id": 48, "duration_s": 1.82, "emotion": "proud", "text": "ഹും! എന്റെ പേര് രണ്ടു വട്ടം!"}, {"id": 49, "duration_s": 3.5, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... ഭൂതത്തിന് തണുത്ത വെള്ളം ഇഷ്ടം."}, {"id": 50, "duration_s": 0.93, "emotion": "stern_warning", "text": "മിണ്ടരുത്!"}, {"id": 51, "duration_s": 1.49, "emotion": "curious", "text": "ഞാൻ പറയട്ടെ? പിന്നെ."}, {"id": 52, "duration_s": 3.23, "emotion": "excited", "text": "സഹോദരങ്ങളേ! ഭൂതപ്പേടിയോ? ടെൻഷൻ വേണ്ട!"}, {"id": 53, "duration_s": 2.48, "emotion": "proud", "text": "ഇതാ... താന്ത്രികൻ ടിംഗു ബാബ!"}, {"id": 54, "duration_s": 5.2, "emotion": "serious", "text": "അലഖ് നിരഞ്ജൻ! ഭൂതം... ശ്ശി വല്യതാ ട്ടാ!"}, {"id": 55, "duration_s": 3.36, "emotion": "embarrassed", "text": "ഹെ ഹെ... ഇത് സ്വാമിയുടെ... തലകീഴ് യോഗ!"}, {"id": 56, "duration_s": 2.72, "emotion": "curious", "text": "താടി... തലകീഴാ."}, {"id": 57, "duration_s": 0.75, "emotion": "serious", "text": "കുറിച്ചോ!"}, {"id": 58, "duration_s": 3.43, "emotion": "proud", "text": "ഭൂത-പ്രൂഫ് നാരങ്ങ! അഞ്ഞൂറേ ഉള്ളൂ ട്ടാ!"}, {"id": 59, "duration_s": 3.91, "emotion": "shocked", "text": "അഞ്ഞൂറോ? എന്റെ കടയിൽ രണ്ടു രൂപ!"}, {"id": 60, "duration_s": 1.68, "emotion": "comic_panic", "text": "രണ്ടെണ്ണം താ! വേഗം!"}, {"id": 61, "duration_s": 2.957, "emotion": "excited", "text": "സ്വാമീ, എനിക്ക് നാരങ്ങ-മുളക് കോംബോ!"}, {"id": 62, "duration_s": 1.64, "emotion": "proud", "text": "എട്ട് നാരങ്ങ! മുഴുവൻ!"}, {"id": 63, "duration_s": 3.3, "emotion": "proud", "text": "എട്ടോ? ഹും! പത്തു താ! നാട്ടുകാർ കാണട്ടെ!"}, {"id": 64, "duration_s": 1.24, "emotion": "happy", "text": "പത്ത്! ഒന്ന് ഫ്രീ!"}, {"id": 65, "duration_s": 2.24, "emotion": "angry", "text": "ഹലോ? സ്വാമീ, പന്ത്രണ്ട് കിട്ടുമോ?"}, {"id": 66, "duration_s": 2.65, "emotion": "proud", "text": "ഇനി എനിക്കാരെയും പേടിയില്ല!"}, {"id": 67, "duration_s": 1.11, "emotion": "sarcastic", "text": "പല്ലിയെയും?"}, {"id": 68, "duration_s": 1.6, "emotion": "sarcastic", "text": "നാരങ്ങ ഉപകരിച്ചു."}, {"id": 69, "duration_s": 2.729, "emotion": "sarcastic", "text": "അയ്യായിരത്തിന്റെ നാരങ്ങ, അച്ഛാ!"}, {"id": 70, "duration_s": 2.45, "emotion": "calm", "text": "നാരങ്ങാവെള്ളം കലക്കും."}, {"id": 71, "duration_s": 4.38, "emotion": "mischievous", "text": "സന്ധ്യയ്ക്ക് കോളനിയിൽ ആളു കുറവ്, നാരങ്ങ കൂടുതൽ."}, {"id": 72, "duration_s": 4.26, "emotion": "mischievous", "text": "ഇന്ന് രാത്രി ഒരു ഉഗ്രൻ 'ഊഊഊ' വേണം."}, {"id": 73, "duration_s": 3.04, "emotion": "mischievous", "text": "കാറ്റടിച്ചാൽ... ഇരട്ടി ലാഭം ട്ടാ!"}, {"id": 74, "duration_s": 3.49, "emotion": "mischievous", "text": "രാത്രി... കോളനി മൊത്തം അപ്പൂപ്പന്റെ മുറ്റത്ത്."}, {"id": 75, "duration_s": 1.4, "emotion": "tired", "text": "അന്വേഷിക്കും... ഖർർർ..."}, {"id": 76, "duration_s": 8.0, "emotion": "serious", "text": "സയൻസ് പറയുന്നു, ഭൂതം കൃത്യം പന്ത്രണ്ടിനേ വരൂ."}, {"id": 77, "duration_s": 1.72, "emotion": "tired", "text": "ഇപ്പോൾ പതിനൊന്നര. ഉറങ്ങ്."}, {"id": 78, "duration_s": 1.54, "emotion": "angry", "text": "കേട്ടോ? മോഷണം!"}, {"id": 79, "duration_s": 3.15, "emotion": "guilty", "text": "ഇതെല്ലാം... എന്റെ കഥ കാരണമാ."}, {"id": 80, "duration_s": 1.23, "emotion": "serious", "text": "മിണ്ടരുത്! കേൾക്ക്."}, {"id": 81, "duration_s": 4.23, "emotion": "shouting", "text": "ആരാ? അന്വേഷിക്കും!"}, {"id": 82, "duration_s": 1.93, "emotion": "excited", "text": "കൊള്ളാം! പത്തിൽ പത്ത്!"}, {"id": 83, "duration_s": 1.69, "emotion": "comic_panic", "text": "ഭൂതം! ഭൂതം! ഭൂതം!"}, {"id": 84, "duration_s": 0.768, "emotion": "panicked", "text": "ഭൂതം!"}, {"id": 85, "duration_s": 1.78, "emotion": "comic_panic", "text": "ഞാനാ! സുരേഷ്!"}, {"id": 86, "duration_s": 1.49, "emotion": "panicked", "text": "ഭൂതം സംസാരിക്കുന്നു!"}, {"id": 87, "duration_s": 2.15, "emotion": "determined", "text": "ഭൂതമോ? എന്റെ ചെരിപ്പ് കണ്ടോ!"}, {"id": 88, "duration_s": 3.51, "emotion": "embarrassed", "text": "അമ്മേ... ഉന്നം ഇപ്പോഴും... അടിപൊളി."}, {"id": 89, "duration_s": 2.39, "emotion": "excited", "text": "ലൈവ് പോകുന്നു! അഞ്ചു ലക്ഷം!"}, {"id": 90, "duration_s": 1.95, "emotion": "comic_panic", "text": "വാ, പോകാം! എല്ലാവരും ഓട്ടോയിൽ!"}, {"id": 91, "duration_s": 1.62, "emotion": "determined", "text": "മതി! ഇനി ഞാൻ നോക്കാം."}, {"id": 92, "duration_s": 4.27, "emotion": "calm", "text": "മോളേ, ഒന്ന് എണ്ണി നോക്ക്. കുട്ടികൾ എവിടെ?"}, {"id": 93, "duration_s": 1.97, "emotion": "determined", "text": "ഒരു ഐഡിയ ഉണ്ട്! ഭൂതത്തോട് ചോദിക്കാം."}, {"id": 94, "duration_s": 3.06, "emotion": "curious", "text": "ഞാൻ പറയട്ടെ? പേടി ചോദ്യങ്ങളെ പേടിക്കും."}, {"id": 95, "duration_s": 1.7, "emotion": "stern_warning", "text": "മിണ്ടരുത്! ആദ്യം ഞാൻ."}, {"id": 96, "duration_s": 2.34, "emotion": "proud", "text": "ഞാൻ... സ്നാക്സ് സംരക്ഷിക്കാം."}, {"id": 97, "duration_s": 2.73, "emotion": "sarcastic", "text": "ഭൂതത്തെ കിട്ടി. തീറ്റ ഭൂതം."}, {"id": 98, "duration_s": 4.207, "emotion": "curious", "text": "നോക്ക്! കാറ്റടിക്കുമ്പോഴേ ശബ്ദം വരൂ!"}, {"id": 99, "duration_s": 2.18, "emotion": "laughing", "text": "ഭൂതത്തിന് എന്റെ വിരൽ പേടി!"}, {"id": 100, "duration_s": 4.08, "emotion": "proud", "text": "കാറ്റ്, പൈപ്പ്, വിള്ളൽ. ഭൂതം ഒന്ന് ക്ലിയർ."}, {"id": 101, "duration_s": 2.38, "emotion": "curious", "text": "ശബ്ദം പൈപ്പാ. കണ്ണോ?"}, {"id": 102, "duration_s": 2.17, "emotion": "proud", "text": "ടോർച്ച് വെളിച്ചം പൂച്ചക്കണ്ണിൽ തിളങ്ങും."}, {"id": 103, "duration_s": 2.53, "emotion": "happy", "text": "ഭൂതമല്ല, പൂച്ച!"}, {"id": 104, "duration_s": 2.99, "emotion": "stern_warning", "text": "ആരും അകത്തു പോകേണ്ട. ഉണ്ണീ, പൊതി താ!"}, {"id": 105, "duration_s": 2.63, "emotion": "sad", "text": "എന്റെ സമോസ-ബിസ്കറ്റ്... വിട."}, {"id": 106, "duration_s": 2.09, "emotion": "happy", "text": "വാ, കുഞ്ഞു ഭൂതമേ!"}, {"id": 107, "duration_s": 2.06, "emotion": "tender", "text": "ഇവൾ ബിസ്കറ്റ് തിന്നാൻ കയറിയതാ."}, {"id": 108, "duration_s": 2.91, "emotion": "surprised", "text": "അയ്യോ! അകത്ത് ഒരു ടിന്നുമുണ്ട്!"}, {"id": 109, "duration_s": 3.95, "emotion": "embarrassed", "text": "വിശന്നു! ഏറ്റവും തണുപ്പുള്ള സ്ഥലം!"}, {"id": 110, "duration_s": 2.95, "emotion": "stern_warning", "text": "മിണ്ടരുത്! ...ശരി, ഒന്ന് താ."}, {"id": 111, "duration_s": 2.91, "emotion": "shouting", "text": "നിൽക്ക്! ഭൂതം ശ്ശി അപകടമാ ട്ടാ!"}, {"id": 112, "duration_s": 1.66, "emotion": "proud", "text": "ഇതാ നിങ്ങളുടെ ഭൂതം!"}, {"id": 113, "duration_s": 3.05, "emotion": "excited", "text": "പത്തു ലക്ഷം! ഭൂതമല്ല, പൂച്ച വൈറൽ!"}, {"id": 114, "duration_s": 2.82, "emotion": "proud", "text": "ഇതാ ഭൂതത്തിന്റെ പാട്ട്. പൊട്ടിയ പൈപ്പ്."}, {"id": 115, "duration_s": 3.09, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... ഞാൻ നേരത്തേ അറിഞ്ഞിരുന്നു."}, {"id": 116, "duration_s": 2.07, "emotion": "shocked", "text": "അയ്യോ! ഇത് ഉത്സവത്തിലെ ബലൂൺകാരനല്ലേ!"}, {"id": 117, "duration_s": 1.73, "emotion": "excited", "text": "കേട്ടോ? സ്വാമി വ്യാജനാ!"}, {"id": 118, "duration_s": 2.97, "emotion": "comic_panic", "text": "ഹെ ഹെ... സ്വാമിയുടെ ടൈം തീർന്നു ട്ടാ!"}, {"id": 119, "duration_s": 2.47, "emotion": "angry", "text": "എന്റെ നാരങ്ങയുടെ ആയിരം രൂപ!"}, {"id": 120, "duration_s": 1.78, "emotion": "shouting", "text": "ഒരു രൂപ കുറയില്ല!"}, {"id": 121, "duration_s": 2.34, "emotion": "stern_warning", "text": "ഷിബു! കാശ് തിരിച്ചു കൊടുക്ക്!"}, {"id": 122, "duration_s": 2.318, "emotion": "embarrassed", "text": "ടെൻഷൻ വേണ്ട, ചേച്ചീ... എല്ലാം തിരിച്ച്!"}, {"id": 123, "duration_s": 1.78, "emotion": "determined", "text": "എന്റെ പത്തു നാരങ്ങയോ?"}, {"id": 124, "duration_s": 1.88, "emotion": "embarrassed", "text": "ചെരിപ്പ്... ഒരിക്കലും ഉന്നം തെറ്റില്ല."}, {"id": 125, "duration_s": 2.09, "emotion": "sad", "text": "ആയിരം രൂപയ്ക്ക്... ഒരു ചെരിപ്പ്."}, {"id": 126, "duration_s": 4.62, "emotion": "mischievous", "text": "ടാങ്ക് മിണ്ടാതായി... ഇപ്പോൾ കാശു കുട്ടപ്പൻ 'ഊഊഊ' ആയി."}, {"id": 127, "duration_s": 2.01, "emotion": "happy", "text": "വാ! ഭൂതത്തിന് അവധി!"}, {"id": 128, "duration_s": 3.71, "emotion": "proud", "text": "ഭൂത-പ്രൂഫ് നാരങ്ങ... ഇനി ദാഹ-പ്രൂഫ്!"}, {"id": 129, "duration_s": 2.93, "emotion": "proud", "text": "എന്റെ ഗ്ലാസ് വലുത്. നാട്ടുകാർ കാണട്ടെ!"}, {"id": 130, "duration_s": 2.12, "emotion": "embarrassed", "text": "കണ്ണേറല്ല... ദാഹമാ."}, {"id": 131, "duration_s": 2.29, "emotion": "guilty", "text": "കേട്ടോ? ...ആദ്യം ഒന്ന് അന്വേഷിക്കട്ടെ."}, {"id": 132, "duration_s": 3.75, "emotion": "happy", "text": "വിശപ്പല്ല... ഇന്ന് ദാഹമായിരുന്നു!"}, {"id": 133, "duration_s": 2.88, "emotion": "guilty", "text": "അപ്പൂപ്പാ, എല്ലാം എന്റെ ഭൂതക്കഥയിൽ തുടങ്ങിയതാ."}, {"id": 134, "duration_s": 4.21, "emotion": "serious", "text": "പേടിക്ക് മരുന്ന് ചോദ്യമാ... സ്വാമിയല്ല."}, {"id": 135, "duration_s": 4.89, "emotion": "calm", "text": "ആദ്യം ചോദിക്ക്, പിന്നെ പരിശോധിക്ക്, പിന്നെ വിശ്വസിക്ക്."}, {"id": 136, "duration_s": 2.03, "emotion": "proud", "text": "പേടി വിൽക്കുന്നവർക്ക്... കാശില്ല!"}, {"id": 137, "duration_s": 1.85, "emotion": "stern_warning", "text": "കേട്ടോ? ഇനി മിണ്ടരുത്!"}, {"id": 138, "duration_s": 2.84, "emotion": "proud", "text": "ഞാൻ പറഞ്ഞില്ലേ? എനിക്കാരെയും പേടിയില്ല!"}]