[{"id": 1, "duration_s": 3.96, "emotion": "mischievous", "text": "ദീപാവലി രാത്രി. കോളനി മുഴുവൻ ഒരേ ഒരു കാഴ്ചയിൽ..."}, {"id": 2, "duration_s": 1.93, "emotion": "excited", "text": "ശിബുവിന്റെ... സൂപ്പർ ബോംബ്!"}, {"id": 3, "duration_s": 2.37, "emotion": "proud", "text": "ടെൻഷൻ വേണ്ട! ചന്ദ്രനേക്കാൾ ഒച്ച!"}, {"id": 4, "duration_s": 3.15, "emotion": "excited", "text": "ലൈവാണ്! ദീപാവലി സ്പെഷ്യൽ!"}, {"id": 5, "duration_s": 0.82, "emotion": "stern_warning", "text": "ശ്ശ്! വരയ്ക്ക് പിന്നിൽ!"}, {"id": 6, "duration_s": 0.65, "emotion": "scared_whisper", "text": "കഴിഞ്ഞോ?"}, {"id": 7, "duration_s": 4.09, "emotion": "mischievous", "text": "നിൽക്ക് നിൽക്ക്! ഇതൊക്കെ തുടങ്ങിയത്... ഇന്ന് രാവിലെ."}, {"id": 8, "duration_s": 3.37, "emotion": "happy", "text": "ദീപാവലി പ്രഭാതം. കോളനി മിന്നിത്തിളങ്ങി..."}, {"id": 9, "duration_s": 2.22, "emotion": "sarcastic", "text": "...ശിബു നല്ല ഉറക്കത്തിലും."}, {"id": 10, "duration_s": 4.75, "emotion": "excited", "text": "ഇങ്ങള് ബാ! സൂപ്പർ ബോംബ്! ബല്ലാത്ത ഒച്ച! ഇന്ന് മാത്രം!"}, {"id": 11, "duration_s": 1.13, "emotion": "excited", "text": "ചന്ദ്രനേക്കാളോ?!"}, {"id": 12, "duration_s": 2.45, "emotion": "curious", "text": "ചേട്ടാ... ചന്ദ്രന്റെ ഒച്ച എത്രയാ?"}, {"id": 13, "duration_s": 1.26, "emotion": "serious", "text": "...ഇതിലും കൊറവ്!"}, {"id": 14, "duration_s": 3.42, "emotion": "loving", "text": "എന്റെ സൂപ്പർ ബോംബ്... എന്റെ പൊൻകുഞ്ഞ്."}, {"id": 15, "duration_s": 2.86, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? ആ പെട്ടിയിൽ പേരില്ല!"}, {"id": 16, "duration_s": 3.09, "emotion": "serious", "text": "കമ്പനിയില്ല, വിലാസമില്ല! വണ്ടിക്കാരൻ മുങ്ങി!"}, {"id": 17, "duration_s": 2.54, "emotion": "proud", "text": "ടെൻഷൻ വേണ്ട! ശിബു ഇല്ലേ!"}, {"id": 18, "duration_s": 0.92, "emotion": "happy", "text": "വാ, പോകാം!"}, {"id": 19, "duration_s": 2.13, "emotion": "comic_panic", "text": "രക്ഷപ്പെട്ടു! ബോംബ് രക്ഷപ്പെട്ടു!"}, {"id": 20, "duration_s": 3.15, "emotion": "embarrassed", "text": "അയ്യോ ശിബൂ, അത് എന്റെ ഓട്ടോയുടെ തുമ്മലാ!"}, {"id": 21, "duration_s": 0.61, "emotion": "excited", "text": "ഒരു ഐഡിയ!"}, {"id": 22, "duration_s": 2.48, "emotion": "determined", "text": "ഇന്ന് രാത്രി... കുട്ടികളുടെ സേഫ്റ്റി സ്ക്വാഡ്!"}, {"id": 23, "duration_s": 2.23, "emotion": "excited", "text": "കേട്ടോ? ശിബു ബോംബ് കൊണ്ടുവന്നു!"}, {"id": 24, "duration_s": 2.44, "emotion": "sarcastic", "text": "പത്തു സെക്കൻഡിൽ... കോളനി മുഴുവൻ അറിഞ്ഞു."}, {"id": 25, "duration_s": 3.0, "emotion": "excited", "text": "നോക്കൂ! സൂപ്പർ ബോംബ്! ചന്ദ്രനേക്കാൾ ഒച്ച!"}, {"id": 26, "duration_s": 4.42, "emotion": "proud", "text": "കുഞ്ഞമ്മയുടെ പടക്കം ചീറ്റും! കോളനി മുഴുവൻ കാണട്ടെ!"}, {"id": 27, "duration_s": 1.88, "emotion": "angry", "text": "ശിബൂ!"}, {"id": 28, "duration_s": 2.82, "emotion": "embarrassed", "text": "അയ്യോ! ഈ ഏറ് ഒരിക്കലും തെറ്റില്ല..."}, {"id": 29, "duration_s": 3.75, "emotion": "stern_warning", "text": "വിളക്കിനടുത്ത് വെടിമരുന്നോ? ബുദ്ധി എവിടെപ്പോയി?"}, {"id": 30, "duration_s": 1.82, "emotion": "calm", "text": "മതി! ഇനി ഞാൻ നോക്കിക്കോളാം."}, {"id": 31, "duration_s": 2.518, "emotion": "stern_warning", "text": "പടക്കം തീയിൽനിന്ന് അകലെ, തണുപ്പത്ത്."}, {"id": 32, "duration_s": 3.25, "emotion": "proud", "text": "ആദ്യ കമ്പിത്തിരി ഞാൻ! ഞാനാരെയും പേടിക്കില്ല!"}, {"id": 33, "duration_s": 4.689, "emotion": "sarcastic", "text": "കഴിഞ്ഞ ദീപാവലിക്ക് പൂക്കുറ്റി കണ്ട് അലമാരയിൽ കയറിയതാര്?"}, {"id": 34, "duration_s": 2.96, "emotion": "embarrassed", "text": "അത്... അലമാര വൃത്തിയാക്കുവാരുന്നു. അകത്തുനിന്ന്."}, {"id": 35, "duration_s": 2.91, "emotion": "proud", "text": "ചെരിപ്പ് തിരിച്ചു. ഏറ് റെഡി."}, {"id": 36, "duration_s": 5.31, "emotion": "shouting", "text": "മൗനപ്പടക്കം! പുകയില്ല, ഒച്ചയില്ല, പേടിയില്ല!"}, {"id": 37, "duration_s": 2.99, "emotion": "proud", "text": "നൂറു രൂപ പെട്ടി! ഒരു രൂപ കുറയില്ല!"}, {"id": 38, "duration_s": 5.67, "emotion": "curious", "text": "കുട്ടപ്പേട്ടാ, ഈ നിശ്ശബ്ദ പടക്കം എങ്ങനെ കത്തും?"}, {"id": 39, "duration_s": 2.31, "emotion": "mischievous", "text": "അത്രയ്ക്ക് നിശ്ശബ്ദം... അറിയുകയേ ഇല്ല!"}, {"id": 40, "duration_s": 3.54, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... ശബ്ദം നേരെ തലച്ചോറിൽ കേൾക്കും!"}, {"id": 41, "duration_s": 2.55, "emotion": "excited", "text": "ഹാ... കേൾക്കുന്നുണ്ട്!"}, {"id": 42, "duration_s": 2.66, "emotion": "sad", "text": "ഇതിനകത്ത് തിന്നാൻ പോലും ഒന്നുമില്ല!"}, {"id": 43, "duration_s": 1.78, "emotion": "happy", "text": "വിശക്കുന്നു!"}, {"id": 44, "duration_s": 3.05, "emotion": "shocked", "text": "കേട്ടോ? കുട്ടപ്പൻ ഒഴിഞ്ഞ പെട്ടി വിൽക്കുന്നു!"}, {"id": 45, "duration_s": 0.87, "emotion": "stern_warning", "text": "കുട്ടപ്പേട്ടാ!"}, {"id": 46, "duration_s": 4.078, "emotion": "embarrassed", "text": "കല്യാണീ... ഇത് മലിനീകരണമില്ലാത്ത പാക്കിങ്ങാ!"}, {"id": 47, "duration_s": 2.88, "emotion": "sad", "text": "<sigh> നിശ്ശബ്ദ പടക്കം... നിശ്ശബ്ദ കസ്റ്റമേഴ്സ്."}, {"id": 48, "duration_s": 2.3, "emotion": "serious", "text": "പടക്കത്തിനും കണ്ണുതട്ടും മോനേ!"}, {"id": 49, "duration_s": 1.78, "emotion": "worried", "text": "വല്യമ്മച്ചീ, നാരങ്ങ പൊട്ടിയാലോ?"}, {"id": 50, "duration_s": 1.42, "emotion": "serious", "text": "അപ്പൊ പുളിപ്പൊട്ടൽ!"}, {"id": 51, "duration_s": 2.69, "emotion": "sarcastic", "text": "കോൺസ്റ്റബിൾ ഉറക്കംപിള്ള കോളനി കാക്കുന്നു..."}, {"id": 52, "duration_s": 1.81, "emotion": "happy", "text": "ഹോണിനും കണ്ണുതട്ടി!"}, {"id": 53, "duration_s": 2.39, "emotion": "pleading", "text": "ഒരെണ്ണം മാത്രം... അന്വേഷണത്തിന് വേണ്ടി."}, {"id": 54, "duration_s": 3.19, "emotion": "stern_warning", "text": "അന്വേഷണം!"}, {"id": 55, "duration_s": 3.74, "emotion": "sad", "text": "<sigh> അന്വേഷണം മധുരം തിന്നു."}, {"id": 56, "duration_s": 6.73, "emotion": "proud", "text": "ഞാനാരെയും പേടിക്കില്ല! തീ, തീപ്പൊരി, ഒച്ച... ഇവ മാത്രം."}, {"id": 57, "duration_s": 1.87, "emotion": "loving", "text": "എങ്കിൽ ഒരു നാരങ്ങ നിനക്കും."}, {"id": 58, "duration_s": 2.51, "emotion": "excited", "text": "വൈകുന്നേരം... കുട്ടികൾ ചുമതലയേറ്റു."}, {"id": 59, "duration_s": 2.64, "emotion": "determined", "text": "ഇതാണ് സേഫ്റ്റി ലൈൻ! ഇതിനപ്പുറം ആരുമില്ല!"}, {"id": 60, "duration_s": 3.61, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? വെള്ളബക്കറ്റ്, മണൽബക്കറ്റ്, പിന്നെ ദൂരം!"}, {"id": 61, "duration_s": 2.47, "emotion": "excited", "text": "പാനിപൂരിയോ? എവിടെ പാനിപൂരി?"}, {"id": 62, "duration_s": 1.89, "emotion": "excited", "text": "പാനിപൂരി?! എവ്ടെ?!"}, {"id": 63, "duration_s": 2.87, "emotion": "sarcastic", "text": "വെള്ളം ബക്കറ്റ്, മാഷേ! പിന്നെ മണൽ!"}, {"id": 64, "duration_s": 2.48, "emotion": "curious", "text": "മണലോ? പാനിപൂരിക്ക് എന്താ വില?"}, {"id": 65, "duration_s": 2.14, "emotion": "embarrassed", "text": "വേണ്ട സമയത്തൊക്കെ ഇവന് അവധി!"}, {"id": 66, "duration_s": 2.23, "emotion": "shouting", "text": "വലിയവർ ഇങ്ങോട്ട്! നിയമം കേൾക്ക്!"}, {"id": 67, "duration_s": 3.25, "emotion": "stern_warning", "text": "കയ്യിൽ കമ്പിത്തിരി മാത്രം! ബാക്കി പടക്കം ഒരിക്കലുമില്ല!"}, {"id": 68, "duration_s": 2.53, "emotion": "stern_warning", "text": "പട്ട് വിളക്കിൽനിന്ന് അകലെ! കോട്ടൺ ഇടൂ!"}, {"id": 69, "duration_s": 1.54, "emotion": "comic_panic", "text": "അഞ്ചു മിനിറ്റ്! ഇപ്പൊ വരാം!"}, {"id": 70, "duration_s": 2.01, "emotion": "shouting", "text": "നിൽക്ക്! തിരിച്ചുപോ!"}, {"id": 71, "duration_s": 2.51, "emotion": "embarrassed", "text": "ഞാൻ... വര ചെക്ക് ചെയ്യുവാരുന്നു."}, {"id": 72, "duration_s": 3.5, "emotion": "sarcastic", "text": "രാത്രിയായി... ഹീറോ കോട്ടൺ ജുബ്ബയിൽ തിരിച്ചെത്തി."}, {"id": 73, "duration_s": 2.12, "emotion": "proud", "text": "ഞാനാരെയും പേടിക്കില്ല! കത്തിക്ക്!"}, {"id": 74, "duration_s": 4.43, "emotion": "stern_warning", "text": "കൈ നേരെ! മുഖത്തുനിന്ന് അകലെ! ബക്കറ്റ് അടുത്ത്!"}, {"id": 75, "duration_s": 1.01, "emotion": "comic_panic", "text": "തീ... തീപ്പൊരി!"}, {"id": 76, "duration_s": 0.79, "emotion": "comic_panic", "text": "ആആആആ!"}, {"id": 77, "duration_s": 1.49, "emotion": "comic_panic", "text": "ഇതെന്താ കെടാത്തത്?!"}, {"id": 78, "duration_s": 2.17, "emotion": "excited", "text": "കേട്ടോ? സുരേഷ് മാരത്തൺ ഓടുന്നു!"}, {"id": 79, "duration_s": 1.91, "emotion": "sarcastic", "text": "കമ്പിത്തിരി രണ്ടു മിനിറ്റ് മുമ്പേ കെട്ടു."}, {"id": 80, "duration_s": 2.594, "emotion": "tired", "text": "...പിന്നെന്താ പറയാഞ്ഞേ?"}, {"id": 81, "duration_s": 2.73, "emotion": "giggly", "text": "അച്ഛാ, കമ്പിത്തിരി നിന്നാ കത്തിക്കുന്നേ, ഓടിയല്ല!"}, {"id": 82, "duration_s": 3.4, "emotion": "serious", "text": "കത്തിയ കമ്പി നേരെ വെള്ളത്തിൽ. കാലിൽ അല്ല."}, {"id": 83, "duration_s": 2.409, "emotion": "giggly", "text": "ആദ്യ കമ്പിത്തിരി... ആദ്യ മാരത്തൺ!"}, {"id": 84, "duration_s": 2.45, "emotion": "mischievous", "text": "പുതിയ പ്രാങ്ക്! ചോക്ലേറ്റ് ബോംബ്!"}, {"id": 85, "duration_s": 2.67, "emotion": "curious", "text": "ബോംബിൽ നിന്ന്... ചോക്ലേറ്റിന്റെ മണം?"}, {"id": 86, "duration_s": 2.44, "emotion": "shouting", "text": "ബൂ... ബൂ... ബൂം!"}, {"id": 87, "duration_s": 2.35, "emotion": "panicked", "text": "ഉണ്ണി പൊട്ടി!"}, {"id": 88, "duration_s": 1.5, "emotion": "shouting", "text": "ഉണ്ണീ!!"}, {"id": 89, "duration_s": 4.18, "emotion": "giggly", "text": "അകത്ത് ചോക്ലേറ്റ് ആയിരുന്നു! വിശന്നിട്ടാ!"}, {"id": 90, "duration_s": 2.19, "emotion": "excited", "text": "കേട്ടോ? ഉണ്ണിക്ക് വീണ്ടും വിശപ്പ്!"}, {"id": 91, "duration_s": 4.16, "emotion": "stern_warning", "text": "പടക്കം വച്ച് കളിക്കല്ലേ ചേച്ചീ! എല്ലാരും പേടിച്ചു."}, {"id": 92, "duration_s": 2.47, "emotion": "embarrassed", "text": "സോറി... റീൽ ഡിലീറ്റ്."}, {"id": 93, "duration_s": 2.72, "emotion": "mischievous", "text": "ഇനി... കഥ നിന്നിടത്തേക്ക് തന്നെ തിരിച്ച്."}, {"id": 94, "duration_s": 3.87, "emotion": "stern_warning", "text": "നീണ്ട ചന്ദനത്തിരി! കൈ നേരെ! കത്തിച്ച് പിന്നോട്ട്!"}, {"id": 95, "duration_s": 2.01, "emotion": "comic_panic", "text": "കത്തി! ഓടിക്കോ... അല്ല, പിന്നോട്ട് മാറൂ!"}, {"id": 96, "duration_s": 1.33, "emotion": "proud", "text": "നിൽക്ക്... ഇത് ആലോചിക്കുവാ."}, {"id": 97, "duration_s": 1.87, "emotion": "serious", "text": "സയൻസ് പറയുന്നു... ഇത് ഉറങ്ങിപ്പോയി."}, {"id": 98, "duration_s": 2.74, "emotion": "shouting", "text": "നിൽക്ക്! ചീറ്റിയ പടക്കത്തിനടുത്ത് ആരും പോകരുത്!"}, {"id": 99, "duration_s": 3.62, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? പതിനഞ്ച് മിനിറ്റ് കഴിഞ്ഞ് വെള്ളം ഒഴിക്ക്."}, {"id": 100, "duration_s": 3.23, "emotion": "sarcastic", "text": "പതിനഞ്ച് മിനിറ്റോ? എന്റെ പലിശ ഓടുവാ!"}, {"id": 101, "duration_s": 1.86, "emotion": "embarrassed", "text": "...ചന്ദ്രനേക്കാൾ ഒച്ച."}, {"id": 102, "duration_s": 2.09, "emotion": "sarcastic", "text": "ലൈവാണ്... കഷ്ടകാലത്തിന്."}, {"id": 103, "duration_s": 0.81, "emotion": "angry", "text": "ശിബൂ..."}, {"id": 104, "duration_s": 1.33, "emotion": "shouting", "text": "അന്വേഷണം!"}, {"id": 105, "duration_s": 2.67, "emotion": "embarrassed", "text": "ഹോൺ കാരണമാ! സത്യമായിട്ടും!"}, {"id": 106, "duration_s": 3.01, "emotion": "curious", "text": "എന്താ? മധുരം വിതരണമോ?"}, {"id": 107, "duration_s": 3.34, "emotion": "tender", "text": "അയ്യോ മണീ... നീയും പേടിച്ചോ?"}, {"id": 108, "duration_s": 3.4, "emotion": "worried", "text": "മൃഗങ്ങളുടെ ചെവി നമ്മളേക്കാൾ കൂർമ്മയാ."}, {"id": 109, "duration_s": 3.11, "emotion": "serious", "text": "നമുക്ക് പടക്കം, അവർക്ക് കൊടുങ്കാറ്റ്."}, {"id": 110, "duration_s": 2.65, "emotion": "tender", "text": "ശ്ശ്ശ്... മണിക്ക് ഒരു ശാന്തമൂല!"}, {"id": 111, "duration_s": 3.2, "emotion": "calm", "text": "പൊട്ടലിൽനിന്നകലെ... ഒരു കൊച്ചു ശാന്തമൂല."}, {"id": 112, "duration_s": 3.39, "emotion": "happy", "text": "എന്റെ ചെവിയും വയസ്സായി. ഞാനും ഇവിടെ!"}, {"id": 113, "duration_s": 1.98, "emotion": "tender", "text": "വാ മണീ, ഇവിടെ ഒച്ചയില്ല."}, {"id": 114, "duration_s": 2.23, "emotion": "serious", "text": "പാവത്തിന് കണ്ണുതട്ടിയതാ!"}, {"id": 115, "duration_s": 2.72, "emotion": "proud", "text": "ശബാഷ്, എന്റെ സേഫ്റ്റി സ്ക്വാഡ്."}, {"id": 116, "duration_s": 2.95, "emotion": "mischievous", "text": "പിന്നെ... സൂപ്പർ ബോംബിന്റെ പോസ്റ്റ്മോർട്ടം."}, {"id": 117, "duration_s": 4.18, "emotion": "serious", "text": "അന്വേഷണമുണ്ടാകും! ...ഓരോ പാളിയായി."}, {"id": 118, "duration_s": 2.96, "emotion": "sad", "text": "ഇത്ര വലിയ പെട്ടി... ഉള്ളിൽ ഇത്രേയുള്ളൂ?"}, {"id": 119, "duration_s": 2.15, "emotion": "serious", "text": "പേരില്ലാത്ത പടക്കം അപകടവുമാകാം."}, {"id": 120, "duration_s": 3.11, "emotion": "loving", "text": "ചിറ്റപ്പാ, ലൈസൻസ് കടയിൽ വാങ്ങൂ, വണ്ടിയിൽ വേണ്ട."}, {"id": 121, "duration_s": 3.41, "emotion": "guilty", "text": "ശരിയാ. അടുത്ത തവണ ആദ്യം ചോദിക്കാം."}, {"id": 122, "duration_s": 1.57, "emotion": "giggly", "text": "ടെൻഷൻ വേണം... ഇത്തിരി."}, {"id": 123, "duration_s": 4.694, "emotion": "stern_warning", "text": "കുട്ടപ്പേട്ടാ! കാലി?"}, {"id": 124, "duration_s": 3.83, "emotion": "guilty", "text": "ശരി! എല്ലാവർക്കും... സൗജന്യ മധുരം!"}, {"id": 125, "duration_s": 3.3, "emotion": "crying", "text": "സൗജന്യം... പറയുമ്പോൾ തന്നെ നോവുന്നു."}, {"id": 126, "duration_s": 3.31, "emotion": "serious", "text": "അന്വേഷണം തീർന്നു."}, {"id": 127, "duration_s": 0.66, "emotion": "happy", "text": "കൃത്യം പകുതി!"}, {"id": 128, "duration_s": 3.58, "emotion": "calm", "text": "ആ രാത്രി കോളനിയിൽ പുക കുറവ്... വെളിച്ചം കൂടുതൽ."}, {"id": 129, "duration_s": 3.05, "emotion": "loving", "text": "ഈ വിളക്കുകൾ നിശ്ശബ്ദമായി കത്തും... രാത്രി മുഴുവൻ."}, {"id": 130, "duration_s": 1.66, "emotion": "giggly", "text": "ഇവയ്ക്ക് വിസിൽ പോലും വേണ്ട!"}, {"id": 131, "duration_s": 2.75, "emotion": "excited", "text": "പുതിയ റീൽ... 'നിശ്ശബ്ദ ദീപാവലി'! ലൈവാണ്!"}, {"id": 132, "duration_s": 2.19, "emotion": "excited", "text": "കേട്ടോ? അഞ്ജുവിന്റെ റീൽ വൈറൽ!"}, {"id": 133, "duration_s": 3.77, "emotion": "proud", "text": "കണ്ടോ? കോളനി മുഴുവൻ കണ്ടു! നാട് മുഴുവൻ കണ്ടു!"}, {"id": 134, "duration_s": 2.2, "emotion": "giggly", "text": "റീലിൽ ചെരിപ്പും ഉണ്ട് കേട്ടോ!"}, {"id": 135, "duration_s": 4.65, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... വിളക്കാണ് ഏറ്റവും സേഫ് പടക്കം."}, {"id": 136, "duration_s": 3.44, "emotion": "shocked", "text": "പണ്ഡിറ്റ് പ്രകാശ് ശരി പറഞ്ഞോ?! സത്യോ?"}, {"id": 137, "duration_s": 6.17, "emotion": "serious", "text": "പടക്കം കയ്യിലല്ല, ബക്കറ്റ് അടുത്ത്, കുട്ടികൾ വലിയവരോടൊപ്പം."}, {"id": 138, "duration_s": 3.66, "emotion": "loving", "text": "മൃഗങ്ങൾക്കും മുതിർന്നവർക്കും ഒരു ശാന്തമൂല."}, {"id": 139, "duration_s": 4.03, "emotion": "calm", "text": "വെളിച്ചം മനസ്സിൽ വേണം... പൊട്ടൽ കയ്യിൽ വേണ്ട."}, {"id": 140, "duration_s": 1.67, "emotion": "excited", "text": "ഹാപ്പി സേഫ് ദീപാവലി!"}]