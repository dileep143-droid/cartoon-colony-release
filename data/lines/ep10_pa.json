[{"id": 1, "duration_s": 5.12, "emotion": "mischievous", "text": "ਰਾਤ ਦੇ ਦੋ ਵਜੇ... ਸਾਰੀ ਕਲੋਨੀ ਸੁੱਤੀ ਪਈ ਸੀ।"}, {"id": 2, "duration_s": 0.92, "emotion": "mischievous", "text": "ਇੱਕ ਨੂੰ ਛੱਡ ਕੇ।"}, {"id": 3, "duration_s": 1.61, "emotion": "angry", "text": "ਮੇਰੇ ਕੰਨ 'ਚ ਹਵਾਈ ਅੱਡਾ?"}, {"id": 4, "duration_s": 1.9, "emotion": "proud", "text": "ਮੈਂ ਕਿਸੇ ਤੋਂ ਨਹੀਂ ਡਰਦਾ!"}, {"id": 5, "duration_s": 4.49, "emotion": "giggly", "text": "ਦਸ ਤਾੜੀ... ਵੀਹ ਤਾੜੀ... ਤੀਹ ਤਾੜੀ..."}, {"id": 6, "duration_s": 2.19, "emotion": "sarcastic", "text": "ਤਾੜੀਆਂ ਕਾਹਦੀਆਂ? ਜੰਞ ਆਈ ਏ?"}, {"id": 7, "duration_s": 2.21, "emotion": "scared_whisper", "text": "ਚਾਲੀਵੀਂ... ਤੇ ਆਖ਼ਰੀ।"}, {"id": 8, "duration_s": 5.51, "emotion": "giggly", "text": "ਚਾਲੀ ਤਾੜੀਆਂ। ਮੱਛਰ: ਜ਼ੀਰੋ। ਬਿੱਲਾ: ਚਾਲੀ ਚਪੇੜਾਂ!"}, {"id": 9, "duration_s": 4.24, "emotion": "determined", "text": "ਪਰ੍ਹੇ ਹੋਵੋ! ਮੇਰੀ ਜੁੱਤੀ ਕਦੇ ਨਹੀਂ ਖੁੰਝਦੀ!"}, {"id": 10, "duration_s": 3.65, "emotion": "embarrassed", "text": "ਖੁੰਝੀ ਨਹੀਂ... ਸਿੱਧੀ ਮੇਰੇ ਵੱਜੀ!"}, {"id": 11, "duration_s": 2.51, "emotion": "proud", "text": "ਦੇਖਿਆ? ਨਿਸ਼ਾਨਾ ਪੱਕਾ।"}, {"id": 12, "duration_s": 2.64, "emotion": "mischievous", "text": "ਤੇ ਇਹ ਤਾਂ... ਬੱਸ ਸ਼ੁਰੂਆਤ ਸੀ।"}, {"id": 13, "duration_s": 7.03, "emotion": "giggly", "text": "ਤੇ ਸਵੇਰ ਤੱਕ... ਸਾਰੀ ਕਲੋਨੀ ਖੁਰਕੀ ਜਾਂਦੀ ਸੀ।"}, {"id": 14, "duration_s": 2.99, "emotion": "excited", "text": "ਸੁਣਿਆ ਕੁਝ? ਰਾਤੀਂ ਮੱਛਰਾਂ ਦੀ ਫ਼ੌਜ ਆਈ ਸੀ!"}, {"id": 15, "duration_s": 2.69, "emotion": "mischievous", "text": "ਤੇ ਬਿੱਲੇ ਨੇ ਆਪਣੇ ਆਪ ਨੂੰ ਚਾਲੀ ਚਪੇੜਾਂ ਮਾਰੀਆਂ!"}, {"id": 16, "duration_s": 2.85, "emotion": "embarrassed", "text": "ਉਹ ਮੱਛਰ ਨਹੀਂ ਸੀ... ਹਾਥੀ ਸੀ!"}, {"id": 17, "duration_s": 2.29, "emotion": "sarcastic", "text": "ਹਾਥੀ ਨਹੀਂ, ਬੇਬੇ ਦੀ ਜੁੱਤੀ ਸੀ।"}, {"id": 18, "duration_s": 2.79, "emotion": "serious", "text": "ਨਜ਼ਰ ਲੱਗ ਗਈ! ਮੱਛਰਾਂ ਦੀ ਨਜ਼ਰ!"}, {"id": 19, "duration_s": 2.34, "emotion": "shocked", "text": "ਹਾਏ! ਇਹ ਤਾਂ ਮਿਰਚ ਵੀ ਖਾ ਗਿਆ!"}, {"id": 20, "duration_s": 5.47, "emotion": "stern_warning", "text": "ਸਮੋਸਾ? ਰੁਕੋ! ਜਾਂਚ ਹੋਵੇਗੀ!"}, {"id": 21, "duration_s": 2.92, "emotion": "happy", "text": "ਜਾਂਚ ਖ਼ਤਮ। ਭੁੱਖ ਲੱਗੀ ਸੀ!"}, {"id": 22, "duration_s": 3.62, "emotion": "proud", "text": "ਸਾਇੰਸ ਆਖਦੀ, ਮੱਛਰ ਗੰਦੇ ਛੱਪੜ 'ਚ ਹੀ ਪਲਦੇ!"}, {"id": 23, "duration_s": 0.87, "emotion": "curious", "text": "ਮੈਂ ਦੱਸਾਂ?"}, {"id": 24, "duration_s": 2.2, "emotion": "proud", "text": "ਬੱਚੇ ਚੁੱਪ! ਸਾਇੰਸ ਬੋਲ ਰਹੀ ਆ।"}, {"id": 25, "duration_s": 2.91, "emotion": "proud", "text": "ਸਾਡੀ ਕਲੋਨੀ ਸਾਫ਼ ਆ, ਮੱਛਰ ਬਾਹਰੋਂ ਆਉਂਦੇ ਨੇ!"}, {"id": 26, "duration_s": 4.33, "emotion": "excited", "text": "ਮੱਛਰ-ਪਰੂਫ਼ ਅਗਰਬੱਤੀ! ਇੱਕ ਜਗਾਓ, ਮੱਛਰ ਗਾਇਬ!"}, {"id": 27, "duration_s": 2.48, "emotion": "determined", "text": "ਚਾਲੀ ਦਿਓ! ਇੱਕ ਤਾੜੀ ਬਦਲੇ ਇੱਕ।"}, {"id": 28, "duration_s": 3.11, "emotion": "stern_warning", "text": "ਦਸ ਦੀ ਇੱਕ। ਇੱਕ ਰੁਪਈਆ ਵੀ ਘੱਟ ਨਹੀਂ!"}, {"id": 29, "duration_s": 4.715, "emotion": "angry", "text": "ਲਾਲਾ ਜੀ! ਇਹ ਤਾਂ ਪਿਛਲੇ ਸਾਲ ਦੀ ਪੂਜਾ ਵਾਲੀਆਂ ਨੇ!"}, {"id": 30, "duration_s": 2.85, "emotion": "embarrassed", "text": "ਪੁਰਾਣੀ ਪੂਜਾ... ਨਵਾਂ ਮੱਛਰ।"}, {"id": 31, "duration_s": 4.49, "emotion": "giggly", "text": "ਸ਼ਾਮ ਤੱਕ ਕਲੋਨੀ 'ਚ ਬੱਦਲ ਆ ਗਏ। ਮੱਛਰ ਨਹੀਂ ਗਏ।"}, {"id": 32, "duration_s": 2.21, "emotion": "excited", "text": "ਅਸੀਂ ਲਾਈਵ ਆਂ! ਕਲੋਨੀ 'ਚ ਬੱਦਲ ਆ ਗਏ!"}, {"id": 33, "duration_s": 1.55, "emotion": "determined", "text": "ਲਾਲਾ ਜੀ, ਹਿੱਲਣਾ ਨਾ।"}, {"id": 34, "duration_s": 3.33, "emotion": "tired", "text": "ਧੂੰਆਂ ਗਿਆ... ਮੱਛਰ ਨਹੀਂ ਗਿਆ।"}, {"id": 35, "duration_s": 2.6, "emotion": "serious", "text": "ਦੋ ਦਿਨ ਬਾਅਦ। ਲਾਲੇ ਦੇ ਘਰ।"}, {"id": 36, "duration_s": 2.64, "emotion": "loving", "text": "ਉੱਠ ਪੁੱਤ। ਤੇਰੀਆਂ ਫ਼ੇਵਰਿਟ ਪਿੰਨੀਆਂ।"}, {"id": 37, "duration_s": 2.89, "emotion": "shocked", "text": "ਪਿੰਨੀ ਨੇ... ਪਿੰਨੀ ਨੂੰ ਨਾਂਹ ਕੀਤੀ?!"}, {"id": 38, "duration_s": 3.713, "emotion": "tired", "text": "ਮੰਮੀ... ਭੁੱਖ... ਨਹੀਂ ਲੱਗੀ।"}, {"id": 39, "duration_s": 3.71, "emotion": "worried", "text": "ਬੁਖ਼ਾਰ ਆ! ਲਾਲਾ ਜੀ, ਡਾਕਟਰ!"}, {"id": 40, "duration_s": 4.09, "emotion": "worried", "text": "ਫ਼ੀਸ... ਕੋਈ ਨਾ! ਕੋਈ ਨਾ!"}, {"id": 41, "duration_s": 2.53, "emotion": "calm", "text": "ਬੁਖ਼ਾਰ ਆ ਤਾਂ ਸਵੇਰੇ ਕਲੀਨਿਕ ਲੈ ਆਇਓ।"}, {"id": 42, "duration_s": 3.13, "emotion": "serious", "text": "ਡੇਂਗੂ ਦਾ ਟੈਸਟ ਜ਼ਰੂਰੀ ਆ। ਫ਼ਿਕਰ ਨਾ ਕਰਿਓ।"}, {"id": 43, "duration_s": 2.42, "emotion": "serious", "text": "ਤੇ ਘਰ ਦੇ ਆਲੇ-ਦੁਆਲੇ ਖੜ੍ਹਾ ਪਾਣੀ?"}, {"id": 44, "duration_s": 1.2, "emotion": "proud", "text": "ਸਾਡਾ ਘਰ ਸਾਫ਼ ਆ!"}, {"id": 45, "duration_s": 3.05, "emotion": "serious", "text": "ਡੇਂਗੂ ਵਾਲਾ ਮੱਛਰ ਸਾਫ਼, ਖੜ੍ਹੇ ਪਾਣੀ 'ਚ ਈ ਪਲਦਾ।"}, {"id": 46, "duration_s": 1.47, "emotion": "happy", "text": "ਚੱਲੋ, ਚੱਲਦੇ ਆਂ!"}, {"id": 47, "duration_s": 1.94, "emotion": "giggly", "text": "...ਤੇ ਪਹੁੰਚ ਵੀ ਗਏ।"}, {"id": 48, "duration_s": 2.49, "emotion": "relieved", "text": "ਡੇਂਗੂ ਨਹੀਂ ਨਿਕਲਿਆ। ਹਲਕਾ ਬੁਖ਼ਾਰ ਆ।"}, {"id": 49, "duration_s": 1.19, "emotion": "pleading", "text": "ਤਾਂ... ਪਿੰਨੀ?"}, {"id": 50, "duration_s": 2.4, "emotion": "stern_warning", "text": "ਠੀਕ ਹੋਣ ਮਗਰੋਂ। ਸਿਰਫ਼ ਇੱਕ।"}, {"id": 51, "duration_s": 1.09, "emotion": "shocked", "text": "ਇੱਕ?!"}, {"id": 52, "duration_s": 3.24, "emotion": "excited", "text": "ਇੱਕ ਆਈਡੀਆ ਆ! ਆਪਾਂ ਬਣਾਂਗੇ..."}, {"id": 53, "duration_s": 1.46, "emotion": "excited", "text": "...ਮੱਛਰ ਜਾਸੂਸ!"}, {"id": 54, "duration_s": 2.29, "emotion": "proud", "text": "ਮੈਂ ਦੱਸਾਂ? ਐਤਕੀਂ ਸੱਚੀਂ?"}, {"id": 55, "duration_s": 1.44, "emotion": "stern_warning", "text": "ਬੋਲ! ਛੇਤੀ!"}, {"id": 56, "duration_s": 3.28, "emotion": "serious", "text": "ਡੇਂਗੂ ਵਾਲਾ ਮੱਛਰ ਜ਼ਿਆਦਾਤਰ ਦਿਨੇ ਵੱਢਦਾ ਆ।"}, {"id": 57, "duration_s": 3.82, "emotion": "serious", "text": "ਗੰਦੇ ਛੱਪੜ 'ਚ ਨਹੀਂ, ਸਾਫ਼ ਖੜ੍ਹੇ ਪਾਣੀ 'ਚ ਆਂਡੇ ਦਿੰਦਾ ਆ।"}, {"id": 58, "duration_s": 4.26, "emotion": "shocked", "text": "ਮਤਲਬ ਗਿਆਨੀ ਗੁਰਮੀਤ ਦੀ ਸਾਇੰਸ... ਪੁੱਠੀ!"}, {"id": 59, "duration_s": 3.17, "emotion": "serious", "text": "ਪਾਣੀ 'ਚ ਨਿੱਕੇ ਕੀੜੇ ਦਿਸਣ, ਉਹ ਲਾਰਵਾ ਆ।"}, {"id": 60, "duration_s": 2.89, "emotion": "serious", "text": "ਇੱਕ ਹਫ਼ਤੇ 'ਚ, ਲਾਰਵੇ ਤੋਂ ਮੱਛਰ!"}, {"id": 61, "duration_s": 2.92, "emotion": "determined", "text": "ਜਾਸੂਸੋ! ਮੇਰਾ ਬਦਲਾ ਲੈਣਾ!"}, {"id": 62, "duration_s": 3.86, "emotion": "determined", "text": "ਹਰ ਭਾਂਡਾ! ਹਰ ਗਮਲਾ! ਹਰ ਟਾਇਰ!"}, {"id": 63, "duration_s": 2.78, "emotion": "proud", "text": "ਜਾਸੂਸੀ? ਵੱਡੇ ਸਾਂਭ ਲੈਣਗੇ!"}, {"id": 64, "duration_s": 0.58, "emotion": "angry", "text": "ਚੁੱਪ!"}, {"id": 65, "duration_s": 3.4, "emotion": "excited", "text": "ਤੇ ਸ਼ੁਰੂ ਹੋਈ... ਮੱਛਰ ਜਾਸੂਸੀ!"}, {"id": 66, "duration_s": 1.7, "emotion": "excited", "text": "ਲੱਭ ਗਿਆ! ਕੂਲਰ 'ਚ ਲਾਰਵਾ!"}, {"id": 67, "duration_s": 3.35, "emotion": "proud", "text": "ਮੇਰਾ ਕੂਲਰ? ਇਹ ਤਾਂ ਬੱਸ... ਕਿਰਾਏਦਾਰ ਨੇ।"}, {"id": 68, "duration_s": 2.74, "emotion": "scared_whisper", "text": "ਮੈਂ... ਕਿਸੇ ਤੋਂ... ਨਹੀਂ ਡਰਦਾ।"}, {"id": 69, "duration_s": 2.2, "emotion": "panicked", "text": "ਪੂਜਾ! ਇਹ ਭਾੜਾ ਮੰਗ ਰਿਹਾ ਆ!"}, {"id": 70, "duration_s": 2.09, "emotion": "stern_warning", "text": "ਬੇਬੇ ਜੀ, ਗਮਲੇ ਦੀ ਪਲੇਟ 'ਚ ਵੀ!"}, {"id": 71, "duration_s": 2.81, "emotion": "proud", "text": "ਮੇਰੇ ਗਮਲਿਆਂ ਦੀ ਤਾਂ ਰੋਜ਼ ਪੂਜਾ ਹੁੰਦੀ ਆ!"}, {"id": 72, "duration_s": 3.0, "emotion": "sarcastic", "text": "ਪੂਜਾ ਵੀ, ਪਾਣੀ ਵੀ... ਮੱਛਰ ਵੀ।"}, {"id": 73, "duration_s": 2.11, "emotion": "determined", "text": "ਬੱਸ! ਹੁਣ ਮੈਂ ਦੇਖਦੀ ਆਂ।"}, {"id": 74, "duration_s": 3.65, "emotion": "proud", "text": "ਹਰ ਹਫ਼ਤੇ ਖ਼ਾਲੀ ਕਰੋ, ਸੁਕਾਓ। ਦਸ ਸਕਿੰਟ।"}, {"id": 75, "duration_s": 2.52, "emotion": "embarrassed", "text": "ਮੈਂ ਵੀ... ਮਦਦ ਕਰ ਰਿਹਾ ਸੀ।"}, {"id": 76, "duration_s": 3.41, "emotion": "mischievous", "text": "ਤੇ ਛੱਤ 'ਤੇ... ਗੋਗੀ ਦਾ ਬਿਜ਼ਨਸ।"}, {"id": 77, "duration_s": 0.68, "emotion": "excited", "text": "ਟੈਂਸ਼ਨ ਨਾ ਲਓ!"}, {"id": 78, "duration_s": 4.06, "emotion": "proud", "text": "ਇਹ ਆ ਮੇਰਾ ਟਾਇਰ ਬਿਜ਼ਨਸ! ਵੀਹ ਟਾਇਰ, ਅਗਲੇ ਸਾਲ ਵੀਹ ਲੱਖ!"}, {"id": 79, "duration_s": 3.38, "emotion": "serious", "text": "ਇੱਕ ਟਾਇਰ 'ਚ... ਸੌ ਤੋਂ ਵੱਧ ਲਾਰਵੇ।"}, {"id": 80, "duration_s": 1.35, "emotion": "shocked", "text": "ਤੇ ਵੀਹ ਟਾਇਰਾਂ 'ਚ?"}, {"id": 81, "duration_s": 1.32, "emotion": "shocked", "text": "ਪੂਰੀ ਮੱਛਰ-ਕਲੋਨੀ!"}, {"id": 82, "duration_s": 2.01, "emotion": "mischievous", "text": "ਤਾਂ... ਇਨ੍ਹਾਂ ਤੋਂ ਭਾੜਾ ਲਵਾਂ?"}, {"id": 83, "duration_s": 4.16, "emotion": "proud", "text": "ਮੇਰੇ ਅਚਾਰ ਨੂੰ ਧੁੱਪ! ਘੱਟੋ-ਘੱਟ ਮੈਂ..."}, {"id": 84, "duration_s": 2.04, "emotion": "mischievous", "text": "ਬੇਬੇ... ਤੁਹਾਡੇ ਢੱਕਣ 'ਚ ਵੀ।"}, {"id": 85, "duration_s": 2.99, "emotion": "shocked", "text": "ਹਾਏ ਰੱਬਾ! ਸਾਰੀ ਕਲੋਨੀ ਦੇਖੂਗੀ!"}, {"id": 86, "duration_s": 2.21, "emotion": "angry", "text": "ਇਹ ਸਭ ਤੇਰੇ ਟਾਇਰਾਂ ਕਰਕੇ!"}, {"id": 87, "duration_s": 0.84, "emotion": "panicked", "text": "ਜਾਰ ਵੀ!"}, {"id": 88, "duration_s": 2.39, "emotion": "embarrassed", "text": "ਨਿਸ਼ਾਨਾ... ਫੇਰ ਪੱਕਾ।"}, {"id": 89, "duration_s": 3.33, "emotion": "determined", "text": "ਟਾਇਰ ਪੁੱਠੇ, ਪਾਣੀ ਬਾਹਰ, ਬਿਜ਼ਨਸ ਅੰਦਰ!"}, {"id": 90, "duration_s": 2.75, "emotion": "excited", "text": "ਸੁਣਿਆ ਕੁਝ? ਬਿੱਲੇ ਦੀ ਛੱਤ 'ਤੇ ਵੀਹ ਲੱਖ!"}, {"id": 91, "duration_s": 2.51, "emotion": "panicked", "text": "ਵੀਹ ਲੱਖ... ਮੱਛਰ! ਡੇਂਗੂ ਆ ਗਿਆ!"}, {"id": 92, "duration_s": 5.538, "emotion": "serious", "text": "ਨਜ਼ਰ ਲੱਗ ਗਈ! ਹਰ ਬੂਹੇ 'ਤੇ ਨਿੰਬੂ!"}, {"id": 93, "duration_s": 3.23, "emotion": "mischievous", "text": "ਮੱਛਰਦਾਨੀ! ਅੱਜ ਦਾ ਰੇਟ ਡਬਲ!"}, {"id": 94, "duration_s": 3.54, "emotion": "giggly", "text": "ਤੇ ਫੇਰ... ਕਲੋਨੀ 'ਚ ਭੂਤਾਂ ਦੀ ਜੰਞ ਨਿਕਲੀ।"}, {"id": 95, "duration_s": 4.68, "emotion": "shouting", "text": "ਹਰ ਮੱਛਰ ਦੀ ਜਾਂਚ ਹੋਵੇਗੀ!"}, {"id": 96, "duration_s": 0.56, "emotion": "angry", "text": "ਚੁੱਪ!"}, {"id": 97, "duration_s": 6.02, "emotion": "serious", "text": "ਧੂੰਏਂ, ਨਿੰਬੂ, ਰੈਕੇਟ ਨਾਲ ਨਹੀਂ। ਖੜ੍ਹਾ ਪਾਣੀ ਸੁੱਟੋ!"}, {"id": 98, "duration_s": 1.01, "emotion": "excited", "text": "ਇੱਕ ਆਈਡੀਆ ਆ!"}, {"id": 99, "duration_s": 3.03, "emotion": "excited", "text": "ਸਫ਼ਾਈ ਰੇਸ! ਜੋ ਸਭ ਤੋਂ ਵੱਧ ਪਾਣੀ ਲੱਭੇ!"}, {"id": 100, "duration_s": 2.89, "emotion": "determined", "text": "ਰੇਸ? ਬਿੱਲਾ ਕਦੇ ਨਹੀਂ ਹਾਰਦਾ!"}, {"id": 101, "duration_s": 3.1, "emotion": "excited", "text": "ਕਲੋਨੀ ਦੀ ਪਹਿਲੀ... ਸਫ਼ਾਈ ਰੇਸ!"}, {"id": 102, "duration_s": 2.95, "emotion": "serious", "text": "ਨਿਯਮ ਸੁਣੋ! ਜਿਸ ਕੋਲ ਸਭ ਤੋਂ ਵੱਧ..."}, {"id": 103, "duration_s": 2.15, "emotion": "serious", "text": "ਮਾਸਟਰ ਜੀ, ਲਾਰਵਾ!"}, {"id": 104, "duration_s": 2.03, "emotion": "shocked", "text": "ਲਵਰ? ਇਸ ਕਲੋਨੀ 'ਚ?"}, {"id": 105, "duration_s": 2.84, "emotion": "scared_whisper", "text": "ਕਿਸ ਦੇ? ਕਿੱਥੇ? ਇਸ ਉਮਰ 'ਚ?"}, {"id": 106, "duration_s": 1.91, "emotion": "sarcastic", "text": "ਮੱਛਰ ਦੇ ਬੱਚੇ, ਮਾਸਟਰ ਜੀ!"}, {"id": 107, "duration_s": 2.95, "emotion": "embarrassed", "text": "ਅੱਛਾ... ਫੇਰ ਠੀਕ ਆ। ਸ਼ੁਰੂ!"}, {"id": 108, "duration_s": 5.747, "emotion": "tired", "text": "ਪੂਰੀ ਬਾਂਹ... ਪੂਰਾ ਪਸੀਨਾ!"}, {"id": 109, "duration_s": 1.59, "emotion": "giggly", "text": "ਪਰ ਮੱਛਰ ਤਿਲ੍ਹਕ ਗਿਆ!"}, {"id": 110, "duration_s": 2.67, "emotion": "determined", "text": "ਨਾਨੀ, ਤੁਹਾਡਾ ਕਟੋਰਾ ਵੀ!"}, {"id": 111, "duration_s": 3.03, "emotion": "embarrassed", "text": "ਨਜ਼ਰ... ਪਾਣੀ ਨੂੰ ਲੱਗੀ ਸੀ।"}, {"id": 112, "duration_s": 2.37, "emotion": "happy", "text": "ਓਏ, ਛੱਤ 'ਤੇ ਵੀ ਛੱਪੜ!"}, {"id": 113, "duration_s": 5.92, "emotion": "shouting", "text": "ਮੀਂਹ? ਸਮੋਸਾ? ਪੜਤਾਲ ਹੋਵੇਗੀ!"}, {"id": 114, "duration_s": 2.01, "emotion": "mischievous", "text": "ਲਾਲਾ ਜੀ, ਮੁਫ਼ਤ ਦੇ ਕਿਰਾਏਦਾਰ!"}, {"id": 115, "duration_s": 3.65, "emotion": "sad", "text": "ਮੇਰੀ ਦੁਕਾਨ 'ਚ ਮੁਫ਼ਤ 'ਚ ਕੋਈ ਨਹੀਂ ਰਹਿੰਦਾ!"}, {"id": 116, "duration_s": 3.25, "emotion": "proud", "text": "ਸਾਇੰਸ ਕਹਿੰਦੀ ਆ... ਇਹ ਨਹੀਂ ਹਿੱਲਣਾ।"}, {"id": 117, "duration_s": 1.86, "emotion": "calm", "text": "ਪਰ੍ਹੇ।"}, {"id": 118, "duration_s": 2.26, "emotion": "embarrassed", "text": "ਸਾਇੰਸ ਕਹਿੰਦੀ ਆ... ਬੱਚਿਆਂ ਦੀ ਸੁਣੋ।"}, {"id": 119, "duration_s": 3.08, "emotion": "excited", "text": "ਅਸੀਂ ਲਾਈਵ ਆਂ! ਹੈਸ਼ਟੈਗ ਮੱਛਰ-ਮੁਕਤ!"}, {"id": 120, "duration_s": 3.87, "emotion": "proud", "text": "ਇੱਕ ਘੰਟੇ 'ਚ, ਕਲੋਨੀ 'ਚ ਇੱਕ ਬੂੰਦ ਖੜ੍ਹਾ ਪਾਣੀ ਨਹੀਂ।"}, {"id": 121, "duration_s": 3.19, "emotion": "excited", "text": "ਦਸ ਹਜ਼ਾਰ ਵਿਊ! ਕਲੋਨੀ ਵਾਇਰਲ!"}, {"id": 122, "duration_s": 2.42, "emotion": "excited", "text": "ਸੁਣਿਆ ਕੁਝ? ਐਤਕੀਂ ਚੰਗੀ ਖ਼ਬਰ!"}, {"id": 123, "duration_s": 4.41, "emotion": "proud", "text": "ਤੇ ਰੀਲ 'ਚ ਸਭ ਤੋਂ ਅੱਗੇ ਮੈਂ! ਸਾਰੀ ਕਲੋਨੀ ਦੇਖੂਗੀ!"}, {"id": 124, "duration_s": 3.93, "emotion": "proud", "text": "ਡੇਂਗੂ-ਮੁਕਤ ਕਲੋਨੀ। ਤੇ ਲਵਰ-ਮੁਕਤ ਵੀ।"}, {"id": 125, "duration_s": 1.77, "emotion": "sarcastic", "text": "ਮਾਸਟਰ ਜੀ... ਲਾਰਵਾ।"}, {"id": 126, "duration_s": 3.53, "emotion": "happy", "text": "ਕਲੋਨੀ ਮੱਛਰ ਤੋਂ ਜਿੱਤ ਗਈ... ਪਾਣੀ ਨਾਲ ਲੜ ਕੇ।"}, {"id": 127, "duration_s": 2.83, "emotion": "stern_warning", "text": "ਡਾਕਟਰ ਨੇ ਕਿਹਾ ਸੀ। ਸ