[{"id": 1, "duration_s": 4.57, "emotion": "calm", "text": "இதுதான் எங்க காலனி. அமைதி, அழகு, பாதுகாப்பு..."}, {"id": 2, "duration_s": 3.3, "emotion": "excited", "text": "இவங்கதான்... காலனியோட புது ராஜா!"}, {"id": 3, "duration_s": 2.96, "emotion": "proud", "text": "ராஜாவா? நான்தான்டா ராஜா!"}, {"id": 4, "duration_s": 1.05, "emotion": "sarcastic", "text": "தப்பு செல்லம்."}, {"id": 5, "duration_s": 2.74, "emotion": "proud", "text": "ராணி நான்தான்! ஊரே பாக்கும்!"}, {"id": 6, "duration_s": 1.57, "emotion": "sarcastic", "text": "இதுவும் தப்பு செல்லம்."}, {"id": 7, "duration_s": 1.67, "emotion": "proud", "text": "ஃபாலோயர்ஸ் எனக்குத்தான் அதிகம்!"}, {"id": 8, "duration_s": 3.61, "emotion": "mischievous", "text": "மூணுமே தப்பு. கதை நேத்து சாயங்காலம் ஆரம்பம்..."}, {"id": 9, "duration_s": 1.47, "emotion": "mischievous", "text": "...ஒரு வாழைப்பழத்தால."}, {"id": 10, "duration_s": 3.14, "emotion": "calm", "text": "அன்னைக்கு சாயங்காலம் ஒரே ஒரு குரங்கு வந்துச்சு."}, {"id": 11, "duration_s": 2.93, "emotion": "excited", "text": "அடடா! குரங்கு வந்திருக்கு! ரொம்ப ராசி!"}, {"id": 12, "duration_s": 2.85, "emotion": "loving", "text": "இந்தா கண்ணா, பழம் சாப்பிடு. கண்ணு படாது."}, {"id": 13, "duration_s": 3.28, "emotion": "excited", "text": "குரங்கு! நிஜக் குரங்கு! நம்ம காலனில!"}, {"id": 14, "duration_s": 3.52, "emotion": "excited", "text": "ஒரு ஐடியா இருக்கு! வளர்க்கலாம்! பேரு... மங்கு!"}, {"id": 15, "duration_s": 3.25, "emotion": "worried", "text": "வளர்க்கறதா? என்ன போடுவ? என் சிப்ஸ் இல்ல!"}, {"id": 16, "duration_s": 3.68, "emotion": "serious", "text": "நான் சொல்லட்டுமா? குரங்கு காட்டு விலங்கு, வீட்டு விலங்கு இல்ல."}, {"id": 17, "duration_s": 2.77, "emotion": "stern_warning", "text": "சும்மா இரு! மங்கு நம்ம ஃப்ரெண்ட்."}, {"id": 18, "duration_s": 1.55, "emotion": "sarcastic", "text": "சரி. நான் எழுதிக்கறேன்."}, {"id": 19, "duration_s": 3.16, "emotion": "happy", "text": "தினமும் குடுப்போம். ராசியான குரங்கு!"}, {"id": 20, "duration_s": 3.63, "emotion": "mischievous", "text": "மங்கு சாப்பிட்டுச்சு... வீட்டுக்கும் போன் போட்டுச்சு."}, {"id": 21, "duration_s": 1.8, "emotion": "mischievous", "text": "மொத்தக் குடும்பத்துக்கும்!"}, {"id": 22, "duration_s": 4.29, "emotion": "calm", "text": "ராசி... ராசி... ரொம்ப ராசி..."}, {"id": 23, "duration_s": 4.61, "emotion": "mischievous", "text": "மறுநாள் காலை... ஒரு குரங்கு இருபது ஆச்சு!"}, {"id": 24, "duration_s": 3.78, "emotion": "excited", "text": "இத்தனையா? ஆஹா! இத்தனை அதிர்ஷ்டமா!"}, {"id": 25, "duration_s": 3.57, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது, குரங்கு மனுஷனுக்குப் பயப்படும்."}, {"id": 26, "duration_s": 3.07, "emotion": "serious", "text": "இங்க பாருங்க சார், சயின்ஸ் சொல்லுது, பயப்படாதீங்க."}, {"id": 27, "duration_s": 3.99, "emotion": "loving", "text": "நீங்க ரொம்ப உயரம்... பசி மயக்கமா? சாப்பிடுங்க!"}, {"id": 28, "duration_s": 3.928, "emotion": "happy", "text": "பசிக்குது! உருளை பரோட்டா, முழுசா நாலு!"}, {"id": 29, "duration_s": 4.49, "emotion": "shocked", "text": "என்னை விட வேகமா? என்னை?! அசிங்கமா போச்சு!"}, {"id": 30, "duration_s": 4.28, "emotion": "stern_warning", "text": "மென்னு சாப்பிடு! முப்பத்திரண்டு தடவை! மரியாதைன்னு ஒண்ணு..."}, {"id": 31, "duration_s": 4.93, "emotion": "laughing", "text": "ஹா ஹா! பாவம் போண்டா... அடடா! என் சாக்ஸ்!"}, {"id": 32, "duration_s": 3.83, "emotion": "worried", "text": "நேத்து ஒண்ணு. இன்னிக்கு இருபத்தேழு. நாளைக்கு எத்தனை?"}, {"id": 33, "duration_s": 2.06, "emotion": "happy", "text": "இருபத்தேழு ராசி!"}, {"id": 34, "duration_s": 2.18, "emotion": "excited", "text": "கேட்டியா? காலனில குரங்கு!"}, {"id": 35, "duration_s": 2.374, "emotion": "excited", "text": "அறிவு கண்ணாடி போச்சு, போண்டா டிபன் போச்சு..."}, {"id": 36, "duration_s": 2.89, "emotion": "proud", "text": "...ஆனா என்னோடது? எதுவும் போகாது!"}, {"id": 37, "duration_s": 1.92, "emotion": "shocked", "text": "ஐயோ! என் போன்!"}, {"id": 38, "duration_s": 4.12, "emotion": "laughing", "text": "மாமி, அது உங்களை விட நல்லா கிசுகிசு பேசுதே!"}, {"id": 39, "duration_s": 2.8, "emotion": "angry", "text": "சிரிக்காதீங்க! அதுல என் முந்நூறு குரூப் இருக்கு!"}, {"id": 40, "duration_s": 1.62, "emotion": "determined", "text": "வாங்க போலாம்! போனை திருப்பி வாங்கலாம்!"}, {"id": 41, "duration_s": 4.09, "emotion": "tired", "text": "ஐயோ! முக்கியமான நேரத்துல... எப்பவும்!"}, {"id": 42, "duration_s": 5.85, "emotion": "serious", "text": "ஒண்ணு, ரெண்டு, மூணு... ஒரு பழம் கூட கம்மி இல்ல!"}, {"id": 43, "duration_s": 5.65, "emotion": "shocked", "text": "திரும்ப எண்ணு... ஒண்ணு... ரெண்டு... ஆத்தி! காணோம்!"}, {"id": 44, "duration_s": 2.44, "emotion": "stern_warning", "text": "கந்தசாமி! நம்ம அரிசி!"}, {"id": 45, "duration_s": 1.29, "emotion": "stern_warning", "text": "கை வெச்சு பாரு!"}, {"id": 46, "duration_s": 3.7, "emotion": "relieved", "text": "குரங்கே இவங்களுக்குப் பயப்படுது. நான் மட்டும் இல்ல!"}, {"id": 47, "duration_s": 2.6, "emotion": "excited", "text": "ஹலோ ஃப்ரெண்ட்ஸ்! லைவ்ல இருக்கோம்! குரங்கு ஸ்பெஷல்!"}, {"id": 48, "duration_s": 2.35, "emotion": "happy", "text": "பாருங்க என் ஃபேன்ஸ! ஹாய் மங்கி!"}, {"id": 49, "duration_s": 2.7, "emotion": "comic_panic", "text": "என் லைவ்! என் ரிங் லைட்! என் கரியர்!"}, {"id": 50, "duration_s": 2.44, "emotion": "angry", "text": "குரங்கு லைவ்ல... பத்து லட்சம் பேரா!"}, {"id": 51, "duration_s": 4.1, "emotion": "sarcastic", "text": "அன்னைக்கு காலனியோட பெரிய இன்ஃப்ளூயன்சர்... குரங்கு."}, {"id": 52, "duration_s": 2.41, "emotion": "embarrassed", "text": "...நானும் ஃபாலோ பண்ணிட்டேன்."}, {"id": 53, "duration_s": 3.34, "emotion": "mischievous", "text": "மதியத்துக்குள்ள காலனில அவசர மீட்டிங் கூடிடுச்சு."}, {"id": 54, "duration_s": 1.89, "emotion": "stern_warning", "text": "அமைதி! ஒவ்வொருத்தரா! கை தூக்குங்க!"}, {"id": 55, "duration_s": 0.73, "emotion": "sarcastic", "text": "நீங்க மெம்பரே இல்ல!"}, {"id": 56, "duration_s": 1.6, "emotion": "proud", "text": "நான் யாருக்கும் பயப்படமாட்டேன்! குரங்கை நான் பிடிப்பேன்!"}, {"id": 57, "duration_s": 2.44, "emotion": "sarcastic", "text": "பல்லிக்கே பயந்துட்டு குரங்கு பிடிப்பீங்களா?"}, {"id": 58, "duration_s": 7.01, "emotion": "embarrassed", "text": "நான்... தூணோட உறுதியை செக் பண்ணேன்."}, {"id": 59, "duration_s": 4.01, "emotion": "serious", "text": "கண்ணு பட்டுடுச்சு! எல்லா வீட்டுலயும் எலுமிச்சை மிளகாய்!"}, {"id": 60, "duration_s": 2.69, "emotion": "proud", "text": "என் லட்டை தொட்டுப் பாருங்க பாப்போம்!"}, {"id": 61, "duration_s": 2.81, "emotion": "scared_whisper", "text": "குரங்குக்கு இனிப்பு வாசனை தெரியுமாம்..."}, {"id": 62, "duration_s": 3.0, "emotion": "serious", "text": "நான் சொல்லட்டுமா? குரங்கு வர்றதுக்குக் காரணம்..."}, {"id": 63, "duration_s": 2.24, "emotion": "serious", "text": "புள்ளைங்க பேசாதீங்க! பெரியவங்க மீட்டிங்!"}, {"id": 64, "duration_s": 1.5, "emotion": "stern_warning", "text": "அமைதி! அண்ணா பேசட்டும்!"}, {"id": 65, "duration_s": 1.95, "emotion": "excited", "text": "டென்ஷன் வேணாம்! பிளான் ரெடி!"}, {"id": 66, "duration_s": 4.52, "emotion": "sad", "text": "பெரிசுங்க மீட்டிங். எங்க பேச்சு... நாளைக்கு."}, {"id": 67, "duration_s": 5.01, "emotion": "proud", "text": "பாருங்க, விஞ்ஞானம்! பழம் உள்ள, குரங்கு உள்ள, டமால்!"}, {"id": 68, "duration_s": 2.43, "emotion": "worried", "text": "அப்பா, குரங்கு மேல மரத்துல இருக்கு..."}, {"id": 69, "duration_s": 1.92, "emotion": "determined", "text": "பழத்தை கொஞ்சம் நேரா வெச்சுடறேன்..."}, {"id": 70, "duration_s": 3.07, "emotion": "comic_panic", "text": "நான் யாருக்கும் பயப்படமாட்டேன்... வெளிய எடுங்கடா!"}, {"id": 71, "duration_s": 2.76, "emotion": "worried", "text": "அங்கிள் ஓகேவா? பழம் ஓகேவா?"}, {"id": 72, "duration_s": 2.08, "emotion": "determined", "text": "போதும்! இனி நான் பாத்துக்கறேன்."}, {"id": 73, "duration_s": 3.26, "emotion": "proud", "text": "நான் வேணும்னே விட்டேன். பாவமா போச்சு."}, {"id": 74, "duration_s": 2.29, "emotion": "proud", "text": "டென்ஷன் வேணாம்! கருங்குரங்கு வந்தாச்சு!"}, {"id": 75, "duration_s": 3.98, "emotion": "curious", "text": "சித்தப்பா, நீங்க... பெரிய குரங்கு மாதிரி இருக்கீங்க."}, {"id": 76, "duration_s": 2.95, "emotion": "proud", "text": "அதான்! குரங்கு கருங்குரங்குக்குப் பயப்படும்!"}, {"id": 77, "duration_s": 1.57, "emotion": "shouting", "text": "ஹூ ஹூ ஹா ஹா! ஓடுங்க!"}, {"id": 78, "duration_s": 2.3, "emotion": "surprised", "text": "அட? இது... குனியுதே?"}, {"id": 79, "duration_s": 3.25, "emotion": "proud", "text": "நான்தான் இவங்க ராஜா! சேகர் மகாராஜா!"}, {"id": 80, "duration_s": 2.8, "emotion": "giggly", "text": "ஹா ஹா! கூசுது! என் தலைல பேன் இல்ல!"}, {"id": 81, "duration_s": 2.36, "emotion": "excited", "text": "கேட்டியா? சேகர் குரங்குக்கெல்லாம் தலைவனாயிட்டான்!"}, {"id": 82, "duration_s": 2.2, "emotion": "stern_warning", "text": "வெளிய போ! உன் மொத்த சேனையோட!"}, {"id": 83, "duration_s": 3.84, "emotion": "tired", "text": "ஹ்ம். டென்ஷன்... கொஞ்சூண்டு இருக்கு."}, {"id": 84, "duration_s": 3.15, "emotion": "stern_warning", "text": "விசாரணை நடக்கும்! காலனி முழுக்க!"}, {"id": 85, "duration_s": 2.82, "emotion": "sarcastic", "text": "விசாரணை ஆரம்பம். ரெண்டு நிமிஷம்..."}, {"id": 86, "duration_s": 3.13, "emotion": "excited", "text": "சமோசா? விசாரணை!"}, {"id": 87, "duration_s": 4.69, "emotion": "shocked", "text": "ஜெய் ஹிந்த்! ஆஹா... என் தொப்பி!"}, {"id": 88, "duration_s": 3.76, "emotion": "comic_panic", "text": "ஹெட் ஆபீஸ்! குரங்குங்க என் தொப்பியை கைது பண்ணிடுச்சு!"}, {"id": 89, "duration_s": 4.43, "emotion": "tender", "text": "அங்கிள், பாதி சமோசா. பாதி மட்டும்தான்."}, {"id": 90, "duration_s": 3.63, "emotion": "proud", "text": "என் கடலைமாவு லட்டு! ஊரே பாக்கும்!"}, {"id": 91, "duration_s": 2.09, "emotion": "shocked", "text": "ஆத்தி! என் லட்டு!"}, {"id": 92, "duration_s": 2.03, "emotion": "determined", "text": "இன்னிக்கு நீ காலி!"}, {"id": 93, "duration_s": 4.3, "emotion": "excited", "text": "ஆரம்பமாச்சு... காலனி வரலாற்றிலேயே பெரிய ஓட்டம்!"}, {"id": 94, "duration_s": 2.073, "emotion": "excited", "text": "பாட்டி! பாட்டி! பாட்டி!"}, {"id": 95, "duration_s": 2.11, "emotion": "excited", "text": "பாட்டி வெர்சஸ் குரங்கு! லைவ்ல இருக்கோம்!"}, {"id": 96, "duration_s": 1.64, "emotion": "excited", "text": "சபாஷ் பாட்டி!"}, {"id": 97, "duration_s": 3.67, "emotion": "shocked", "text": "நாப்பது லட்டு... நானூறு ரூபாய் சரக்கு!"}, {"id": 98, "duration_s": 2.06, "emotion": "shocked", "text": "அம்மா குறி... தப்பிடுச்சா?"}, {"id": 99, "duration_s": 4.1, "emotion": "sad", "text": "முதல் தடவை... வாழ்க்கைல முதல் தடவை!"}, {"id": 100, "duration_s": 3.31, "emotion": "sarcastic", "text": "ஊரே பாத்துச்சு... பாட்டியோட குறி தப்புறதை."}, {"id": 101, "duration_s": 2.73, "emotion": "stern_warning", "text": "அமைதி! எல்லாரும் அமைதி! இப்போ அண்ணன் பேசுவான்!"}, {"id": 102, "duration_s": 2.46, "emotion": "determined", "text": "நான் சொல்லட்டுமா? என் கூட வாங்க."}, {"id": 103, "duration_s": 4.48, "emotion": "sarcastic", "text": "காலனி பின்னாடி... குரங்குக்கு இலவச ஹோட்டல்."}, {"id": 104, "duration_s": 2.29, "emotion": "angry", "text": "ச்சீ! இந்தக் குப்பை யாரோடது?"}, {"id": 105, "duration_s": 1.38, "emotion": "embarrassed", "text": "...யாரோடதும் இருக்கலாம்."}, {"id": 106, "duration_s": 3.91, "emotion": "serious", "text": "திறந்த குப்பை, தினம் வாழைப்பழம்... இலவச சாப்பாடு!"}, {"id": 107, "duration_s": 3.86, "emotion": "calm", "text": "இலவச சாப்பாடு, குரங்கு அங்கே. நேரா கணக்கு."}, {"id": 108, "duration_s": 3.36, "emotion": "proud", "text": "சயின்ஸ் சொல்லுது, குரங்கு நம்மள காதலிக்குது!"}, {"id": 109, "duration_s": 3.28, "emotion": "sarcastic", "text": "அது சாப்பாட்டை காதலிக்குது. நீங்க குப்பைத்தொட்டியை."}, {"id": 110, "duration_s": 4.36, "emotion": "serious", "text": "சாப்பாடு குடுத்தா மனுஷன் பயம் போயிடும். அப்புறம் பிடுங்கல்."}, {"id": 111, "duration_s": 3.27, "emotion": "serious", "text": "நம்ம சிப்ஸ், இனிப்பால குரங்குக்கு உடம்பும் கெடும்."}, {"id": 112, "duration_s": 4.26, "emotion": "guilty", "text": "நான்... ராசிக்காக ஒரு பழம்தான் குடுத்தேன்."}, {"id": 113, "duration_s": 2.43, "emotion": "guilty", "text": "தினமும் குடுக்கற ஐடியா... என்னுது."}, {"id": 114, "duration_s": 2.03, "emotion": "guilty", "text": "நான் ஒரு சிப்ஸ்தான்..."}, {"id": 115, "duration_s": 1.95, "emotion": "determined", "text": "போதும்! இனி நான் பாத்துக்கறேன்."}, {"id": 116, "duration_s": 1.48, "emotion": "shouting", "text": "கந்தா! துடைப்பம்!"}, {"id": 117, "duration_s": 4.31, "emotion": "tired", "text": "ஒண்ணு, ரெண்டு பெருக்கல்... இலவச வேலை!"}, {"id": 118, "duration_s": 2.94, "emotion": "mischievous", "text": "இனி பழம் நான் மட்டும்தான்."}, {"id": 119, "duration_s": 4.15, "emotion": "calm", "text": "ஹலோ, வனத்துறையா? காலனில குரங்கு! பிளீஸ் வாங்க."}, {"id": 120, "duration_s": 2.83, "emotion": "calm", "text": "பயப்படாதீங்கோ. டீம் பத்திரமா கூட்டிண்டு போவா."}, {"id": 121, "duration_s": 3.51, "emotion": "calm", "text": "அடிக்காதீங்கோ, மிரட்டாதீங்கோ, ஊட்டாதீங்கோ. அன்பா இருங்கோ."}, {"id": 122, "duration_s": 4.32, "emotion": "surprised", "text": "இன்னைக்கு முதல் தடவை... ராஜா ஆட்டோ நிக்கல."}, {"id": 123, "duration_s": 2.08, "emotion": "happy", "text": "வந்தாச்சு! இப்போ நீ தூங்கு!"}, {"id": 124, "duration_s": 2.93, "emotion": "proud", "text": "டென்ஷன் வேணாம்! இதுங்க என் பேச்சைக் கேக்கும்!"}, {"id": 125, "duration_s": 4.97, "emotion": "happy", "text": "ஹா! குரங்கு போனை திருப்பிக் குடுத்துச்சு!"}, {"id": 126, "duration_s": 5.14, "emotion": "proud", "text": "விசாரணை... ஓவர்!"}, {"id": 127, "duration_s": 2.07, "emotion": "embarrassed", "text": "ஓ... நீங்க விளக்குக் கம்பமா. சாரி."}, {"id": 128, "duration_s": 2.87, "emotion": "excited", "text": "கோலாப்! திவ்யா அண்ட் மங்கி!"}, {"id": 129, "duration_s": 2.46, "emotion": "stern_warning", "text": "அடுத்த தடவை... குறி தப்பாது."}, {"id": 130, "duration_s": 2.395, "emotion": "tender", "text": "வாலை வெச்சுக்கோ... நினைவுக்காக."}, {"id": 131, "duration_s": 2.32, "emotion": "tender", "text": "குரங்குகள் வீடு போச்சு... காட்டுக்கு."}, {"id": 132, "duration_s": 4.17, "emotion": "curious", "text": "ஆனா தாத்தா, குரங்குக்கு பழம் குடுக்கறது ராசிதானே?"}, {"id": 133, "duration_s": 3.3, "emotion": "calm", "text": "விலங்குக்கு தீனி போடறது அன்பில்ல..."}, {"id": 134, "duration_s": 3.14, "emotion": "tender", "text": "...காட்டை காடா இருக்க விடு."}, {"id": 135, "duration_s": 3.31, "emotion": "serious", "text": "குப்பையை மூடி வைங்க. குரங்கு பாத்தா வனத்துறைக்கு போன்."}, {"id": 136, "duration_s": 2.67, "emotion": "stern_warning", "text": "கிண்டலும் பண்ணாதீங்க! புரிஞ்சுதா? அமைதி!"}, {"id": 137, "duration_s": 2.24, "emotion": "giggly", "text": "ராசி பழம்... என்னுது!"}, {"id": 138, "duration_s": 3.41, "emotion": "determined", "text": "இனி பயிற்சி! குறியை திரும்பக் கொண்டு வரணும்!"}, {"id": 139, "duration_s": 1.103, "emotion": "tired", "text": "அம்மா!"}, {"id": 140, "duration_s": 1.56, "emotion": "proud", "text": "குறி திரும்புச்சு!"}]