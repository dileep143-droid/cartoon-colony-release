[{"id": 1, "duration_s": 3.7, "emotion": "embarrassed", "text": "ഹാ, ഞാൻ തന്നെ! എങ്ങനെയെന്ന് ആലോചിക്കുവാണോ?"}, {"id": 2, "duration_s": 4.69, "emotion": "mischievous", "text": "രാവിലെ മുതൽ പറയാം. കോളനിയിൽ വന്നു... ഒരു പുതിയ ബൈക്ക്."}, {"id": 3, "duration_s": 4.7, "emotion": "proud", "text": "പുതിയ ബൈക്ക്! എൺപതിനായിരം... ഒറ്റ രൂപ കുറയില്ല!"}, {"id": 4, "duration_s": 2.57, "emotion": "mischievous", "text": "എന്റച്ഛന് ബൈക്ക്! നിന്റച്ഛന് എന്തുണ്ട്?"}, {"id": 5, "duration_s": 2.45, "emotion": "proud", "text": "എന്റച്ഛന്... മീശയുണ്ട്!"}, {"id": 6, "duration_s": 3.75, "emotion": "sarcastic", "text": "എന്റച്ഛനും മീശയുണ്ട്... ബൈക്കും!"}, {"id": 7, "duration_s": 2.48, "emotion": "shocked", "text": "മീശയോ?! ഇത് മാനത്തിന്റെ പ്രശ്നമാ!"}, {"id": 8, "duration_s": 2.67, "emotion": "proud", "text": "വൈകിട്ടോടെ ഈ വഴിയിൽ എന്റെ വണ്ടി ഓടും!"}, {"id": 9, "duration_s": 2.24, "emotion": "excited", "text": "കേട്ടോ? സുരേഷിന് കപ്പലോളം വണ്ടി!"}, {"id": 10, "duration_s": 3.15, "emotion": "sarcastic", "text": "വൈകിട്ട് വണ്ടി വന്നു... പക്ഷേ ഓടിയല്ല."}, {"id": 11, "duration_s": 4.78, "emotion": "tired", "text": "എത്തി... എന്റെ പുലിക്കുട്ടി."}, {"id": 12, "duration_s": 2.7, "emotion": "sarcastic", "text": "ഇത് ഓടുമോ, അതോ ഇതിനും തള്ളണോ?"}, {"id": 13, "duration_s": 6.99, "emotion": "proud", "text": "വിന്റേജാ! വിന്റേജ് എന്നാൽ... പഴയത്, പക്ഷേ വില കൂടിയത്!"}, {"id": 14, "duration_s": 2.41, "emotion": "comic_panic", "text": "ഞാൻ... ആരെയും പേടിക്കില്ല!"}, {"id": 15, "duration_s": 3.83, "emotion": "laughing", "text": "ഹ ഹ! സ്കൂട്ടി പതിനയ്യായിരം, പുക ഫ്രീ!"}, {"id": 16, "duration_s": 0.49, "emotion": "stern_warning", "text": "ചേട്ടാ!"}, {"id": 17, "duration_s": 2.32, "emotion": "excited", "text": "ഓടി! അച്ഛാ, ഓടി!"}, {"id": 18, "duration_s": 3.39, "emotion": "serious", "text": "കണ്ണ് തട്ടിയാലോ? നാരങ്ങയും മുളകും വേണം!"}, {"id": 19, "duration_s": 3.8, "emotion": "proud", "text": "നാട്ടുകാരെല്ലാം കാണട്ടെ! എന്റെ മോന്റെ വണ്ടി!"}, {"id": 20, "duration_s": 4.77, "emotion": "proud", "text": "ഇന്ന് മുടി സെറ്റ്... ബൈക്കിനും നാണം വരും."}, {"id": 21, "duration_s": 0.616, "emotion": "stern_warning", "text": "ഹെൽമെറ്റ് വെക്ക്."}, {"id": 22, "duration_s": 1.65, "emotion": "pleading", "text": "ഹെൽമെറ്റ് വച്ചാൽ മുടി പോകും, ശോഭേ! ഒരിക്കലുമില്ല!"}, {"id": 23, "duration_s": 1.88, "emotion": "determined", "text": "മതി! ഇനി ഞാൻ നോക്കിക്കോളാം."}, {"id": 24, "duration_s": 2.11, "emotion": "comic_panic", "text": "ഞാൻ ആരെയും പേടിക്കില്ല... പല്ലിയെ ഒഴികെ!"}, {"id": 25, "duration_s": 2.34, "emotion": "sarcastic", "text": "പല്ലി പോയി. ഇനി മുടിയും പോകും."}, {"id": 26, "duration_s": 3.8, "emotion": "giggly", "text": "അച്ഛാ, ഹെൽമെറ്റ് തലതിരിഞ്ഞു!"}, {"id": 27, "duration_s": 1.9, "emotion": "proud", "text": "അറിയാം! പിന്നിലിരിക്കുന്നവർക്കാ!"}, {"id": 28, "duration_s": 2.93, "emotion": "excited", "text": "ലൈവാണ്! അച്ഛന്റെ തിരിഞ്ഞ ഹെൽമെറ്റ്!"}, {"id": 29, "duration_s": 2.9, "emotion": "sad", "text": "എന്റെ മുടി... വീരമൃത്യു വരിച്ചു."}, {"id": 30, "duration_s": 1.11, "emotion": "stern_warning", "text": "വള്ളിയും കെട്ട്."}, {"id": 31, "duration_s": 0.58, "emotion": "mischievous", "text": "നാളെ!"}, {"id": 32, "duration_s": 1.88, "emotion": "excited", "text": "ടെൻഷനടിക്കണ്ട! ഞാൻ പഠിപ്പിക്കാം!"}, {"id": 33, "duration_s": 2.09, "emotion": "proud", "text": "ക്ലച്ചില്ല, കൊടുക്ക് ആക്സിലറേറ്റർ!"}, {"id": 34, "duration_s": 2.14, "emotion": "sarcastic", "text": "ചേട്ടാ, ആദ്യം സ്റ്റാർട്ടാക്ക്!"}, {"id": 35, "duration_s": 1.62, "emotion": "excited", "text": "നോക്ക്! ഞാൻ പറക്കുന്നു!"}, {"id": 36, "duration_s": 2.31, "emotion": "proud", "text": "ഹീറോ! പത്ത് കിലോമീറ്റർ ആയി!"}, {"id": 37, "duration_s": 0.72, "emotion": "proud", "text": "അനങ്ങാതെ!"}, {"id": 38, "duration_s": 1.8, "emotion": "shouting", "text": "ആക്സിലറേറ്റ്! മുന്നോട്ട്! മുന്നോട്ട്!"}, {"id": 39, "duration_s": 2.16, "emotion": "comic_panic", "text": "മുന്നോട്ടോ? വണ്ടി പിന്നോട്ടാ പോണേ!"}, {"id": 40, "duration_s": 1.46, "emotion": "comic_panic", "text": "ബ്രേക്ക്! ബ്രേക്ക്! കൈ ബ്രേക്ക്!"}, {"id": 41, "duration_s": 1.95, "emotion": "embarrassed", "text": "ഞാൻ ഓക്കേ. വണ്ടിയും ഓക്കേ."}, {"id": 42, "duration_s": 2.194, "emotion": "serious", "text": "കണ്ണ് തട്ടി! ഞാൻ പറഞ്ഞില്ലേ?"}, {"id": 43, "duration_s": 2.84, "emotion": "sad", "text": "ശ്ശോ! നാരങ്ങയ്ക്ക് ബ്രേക്കില്ല, അമ്മച്ചീ!"}, {"id": 44, "duration_s": 2.09, "emotion": "angry", "text": "ഷിബൂ! ആദ്യം നീ പഠിക്ക്!"}, {"id": 45, "duration_s": 3.07, "emotion": "embarrassed", "text": "ടെൻഷനടിക്കണ്ട... അമ്മച്ചിക്ക് ഉന്നം തെറ്റില്ല."}, {"id": 46, "duration_s": 2.84, "emotion": "mischievous", "text": "ഒരു ഐഡിയ ഉണ്ട്! അച്ഛനെക്കാൾ നന്നായി ഞങ്ങളോടിക്കും!"}, {"id": 47, "duration_s": 2.6, "emotion": "excited", "text": "ഞാൻ പിന്നിൽ... പലഹാരത്തോടൊപ്പം!"}, {"id": 48, "duration_s": 1.51, "emotion": "stern_warning", "text": "മിണ്ടരുത്! കൈ മാറ്റ്!"}, {"id": 49, "duration_s": 3.11, "emotion": "serious", "text": "കുട്ടികൾ വണ്ടിയോടിക്കരുത്, ഒരിക്കലും! കേട്ടോ?"}, {"id": 50, "duration_s": 2.91, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? പതിനെട്ടാവാതെ വണ്ടി ഓടിക്കാൻ പാടില്ല."}, {"id": 51, "duration_s": 2.28, "emotion": "serious", "text": "കാല് നിലത്തെത്തില്ല. ബ്രേക്ക് എങ്ങനെ പിടിക്കും?"}, {"id": 52, "duration_s": 1.26, "emotion": "proud", "text": "താക്കോൽ ജപ്തി!"}, {"id": 53, "duration_s": 2.95, "emotion": "excited", "text": "വേറൊരു ഐഡിയ! അച്ഛനെ നമ്മൾ പഠിപ്പിക്കും!"}, {"id": 54, "duration_s": 2.85, "emotion": "tired", "text": "ഞാൻ ആരെ... പേടി... കൂർ..."}, {"id": 55, "duration_s": 3.71, "emotion": "proud", "text": "കണ്ടോ നാട്ടുകാരേ! സുരേഷ് മേനോൻ... ഓൺ ദി റോഡ്!"}, {"id": 56, "duration_s": 2.29, "emotion": "proud", "text": "കുട്ടപ്പേട്ടാ! സ്കൂട്ടി കാറ്റിനോട് മിണ്ടുന്നു!"}, {"id": 57, "duration_s": 3.728, "emotion": "sarcastic", "text": "കാറ്റിനോടല്ല, എന്നോടാ മിണ്ടുന്നത്. ശ്രദ്ധിക്ക്!"}, {"id": 58, "duration_s": 2.61, "emotion": "happy", "text": "നമസ്തേ കുഞ്ഞമ്മ! കുട്ടപ്പേട്ടാ, പറയൂ!"}, {"id": 59, "duration_s": 4.53, "emotion": "sarcastic", "text": "ഒരു കൈയിൽ ഫോൺ, മറുകൈയിൽ നമസ്കാരം... വണ്ടി ആരുടെ കയ്യിൽ?"}, {"id": 60, "duration_s": 2.81, "emotion": "comic_panic", "text": "സുരേഷേ! മുന്നിൽ നോക്ക്! മുന്നിൽ!"}, {"id": 61, "duration_s": 6.46, "emotion": "curious", "text": "മുന്നിലോ? കുട്ടപ്പേട്ടാ, നിങ്ങൾ ഫോണിലല്ലേ!"}, {"id": 62, "duration_s": 3.02, "emotion": "embarrassed", "text": "ഞാൻ ഓക്കേ! വണ്ടിയും ഓക്കേ! പെട്ടികൾ...?"}, {"id": 63, "duration_s": 3.21, "emotion": "crying", "text": "എന്റെ പെട്ടികൾ! എന്റെ ഷോകേസ്!"}, {"id": 64, "duration_s": 1.85, "emotion": "shocked", "text": "കാലി! ഇതും കാലി!"}, {"id": 65, "duration_s": 3.96, "emotion": "sad", "text": "എല്ലാം ഒഴിഞ്ഞു! ഒരു മധുരം പോലുമില്ല!"}, {"id": 66, "duration_s": 4.65, "emotion": "stern_warning", "text": "ചേട്ടാ! പെട്ടി കാലിയോ?"}, {"id": 67, "duration_s": 3.65, "emotion": "embarrassed", "text": "കാണിക്കാനാ! നിറച്ച പെട്ടിക്ക് ചെലവ് കൂടും!"}, {"id": 68, "duration_s": 3.28, "emotion": "proud", "text": "കണ്ടോ? ഹെൽമെറ്റിൽ ഒരു പെട്ടി വീണതേയുള്ളൂ."}, {"id": 69, "duration_s": 2.481, "emotion": "serious", "text": "ഹെൽമെറ്റ് ഇല്ലായിരുന്നെങ്കിലോ?"}, {"id": 70, "duration_s": 1.18, "emotion": "happy", "text": "മുടി രക്ഷപ്പെട്ടേനെ!"}, {"id": 71, "duration_s": 3.25, "emotion": "sarcastic", "text": "ഇത്രയും ബഹളത്തിലും... ഹവൽദാർ പിള്ള സാർ ഉറക്കം തന്നെ!"}, {"id": 72, "duration_s": 2.24, "emotion": "shouting", "text": "സമൂസയോ? അപ്പോ... അന്വേഷണം!"}, {"id": 73, "duration_s": 9.99, "emotion": "stern_warning", "text": "ബെൽറ്റ് തുറന്ന്, കയ്യിൽ ഫോൺ... ലൈസൻസ് കാണിക്ക്!"}, {"id": 74, "duration_s": 2.66, "emotion": "sarcastic", "text": "ഇത് റേഷൻ കാർഡ്."}, {"id": 75, "duration_s": 5.39, "emotion": "curious", "text": "ഇത് ജിം കാർഡ്. നീ ജിമ്മിൽ പോവാറുണ്ടോ?"}, {"id": 76, "duration_s": 6.59, "emotion": "embarrassed", "text": "കാർഡ് മാത്രം."}, {"id": 77, "duration_s": 2.78, "emotion": "shocked", "text": "ഇത്... ഏതോ കുട്ടീടെ റിപ്പോർട്ട് കാർഡാ!"}, {"id": 78, "duration_s": 2.02, "emotion": "embarrassed", "text": "അച്ഛാ! അത് എന്റേതാ!"}, {"id": 79, "duration_s": 5.84, "emotion": "serious", "text": "ലൈസൻസില്ല, ഫോണിൽ സംസാരം... ഫൈൻ അടിക്കും!"}, {"id": 80, "duration_s": 3.63, "emotion": "pleading", "text": "സാറേ... ചൂടൻ സമൂസ? ഫൈനിനു പകരം?"}, {"id": 81, "duration_s": 6.0, "emotion": "stern_warning", "text": "കൈക്കൂലിയോ? കിഴങ്ങോ? ഒരിക്കലുമില്ല!"}, {"id": 82, "duration_s": 1.28, "emotion": "embarrassed", "text": "വിശക്കുന്നു!"}, {"id": 83, "duration_s": 4.16, "emotion": "serious", "text": "ആദ്യം ആർടിഒയിൽ പോ. ലേണേഴ്സ് എടുക്ക്."}, {"id": 84, "duration_s": 2.12, "emotion": "sarcastic", "text": "ഫൈൻ നിങ്ങളുടെ പോക്കറ്റ് മണിയിൽ നിന്ന്."}, {"id": 85, "duration_s": 4.32, "emotion": "shocked", "text": "എന്റെ പോക്കറ്റ് മണിയോ? ഞാനൊരു അച്ഛനാ!"}, {"id": 86, "duration_s": 2.84, "emotion": "determined", "text": "അച്ഛാ, നാളെ മുതൽ... കോളനി ഡ്രൈവിങ് സ്കൂൾ!"}, {"id": 87, "duration_s": 3.53, "emotion": "excited", "text": "ഒരാഴ്ച കഴിഞ്ഞ്... കുട്ടികൾ തുടങ്ങി ഡ്രൈവിങ് സ്കൂൾ!"}, {"id": 88, "duration_s": 2.79, "emotion": "excited", "text": "കോളനി ഡ്രൈവിങ് സ്കൂൾ! ഇന്ന് എല്ലാവർക്കും ടെസ്റ്റ്!"}, {"id": 89, "duration_s": 5.68, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? നാല് നിയമം: ഹെൽമെറ്റ്, രണ്ട് കൈ, ഫോണില്ല, ലൈസൻസ്."}, {"id": 90, "duration_s": 2.61, "emotion": "proud", "text": "കുട്ടികൾ? കൈയടിക്കും, അത്രമാത്രം!"}, {"id": 91, "duration_s": 3.76, "emotion": "proud", "text": "ആർടിഒയിൽ നിന്ന് ലേണേഴ്സ്! ഞാനിപ്പോൾ പകുതി ഡ്രൈവർ!"}, {"id": 92, "duration_s": 2.87, "emotion": "proud", "text": "സയൻസ് പറയുന്നു, ഹെൽമെറ്റ് തല ചൂടാക്കും."}, {"id": 93, "duration_s": 5.136, "emotion": "serious", "text": "സയൻസ് ഇതും പറയുന്നു: ഹെൽമെറ്റ് തല രക്ഷിക്കും."}, {"id": 94, "duration_s": 0.94, "emotion": "embarrassed", "text": "...ഉം, അതും."}, {"id": 95, "duration_s": 2.88, "emotion": "serious", "text": "മാഷേ, ഒന്നാം നിയമം: ബ്രേക്ക്!"}, {"id": 96, "duration_s": 2.91, "emotion": "happy", "text": "ബ്രേക്കോ? ഉവ്വുവ്വ്, ലഞ്ച് ബ്രേക്ക്!"}, {"id": 97, "duration_s": 1.21, "emotion": "shouting", "text": "ഇൻഡിക്കേറ്റർ!"}, {"id": 98, "duration_s": 2.79, "emotion": "proud", "text": "ഇന്ത്യാ ഗേറ്റോ? അത് ഡൽഹിയിലാ, മോനേ!"}, {"id": 99, "duration_s": 0.84, "emotion": "shouting", "text": "ലൈസൻസ്!"}, {"id": 100, "duration_s": 2.25, "emotion": "stern_warning", "text": "സൈലൻസ്! എല്ലാരും മിണ്ടരുത്!"}, {"id": 101, "duration_s": 0.94, "emotion": "happy", "text": "വാ, പോകാം!"}, {"id": 102, "duration_s": 2.27, "emotion": "serious", "text": "ഇതിനും കണ്ണ് തട്ടി!"}, {"id": 103, "duration_s": 2.18, "emotion": "curious", "text": "ആദ്യത്തെ ആൾ... ഓട്ടോ?"}, {"id": 104, "duration_s": 2.98, "emotion": "excited", "text": "ലൈവാണ്! കോളനിയുടെ മഹാ ടെസ്റ്റ്!"}, {"id": 105, "duration_s": 2.66, "emotion": "proud", "text": "ടെൻഷനടിക്കണ്ട! ഹീറോയ്ക്ക് ഹെൽമെറ്റ് വേണ്ട!"}, {"id": 106, "duration_s": 1.7, "emotion": "stern_warning", "text": "ഹെൽമെറ്റില്ലേ? പുറത്ത്!"}, {"id": 107, "duration_s": 4.96, "emotion": "serious", "text": "ഒന്ന്, രണ്ട്, മൂന്ന്... നില്ല്, വീണ്ടും... ഒന്ന്..."}, {"id": 108, "duration_s": 2.41, "emotion": "angry", "text": "കുട്ടപ്പേട്ടാ! ടെസ്റ്റാ, കണക്കല്ല!"}, {"id": 109, "duration_s": 2.3, "emotion": "stern_warning", "text": "എന്റെ പെട്ടികളാ! ഒറ്റയെണ്ണം കുറയില്ല!"}, {"id": 110, "duration_s": 1.51, "emotion": "serious", "text": "സമയം തീർന്നു! നെക്സ്റ്റ്!"}, {"id": 111, "duration_s": 1.35, "emotion": "excited", "text": "കേട്ടോ? ഞാൻ ടെസ്റ്റിലാ..."}, {"id": 112, "duration_s": 0.86, "emotion": "stern_warning", "text": "ഫോൺ!"}, {"id": 113, "duration_s": 0.79, "emotion": "embarrassed", "text": "...പിന്നെ പറയാം."}, {"id": 114, "duration_s": 1.8, "emotion": "shocked", "text": "അമ്മേ! സ്കൂട്ടിയിലോ?"}, {"id": 115, "duration_s": 2.72, "emotion": "proud", "text": "എൺപതിലെ ലൈസൻസാ, മോനേ!"}, {"id": 116, "duration_s": 1.81, "emotion": "determined", "text": "നാട്ടുകാരൊക്കെ കാണട്ടെ!"}, {"id": 117, "duration_s": 3.02, "emotion": "proud", "text": "ഇദ്ദേഹത്തെയും സ്കൂട്ടി പഠിപ്പിച്ചത് ഞാനാ!"}, {"id": 118, "duration_s": 3.02, "emotion": "excited", "text": "ഫസ്റ്റ് ക്ലാസ്! നൂറിൽ നൂറ്!"}, {"id": 119, "duration_s": 2.441, "emotion": "proud", "text": "ഞാൻ ആരെയും പേടിക്കില്ല!"}, {"id": 120, "duration_s": 2.53, "emotion": "giggly", "text": "അച്ഛാ... പിന്നേം തിരിഞ്ഞു!"}, {"id": 121, "duration_s": 1.83, "emotion": "mischievous", "text": "ഇനി ഞാൻ നോക്കട്ടെ..."}, {"id": 122, "duration_s": 2.29, "emotion": "determined", "text": "വണ്ടിയോടിക്കുമ്പോൾ... ഫോൺ വേണ്ട!"}, {"id": 123, "duration_s": 0.92, "emotion": "tender", "text": "ആദ്യം നീ പൊയ്ക്കോ."}, {"id": 124, "duration_s": 0.66, "emotion": "excited", "text": "പാസ്!"}, {"id": 125, "duration_s": 3.91, "emotion": "serious", "text": "പക്ഷേ ശരിക്കുള്ളത് ആർടിഒ തരും, ഞാനല്ല."}, {"id": 126, "duration_s": 2.4, "emotion": "excited", "text": "സുരേഷ് പാസ്! സുരേഷ് പാസ്!"}, {"id": 127, "duration_s": 3.59, "emotion": "excited", "text": "എന്റെ അച്ഛന് ഇപ്പോൾ... മീശയും, ലൈസൻസും!"}, {"id": 128, "duration_s": 2.02, "emotion": "happy", "text": "ചേട്ടാ! കൈയടിക്ക്!"}, {"id": 129, "duration_s": 4.1, "emotion": "excited", "text": "'അച്ഛന്റെ ആദ്യ യാത്ര'! പത്തുലക്ഷം വ്യൂസ്!"}, {"id": 130, "duration_s": 3.67, "emotion": "comic_panic", "text": "എന്റെ മുടി! പത്തുലക്ഷം പേർ കണ്ടോ?!"}, {"id": 131, "duration_s": 1.92, "emotion": "laughing", "text": "ഹ ഹ! ഇനി ചീപ്പിനും ഹെൽമെറ്റ് വേണം!"}, {"id": 132, "duration_s": 2.647, "emotion": "calm", "text": "സുരേഷേ... ഒരു കാര്യം ഓർത്തോ."}, {"id": 133, "duration_s": 3.11, "emotion": "serious", "text": "ഹെൽമെറ്റ് തലയ്ക്കാ, മുടിക്കല്ല."}, {"id": 134, "duration_s": 5.81, "emotion": "calm", "text": "വള്ളി കെട്ടണം, രണ്ടു കൈയും ഹാൻഡിലിൽ, ഫോൺ പോക്കറ്റിൽ."}, {"id": 135, "duration_s": 5.46, "emotion": "tender", "text": "കുട്ടികളേ? വണ്ടി പതിനെട്ടു കഴിഞ്ഞ്, ലൈസൻസോടെ."}, {"id": 136, "duration_s": 1.23, "emotion": "proud", "text": "അതുവരെ... കൈയടി!"}, {"id": 137, "duration_s": 4.69, "emotion": "happy", "text": "അച്ഛാ, മനസ്സിലായി! തല ആദ്യം, മുടി പിന്നെ."}, {"id": 138, "duration_s": 1.36, "emotion": "excited", "text": "ചിരിക്കൂ, സുരേഷേട്ടാ!"}, {"id": 139, "duration_s": 0.99, "emotion": "shocked", "text": "എന്റെ പുലിക്കുട്ടി...?"}, {"id": 140, "duration_s": 3.82, "emotion": "sad", "text": "നാല്പത്തിരണ്ട്... വീണ്ടും എണ്ണണോ?"}]