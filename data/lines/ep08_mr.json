[{"id": 1, "duration_s": 4.87, "emotion": "calm", "text": "मेची गर्मी. सकाळचे सात. सगळं आलबेल होतं..."}, {"id": 2, "duration_s": 4.18, "emotion": "happy", "text": "थंड थंड पाणी... गरम गरम मी! ला-ला-ला!"}, {"id": 3, "duration_s": 2.38, "emotion": "curious", "text": "अरेच्चा! पाऊस थांबला की काय?"}, {"id": 4, "duration_s": 3.36, "emotion": "comic_panic", "text": "पाणी... पाणी! डोळ्यात साबण! सुनंदाऽऽ!"}, {"id": 5, "duration_s": 2.72, "emotion": "surprised", "text": "सासूबाई, पाणी नाही! नुसती हवा!"}, {"id": 6, "duration_s": 5.64, "emotion": "serious", "text": "नळ आजारी आहे. ताप नाही, तहान आहे."}, {"id": 7, "duration_s": 2.46, "emotion": "excited", "text": "ऐकलंत का? माझा नळपण खोकतोय!"}, {"id": 8, "duration_s": 3.54, "emotion": "angry", "text": "एक थेंब? महिन्याचं बिल भरलंय मी!"}, {"id": 9, "duration_s": 3.46, "emotion": "worried", "text": "दृष्ट लागली! नळाला दृष्ट लागली!"}, {"id": 10, "duration_s": 3.5, "emotion": "proud", "text": "विज्ञान सांगतं... नळ झोपलाय."}, {"id": 11, "duration_s": 2.7, "emotion": "excited", "text": "लाइव्ह सुरू आहे! सगळी कॉलनी कोरडी!"}, {"id": 12, "duration_s": 4.39, "emotion": "shouting", "text": "कुणी पाणी बंद केलं? मी कुणाला भीत नाही!"}, {"id": 13, "duration_s": 4.38, "emotion": "mischievous", "text": "आणि मग... अख्ख्या कॉलनीचं पाणी बंद!"}, {"id": 14, "duration_s": 2.36, "emotion": "shouting", "text": "टँकर आला! टँकर आला!"}, {"id": 15, "duration_s": 2.65, "emotion": "determined", "text": "वाट सोडा! साबणवाले काका येतायत!"}, {"id": 16, "duration_s": 3.75, "emotion": "proud", "text": "माझी बादली! इम्पोर्टेड! एक थेंबही कमी नाही!"}, {"id": 17, "duration_s": 2.47, "emotion": "happy", "text": "चला, निघूया! ड्रम भरून आणू!"}, {"id": 18, "duration_s": 2.26, "emotion": "sarcastic", "text": "एक मीटर. विक्रम!"}, {"id": 19, "duration_s": 2.79, "emotion": "shouting", "text": "घरटी दोन बादल्या! धक्को नको!"}, {"id": 20, "duration_s": 2.3, "emotion": "determined", "text": "बस्स! आता मी बघते."}, {"id": 21, "duration_s": 1.98, "emotion": "surprised", "text": "शेठ, ही बादली आसा?"}, {"id": 22, "duration_s": 1.88, "emotion": "mischievous", "text": "बादलीचा मोठा भाऊ!"}, {"id": 23, "duration_s": 2.31, "emotion": "stern_warning", "text": "धनाजी शेठ! अख्खी कॉलनी बघतेय!"}, {"id": 24, "duration_s": 1.5, "emotion": "sad", "text": "भूक लागलीय... तहानपण."}, {"id": 25, "duration_s": 2.25, "emotion": "calm", "text": "संपला! पुढचो टँकर... दुपारी."}, {"id": 26, "duration_s": 4.52, "emotion": "excited", "text": "ऐकलंत का? पुढचा टँकर... तीन दिवसांनी!"}, {"id": 27, "duration_s": 2.6, "emotion": "excited", "text": "हॅलो जोशी, ऐकलं? हॅलो देशपांडे, ऐकलं?"}, {"id": 28, "duration_s": 1.48, "emotion": "serious", "text": "कबुतरा, ऐकलं?"}, {"id": 29, "duration_s": 5.846, "emotion": "panicked", "text": "तीन दिवस? अरे देवा... तीन तासांत संपेल!"}, {"id": 30, "duration_s": 1.63, "emotion": "comic_panic", "text": "तीन तास? नाही... तीन मिनिटं! पळा!"}, {"id": 31, "duration_s": 4.11, "emotion": "mischievous", "text": "दुपारचा टँकर, तीन मिनिटांत तीन दिवसांचा झाला."}, {"id": 32, "duration_s": 2.66, "emotion": "mischievous", "text": "बाटली वीस रुपये! लवकर, भाव वाढणार!"}, {"id": 33, "duration_s": 4.981, "emotion": "mischievous", "text": "चाळीस! भाव हवामानासारखा, बदलतच राहतो."}, {"id": 34, "duration_s": 5.43, "emotion": "proud", "text": "बारा बाटल्या! एक आंघोळीला... अकरा पुन्हा आंघोळीला!"}, {"id": 35, "duration_s": 1.7, "emotion": "curious", "text": "एक बाटली किती?"}, {"id": 36, "duration_s": 1.44, "emotion": "proud", "text": "शंभ!"}, {"id": 37, "duration_s": 2.18, "emotion": "calm", "text": "मग राहू द्या. हवा फुकट आहे."}, {"id": 38, "duration_s": 3.68, "emotion": "mischievous", "text": "टेन्शन नको! सगळ्या बाटल्या मला द्या, मी दुप्पट भावात विकतो!"}, {"id": 39, "duration_s": 1.89, "emotion": "sarcastic", "text": "मी स्वतः तिप्पट भावात विकतोय."}, {"id": 40, "duration_s": 2.51, "emotion": "stern_warning", "text": "धनाजी!"}, {"id": 41, "duration_s": 2.25, "emotion": "embarrassed", "text": "वीस... वीसच होता, वीस!"}, {"id": 42, "duration_s": 3.12, "emotion": "excited", "text": "लाइव्ह सुरू आहे! पाणी सोन्यापेक्षा महाग!"}, {"id": 43, "duration_s": 3.86, "emotion": "proud", "text": "बारा बाटल्यांचं पाणी! आज राजासारखी आंघोळ करणार!"}, {"id": 44, "duration_s": 2.77, "emotion": "stern_warning", "text": "राजा नाही, प्रजेसारखी. एक तांब्या."}, {"id": 45, "duration_s": 2.31, "emotion": "pleading", "text": "अर्धा तांब्या? एवढ्या साबणाला?"}, {"id": 46, "duration_s": 3.61, "emotion": "proud", "text": "आमच्या काळात अर्ध्या तांब्यात वऱ्हाड आंघोळ करायचं!"}, {"id": 47, "duration_s": 4.18, "emotion": "proud", "text": "ठीक आहे! मी कुणाला भीत नाही! अर्धा तांब्या, चला!"}, {"id": 48, "duration_s": 3.2, "emotion": "determined", "text": "थांबा! जे पाणी सांडेल ते तुळशीला."}, {"id": 49, "duration_s": 3.11, "emotion": "surprised", "text": "बाबा, साबण सगळं पाणी प्याला!"}, {"id": 50, "duration_s": 4.507, "emotion": "stern_warning", "text": "दुसरा तांब्या? अख्खी कॉलनी बघेल!"}, {"id": 51, "duration_s": 0.45, "emotion": "shocked", "text": "शी... पाल!"}, {"id": 52, "duration_s": 3.52, "emotion": "embarrassed", "text": "मी भीत नाही... तिच्या तहानेला भितो."}, {"id": 53, "duration_s": 2.8, "emotion": "worried", "text": "सासूबाई, रात्री टाकी भरलेली!"}, {"id": 54, "duration_s": 1.89, "emotion": "curious", "text": "मग सकाळी गेलं कुठे?"}, {"id": 55, "duration_s": 2.29, "emotion": "excited", "text": "आयडिया! पाण्याचा गुप्तहेर!"}, {"id": 56, "duration_s": 2.46, "emotion": "excited", "text": "गुप्तहेर टीम, तयार?"}, {"id": 57, "duration_s": 1.66, "emotion": "stern_warning", "text": "श्श! गुप्तहेर बोलत नाहीत."}, {"id": 58, "duration_s": 3.72, "emotion": "serious", "text": "मी सांगू? पाण्याचा पाठलाग करा... चोर सापडेल!"}, {"id": 59, "duration_s": 0.54, "emotion": "serious", "text": "एक!"}, {"id": 60, "duration_s": 0.62, "emotion": "serious", "text": "दोन!"}, {"id": 61, "duration_s": 3.57, "emotion": "happy", "text": "हा टपकणारा नळ... सगळ्यात गोड आहे!"}, {"id": 62, "duration_s": 2.49, "emotion": "shocked", "text": "चौदा नळ गळतायत! चौदा!"}, {"id": 63, "duration_s": 2.77, "emotion": "mischievous", "text": "आणि या पाण्याची नदी... जाते कुठे?"}, {"id": 64, "duration_s": 5.69, "emotion": "proud", "text": "सोन्या कार वॉश! गाडी, स्कूटर, म्हैस... सगळं धुणार!"}, {"id": 65, "duration_s": 1.83, "emotion": "angry", "text": "गप्प! पाइप बंद कर!"}, {"id": 66, "duration_s": 4.64, "emotion": "mischievous", "text": "बंद? हा धंदा आहे! पाणी फुकट, कमाई पूर्ण!"}, {"id": 67, "duration_s": 3.39, "emotion": "serious", "text": "मी सांगू? हा पाइप पहाटे पाचपासून चालू आहे."}, {"id": 68, "duration_s": 1.79, "emotion": "shocked", "text": "म्हणूनच आपली टाकी रिकामी!"}, {"id": 69, "duration_s": 3.26, "emotion": "calm", "text": "टेन्शन नको! पाणी माझं नाही, कॉलनीचं आहे!"}, {"id": 70, "duration_s": 1.35, "emotion": "angry", "text": "तेच तर टेन्शन आहे!"}, {"id": 71, "duration_s": 3.35, "emotion": "shouting", "text": "चौकशी होणार! कोण?"}, {"id": 72, "duration_s": 4.42, "emotion": "proud", "text": "विज्ञान सांगतं... हवा अधिक पाणी बरोबर पाऊस!"}, {"id": 73, "duration_s": 1.41, "emotion": "stern_warning", "text": "गप्प! बघू या."}, {"id": 74, "duration_s": 2.7, "emotion": "excited", "text": "लाइव्ह सुरू आहे! कॉलनीचा पहिला पाऊस!"}, {"id": 75, "duration_s": 3.3, "emotion": "proud", "text": "विज्ञान सांगतं... पाऊस फक्त शास्त्रज्ञांवर पडतो."}, {"id": 76, "duration_s": 5.02, "emotion": "sad", "text": "हरीशची आंघोळ झाली? मी अजून साबणातच!"}, {"id": 77, "duration_s": 2.55, "emotion": "laughing", "text": "<laugh> अख्खी कॉलनी बघेल... हरीशची आंघोळ!"}, {"id": 78, "duration_s": 3.01, "emotion": "sarcastic", "text": "आणखी एक बादली गेली. पंधरावा नळ!"}, {"id": 79, "duration_s": 2.82, "emotion": "embarrassed", "text": "बस्स... थोडं कॅलिब्रेशन बाकी आहे."}, {"id": 80, "duration_s": 2.24, "emotion": "panicked", "text": "ऐकलं? लास्ट टँकर!"}, {"id": 81, "duration_s": 4.03, "emotion": "excited", "text": "सुरू झाली... कॉलनीची सगळ्यात मोठी बादली शर्यत!"}, {"id": 82, "duration_s": 1.79, "emotion": "determined", "text": "यावेळी पहिली बादली माझी!"}, {"id": 83, "duration_s": 1.21, "emotion": "excited", "text": "चला, निघूया!"}, {"id": 84, "duration_s": 1.96, "emotion": "sad", "text": "अरे... आजही?"}, {"id": 85, "duration_s": 3.0, "emotion": "curious", "text": "कोणी सांगेल का... मी कुठे आहे?"}, {"id": 86, "duration_s": 1.2, "emotion": "angry", "text": "बादलीवरून उतरा!"}, {"id": 87, "duration_s": 3.36, "emotion": "sarcastic", "text": "ही बादली नाही... मोठा भाऊ आहे!"}, {"id": 88, "duration_s": 6.22, "emotion": "shouting", "text": "चौकशी होणार! थांबा! नाही, चला! नाही, थांबा!"}, {"id": 89, "duration_s": 3.59, "emotion": "excited", "text": "लाइव्ह! बादली जाम, शंभर मीटर लांब!"}, {"id": 90, "duration_s": 3.47, "emotion": "angry", "text": "अख्खी कॉलनी बघतेय... आणि कोणी हलत नाही!"}, {"id": 91, "duration_s": 1.83, "emotion": "excited", "text": "कबुतरा, ऐकलं...? अरे!"}, {"id": 92, "duration_s": 0.66, "emotion": "shouting", "text": "गप्प!!!"}, {"id": 93, "duration_s": 3.28, "emotion": "serious", "text": "पाण्यासाठी भांडण... आणि नळ अजून गळतायत!"}, {"id": 94, "duration_s": 1.81, "emotion": "determined", "text": "मी सांगू? हिशोब बघा!"}, {"id": 95, "duration_s": 3.52, "emotion": "stern_warning", "text": "शांतता! आजचा तास... पाणी!"}, {"id": 96, "duration_s": 4.4, "emotion": "serious", "text": "मी सांगू? एक गळका नळ, दर सेकंदाला एक थेंब."}, {"id": 97, "duration_s": 2.32, "emotion": "excited", "text": "बुंदी? कुठे आहे बुंदी?"}, {"id": 98, "duration_s": 2.38, "emotion": "sarcastic", "text": "बुंदी नाही, थेंब!"}, {"id": 99, "duration_s": 2.13, "emotion": "proud", "text": "एक नळ, एक महिना... साठ बादल्या!"}, {"id": 100, "duration_s": 3.17, "emotion": "shocked", "text": "<gasp> साठ? अरे देवा!"}, {"id": 101, "duration_s": 1.32, "emotion": "shocked", "text": "चौदा गुणिले साठ... आठशे चाळीस बादल्या!"}, {"id": 102, "duration_s": 9.45, "emotion": "mischievous", "text": "एवढ्या बाटल्या विकल्या तर..."}, {"id": 103, "duration_s": 1.18, "emotion": "stern_warning", "text": "धनाजी!"}, {"id": 104, "duration_s": 3.9, "emotion": "serious", "text": "आणि सोन्या काकांचा पाइप... तासाला पन्नास बादल्या!"}, {"id": 105, "duration_s": 2.35, "emotion": "embarrassed", "text": "टेन्शन... थोडं थोडं येतंय."}, {"id": 106, "duration_s": 3.76, "emotion": "calm", "text": "ताई, लाईनना दुरुस्ती शे. संध्याकाळपावतर पाणी येई."}, {"id": 107, "duration_s": 2.42, "emotion": "embarrassed", "text": "संध्याकाळी? तीन दिवस नाही?"}, {"id": 108, "duration_s": 1.19, "emotion": "sarcastic", "text": "तीन दिन कोणी सांगी?"}, {"id": 109, "duration_s": 4.61, "emotion": "guilty", "text": "म्हणजे पाणी बंद नव्हतं झालं... आपणच वाहून दिलं!"}, {"id": 110, "duration_s": 3.29, "emotion": "serious", "text": "चौदा नळ, एक पाइप, एक बाथटब..."}, {"id": 111, "duration_s": 2.33, "emotion": "mischievous", "text": "आणि एक साबणवाले बाबा!"}, {"id": 112, "duration_s": 2.46, "emotion": "determined", "text": "बस्स! आता आपण सगळे बघू."}, {"id": 113, "duration_s": 1.02, "emotion": "determined", "text": "दहा सेकंद."}, {"id": 114, "duration_s": 3.28, "emotion": "proud", "text": "नऊ सेकंद! अख्खी कॉलनी बघेल!"}, {"id": 115, "duration_s": 2.08, "emotion": "proud", "text": "हे तर माझ्या डाव्या हाताचं काम!"}, {"id": 116, "duration_s": 3.58, "emotion": "relieved", "text": "आह... आंघोळ झाली! शेवटी!"}, {"id": 117, "duration_s": 1.71, "emotion": "excited", "text": "ऐकलं? गणपत न्हाला!"}, {"id": 118, "duration_s": 3.16, "emotion": "happy", "text": "एक बादली, एक कापड... गाडी चकाचक!"}, {"id": 119, "duration_s": 2.2, "emotion": "laughing", "text": "<laugh> म्हैसपण! बादलीने!"}, {"id": 120, "duration_s": 3.84, "emotion": "proud", "text": "गळका थेंबही माझाच! एकही थेंब वाया नाही!"}, {"id": 121, "duration_s": 4.65, "emotion": "proud", "text": "विज्ञान सांगतं... गळका नळ दुरुस्त करा."}, {"id": 122, "duration_s": 2.78, "emotion": "surprised", "text": "हरीशदादा... पहिल्यांदा बरोबर!"}, {"id": 123, "duration_s": 1.14, "emotion": "sad", "text": "गोड नळ... रिटायर झाला."}, {"id": 124, "duration_s": 2.16, "emotion": "happy", "text": "छपराचं पाणी थेट ड्रमात!"}, {"id": 125, "duration_s": 2.96, "emotion": "loving", "text": "आता पावसाला दृष्ट लागणार नाही."}, {"id": 126, "duration_s": 2.79, "emotion": "excited", "text": "लाइव्ह सुरू आहे! हॅशटॅग थेंब वाचवा!"}, {"id": 127, "duration_s": 5.47, "emotion": "happy", "text": "त्या दिवशी चौदा नळ दुरुस्त झाले... आणि एक बाबा आंघोळले."}, {"id": 128, "duration_s": 3.71, "emotion": "calm", "text": "संध्याकाळ झाली... आणि नळांना पुन्हा पाणी आलं."}, {"id": 129, "duration_s": 3.28, "emotion": "proud", "text": "आज गणपत जोशी... एका बादलीत न्हाणार!"}, {"id": 130, "duration_s": 0.88, "emotion": "stern_warning", "text": "अर्धी."}, {"id": 131, "duration_s": 2.12, "emotion": "calm", "text": "थेंबे थेंबे तळे साचे..."}, {"id": 132, "duration_s": 3.1, "emotion": "serious", "text": "...आणि थेंबे थेंबे तळे आटतेही."}, {"id": 133, "duration_s": 3.46, "emotion": "serious", "text": "गळका नळ आजच दुरुस्त करा... उद्या नाही."}, {"id": 134, "duration_s": 4.21, "emotion": "calm", "text": "आणि आभाळाचं पाणी... ड्रममध्ये."}, {"id": 135, "duration_s": 1.4, "emotion": "determined", "text": "गाडी बादलीने!"}, {"id": 136, "duration_s": 1.1, "emotion": "determined", "text": "पाइप मोकळा नाही!"}, {"id": 137, "duration_s": 3.04, "emotion": "proud", "text": "आणि पावसाचं पाणी... छपरावर!"}, {"id": 138, "duration_s": 1.18, "emotion": "excited", "text": "पाऊस!"}, {"id": 139, "duration_s": 3.23, "emotion": "excited", "text": "फुकटचा शॉवर! देवा, चालू करा!"}]