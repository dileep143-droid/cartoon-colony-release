[{"id": 1, "duration_s": 3.73, "emotion": "mischievous", "text": "ದೀಪಾವಳಿ ರಾತ್ರಿ. ಇಡೀ ಬಡಾವಣೆ ಝಗಮಗ..."}, {"id": 2, "duration_s": 2.85, "emotion": "sarcastic", "text": "...ಆದ್ರೆ ಎಲ್ರೂ ಒಂದೇ ಸಾಲಲ್ಲಿ!"}, {"id": 3, "duration_s": 3.11, "emotion": "comic_panic", "text": "ಕೇಳಿದ್ಯಾ? ನನ್ ಹೊಟ್ಟೆಲಿ ಪಟಾಕಿ ಸಿಡೀತಿದೆ!"}, {"id": 4, "duration_s": 3.07, "emotion": "worried", "text": "ದೃಷ್ಟಿ ಆಯ್ತು! ಬಾತ್ರೂಮಿಗೇ ದೃಷ್ಟಿ ಆಯ್ತು!"}, {"id": 5, "duration_s": 3.16, "emotion": "determined", "text": "ಹೊಟ್ಟೆ ನೋವು... ಆದ್ರೂ ಹಸಿವಾಗ್ತಿದೆ!"}, {"id": 6, "duration_s": 2.12, "emotion": "comic_panic", "text": "ಒಳಗೆ ಯಾರು? ಬೇಗ ಬನ್ನಿ!"}, {"id": 7, "duration_s": 1.11, "emotion": "calm", "text": "ಟೆನ್ಷನ್ ಬೇಡ!"}, {"id": 8, "duration_s": 3.09, "emotion": "calm", "text": "ಇದೆಲ್ಲ ಶುರುವಾಗಿದ್ದು... ಮೂರು ದಿನದ ಹಿಂದೆ."}, {"id": 9, "duration_s": 2.46, "emotion": "mischievous", "text": "ತುಂಬಾ ಹೊಳೆಯೋ ಒಂದು ಸಿಹಿಯಿಂದ."}, {"id": 10, "duration_s": 3.62, "emotion": "happy", "text": "ದೀಪಾವಳಿ ವಾರ. ಇಡೀ ಬಡಾವಣೆ ಅಲಂಕಾರ!"}, {"id": 11, "duration_s": 3.52, "emotion": "proud", "text": "ಮೆಗಾ ಸೇಲ್! ಕಾಜು ಕತ್ಲಿ ಅರ್ಧ ರೇಟು!"}, {"id": 12, "duration_s": 2.3, "emotion": "excited", "text": "ಹೊಳೆಯೋ ಸಿಹಿ! ಹಸಿವಾಗ್ತಿದೆ!"}, {"id": 13, "duration_s": 4.95, "emotion": "mischievous", "text": "ದಾಸಪ್ಪಣ್ಣಾರ, ಇನ್ನೂರ ಡಬ್ಬಿ, ಅರ್ಧ ರೇಟು, ಖರೇ ಬೆಳ್ಳಿ ಐತಿ!"}, {"id": 14, "duration_s": 2.24, "emotion": "excited", "text": "ಅಗ್ಗದ ಮಾಲು, ದಪ್ಪ ಲಾಭ!"}, {"id": 15, "duration_s": 3.72, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪ! ಅರ್ಧ ರೇಟಿಗೆ ಅಸಲಿ ಬೆಳ್ಳಿ?"}, {"id": 16, "duration_s": 2.8, "emotion": "proud", "text": "ಭಾಗ್ಯ, ಇದು ಹಬ್ಬದ ಕೃಪೆ!"}, {"id": 17, "duration_s": 0.87, "emotion": "excited", "text": "ಐಡಿಯಾ ಇದೆ!"}, {"id": 18, "duration_s": 3.73, "emotion": "excited", "text": "ಗೌರಜ್ಜಿ! ಸರಸುಗಿಂತ ದೊಡ್ಡ ತಟ್ಟೆ... ಅರ್ಧಕ್ಕೆ!"}, {"id": 19, "duration_s": 3.55, "emotion": "mischievous", "text": "ಈ ಸಲ ನನ್ ತಟ್ಟೆ... ಇಡೀ ಬಡಾವಣೆ ನೋಡ್ಬೇಕು!"}, {"id": 20, "duration_s": 4.2, "emotion": "serious", "text": "ಅತ್ತೆ, ಅರ್ಧ ರೇಟಿಗೆ ಕಾಜು ಕತ್ಲಿ? ಏನೋ ಗೋಲ್ಮಾಲ್ ಇದೆ."}, {"id": 21, "duration_s": 2.44, "emotion": "proud", "text": "ಗೋಲ್ಮಾಲ್ ಅಲ್ಲ, ಉಳಿತಾಯ!"}, {"id": 22, "duration_s": 2.95, "emotion": "mischievous", "text": "ಹಾಗೆ ಶುರುವಾಯ್ತು... ತಟ್ಟೆ ಯುದ್ಧ!"}, {"id": 23, "duration_s": 3.21, "emotion": "proud", "text": "ಐದು ಡಬ್ಬಿ! ಎಲ್ಲಕ್ಕಿಂತ ದೊಡ್ಡದು!"}, {"id": 24, "duration_s": 1.8, "emotion": "proud", "text": "ಒಂದ್ರೂಪಾಯಿ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 25, "duration_s": 3.36, "emotion": "shocked", "text": "ಕೇಳಿದ್ಯಾ? ಗೌರಮ್ಮಂಗೆ ಐದು ಡಬ್ಬಿ!"}, {"id": 26, "duration_s": 2.07, "emotion": "proud", "text": "ಆರು ಡಬ್ಬಿ, ದಾಸಪ್ಪ! ಆರು!"}, {"id": 27, "duration_s": 0.79, "emotion": "determined", "text": "ಏಳು!"}, {"id": 28, "duration_s": 2.25, "emotion": "excited", "text": "ಟೆನ್ಷನ್ ಬೇಡ! ಸೀನನ ಹ್ಯಾಂಪರ್!"}, {"id": 29, "duration_s": 2.26, "emotion": "mischievous", "text": "ಡಬಲ್ ರೇಟು ಆಂಟಿ... ಡಬಲ್ ಗೌರವ!"}, {"id": 30, "duration_s": 2.89, "emotion": "worried", "text": "ಇಷ್ಟೊಂದು ಸಿಹಿ! ದೃಷ್ಟಿ ಆಗುತ್ತೆ!"}, {"id": 31, "duration_s": 2.05, "emotion": "proud", "text": "ಇಡೀ ಬಡಾವಣೆ ನೋಡ್ಬೇಕು!"}, {"id": 32, "duration_s": 2.49, "emotion": "proud", "text": "ಯಾರಿಗೂ ಹೆದರಲ್ಲ! ಸರಸು ಆಂಟಿಗೂ ಇಲ್ಲ!"}, {"id": 33, "duration_s": 2.91, "emotion": "curious", "text": "ಅರ್ಧ ರೇಟಿಗೆ ಬೆಳ್ಳಿ? ನಂಗೆ ಅನುಮಾನ."}, {"id": 34, "duration_s": 2.06, "emotion": "sarcastic", "text": "ದೊಡ್ಡವರಿಗೆ ಯಾರು ಹೇಳೋದು?"}, {"id": 35, "duration_s": 5.22, "emotion": "giggly", "text": "ಸ್ಕೋರ್? ಹನ್ನೆರಡು-ಹನ್ನೆರಡು. ಆರ್‌ಸಿಬಿ ಸಿಎಸ್‌ಕೆ ಟೈ!"}, {"id": 36, "duration_s": 3.76, "emotion": "stern_warning", "text": "ಬೊಂಡಾ, ನೀನು ಕಾವಲುಗಾರ. ಒಂದು ತುಂಡೂ ಮುಟ್ಟಬಾರ್ದು!"}, {"id": 37, "duration_s": 1.14, "emotion": "determined", "text": "ಒಂದು ತುಂಡೂ ಇಲ್ಲ!"}, {"id": 38, "duration_s": 2.54, "emotion": "proud", "text": "ನನ್ ರಂಗೋಲಿ ದೊಡ್ಡದು."}, {"id": 39, "duration_s": 2.14, "emotion": "sarcastic", "text": "ನನ್ ರಂಗೋಲಿಲಿ ಬಣ್ಣ ಜಾಸ್ತಿ."}, {"id": 40, "duration_s": 3.5, "emotion": "serious", "text": "ತನಿಖೆ ಆಗ್ಬೇಕು! ಸಿಹಿ ಸುರಕ್ಷೆಗೆ!"}, {"id": 41, "duration_s": 0.74, "emotion": "excited", "text": "ಸಿಹಿ?"}, {"id": 42, "duration_s": 1.2, "emotion": "happy", "text": "ಚೆಕ್ ಮುಗೀತು."}, {"id": 43, "duration_s": 2.28, "emotion": "shocked", "text": "ಬೊಂಡಾ! ತಟ್ಟೆಗಳೆಲ್ಲಿ?"}, {"id": 44, "duration_s": 2.52, "emotion": "guilty", "text": "ಅದು... ದೃಷ್ಟಿ ಆಯ್ತು!"}, {"id": 45, "duration_s": 1.9, "emotion": "excited", "text": "ನೋಡ್ದ್ಯಾ! ಹೇಳಿದ್ದೆ ನಾನು!"}, {"id": 46, "duration_s": 2.01, "emotion": "excited", "text": "ಹ್ಯಾಂಪರ್ ತಗೊಳ್ಳಿ! ಇಡೀ ಬಡಾವಣೆಗೆ!"}, {"id": 47, "duration_s": 3.88, "emotion": "serious", "text": "ಈಗ ದಾಸಪ್ಪನ ಸಿಹಿ... ಮನೆ ಮನೆ ತಲುಪಿತ್ತು."}, {"id": 48, "duration_s": 2.19, "emotion": "excited", "text": "ಹಾಯ್ ಗಾಯ್ಸ್! ಲೈವ್ ಇದೆ!"}, {"id": 49, "duration_s": 2.94, "emotion": "sarcastic", "text": "ಇಷ್ಟು ಹಸಿರು... ಎಲೆಗೂ ಇರಲ್ಲ."}, {"id": 50, "duration_s": 4.34, "emotion": "excited", "text": "ಸಿಹಿ ಮುಕ್‌ಬ್ಯಾಂಗ್! ಇವತ್ತಿನ ಬರ್ಫಿ... ನಿಯಾನ್ ಹಸಿರು!"}, {"id": 51, "duration_s": 3.95, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ... ಬಣ್ಣ ಜಾಸ್ತಿ, ವಿಟಮಿನ್ ಜಾಸ್ತಿ!"}, {"id": 52, "duration_s": 1.84, "emotion": "happy", "text": "ಕೇಳಿದ್ರಾ ಗಾಯ್ಸ್? ಹೆಲ್ತಿ!"}, {"id": 53, "duration_s": 4.53, "emotion": "serious", "text": "ಹಸಿರು ನಾಲಿಗೆ? ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ... ಇದು ಹಸಿರುತನ."}, {"id": 54, "duration_s": 3.2, "emotion": "shocked", "text": "ಗಾಯ್ಸ್, ನಾಲಿಗೆ ನೀಲಿ! ಹೊಸ ಫಿಲ್ಟರಾ?"}, {"id": 55, "duration_s": 2.45, "emotion": "embarrassed", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ... ಇದು ನೋವು."}, {"id": 56, "duration_s": 3.53, "emotion": "proud", "text": "ಎರಡು ಲಕ್ಷ ವ್ಯೂಸ್! ಎಲ್ರೂ ನೀಲಿ ಬರ್ಫಿ ತಿನ್ನಿ!"}, {"id": 57, "duration_s": 3.7, "emotion": "happy", "text": "ದೀಪಾವಳಿ ಸಂಜೆ. ಗೌರಮ್ಮನ ಸಿಹಿ ಪಾರ್ಟಿ!"}, {"id": 58, "duration_s": 4.33, "emotion": "proud", "text": "ಬನ್ನಿ ಬನ್ನಿ! ಇಡೀ ಬಡಾವಣೆ ನೋಡ್ಲಿ... ತಿನ್ಲಿ!"}, {"id": 59, "duration_s": 2.91, "emotion": "sarcastic", "text": "ಗೌರಮ್ಮ, ನಿಮ್ ಕತ್ಲಿ ಯಾಕಿಷ್ಟು ಹೊಳೆಯುತ್ತೆ?"}, {"id": 60, "duration_s": 3.0, "emotion": "proud", "text": "ಅಸಲಿ ಬೆಳ್ಳಿ! ಅರ್ಧ ರೇಟಿನದು!"}, {"id": 61, "duration_s": 0.76, "emotion": "proud", "text": "ನಂದೂ!"}, {"id": 62, "duration_s": 2.55, "emotion": "curious", "text": "ಮೇಷ್ಟ್ರೇ, ಈ ಸಿಹಿ ಅಸಲಿ?"}, {"id": 63, "duration_s": 3.34, "emotion": "happy", "text": "ಗಿಳಿ ಹಸಿರಾ? ಹೌದೌದು, ತುಂಬಾ ಚೆಂದ!"}, {"id": 64, "duration_s": 2.73, "emotion": "shocked", "text": "ಗಿಳಿ ಅಲ್ಲ ಮೇಷ್ಟ್ರೇ... ಸಿಹಿ!"}, {"id": 65, "duration_s": 3.77, "emotion": "excited", "text": "ಗಿಳಿಯೂ ಹಸಿರು, ಬರ್ಫಿಯೂ ಹಸಿರು! ವಾಹ್!"}, {"id": 66, "duration_s": 3.91, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ... ಹೊಳಪು ಅಂದ್ರೆ ತಾಜಾತನ!"}, {"id": 67, "duration_s": 1.92, "emotion": "proud", "text": "ನಂಗೆ ಯಾವ ಸಿಹಿಗೂ ಹೆದರಲ್ಲ!"}, {"id": 68, "duration_s": 3.33, "emotion": "happy", "text": "ಮೋಡ ಗುಡುಗ್ತಿದೆಯಾ? ದೀಪಾವಳಿಗೆ ಮಳೆ!"}, {"id": 69, "duration_s": 3.06, "emotion": "comic_panic", "text": "ಕೇಳಿದ್ಯಾ? ನನ್ ಹೊಟ್ಟೆನೂ ಏನೋ ಹೇಳ್ತಿದೆ!"}, {"id": 70, "duration_s": 4.11, "emotion": "giggly", "text": "ಆಮೇಲೆ... ಇಡೀ ಬಡಾವಣೆ ಹೊಟ್ಟೆ ಒಟ್ಟಿಗೇ ಮಾತಾಡ್ತು."}, {"id": 71, "duration_s": 3.07, "emotion": "sarcastic", "text": "ಹದಿನಾಲ್ಕು ಜನ. ಒಂದೇ ಬಾತ್ರೂಮ್."}, {"id": 72, "duration_s": 3.14, "emotion": "comic_panic", "text": "ಯಾರಿಗೂ ಹೆದರಲ್ಲ... ಆದ್ರೆ ಬೇಗ!"}, {"id": 73, "duration_s": 2.07, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪ! ಸಾಲಲ್ಲಿ!"}, {"id": 74, "duration_s": 2.65, "emotion": "pleading", "text": "ಹೋಗೋಕೆ... ಎರಡ್ರೂಪಾಯಿ ಕೊಡ್ಲಾ?"}, {"id": 75, "duration_s": 4.93, "emotion": "sarcastic", "text": "ಸರಸು, ನಿನ್ ಹೊಟ್ಟೆ... ನನ್ದಕ್ಕಿಂತ ಜೋರಾಗಿ ಮಾತಾಡುತ್ತೆ."}, {"id": 76, "duration_s": 1.9, "emotion": "comic_panic", "text": "ಲೈವ್ ಇದೆ... ಬಾತ್ರೂಮ್ ಸಾಲಿಂದ!"}, {"id": 77, "duration_s": 2.03, "emotion": "determined", "text": "ಸಾಕು! ಈಗ ನಾನು ನೋಡ್ತೀನಿ."}, {"id": 78, "duration_s": 3.92, "emotion": "serious", "text": "ಒಂದು ಲೀಟರ್ ಕುದಿಸಿ ಆರಿಸಿದ ನೀರು, ಆರು ಚಮಚ ಸಕ್ಕರೆ..."}, {"id": 79, "duration_s": 3.18, "emotion": "serious", "text": "...ಅರ್ಧ ಚಮಚ ಉಪ್ಪು. ಗುಟುಕು ಗುಟುಕಾಗಿ ಕುಡಿ."}, {"id": 80, "duration_s": 3.86, "emotion": "worried", "text": "ಎರಡು ನಿಂಬೆ ಸಾಲ್ದು... ಇದು ಮೂರನೇದು!"}, {"id": 81, "duration_s": 5.0, "emotion": "calm", "text": "ಎರಡೇ ನಿಮಿಷ... ಟೆನ್ಷನ್ ಬೇಡ!"}, {"id": 82, "duration_s": 2.58, "emotion": "crying", "text": "ಸೀನ, ನಿನ್ ಎರಡು ನಿಮಿಷ... ದೀಪಾವಳಿಗಿಂತ ಉದ್ದ!"}, {"id": 83, "duration_s": 1.98, "emotion": "guilty", "text": "ಕೊನೇದು... ಖಂಡಿತ."}, {"id": 84, "duration_s": 5.17, "emotion": "determined", "text": "ಔಷಧಿ ಅಂಗಡಿ! ನಡೀರಿ, ಹೋಗೋಣ!"}, {"id": 85, "duration_s": 4.52, "emotion": "tired", "text": "ತನಿಖೆ... ನಡ್ಕೊಂಡು."}, {"id": 86, "duration_s": 3.25, "emotion": "curious", "text": "ಎಲ್ರ ಹೊಟ್ಟೆ ಕೆಟ್ಟಿದೆ... ನಾವ್ ಮೂರೂ ಜನ ಹೇಗೆ ಸರಿ?"}, {"id": 87, "duration_s": 2.84, "emotion": "proud", "text": "ಯಾಕಂದ್ರೆ ನಾವು ಕಾವೇರಿ ಆಂಟಿ ಮನೆ ಲಡ್ಡು ತಿಂದ್ವಿ!"}, {"id": 88, "duration_s": 3.34, "emotion": "determined", "text": "ಇದೇ ಸಾಕ್ಷಿ. ನಾಳೆ ಬೆಳಗ್ಗೆ... ಸೈನ್ಸ್ ಟೆಸ್ಟ್!"}, {"id": 89, "duration_s": 4.23, "emotion": "sarcastic", "text": "ಆ ರಾತ್ರಿ ಪಟಾಕಿ ಕಮ್ಮಿ ಸಿಡೀತು... ಹೊಟ್ಟೆ ಜಾಸ್ತಿ."}, {"id": 90, "duration_s": 2.49, "emotion": "curious", "text": "ಮರುದಿನ ಬೆಳಗ್ಗೆ. ಚಿನ್ನುವಿನ ಲ್ಯಾಬ್."}, {"id": 91, "duration_s": 2.73, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ... ಹೊಳಪು ಅಂದ್ರೆ ತಾಜಾ!"}, {"id": 92, "duration_s": 1.43, "emotion": "angry", "text": "ನನ್ ಸಿಹಿ ಅಸಲಿ!"}, {"id": 93, "duration_s": 1.51, "emotion": "angry", "text": "ನಂದು ಇನ್ನೂ ಅಸಲಿ!"}, {"id": 94, "duration_s": 2.34, "emotion": "shouting", "text": "ಸುಮ್ನಿರಿ! ಚಿನ್ನು ಮಾತಾಡ್ತಿದ್ದಾನೆ!"}, {"id": 95, "duration_s": 3.3, "emotion": "proud", "text": "ನಾನು ಹೇಳ್ಲಾ? ಶಾಲೆ ಟೆಸ್ಟ್."}, {"id": 96, "duration_s": 3.44, "emotion": "stern_warning", "text": "ಅಯೋಡಿನ್ ಗಾಯಕ್ಕೆ ಔಷಧಿ. ತಿನ್ನೋದಕ್ಕಲ್ಲ!"}, {"id": 97, "duration_s": 3.85, "emotion": "serious", "text": "ನೀಲಿ-ಕಪ್ಪು ಅಂದ್ರೆ ಪಿಷ್ಟ. ಮೈದಾ ಅಥವಾ ಅರಾರೋಟ್ ಬೆರೆಸಿದ್ದಾರೆ!"}, {"id": 98, "duration_s": 3.33, "emotion": "serious", "text": "ಅಸಲಿ ಖೋವಾದಲ್ಲಿ ಪಿಷ್ಟ ಇಲ್ಲ... ಬಣ್ಣ ಕಂದೇ ಇರುತ್ತೆ."}, {"id": 99, "duration_s": 2.9, "emotion": "serious", "text": "ಅಸಲಿ ಬೆಳ್ಳಿ ವರ್ಕ್... ಉಜ್ಜಿದ್ರೆ ಪುಡಿ ಆಗುತ್ತೆ."}, {"id": 100, "duration_s": 3.88, "emotion": "stern_warning", "text": "ಇದು ಅಂಟ್ಕೊಂಡಿದೆ, ಹೊಳೆಯುತ್ತಲೇ ಇದೆ... ನಕಲಿ ಹಾಳೆ!"}, {"id": 101, "duration_s": 1.63, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ..."}, {"id": 102, "duration_s": 0.84, "emotion": "stern_warning", "text": "ಸುಮ್ನಿರು!"}, {"id": 103, "duration_s": 2.65, "emotion": "serious", "text": "ಇಷ್ಟು ಗಾಢ ಬಣ್ಣ? ಅಪಾಯದ ಘಂಟೆ."}, {"id": 104, "duration_s": 2.03, "emotion": "stern_warning", "text": "ಟೆಸ್ಟ್ ಸಿಹಿ... ತಿನ್ನೋದು ಬೇಡ!"}, {"id": 105, "duration_s": 3.74, "emotion": "proud", "text": "ಶಾಬಾಸ್ ಚಿನ್ನು! ಟೆಸ್ಟ್ ತುಂಡುಗಳು ಕಸದ ಡಬ್ಬಿಗೆ."}, {"id": 106, "duration_s": 4.14, "emotion": "embarrassed", "text": "ಮತ್ತೆ ನಾನು... ಗಿಳಿ ಅಂತ ತಿಂತಾನೇ ಇದ್ದೆ."}, {"id": 107, "duration_s": 3.7, "emotion": "serious", "text": "ಗೊತ್ತಿರೋ ಅಂಗಡಿ, ಡಬ್ಬಿ ಮೇಲೆ ದಿನಾಂಕ, ಲೈಸೆನ್ಸ್."}, {"id": 108, "duration_s": 3.98, "emotion": "guilty", "text": "ನಾನಂತೂ... ಸರಸುಗಿಂತ ದೊಡ್ಡ ತಟ್ಟೆ ನೋಡ್ತಿದ್ದೆ ಅಷ್ಟೇ."}, {"id": 109, "duration_s": 2.548, "emotion": "determined", "text": "ಬನ್ನಿ! ದಾಸಪ್ಪನಂಗಡಿ!"}, {"id": 110, "duration_s": 3.21, "emotion": "mischievous", "text": "ಇಡೀ ಬಡಾವಣೆ... ದಾಸಪ್ಪನಂಗ್ಡಿಗೆ!"}, {"id": 111, "duration_s": 4.04, "emotion": "comic_panic", "text": "ಹಲೋ! ನಿಮ್ ಅಸಲಿ ಬೆಳ್ಳಿ... ನಕಲಿ ಆಯ್ತು!"}, {"id": 112, "duration_s": 4.096, "emotion": "mischievous", "text": "ಯಾರ ಸೇಟ? ರಾಂಗ್ ನಂಬರ್ ಐತಿ!"}, {"id": 113, "duration_s": 3.93, "emotion": "sad", "text": "ನಂಗೂ ಮೋಸ... ಅತಿ ಆಸೆ ಗತಿಗೇಡು!"}, {"id": 114, "duration_s": 4.26, "emotion": "stern_warning", "text": "ದಾಸಪ್ಪ! ಪ್ರತಿ ಡಬ್ಬಿ ವಾಪಸ್. ಪ್ರತಿ ರೂಪಾಯಿ ವಾಪಸ್."}, {"id": 115, "duration_s": 2.86, "emotion": "pleading", "text": "ಭಾಗ್ಯ... ಸ್ವಲ್ಪ ಕಮ್ಮಿ?"}, {"id": 116, "duration_s": 1.31, "emotion": "angry", "text": "ಒಂದ್ರೂಪಾಯಿ ಕಮ್ಮಿ ಇಲ್ಲ!"}, {"id": 117, "duration_s": 3.83, "emotion": "crying", "text": "ವಿದಾಯ... ನನ್ ಪ್ರೀತಿಯ ನಾಣ್ಯಗಳೇ."}, {"id": 118, "duration_s": 1.59, "emotion": "mischievous", "text": "ಟೆನ್ಷನ್ ಬೇಡ... ನಾ ಹೊರಟೆ."}, {"id": 119, "duration_s": 3.502, "emotion": "sarcastic", "text": "ಡಬಲ್ ರೇಟು ತಗೊಂಡಿದ್ದೆ... ಡಬಲ್ ವಾಪಸ್ ಕೊಡು."}, {"id": 120, "duration_s": 2.87, "emotion": "sad", "text": "ಮೆಗಾ ಸೇಲ್... ಮೆಗಾ ಫೇಲ್."}, {"id": 121, "duration_s": 2.69, "emotion": "happy", "text": "ಈ ಸಲ ಸಿಹಿ... ಮನೇಲೇ ಮಾಡ್ತಾರೆ!"}, {"id": 122, "duration_s": 4.1, "emotion": "happy", "text": "ಕಡ್ಲೆಹಿಟ್ಟು, ತುಪ್ಪ, ಸಕ್ಕರೆ... ಅಷ್ಟೇ! ಇನ್ನೇನೂ ಇಲ್ಲ."}, {"id": 123, "duration_s": 2.79, "emotion": "loving", "text": "ಗೌರಮ್ಮ, ನನ್ ತೆಂಗಿನಕಾಯಿ ಬರ್ಫಿ... ಮನೇದು."}, {"id": 124, "duration_s": 2.46, "emotion": "happy", "text": "ಈ ಸಲ ತಟ್ಟೆ ಒಂದೇ... ಇಬ್ಬರದೂ!"}, {"id": 125, "duration_s": 2.33, "emotion": "giggly", "text": "ಕೇಳಿದ್ಯಾ? ನಮ್ಮ ಗೆಳೆತನ ಆಯ್ತು!"}, {"id": 126, "duration_s": 2.83, "emotion": "excited", "text": "ಐಡಿಯಾ ಇದೆ! ಅತಿ ದೊಡ್ಡ ಲಡ್ಡು!"}, {"id": 127, "duration_s": 1.87, "emotion": "sarcastic", "text": "ಸುಮ್ನಿರು! ಗುಂಡಗೆ ಮಾಡು."}, {"id": 128, "duration_s": 3.05, "emotion": "giggly", "text": "ಬೊಂಡಾ, ಇವತ್ತಿಂದ ನೀನು... ಟೇಸ್ಟರ್!"}, {"id": 129, "duration_s": 2.43, "emotion": "excited", "text": "ಈ ಕೆಲಸ... ನನಗೇ ಹೇಳಿ ಮಾಡಿಸಿದ್ದು!"}, {"id": 130, "duration_s": 2.24, "emotion": "proud", "text": "ಕ್ವಾಲಿಟಿ ಚೆಕ್... ನಡೀತಿದೆ."}, {"id": 131, "duration_s": 4.69, "emotion": "happy", "text": "ಆಮೇಲೆ ಬಂತು... ಅಸಲಿ, ಶುದ್ಧ, ಸಿಹಿ ದೀಪಾವಳಿ!"}, {"id": 132, "duration_s": 6.73, "emotion": "proud", "text": "ಇಡೀ ಬಡಾವಣೆ ನೋಡ್ಬೇಕು... ಒಂದೇ ತಟ್ಟೆ!"}, {"id": 133, "duration_s": 0.89, "emotion": "embarrassed", "text": "ಈ ಸಲ... ಫ್ರೀ!"}, {"id": 134, "duration_s": 3.83, "emotion": "worried", "text": "ದಾಸಪ್ಪ, ಫ್ರೀನಾ? ನಡೀರಿ... ಡಾಕ್ಟರ್ ಹತ್ರ!"}, {"id": 135, "duration_s": 3.13, "emotion": "proud", "text": "ಸೈನ್ಸ್ ಹೇಳುತ್ತೆ... ಮನೆ ಸಿಹಿ ಬೆಸ್ಟ್!"}, {"id": 136, "duration_s": 3.91, "emotion": "proud", "text": "ಈ ಸಲ ಸರಿಯಾಗಿ ಕೇಳ್ಸ್ತು... ಸಿಹಿ ಅಸಲಿ!"}, {"id": 137, "duration_s": 1.83, "emotion": "curious", "text": "ಅಜ್ಜಾ! ಇವತ್ತಿನ ಪಾಠ?"}, {"id": 138, "duration_s": 4.35, "emotion": "calm", "text": "ಅಗ್ಗ ನೋಡಿ ಅಲ್ಲ... ಶುದ್ಧ ನೋಡಿ ಕೊಳ್ಳಿ."}, {"id": 139, "duration_s": 2.03, "emotion": "happy", "text": "ಹ್ಯಾಪಿ ದೀಪಾವಳಿ!"}]