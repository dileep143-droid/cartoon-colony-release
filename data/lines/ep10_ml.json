[{"id": 1, "duration_s": 4.06, "emotion": "mischievous", "text": "രാത്രി രണ്ടു മണി... കോളനി ഉറക്കത്തിൽ."}, {"id": 2, "duration_s": 1.04, "emotion": "mischievous", "text": "ഒരാളൊഴികെ."}, {"id": 3, "duration_s": 1.32, "emotion": "angry", "text": "ചെവിയിൽ എയർപോർട്ടോ?"}, {"id": 4, "duration_s": 1.35, "emotion": "proud", "text": "ആരെയും പേടിയില്ല!"}, {"id": 5, "duration_s": 5.04, "emotion": "giggly", "text": "പത്ത് കൈയടി... ഇരുപത്... മുപ്പത്..."}, {"id": 6, "duration_s": 2.21, "emotion": "sarcastic", "text": "കൈയടിയോ? കല്യാണമാണോ?"}, {"id": 7, "duration_s": 2.76, "emotion": "scared_whisper", "text": "നാല്പതാമത്തേത്... അവസാനത്തേത്."}, {"id": 8, "duration_s": 4.93, "emotion": "giggly", "text": "നാല്പത് അടി. കൊതുക്: പൂജ്യം. സുരേഷ്: നാല്പത്."}, {"id": 9, "duration_s": 2.43, "emotion": "determined", "text": "മാറ്! ചെരിപ്പ് പിഴയ്ക്കില്ല!"}, {"id": 10, "duration_s": 1.41, "emotion": "embarrassed", "text": "പിഴച്ചില്ല, എനിക്ക് കൊണ്ടു!"}, {"id": 11, "duration_s": 2.43, "emotion": "proud", "text": "കണ്ടോ? ഉന്നം ഉറച്ചത്."}, {"id": 12, "duration_s": 2.458, "emotion": "mischievous", "text": "ഇത് വെറും തുടക്കം."}, {"id": 13, "duration_s": 4.98, "emotion": "giggly", "text": "രാവിലെയായപ്പോൾ കോളനി മുഴുവൻ ചൊറിഞ്ഞു."}, {"id": 14, "duration_s": 2.08, "emotion": "excited", "text": "അറിഞ്ഞോ? രാത്രി കൊതുകുപട വന്നു!"}, {"id": 15, "duration_s": 4.604, "emotion": "mischievous", "text": "സുരേഷ് സ്വയം നാല്പത് അടിച്ചു!"}, {"id": 16, "duration_s": 2.79, "emotion": "embarrassed", "text": "അത് കൊതുകല്ല... ആനയാ!"}, {"id": 17, "duration_s": 2.1, "emotion": "sarcastic", "text": "ആനയല്ല, അമ്മയുടെ ചെരിപ്പ്."}, {"id": 18, "duration_s": 2.52, "emotion": "serious", "text": "കണ്ണ് തട്ടി! കൊതുകിന്റെ കണ്ണ്!"}, {"id": 19, "duration_s": 2.3, "emotion": "shocked", "text": "അയ്യോ! മുളകും തിന്നല്ലോ!"}, {"id": 20, "duration_s": 3.31, "emotion": "stern_warning", "text": "സമോസ? നിൽക്ക്! അന്വേഷണം!"}, {"id": 21, "duration_s": 2.76, "emotion": "happy", "text": "അന്വേഷണം കഴിഞ്ഞു. വിശന്നു!"}, {"id": 22, "duration_s": 3.19, "emotion": "proud", "text": "സയൻസ് പറയുന്നു, കൊതുക് ഓടയിലേ വളരൂ!"}, {"id": 23, "duration_s": 0.8, "emotion": "curious", "text": "ഞാൻ പറയാം?"}, {"id": 24, "duration_s": 1.917, "emotion": "proud", "text": "കുട്ടി മിണ്ടരുത്! സയൻസാ!"}, {"id": 25, "duration_s": 3.55, "emotion": "proud", "text": "നമ്മുടെ കോളനി വൃത്തിയാ, കൊതുക് പുറത്തുനിന്നാ!"}, {"id": 26, "duration_s": 3.92, "emotion": "excited", "text": "കൊതുകില്ലാ ചന്ദനത്തിരി! ഒന്ന് കത്തിച്ചാൽ കൊതുക് ഔട്ട്!"}, {"id": 27, "duration_s": 2.33, "emotion": "determined", "text": "നാല്പത് താ! ഒരടിക്ക് ഒന്ന്."}, {"id": 28, "duration_s": 2.69, "emotion": "stern_warning", "text": "പത്തു രൂപ വീതം. ഒരു രൂപ കുറയില്ല!"}, {"id": 29, "duration_s": 3.9, "emotion": "angry", "text": "കാശു കുട്ടപ്പാ, ഇത് കഴിഞ്ഞ കൊല്ലത്തെ പൂജയുടേത്!"}, {"id": 30, "duration_s": 3.66, "emotion": "embarrassed", "text": "പഴയ പൂജ... പുതിയ കൊതുക്."}, {"id": 31, "duration_s": 4.36, "emotion": "giggly", "text": "വൈകുന്നേരമായപ്പോൾ കോളനിയിൽ മേഘം വന്നു. കൊതുക് പോയില്ല."}, {"id": 32, "duration_s": 2.17, "emotion": "excited", "text": "ലൈവാണ്! കോളനിയിൽ മേഘം!"}, {"id": 33, "duration_s": 1.77, "emotion": "determined", "text": "കുട്ടപ്പാ, അനങ്ങല്ലേ."}, {"id": 34, "duration_s": 2.58, "emotion": "tired", "text": "പുക പോയി... കൊതുക് പോയില്ല."}, {"id": 35, "duration_s": 2.62, "emotion": "serious", "text": "രണ്ടു നാൾ ശേഷം. കുട്ടപ്പന്റെ വീട്ടിൽ."}, {"id": 36, "duration_s": 2.97, "emotion": "loving", "text": "എണീക്ക് ഉണ്ണീ. ഇഷ്ടപ്പെട്ട ഉണ്ണിയപ്പം."}, {"id": 37, "duration_s": 2.8, "emotion": "shocked", "text": "ഉണ്ണി... ഉണ്ണിയപ്പം വേണ്ടെന്നോ?!"}, {"id": 38, "duration_s": 2.3, "emotion": "tired", "text": "അമ്മേ... വിശപ്പില്ല."}, {"id": 39, "duration_s": 4.37, "emotion": "worried", "text": "പനിയുണ്ട്! കുട്ടപ്പാ, ഡോക്ടറെ!"}, {"id": 40, "duration_s": 1.36, "emotion": "worried", "text": "ഫീസ്... സാരമില്ല! സാരമില്ല!"}, {"id": 41, "duration_s": 2.18, "emotion": "calm", "text": "പനിണ്ടെങ്കില് രാവിലെ ക്ലിനിക്കിലേക്ക് ബാ."}, {"id": 42, "duration_s": 2.09, "emotion": "serious", "text": "ഡെങ്കി ടെസ്റ്റ് ബേണം. ബേജാറാവണ്ട."}, {"id": 43, "duration_s": 1.48, "emotion": "serious", "text": "ചുറ്റും ബെള്ളം കെട്ടിക്കിടപ്പുണ്ടോ?"}, {"id": 44, "duration_s": 1.45, "emotion": "proud", "text": "നമ്മുടെ വീട് വൃത്തിയാ!"}, {"id": 45, "duration_s": 2.86, "emotion": "serious", "text": "ഡെങ്കി കൊതുക് ബൃത്തീള്ള ബെള്ളത്തിലാ മുട്ടയിടല്."}, {"id": 46, "duration_s": 4.06, "emotion": "happy", "text": "ഹായ്, പോകാം!"}, {"id": 47, "duration_s": 1.42, "emotion": "giggly", "text": "...എത്തുകേം ചെയ്തു."}, {"id": 48, "duration_s": 1.21, "emotion": "relieved", "text": "ഡെങ്കിയില്ല. ചെറിയ പനി മാത്രം."}, {"id": 49, "duration_s": 0.93, "emotion": "pleading", "text": "ഉണ്ണിയോ?"}, {"id": 50, "duration_s": 2.74, "emotion": "stern_warning", "text": "മാറീട്ട്. ഒരെണ്ണം മാത്രം."}, {"id": 51, "duration_s": 1.04, "emotion": "shocked", "text": "ഒന്നോ?!"}, {"id": 52, "duration_s": 1.99, "emotion": "excited", "text": "എനിക്കൊരു ഐഡിയ! നമ്മൾ ആകും..."}, {"id": 53, "duration_s": 0.9, "emotion": "excited", "text": "...കൊതുക് ഡിറ്റക്ടീവ്!"}, {"id": 54, "duration_s": 1.88, "emotion": "proud", "text": "ഞാൻ പറയട്ടെ? ഇത്തവണ സത്യം!"}, {"id": 55, "duration_s": 1.34, "emotion": "stern_warning", "text": "പറ! വേഗം!"}, {"id": 56, "duration_s": 2.66, "emotion": "serious", "text": "ഡെങ്കി കൊതുക് മിക്കവാറും പകലാ കടിക്കുന്നത്."}, {"id": 57, "duration_s": 3.39, "emotion": "serious", "text": "ഓടയിലല്ല, തെളിഞ്ഞ കെട്ടുവെള്ളത്തിൽ മുട്ടയിടും."}, {"id": 58, "duration_s": 2.57, "emotion": "shocked", "text": "അപ്പോ പണ്ഡിറ്റിന്റെ സയൻസ്... നേരെ തിരിച്ച്!"}, {"id": 59, "duration_s": 3.06, "emotion": "serious", "text": "വെള്ളത്തിൽ ചെറുപുഴുക്കൾ കണ്ടാൽ അത് ലാർവ."}, {"id": 60, "duration_s": 2.35, "emotion": "serious", "text": "ഒരാഴ്ചയ്ക്കുള്ളിൽ ലാർവ കൊതുകാകും!"}, {"id": 61, "duration_s": 2.86, "emotion": "determined", "text": "ഡിറ്റക്ടീവുകളേ! പ്രതികാരം!"}, {"id": 62, "duration_s": 3.09, "emotion": "determined", "text": "ഓരോ പാത്രം! ഓരോ ചട്ടി! ഓരോ ടയർ!"}, {"id": 63, "duration_s": 2.75, "emotion": "proud", "text": "ഡിറ്റക്ടീവോ? വലിയവർ നോക്കിക്കോളാം!"}, {"id": 64, "duration_s": 0.54, "emotion": "angry", "text": "നിർത്ത്!"}, {"id": 65, "duration_s": 2.09, "emotion": "excited", "text": "അങ്ങനെ തുടങ്ങി... കൊതുക് വേട്ട!"}, {"id": 66, "duration_s": 2.17, "emotion": "excited", "text": "കിട്ടി! കൂളറിൽ ലാർവ!"}, {"id": 67, "duration_s": 4.56, "emotion": "proud", "text": "എന്റെ കൂളറോ? അത് വെറും... വാടകക്കാർ."}, {"id": 68, "duration_s": 3.52, "emotion": "scared_whisper", "text": "ഞാൻ... ആരെയും... പേടിയില്ല."}, {"id": 69, "duration_s": 2.78, "emotion": "panicked", "text": "ശോഭേ! ഇവൻ വാടക ചോദിക്കുന്നു!"}, {"id": 70, "duration_s": 3.03, "emotion": "stern_warning", "text": "അമ്മിണിയമ്മച്ചീ, ചട്ടീടെ ട്രേയിലും!"}, {"id": 71, "duration_s": 3.4, "emotion": "proud", "text": "എന്റെ ചട്ടിക്ക് ദിവസവും വെള്ളമൊഴിക്കാറുണ്ട്!"}, {"id": 72, "duration_s": 2.63, "emotion": "sarcastic", "text": "പൂജയും വെള്ളവും കൊതുകും!"}, {"id": 73, "duration_s": 1.97, "emotion": "determined", "text": "മതി! ഇനി ഞാൻ നോക്കാം."}, {"id": 74, "duration_s": 4.56, "emotion": "proud", "text": "ആഴ്ചയിലൊരിക്കൽ ഒഴിക്കൂ, ഉണക്കൂ. പത്തു സെക്കൻഡ്."}, {"id": 75, "duration_s": 2.58, "emotion": "embarrassed", "text": "ഞാനും... സഹായിക്കുവായിരുന്നു."}, {"id": 76, "duration_s": 3.01, "emotion": "mischievous", "text": "മേൽക്കൂരയിൽ... ഷിബുവിന്റെ ബിസിനസ്."}, {"id": 77, "duration_s": 0.8, "emotion": "excited", "text": "ടെൻഷൻ വേണ്ട!"}, {"id": 78, "duration_s": 4.64, "emotion": "proud", "text": "ഇതാ എന്റെ ടയർ ബിസിനസ്! ഇരുപത് ടയർ, അടുത്ത കൊല്ലം ഇരുപത് ലക്ഷം!"}, {"id": 79, "duration_s": 2.65, "emotion": "serious", "text": "ഒരു ടയറിൽ നൂറിലധികം ലാർവ."}, {"id": 80, "duration_s": 1.29, "emotion": "shocked", "text": "ഇരുപത് ടയറിലോ?"}, {"id": 81, "duration_s": 1.69, "emotion": "shocked", "text": "മുഴുവൻ കൊതുക് കോളനി!"}, {"id": 82, "duration_s": 1.09, "emotion": "mischievous", "text": "വാടക വാങ്ങിയാലോ?"}, {"id": 83, "duration_s": 3.58, "emotion": "proud", "text": "എന്റെ അച്ചാറിന് വെയില്! ഞാനെങ്കിലും..."}, {"id": 84, "duration_s": 1.86, "emotion": "mischievous", "text": "അമ്മച്ചീ... അടപ്പിലുമുണ്ട്."}, {"id": 85, "duration_s": 2.74, "emotion": "shocked", "text": "അയ്യോ! നാട്ടുകാരെല്ലാം കാണുമല്ലോ!"}, {"id": 86, "duration_s": 1.96, "emotion": "angry", "text": "ഇതെല്ലാം നിന്റെ ടയർ കാരണമാ!"}, {"id": 87, "duration_s": 1.959, "emotion": "panicked", "text": "ഭരണിയും!"}, {"id": 88, "duration_s": 1.4, "emotion": "embarrassed", "text": "ഉന്നം... വീണ്ടും ഉറച്ചു."}, {"id": 89, "duration_s": 2.47, "emotion": "determined", "text": "ടയർ കമിഴ്ത്തി, വെള്ളം പുറത്ത്, ബിസിനസ് അകത്ത്!"}, {"id": 90, "duration_s": 3.65, "emotion": "excited", "text": "കേട്ടോ? സുരേഷിന്റെ കൂരേൽ ഇരുപത് ലക്ഷം!"}, {"id": 91, "duration_s": 3.11, "emotion": "panicked", "text": "ഇരുപത് ലക്ഷം കൊതുക്! ഡെങ്കി വന്നേ!"}, {"id": 92, "duration_s": 5.548, "emotion": "serious", "text": "കണ്ണ് തട്ടി! എല്ലാ വാതിലിലും നാരങ്ങ!"}, {"id": 93, "duration_s": 3.04, "emotion": "mischievous", "text": "കൊതുകുവല! ഇന്ന് റേറ്റ് ഇരട്ടി!"}, {"id": 94, "duration_s": 3.83, "emotion": "giggly", "text": "പിന്നെ... കോളനിയിൽ പ്രേതങ്ങളുടെ ഘോഷയാത്ര."}, {"id": 95, "duration_s": 2.13, "emotion": "shouting", "text": "കൊതുകിനെയും അന്വേഷിക്കും!"}, {"id": 96, "duration_s": 0.61, "emotion": "angry", "text": "നിർത്ത്!"}, {"id": 97, "duration_s": 4.05, "emotion": "serious", "text": "പുക, നാരങ്ങ, ബാറ്റല്ല! കെട്ടുവെള്ളം കളയൂ!"}, {"id": 98, "duration_s": 1.3, "emotion": "excited", "text": "എനിക്കൊരു ഐഡിയ!"}, {"id": 99, "duration_s": 2.95, "emotion": "excited", "text": "വൃത്തി മത്സരം! ഏറ്റവും വെള്ളം കണ്ടെത്തുന്നവർ!"}, {"id": 100, "duration_s": 3.12, "emotion": "determined", "text": "മത്സരമോ? ഞങ്ങൾ തോൽക്കില്ല!"}, {"id": 101, "duration_s": 3.13, "emotion": "excited", "text": "കോളനിയിലെ ആദ്യ... വൃത്തി മത്സരം!"}, {"id": 102, "duration_s": 3.03, "emotion": "serious", "text": "നിയമം കേൾക്കൂ! ഏറ്റവും കൂടുതൽ..."}, {"id": 103, "duration_s": 1.77, "emotion": "serious", "text": "ലാർവ, മാഷേ! ലാർവ!"}, {"id": 104, "duration_s": 2.31, "emotion": "shocked", "text": "ലവറോ? ഈ കോളനിയിലോ?"}, {"id": 105, "duration_s": 2.9, "emotion": "scared_whisper", "text": "ആരുടെ? എവിടെ? ഈ പ്രായത്തിൽ?"}, {"id": 106, "duration_s": 3.644, "emotion": "sarcastic", "text": "കൊതുകിന്റെ കുഞ്ഞുങ്ങൾ, മാഷേ!"}, {"id": 107, "duration_s": 1.46, "emotion": "embarrassed", "text": "ഓ... എന്നാൽ ശരി. തുടങ്ങൂ!"}, {"id": 108, "duration_s": 2.76, "emotion": "tired", "text": "മുഴുക്കൈ... മുഴുവൻ വിയർപ്പ്!"}, {"id": 109, "duration_s": 2.64, "emotion": "giggly", "text": "പക്ഷേ കൊതുക് തെന്നിപ്പോയി!"}, {"id": 110, "duration_s": 2.36, "emotion": "determined", "text": "വലിയമ്മച്ചീ, ആ പാത്രവും!"}, {"id": 111, "duration_s": 2.83, "emotion": "embarrassed", "text": "കണ്ണ്... വെള്ളത്തിനാ തട്ടിയത്."}, {"id": 112, "duration_s": 2.09, "emotion": "happy", "text": "അയ്യോ, മേൽക്കൂരയിലും കുളം!"}, {"id": 113, "duration_s": 4.369, "emotion": "shouting", "text": "മഴ? സമോസ? അന്വേഷണം!"}, {"id": 114, "duration_s": 2.87, "emotion": "mischievous", "text": "കാശു കുട്ടപ്പാ, സൗജന്യ വാടകക്കാർ!"}, {"id": 115, "duration_s": 2.86, "emotion": "sad", "text": "എന്റെ കടയിൽ ഫ്രീയായി ആരും താമസമില്ല!"}, {"id": 116, "duration_s": 2.737, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... ഇത് അനങ്ങില്ല."}, {"id": 117, "duration_s": 0.63, "emotion": "calm", "text": "മാറ്."}, {"id": 118, "duration_s": 3.03, "emotion": "embarrassed", "text": "സയൻസ് പറയുന്നു... കുട്ടികളെ കേൾക്കൂ."}, {"id": 119, "duration_s": 1.96, "emotion": "excited", "text": "ലൈവാണ്! ഹാഷ്ടാഗ് കൊതുകുമുക്തം!"}, {"id": 120, "duration_s": 2.82, "emotion": "proud", "text": "ഒരു മണിക്കൂറിൽ കോളനിയിൽ തുള്ളി കെട്ടുവെള്ളമില്ല."}, {"id": 121, "duration_s": 1.99, "emotion": "excited", "text": "പതിനായിരം വ്യൂ! കോളനി വൈറൽ!"}, {"id": 122, "duration_s": 2.11, "emotion": "excited", "text": "അറിഞ്ഞോ? ഇത്തവണ നല്ല വാർത്ത!"}, {"id": 123, "duration_s": 3.13, "emotion": "proud", "text": "റീലിൽ മുന്നിൽ ഞാൻ! നാട്ടുകാരെല്ലാം കാണും!"}, {"id": 124, "duration_s": 3.25, "emotion": "proud", "text": "ഡെങ്കിമുക്ത കോളനി. പിന്നെ ലവർമുക്തവും."}, {"id": 125, "duration_s": 1.64, "emotion": "sarcastic", "text": "ലാർവ, മാഷേ... ലാർവ."}, {"id": 126, "duration_s": 3.97, "emotion": "happy", "text": "കോളനി കൊതുകിനെ തോൽപ്പിച്ചു... വെള്ളത്തോട് പൊരുതി."}, {"id": 127, "duration_s": 2.78, "emotion": "stern_warning", "text": "ഡോക്ടർ പറഞ്ഞതാ. ഒരെണ്ണം മാത്രം."}, {"id": 128, "duration_s": 2.35, "emotion": "loving", "text": "പയ്യെത്തിന്നാൽ പനയും തിന്നാം!"}, {"id": 129, "duration_s": 2.225, "emotion": "tired", "text": "ഉണ്ണീ, ഇരുപത് മിനിറ്റായി!"}, {"id": 130, "duration_s": 3.44, "emotion": "happy", "text": "പനി മാറി! ഇപ്പോ... വിശക്കുന്നു!"}, {"id": 131, "duration_s": 2.73, "emotion": "proud", "text": "ഞാൻ പറഞ്ഞില്ലേ, ആരെയും പേടിയില്ലെന്ന്."}, {"id": 132, "duration_s": 1.04, "emotion": "mischievous", "text": "ങ്ഈഈഈ..."}, {"id": 133, "duration_s": 1.4, "emotion": "calm", "text": "കേൾക്കൂ, ചാരരേ."}, {"id": 134, "duration_s": 3.41, "emotion": "serious", "text": "കൊതുകിനോടല്ല... വെള്ളത്തോട് പൊരുതൂ."}, {"id": 135, "duration_s": 4.86, "emotion": "serious", "text": "ആഴ്ചയിലൊരിക്കൽ പാത്രങ്ങൾ ഒഴിക്കുക, ടാങ്ക് മൂടുക."}, {"id": 136, "duration_s": 4.38, "emotion": "loving", "text": "നീളക്കൈ വസ്ത്രം. പനി വന്നാൽ നേരെ ഡോക്ടറെ."}, {"id": 137, "duration_s": 1.49, "emotion": "excited", "text": "കേസ് ക്ലോസ്!"}, {"id": 138, "duration_s": 3.22, "emotion": "mischievous", "text": "കോളനി നന്നായി... പക്ഷേ സുരേഷിന്റെ കൈയടി?"}, {"id": 139, "duration_s": 1.02, "emotion": "scared_whisper", "text": "നാല്പത്തൊന്ന്..."}]