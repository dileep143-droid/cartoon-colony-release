[{"id": 1, "duration_s": 4.39, "emotion": "calm", "text": "ഞായറാഴ്ച വൈകുന്നേരം. സുരേഷിന്റെ വീട്ടിൽ സത്യനാരായണ പൂജ."}, {"id": 2, "duration_s": 2.91, "emotion": "excited", "text": "ബനാന കിങ്ഡം! ഊ ഊ ആ ആ!"}, {"id": 3, "duration_s": 1.83, "emotion": "excited", "text": "വെറും തൊണ്ണൂറ്റൊമ്പത് രൂപ!"}, {"id": 4, "duration_s": 4.38, "emotion": "shocked", "text": "പിന്നേം പോയോ?!"}, {"id": 5, "duration_s": 0.66, "emotion": "embarrassed", "text": "ഊ ഊ ആ ആ?"}, {"id": 6, "duration_s": 2.38, "emotion": "mischievous", "text": "തുടങ്ങിയത് മൂന്നു ദിവസം മുമ്പ്."}, {"id": 7, "duration_s": 1.65, "emotion": "mischievous", "text": "ഒരു പഴം ഗെയിമിൽ നിന്ന്."}, {"id": 8, "duration_s": 2.99, "emotion": "angry", "text": "കുഞ്ഞൂ! ഈ ഫോൺ 'ഗുഡ്മോണിങ്' അയക്കുന്നേയില്ല!"}, {"id": 9, "duration_s": 2.15, "emotion": "proud", "text": "ശരിയാക്കി. പതിനാല് ഗ്രൂപ്പിൽ വിട്ടു."}, {"id": 10, "duration_s": 1.45, "emotion": "proud", "text": "നാടു മുഴുവൻ കാണും!"}, {"id": 11, "duration_s": 1.87, "emotion": "excited", "text": "അമ്മച്ചീ! കുരങ്ങൻ ഗെയിമുണ്ട്!"}, {"id": 12, "duration_s": 3.01, "emotion": "tired", "text": "അഞ്ചു മിനിറ്റ് കളിച്ചോ. ഞാനൊന്ന് കണ്ണടച്ച്..."}, {"id": 13, "duration_s": 2.08, "emotion": "excited", "text": "ബനാന കിങ്ഡത്തിലേക്ക് സ്വാഗതം!"}, {"id": 14, "duration_s": 3.03, "emotion": "excited", "text": "പഴം തീർന്നു കൊച്ചേ! തൊണ്ണൂറ്റൊമ്പതിന് നൂറ് പഴം!"}, {"id": 15, "duration_s": 3.13, "emotion": "curious", "text": "തൊണ്ണൂറ്റൊമ്പത് രൂപയോ? ശരിക്കുള്ളതോ?"}, {"id": 16, "duration_s": 2.95, "emotion": "mischievous", "text": "മണ്ടാ! ഗെയിമിലെ കാശ് വ്യാജനാ."}, {"id": 17, "duration_s": 0.96, "emotion": "mischievous", "text": "എനിക്കൊരു ഐഡിയ!"}, {"id": 18, "duration_s": 2.62, "emotion": "excited", "text": "ശബ്ദം കേട്ടോ? നമുക്ക് കാശ് കിട്ടുന്നു!"}, {"id": 19, "duration_s": 2.91, "emotion": "laughing", "text": "ഒന്നൂടെ! ഹ ഹ! ഒന്നൂടെ!"}, {"id": 20, "duration_s": 2.27, "emotion": "happy", "text": "നാടു മുഴുവൻ... കാണും..."}, {"id": 21, "duration_s": 3.51, "emotion": "excited", "text": "കലക്കി! നീയാണ് ബനാന കിങ്ഡത്തിലെ രാജാവ്!"}, {"id": 22, "duration_s": 3.26, "emotion": "calm", "text": "അന്നു രാവിലെ. വരാന്തയിൽ സുരേഷിന്റെ വിശ്രമം."}, {"id": 23, "duration_s": 3.95, "emotion": "proud", "text": "എന്റെ ബാങ്ക് അക്കൗണ്ട്... ഉരുക്ക് ലോക്കറാ, ഷിബൂ!"}, {"id": 24, "duration_s": 1.39, "emotion": "sarcastic", "text": "ഉള്ളിൽ വല്ലതുമുണ്ടോ?"}, {"id": 25, "duration_s": 3.99, "emotion": "neutral", "text": "തൊണ്ണൂറ്റൊമ്പത് പോയോ? പോട്ടെ... ചായക്കാശ്."}, {"id": 26, "duration_s": 2.23, "emotion": "shocked", "text": "നാനൂറ്റി തൊണ്ണൂറ്റൊമ്പത്?!"}, {"id": 27, "duration_s": 1.94, "emotion": "curious", "text": "പെട്ടിക്ക് ഓട്ടയുണ്ട്!"}, {"id": 28, "duration_s": 2.91, "emotion": "panicked", "text": "തൊള്ളായിരം തൊണ്ണൂറ്റൊമ്പത്! ഇവൻ കൊള്ളക്കാരൻ!"}, {"id": 29, "duration_s": 1.68, "emotion": "excited", "text": "ടെൻഷൻ വേണ്ട! ഫോൺ വിറ്റേക്ക്!"}, {"id": 30, "duration_s": 2.88, "emotion": "determined", "text": "ഞാൻ ആരെയും പേടിക്കില്ല! ആ കള്ളനെ ഞാൻ..."}, {"id": 31, "duration_s": 0.44, "emotion": "comic_panic", "text": "പ... പല്ലി!"}, {"id": 32, "duration_s": 3.09, "emotion": "sarcastic", "text": "ആരെയും പേടിയില്ലല്ലോ? പല്ലിയെയും?"}, {"id": 33, "duration_s": 2.16, "emotion": "embarrassed", "text": "അത്... കള്ളന്റെ ചാരനാ! രഹസ്യച്ചാരൻ!"}, {"id": 34, "duration_s": 1.41, "emotion": "calm", "text": "മതി! ഇനി ഞാൻ നോക്കാം—"}, {"id": 35, "duration_s": 1.96, "emotion": "shouting", "text": "വേണ്ട! ഇത് പോലീസ് കേസാ!"}, {"id": 36, "duration_s": 3.72, "emotion": "scared_whisper", "text": "ഹലോ, സ്റ്റേഷൻ? എന്റെ അക്കൗണ്ട് കൊള്ളയടിക്കുന്നു!"}, {"id": 37, "duration_s": 4.65, "emotion": "serious", "text": "അന്വേഷണം! പൂർണ്ണ അന്വേഷണം!"}, {"id": 38, "duration_s": 5.273, "emotion": "panicked", "text": "സാറേ, കള്ളനെ കാണില്ല... കാശ് മാത്രം പോകും!"}, {"id": 39, "duration_s": 1.67, "emotion": "curious", "text": "ഹും... തെളിവിന്റെ മണം."}, {"id": 40, "duration_s": 8.25, "emotion": "serious", "text": "കള്ളൻ എപ്പോ വരും? എന്താ ഇടുന്നത്? ചട്ണി എവിടെ?"}, {"id": 41, "duration_s": 1.923, "emotion": "embarrassed", "text": "വിശന്നിട്ടാ!"}, {"id": 42, "duration_s": 3.8, "emotion": "serious", "text": "എഴുതൂ... കള്ളൻ... പശി."}, {"id": 43, "duration_s": 1.92, "emotion": "curious", "text": "വിശപ്പോ? എങ്ങനെ അറിയാം?"}, {"id": 44, "duration_s": 2.03, "emotion": "proud", "text": "പക്കാവട തീർന്നില്ലേ!"}, {"id": 45, "duration_s": 1.87, "emotion": "pleading", "text": "സാറേ? സാറേ! കള്ളൻ!"}, {"id": 46, "duration_s": 1.6, "emotion": "sarcastic", "text": "ഒരു പക്കാവട കൂടി?"}, {"id": 47, "duration_s": 1.1, "emotion": "excited", "text": "അന്വേഷണം!"}, {"id": 48, "duration_s": 4.38, "emotion": "serious", "text": "സ്റ്റേഷനിൽ ചെന്ന് റിപ്പോർട്ട് തിന്നും. അല്ല... എഴുതും."}, {"id": 49, "duration_s": 4.45, "emotion": "sad", "text": "ശ്ശൊ... കള്ളനും വിശപ്പ്... പോലീസിനും വിശപ്പ്."}, {"id": 50, "duration_s": 3.76, "emotion": "mischievous", "text": "ഒരു മണിക്കൂറിൽ... വാർത്ത നാടാകെ."}, {"id": 51, "duration_s": 1.77, "emotion": "excited", "text": "അറിഞ്ഞോ? സുരേഷിന്റെ ഫോണിൽ കള്ളൻ!"}, {"id": 52, "duration_s": 1.93, "emotion": "scared_whisper", "text": "അറിഞ്ഞോ? കള്ളൻ അദൃശ്യനാ!"}, {"id": 53, "duration_s": 1.66, "emotion": "shocked", "text": "അറിഞ്ഞോ? കള്ളൻ കുരങ്ങാ!"}, {"id": 54, "duration_s": 1.55, "emotion": "proud", "text": "സയൻസ് പറയുന്നു..."}, {"id": 55, "duration_s": 1.74, "emotion": "serious", "text": "കള്ളൻ... ഇടംകയ്യനാ!"}, {"id": 56, "duration_s": 0.96, "emotion": "curious", "text": "എങ്ങനെ?"}, {"id": 57, "duration_s": 2.57, "emotion": "proud", "text": "കാശ് എപ്പോഴും ഇടതുകൈകൊണ്ടേ പോകൂ!"}, {"id": 58, "duration_s": 0.67, "emotion": "stern_warning", "text": "കുട്ടപ്പാ!"}, {"id": 59, "duration_s": 4.16, "emotion": "serious", "text": "എന്റെ ഇടതുകൈ എണ്ണാൻ മാത്രം. ഒരു രൂപ കുറയില്ല!"}, {"id": 60, "duration_s": 3.895, "emotion": "serious", "text": "കണ്ണു തട്ടി! ഓരോ ഫോണിനും നാരങ്ങ-മുളക്!"}, {"id": 61, "duration_s": 2.18, "emotion": "excited", "text": "ലൈവാണ്! കോളനിയിൽ കള്ളൻ!"}, {"id": 62, "duration_s": 1.76, "emotion": "determined", "text": "വാ, പോകാം! കള്ളനെ പിടിക്കാൻ!"}, {"id": 63, "duration_s": 2.49, "emotion": "embarrassed", "text": "ശ്ശൊ... കള്ളനെ നടന്നു പിടിക്കാം."}, {"id": 64, "duration_s": 2.04, "emotion": "comic_panic", "text": "പത്തൊമ്പതുനൂറ്റി തൊണ്ണൂറ്റൊമ്പത്! ഇപ്പൊ!"}, {"id": 65, "duration_s": 1.89, "emotion": "shocked", "text": "കള്ളൻ ഇവിടെത്തന്നെ!"}, {"id": 66, "duration_s": 0.96, "emotion": "shouting", "text": "നീ! അല്ല, നീ!"}, {"id": 67, "duration_s": 1.08, "emotion": "shouting", "text": "മിണ്ടരുത്!"}, {"id": 68, "duration_s": 3.0, "emotion": "curious", "text": "ഞാൻ പറയട്ടെ? കള്ളൻ ചിലപ്പോ വീട്ടിലെ..."}, {"id": 69, "duration_s": 0.8, "emotion": "shouting", "text": "വേണ്ട!"}, {"id": 70, "duration_s": 1.58, "emotion": "sarcastic", "text": "കുട്ടികൾക്ക് സയൻസറിയില്ല!"}, {"id": 71, "duration_s": 3.87, "emotion": "scared_whisper", "text": "രാത്രി രണ്ടു മണി. നാടു മുഴുവൻ ഉറക്കം..."}, {"id": 72, "duration_s": 1.9, "emotion": "mischievous", "text": "...ഏതാണ്ട് മുഴുവൻ."}, {"id": 73, "duration_s": 2.77, "emotion": "scared_whisper", "text": "ഒരു ലെവൽ കൂടി... എന്നിട്ടുറങ്ങാം."}, {"id": 74, "duration_s": 2.36, "emotion": "scared_whisper", "text": "ശ്ശ്! കുരങ്ങന് വിശക്കുന്നു!"}, {"id": 75, "duration_s": 2.07, "emotion": "scared_whisper", "text": "കള്ളൻ... വീടിനകത്താ!"}, {"id": 76, "duration_s": 3.14, "emotion": "scared_whisper", "text": "ഞാൻ ആരെയും പേടിക്കില്ല... ഞാൻ..."}, {"id": 77, "duration_s": 1.8, "emotion": "scared_whisper", "text": "ആരാ അത്? കൈ പൊക്കിക്കോ!"}, {"id": 78, "duration_s": 1.31, "emotion": "angry", "text": "രാത്രി ടോർച്ചോ?!"}, {"id": 79, "duration_s": 1.95, "emotion": "embarrassed", "text": "അമ്മേ... അമ്മ കള്ളനെ വല്ലതും കണ്ടോ?"}, {"id": 80, "duration_s": 4.643, "emotion": "tired", "text": "കള്ളനോ? ഞാൻ മാത്രം!"}, {"id": 81, "duration_s": 1.42, "emotion": "relieved", "text": "ഹാ... അമ്മ ഉറക്കമല്ലേ."}, {"id": 82, "duration_s": 3.63, "emotion": "serious", "text": "കോളനിയിൽ കള്ളൻ കറങ്ങുന്നു. ഒരു രൂപ കുറയില്ല!"}, {"id": 83, "duration_s": 0.69, "emotion": "excited", "text": "ടെൻഷൻ വേണ്ട!"}, {"id": 84, "duration_s": 2.43, "emotion": "mischievous", "text": "ഗെയിം ഹാക്ക്! പഴം ഫ്രീ! ഇരുന്നൂറ് മാത്രം!"}, {"id": 85, "duration_s": 2.82, "emotion": "curious", "text": "ഇരുന്നൂറില്ല... രണ്ട് സമോസയുണ്ട്."}, {"id": 86, "duration_s": 1.39, "emotion": "happy", "text": "അത് മതി! ഡീൽ!"}, {"id": 87, "duration_s": 1.68, "emotion": "shocked", "text": "ശ്ശൊ! പേയ്‌മെന്റ് തിന്നു!"}, {"id": 88, "duration_s": 3.8, "emotion": "stern_warning", "text": "ഗെയിം ഹാക്കോ? ഞാൻ ശരിക്കുള്ള ഹാക്ക് കാണിക്കട്ടെ?"}, {"id": 89, "duration_s": 2.41, "emotion": "pleading", "text": "ചേച്ചീ... ഇത് സേവനമാ!"}, {"id": 90, "duration_s": 2.83, "emotion": "excited", "text": "ഇരുന്നൂറോ? അതിൽ എനിക്ക് പത്തു ശതമാനം!"}, {"id": 91, "duration_s": 0.79, "emotion": "stern_warning", "text": "കുട്ടപ്പാ!"}, {"id": 92, "duration_s": 1.46, "emotion": "happy", "text": "ഹാക്ക് കിടു!"}, {"id": 93, "duration_s": 4.26, "emotion": "calm", "text": "മൂന്നു ദിവസം കഴിഞ്ഞ്. അതേ പൂജ... തുടങ്ങിയിടത്ത്."}, {"id": 94, "duration_s": 2.72, "emotion": "scared_whisper", "text": "ഇന്ന് ചെലവൊന്നുമില്ല. ഇന്ന് പൂജയാ."}, {"id": 95, "duration_s": 2.84, "emotion": "scared_whisper", "text": "ലൈവാണ്! സുരേഷിന്റെ പൂജ, എക്സ്ക്ലൂസീവ്!"}, {"id": 96, "duration_s": 2.9, "emotion": "serious", "text": "പിന്നെ ലീലാവതി... പ്രസാദം കഴിച്ചില്ല."}, {"id": 97, "duration_s": 1.32, "emotion": "curious", "text": "ഇതേത് അധ്യായമാ?"}, {"id": 98, "duration_s": 3.69, "emotion": "excited", "text": "ഇത്... പുതിയ ഭജനയാ! പഴം ഭജന!"}, {"id": 99, "duration_s": 1.18, "emotion": "shocked", "text": "കണ്ണു തട്ടി!"}, {"id": 100, "duration_s": 2.43, "emotion": "excited", "text": "അറിഞ്ഞോ? അമ്മച്ചിയുടെ ഡിസ്കോ ഭജന!"}, {"id": 101, "duration_s": 3.46, "emotion": "excited", "text": "നന്ദി! തൊണ്ണൂറ്റൊമ്പത് രൂപ!"}, {"id": 102, "duration_s": 0.95, "emotion": "shocked", "text": "പിന്നേം പോയോ?!"}, {"id": 103, "duration_s": 1.77, "emotion": "embarrassed", "text": "ഊ ഊ ആ ആ?"}, {"id": 104, "duration_s": 0.98, "emotion": "shouting", "text": "അന്വേഷണം!"}, {"id": 105, "duration_s": 0.67, "emotion": "shocked", "text": "അമ്മച്ചീ?!"}, {"id": 106, "duration_s": 0.68, "emotion": "curious", "text": "പറയട്ടെ?"}, {"id": 107, "duration_s": 0.7, "emotion": "shouting", "text": "പറ!"}, {"id": 108, "duration_s": 3.36, "emotion": "serious", "text": "നാനൂറ്റി തൊണ്ണൂറ്റൊമ്പത്... തൊള്ളായിരം തൊണ്ണൂറ്റൊമ്പത്..."}, {"id": 109, "duration_s": 3.06, "emotion": "serious", "text": "എല്ലാം ഈ ഫോണീന്ന്. പണം ചിറ്റപ്പന്റെ കാർഡീന്ന്."}, {"id": 110, "duration_s": 2.38, "emotion": "shocked", "text": "എന്റെ കാർഡോ? അമ്മയുടെ ഫോണിൽ?"}, {"id": 111, "duration_s": 3.85, "emotion": "sarcastic", "text": "നീ തന്നെയാ ഇട്ടത്! കറണ്ട് ബില്ലടയ്ക്കാൻ!"}, {"id": 112, "duration_s": 1.25, "emotion": "sad", "text": "ശ്ശൊ... മാറ്റാനും മറന്നു."}, {"id": 113, "duration_s": 3.17, "emotion": "guilty", "text": "അച്ഛാ... ആദ്യത്തെ തൊണ്ണൂറ്റൊമ്പത് ഞാനാ."}, {"id": 114, "duration_s": 3.54, "emotion": "guilty", "text": "നാനൂറ്റി തൊണ്ണൂറ്റൊമ്പത്... ഞങ്ങൾ രണ്ടും."}, {"id": 115, "duration_s": 2.135, "emotion": "guilty", "text": "ഗെയിമിലെ കാശ് വ്യാജമെന്ന് കരുതി."}, {"id": 116, "duration_s": 2.215, "emotion": "serious", "text": "കാശ് ശരിക്കുള്ളതാ. പഴമാ വ്യാജം."}, {"id": 117, "duration_s": 4.43, "emotion": "guilty", "text": "രാത്രി രണ്ടുമണിക്കുള്ളത്... ഞാനാ."}, {"id": 118, "duration_s": 1.73, "emotion": "shocked", "text": "രാത്രി രണ്ടു മണിക്കോ?!"}, {"id": 119, "duration_s": 1.44, "emotion": "pleading", "text": "കുരങ്ങന് വിശന്നതാ!"}, {"id": 120, "duration_s": 2.83, "emotion": "proud", "text": "കണ്ടോ! കള്ളൻ വിശന്നെന്ന് പറഞ്ഞില്ലേ!"}, {"id": 121, "duration_s": 3.07, "emotion": "proud", "text": "അമ്മച്ചിയും ഇടംകയ്യത്തി! സയൻസ്!"}, {"id": 122, "duration_s": 2.64, "emotion": "excited", "text": "അറിഞ്ഞോ? കള്ളൻ... അമ്മച്ചി!"}, {"id": 123, "duration_s": 2.83, "emotion": "proud", "text": "ഇനി ഞാൻ നോക്കാം! ഞാൻ ആരെയും—"}, {"id": 124, "duration_s": 1.89, "emotion": "determined", "text": "മതി! ഇനി ഞാൻ നോക്കാം."}, {"id": 125, "duration_s": 1.97, "emotion": "serious", "text": "ഒന്ന് - ഓരോ പേയ്‌മെന്റിനും പിൻ."}, {"id": 126, "duration_s": 2.08, "emotion": "serious", "text": "രണ്ട് - മാസത്തിൽ പരിധി."}, {"id": 127, "duration_s": 3.17, "emotion": "serious", "text": "മൂന്ന് - കാർഡ് മാറ്റൂ, ഓട്ടോ-പേ ഓഫ്."}, {"id": 128, "duration_s": 2.09, "emotion": "shocked", "text": "ഇത്രേയോ? പത്തു സെക്കൻഡിൽ?"}, {"id": 129, "duration_s": 2.48, "emotion": "pleading", "text": "അപ്പോ... ഞങ്ങടെ ഗെയിം?"}, {"id": 130, "duration_s": 3.58, "emotion": "calm", "text": "ദിവസം മുപ്പതു മിനിറ്റ്. പിന്നെ പുറത്ത് ക്രിക്കറ്റ്!"}, {"id": 131, "duration_s": 1.68, "emotion": "excited", "text": "ക്രിക്കറ്റ് കഴിഞ്ഞ് സമോസ?"}, {"id": 132, "duration_s": 1.03, "emotion": "worried", "text": "പോയ കാശോ?"}, {"id": 133, "duration_s": 3.02, "emotion": "calm", "text": "കമ്പനിക്ക് പരാതി അയക്കാം. ഇനി മുതൽ പിൻ!"}, {"id": 134, "duration_s": 4.26, "emotion": "calm", "text": "കുട്ടികൾക്ക് ഫോണിനെക്കാൾ... വേണ്ടത് നമ്മുടെ കൂടെയിരിപ്പാ."}, {"id": 135, "duration_s": 3.95, "emotion": "serious", "text": "ഫോണിന് പിൻ... കുട്ടികൾക്ക് സമയം."}, {"id": 136, "duration_s": 4.67, "emotion": "laughing", "text": "ഈ അമ്മച്ചീടെ ഫോണിന് ഡബിൾ പിൻ!"}, {"id": 137, "duration_s": 2.22, "emotion": "proud", "text": "ഞാൻ ആരെയും പേടിക്കില്ല! ബോൾ എറി!"}, {"id": 138, "duration_s": 3.89, "emotion": "mischievous", "text": "ഇടംകയ്യൻ. സയൻസ് പറയുന്നു."}, {"id": 139, "duration_s": 1.28, "emotion": "sad", "text": "ശ്ശൊ... ചെരുപ്പ് പോലെ തന്നെ."}, {"id": 140, "duration_s": 3.2, "emotion": "laughing", "text": "അമ്മച്ചിക്ക് പിഴയ്ക്കില്ല!"}]