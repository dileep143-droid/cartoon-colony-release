[{"id": 1, "duration_s": 5.82, "emotion": "mischievous", "text": "രാവിലെ ഏഴുമണി... കോളനിയിലെ എല്ലാ ഫോണും ഒരുമിച്ച് ചിലച്ചു."}, {"id": 2, "duration_s": 1.95, "emotion": "angry", "text": "കാശുകുട്ടപ്പൻ ലോണെടുത്തേ! പിരിവ് വരും!"}, {"id": 3, "duration_s": 2.29, "emotion": "excited", "text": "കുട്ടപ്പൻ കഥ... എനിക്കോ? <gasp>"}, {"id": 4, "duration_s": 3.24, "emotion": "scared_whisper", "text": "ഞാൻ വീട്ടിലില്ല... ഞാൻ അരിയാണ്."}, {"id": 5, "duration_s": 1.0, "emotion": "stern_warning", "text": "കുട്ടപ്പേട്ടാ!"}, {"id": 6, "duration_s": 4.04, "emotion": "mischievous", "text": "ഇതെല്ലാം തുടങ്ങിയത് തലേന്ന്... വെറും രണ്ട് മിനിറ്റിൽ."}, {"id": 7, "duration_s": 6.03, "emotion": "serious", "text": "തൊണ്ണൂറ്റെട്ട്, തൊണ്ണൂറ്റൊമ്പത്... വീണ്ടും എണ്ണ്. ഒരു രൂപ കുറയില്ല!"}, {"id": 8, "duration_s": 3.89, "emotion": "worried", "text": "കട ചെറുത്, വയറ് വലുത്... കട വലുതാക്കണം!"}, {"id": 9, "duration_s": 3.57, "emotion": "mischievous", "text": "വലിയ കടയോ? ഞാനിപ്പഴേ സ്ഥലമുണ്ടാക്കുവാ!"}, {"id": 10, "duration_s": 2.66, "emotion": "excited", "text": "രണ്ട് മിനിറ്റിൽ ലോൺ! പേപ്പറൊന്നും ബേണ്ട!"}, {"id": 11, "duration_s": 2.88, "emotion": "excited", "text": "രണ്ട് മിനിറ്റോ? എന്റെ ചായ പോലും തണുക്കില്ല!"}, {"id": 12, "duration_s": 3.615, "emotion": "curious", "text": "കുട്ടപ്പേട്ടാ, ലോണെന്നാൽ?"}, {"id": 13, "duration_s": 4.46, "emotion": "proud", "text": "ലോൺ എന്നാൽ... മറ്റുള്ളവരുടെ കാശ്, എന്റെ കട!"}, {"id": 14, "duration_s": 3.203, "emotion": "calm", "text": "ഇങ്ങടെ കോൺടാക്ട്സിന് അനുമതി മതി."}, {"id": 15, "duration_s": 3.77, "emotion": "happy", "text": "കോൺടാക്ട്സ് മാത്രമോ? എടുത്തോ! ഫ്രീയായിട്ട്!"}, {"id": 16, "duration_s": 1.36, "emotion": "calm", "text": "പിന്നെ ഫോട്ടോ ഗാലറീം കൂടി."}, {"id": 17, "duration_s": 4.94, "emotion": "giggly", "text": "ഫോട്ടോയും എടുത്തോ! എന്നെപ്പോലെ ഹീറോ ഉണ്ടോ?"}, {"id": 18, "duration_s": 3.17, "emotion": "calm", "text": "പിന്നെ ഈ നിബന്ധനകൾ... ഒന്ന് വായിച്ചോളീ."}, {"id": 19, "duration_s": 2.46, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? നിബന്ധന വായിക്കണം ചേട്ടാ!"}, {"id": 20, "duration_s": 3.44, "emotion": "sarcastic", "text": "വായിക്കാൻ സമയം പോകും. സമയമാണ് പണം!"}, {"id": 21, "duration_s": 2.78, "emotion": "excited", "text": "അഭിനന്ദനം! ലോൺ പാസ്സായി!"}, {"id": 22, "duration_s": 3.42, "emotion": "shocked", "text": "ഇരുപതിനായിരം... വന്നത് പതിമൂന്നോ?"}, {"id": 23, "duration_s": 2.22, "emotion": "happy", "text": "ഏഴായിരം പ്രോസസിങ് ഫീസ്, കുട്ടപ്പേട്ടാ!"}, {"id": 24, "duration_s": 3.33, "emotion": "worried", "text": "ഏഴ് ദിവസത്തിൽ തിരിച്ചടയ്ക്കണം... മുപ്പതിനായിരം!"}, {"id": 25, "duration_s": 4.17, "emotion": "proud", "text": "ഏഴ് ദിവസംകൊണ്ട് കട ഇരട്ടിയാകും!"}, {"id": 26, "duration_s": 4.29, "emotion": "proud", "text": "ഇന്നുമുതൽ ലോൺ കുട്ടപ്പൻ... ലോൺ മുതലാളി!"}, {"id": 27, "duration_s": 3.5, "emotion": "happy", "text": "ലോൺ? ആഹാ! പുല്ല് എവിടെ വയ്ക്കും കുട്ടപ്പാ?"}, {"id": 28, "duration_s": 3.68, "emotion": "sarcastic", "text": "പുല്ലല്ല മാഷേ! ലോൺ! കാശ്!"}, {"id": 29, "duration_s": 3.32, "emotion": "tired", "text": "അണ്ണാ, ഫ്രീസറ് വല്യതോ, വാതില് ചെറുതോ?"}, {"id": 30, "duration_s": 2.74, "emotion": "serious", "text": "കുട്ടപ്പേട്ടാ, ഇത്രേം കാശ് എവിടുന്ന്?"}, {"id": 31, "duration_s": 2.78, "emotion": "happy", "text": "ദൈവം തന്നതാ... രണ്ട് മിനിറ്റിൽ."}, {"id": 32, "duration_s": 2.21, "emotion": "excited", "text": "രണ്ട് മിനിറ്റിൽ കാശോ? ഇതെന്റെ സ്വപ്നമാ!"}, {"id": 33, "duration_s": 2.74, "emotion": "excited", "text": "ലൈവാണ്! കുട്ടപ്പേട്ടന്റെ പുതിയ ഫ്രീസർ!"}, {"id": 34, "duration_s": 4.32, "emotion": "mischievous", "text": "അന്ന് രാത്രി... പലിശ ഉറങ്ങിയില്ല. കാശു കുട്ടപ്പനും."}, {"id": 35, "duration_s": 6.38, "emotion": "worried", "text": "പന്ത്രണ്ട് മണി... ഇരുപത്തൊന്നായിരം!"}, {"id": 36, "duration_s": 0.7, "emotion": "panicked", "text": "ഒരു മണി... ഇരുപത്തിരണ്ടായിരം!"}, {"id": 37, "duration_s": 1.89, "emotion": "comic_panic", "text": "ഇത് പലിശയോ കറന്റ് ബില്ലോ?"}, {"id": 38, "duration_s": 3.47, "emotion": "scared_whisper", "text": "പ്രകാശാ! പലിശ ഓരോ മണിക്കൂറും കൂടുന്നു!"}, {"id": 39, "duration_s": 2.9, "emotion": "proud", "text": "സയൻസ് പറയുന്നു... പലിശയും രാത്രി ഉറങ്ങും."}, {"id": 40, "duration_s": 3.53, "emotion": "crying", "text": "പലിശ ഉറങ്ങില്ല പ്രകാശാ... ഞാനാ ഉറങ്ങാത്തത്!"}, {"id": 41, "duration_s": 2.75, "emotion": "tired", "text": "കുട്ടപ്പേട്ടാ... കണക്ക് നാളെ."}, {"id": 42, "duration_s": 2.99, "emotion": "mischievous", "text": "ആപ്പ് കുട്ടപ്പന്റെ എല്ലാ കോൺടാക്ടിനെയും വിളിച്ചു."}, {"id": 43, "duration_s": 3.56, "emotion": "proud", "text": "ആരാത്? ഞാൻ ആരെയും പേടിക്കില്ല!"}, {"id": 44, "duration_s": 2.73, "emotion": "shouting", "text": "കുട്ടപ്പന്റെ കാശടയ്ക്ക്, ഇല്ലേൽ ഫോട്ടോ എല്ലാർക്കും പോകും!"}, {"id": 45, "duration_s": 2.28, "emotion": "sarcastic", "text": "ഫോണാ ചേട്ടാ, പല്ലിയല്ല."}, {"id": 46, "duration_s": 7.16, "emotion": "angry", "text": "എല്ലാർക്കും ഫോൺ വന്നു, എനിക്ക് മാത്രമില്ലേ? കുട്ടപ്പൻ എന്റെ നമ്പർ വച്ചില്ലേ?"}, {"id": 47, "duration_s": 3.81, "emotion": "proud", "text": "വന്നു! ഹലോ? ഞാൻ തന്നെ... കോളനി മുഴുവൻ കാണട്ടെ!"}, {"id": 48, "duration_s": 1.6, "emotion": "worried", "text": "ഫോണിന് കണ്ണ് തട്ടി!"}, {"id": 49, "duration_s": 4.647, "emotion": "shouting", "text": "അന്വേഷിക്കും! ...ആരെ?"}, {"id": 50, "duration_s": 3.77, "emotion": "tired", "text": "ഫോൺ ബെല്ലടിച്ചു, ഓട്ടോ നിന്നു. ശ്ശൊ..."}, {"id": 51, "duration_s": 1.18, "emotion": "stern_warning", "text": "മിണ്ടരുത്!"}, {"id": 52, "duration_s": 3.04, "emotion": "excited", "text": "മുപ്പത് കൊല്ലമായി കുട്ടപ്പന്റെ ഒരു വാർത്തയും കിട്ടിയിട്ട്!"}, {"id": 53, "duration_s": 2.0, "emotion": "mischievous", "text": "അറിഞ്ഞോ? കുട്ടപ്പൻ ലോണെടുത്തു!"}, {"id": 54, "duration_s": 2.53, "emotion": "sarcastic", "text": "അറിയാം. എനിക്കും ഫോൺ വന്നിരുന്നു."}, {"id": 55, "duration_s": 1.45, "emotion": "excited", "text": "അറിഞ്ഞോ? കുട്ടപ്പൻ—"}, {"id": 56, "duration_s": 2.16, "emotion": "calm", "text": "അറിയാം. നാരങ്ങയും കെട്ടി."}, {"id": 57, "duration_s": 1.4, "emotion": "pleading", "text": "അറിഞ്ഞോ...?"}, {"id": 58, "duration_s": 2.72, "emotion": "giggly", "text": "അറിയാം ചേച്ചീ! കോളനി മുഴുവനറിയാം!"}, {"id": 59, "duration_s": 3.92, "emotion": "mischievous", "text": "ഹലോ, ലോൺകാരേ? കുട്ടപ്പൻ വേറെ എന്തെടുത്തു?"}, {"id": 60, "duration_s": 2.6, "emotion": "surprised", "text": "ചേച്ചി പിരിവിന് ഇറങ്ങുവാണോ?"}, {"id": 61, "duration_s": 2.66, "emotion": "giggly", "text": "അല്ല മോനേ, ഞാൻ വാർത്തയേ പിരിക്കൂ."}, {"id": 62, "duration_s": 2.31, "emotion": "angry", "text": "കുട്ടപ്പേട്ടാ! കോളനിയെന്താ പറയുന്നേ?!"}, {"id": 63, "duration_s": 2.15, "emotion": "serious", "text": "കുട്ടപ്പൻ എവിടെ?"}, {"id": 64, "duration_s": 2.33, "emotion": "giggly", "text": "അരിച്ചാക്കിൽ!"}, {"id": 65, "duration_s": 2.5, "emotion": "scared_whisper", "text": "കല്യാണീ... ഞാൻ ചാക്കിലല്ല."}, {"id": 66, "duration_s": 2.588, "emotion": "guilty", "text": "രണ്ടു മിനിറ്റ് ലോണല്ലേ, ബിന്ദൂ."}, {"id": 67, "duration_s": 3.31, "emotion": "sarcastic", "text": "രണ്ട് മിനിറ്റിന്റെ ലോൺ... കോളനി മുഴുവൻ ഫോൺ വിളിയും?"}, {"id": 68, "duration_s": 2.86, "emotion": "pleading", "text": "അവർ എന്റെ ഫോട്ടോ എടുത്തു. എല്ലാർക്കും അയയ്ക്കും!"}, {"id": 69, "duration_s": 2.84, "emotion": "laughing", "text": "ഇത് അച്ഛൻ ഉണ്ണിയപ്പം തിന്നുന്ന ഫോട്ടോയാ!"}, {"id": 70, "duration_s": 1.55, "emotion": "determined", "text": "ഇനി കണക്ക് ഞാൻ."}, {"id": 71, "duration_s": 2.41, "emotion": "excited", "text": "ടെൻഷൻ വേണ്ട! എന്റെ കയ്യിൽ വേറെ ആപ്പുണ്ട്!"}, {"id": 72, "duration_s": 1.78, "emotion": "proud", "text": "ലോൺ അടയ്ക്കാൻ... പുതിയ ലോൺ!"}, {"id": 73, "duration_s": 4.383, "emotion": "excited", "text": "സത്യമോ? എത്ര മിനിറ്റിൽ?"}, {"id": 74, "duration_s": 0.93, "emotion": "comic_panic", "text": "...ഞാൻ തമാശ പറഞ്ഞതാ."}, {"id": 75, "duration_s": 3.62, "emotion": "angry", "text": "കടത്തിന് മേൽ കടമോ? നിൽക്ക് ശിബൂ!"}, {"id": 76, "duration_s": 1.98, "emotion": "embarrassed", "text": "അമ്മിണിയമ്മച്ചീടെ ഏറ്... പിഴയ്ക്കില്ല."}, {"id": 77, "duration_s": 1.79, "emotion": "determined", "text": "മതി! ഇനി ഞാൻ നോക്കാം."}, {"id": 78, "duration_s": 3.58, "emotion": "serious", "text": "ആദ്യം തെളിവ്. ഓരോ ഭീഷണിയുടെയും സ്ക്രീൻഷോട്ട്."}, {"id": 79, "duration_s": 3.5, "emotion": "calm", "text": "പിന്നെ കോൺടാക്ട്സും ഫോട്ടോയും... അനുമതി ഓഫ്."}, {"id": 80, "duration_s": 1.89, "emotion": "shocked", "text": "പക്ഷേ ഫ്രീയായിട്ട് കൊടുത്തതാ!"}, {"id": 81, "duration_s": 0.7, "emotion": "shouting", "text": "മിണ്ടരുത്!"}, {"id": 82, "duration_s": 2.53, "emotion": "excited", "text": "എനിക്കൊരു ഐഡിയ! ശരിക്കുള്ള ബാങ്കിൽ പോകാം!"}, {"id": 83, "duration_s": 5.24, "emotion": "proud", "text": "ഞാൻ പറയാം! ഒന്ന് ഒൻപത് മൂന്ന് പൂജ്യം, പരാതി!"}, {"id": 84, "duration_s": 2.87, "emotion": "worried", "text": "ബാങ്കോ? അവിടിരിക്കാനും ഫീസുണ്ടാകും!"}, {"id": 85, "duration_s": 1.23, "emotion": "stern_warning", "text": "നടക്ക്!"}, {"id": 86, "duration_s": 1.26, "emotion": "happy", "text": "പോകാം, വാ!"}, {"id": 87, "duration_s": 5.34, "emotion": "sarcastic", "text": "കുട്ടപ്പേട്ടാ, വയറൊന്ന് മാറ്റൂ... പലിശയോടെ."}, {"id": 88, "duration_s": 1.35, "emotion": "tired", "text": "<sigh> ഇത് അത്യാവശ്യത്തിനേ പണിമുടക്കൂ."}, {"id": 89, "duration_s": 2.46, "emotion": "stern_warning", "text": "ആഞ്ഞു തള്ള്! ഞാൻ എണ്ണുന്നുണ്ട്!"}, {"id": 90, "duration_s": 3.22, "emotion": "scared_whisper", "text": "ആദ്യമേ പറഞ്ഞേക്ക്... ഇരിക്കാൻ ഫീസില്ലല്ലോ?"}, {"id": 91, "duration_s": 3.58, "emotion": "calm", "text": "മാഡം, ആപ്പ് ദിവസവും പലിശ കൂട്ടും, ഭീഷണിയും."}, {"id": 92, "duration_s": 3.64, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? ആപ്പിന് കോൺടാക്ട്, ഫോട്ടോ കൊടുക്കരുത്."}, {"id": 93, "duration_s": 2.98, "emotion": "serious", "text": "കടം ബാങ്കിൽ, അല്ലേൽ ആർബിഐ അംഗീകൃതം."}, {"id": 94, "duration_s": 3.05, "emotion": "guilty", "text": "അപ്പോ എന്റെ ആപ്പ്... രജിസ്റ്റർ ആണോ?"}, {"id": 95, "duration_s": 3.28, "emotion": "proud", "text": "ഭീഷണിയോ? ഒന്ന് ഒൻപത് മൂന്ന് പൂജ്യം വിളിക്ക്!"}, {"id": 96, "duration_s": 3.13, "emotion": "calm", "text": "സൈബർ ക്രൈം ഹെൽപ്പ്ലൈൻ. പറയൂ, എന്നാ ഉണ്ടായേ?"}, {"id": 97, "duration_s": 3.42, "emotion": "serious", "text": "ലോൺ ആപ്പ് ഭീഷണിപ്പെടുത്തുന്നു. സ്ക്രീൻഷോട്ടെല്ലാം ഞങ്ങളുടെ കയ്യിലുണ്ട്."}, {"id": 98, "duration_s": 3.82, "emotion": "calm", "text": "നന്നായി കൊച്ചേ. പരാതി എടുത്തിട്ടൊണ്ട്, നമ്പർ മെസേജിൽ വരും."}, {"id": 99, "duration_s": 1.92, "emotion": "worried", "text": "പിന്നെ... വല്ല ഫീസും?"}, {"id": 100, "duration_s": 0.98, "emotion": "calm", "text": "ഫീസൊന്നുമില്ല."}, {"id": 101, "duration_s": 3.2, "emotion": "happy", "text": "കടയ്ക്ക് ശരിയായ ലോൺ, ശരിയായ കടലാസുകളോടെ."}, {"id": 102, "duration_s": 3.02, "emotion": "happy", "text": "മാഡം, ഈ ഉപദേശം... ഒരു രൂപ കുറയില്ല!"}, {"id": 103, "duration_s": 3.54, "emotion": "calm", "text": "വൈകിട്ട് കാശു കുട്ടപ്പൻ ഭാഗവത പാരായണം വച്ചു."}, {"id": 104, "duration_s": 2.84, "emotion": "pleading", "text": "ഭഗവാനേ, ഇന്ന് ഒരു ഫോണും അടിക്കല്ലേ."}, {"id": 105, "duration_s": 4.07, "emotion": "serious", "text": "ഭാഗവതത്തിലെ ഒന്നാം അധ്യായം... ശ്രദ്ധിച്ച് കേൾക്കൂ."}, {"id": 106, "duration_s": 2.37, "emotion": "scared_whisper", "text": "വന്നല്ലോ... പിരിവുകാർ!"}, {"id": 107, "duration_s": 3.39, "emotion": "excited", "text": "പ്ലാൻ ഓർമയുണ്ടല്ലോ? മൂന്ന്... രണ്ട്... ഒന്ന്!"}, {"id": 108, "duration_s": 1.35, "emotion": "calm", "text": "കുട്ടപ്പേട്ടൻ പ്രാർത്ഥനയിലാണ്!"}, {"id": 109, "duration_s": 1.91, "emotion": "angry", "text": "പ്രാർത്ഥനയോ? കാശെപ്പം?!"}, {"id": 110, "duration_s": 4.22, "emotion": "proud", "text": "പരാതി ഒന്ന് ഒൻപത് മൂന്ന് പൂജ്യത്തിൽ! കോളനി സാക്ഷി!"}, {"id": 111, "duration_s": 2.279, "emotion": "proud", "text": "ഞാനോ... ആരെയും പേടിക്കില്ല!"}, {"id": 112, "duration_s": 2.97, "emotion": "sarcastic", "text": "ഭീഷണിയെ പേടിച്ചില്ല... പല്ലിയെ പേടിച്ചു."}, {"id": 113, "duration_s": 3.69, "emotion": "mischievous", "text": "മോനേ, നിന്റെ പേരെന്താ? നാളെ കോളനി മുഴുവൻ അറിയും."}, {"id": 114, "duration_s": 5.168, "emotion": "serious", "text": "എല്ലാ ഫോണിനും കണ്ണ് തട്ടി!"}, {"id": 115, "duration_s": 4.457, "emotion": "excited", "text": "പ്രസാദം? ...അന്വേഷണം!"}, {"id": 116, "duration_s": 2.41, "emotion": "guilty", "text": "വിശക്കുന്നു! ഭഗവാൻ പൊറുക്കും."}, {"id": 117, "duration_s": 3.02, "emotion": "excited", "text": "ലൈവാണ്! ലോകത്തെ ആദ്യ ആന്റി-ലോൺ ഭജന!"}, {"id": 118, "duration_s": 0.86, "emotion": "shouting", "text": "മിണ്ടരുത്!"}, {"id": 119, "duration_s": 2.82, "emotion": "calm", "text": "ഭാഗവതം... ഒന്നാം അധ്യായം."}, {"id": 120, "duration_s": 2.57, "emotion": "loving", "text": "കുട്ടപ്പേട്ടാ, ഇനി ഒറ്റയ്ക്കല്ല കേട്ടോ."}, {"id": 121, "duration_s": 3.5, "emotion": "tender", "text": "കോളനി മുഴുവനുമുണ്ട്... ഫീസൊന്നുമില്ല."}, {"id": 122, "duration_s": 4.36, "emotion": "calm", "text": "പിറ്റേന്ന് രാവിലെ... കോളനിയിൽ ഒരു ഫോണും ചിലച്ചില്ല."}, {"id": 123, "duration_s": 4.65, "emotion": "proud", "text": "അന്വേഷണം കഴിഞ്ഞു! സൈബർ സെൽ പരാതി രജിസ്റ്റർ ചെയ്തു."}, {"id": 124, "duration_s": 4.25, "emotion": "serious", "text": "ആപ്പ് റിപ്പോർട്ട് ചെയ്തു. ഭീഷണി ഫോൺ നിർത്തി."}, {"id": 125, "duration_s": 2.25, "emotion": "excited", "text": "അപ്പോ... മുപ്പതിനായിരം കൊടുക്കണ്ടേ?"}, {"id": 126, "duration_s": 4.03, "emotion": "serious", "text": "ഭീഷണിക്ക് പലിശയില്ല. കിട്ടിയത് മാത്രം തിരിച്ചടയ്ക്ക്."}, {"id": 127, "duration_s": 4.4, "emotion": "sad", "text": "പതിമൂവായിരം... മുഴുവൻ. ഒരു രൂപ കുറയില്ല..."}, {"id": 128, "duration_s": 4.12, "emotion": "determined", "text": "കോൺടാക്ട്സ് എന്റേത്, ഫോട്ടോ എന്റേത്. ഒരു ആപ്പിന്റെയുമല്ല!"}, {"id": 129, "duration_s": 3.64, "emotion": "proud", "text": "സയൻസ് പറയുന്നു, ആപ്പ് ഡിലീറ്റായാൽ ലോണും ഡിലീറ്റ്!"}, {"id": 130, "duration_s": 4.36, "emotion": "serious", "text": "ഞാൻ പറയട്ടെ? ശരിക്കുള്ള കടം തിരിച്ചടയ്ക്കണം. ഭീഷണി സഹിക്കരുത്."}, {"id": 131, "duration_s": 3.78, "emotion": "proud", "text": "കട വലുതാകും... ബാങ്കിൽ നിന്ന്, ശരിയായ കടലാസുകളോടെ!"}, {"id": 132, "duration_s": 4.67, "emotion": "guilty", "text": "അപ്പൂപ്പാ, രണ്ട് മിനിറ്റിന്റെ ലോൺ... രണ്ട് ദിവസം കരയിച്ചു."}, {"id": 133, "duration_s": 2.7, "emotion": "calm", "text": "ധൃതിപ്പണം... ഏറെ നേരം കരയിക്കും."}, {"id": 134, "duration_s": 7.3, "emotion": "serious", "text": "കടം ബാങ്കിൽ, അല്ലേൽ ആർബിഐ അംഗീകൃതം. നിബന്ധന വായിക്കണം."}, {"id": 135, "duration_s": 7.05, "emotion": "stern_warning", "text": "ആപ്പിന് ഫോട്ടോ വേണ്ട! ഭീഷണി? ഒന്ന് ഒൻപത് മൂന്ന് പൂജ്യം."}, {"id": 136, "duration_s": 2.36, "emotion": "happy", "text": "'സമയമാണ് പണം' അല്ല... 'വായനയാണ് പണം'!"}, {"id": 137, "duration_s": 3.2, "emotion": "happy", "text": "ഒരക്ഷരം കുറയില്ല... മുഴുവൻ വായിക്കും!"}, {"id": 138, "duration_s": 1.33, "emotion": "excited", "text": "രണ്ട് മിനിറ്റിൽ ലോൺ!"}, {"id": 139, "duration_s": 1.82, "emotion": "happy", "text": "കോളനിക്കഥകൾ... വീണ്ടും കാണാം!"}]