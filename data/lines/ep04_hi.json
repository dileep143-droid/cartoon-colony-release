[{"id": 1, "duration_s": 4.8, "emotion": "calm", "text": "रविवार की शाम। शर्मा जी के घर सत्यनारायण की कथा।"}, {"id": 2, "duration_s": 1.99, "emotion": "excited", "text": "बनाना किंगडम! ऊ ऊ आ आ!"}, {"id": 3, "duration_s": 1.88, "emotion": "excited", "text": "सिर्फ़ निन्यानवे रुपये!"}, {"id": 4, "duration_s": 1.08, "emotion": "shocked", "text": "फिर से कटे?!"}, {"id": 5, "duration_s": 2.106, "emotion": "embarrassed", "text": "ऊ ऊ आ आ?"}, {"id": 6, "duration_s": 3.23, "emotion": "mischievous", "text": "ये सब शुरू हुआ था... तीन दिन पहले।"}, {"id": 7, "duration_s": 1.94, "emotion": "mischievous", "text": "एक केले वाले गेम से।"}, {"id": 8, "duration_s": 3.07, "emotion": "angry", "text": "छोटू! ये फ़ोन 'गुड मॉर्निंग' भेज ही नहीं रहा!"}, {"id": 9, "duration_s": 1.99, "emotion": "proud", "text": "हो गया। चौदह ग्रुप में भेज दिया।"}, {"id": 10, "duration_s": 1.9, "emotion": "proud", "text": "पूरी कॉलोनी देखेगी!"}, {"id": 11, "duration_s": 1.99, "emotion": "excited", "text": "दादी! उसमें बंदर वाला गेम है!"}, {"id": 12, "duration_s": 3.4, "emotion": "tired", "text": "पाँच मिनट खेलो। मैं बस आँख बंद करके..."}, {"id": 13, "duration_s": 2.92, "emotion": "excited", "text": "बनाना किंगडम में आपका स्वागत है!"}, {"id": 14, "duration_s": 3.63, "emotion": "excited", "text": "केले ख़त्म! सिर्फ़ निन्यानवे रुपये में सौ केले!"}, {"id": 15, "duration_s": 2.75, "emotion": "curious", "text": "निन्यानवे रुपये? असली वाले?"}, {"id": 16, "duration_s": 2.3, "emotion": "mischievous", "text": "पागल! गेम के पैसे नकली होते हैं।"}, {"id": 17, "duration_s": 1.44, "emotion": "mischievous", "text": "एक आइडिया है!"}, {"id": 18, "duration_s": 2.59, "emotion": "excited", "text": "आवाज़ सुनी? हमें पैसे मिल रहे हैं!"}, {"id": 19, "duration_s": 2.21, "emotion": "laughing", "text": "एक और! <laugh> एक और!"}, {"id": 20, "duration_s": 3.74, "emotion": "happy", "text": "पूरी कॉलोनी... देखेगी..."}, {"id": 21, "duration_s": 4.6, "emotion": "excited", "text": "शाबाश! आप हैं केला किंगडम के राजा!"}, {"id": 22, "duration_s": 4.01, "emotion": "calm", "text": "उसी सुबह। बरामदे में रमेश जी का आराम।"}, {"id": 23, "duration_s": 3.26, "emotion": "proud", "text": "मेरा बैंक अकाउंट... लोहे की तिजोरी है, टिंकू!"}, {"id": 24, "duration_s": 1.39, "emotion": "sarcastic", "text": "तिजोरी में कुछ है भी?"}, {"id": 25, "duration_s": 3.02, "emotion": "neutral", "text": "निन्यानवे कटे? चलो... चाय का ख़र्चा।"}, {"id": 26, "duration_s": 2.41, "emotion": "shocked", "text": "चार सौ निन्यानवे?!"}, {"id": 27, "duration_s": 1.55, "emotion": "curious", "text": "भैया, तिजोरी में छेद है।"}, {"id": 28, "duration_s": 4.38, "emotion": "panicked", "text": "नौ सौ निन्यानवे! ये चोर नहीं... डाकू है!"}, {"id": 29, "duration_s": 2.1, "emotion": "excited", "text": "टेंशन मत लो! फ़ोन ही बेच दो!"}, {"id": 30, "duration_s": 2.42, "emotion": "determined", "text": "मैं किसी से नहीं डरता! उस चोर को मैं..."}, {"id": 31, "duration_s": 1.13, "emotion": "comic_panic", "text": "छिप... छिपकली!"}, {"id": 32, "duration_s": 2.6, "emotion": "sarcastic", "text": "किसी से नहीं डरते? छिपकली से भी नहीं?"}, {"id": 33, "duration_s": 3.62, "emotion": "embarrassed", "text": "वो... चोर की जासूस थी! ख़ुफ़िया!"}, {"id": 34, "duration_s": 2.17, "emotion": "calm", "text": "बस! अब मैं देखती—"}, {"id": 35, "duration_s": 1.61, "emotion": "shouting", "text": "नहीं! ये पुलिस केस है!"}, {"id": 36, "duration_s": 2.78, "emotion": "scared_whisper", "text": "हैलो, थाना? मेरा अकाउंट... लुट रहा है!"}, {"id": 37, "duration_s": 3.97, "emotion": "serious", "text": "जाँच होगी! पूरी जाँच होगी!"}, {"id": 38, "duration_s": 2.88, "emotion": "panicked", "text": "साहब, चोर दिखता नहीं... बस पैसे काटता है!"}, {"id": 39, "duration_s": 4.603, "emotion": "curious", "text": "हम्म... सुराग़ की ख़ुशबू।"}, {"id": 40, "duration_s": 6.74, "emotion": "serious", "text": "चोर कब आता है? क्या पहनता है? चटनी कहाँ है?"}, {"id": 41, "duration_s": 4.618, "emotion": "embarrassed", "text": "भूख लगी है!"}, {"id": 42, "duration_s": 6.68, "emotion": "serious", "text": "लिखो... चोर... भूखा है।"}, {"id": 43, "duration_s": 2.454, "emotion": "curious", "text": "भूखा? ये कैसे पता चला?"}, {"id": 44, "duration_s": 2.44, "emotion": "proud", "text": "पकौड़े ख़त्म हो गए ना!"}, {"id": 45, "duration_s": 2.11, "emotion": "pleading", "text": "साहब? साहब! चोर!"}, {"id": 46, "duration_s": 1.15, "emotion": "sarcastic", "text": "एक पकौड़ा और?"}, {"id": 47, "duration_s": 2.25, "emotion": "excited", "text": "जाँच होगी!"}, {"id": 48, "duration_s": 7.257, "emotion": "serious", "text": "थाने जाकर रिपोर्ट खाऊँगा। मतलब... लिखूँगा।"}, {"id": 49, "duration_s": 4.862, "emotion": "sad", "text": "<sigh> चोर भी भूखा... हवलदार भी भूखा।"}, {"id": 50, "duration_s": 3.66, "emotion": "mischievous", "text": "एक घंटे में... ख़बर पूरी कॉलोनी में।"}, {"id": 51, "duration_s": 1.99, "emotion": "excited", "text": "सुना क्या? शर्मा जी के फ़ोन में चोर!"}, {"id": 52, "duration_s": 1.88, "emotion": "scared_whisper", "text": "सुना क्या? चोर अदृश्य है!"}, {"id": 53, "duration_s": 1.82, "emotion": "shocked", "text": "सुना क्या? चोर बंदर है!"}, {"id": 54, "duration_s": 1.02, "emotion": "proud", "text": "साइंस कहता है..."}, {"id": 55, "duration_s": 2.42, "emotion": "serious", "text": "चोर... लेफ़्ट-हैंडेड है!"}, {"id": 56, "duration_s": 0.97, "emotion": "curious", "text": "कैसे पता?"}, {"id": 57, "duration_s": 2.671, "emotion": "proud", "text": "पैसा हमेशा बाएँ हाथ से जाता है!"}, {"id": 58, "duration_s": 0.86, "emotion": "stern_warning", "text": "सेठ जी!"}, {"id": 59, "duration_s": 3.49, "emotion": "serious", "text": "मेरा बायाँ हाथ सिर्फ़ गिनता है। एक रुपया भी कम नहीं!"}, {"id": 60, "duration_s": 4.21, "emotion": "serious", "text": "नज़र लग गई! हर फ़ोन को नींबू-मिर्ची!"}, {"id": 61, "duration_s": 2.2, "emotion": "excited", "text": "लाइव चल रहा है! कॉलोनी में चोर!"}, {"id": 62, "duration_s": 2.79, "emotion": "determined", "text": "चलो, चलते हैं! चोर पकड़ने!"}, {"id": 63, "duration_s": 2.75, "emotion": "embarrassed", "text": "<sigh> चोर पैदल ही पकड़ेंगे।"}, {"id": 64, "duration_s": 2.94, "emotion": "comic_panic", "text": "उन्नीस सौ निन्यानवे! अभी! यहीं!"}, {"id": 65, "duration_s": 1.0, "emotion": "shocked", "text": "चोर हमारे बीच है!"}, {"id": 66, "duration_s": 0.705, "emotion": "shouting", "text": "तुम! नहीं, तुम!"}, {"id": 67, "duration_s": 0.98, "emotion": "shouting", "text": "चुप!"}, {"id": 68, "duration_s": 4.71, "emotion": "curious", "text": "मैं बताऊँ? चोर शायद घर का ही..."}, {"id": 69, "duration_s": 1.32, "emotion": "shouting", "text": "नहीं!"}, {"id": 70, "duration_s": 1.84, "emotion": "sarcastic", "text": "बच्चे साइंस नहीं समझते!"}, {"id": 71, "duration_s": 4.03, "emotion": "scared_whisper", "text": "रात के दो बजे। पूरी कॉलोनी सो रही है..."}, {"id": 72, "duration_s": 1.26, "emotion": "mischievous", "text": "...लगभग पूरी।"}, {"id": 73, "duration_s": 2.5, "emotion": "scared_whisper", "text": "बस एक लेवल और... फिर सो जाऊँगी।"}, {"id": 74, "duration_s": 1.54, "emotion": "scared_whisper", "text": "शश्श्श! बंदर भूखा है।"}, {"id": 75, "duration_s": 1.98, "emotion": "scared_whisper", "text": "चोर... घर के अंदर है!"}, {"id": 76, "duration_s": 2.3, "emotion": "scared_whisper", "text": "मैं किसी से नहीं डरता... मैं किसी से..."}, {"id": 77, "duration_s": 1.25, "emotion": "scared_whisper", "text": "कौन है? हाथ ऊपर!"}, {"id": 78, "duration_s": 4.0, "emotion": "angry", "text": "रात को टॉर्च?!"}, {"id": 79, "duration_s": 4.963, "emotion": "embarrassed", "text": "माँ... आपने कोई चोर देखा?"}, {"id": 80, "duration_s": 1.91, "emotion": "tired", "text": "चोर? <short pause> यहाँ तो बस मैं हूँ।"}, {"id": 81, "duration_s": 3.75, "emotion": "relieved", "text": "हाँ... आप तो सो रही हो।"}, {"id": 82, "duration_s": 3.88, "emotion": "serious", "text": "कॉलोनी में चोर घूम रहा है। एक रुपया भी कम नहीं!"}, {"id": 83, "duration_s": 0.87, "emotion": "excited", "text": "टेंशन मत लो!"}, {"id": 84, "duration_s": 3.03, "emotion": "mischievous", "text": "गेम हैक! अनलिमिटेड केले! सिर्फ़ दो सौ में!"}, {"id": 85, "duration_s": 3.33, "emotion": "curious", "text": "दो सौ नहीं हैं... दो समोसे हैं।"}, {"id": 86, "duration_s": 1.37, "emotion": "happy", "text": "चलेगा! डील पक्की!"}, {"id": 87, "duration_s": 1.68, "emotion": "shocked", "text": "अरे! पेमेंट ही खा गया!"}, {"id": 88, "duration_s": 3.27, "emotion": "stern_warning", "text": "गेम हैक? मैं दिखाऊँ असली हैक?"}, {"id": 89, "duration_s": 2.07, "emotion": "pleading", "text": "भाभी... ये तो समाज सेवा थी!"}, {"id": 90, "duration_s": 2.4, "emotion": "excited", "text": "दो सौ? उसमें मेरा दस परसेंट!"}, {"id": 91, "duration_s": 1.572, "emotion": "stern_warning", "text": "सेठ जी!"}, {"id": 92, "duration_s": 1.1, "emotion": "happy", "text": "हैक बढ़िया था।"}, {"id": 93, "duration_s": 4.53, "emotion": "calm", "text": "तीन दिन बाद। वही पूजा... जहाँ से हमने शुरू किया।"}, {"id": 94, "duration_s": 3.31, "emotion": "scared_whisper", "text": "आज कोई ख़र्चा नहीं होगा। आज पूजा है।"}, {"id": 95, "duration_s": 3.16, "emotion": "scared_whisper", "text": "लाइव चल रहा है! शर्मा पूजा, एक्सक्लूसिव!"}, {"id": 96, "duration_s": 4.19, "emotion": "serious", "text": "और फिर लीलावती ने... प्रसाद नहीं खाया।"}, {"id": 97, "duration_s": 2.32, "emotion": "curious", "text": "ये कौन सा अध्याय है?"}, {"id": 98, "duration_s": 5.3, "emotion": "excited", "text": "ये... नया भजन है! केला भजन!"}, {"id": 99, "duration_s": 1.13, "emotion": "shocked", "text": "नज़र लग गई!"}, {"id": 100, "duration_s": 2.26, "emotion": "excited", "text": "सुना क्या? दादी का डिस्को भजन!"}, {"id": 101, "duration_s": 2.96, "emotion": "excited", "text": "धन्यवाद! निन्यानवे रुपये!"}, {"id": 102, "duration_s": 0.99, "emotion": "shocked", "text": "फिर से कटे?!"}, {"id": 103, "duration_s": 1.94, "emotion": "embarrassed", "text": "ऊ ऊ आ आ?"}, {"id": 104, "duration_s": 2.2, "emotion": "shouting", "text": "जाँच होगी!"}, {"id": 105, "duration_s": 0.9, "emotion": "shocked", "text": "दादी?!"}, {"id": 106, "duration_s": 0.77, "emotion": "curious", "text": "मैं बताऊँ?"}, {"id": 107, "duration_s": 0.82, "emotion": "shouting", "text": "बताओ!"}, {"id": 108, "duration_s": 4.42, "emotion": "serious", "text": "निन्यानवे... चार सौ निन्यानवे... नौ सौ निन्यानवे..."}, {"id": 109, "duration_s": 4.11, "emotion": "serious", "text": "सब इसी फ़ोन से। पेमेंट रमेश चाचा के कार्ड से।"}, {"id": 110, "duration_s": 2.24, "emotion": "shocked", "text": "मेरा कार्ड? दादी के फ़ोन में?"}, {"id": 111, "duration_s": 2.83, "emotion": "sarcastic", "text": "तूने ही डाला था! बिजली का बिल भरने!"}, {"id": 112, "duration_s": 1.99, "emotion": "sad", "text": "<sigh> और हटाना भूल गया।"}, {"id": 113, "duration_s": 3.01, "emotion": "guilty", "text": "पापा... पहले वाले निन्यानवे... मैंने दबाए।"}, {"id": 114, "duration_s": 2.5, "emotion": "guilty", "text": "और चार सौ निन्यानवे... हम दोनों ने।"}, {"id": 115, "duration_s": 2.83, "emotion": "guilty", "text": "हमें लगा गेम के पैसे नकली हैं।"}, {"id": 116, "duration_s": 3.58, "emotion": "serious", "text": "पैसे असली थे। बस केले नकली थे।"}, {"id": 117, "duration_s": 3.73, "emotion": "guilty", "text": "और रात दो बजे वाले... मैंने।"}, {"id": 118, "duration_s": 1.4, "emotion": "shocked", "text": "रात को दो बजे?!"}, {"id": 119, "duration_s": 1.8, "emotion": "pleading", "text": "बंदर भूखा था!"}, {"id": 120, "duration_s": 4.45, "emotion": "proud", "text": "देखा! मैंने कहा था, चोर भूखा है!"}, {"id": 121, "duration_s": 2.76, "emotion": "proud", "text": "और दादी लेफ़्ट-हैंडेड हैं! साइंस कहता है!"}, {"id": 122, "duration_s": 3.07, "emotion": "excited", "text": "सुना क्या? चोर... दादी निकली!"}, {"id": 123, "duration_s": 2.12, "emotion": "proud", "text": "अब मैं सँभालता हूँ! मैं किसी से—"}, {"id": 124, "duration_s": 1.73, "emotion": "determined", "text": "बस! अब मैं देखती हूँ।"}, {"id": 125, "duration_s": 2.08, "emotion": "serious", "text": "एक - हर पेमेंट पर पिन।"}, {"id": 126, "duration_s": 1.9, "emotion": "serious", "text": "दो - महीने की लिमिट।"}, {"id": 127, "duration_s": 2.49, "emotion": "serious", "text": "तीन - कार्ड हटाओ, ऑटो-पे बंद।"}, {"id": 128, "duration_s": 1.61, "emotion": "shocked", "text": "बस? दस सेकंड में?"}, {"id": 129, "duration_s": 1.59, "emotion": "pleading", "text": "और... हमारा गेम?"}, {"id": 130, "duration_s": 2.73, "emotion": "calm", "text": "रोज़ तीस मिनट। फिर बाहर क्रिकेट!"}, {"id": 131, "duration_s": 1.27, "emotion": "excited", "text": "क्रिकेट के बाद समोसे?"}, {"id": 132, "duration_s": 1.29, "emotion": "worried", "text": "और जो पैसे गए?"}, {"id": 133, "duration_s": 3.64, "emotion": "calm", "text": "कंपनी को शिकायत भेजेंगे। और आगे से... पिन!"}, {"id": 134, "duration_s": 3.81, "emotion": "calm", "text": "बच्चों को फ़ोन से ज़्यादा... हमारा साथ चाहिए।"}, {"id": 135, "duration_s": 2.65, "emotion": "serious", "text": "फ़ोन में पिन... बच्चों के साथ टाइम।"}, {"id": 136, "duration_s": 4.268, "emotion": "laughing", "text": "और दादी के फ़ोन में डबल पिन!"}, {"id": 137, "duration_s": 3.03, "emotion": "proud", "text": "मैं किसी से नहीं डरता! फेंको बॉल!"}, {"id": 138, "duration_s": 4.452, "emotion": "mischievous", "text": "लेफ़्ट-हैंडेड। साइंस कहता है।"}, {"id": 139, "duration_s": 1.633, "emotion": "sad", "text": "<sigh> बिल्कुल चप्पल जैसी।"}, {"id": 140, "duration_s": 2.15, "emotion": "laughing", "text": "दादी कभी नहीं चूकती!"}]