[{"id": 1, "duration_s": 5.94, "emotion": "calm", "text": "મે મહિનાની ગરમી. સવારના સાત. બધું એકદમ ઠીક હતું..."}, {"id": 2, "duration_s": 3.82, "emotion": "happy", "text": "ઠંડું ઠંડું પાણી... ગરમ ગરમ હું! લા લા લા!"}, {"id": 3, "duration_s": 1.72, "emotion": "curious", "text": "અરે? વરસાદ બંધ થયો?"}, {"id": 4, "duration_s": 3.35, "emotion": "comic_panic", "text": "પાણી... પાણી! આંખમાં સાબુ! હેતલલલ!"}, {"id": 5, "duration_s": 3.9, "emotion": "surprised", "text": "કાંતા બા, અહીં પણ પાણી નથી! બસ હવા!"}, {"id": 6, "duration_s": 4.04, "emotion": "serious", "text": "નળ માંદો છે. તાવ નહીં, તરસ છે."}, {"id": 7, "duration_s": 3.26, "emotion": "excited", "text": "સાંભળ્યું કે? મારો નળ પણ ખાંસે છે!"}, {"id": 8, "duration_s": 4.24, "emotion": "angry", "text": "એક ટીપું? આખા મહિનાનું બિલ ભર્યું છે મેં!"}, {"id": 9, "duration_s": 2.64, "emotion": "worried", "text": "નજર લાગી! નળને નજર લાગી!"}, {"id": 10, "duration_s": 2.67, "emotion": "proud", "text": "સાયન્સ કહે છે... નળ સૂતો છે."}, {"id": 11, "duration_s": 2.28, "emotion": "excited", "text": "લાઇવ ચાલુ છે! આખી સોસાયટી સૂકી!"}, {"id": 12, "duration_s": 2.71, "emotion": "shouting", "text": "કોણે પાણી બંધ કર્યું? હું કોનાથી ના ડરું!"}, {"id": 13, "duration_s": 4.43, "emotion": "mischievous", "text": "અને પછી... આખી સોસાયટીનું પાણી બંધ!"}, {"id": 14, "duration_s": 2.59, "emotion": "shouting", "text": "ટેન્કર આવ્યું! ટેન્કર આવ્યું!"}, {"id": 15, "duration_s": 2.56, "emotion": "determined", "text": "રસ્તો આપો! સાબુવાળો માણસ આવે છે!"}, {"id": 16, "duration_s": 4.09, "emotion": "proud", "text": "મારી ડોલ! ઇમ્પોર્ટેડ! એક રૂપિયો ઓછો નહીં!"}, {"id": 17, "duration_s": 4.063, "emotion": "happy", "text": "ચાલો ચાલો! ડ્રમ ભરી લાવીએ!"}, {"id": 18, "duration_s": 2.04, "emotion": "sarcastic", "text": "એક મીટર. રેકોર્ડ."}, {"id": 19, "duration_s": 1.97, "emotion": "shouting", "text": "એક ઘરે બે ડોલ! ધક્કા નો મારો, બાપુ!"}, {"id": 20, "duration_s": 1.82, "emotion": "determined", "text": "બસ! હવે હું જોઉં છું."}, {"id": 21, "duration_s": 1.9, "emotion": "surprised", "text": "ચીમન, ઈ ડોલ સે?"}, {"id": 22, "duration_s": 2.11, "emotion": "mischievous", "text": "ડોલનો મોટો ભાઈ!"}, {"id": 23, "duration_s": 2.62, "emotion": "stern_warning", "text": "ચીમન શેઠ! આખી સોસાયટી જુએ છે!"}, {"id": 24, "duration_s": 2.75, "emotion": "sad", "text": "ભૂખ લાગી છે... ને તરસ પણ."}, {"id": 25, "duration_s": 3.66, "emotion": "calm", "text": "ખતમ! હવે પછીનું ટેન્કર... બપોરે."}, {"id": 26, "duration_s": 2.56, "emotion": "excited", "text": "સાંભળ્યું કે? હવે ટેન્કર... ત્રણ દિવસ પછી!"}, {"id": 27, "duration_s": 2.51, "emotion": "excited", "text": "શાહભાઈ, સાંભળ્યું? વોરાભાઈ, સાંભળ્યું?"}, {"id": 28, "duration_s": 1.06, "emotion": "serious", "text": "કબૂતર, સાંભળ્યું?"}, {"id": 29, "duration_s": 4.06, "emotion": "panicked", "text": "ત્રણ દિવસ? હાય... ત્રણ કલાકમાં બધું ગયું!"}, {"id": 30, "duration_s": 3.01, "emotion": "comic_panic", "text": "ત્રણ કલાક? ના... ત્રણ મિનિટ! ભાગો!"}, {"id": 31, "duration_s": 3.84, "emotion": "mischievous", "text": "બપોરનું ટેન્કર, ત્રણ મિનિટમાં ત્રણ દિવસનું થઈ ગયું."}, {"id": 32, "duration_s": 3.18, "emotion": "mischievous", "text": "બોટલ વીસની! જલદી કરો, ભાવ વધવાનો છે!"}, {"id": 33, "duration_s": 4.45, "emotion": "mischievous", "text": "ચાલીસ! ભાવ તો હવામાન જેવો, બદલાતો રહે!"}, {"id": 34, "duration_s": 4.5, "emotion": "proud", "text": "બાર બોટલ! એક નહાવા... અગિયાર ફરી નહાવા!"}, {"id": 35, "duration_s": 1.43, "emotion": "curious", "text": "એક બોટલ કેટલાની?"}, {"id": 36, "duration_s": 0.99, "emotion": "proud", "text": "સો!"}, {"id": 37, "duration_s": 2.6, "emotion": "calm", "text": "તો રહેવા દો. હવા મફત છે."}, {"id": 38, "duration_s": 3.23, "emotion": "mischievous", "text": "ટેન્શન ના લો! બધી બોટલ મને આપો, હું ડબલમાં વેચીશ!"}, {"id": 39, "duration_s": 2.12, "emotion": "sarcastic", "text": "હું જાતે ટ્રિપલમાં વેચું છું."}, {"id": 40, "duration_s": 4.129, "emotion": "stern_warning", "text": "શેઠજી!"}, {"id": 41, "duration_s": 0.56, "emotion": "embarrassed", "text": "વીસ... વીસ જ હતા, વીસ!"}, {"id": 42, "duration_s": 4.56, "emotion": "excited", "text": "લાઇવ ચાલુ છે! પાણી, સોનાથી મોંઘું!"}, {"id": 43, "duration_s": 5.74, "emotion": "proud", "text": "બાર બોટલનું પાણી! આજે રાજાની જેમ નહાઈશ!"}, {"id": 44, "duration_s": 2.97, "emotion": "stern_warning", "text": "રાજા નહીં, પ્રજાની જેમ. એક મગ."}, {"id": 45, "duration_s": 2.62, "emotion": "pleading", "text": "અડધો મગ? આટલા સાબુ માટે?"}, {"id": 46, "duration_s": 4.35, "emotion": "proud", "text": "અમારા જમાનામાં અડધા મગમાં આખી જાન નહાતી!"}, {"id": 47, "duration_s": 4.96, "emotion": "proud", "text": "ભલે! હું કોનાથી ના ડરું! અડધો મગ, ચાલો!"}, {"id": 48, "duration_s": 3.44, "emotion": "determined", "text": "ઊભા રહો! જે પાણી પડશે, તે તુલસીને."}, {"id": 49, "duration_s": 2.6, "emotion": "surprised", "text": "પપ્પા, સાબુ બધું પાણી પી ગયો!"}, {"id": 50, "duration_s": 2.89, "emotion": "stern_warning", "text": "બીજો મગ? આખી સોસાયટી જોશે!"}, {"id": 51, "duration_s": 1.37, "emotion": "shocked", "text": "ગ... ગરોળી!"}, {"id": 52, "duration_s": 3.92, "emotion": "embarrassed", "text": "હું ડરતો નથી... એની તરસથી ડરું છું."}, {"id": 53, "duration_s": 2.96, "emotion": "worried", "text": "બા, રાત્રે ટાંકી આખી ભરેલી હતી."}, {"id": 54, "duration_s": 1.34, "emotion": "curious", "text": "તો સવારે ગયું ક્યાં?"}, {"id": 55, "duration_s": 2.73, "emotion": "excited", "text": "એક આઈડિયા છે! પાણીના જાસૂસ!"}, {"id": 56, "duration_s": 1.44, "emotion": "excited", "text": "જાસૂસ ટીમ, તૈયાર?"}, {"id": 57, "duration_s": 2.29, "emotion": "stern_warning", "text": "ચૂપ! જાસૂસ બોલે નહીં."}, {"id": 58, "duration_s": 3.82, "emotion": "serious", "text": "હું કહું? પાણીનો પીછો કરો... ચોર મળશે!"}, {"id": 59, "duration_s": 0.78, "emotion": "serious", "text": "એક!"}, {"id": 60, "duration_s": 2.056, "emotion": "serious", "text": "બે!"}, {"id": 61, "duration_s": 3.32, "emotion": "happy", "text": "આ ટપકતો નળ... સૌથી મીઠો છે!"}, {"id": 62, "duration_s": 2.31, "emotion": "shocked", "text": "ચૌદ નળ ટપકે છે! ચૌદ!"}, {"id": 63, "duration_s": 3.27, "emotion": "mischievous", "text": "અને આ પાણીની નદી... જાય છે ક્યાં?"}, {"id": 64, "duration_s": 5.38, "emotion": "proud", "text": "લાલો કાર વૉશ! ગાડી, સ્કૂટર, ભેંસ... બધું ધોવાશે!"}, {"id": 65, "duration_s": 0.7, "emotion": "angry", "text": "ચૂપ! પાઇપ બંધ કર!"}, {"id": 66, "duration_s": 4.77, "emotion": "mischievous", "text": "બંધ? આ બિઝનેસ છે! પાણી ફ્રી, કમાણી પૂરી!"}, {"id": 67, "duration_s": 3.09, "emotion": "serious", "text": "હું કહું? આ પાઇપ સવારના પાંચથી ચાલે છે."}, {"id": 68, "duration_s": 2.26, "emotion": "shocked", "text": "એટલે જ આપણી ટાંકી ખાલી!"}, {"id": 69, "duration_s": 3.13, "emotion": "calm", "text": "ટેન્શન ના લો! પાણી મારું થોડું છે, સોસાયટીનું છે!"}, {"id": 70, "duration_s": 1.48, "emotion": "angry", "text": "એટલે જ તો ટેન્શન છે!"}, {"id": 71, "duration_s": 2.7, "emotion": "shouting", "text": "તપાસ થશે! કોણ છે?"}, {"id": 72, "duration_s": 5.77, "emotion": "proud", "text": "સાયન્સ કહે છે... હવા વત્તા પાણી બરાબર વરસાદ!"}, {"id": 73, "duration_s": 0.84, "emotion": "stern_warning", "text": "ચૂપ! જોઈએ."}, {"id": 74, "duration_s": 2.73, "emotion": "excited", "text": "લાઇવ ચાલુ છે! સોસાયટીનો પહેલો વરસાદ!"}, {"id": 75, "duration_s": 4.449, "emotion": "proud", "text": "સાયન્સ કહે છે... વરસાદ ફક્ત વૈજ્ઞાનિકો પર પડે!"}, {"id": 76, "duration_s": 5.21, "emotion": "sad", "text": "હોશિયાર હર્ષ નહાઈ લીધું? હું હજી સાબુમાં છું!"}, {"id": 77, "duration_s": 2.72, "emotion": "laughing", "text": "હા હા! સોસાયટી જોશે... હર્ષનું સ્નાન!"}, {"id": 78, "duration_s": 3.55, "emotion": "sarcastic", "text": "એક ડોલ વધુ ગઈ. પંદરમો નળ!"}, {"id": 79, "duration_s": 3.11, "emotion": "embarrassed", "text": "બસ... થોડું કેલિબ્રેશન બાકી છે."}, {"id": 80, "duration_s": 2.27, "emotion": "panicked", "text": "સાંભળ્યું કે? છેલ્લું ટેન્કર!"}, {"id": 81, "duration_s": 4.65, "emotion": "excited", "text": "અને શરૂ થઈ... સોસાયટીની સૌથી મોટી ડોલ રેસ!"}, {"id": 82, "duration_s": 1.95, "emotion": "determined", "text": "આ વખતે પહેલી ડોલ મારી!"}, {"id": 83, "duration_s": 1.21, "emotion": "excited", "text": "ચાલો ચાલો!"}, {"id": 84, "duration_s": 2.2, "emotion": "sad", "text": "અરે... આજે પણ?"}, {"id": 85, "duration_s": 2.83, "emotion": "curious", "text": "કોઈ કહેશે... હું ક્યાં છું?"}, {"id": 86, "duration_s": 1.21, "emotion": "angry", "text": "મારી ડોલમાંથી ઉતર!"}, {"id": 87, "duration_s": 3.07, "emotion": "sarcastic", "text": "આ ડોલ નથી... મોટો ભાઈ છે!"}, {"id": 88, "duration_s": 5.1, "emotion": "shouting", "text": "તપાસ થશે! થોભો! ના, ચાલો! ના, થોભો!"}, {"id": 89, "duration_s": 4.21, "emotion": "excited", "text": "લાઇવ! ડોલ જામ, સો મીટર લાંબો!"}, {"id": 90, "duration_s": 3.59, "emotion": "angry", "text": "આખી સોસાયટી જુએ છે... ને કોઈ હલતું નથી!"}, {"id": 91, "duration_s": 2.94, "emotion": "excited", "text": "કબૂતર, સાંભળ્યું...? અરે!"}, {"id": 92, "duration_s": 1.23, "emotion": "shouting", "text": "ચૂપ!!!"}, {"id": 93, "duration_s": 1.54, "emotion": "serious", "text": "પાણી માટે ઝઘડો... ને નળ હજી ટપકે છે!"}, {"id": 94, "duration_s": 1.65, "emotion": "determined", "text": "હું કહું? હિસાબ જુઓ!"}, {"id": 95, "duration_s": 3.89, "emotion": "stern_warning", "text": "શાંતિ! આજનો ક્લાસ... પાણી!"}, {"id": 96, "duration_s": 4.51, "emotion": "serious", "text": "હું કહું? એક ટપકતો નળ, દર સેકન્ડે એક ટીપું."}, {"id": 97, "duration_s": 2.79, "emotion": "excited", "text": "બુંદી? ક્યાં છે બુંદી?"}, {"id": 98, "duration_s": 2.18, "emotion": "sarcastic", "text": "બુંદી નહીં, બૂંદ!"}, {"id": 99, "duration_s": 2.24, "emotion": "proud", "text": "એક નળ, એક મહિનો... સાઠ ડોલ!"}, {"id": 100, "duration_s": 4.3, "emotion": "shocked", "text": "સાઠ? હાય હાય!"}, {"id": 101, "duration_s": 4.82, "emotion": "shocked", "text": "ચૌદ ગુણ્યા સાઠ... આઠસો ચાલીસ ડોલ!"}, {"id": 102, "duration_s": 2.44, "emotion": "mischievous", "text": "આટલી બોટલ વેચી હોત તો..."}, {"id": 103, "duration_s": 1.016, "emotion": "stern_warning", "text": "શેઠજી!"}, {"id": 104, "duration_s": 4.49, "emotion": "serious", "text": "અને લાલા કાકાનો પાઇપ... એક કલાકમાં પચાસ ડોલ!"}, {"id": 105, "duration_s": 3.92, "emotion": "embarrassed", "text": "ટેન્શન... થોડું થોડું થાય છે."}, {"id": 106, "duration_s": 3.28, "emotion": "calm", "text": "માડી, લાઈનનું રિપેરિંગ સે. સાંજ લગી પાણી આવી જાહે."}, {"id": 107, "duration_s": 1.69, "emotion": "embarrassed", "text": "સાંજ સુધી? ત્રણ દિવસ નહીં?"}, {"id": 108, "duration_s": 1.18, "emotion": "sarcastic", "text": "ત્રણ દિ' કોણે કીધું?"}, {"id": 109, "duration_s": 4.41, "emotion": "guilty", "text": "એટલે પાણી બંધ નહોતું થયું... આપણે જ વહાવી દીધું!"}, {"id": 110, "duration_s": 2.99, "emotion": "serious", "text": "ચૌદ નળ, એક પાઇપ, એક બાથટબ..."}, {"id": 111, "duration_s": 1.89, "emotion": "mischievous", "text": "ને એક સાબુવાળા પપ્પા!"}, {"id": 112, "duration_s": 2.82, "emotion": "determined", "text": "બસ! હવે આપણે બધા સંભાળીશું."}, {"id": 113, "duration_s": 2.84, "emotion": "determined", "text": "દસ સેકન્ડ."}, {"id": 114, "duration_s": 1.74, "emotion": "proud", "text": "નવ સેકન્ડ! આખી સોસાયટી જોશે!"}, {"id": 115, "duration_s": 2.12, "emotion": "proud", "text": "આ તો મારા ડાબા હાથનો ખેલ છે!"}, {"id": 116, "duration_s": 4.51, "emotion": "relieved", "text": "આહ... નહાઈ લીધું! આખરે!"}, {"id": 117, "duration_s": 2.65, "emotion": "excited", "text": "સાંભળ્યું કે? જયેશભાઈ નહાયા!"}, {"id": 118, "duration_s": 4.8, "emotion": "happy", "text": "એક ડોલ, એક કપડું... ગાડી ચમકી ગઈ!"}, {"id": 119, "duration_s": 1.312, "emotion": "laughing", "text": "હા! ભેંસ! પણ ડોલથી!"}, {"id": 120, "duration_s": 3.84, "emotion": "proud", "text": "ટપકેલું પાણી મારું! એક ટીપું નહીં બગડે!"}, {"id": 121, "duration_s": 3.21, "emotion": "proud", "text": "સાયન્સ કહે છે... ટપકતો નળ ઠીક કરો."}, {"id": 122, "duration_s": 3.03, "emotion": "surprised", "text": "હર્ષભાઈ... પહેલી વાર સાચું!"}, {"id": 123, "duration_s": 3.51, "emotion": "sad", "text": "મીઠો નળ... રિટાયર થઈ ગયો."}, {"id": 124, "duration_s": 3.14, "emotion": "happy", "text": "છતનું પાણી, સીધું ડ્રમમાં!"}, {"id": 125, "duration_s": 2.85, "emotion": "loving", "text": "હવે વરસાદને નજર નહીં લાગે."}, {"id": 126, "duration_s": 3.07, "emotion": "excited", "text": "લાઇવ ચાલુ છે! હેશટેગ ટીપું બચાવો!"}, {"id": 127, "duration_s": 5.17, "emotion": "happy", "text": "તે દિવસે ચૌદ નળ ઠીક થયા... ને એક પપ્પા નહાયા."}, {"id": 128, "duration_s": 3.34, "emotion": "calm", "text": "સાંજ પડી... ને નળમાં ફરી પાણી આવ્યું."}, {"id": 129, "duration_s": 3.5, "emotion": "proud", "text": "આજથી જયેશ શાહ... એક ડોલમાં નહાશે!"}, {"id": 130, "duration_s": 0.63, "emotion": "stern_warning", "text": "અડધી."}, {"id": 131, "duration_s": 2.0, "emotion": "calm", "text": "ટીપે ટીપે સરોવર ભરાય..."}, {"id": 132, "duration_s": 4.09, "emotion": "serious", "text": "...ને ટીપે ટીપે ખાલી પણ થાય."}, {"id": 133, "duration_s": 4.3, "emotion": "serious", "text": "ટપકતો નળ આજે ઠીક કરો... કાલે નહીં."}, {"id": 134, "duration_s": 3.23, "emotion": "calm", "text": "ને આકાશનું પાણી... ડ્રમમાં."}, {"id": 135, "duration_s": 1.77, "emotion": "determined", "text": "ગાડી ડોલથી!"}, {"id": 136, "duration_s": 1.18, "emotion": "determined", "text": "પાઇપ ખુલ્લો નહીં!"}, {"id": 137, "duration_s": 2.89, "emotion": "proud", "text": "ને વરસાદનું પાણી... છત પર!"}, {"id": 138, "duration_s": 2.2, "emotion": "excited", "text": "વરસાદ!"}, {"id": 139, "duration_s": 3.86, "emotion": "excited", "text": "ફ્રીનો શાવર! ભગવાન, ચાલુ કરો!"}]